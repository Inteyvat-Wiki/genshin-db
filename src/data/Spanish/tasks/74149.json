			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "¿Hay algún trabajo nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "¿Eh? Supongo que los encargos de “Espejo Social” no suponen un reto para ti. ¿O es que necesitas Moras urgentemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Nunca se tienen suficientes Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Mhm, es lo que la gente suele pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Si hay algo que nunca falta aquí, es trabajo. Sin contar el Gremio de Aventureros, «El Pájaro de Vapor» probablemente sea el mayor centro de información sobre empleo que hay en la Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Aunque, en teoría, no es necesario que asumamos ese tipo de funciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Pero bueno, ya que necesitas Moras, te voy a recomendar un trabajo a largo plazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Esta es una nota que el Sr. Leroy nos dejó hace alrededor de medio año. Todo el mundo que vive en esta calle lo conoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Aunque no tenía muy buena reputación cuando era joven, no he oído ningún rumor que hable mal de él en los últimos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Ha estado solo toda su vida, y con su única hija lejos de su lado, no hay nadie que cuide de él... Supongo que necesita a alguien que trabaje por horas que le eche una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "Según tengo entendido, no le falta el Mora, así que el trabajo debe estar bastante bien pagado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Un trabajo sin riesgo con una buena recompensa. ¿Por qué no te lo piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Así que solo tenemos que ayudarlo con algunas tareas domésticas, ¿verdad? ¡Paimon piensa que no es un mal trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Por favor, dime cuál es su dirección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "De acuerdo. Solo gira dos calles, y luego gira hacia... ¿Sabes qué? Mejor te doy un mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Recuerda decirle que fui yo quien los puso en contacto, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Un poco de ambas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#Qué joven tan aplicad{F#a}{M#o}. Está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
