			"dialogs": [
				{
					"id": 741490701,
					"content": "¿Olvidaron lo que les pedí? Ay, la memoria de la juventud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490702,
					"content": "Lo primero que les pedí que hicieran fue limpiar la entrada y la parte trasera de la casa, y luego, darle de comer a Nana algo de pescado.",
					"roleType": "TALK_ROLE_NPC",
