							75.375
						],
						"pointId": 68
					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantástico... Prácticamente ya hemos sacado la mayor parte de la chatarra hundida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160102,
					"content": "Siento haberles hecho trabajar tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160103,
					"content": "¡No hace falta que te disculpes, Fréminet! En realidad, según lo ve Paimon, no hemos estado trabajando, sino cazando tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Hemos ayudado a restaurar el medioambiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Gracias... Me lo he pasado muy bien, todo gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160107,
					"content": "¡De nada! Además, ¡ha sido un trabajo en equipo! Y Paimon cree que has progresado mucho, Fréminet. ¡Has sido de gran ayuda tanto bajo el agua como en tierra firme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "No te pongas tímido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "E-está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160111,
					"content": "Lo siento, pero aparte de “gracias”, no sé qué más decir en un momento como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160112,
					"content": "Tal vez... ¿aún necesito más práctica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160113,
					"content": "Tómate tu tiempo, no hay prisa. ¡Sigue haciéndolo a tu propio ritmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Si se presenta la oportunidad, volvamos a trabajar juntos en el futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Trato hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160117,
					"content": "... Ahora que todo está en orden, tenía pensado volver bajo el agua para pasar un tiempo a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160118,
					"content": "Pero, curiosamente, después de hablar con ustedes... hasta el cielo parece más tranquilo. Solo quería... compartir lo que siento con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160119,
					"content": "En fin... será mejor que regrese y me reúna con Lyney y los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160120,
					"content": "Les dejaré el resto de los datos del estudio submarino. Espero que encuentren lo que buscan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160121,
					"content": "Los he oído celebrar desde arriba. ¿Ha ocurrido algo bueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160122,
					"content": "¡Sí! Es que hemos limpiado toda la chatarra que estaba molestando a los pececitos. ¡Y también hemos encontrado el resto de las piezas del piano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "¿De veras? Déjenme ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160124,
					"content": "... Vaya, así que es cierto. Con estas piezas, podré arreglar el piano por fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160125,
					"content": "Puede que no quede exactamente igual que antes, pero debería poder volver a tocar música linda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160126,
					"content": "Pareces muy contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "¿A-ah, sí? Da igual, iré a arreglarlo enseguida. No debería tardar demasiado. Mientras, ¿podrían ayudarme a decorar un poco el lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160128,
					"content": "Un instrumento tan maravilloso merece un escenario a su altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160129,
					"content": "Sí que está contenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "¡Guau! ¡Qué piano tan bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "¡Es muy elegante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "¡Hum, claro que sí! ¡Al fin y al cabo, fui yo quien lo arregló! También he reforzado los mecanismos y he retocado el exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160134,
					"content": "Ustedes dos tampoco lo han hecho nada mal. Este escenario es verdaderamente digno del piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160135,
					"content": "¡Jeje, no ha sido nada! En fin, dejémonos de cháchara. ¿No nos vas a tocar una canción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "... ¿Eh? ¿Ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160137,
					"content": "¿Cuándo si no? ¿Para qué arreglar el piano si no lo vas a tocar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "¿Qué tal si... lo dejamos para otro día? ¡Habrá tiempo de sobra para escucharme tocar más adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160139,
					"content": "¿Te olvidaste la partitura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "*Tch*... ¡Qué tontería! ¡Tan solo quiero quedarme un rato en silencio y recordar los viejos tiempos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160142,
					"content": "¡Y no crean que unas cuantas provocaciones de pacotilla van a hacer que me ponga a tocar! Hum, ¡antes tendré que practicar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160140,
					"content": "¿Te da vergüenza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "¡Es precioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "#Si necesitas ayuda, siempre puedes contar con nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Y encontramos un montón de tesoros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}