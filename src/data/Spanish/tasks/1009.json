		{
			"id": 100914,
			"completionStepIds": [
				100914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100914",
							"2"
						],
						"stepId": 100914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Estoy muy impresionada. El camino a esta morada es un desafío para aquellos de habilidades corrientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091402,
					"content": "Estás frente a la Adeptus Preservadora de Nubes. Ahora, dime qué asuntos te traen por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091403,
					"content": "¿Construyó todo este lugar usted sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Tu suposición es correcta. Yo construí este lugar y diseñé sus trampas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091407,
					"content": "De hecho, incluso Guizhong y Rex Lapis afirmaron que mis logros tecnológicos eran dignos de admiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091408,
					"content": "¡Este lugar es enorme! Y hay tantos mecanismos... ¿De verdad vive usted sola aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "¿Lo construyó como su taller privado de fabricación de trampas o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "Es igual que en las leyendas... Los Adeptus dejan el mundo humano, encuentran un lugar donde ser ermitaños y, luego, investigan e inventan cosas increíbles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Los Adeptus... no somos muy dados al tedio de la interacción social. Solo deseamos encontrar algo de paz y tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091412,
					"content": "Yo, de hecho, las encontré. Pero poco después, llegaste tú con el Sello del Permiso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091413,
					"content": "¡Pero basta de charla! ¡Dime de inmediato qué asuntos te traen por aquí! Ya has perturbado la tranquilidad de este lugar durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091414,
					"content": "¡¿Rex Lapis... fue asesinado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091415,
					"content": "¿Cómo pudo ocurrir? ¿Quién se atrevió a cometer un crimen tan atroz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091416,
					"content": "Me parece algo tan imposible que apenas puedo creerlo... Tendré que comprobar la verdad del asunto por mi cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091417,
					"content": "Tal vez primero deba castigar a Liyue y luego reunirme con los otros Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091418,
					"content": "¿Perdón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Espere, ¿qué? ¿Acaba de decir “castigar a Liyue”? ¿En serio va a arrasar con toda la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Solo una respuesta así puede evitar que se produzcan más incidentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091421,
					"content": "Pero se supone que los Adeptus juraron proteger la ciudad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "Y eso hemos hecho. Hemos protegido Liyue bajo el liderazgo de Rex Lapis durante 37 siglos. Pero frente a este golpe tan bajo, deben tomarse medidas excepcionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091425,
					"content": "Como no deseo ver más sufrimiento, considero que este momento excepcional requiere medidas excepcionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091426,
					"content": "¡Ay! ¡Rápido, tienes que pensar en algo! ¡Quiere castigar a Liyue, y no parece que esté fanfarroneando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "Aceptó nuestra ofrenda. Eso hace que esto sea un contrato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "¡Eso es justo lo que iba a decir Paimon! ¡Hicimos toda esa deliciosa comida solo para usted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "Esperábamos que pudiera ayudar a Liyue... ¡no aniquilarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "O, al menos... discutámoslo primero. No pierde nada con escucharnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "¿Un “contrato”, dicen? Qué cruel e irónico que apelen a este concepto justo después del despiadado asesinato del mismísimo Patrono de los contratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091432,
					"content": "La gente de Liyue parece bastante contenta de poder prescindir de sus contratos. Es como si no supieran distinguir el bien del mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091433,
					"content": "Sin embargo... Ya que viniste aquí en nombre de los contratos, no puedo ignorar las obligaciones que de dicho contrato subyacen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091434,
					"content": "Y menos aún cuando vienes con un Sello del Permiso... *Suspira*, Rex Lapis imbuyó estos signos de poder adéptico cuando los creó por primera vez. Ese poder que, en el pasado, ayudó a los humanos en la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091435,
					"content": "La mayor parte del poder de este Sello se agotó hace mucho tiempo... Ahora no es más que un simple recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091436,
					"content": "Pero no puedo considerarlo como una prueba de tu lealtad. Debo investigar por mi cuenta lo que me has contado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091437,
					"content": "Esta es, sin duda, la razón por la que Escultor de la Luna nos ha llamado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091438,
					"content": "Bien, ya escuché lo que tenías que decir. Sal de inmediato y no me molestes más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091423,
					"content": "¿No se supone que debe proteger a su gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Así es. Pero si Rex Lapis ha sido asesinado, entonces, Liyue está en gran peligro. No castigar esa amenaza a tiempo es como querer atraer un mayor desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10091405,
					"content": "¿Diseñó usted todas las trampas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
		},
		{
			"id": 100915,
			"completionStepIds": [
				100915
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
