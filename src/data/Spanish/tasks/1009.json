			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Oye, ¿quién puso esta mesa aquí? Incluso pusieron cubiertos y una jarra de vino y todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "¡Y también grabaron en los asientos los nombres de los invitados! “Aquí se sienta Preservadora...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "“Aquí se sienta Guizhong...”, “Aquí se sienta Rex...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "¿Quizás “Rex” se refiere a “Rex Lapis”? Pero Paimon no entiende lo de “Guizhong”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "En cuanto a “Preservadora”... Humm... ¡Eso es! Cuando Escultor de la Luna mencionó los nombres de sus amigos Adeptus, dijo que había una llamada “Preservadora de Nubes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "¡Así que aquí debe ser donde Preservadora de Nubes y los otros Adeptus cenan juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Jeje. ¿Y si cocinamos algunos platos que les gusten a los Adeptus? De esa forma, ¡conseguiremos llamar la atención de Preservadora de Nubes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Pero... ¿qué es lo que comen los Adeptus? Paimon no tiene idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Humm... Seguro que la gente hace ofrendas por aquí todo el tiempo. Deberíamos buscar restos de comida por la zona. Tal vez eso nos dé ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "¿Crees que los Adeptus querrán probar un poco de... asado a la miel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
