			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Alguien ha cocinado aquí antes. ¿Crees que estaban haciendo una ofrenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Parece que no usaron todos los ingredientes. Veamos... tenemos algo de flor dorada, algunas cabezas de loto, algo de tofu... Sea lo que sea lo que cocinaban, ¡parece complicado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Oye, mira allí... También dejaron algunas notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Qué lío... Paimon no se sorprende de que hayan tenido que escribirlo todo. Es mucho que recordar... Deberíamos leerlo detenidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
							"2"
						],
						"stepId": 100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Vaya... Hay harina por todo el suelo. Qué chef tan descuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "¿Qué tenemos en esta olla?... Humm... Es carne, pero Paimon no sabe de qué tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "¿Crees que quien cocinó esto lo hizo como ofrenda para los Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Humm... Una ofrenda de comida hecha con carne y harina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "¿Eh? Nuestro descuidado chef dejó caer un pedazo de papel en el suelo... Oh, y hay una huella enorme sobre él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "¿Tal vez tiene algo que ver con este plato misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
							"2"
						],
						"stepId": 100904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Este sitio está muy limpio. A quien cocinó aquí por última vez obviamente le gusta mantener las cosas limpias y ordenadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Paimon apuesta a que estaban haciendo una ofrenda a los Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Y esto de aquí es... matsutake y algo de carne cruda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "Mira, la receta está aquí mismo. Este chef era una persona superorganizada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100913,
			"completionStepIds": [
				100913
