			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Miras el altar y, de repente, una extraña energía parece surgir en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Tocar amuleto"
				},
				{
					"id": 721290202,
					"content": "Te das cuenta de que no se te resiste, que te está pidiendo algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Tocar amuleto"
				},
				{
					"id": 721290203,
					"content": "Humm... Parece que a este altar le faltan algunas cosas. Vamos a buscar por los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Utiliza la Visión Elemental para investigar los rastros elementales dispersos en el área, ¡quizá encuentres algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
