			"dialogs": [
				{
					"id": 721290601,
					"content": "¿Qué? ¿Arreglaste el pilar tan rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Oh, está bien. Tómate tu tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "Todavía estoy en ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Si no es posible, no te fuerces, y no te quedes en este lugar mucho tiempo. Es peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
