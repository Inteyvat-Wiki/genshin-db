				"objectNames": [
					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "#¡Qué hábil, foraster{F#a}{M#o}! Las nubes se han disipado bastante, parece que mis sospechas eran correctas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Todavía hay dos altares que necesitan ser reparados, en la Cabeza de la Serpiente y la Mina Jakotsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Si no te importa, ¿podrías encargarte de también de ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Muchas gracias por tu ayuda. No soy rico, pero te prometo que no te voy a dejar con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Aunque no se sabe cuándo será, el día en que la familia y los amigos vuelvan a casa se acerca cada vez más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Por cierto, reúnete conmigo en el lado oeste de la isla cuando hayas terminado. El área del Bastión Mumei también ha sido invadida por rebeldes, y probablemente también tenga que ver con estos cambios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
