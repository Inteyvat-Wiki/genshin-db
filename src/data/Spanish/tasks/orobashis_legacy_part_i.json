			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "La extraña linterna de piedra parece irradiar una energía perturbadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290102,
					"content": "Esta linterna de piedra es tan rara que hace sentir una incomodidad extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, parece que hay algo escrito en la lámpara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "“Transeúnte, si tienes alguna pregunta sobre este altar, dirígete a la Garganta Musoujin y habla con el Sr. Kaji.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290105,
					"content": "La escritura parece reciente, no debe haber sido hecha hace mucho tiempo. Debajo hay varias columnas de letras pequeñas, borrosas por la lluvia:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290106,
					"content": "“Por favor, dile que lo hemos intentado... pero por desgracia... Tal vez haya algo cerca...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290107,
					"content": "“Pídele al Sr. Kaji que venga al lugar de evacuación lo antes posible, su familia lo extraña.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290108,
					"content": "Este Sr. Kaji parece preocuparse mucho por la linterna de piedra, ¿por qué no vamos a la Garganta Musoujin a preguntarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
