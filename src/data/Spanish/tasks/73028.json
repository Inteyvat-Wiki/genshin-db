			"dialogs": [
				{
					"id": 730280101,
					"content": "Aquí también hay componentes robóticos gigantes. Si Jazari los viera, se pondría a capturar imágenes con el Daguerrotipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Ararycan dijo que él movió ese fragmento enorme hasta aquí. ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Claro que es posible. Ararycan nunca miente a nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "Ajá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan, ¡tú eras el aranara que jugaba con los niños en la base secreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "Pero Ararycan no recuerda nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Tal vez tenga algo que ver con la flor seca en el diario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Sí. El aranara en la Arboleda Moutiyima olvidó todo después de darnos la flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Quizás los tres tuvieron las mismas aventuras que nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan no entiende de lo que están hablando y tampoco recuerda. ¡Pero es divertido jugar con pequeños nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Paimon espera que seas feliz dondequiera que estés, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "Ya nos hemos encontrado con algo así antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
