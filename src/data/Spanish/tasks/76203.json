					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "¡Aah, qué susto! ¡El cuadro nos ha absorbido de repente! Un momento... Esta escena le resulta familiar a Paimon... ¡Oh, es la mesa donde las brujas toman el té!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Todo empezó cuando Alice me invitó a tomar té por primera vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Sin embargo, ese día no asistí en persona. Sobre todo porque por aquel entonces aún no había decidido si quería unirme al Aquelarre o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice era la única de las presentes que conocía mi verdadera identidad. Me advirtió de que no dijera nada ni dejara que nadie más descubriera quién era. Se suponía que solo debía observar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "¿Y qué pasó después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Bueno... Después, llegué a la conclusión de que me estaba castigando por mis dudas sobre si unirme o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Todas estaban hablando de cosas muy interesantes, así que ¿cómo no iba a dar mi opinión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Y, claro está, si en mitad de la conversación alguien preguntaba algo cuya respuesta conocía, ¿cómo iba a quedarme callada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Esto nos lleva a la apuesta entre Alice y Barbeloth, las creaciones prohibidas de Rhinedottir, las artimañas políticas de Ivánovna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Era como una serie de exquisitas obras de teatro destiladas en el interior de una taza de té. ¡Sus palabras bastaron para activar mi instinto de reconocer la verdad ante ellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "¿Así que hablaste en la mente de todas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "¡Por supuesto que no! Incluso aunque sentía que apenas podía respirar, me aseguré de guardármelo para mí. Soy un ángel responsable, después de todo. Conozco bien la diferencia entre lo que quiero decir y lo que puedo decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Al final, tuve una laaarga charla privada con Alice en su cabeza y acepté unirme al Aquelarre en ese mismo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Se puso muy contenta con mi decisión, pero en cuanto a lo de hablar en su mente... Bueno, dice que durante los siguientes días sufrió un dolor de cabeza tan fuerte que tuvo que visitar a un médico de Liyue en busca de algún remedio. ¡Pero no puede culparme a mí de eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
