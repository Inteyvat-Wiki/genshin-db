							-26.859
						],
						"pointId": 31
					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "¡Oh, están aquí! Justo empezaba a preguntarme si debería haberles enviado unas instrucciones más claras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Pero luego pensé que si hacía las pistas demasiado obvias, podría interferir con sus planes de viaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Y entonces, cuando empezaba a dudarlo todo, aparecieron como la lluvia que llega en el momento justo. ¡Podría decirse que todo ha salido bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "¡Hola, Nicole, se te ve de muy buen humor! ¡Y también estás muy habladora hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "#¡Me lo tomaré como un cumplido! Está bien, ¿están list{F#a}{M#o}s para echarle un vistazo a la siguiente habitación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
