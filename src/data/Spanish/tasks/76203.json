					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "¿Un árbol de Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Oh, ¿dices este cuadro de aquí? Parece que conocen bien este tipo de árbol... Pero ¿sabían que la traición del primer ángel ocurrió bajo sus ramas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "No lo sabía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "¡Paimon quiere saber más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Bueno, supongo que ha llegado el momento de contarles una historia de amor y terror. Dejen que se me ocurra primero una forma de proteger la identidad de quienes se vieron involucrados en ella... ¡Ah, ya sé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "#Hace mucho, mucho tiempo, había un viajero que vagaba por las estrellas. Nada que ver con {NICKNAME}, es una larga historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Un día, viajó a un árbol plateado para visitar a la princesa de la estrella del alba. Tras un tiempo, empezó a preguntarle sobre los secretos prohibidos de su reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Sus palabras hicieron que la princesa se sintiera confundida. ¿Cómo podía saber él sobre todas aquellas cosas prohibidas por los dioses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "El joven le reveló sus orígenes y le mostró a la princesa algo que nunca antes había visto: el libre albedrío y el amor noble y espiritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Sus palabras despertaron el yo interior de la princesa, encadenado hasta entonces por los dioses. Su corazón se elevó, llevándola más allá de unos límites que nunca había cruzado antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "La princesa de la estrella del alba le contó al joven los secretos del reino, y el amor creció y floreció entre ambos... a la vez que lo hizo su determinación de desafiar a los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "Hasta el momento, tan solo se trata de una historia de amor normal y corriente, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Aquí viene la parte aterradora: ellos anhelaban ayudar a la gente a vivir en libertad, sin ataduras, pero los dioses no perdonaron tal traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Desataron sus relámpagos y su ira sobre su hogar, destruyéndolo. Cuando la guerra se calmó, la princesa había perdido por siempre su poder y sabiduría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Incluso sus amigas cercanas habían sufrido la maldición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "Oh... Ese final sí que da miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Pero ¿no decías que ibas a hablarnos del primer ángel? No estarás diciendo que esa historia es real, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Sí que lo es, y eso es lo más terrorífico de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Bueno, supongo que ha llegado el momento de contarles una historia de amor y terror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Dejen que se me ocurra primero una forma de proteger la identidad de quienes se vieron involucrados en ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "¡Ah, ya sé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Me resulta familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
