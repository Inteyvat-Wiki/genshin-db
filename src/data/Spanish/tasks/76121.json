			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "¿Así?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540302,
					"content": "Humm, tengo que pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540304,
					"content": "La luna... La luna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540305,
					"content": "¿Qué tal aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540306,
					"content": "Esta vez he ganado yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540307,
					"content": "He conectado las tres lunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540308,
					"content": "Sí, debería poder ganar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540309,
					"content": "Humm... La luna se alza y se pone en un ciclo sin fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540310,
					"content": "Nuestras lunas se niegan a ser eclipsadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540311,
					"content": "¿Acaso... vamos a empatar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540312,
					"content": "Parece que te gusta pensar bien en tus decisiones. No importa, tenemos tiempo de sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540313,
					"content": "¿Has olvidado cómo colocar las “lunas” en el “cielo nocturno”? ¿Necesitas que te ayude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540314,
					"content": "¿Es que no te gusta este juego? A mí me parece muy entretenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540315,
					"content": "Oh, ¿me estás mirando a mí? Puedo sentirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540316,
					"content": "¿Acaso crees que encontrarás la respuesta en mi cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540317,
					"content": "El tablero está ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540318,
					"content": "Humm, tus “lunas” te han traído la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540319,
					"content": "El cielo nocturno te pertenece a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540320,
					"content": "Ah... Parece que me he equivocado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540321,
					"content": "Pasas un buen rato jugando junto a Colombina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Las tres lunas alineadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210203,
					"content": "¿Qué pasa? ¿Estabas pensando en cómo fue la última partida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Oh, no es eso. Es solo que... cuando pienso en el juego ahora, me invade una sensación extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210205,
					"content": "Claro, ahora que tienes el poder de las tres lunas, te has convertido en mucho más que alguien capaz de dominar el cielo nocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Sí, y también pienso que... el destino del mundo podría haber sido muy diferente si no hubiera existido división alguna entre las tres Diosas Lunares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210207,
					"content": "¿Cómo eran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "La primera a la que vi fue Sonnet, Diosa de la Luna Arcoíris. Era mucho más enérgica de lo que imaginaba, parecía casi una niña juguetona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210209,
					"content": "Aria, la Diosa de la Luna Eterna, era la más madura de las tres. Era una líder innata, pero también la más gentil. Oh, justo como Lauma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210210,
					"content": "En cuanto a Canon, la Diosa de la Luna Escarchada... me resultó alguien sabio y con una gran visión de futuro. Ella fue quien me entregó su luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210211,
					"content": "Parece que todas eran deidades bondadosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Así es. A pesar de sus diferencias, todas ellas amaban el mundo de Teyvat y amaban su hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210213,
					"content": "Cuando les hablé de lo que estaba por venir, parecieron aliviadas y contentas de que el mundo siguiera teniendo un futuro tan prometedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210214,
					"content": "Por eso me dieron el poder de regresar aquí, a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210215,
					"content": "Oh... A Paimon le encantaría poder verlas y darles las gracias de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "A mí también me gustaría, pero... me temo que ya no es posible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210217,
					"content": "Por suerte, el mundo continúa avanzando. Los humanos a los que protegieron sobrevivieron, y han transmitido en forma de canción su historia hasta el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210218,
					"content": "¡Cierto! Mientras sigamos viviendo y no dejemos que los malvados destruyan el mundo, ¡esa será nuestra mejor forma de agradecérselo a las tres diosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Qué bien hablas, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "En ese caso, les das las gracias todos los días...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "¡Por supuesto! ¡Paimon siempre intenta vivir la vida al máximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "¡Tú también tienes que hacer lo mismo, Colombina! ¡Come y duerme bien todos los días y ven a buscarnos cuando quieras jugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Jaja, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210224,
					"content": "Sospecho que, a partir de ahora, siempre pensaré en esas tres amables diosas cuando vaya a jugar a las damas lunares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
