			"dialogs": [
				{
					"id": 761210101,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210102,
					"content": "¡Hola, Colombina! ¡Parece que hoy estás de muy buen humor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Ja... Vamos, suban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210104,
					"content": "¿Es que quiere jugar a las damas lunares otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Sí, llevamos mucho tiempo sin jugar. Lo echo de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210106,
					"content": "¿Las reglas son las mismas de siempre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "¿O acaso ahora que eres la Diosa Trilunar puedes mover varias piezas en un solo turno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Eso sería hacer trampa, y yo no quiero ganar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761210109,
					"content": "Jeje, Paimon ya lo sabe, solo era una broma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "¿Empezamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
		{
