			"dialogs": [
				{
					"id": 710500401,
					"content": "Sobre esos hongos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "#No esperaba menos de {F#una viajera experimentada}{M#un viajero experimentado} como tú. No has tardado nada en hacer nuevos descubrimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "#Humm, ¿estás segur{F#a}{M#o} de que has encontrado este hongo aquí? Qué raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "¿Es raro porque los hongos no pueden crecer bajo tierra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Ese no es el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "Es que este hongo se parece mucho a uno que crece en Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Aunque no tengo muy claro qué tipo de hongo es este... Si tuviera más muestras, podría analizarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "Hablando de muestras... Tú encontraste este, así que supongo que sabrás dónde buscar más... ¿Por qué no me traes unos cuantos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Si me traes suficientes hongos, te daré una buena recompensa en Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "¿Y cuántos son suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Humm, déjame pensar... ¿Por qué no me traes 8 para empezar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "No te preocupes. ¡Si me traes hongos, no escatimaré en Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
