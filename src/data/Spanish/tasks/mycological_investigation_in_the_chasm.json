			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "Traje los hongos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Muy bien, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500703,
					"content": "Con tu ayuda, mi investigación marcha... ¿Cómo es ese dicho de Liyue? “Viento en vela, a toda popa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500704,
					"content": "¿“Viento en popa, a toda vela”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Pues sí, viento en popa, a toda vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500706,
					"content": "¿Qué les pasa a estos hongos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500707,
					"content": "Esto es muy extraño. Estos hongos son exactamente iguales a los autóctonos de Sumeru. Pero ¿por qué brillan? ¿Será porque han crecido en la oscuridad y han evolucionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500708,
					"content": "Pero, si han evolucionado, ¿cómo es que su aspecto no ha cambiado en absoluto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500709,
					"content": "No entiendo nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "A ver... Dicho de otra manera, los hongos se adaptan al medio que los rodea, pero estos hongos en concreto muestran características de adaptación a un bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500712,
					"content": "Por eso estoy completamente seguro de que estos hongos provienen de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500713,
					"content": "¿Y, entonces, por qué brillan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Puesto que no son autóctonos de la Sima, no brillan porque se hayan adaptado al medio, sino por algún tipo de anomalía externa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500715,
					"content": "Supongo que será por ese fragmento que cayó del cielo. Tiene que haber absorbido su energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500716,
					"content": "¿Fragmento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Humm... ¿Eh? ¿Has dicho fragmento? ¿Qué? No, yo decía que cuando los fragmentos de hongo cayeron del cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500719,
					"content": "Sufrieron algún tipo de mutación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500720,
					"content": "¡Seguro que es eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500721,
					"content": "Muchas gracias por traerme estos hongos. Has hecho un gran trabajo. ¡Deberías descansar un poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500722,
					"content": "Yo seguiré investigando estos hongos y necesito estar solo para hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500717,
					"content": "¿Qué fragmento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "¿Qué problema hay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
