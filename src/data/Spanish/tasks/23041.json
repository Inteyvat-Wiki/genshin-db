				},
				{
					"id": 230411003,
					"content": "Pero es algo bueno. Así Nermín mantiene su mente ocupada en otras cosas que no sea su salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230411004
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411004,
					"content": "Hay otro cargamento de mercancías que llegará más tarde. Tomaré la sopa después de llevarlo al pueblo.",
