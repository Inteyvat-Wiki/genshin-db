			"dialogs": [
				{
					"id": 230410602,
					"content": "¿Miau? ¡Miau, miau miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410603
					],
					"speakerTitle": "Gato perezoso"
				},
				{
					"id": 230410603,
					"content": "#¡Oye! ¡Que nosotr{F#a}{M#o}s somos buenas personas! ¡No te pongas a la defensiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230410604,
					"content": "Este debe ser el gato del que hablaba Nermín. Vamos a darle de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230410605,
					"content": "Bajo la atenta mirada del felino, colocan la comida delante de él...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410606
					]
				},
				{
					"id": 230410606,
					"content": "Está comiendo que da gusto. Volvamos a contárselo a Nermín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
