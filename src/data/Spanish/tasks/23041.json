				},
				{
					"id": 230410902,
					"content": "Nermín empieza a preparar su sopa especial de menta y frijoles...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410903
					]
				},
				{
					"id": 230410903,
					"content": "¡Listo! Humm, no se ve muy diferente a una sopa normal de menta y frijoles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410904
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410904,
					"content": "¡Pero estoy segura de que el sabor es diferente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410905
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410905,
					"content": "#Viajer{F#a}{M#o}, por favor, llévale este tazón de sopa a Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410906
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410906,
					"content": "Todavía tengo que preparar un poco más para la abuela Kulsum. Ebeid e Hilmi dijeron que también les gustaría probarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410907,
						230410909
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410907,
					"content": "No te exijas demasiado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410908
					]
				},
				{
					"id": 230410908,
					"content": "Lo sé. Solo son un par de tazones de sopa. No es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410911
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410911,
					"content": "En fin, llévale esta sopa de menta y frijoles a Raef, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410912
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410912,
					"content": "Tengo que preparar un poco más para Nawaz y Ramiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410909,
					"content": "Tienes mucha energía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410910
					]
				},
				{
					"id": 230410910,
					"content": "Bueno, es que al fin puedo hacer algo útil. No puedo echar a perder esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410911
					],
					"speakerTitle": "Nermín"
				}
			]
		},
