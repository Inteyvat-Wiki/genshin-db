					"nextDialogs": [
						230411005
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411005,
					"content": "#Bueno, viajer{F#a}{M#o}, gracias por tu ayuda. Aquí tienes tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
