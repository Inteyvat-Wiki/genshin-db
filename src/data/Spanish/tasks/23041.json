			"dialogs": [
				{
					"id": 230410501,
					"content": "#Viajer{F#a}{M#o}, ¿conseguiste el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410502
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410502,
					"content": "Se podría decir que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410503
					]
				},
				{
					"id": 230410503,
					"content": "¡Excelente! Voy a regar las flores. Espera un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410504
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410504,
					"content": "Nermín comienza a regar las flores...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410505
					]
				},
				{
					"id": 230410505,
					"content": "*Suspira*, con eso debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410506
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410506,
					"content": "La abuela Kulsum dice que hay que parar de regar las plantas cuando el agua comience a salir por debajo de la maceta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410507
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410507,
					"content": "Así la tierra estará húmeda. Después, hay que regarlas una vez cada tres días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410508
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410508,
					"content": "#¡Ay! Lo siento, estoy hablando sola. Esta es la recompensa. Gracias por tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410509
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410509,
					"content": "¿Cuál es la mejor herramienta para podar las hojas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				}
			]
		},
