				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304101",
							"2"
						],
						"stepId": 2304101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"3",
							"23041"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#¡Viajer{F#a}{M#o}, llegas justo a tiempo! Ven, prueba la sopa de menta y frijoles que he preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410303,
					"content": "Estos ingredientes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Algunos los compré, pero la menta la cultivé yo misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410305,
					"content": "Raef me regaló un juego de herramientas de jardinería y un montón de fertilizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410306,
					"content": "Pensé que sería un desperdicio plantar solo una maceta de flores, así que le pedí a Azalai que me comprara algunas semillas de menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410307,
					"content": "Después de plantarlas, las cuidé igual que a las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410308,
					"content": "Con mucho cuidado y atención, la menta creció sana y sin problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410309,
					"content": "Recogí algunas hojas y preparé sopa de menta y frijoles. ¿Qué te parece? No está mal, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410310,
					"content": "Ahora que has probado mi sopa de menta y frijoles, tienes que hacerme un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410311,
					"content": "Todavía no la he terminado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "¡Oye! Solo estoy bromeando, ¡te pagaré como es debido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410314,
					"content": "Quería pedirte que me ayudes a recolectar tres duraznolivas. A Raef le encantan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410315,
					"content": "Quiero agregarlas a la sopa de menta y frijoles, y llevársela a Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410316,
					"content": "Ya sé cómo preparar la sopa, solo necesito que alguien me ayude a recolectar las duraznolivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410317,
					"content": "Entiendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Gracias. Te invitaré otro tazón de sopa cuando vuelvas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410321,
					"content": "#Lo dejo en tus manos, viajer{F#a}{M#o}. Vuelve a buscarme cuando encuentres las duraznolivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410319,
					"content": "¿Podrá tomarla durante el trabajo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Solo es un tazón de sopa. En su trabajo no le exigen tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410312,
					"content": "¡Te la devuelvo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
		},
