			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Oh, no... Parece que algo se está comiendo las hojas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410202,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "#Viajer{F#a}{M#o}, ¡mira! ¡Otra vez ese gato ha venido a morder mis flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410204,
					"content": "Mira esta hoja, ¡y esta otra! ¡Les han dado un buen mordisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410205,
					"content": "¿Será que el gato tiene hambre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Raef dijo lo mismo. Incluso le llevó comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410207,
					"content": "Pero al día siguiente, regresó a mordisquear mis flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410210,
					"content": "Por ahora solo mastica las hojas, pero temo que luego empiece a morder los tallos. Eso sería terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410211,
					"content": "No puedo ahuyentarlo tan lejos. Después de todo, hay un desierto ahí fuera y no tiene otro lugar a dónde ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410212,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ayudarme a alimentar al gato? Espero que no vuelva a morder las flores cuando esté lleno. Además, las hojas no son tan sabrosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410213,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "#Entonces, lo dejo en tus manos, viajer{F#a}{M#o}. Voy a marcar en el mapa los lugares donde el gatito pasa más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410217,
					"content": "Me quedaré aquí cuidando las flores en caso de que vengan otros gatos a morderlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410214,
					"content": "#Soy expert{F#a}{M#o} en gatos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "¡Excelente! Cada vez que veo las patitas de un gato, me preocupa que se abalance sobre mí y me arañe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410208,
					"content": "¿Le gusta jugar a morder las hojas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "No entiendo con qué le gusta jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermín"
				}
			]
		},
		{
			"id": 2304103,
			"completionStepIds": [
				2304101,
