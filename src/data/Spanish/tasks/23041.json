			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "*Suspira*, debería bastar con remover la tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410102,
					"content": "¿Todavía sigues cuidando de las flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Así es. La abuela Kulsum me ha enseñado muchas cosas sobre el cuidado de las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410104,
					"content": "Por ejemplo, hay que remover la tierra y podar las hojas cada cierto tiempo. También hay que librarse de los mosquitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410105,
					"content": "Y no se pueden regar en exceso o las hojas acaban por pudrirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410106,
					"content": "*Suspira*, y yo que pensaba que tenía que regarlas todos los días y mantener la tierra húmeda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410107,
					"content": "Aunque así es mejor, porque no tengo que ir a buscar agua todos los días. La fuente está muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410108,
					"content": "#Bueno, debería terminar de podar estas hojas. Viajer{F#a}{M#o}, si no te importa, ¿podrías traerme algo de agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410109,
					"content": "He hablado con Kazán y me ha dado permiso para recoger agua para las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410110,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "La vasija está ahí mismo. Ten cuidado cuando recojas el agua, asegúrate de que esté limpia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410111,
					"content": "¿La abuela Kulsum te enseñó todo eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Bueno, más o menos. La abuela Kulsum sabe muchas cosas. Siempre acudo a ella para que me dé consejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410113,
					"content": "#Bueno, cuento contigo, viajer{F#a}{M#o}. Solo necesito una vasija de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermín"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
