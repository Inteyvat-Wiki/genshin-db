			"dialogs": [
				{
					"id": 230410701,
					"content": "#Viajer{F#a}{M#o}, ¿encontraste al gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410702,
						230410703
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410702,
					"content": "Sí, ya le di de comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410704
					]
				},
				{
					"id": 230410704,
					"content": "Qué bueno. Espero que no vuelva a morder mis flores. Después de todo, la comida para gatos sabe mejor que las hojas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410705
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410705,
					"content": "#Gracias por tu ayuda, viajer{F#a}{M#o}. Aquí está tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410706
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410706,
					"content": "*Suspira*, espero que a ese gato no le dé hambre tan pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230410703,
					"content": "Sí, ya debería estar lleno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
