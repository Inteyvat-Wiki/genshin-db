			"dialogs": [
				{
					"id": 732150601,
					"content": "#Nara rubi{F#a}{M#o}, cosa blanca voladora, ¡están aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "¡Sí! ¡Hemos vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Jeje... Aragaru ha olvidado muchas cosas, necesito su ayuda para recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "¿Es debido al kusava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Sí, Aranaga debió decirlo. El poder está en la memoria, y sin memoria no hay poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Por eso... debimos haber experimentado algo en pasado, pero no recordamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Jaja, ¡pero no pasa nada! Todavía podemos hacer nuevos recuerdos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150608
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150608,
