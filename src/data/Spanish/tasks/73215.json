			"dialogs": [
				{
					"id": 732150401,
					"content": "#¡Hola, nara rubi{F#a}{M#o} y cosa blanca voladora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150402,
					"content": "¡Hola! ¿Cómo te va últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150403,
					"content": "Muy bien, ¿pero ustedes porqué estar aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150404,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150405,
					"content": "Bueno... Preocuparnos. Debe haber razón. Pero Aranaga no saber ustedes qué hacer aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150406,
					"content": "#¡Estamos familiarizad{F#as}{M#os} con este lugar después de todas las aventuras que tuvimos juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150407,
					"content": "Humm... ¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150408,
					"content": "No recuerda nuestras experiencias pasadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
