			"dialogs": [
				{
					"id": 732150201,
					"content": "¡Hola, hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "#¡Hola, pequeñín! ¿Te acuerdas de nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "¡Cosa blanca voladora mala! ¡Aranakin no es pequeñín! ¿Aún recuerdan canción que enseñé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "¡Bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "Entonces prometan que aunque Aranakin olviden canción, ¡ustedes recordarán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
