			"dialogs": [
				{
					"id": 761870401,
					"content": "¡Esta comida está deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761870402,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870404,
					"content": "¡¿Eh?! ¿Tan pronto? ¡Gracias, Sandrone! ¡Espero volver a verte en otra ocasión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maime"
				},
				{
					"id": 761870403,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
