			"dialogs": [
				{
					"id": 790260101,
					"content": "#¡Bienvenid{F#as}{M#os}, bienvenid{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260102,
					"content": "#¡Bienvenid{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260104,
					"content": "#¡Tú debes de ser {F#la renombrada}{M#el renombrado} {NICKNAME}! Y tú, la mejor compañera de aventuras: ¡Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260105,
					"content": "¡Guau! ¿Cómo sabes cómo nos llamamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "Es mi deber conocer el nombre de los huéspedes más apreciados de nuestra isla. Al fin y al cabo, yo soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260107,
					"content": "¿Tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "¡Soy el famoso director de la Compañía de Teatro Crepúsculo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260109,
					"content": "Así que hay gente que se refiere a sí misma como “famosa”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Y si eres tan famoso, ¿cómo es que no hemos oído hablar de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "¡No pasa nada! ¡Ahora ya me conocen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260112,
					"content": "Tras todos los preparativos acometidos, ¡nuestra obra de teatro, «La leyenda de la princesa guerrera», está a punto de estrenarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260113,
					"content": "El espectáculo consta de cinco actos, cada uno de ellos dividido en dos escenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260114,
					"content": "#Distinguid{F#as}{M#os} invitad{F#as}{M#os}, ¡llegan justo a tiempo! ¡El espectáculo está a punto de comenzar! Por favor, ¡tomen asiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260115,
					"content": "Todavía quedan algunas cosas por hacer entre bastidores, así que, si me disculpan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				},
				{
					"id": 790260116,
					"content": "¡La mejor producción teatral de la Compañía de Teatro Crepúsculo está a punto de comenzar! ¡Disfruten de la función!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Director de la Compañía de Teatro Crepúsculo"
				}
			]
		}
	]
}