			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Espera, ¿es ese...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "¿El Alcor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "En realidad, este es el segundo barco de nuestra flota. El Alcor está en casa, patrullando el Bosque de Piedra Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "¡Beidou, la infame capitana mercenaria que navega por alta mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Jaja, no es la primera vez que nos vemos. ¿A qué viene tanta pompa y circunstancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "#Bueno, no os quedéis ahí parad{F#a}{M#o}s. Sentáos y contádmelo todo. Haré que mis muchachos l{F#a}{M#o}s atiendan como merecen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ya veo, conocéis a la jefaza de la Cámara de Secretos, ¿eh? Vuestros contactos nunca dejan de sorprenderme, eso está claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "Por cierto, lo del registro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "¡Ah, sí! Tenemos que registrar quién participará en la exposición y con qué planea comerciar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "En ese caso, registradme a mí y a algunos de mis muchachos como participantes. El resto permanecerá en el barco. En cuanto a nuestra mercancía... Echad un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "¿Qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Hace un tiempo, Ninguang mejoró la Balista Guizhong. La belleza que tenéis ante vuestros ojos ahora es uno de sus nuevos modelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Tiene una potencia de fuego increíble y viene con un sistema de guiado remoto para ataques precisos incluso a larga distancia. ¡Seguro que la gente se peleará por hacerse con una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "¡¿Seguro que puedes vender algo así?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Jaja, no os preocupéis. Este modelo podría ser una antigualla comparado con el que usa la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "... Vaya, Néfer no bromeaba cuando dijo que aquí se comercia sin restricciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Pero ¿quién compraría algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, seguro que alguien picará el anzuelo. Después de todo, habrá compradores de todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "¿Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, perdonadme, estaba tan ocupada descargando la mercancía que olvidé mencionar que Yelan estaba a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "No pasa nada. ¿Tú también has venido a la exposición, Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "No, solo estoy aquí por trabajo. La Capitana Beidou tuvo la amabilidad de traerme. Así que no hace falta que me registren para la exposición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#En fin, cuánto tiempo, {NICKNAME}. Si tienes la ocasión, saluda de mi parte a la dueña de la Cámara de Secretos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "¿Qué tipo de trabajo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "El tipo que es... delicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Parece que es nuestra señal para dejar de hacer preguntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "A mí también me lo parece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "#Bueno, yo me marcho ya. Cuando termine con lo mío, l{F#a}{M#o}s invitaré a un trago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Jaja, qué ganas de probar a qué sabe Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Bien, con esto queda completado el registro. Síguenos, te llevaremos al recinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
