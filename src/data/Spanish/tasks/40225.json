			"dialogs": [
				{
					"id": 402250201,
					"content": "#Beidou da instrucciones a su tripulación para que descarguen la mercancía y l{F#a}{M#o}s sigue hasta el recinto del evento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "¡Así que es aquí! ¡No está nada mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Cuando tengáis algo de tiempo, venid a ayudarme a poner a prueba el sistema de guiado a distancia de este cacharro. Es muy emocionante, seguro que os encanta.",
					"roleType": "TALK_ROLE_NPC",
