			"dialogs": [
				{
					"id": 230380101,
					"content": "#¡Viajer{F#a}{M#o}, ven, corre! Tengo un favor que pedirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "¿Qué ha ocurrido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "¿Te acuerdas de Maruf, el doctor de la Aldea Aaru? Te pidió que vinieras a pedirme unas medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "El pobre se tomó un cuenco entero de un remedio que había preparado él mismo y lleva ya varios días vomitando sin parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Me dijo que la receta original no había surtido efecto en el paciente, así que hizo un par de ajustes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Cómo ha hecho para convertir una receta tan simple en algo tan nocivo es algo que no entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "*Suspira*... Si se hubiera limitado a ajustar las cantidades y el método de cocción, esto no habría pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Y ni siquiera es la primera vez que pasa. No me explico cómo es que no aprende la lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "En fin, eso ahora no importa. Supongo que tendrá sus motivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "#Viajer{F#a}{M#o}, ¿podrías traerme algunos ingredientes? Yo mismo le prepararé un remedio a Maruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "Maruf modificó la receta que le di la última vez para las migrañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Necesitaré tres añoraescarlatas más para la receta. ¿Te importaría traérmelas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "¿Esto ya ha pasado antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Así es. Ha pasado tantas veces que he perdido la cuenta. Al menos no tiene por costumbre usar ingredientes venenosos. Si no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
