			},
			"dialogs": [
				{
					"id": 230381101,
					"content": "Humm, no creo que sea cosa de los ingredientes y tampoco parece que haya nada mal con el proceso de cocción. ¿Qué habrá salido mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "#V-viajer{F#a}{M#o}, ¿qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "El Dr. Zakariya te envía un remedio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Entonces supongo que ya habrás escuchado lo que ha pasado. Siento que hayas tenido que tomarte las molestias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Deberías tomarte la medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "Ah... Bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf se bebe el remedio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Uff, ya me encuentro un poco mejor. El Dr. Zakariya es un profesional de primera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "¿Por qué estabas intentando modificar la receta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "¿Te acuerdas de cuando preparamos juntos aquella medicina? No surtió un gran efecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "Supuse que había algún error en el método de elaboración, o tal vez se trataba de los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "Así que intenté prepararla yo mismo con base en mi experiencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Siempre las pruebo yo primero para asegurarme de que son seguras, pero no salió bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Justo acabo de enviar a alguien a pedirle al doctor algún remedio. No esperaba ver a nadie con la medicina aquí tan pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Creo que descansaré un poco más antes de volver al trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Llevo un par de días enfermo, seguro que hay muchos pacientes esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*Suspira*, pero me estoy quedando sin medicinas otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
