			"dialogs": [
				{
					"id": 715100101,
					"content": "¿Qué tal? ¿Lograste poner en funcionamiento el Clavo de Pursina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100102,
					"content": "Sí. Fue un éxito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Excelente, excelente. Aunque el Clavo de Pursina no puede cerrar todas las aberturas en un solo intento, al haberlo conseguido una vez, seguirá funcionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100105,
					"content": "Eso quiere decir que es solo cuestión de tiempo que las aberturas se cierren por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100106,
					"content": "Y, por lo tanto, el problema está resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100107,
					"content": "Tengo que apuntar esto. Cuando presente el informe completo sobre la investigación del Clavo de Pursina, tal vez me convierta en una figura de gran renombre dentro de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100108,
					"content": "#Sí... Puedo incluirlo en mi futura autobiografía: «Mis experimentos en la Sima con {F#la}{M#el} increíble {NICKNAME}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100109,
					"content": "Esperaré ese día con ansias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Jaja, soy bueno redactando trabajos de investigación, pero para escribir historias soy bastante malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100111,
					"content": "Espero que eso no te importe cuando llegue el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100103,
					"content": "Casi todo el fango oscuro ha desaparecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				}
			]
		}
	]
