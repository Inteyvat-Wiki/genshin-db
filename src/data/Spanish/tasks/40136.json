			"dialogs": [
				{
					"id": 401360201,
					"content": "Hasta aquí llega mi trabajo. A partir de aquí, tú te encargas de estos tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360202,
					"content": "¿Es que tienes más cosas que hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360203,
					"content": "Sí, ir a una fiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360204,
					"content": "Vaya, eso sí que es algo que no ocurre todos los días. ¿Es una nueva afición tuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360205,
					"content": "No, pero es una fiesta muy especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360206,
					"content": "¡Chevreuse, Wriothesley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360207,
					"content": "Los festivales realmente unen a la gente. Hacía tiempo que no recibía tantos visitantes en el Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360208,
					"content": "Bueno, al fin y al cabo, se trata del Festival Fontinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360209,
					"content": "Pues sí. De hecho, Sigewinne ha estado preparando unos batidos nutritivos de lujo. Con un solo trago, tendrás todos los nutrientes que necesitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360210,
					"content": "¿Estaban hablando de trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360211,
					"content": "Ya hablamos de lo que teníamos que hablar. Bueno, Wriothesley, ¿qué te parece mi “saludo”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360212,
					"content": "Aún no te he dicho que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360213,
					"content": "Pero tampoco has dicho que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360214,
					"content": "Tengo una idea, ¿y si le damos a cada persona un periódico con, por ejemplo, una noticia de hace veinte años en la portada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360215,
					"content": "Entonces, creo que cierta persona se convertirá en la persona más desafortunada del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360216,
					"content": "Y a los otros dos los considerarán héroes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360217,
					"content": "Hablando de héroes, ¿por qué me buscaban ustedes dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360218,
					"content": "Ah, sí, veníamos a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360219,
					"content": "A invitarme a una fiesta, ¿a que sí? Como ven, no me he olvidado de qué día es hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360220,
					"content": "Jeje, ¡pues andando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360221,
					"content": "¡Nos vamos, Wriothesley! ¡Feliz Festival Fontinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360222,
					"content": "Felices fiestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
