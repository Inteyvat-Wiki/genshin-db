					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401361102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401361102,
					"content": "Claro, confía en mí. ¿Cuándo me he equivocado con algo como esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
