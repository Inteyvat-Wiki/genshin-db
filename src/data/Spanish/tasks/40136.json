			"dialogs": [
				{
					"id": 401360101,
					"content": "Un tiempo después de todo lo ocurrido...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "¡Ey, Xavier! ¡Hace tiempo que no nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "¡Hola! Lo siento, tras la posproducción, me concentré en las labores de promoción y proyección de la kinografía y no daba abasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "Hoy es la gala de premios, ¿verdad? Paimon se pregunta si nuestra kinografía ganará el Premio Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Estoy segura al 90% de que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "¡Furina, tú también estás aquí! Y llegaste más pronto que los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "No creo que tarden mucho en llegar. Por cierto, Xavier, hablando de la gala de premios, ¿no deberías ponerle un nombre a nuestro equipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "¿Eh? Pero es que aún no sé si ganaremos el premio y... n-no me gusta cantar victoria antes de tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Vamos, ¿es que no viste las reacciones del público tras ver la kinografía? ¡Todas eran positivas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "¿No hablaste con los empleados de la Ópera? ¿Acaso no querían que la kinografía se proyectara más veces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Con las ganancias de las entradas te daría suficiente para abrir tu propia productora kinográfica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "¡Pero el mérito no es todo mío! Fue fruto del esfuerzo de muchas damas y caballeros de buen corazón, ¡así que no puedo poner el nombre yo solo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Bueno, tú piénsalo bien. Estoy segura de que a todo el mundo le gustará el nombre que le pongas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Bueno... pero antes de nada, {NICKNAME}, Paimon, ¿podrían hacerme un favor e ir al Fuerte Merópide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "¿Eh? Pero ¿y la gala de premios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Quiero que vayan a buscar a una de nuestras protagonistas, la Srta. Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Últimamente no la he visto, así que tampoco he podido invitarla a la gala de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Pero según la prensa, la misma capitana de la Unidad Especial de Seguridad y Vigilancia llevará personalmente al Fuerte Merópide a los culpables del caso del asesinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Oooh, ¡por eso nos estás pidiendo ese favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Dalo por hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "¡Eso! Tú quédate aquí pensando en un buen nombre, Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "De acuerdo, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
