			"dialogs": [
				{
					"id": 401360301,
					"content": "La kinografía ganadora del Premio Furina de la primera edición del Festival Fontinal Kinográfico es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "Presentadora"
				},
				{
					"id": 401360302,
					"content": "¡«Las dos mosqueteras»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "Presentadora"
				},
				{
					"id": 401360303,
					"content": "¡Nosotros! ¡Somos nosotros!",
					"roleType": "TALK_ROLE_NPC",
