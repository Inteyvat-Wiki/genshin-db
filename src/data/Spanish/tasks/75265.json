			"dialogs": [
				{
					"id": 752650301,
					"content": "#¡Ey, amig{F#as}{M#os}! Tengo buenos productos a... ¿Otra vez ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "Ya les dije que no les iba a vender nada. ¡Lárguense de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "¡Oye! ¡Aún estás a tiempo de disculparte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "¿Qué les pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "Estás vendiendo falsificaciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "#¿Y? Les aconsejo que no se metan donde no l{F#as}{M#os} llaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
