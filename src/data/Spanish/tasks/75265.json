				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "#¡Ey, amig{F#as}{M#os}! Tengo buenos productos a buen precio. ¿Quieren verlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "¿Eh? ¿No son los muñecos de Koholasaurio que vimos en el Mercado Brisapacible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Tienes buen ojo. Pero los míos son más baratos, te lo dejo a mitad de precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "¿Por qué tan barato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Jeje, no preguntes tanto, amiga. Tengo mis contactos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Son mucho más baratos, pero a Paimon le parece que tienen un color extraño. No serán copias, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Perdona, ¿copias? No tienes idea de lo que estás diciendo... ¡Largo de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "¡He dicho que largo! No se los vendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
