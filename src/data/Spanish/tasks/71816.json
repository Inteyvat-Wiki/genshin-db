			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Aquí es donde almacenan las mercancías. Ya que te ofreciste a ayudarme, ¿podrías escoltar este globo con cargamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Recuerda que estos materiales para fabricar linternas celestes son muy frágiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Sería un desastre si se rompieran o se quemaran. Así que debes tener mucha precaución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "De vez en cuando, pasan monstruos y ladrones de tesoros por este camino, así que no bajes la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Bueno, dejo este pedido en tus manos. Llévaselo sano y salvo a Francis. Cuando termines, nos vemos en las afueras del puente al suroeste del Peñasco Chihu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181603,
