				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Oh, estos son... los materiales que pedí. ¡Por Los Siete! Al fin llegaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "#¿Eres {F#la}{M#el} escolta? A juzgar por tu vestimenta, tú tampoco eres de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "#Querid{F#a}{M#o} amig{F#a}{M#o}, ¿has probado la gastronomía de Liyue? Créeme, es una verdadera delicia. Deberías ir a probarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "De acuerdo, ahora que llegó mi pedido, puedo ir con tranquilidad a disfrutar de su comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
