			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "¿Cómo voy a entregar todo esto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#Ah, eres tú, viajer{F#a}{M#o}. Estás de suerte, viniste justo al inicio del Rito de la Linterna. Pero mi suerte no puede ser peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "La gente de Liyue solemos liberar linternas celestes durante el Rito de la Linterna, así que cada año en esta época, los pedidos de materiales para linternas son enormes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "No sé si es solo impresión mía, pero parece que este año hay mucho más cargamento que en años anteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "Yo sola no puedo ocuparme del trabajo, y ese comerciante de Fontaine no entiende cómo son las rutas comerciales de Liyue. Lleva mucho tiempo presionándome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "Estaba pensando pedirle ayuda a alguien, pero no encuentro a la persona adecuada. Si puedes, ¿estarías de acuerdo en escoltar los materiales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "¡Bien! Me gusta la gente directa. Ojalá ese cliente fuera directo al grano como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "¿Cómo se llamaba? ¿Fran... Francis? Algo así. No soy buena recordando nombres extranjeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Si estás de acuerdo, nos vemos en el almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "Marqué el punto exacto en el mapa. Yo me adelantaré, nos vemos pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "¿Un cliente de Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Así es. Se llamaba Fran... ¿Francis?... algo así. No soy buena recordando nombres extranjeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "No sé para qué pidió tantos materiales para linternas celestes, pero... una tiene que ganarse el pan, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "No te preocupes, si me ayudas, te daré una generosa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
