			"dialogs": [
				{
					"id": 718160301,
					"content": "¿Dónde está esa carga? Mi estómago ya está rugiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181604,
			"completionStepIds": [
				7181605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181605",
							"2"
						],
						"stepId": 7181605,
						"stateName": "QUEST_STATE_UNFINISHED"
