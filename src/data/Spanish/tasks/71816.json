			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Ya hablé con Francis, dijo que ya recibió los productos. Te debo una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "¿En qué momento hablaste con él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Jaja, no le prestes mucha importancia. Igual que nuestras redes de comunicación, las piernas de un escolta son más rápidas que las de una persona común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "Gracias por tu ayuda. Lo más justo es darte una recompensa, así que no te decepcionaré. Espera un segundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "¿Acaso no descansas ni durante el Rito de la Linterna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "En este sector, no sabes cuándo habrá trabajo. Ni siquiera puedes regresar a casa durante el Rito de la Linterna. Pero no hay remedio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Parece que has recorrido todos los rincones del continente. Durante el Rito de la Linterna, la gente suele liberar linternas celestes, deberías probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "¿A ti no te interesa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Estoy ocupada yendo de aquí para allá todo el año. ¿Cómo voy a tener tiempo para liberar una linterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "Si tuviera una preparada, podría liberarla para pedir buena suerte, pero ni siquiera tengo tiempo para hacerla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "Sé que me estoy perdiendo el ambiente festivo, pero qué puedo hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Te ayudaré a hacer una linterna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "#¿Eh? ¿Harías una linterna celeste por mí? Si estás tan entusiasmad{F#a}{M#o} por hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "¿Has liberado linternas celestes alguna vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "#Para nada. Gente errante como nosotr{F#as}{M#os} no tenemos tiempo para trivialidades como esa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181607,
			"completionStepIds": [
				7181608
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181608",
							"2"
						],
						"stepId": 7181608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160701,
					"content": "¿Oh? Esta linterna no está nada mal. Muchas gracias. Déjame pensar... ¿qué deseo escribiré en ella?...",
					"roleType": "TALK_ROLE_NPC",
