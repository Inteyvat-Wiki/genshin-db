				]
			},
			"dialogs": [
				{
					"id": 760830401,
					"content": "Adelante, amigas mías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830402
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830402,
					"content": "A ver si pueden adivinar el dibujo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830403,
						760830407,
						760830412
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830403,
					"content": "La luna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830404
					]
				},
				{
					"id": 760830404,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830405
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830405,
					"content": "Jeje, ¡era bastante obvio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "#Me temo que la adivinanza era demasiado sencilla para nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830407,
					"content": "Una anguila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Oigan, ¡¿qué le pasa a esta anguila en la cintura?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "Saben ustedes un montón de cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830410,
					"content": "La respuesta correcta es “la luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830411,
					"content": "Vengan. Lo hicieron muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830412,
					"content": "Un arco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "¡Cualquiera que tenga ojos sabría que es un arco! ¡¿Cómo va a ser tan simple la respuesta?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Aunque técnicamente no es incorrecto, me temo que esa no era la intención de las kuuhenki al hacer el dibujo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830415
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830415,
					"content": "La respuesta correcta es “la luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830416
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760830416,
					"content": "Vengan. Lo hicieron muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
