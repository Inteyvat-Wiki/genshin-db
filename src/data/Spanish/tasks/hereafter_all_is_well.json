					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Sí que es un proyecto grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "De verdad estás restaurando este lugar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Oh, eres tú. Pues, sí, ya he dicho que soy un ciudadano honrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Pero no esperaba que este proyecto fuera tan grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "El maestro que diseñó el nuevo templo se emocionó mucho cuando le dije que este era un templo Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "No solo diseñó decenas de planos, también me llevó a comprar materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Creo que si fuera unas décadas más joven, habría insistido en hacer el trabajo él mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "¿No te has encontrado con ningún peligro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "¿Peligro? Oh, ¿te refieres a monstruos o ladrones de tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "No te preocupes. Cuando el Ministerio de Asuntos Civiles se enteró de que estaba reparando un templo Yaksha, envió algunos miembros de la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Han ahuyentado a casi todos los monstruos que se encontraban cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "En cuanto a los ladrones de tesoros... Mientras vean que la Geoarmada se encuentra por aquí, no se atreverán ni a asomarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Sin embargo, la cantidad de trabajo necesario para reparar el templo ha superado mis expectativas. Los materiales que preparamos no eran suficientes, por lo que tuvimos que traer más de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Creo que... aunque los ladrones de tesoros no se atreverían a actuar en el lugar de la construcción, podrían tender una emboscada en el camino para robar los materiales durante su entrega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "La Geoarmada puede defender la construcción, pero no creo que puedan ayudar a los que entregan los materiales si los Ladrones de Tesoros los atacan en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "¿Podría pedirte un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "#Sé que eres muy buen{F#a}{M#o} en lo que haces, esos ladrones de tesoros no son rivales para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "¿Podrías darles una lección para que dejen de interrumpir nuestro trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Gracias, ¡muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "¿Por qué no solicitas ayuda a la Geoarmada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Ya están bastante ocupados vigilando el lugar de la construcción día y noche. No quiero exigirles más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "#Prefiero dejar esto en tus manos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Recuerdo que esta área no es la más segura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "¿Quieres decir que está rodeada por monstruos y ladrones de tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
