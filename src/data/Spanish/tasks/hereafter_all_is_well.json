			"dialogs": [
				{
					"id": 718300701,
					"content": "¡Has vuelto! ¿Hay ladrones de tesoros en los alrededores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Oh, ya se fueron... Bien, muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "¿Hay algo más en lo que podamos ayudarte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Jajaja, gracias por preocuparte. Ya me ayudaron bastante, no estaría bien pedirles nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Aunque, si no te molesta, podrías ayudarme a buscar <color=#00E1FFFF>madera de resistearenas</color>. ¡Así estarías contribuyendo a la reparación del templo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "Después de todo, reparar un templo es una buena acción, quizás te traiga algo de buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Voy a buscar la madera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Jaja, perfecto. Tráeme la <color=#00E1FFFF>madera de resistearenas</color> cuando la encuentres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "¿Alguien más ha donado materiales para reparar el templo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Humm... Para ser sinceros, no hay mucha gente que ayude. Este lugar está en medio de la nada y la mayoría ni siquiera sabe que hay un templo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "Además, ya casi nadie recuerda a Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Bueno, no hablemos más de eso. Solo tráeme la <color=#00E1FFFF>madera de resistearenas</color> cuando la encuentres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
