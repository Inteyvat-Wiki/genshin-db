			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jefe de los Ladrones de Tesoros"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "¡Por favor, detente! ¡Nos rendimos! ¡Nos rendimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300402,
					"content": "¡Recojan sus cosas y váyanse de aquí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "S-sí, sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300405,
					"content": "Pero puedo preguntarte... ¿qué hemos hecho para ofenderte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300406,
					"content": "¿Acaso encontraste un tesoro por esta área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300407,
					"content": "Estamos restaurando un templo cerca de aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "¿Re-restaurando un templo? ¿Aquí? ¿En medio de la nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300409,
					"content": "... ¡¿Hay un templo conmemorativo de un Adeptus aquí?! Un momento, ¿podrá ser aquella casa vieja?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300410,
					"content": "Jefe, la última vez que descansamos ahí, vimos una estatua de un pájaro. Debe haber sido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Ladrón de Tesoros subordinado"
				},
				{
					"id": 718300411,
					"content": "Era Pervases, un Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300413,
					"content": "¡J-jefe! ¿Hemos ofendido a un Adeptus?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Ladrón de Tesoros subordinado"
				},
				{
					"id": 718300414,
					"content": "¡N-no digas tonterías! No lo sabíamos, fue... ¡fue sin querer! Los Adeptus no deberían... no deberían culparnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300415,
					"content": "Bueno, ahora ya sabemos que están reparando el templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300416,
					"content": "Disculpen nuestra ignorancia, no sabíamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300417,
					"content": "Regresemos y avisemos a los demás de que no se acerquen al templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300418,
					"content": "Jefe, ¿deberíamos ir y encender algo de incienso para disculparnos con los Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Ladrón de Tesoros subordinado"
				},
				{
					"id": 718300419,
					"content": "¿Qué tonterías dices? ¡Vamos, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jefe de los Ladrones de Tesoros"
				},
				{
					"id": 718300403,
					"content": "No vuelvan a acercarse a este lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
