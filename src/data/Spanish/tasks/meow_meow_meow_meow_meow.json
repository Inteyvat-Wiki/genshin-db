			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "¡Lo han traído de vuelta! ¡Buen trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Parece que se les da bastante bien el felinés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Esto es para ti, como recompensa por tu trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Es raro encontrar a alguien que pueda aprender tan rápido el felinés, así que tal vez te pida ayuda de nuevo en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "¡Ya puedes hablar normal! ¡La Srta. Sareh no es un gato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Por tu expresión, supongo que querías decir “no hay problema”, pero tendrías que mejorar la pronunciación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "#No te preocupes, seguiré enseñándote felinés en el futuro. ¡Así podemos aprender junt{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
