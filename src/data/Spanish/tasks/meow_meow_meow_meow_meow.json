			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "Miau... *Ejem*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "Estoy buscando a mis gatitos. Normalmente me responden cuando los llamo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120104,
					"content": "¿Será que hoy no lo estoy pronunciando bien? Llevo llamándolos un buen rato, pero no me contestan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120105,
					"content": "¿Y por qué no los llamas por sus nombres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "Pues sí, a Paimon le parece más normal llamar a los gatos por su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120107,
					"content": "¿De qué sirve llamarlos por su nombre en nuestra lengua? No la entienden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120108,
					"content": "Humm, tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120113,
					"content": "Pero seguir gritando así tampoco parece un gran plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120114,
					"content": "#Viajer{F#a}{M#o}, quiero hacerte una pregunta muy seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120115,
					"content": "Yo me encar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "¿Quieres aprender felinés?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120118,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120120,
					"content": "¿Estás diciendo que vas a enseñarnos a hablar como los gatos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120116,
					"content": "¿Cuál será la recompen...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "¿Por qué dices que no lo has pronunciado bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Porque lo que estaba maullando eran los nombres de los gatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120111,
					"content": "Después de todo, ¿de qué sirve llamarlos por su nombre en lengua humana? No lo van a entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120112,
					"content": "Humm, tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
