				"points": []
			},
			"dialogs": [
				{
					"id": 230121101,
					"content": "Yo también hablé una vez con un gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "¿Te refieres a Neko? Claro, Neko sabe hablar la lengua humana. No es porque realmente hables felinés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Pero, a cambio, necesito que traigas uno de mis gatitos de vuelta a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Trato hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Entonces, ¿me ayudarás? Te lo agradezco de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "*Ejem*, entonces, presten atención. Me ha llevado mucho tiempo recopilar todos estos sonidos. Lo llamo «Glosario de terminología felinesa».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Cada ciudad tiene su propia manera de buscar gatos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Jajaja, es verdad. Ahora que Paimon se acuerda, hemos ayudado a buscar gatos en muchos lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Paimon supone que es porque a todo el mundo le gustan los gatitos... O, tal vez, porque todos los dueños de un gato tienen que pasar por las mismas dificultades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
