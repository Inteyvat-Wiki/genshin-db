			"dialogs": [
				{
					"id": 230121501,
					"content": "Hoy se ha escapado una gatita muy juguetona de color negro y blanco que se llama Lale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121502
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121502,
					"content": "Para llamarla en felinés tienes que decir: Miau, miau miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121503
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121503,
					"content": "Recuerda que primero es un tono descendente y luego uno ascendente. El último debe ser muy alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121504
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121504,
					"content": "Tal vez deba apuntártelo. Espera aquí un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
