						],
						"pointId": 350400157
					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "¡Houra! ¡Hazme caso y no te muevas! ¡Solo es un baño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "Gruuu, gruuu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200103,
					"content": "Vamos, pequeño, ¿qué te parece si nos damos un baño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Mira, ese estanque de ahí está bien cerca. En cuanto estés limpio, podremos volver a jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200106,
					"content": "¡Eh, espera! ¡No salgas corriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "¿Acaba de pasar algo corriendo a toda prisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "¿Estás de visita en la tribu? Lo siento mucho, Houra está muy revoltoso últimamente, no deja de correr todo el rato. Espero que no te haya asustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "¿Estabas intentando que se diera un baño?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "¿Intentándolo? *Suspira*, más bien rogándoselo. Ha llovido mucho últimamente, así que siempre se llena de barro cuando sale a jugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Quiero lavarlo bien, pero a él no le interesa nada más que el juego. Siempre va correteando por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Y yo... No soy más que un humano, no podría seguirle el ritmo aunque quisiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "¿Has probado a usar comida como cebo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Sí, pero parece adivinar mis verdaderas intenciones y, si ve que estoy cerca, no come nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Y en cuanto aparto la mirada, sale de debajo de la tierra, se lo come todo y vuelve a escabullirse por el agujero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Es un Tepetlisaurio, al fin y al cabo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Así es. No me atrevo a pensar en el caos que sembrará cuando crezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Solo espero que no se ponga a excavar en la tienda de Cheven... No podría permitirme pagarle si destrozara sus gemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "*Suspira*, por ahora no me queda otra opción que probar la idea que me dio Batz. Pero... ¿de verdad le interesará a un Tepetlisaurio esta pelota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "¿Quién es Batz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Oh, es el encargado de cuidar a los Tepetlisaurios de la tribu. Es muy inteligente y tiene un gran talento para la música. Es querido tanto por saurios como por humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "La última vez que hablé con Batz sobre este problema hace mucho tiempo, me dio un plano para fabricar una flotibola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "Es algo que aprendió de Mataoho y a las crías de saurio les encanta. Intentaré hacerle una a Houra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Acabo de reunir los materiales, pero justo cuando me preparaba para empezar, Houra volvió a hacer de las suyas y no había quien lo calmara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "No hay manera, no queda otra que esperar que la flotibola funcione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "¿Qué puedo hacer yo para ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "¿Quieres ayudar? Eso estaría genial. Qué suerte he tenido de encontrarme a alguien tan amable como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Entonces te pediré que vayas hasta esa caja y me traigas unos tallos de mechaceniza. Empezaré creando la estructura de la flotibola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Si necesitas ayuda, dímelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "¡Vaya! ¡Casi me atropella!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
