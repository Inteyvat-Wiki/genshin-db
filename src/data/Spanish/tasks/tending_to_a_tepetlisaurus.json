			"dialogs": [
				{
					"id": 250201001,
					"content": "Eso es, muchas gracias. Voy a... ¡Ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201002,
					"content": "Lo siento, yo... Cuando estaba atando la estructura, me he hecho un corte en el dedo sin darme cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201003,
					"content": "Ya sabía yo que un trabajo tan meticuloso me traería problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201004,
					"content": "Espera, ataré estos tallos de mechaceniza a la estructura y la cubriré con otra capa de tela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201005,
					"content": "Cazcal continúa peleándose con la flotibola... Tres nuevos cortes aparecen en su mano, pero por fin logra acabarla...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "¡Ya está! Vamos a buscar a Houra. Seguro que se ha vuelto a poner a excavar bajo ese árbol de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201007,
					"content": "Deberías vendarte la mano primero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Oh, no te preocupes por eso, no es nada. Ya buscaré después un trozo de tela para vendármela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201009,
					"content": "Vayamos a por Houra antes, que no se pase de rosca con tanto juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
