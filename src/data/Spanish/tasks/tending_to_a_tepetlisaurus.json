			"dialogs": [
				{
					"id": 250200501,
					"content": "¿Gruuu? Gruuu, ¿gruuu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200502,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200503,
					"content": "Houra abraza alegremente la flotibola y se da un revolcón en el estanque. El agua se lleva consigo toda la suciedad de su cuerpo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Jajaja, parece que le encanta la pelota. No puedo creer que se haya metido en el estanque a jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Vamos. Supongo que cuenta como un buen lavado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "¿Gruuu, gruuu? ¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200507,
					"content": "¿Te gusta el regalo, pequeñín? Es todo tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200509,
					"content": "Con lo que cuesta darte un baño... Aunque... Jajaja, ya sé cómo lidiar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "Gruuu... Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200511,
					"content": "¿Por qué me estás tocando la mano? Esta herida... No es nada, no te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "Gruuu, gruuu... Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200513,
					"content": "¿Por qué te pones triste de repente? ¿No estabas jugando tan contento? ¿Acaso estás cansado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "#Por cierto, muchas gracias, amig{F#a}{M#o}. Esto es para ti, puedes considerarlo una recompensa. No es nada de gran valor, así que acéptalo, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "Gruuu, ¡gruuu! Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250200516,
					"content": "¡Espera! ¡No vuelvas al estanque! ¡Houra! ¡Acababa de secarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
