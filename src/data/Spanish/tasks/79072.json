					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Jeje, ¡has acertado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "¿Tanta fama tenemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "La Metrópolis de las Constelaciones siempre ha sido un lugar donde las noticias llegan pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Cabe decir que llegó en un buen momento. Acabo de terminar de crear un juego llamado “Sombrecóptero”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Aunque no puedo compararme con el sombrerero de la historia de «El artesano de sombrecópteros» y hacer que todo el mundo tenga un sombrero bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Confío en que el juego del “Sombrecóptero” hará felices a quienes lo prueben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Diseñé tres formas totalmente diferentes de jugar, pero no se preocupen, las reglas no son nada complicadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Seguro que las comprenderán con solo jugar una partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "¡Quiero probarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Sin problema, venga por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "No tengo tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "No se preocupe. Venga a verme cuando tenga un hueco, yo estaré un tiempo por aquí.",
