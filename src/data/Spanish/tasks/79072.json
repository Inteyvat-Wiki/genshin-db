			"dialogs": [
				{
					"id": 790720101,
					"content": "#Vaya, qué honor. Usted es {NICKNAME}, ¿verdad? Y su compañera debería ser la Srta. Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
