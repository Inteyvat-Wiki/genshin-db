			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "No pensé que me encontrarías tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250502,
					"content": "Está bien, es tu primera vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "Pensé que era el escondite perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250505,
					"content": "De hecho, conozco perfectamente bien los métodos para localizar espíritus malignos y tengo mucha experiencia buscando sus escondites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250506,
					"content": "Por ejemplo, este lugar está polvoriento, tiene muchas líneas rectas y está lejos de la luz. Los espíritus malignos prefieren este tipo de lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250507,
					"content": "Estás tratando de usar taumaturgia para jugar a esconderte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Sí, supongo que mi experiencia como exorcista no sirve aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250511,
					"content": "Ya que me encontraste, admito mi derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250512,
					"content": "Es solo un juego, pero es muy interesante cuando comienzas a jugarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250513,
					"content": "Podemos volver a jugarlo en otra ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Perfecto, podemos invitar a más amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250517,
					"content": "Bueno, andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250515,
					"content": "Suerte que no eras el fantasma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Jeje, tienes razón. Me hubiera tomado horas encontrar a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250509,
					"content": "Pero se te puede ver a plena luz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Humm... Supongo que estaba tan apurado que olvidé lo más importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250503,
					"content": "¿Por qué te escondiste aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
