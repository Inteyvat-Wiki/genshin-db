					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "#¡Bienvenid{F#a}{M#o}! ¿En qué puedo ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Vengo por el encargo de Nermín...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Oh, te refieres a este... Ya está listo. Son especias de alta calidad a un muy buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Nermín va a preparar un perfume con estas especias, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "Es bueno que tenga tanta energía, pero Nermín necesita cuidar su salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "¡Genial! Todavía me quedan algunos ingredientes de la vez pasada. Con los que has traído, puedo hacer unos cuantos intentos más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420502,
					"content": "*Suspira*... Voy a revisar mis apuntes una vez más. ¡Ahora sí saldrá bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420503,
					"content": "Oh, cierto. También necesito algunos pétalos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420504,
					"content": "Nermín comienza a preparar el perfume con mucho esfuerzo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "¡Ya está! Huele bastante bien. Y no es pegajoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420506,
					"content": "¡Creo que está vez lo logré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420507,
					"content": "Parece que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "¡Sí! Además compré un frasco especial para poner el perfume en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420510,
					"content": "#Viajer{F#a}{M#o}, acompáñame a entregarle el perfume a Raef. Espero que le guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420508,
					"content": "Al menos no ha sido un fracaso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
