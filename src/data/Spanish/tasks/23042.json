					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Oh, cierto, ¿has estado ayudando a Nermín con algún encargo? ¿O has oído algún rumor sobre ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "Parece que siempre está ocupada, pero nunca sé qué está haciendo.",
