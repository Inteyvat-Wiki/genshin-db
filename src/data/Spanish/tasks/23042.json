			"dialogs": [
				{
					"id": 230420801,
					"content": "#Viajer{F#a}{M#o}, ¿qué haces corriendo de un lado a otro? ¿Por qué estás tan ocupad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
