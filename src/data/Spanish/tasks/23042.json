					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Será una sorpresa para Raef, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420102,
					"content": "¿Qué sorpresa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "#¡Ay! ¡Viajer{F#a}{M#o}, me asustaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420104,
					"content": "Pero si he venido de frente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Estaba distraída, no me di cuenta de que venías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420106,
					"content": "#Viajer{F#a}{M#o}, una pregunta. ¿Has oído hablar alguna vez de algo llamado “perfume”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420107,
					"content": "La abuela Yawahir me contó que cuando era joven hacía su propio perfume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420108,
					"content": "No solo puede cubrir el sudor de las personas, existen algunos que incluso tienen efectos revitalizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420109,
					"content": "Raef trabaja como guardia en la entrada de la aldea. Hace tanto calor que todos los días suda y siempre vuelve mareado por el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420110,
					"content": "Así que quiero prepararle un perfume de menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420111,
					"content": "La abuela Yawahir me dio la receta y me ayudó a comprar los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420112,
					"content": "Pero prepararlo fue realmente complicado. Solo buscar los ingredientes me tomó mucho tiempo. Y, al intentarlo, cometí varios errores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420113,
					"content": "¡Si no me apresuro, Raef va a descubrir que estoy haciendo un perfume para él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420114,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a buscar algunos ingredientes? ¡Pero no dejes que Raef se dé cuenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420115,
					"content": "No creo que sea un problema que se entere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "De ninguna manera. He estado preparando esta sorpresa durante mucho tiempo. No dejaré que se arruine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420119,
					"content": "No es tan difícil. Solo tienes que encontrar al Sr. Azalai y recoger la mercancía que le encargué. Luego, ayúdame a buscar un poco de agua, ¡y eso es todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420120,
					"content": "#¡Recuerda pasar desapercibid{F#a}{M#o}! Raef no debe darse cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420117,
					"content": "*Suspira*, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Muchas gracias. No te preocupes, ¡te aseguro que tendrás una buena recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermín"
				}
			]
		},
		{
			"id": 2304203,
			"completionStepIds": [
				2304202
