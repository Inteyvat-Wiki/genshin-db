			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef",
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "#Nermín, viajer{F#a}{M#o}, ¿qué l{F#as}{M#os} trae por aquí? ¿Hay algún problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "No le ha pasado nada malo a las flores, ¿verdad? Todavía estoy de servicio, así que tendrán que esperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermín tiene algo para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "¡Este perfume es para ti! Es de menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420605,
					"content": "Iba a hacerlo de duraznoliva, pero por alguna razón, cuando añadía la duraznoliva, el perfume se volvía pegajoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420606,
					"content": "G-gracias, pero ¿para qué es el perfume? ¿Para repeler insectos? ¿Para marcar el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Es para mantenerte fresco. También ayuda a ocultar el olor del sudor. ¿No sientes que te marea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420608,
					"content": "Bueno, uno se acostumbra. Sería un poco extraño que dejara de olerlo de pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Entonces no lo uses. Me lo llevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420610,
					"content": "¡Oye, espera! ¡Estaba bromeando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Vamos, dame el perfume. La cabeza me está empezando a dar vueltas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Toma, póntelo en los brazos. Eso es lo que dijo la abuela Yawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420613,
					"content": "Huele muy bien. Además, deja una sensación refrescante y agradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Jeje, es la receta secreta de la abuela Yawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420615,
					"content": "#Fue gracias a la ayuda {F#de la viajera}{M#del viajero} que pude hacer un perfume tan bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 230420616,
					"content": "Solo te ayudé un poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Siento haberte molestado tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Toma, esta recompensa es para ti. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Este perfume es realmente bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Pero, humm... Nermín, ¿por qué me está saliendo un sarpullido donde me puse el perfume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
