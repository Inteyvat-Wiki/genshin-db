			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Ay, ¡qué dolor de cabeza! ¿Qué se supone que debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "¡Estoy entrenando para las pruebas de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "*Suspira*, pero no soy tan poderosa como Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "Creo que es mejor para mí centrarme en la técnica en lugar de la fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "Por ejemplo, estaba pensando en cómo romper todos estos maniquíes de madera de un solo golpe... Pero para bien o para mal, mi padre se ha esforzado mucho por mí, no puedo decepcionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "Si tienes tiempo libre, ¿me ayudarías a pensar cómo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Claro, tómate tu tiempo. Después de todo, estos maniquíes no irán a ningún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Tampoco mi vida va a ninguna parte mientras esté atrapada tratando de resolver esto. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "A esta distancia, tal vez la mejor solución sería hacerme cargo de un lado y lanzar una bomba al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Jaja, solo bromeo. De todos modos, no tengo idea de dónde conseguiría una bomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "#¿Qué tal si lo intentamos junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "¿Así que te gusta el combate en equipo? Es bueno tener siempre a alguien que te apoye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "Para personas como yo, lo mejor que pueden hacer es intentar subsistir como luchadores solitarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006602,
