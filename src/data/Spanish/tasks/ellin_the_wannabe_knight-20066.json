			"dialogs": [
				{
					"id": 200660301,
					"content": "¡Le has dado justo al clavo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660302,
					"content": "¿Eh? Nunca pensé en intentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660303,
					"content": "¡Gracias! Lo intentaré ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
