				},
				{
					"id": 728130902,
					"content": "*Suspira*, supongo que tendré que buscar otro lugar para hacer mis experimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Iwata"
