					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "Esta es la ayudante que Gorou encontró para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Hola, soy Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "El General Gorou me pidió que le ayudara con su investigación sobre fertilizantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Será un placer trabajar con usted de ahora en adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "¿En serio?... ¡Magnífico! Si tenemos éxito, ¡podremos plantar más cultivos en la Isla Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
