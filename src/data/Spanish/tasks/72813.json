				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#El significado del tótem... Oh, viajer{F#a}{M#o}, ¿me buscabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Sobre Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "¿Dices que Alrani está en la Isla Watatsumi? Qué extraño, ¿qué hace aquí? ¿No iba a ir a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Los soldados la detuvieron...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "¿Qué? Ay, con la situación en la que se encuentra la Isla Watatsumi, no me extraña que les haya parecido sospechosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Ya hablaremos de eso luego. Vamos, rápido. Esa mujer nunca piensa bien las cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
