					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "El flujo elemental y las líneas ley de Mondstadt deben haber regresado a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "¿Qué tal si regresamos a ver cómo están los <color=#00E1FFFF>Caballeros de Favonius</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Si quieres hacer otra cosa, no tengo problema en acompañarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Como ir de compras... O podemos volver a ver la <color=#00E1FFFF>Estatua de Los Siete</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "En los Templos de los Cuatro Vientos encontramos algo que parecía viento solidificado, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "En Mondstadt lo llaman “anemóculus”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Los anemóculus pueden colocarse en los ojos de la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Algunas leyendas dicen que una golondrina se llevó las gemas originales de sus ojos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "Pero en realidad los anemóculus nunca tuvieron una forma física.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Las personas con una Visión los recolectan para obtener la bendición de las <color=#00E1FFFF>Estatuas de Los Siete</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Parece ser que, aunque tú no tienes Visión, las reglas de este mundo no aplican para ti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Si quieres probarlo, ¡hagámoslo ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "La Estatua de Los Siete en Levantaviento debe ser la más cercana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "¡No puedo esperar a ver cómo reaccionarán los dioses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
