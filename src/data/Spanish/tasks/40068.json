			"dialogs": [
				{
					"id": 400681201,
					"content": "Oigan, encontré una nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681202,
					"content": "Oh, vaya... Esta isla sí que es realmente interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681203,
					"content": "A juzgar por el estilo y por la firma... ¡es de Albedo! Es uno de nuestros amigos de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681204,
					"content": "Es un alquimista increíble que también ha visitado esta isla antes. Dejó esta nota para futuros aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681205,
					"content": "¿Eh? Así que fue él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681206,
					"content": "¡¿Dice que toda la isla ha sido transformada en un instrumento musical?! Increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681207
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681207,
					"content": "Y estas corrientes de agua subterráneas desempeñan un papel importante... Oh, tal vez necesitamos desobstruir todas las corrientes para que la isla emita música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681208,
					"content": "¡Hay que limpiar un instrumento antes de tocarlo! Tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
