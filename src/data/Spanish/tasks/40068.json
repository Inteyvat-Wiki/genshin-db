			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "Se ve como una isla común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "Creo que hay un olor a quemado en el aire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Hum... Mi artilugio de adivinación se ve cada vez más nítido, pero aún no veo gran cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "¡Oigan! ¡Miren lo que encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "Es... ¿un tambor? ¿O una planta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "¿Un instrumento musical hecho de plantas? Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, ¿no crees que esta podría ser tu isla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Oh, ¿quieres decir que este instrumento está aquí para mí? Déjame intentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Espera, espera. Ayer, cuando toqué la rocalla del bonsái, nos transportamos a otro lugar. ¿No quieres tomarte un momento para prepararte primero, Xinyan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "Tienes razón, pero no pasa nada. ¡Siempre estoy lista para la música!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006804,
			"completionStepIds": [
				4006804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
