			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Corazón Llameante",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "¡Guau! ¡Es una flor gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "Qué calor hace aquí... ¿Tendrá algo que ver con la flor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Guau, genial, no estaba esperando invitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680904,
					"content": "¡¡Ahh!! ¡Habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "La ardilla de ayer también hablaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "¡Eso Paimon ya lo sabe! ¡P-pero esto es diferente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Hola. Tocamos esa planta con forma de tambor que había en la playa y fuimos transportados a este lugar. ¿Tú eres la dueña de este sitio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "Este es el palacio de la música. Yo solo soy su guardiana. Díganme, amigos, ¿ustedes también buscan la música en su máxima expresión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680910,
					"content": "Ohhh, ¡pues claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Bueno, en ese caso, díganme, ¿qué les gustaría expresar con la música?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680912,
					"content": "¡El espíritu de la rebeldía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "¡Bien dicho, buena respuesta! Me alegra escuchar eso. Qué suerte tengo de encontrar a otra música con los mismos ideales que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680914,
					"content": "Hasta las flores gigantes se llevan bien con Xinyan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "La gente simpática siempre hace amigos allá donde vaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "Si han llegado hasta aquí, debe de ser porque quieren adentrarse en el palacio de la música. Sin embargo, voy a tener que disculparme, para entrar es necesario que cante y en este momento mis cuerdas vocales están un poco mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680917,
					"content": "¿Te encuentras bien? ¿Necesitas... humm... medicina para el resfriado o algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "Es que hace mucho que no tomo agua de manantial glacial. Si pudiera beber un poco, recuperaría mi voz y podría mostrarles el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680919,
					"content": "¿Agua de manantial glacial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Sí. Con un sorbo de esa agua, cualquiera podría cantar la más hermosa de las canciones, ya sea un adulto cansado, un pájaro somnoliento o un niño inocente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "Está bien. Voy a buscarte un poco de esa agua. ¿Dónde se encuentra el manantial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "¡Gracias, eres la mejor! El agua de manantial hace que las plantas crezcan sanas y fuertes para escalar las montañas que se interpongan en su camino, así que... imagino que se encuentra en las montañas protegidas por plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680924,
					"content": "Entonces, ¿tenemos que hacer montañismo? Paimon pensaba que un poco de agua de mar sería suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "El agua de manantial y el agua de mar son completamente diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Puede que necesiten mis poderes para ver el manantial. Amiga, dame tu mano para que puedas ver a través de mis ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Corazón Llameante"
				},
				{
					"id": 400680927,
					"content": "¡Gracias! Ya nos dimos la mano, eso significa que ahora somos amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "El barco de ayer también hablaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
