				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680501,
					"content": "La puerta está cerrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680502,
					"content": "¡Mona, conviértete en agua y entra por abajo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "Haz el favor de dejar de decir tonterías, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680506,
					"content": "Xinyan, ¿por qué cerraste la puerta con llave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680507,
					"content": "Jaja, debería saberlo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680508,
					"content": "Normalmente dejo la llave debajo de la maceta que está junto a la puerta. Así que... debe de estar por aquí cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680509,
					"content": "¡Oh! ¿Hay alguna maceta por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680510,
					"content": "No hay ninguna maceta, pero ahí hay una... ¿flor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "Bueno, vale la pena intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680504,
					"content": "¡Kazuha, elévate y vuela por encima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "... Sigamos pensándolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006809,
			"completionStepIds": [
				4006809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
