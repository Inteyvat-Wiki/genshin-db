				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "*Cof, cof*... A Paimon le entró un montón de polvo en la boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680402,
					"content": "¿Todo bien, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680403,
					"content": "Tal y como sospechamos... Nos transportamos a otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680404,
					"content": "¿Por qué está tan desolado este lugar? ¿Estás segura de que esta es tu ilusión, Xinyan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680405,
					"content": "Supongo que sí, pero... Tienes razón, ¿por qué está tan desolado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680406,
					"content": "Miren, ahí hay algo muy brillante, como si quisiera llamar nuestra atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680407,
					"content": "Bien, vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680408,
					"content": "¡Esperen, esperen! Es muy evidente, ¡es una trampa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680409,
					"content": "Puede ser, pero no tenemos a dónde más ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680410,
					"content": "Eso es cierto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "Si realmente estamos dentro de la ilusión de Xinyan, no creo que encontremos ninguna trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680412,
					"content": "¡Exacto! Ese no es para nada mi estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680413,
					"content": "Humm, tiene sentido. Bueno, vamos, pero tengamos mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
