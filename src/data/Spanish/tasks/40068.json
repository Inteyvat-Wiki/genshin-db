			"dialogs": [
				{
					"id": 400681001,
					"content": "¡Guau! ¡Estamos fuera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "Humm, aquí hay más luz. Aunque tampoco me molestaba la calidez de esa cueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "El agua de manantial glacial brota de una de las montañas que se encuentran por aquí. Vamos juntos a buscarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Espera, ¿cómo puede haber luz bajo tierra? ¿Acaso es... una corriente de agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "Según lo que dijo la flor, esta corriente de agua podría estar relacionada con las plantas. Las plantas nos llevarán a donde se encuentra el manantial. Hay que seguir esta corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
