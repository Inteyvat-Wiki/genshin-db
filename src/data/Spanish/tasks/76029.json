			"dialogs": [
				{
					"id": 760290101,
					"content": "Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290102,
					"content": "Oh, ¿vas a salir, Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Sí, quiero ir a que me reparen una lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290104,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "La lira de una de las kuuhenki se rompió y, como es tan importante para ella, quiero ayudarle a que se la arreglen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290106,
					"content": "Cuántos talentos tienen las kuuhenki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Sí, suele tocar la lira aquí, así que a veces canto al son de su música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290108,
					"content": "Paimon lleva un tiempo pensando esto, pero mimas mucho a las kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Ellas siempre han estado a mi lado y me han traído muchas cosas con las que entretenerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290110,
					"content": "(Lauma dijo que eso se debía al instinto natural de las kuuhenki de querer hacer feliz a la Diosa Lunar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Una cosa, ¿cómo piensas reparar esa lira? ¿No decías que no querías que nadie te viera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Humm, antes, les pedía a los animales o a las kuuhenki que dejaran en la puerta de una artesana las cosas que necesitaban reparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290113,
					"content": "Al ver las cosas, la artesana las reparaba, pero a veces tardaba varios días en darse cuenta de que estaban ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290114,
					"content": "Qué método tan enrevesado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "#Deja que nos encarguemos nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290117,
					"content": "#No te preocupes. Si vamos nosotr{F#a}{M#o}s, tal vez podamos dejarla arreglada hoy mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "Entiendo, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290119,
					"content": "No hay de qué. Por cierto, ¿en la casa de qué artesana sueles dejar las cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "No sé cómo se llama. Su casa es como una caracola de mar redonda y en la puerta hay una mano mecánica muy grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290121,
					"content": "(¿Estará hablando de...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "Y de ella suele emanar un aroma a krumkake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290123,
					"content": "Paimon cree que sabe de quién hablas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
