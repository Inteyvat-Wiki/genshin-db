			"dialogs": [
				{
					"id": 760290201,
					"content": "¡Aino! ¿Estás en casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290202,
					"content": "¡Oh! ¡Parece que es Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290203,
					"content": "#¡Hola, chic{F#a}{M#o}s! ¿Vienen a hacerme una visita? ¿Han traído dulces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290204,
					"content": "Sabíamos que dirías eso. Toma, te hemos comprado esto en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290205,
					"content": "Rápido, rápido, dénmelo. Ineffa llegará pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290206,
					"content": "¿A qué quieren jugar hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290207,
					"content": "Jeje, bueno... En realidad, queríamos pedirte una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290208,
					"content": "¡Aaaaah! ¡Llévensela, llévensela! ¡Llévense esa cosa fuera de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290209,
					"content": "¿Eh? ¿Te refieres a esta lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290210,
					"content": "Ya les dije que detesto las cosas que no se pueden explicar ni con la ciencia ni con la mecánica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290211,
					"content": "Esa lira aparece de vez en cuando en la puerta de mi casa, pero cada vez que la arreglo, ¡desaparece misteriosamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290212,
					"content": "P-pero... eso no significa que crea en cosas sobrenaturales, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290213,
					"content": "Parece que ha habido un malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290214,
					"content": "¿Un malentendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290215,
					"content": "Esta es la lira de una amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Sí, no tiene malas intenciones, pero tiene sus razones para llevarse la lira a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290218,
					"content": "¿En serio? ¿No me estarán engañando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290219,
					"content": "E-está bien... Confiaré en ustedes y la arreglaré una vez más. Esta vez seré más meticulosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290220,
					"content": "Esperen un momento aquí, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290221,
					"content": "Aino es una persona en la que se puede confiar. A Paimon le da un poco de lástima que se asuste tanto cuando le dejan cosas en su puerta a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290222,
					"content": "Deberíamos pagárselo de algún modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290223,
					"content": "Paimon está de acu... ¡Aaaaah! Pero ¡¿qué haces aquí?! ¡Por Los Siete, qué susto nos has dado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290224,
					"content": "Quería darles unas cosas antes de volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290225,
					"content": "¿Eh? ¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290226,
					"content": "Son unos “tesoros” que recogió la kuuhenki para darle las gracias a la artesana. Pensó que podrían gustarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290227,
					"content": "Ooooh, qué cantidad de componentes tan extraños. De acuerdo, se los daremos a Aino luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290228,
					"content": "Ten cuidado al regresar, no vaya a ser que alguien te vea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290232,
					"content": "Mira quién viene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290236,
					"content": "Realizando comparación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290237,
					"content": "¡¿Qué tienes que comparar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290238,
					"content": "Grado de similitud con las Estatuas Lunares de Nod Krai: 95%...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290239,
					"content": "¡E-es una actriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#Se ha detectado una subida en las pulsaciones de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290243,
					"content": "¡Reparada! Ahora sí que no volverá a romperse. Por cierto, los du... ¡I-Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290244,
					"content": "¿Los “du”...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290245,
					"content": "¡Los du... ros componentes que me dieron funcionan a la perfección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290246,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290247,
					"content": "¿Quién es la persona que hay detrás de ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290249,
					"content": "¡Es la clienta de la lira!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Me suena de algo... Pero no sé dónde puedo haberla visto antes. En fin, no importa, será mejor que esconda rápido los dulces que me dio Paimon.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290252,
					"content": "¡S-sí! Te ha traído todos estos componentes para darte las gracias por arreglar su lira, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290253,
					"content": "Oh, a ver... ¡Guau! ¡Son componentes antiguos y raros! ¿De verdad puedo quedármelos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290254,
					"content": "... Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760290255,
					"content": "¡Gracias! Si alguna vez necesitas volver a reparar algo, ¡que no te dé vergüenza venir a verme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290257,
					"content": "#Eh... Bueno, pues nosotr{F#a}{M#o}s ya nos vamos. Aino, Ineffa, ¡nos vemos otro día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290258,
					"content": "(¡Tenemos que sacar a Colombina de aquí antes de que Ineffa la reconozca de verdad!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290259,
					"content": "¡C-claro! ¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290260,
					"content": "(¡Tengo que ir a limpiar antes de que Ineffa vea las migajas de los dulces!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290261,
					"content": "#Adiós a l{F#a}{M#o}s dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290262,
					"content": "Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290263,
					"content": "¿S-sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290264,
					"content": "¿Quieres dar estos componentes como ofrenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290265,
					"content": "¿Eh? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290266,
					"content": "Porque parecen ser “obsequios de la Diosa Lunar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290267,
					"content": "¿Eh? ¿Pero qué estás diciendo, Ineffa? A ver si se te ha caído un tornillo o algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290250,
					"content": "¡Es la clienta a la que le dan miedo los desconocidos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "¿Qu-qué hay del margen de error?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "El margen de error es mínimo. Conclusión: el análisis es fiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290216,
					"content": "La lira es de una amiga a la que le dan un poco de miedo los desconocidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
