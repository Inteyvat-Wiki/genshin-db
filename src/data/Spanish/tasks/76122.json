			"dialogs": [
				{
					"id": 761220101,
					"content": "¿Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "¿Eh? Qué extraño. Paimon juraría que escuchó la voz de Colombina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "¡Jia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220104,
					"content": "¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220106,
					"content": "¿Otro susto? ¡Eso no está bien! Si estabas aquí, ¡podrías haberlo dicho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "#Bueno, pensé que como ya están acostumbrad{F#a}{M#o}s a este juego, debería ponerles las cosas más difíciles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220108,
					"content": "¡Hum! ¡Ya verás el susto que te dará Paimon la próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "¡Genial! Estaré esperándolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220110,
					"content": "¿Qué le ha pasado a tu velo, Colombina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Oh, supongo que una kuuhenki se lo llevaría cuando estábamos jugando antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220112,
					"content": "No suelo usar mis ojos, así que no pasa nada. Si les gusta, deja que jueguen con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220113,
					"content": "Por cierto, ¿no te gustaría salir más a menudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Ya no tienes que esconderte de nadie, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Sí... Ahora tengo todo el tiempo del mundo. Puedo ir a donde quiera cuando quiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220116,
					"content": "Sin embargo, me preocupaba que se inquietaran si venían a buscarme y me había ido sin despedirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220117,
					"content": "En este tipo de situación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "¡Sí! Después de todo, solo necesitamos saber que estás bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Ya veo. Lo consideraré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220121,
					"content": "¿Solo lo “considerarás”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Tal vez le gusta estar aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Todo lo ocurrido aquí... Son recuerdos agradables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220124,
					"content": "#Dicho eso, también tengo otra razón para haberme quedado aquí esperándol{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220125,
					"content": "¿Y cuál es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Para darles una bonita sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220118,
					"content": "Puedes dejar una nota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
