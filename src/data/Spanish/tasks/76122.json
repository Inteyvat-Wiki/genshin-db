				},
				{
					"id": 761220404,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220405,
					"content": "#Si te gusta, podría traerl{F#a}{M#o}s de nuevo más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220406,
					"content": "Entonces, ¿esta era la sorpresa que querías darnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "¿Esto es suficiente para considerarlo una sorpresa? No, aún no han visto la verdadera sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220408,
					"content": "¿Hay más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Vamos a pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220410,
					"content": "Un momento... ¿Aquí? Pero si Paimon no ve ningún lienzo, ni pinceles o pintura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Eso es sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761220412,
					"content": "La superficie del agua será nuestro lienzo, la luz de la luna, nuestro pincel, y los caminos que atravesemos formarán la silueta de la obra.",
