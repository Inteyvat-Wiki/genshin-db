					"id": 750876101,
					"content": "#¡Bienvenid{F#a}{M#o}s a la Academia de Vuelo Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876102,
						750876103
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876102,
					"content": "¿Qué haces por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876104
					]
				},
				{
					"id": 750876104,
					"content": "Todos los estudiantes cuentan con la ayuda que necesiten. Las cosas han cambiado bastante... En el pasado, los nuevos no podían esperar tantos cuidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876105
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876105,
					"content": "Pero una vez hubo un entrenador que era demasiado... exigente. El estudiante en cuestión tenía muy mal carácter... *Suspira*, no es muy agradable hablar de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876106
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876106,
					"content": "Sea como sea, nuestra política de enseñanza ha cambiado mucho desde entonces. Y, bueno, nadie le hace ascos a una sonrisa o a un halago, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876103,
					"content": "Tengo que irme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876107
					]
				},
				{
					"id": 750876107,
					"content": "¡Que tengan un buen día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		},
