			"dialogs": [
				{
					"id": 750140801,
					"content": "(Humm... Desde aquí no se ve gran cosa, pero si nos acercamos más, podrían descubrirnos. Será mejor mantener las distancias e intentar escuchar qué están diciendo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "El último cargamento fue de gran calidad, así que no me decepcionen tampoco esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "Sin problema. ¿Igual que siempre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Parán"
				},
				{
					"id": 750140804,
					"content": "Sí, entréguenlo antes de la competición de vuelo, habrá quien lo necesite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Por supuesto. Supongo que ellos también habrán terminado de acordar todo. ¿Nos retiramos, pues?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Parán"
				},
				{
					"id": 750140806,
					"content": "(¿Eh? ¿Se van ya? Parece que la situación no es la que Paimon se imaginaba... De todas formas, regresemos ya, pero con cuidado de que no nos descubran.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
