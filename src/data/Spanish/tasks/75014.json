			"dialogs": [
				{
					"id": 750141320,
					"content": "¡Paimon está sudando del susto! ¡Menos mal que Paimon se escondió! De no ser así, no se habría interesado por los dos saurios, ¡si no por Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141321
