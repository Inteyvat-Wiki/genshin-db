			"dialogs": [
				{
					"id": 750141201,
					"content": "¿Eh? Pequeñín, ¿te has perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141202,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "Qué enérgico, pareces muy saludable. Y tienes marcas muy especiales en los cuernos... Genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141204,
					"content": "Pero ¿qué hacen los dos juntos aquí? ¿Acaso no los eduqué bien? No, eso es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141205,
					"content": "¿Mmm?... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "¿Eh? ¿Qué pasa con él? ¿Él te trajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141207,
					"content": "(No puedes dejar que te descubra...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "¡Vaya rugido más raro! ¿Acaso estás enfermo? La verdad es que también actúas raro, parece que tengo que hacerte un chequeo completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141211,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "No te preocupes, pequeñín, ahora te tocará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141221,
					"content": "Tú primero, ven conmigo. ¿Puedes entender las instrucciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141213,
					"content": "Asentir",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "¿Dónde has aprendido eso? Espera, ¿entiendes lo que te digo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141219,
					"content": "#En ese momento, se escucha un alboroto fuera...\\n“¿Quién ha abierto la caja?... ¡Oigan, no se peleen! ¡Cálmense! ¡Que Killa se va a enfadar!”.\\nNo tienes tiempo de comprobar qué pasa, así que aprovechas el caos para abandonar el campamento con {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "Negar con la cabeza",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "¿Dónde has aprendido eso? Espera, ¿entiendes lo que te digo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141217,
					"content": "Seguirla",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "Qué raro, si aún no dije las palabras mágicas, ¿acaso entiendes lo que digo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750141209,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				}
			]
		},
