			"dialogs": [
				{
					"id": 750141601,
					"content": "Qué molesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141602,
						750141605
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141602,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141603
					]
				},
				{
					"id": 750141603,
					"content": "La cosa es que tengo un hermano pequeño al que le saco muchos años, y está en una edad rebelde y no se lleva bien con nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141604
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141604,
					"content": "Ay, contarte esto tampoco soluciona nada. ¡Solo espero que se le pase con los años!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141605,
					"content": "No te molesto más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141606
					]
				},
				{
					"id": 750141606,
					"content": "No pasa nada, adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
