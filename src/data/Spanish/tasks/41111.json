			},
			"dialogs": [
				{
					"id": 411111801,
					"content": "Este parece ser el último de los fragmentos. ¿Crees que deshacerse de ellos mejorará las cosas para los habitantes de Aguaclara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111802,
					"content": "La pregunta es: ¿estos fragmentos de meteoritos con energía elemental son la verdadera fuente del problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111803
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111803,
					"content": "Como soberana, ¡tengo la certeza de que estos meteoritos son la fuente de las pesadillas que aquejan a mis súbditos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111804
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111804,
					"content": "Preguntémosle a los demás aldeanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111805
					]
				},
				{
					"id": 411111805,
					"content": "¡De acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
