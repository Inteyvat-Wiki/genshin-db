	"talks": [
		{
			"id": 4111101,
			"completionStepIds": [
				4111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111101",
							"2"
						],
						"stepId": 4111101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "#¡Viajer{F#a}{M#o}! No podrías haber llegado en un mejor momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110102,
					"content": "¿Por qué lo dices? ¿Ocurrió algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110103,
					"content": "Eso me temo. Es demasiado grave... Necesitamos la ayuda de todos y cada uno de nuestros aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110104,
					"content": "#Tengo un encargo realmente urgente para ti, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110105,
					"content": "¡Guau! Suena muy serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110106,
					"content": "A decir verdad, nunca antes nos habíamos topado con algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110107,
					"content": "Estamos muy ocupados en el Gremio de Aventureros. Confiamos en que nuestros miembros se unan y nos apoyen en las labores de rescate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110108,
					"content": "Es mi deber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "Un momento, la seguridad es lo primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110111,
					"content": "¡Katheryne! Vasalla del Reino de la Noche Eterna, ¿me engañan mis oídos, o acaso gritaste mi sagrado nombre con fervorosa súplica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110112,
					"content": "Ah, viniste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110113,
					"content": "Es un placer volver a verla, señorita Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110114,
					"content": "¡Ah! ¡¿Ese cuervo acaba de hablar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110115,
					"content": "Jaja, un placer conocerte, amiga mía. Aunque estoy seguro de que habrás visto cosas más extrañas antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110116,
					"content": "Mis leales súbditos, veo que sus rostros están llenos de miedo y temor ante los viles males que una vez más buscan en vano perturbar la paz y la tranquilidad de nuestra amada Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110117,
					"content": "#Viajer{F#a}{M#o}, permítame presentarle a la Srta. Fischl, miembro experimentada del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110118,
					"content": "#Fischl, Oz, est{F#a}{M#e} es {F#la}{M#el} viajer{F#a}{M#o} {F#de la}{M#del} que les hablé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110119,
					"content": "#¿Oh? ¿Eres {F#la viajera}{M#el viajero}? Humm... Me gusta tu mirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110120,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o} de Favonius, y Paimon, su compañera de viaje, es un honor para nosotros conocerles. Hemos escuchado mucho sobre ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110121,
					"content": "#Viajer{F#a}{M#o}, ¿tú también pretendes enfrentarte a los oscuros cristales crípticos de la destrucción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110122,
					"content": "¿Eh? Cristales críticos de... oscuridad y... ¿qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110123,
					"content": "Katheryne, eso no fue lo que dijiste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "Creo que la señorita se refiere a <color=#00E1FFFF>los meteoritos</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110126,
					"content": "Hasta ahora, el Gremio de Aventureros no ha podido determinar la causa de la lluvia de meteoritos o sus efectos secundarios. Así que, por su seguridad, les rogamos que viajen en parejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110127,
					"content": "#Viajer{F#a}{M#o}, Fischl, cuídense mutuamente en su viaje y tengan extrema precaución en todo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110128,
					"content": "Humm. De acuerdo, siempre has sido una vasalla devota, Katheryne, solo por eso aceptaré tu sincera súplica por mi ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110129,
					"content": "¡Regocíjense, pues unirse a la Princesa del Juicio en su noble misión es sin duda motivo de júbilo eterno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110130,
					"content": "La señorita es mi ama, la princesa Fischl. Proviene de otro mundo conocido como el Reino de la Noche Eterna. Yo soy el humilde espíritu familiar de la señorita, el cuervo Oz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110131,
					"content": "¡Guau, impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110132,
					"content": "#Mi nombre es Paimon, y {NICKNAME} es {F#una viajera}{M#un viajero}. ¡Esperamos con ansias trabajar con ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110133,
					"content": "¿Dijiste ... “de otro mundo”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "Con el tiempo lo entenderá... Cuanto más tiempo pase con la señorita Fischl, más claro se volverá todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110136,
					"content": "#Pobre ingenu{F#a}{M#o} que no conoce la gloria del Reino de la Noche Eterna... Aunque supongo que no podía esperar más de {F#una viajera}{M#un viajero} de baja estirpe... No es la blasfemia, sino la ignorancia la causa de tu transgresión. Por ello, te ofrezco mi perdón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110137,
					"content": "¿Perdón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110138,
					"content": "Lo que la señorita quiso decir es: “Hola”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110139,
					"content": "Estos dos son la pareja más excéntrica que Paimon haya visto... La chica habla muy raro de por sí, pero cada vez que su pájaro mascota habla, se vuelve aún más raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110140,
					"content": "Estoy seguro de que deben tener muchas dudas. Podremos hablar mientras caminamos... o volamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110141,
					"content": "Oh, por cierto... ¿Qué es todo eso de viajar en parejas? ¡Nuestro grupo es de cuatro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110134,
					"content": "¿“Reino de la Noche Eterna”? Nunca había oído hablar de ese lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "¡Gracias por la información! Lo haré de inmediato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "Ya estamos en Aguaclara. Katheryne dijo que este es el sitio del impacto más cercano a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110502,
					"content": "Las cosas están peor de lo que imaginamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110503,
					"content": "Hay mucha gente inconsciente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "¡Que tañan las campanas y resuenen los clarines! ¡El día del juicio se cierne sobre nosotros! ¡Regocíjense todos los que suplican por la salvación, pues la Princesa del Juicio ha llegado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110505,
					"content": "La princesa parece muy entusiasmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111106,
			"completionStepIds": [
				4111106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111106",
							"2"
						],
						"stepId": 4111106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joyce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110601,
					"content": "Queridos mortales, su princesa les permite saltarse la etiqueta para enunciar sin rodeos el asunto en cuestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110602,
					"content": "... ¿Disculpa? ¿Tú quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110603,
					"content": "Venimos en paz, buen señor. Solo esperamos que pueda contarnos todo lo que sepa sobre la situación de esta pobre víctima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110604,
					"content": "¡Espera, espera! Deja que Paimon te explique... Somos del Gremio de Aventureros. Nos encargaron venir a investigar la lluvia de meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110605,
					"content": "Oh, ya veo. Bueno, anoche esta persona tocó el meteorito y perdió el conocimiento al instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110606,
					"content": "Así que no toquen ningún meteorito bajo ninguna circunstancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "Joyce"
				},
				{
					"id": 411110607,
					"content": "¿Qué ridícula reprimenda es esta? Yo estoy bajo la protección divina de la gema de las tinieblas, ¿cómo puede un insignificante cristal negro presentar una amenaza para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110608,
					"content": "Al contrario, señorita, una princesa sabia es aquella que escucha el consejo de sus súbditos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110609,
					"content": "Ya veo... Muy bien, entonces, procederé según tus consejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110610,
					"content": "#¡Eso también se aplica a ti, {NICKNAME}! ¡Un buen aventurero es aquel que escucha los consejos de la gente inteligente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110611,
					"content": "Entendido, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "Jeje, Paimon nunca habla así, ¡pero podría acostumbrarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110613,
					"content": "¿Osas imitar el lenguaje de la princesa? ¡Hum! No imaginé que la sagacidad de una simple mortal fuera suficiente para comprender el lamento de miles de mundos moribundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110614,
					"content": "Quizás sea mejor que permanezcas en tu feliz ignorancia, porque la carga del destino que soporta la Princesa del Juicio sería demasiado para tus hombros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110615,
					"content": "Por favor, guíanos, oh, Princesa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4111114,
			"completionStepIds": [
				4111114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111114",
							"2"
						],
						"stepId": 4111114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111401,
					"content": "¡Edna! Nos deshicimos del meteorito en la colina detrás del pueblo. ¿Cómo están las víctimas ahora? ¿Mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111402,
					"content": "#¡Que los Arcontes l{F#as}{M#os} bendigan! Gracias a sus esfuerzos, dos de las víctimas ya despertaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111403
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111403,
					"content": "Tengo tanto sueño... *Bosteza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111404
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111404,
					"content": "Genial, ¡funcionó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111405,
					"content": "Si pudieras deshacerte del resto de los <color=#00E1FFFF>meteoritos</color> de la aldea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111406
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111406,
					"content": "Entonces, ¡todos los demás se despertarán también!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "Esta es una noticia maravillosa, me alegra de corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111408,
					"content": "Es muy alentador. Sin embargo, la noticia de que yo me iba a ocupar personalmente de este asunto seguramente fue la única garantía que mis fieles súbditos necesitaban para un resultado satisfactorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111409,
					"content": "Oye, acabas de despertar, ¿cierto? ¿Con qué soñabas mientras dormías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111410,
					"content": "Todo lo que recuerdo es que hacía frío... Estaba caminando por un sendero en <color=#00E1FFFF>la montaña</color>... Creo que estaba en medio de la nieve y el hielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111411,
					"content": "Entonces... ¿Simplemente estabas de paseo por las montañas? ¿O tenías algún destino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111412,
					"content": "Pues no lo sé... En mi sueño, sentía como... como si no controlara mis propias acciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111413
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111413,
					"content": "Entonces, ¡seguramente fuiste maldecido! Oh, miserable flagelo de esta tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111414
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111414,
					"content": "(¿Una maldición? ¿Es posible?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "Bueno, sea como sea, lo que sabemos es que deshacerse de los fragmentos de meteorito está ayudando. Entonces, vamos, ¡tenemos que redoblar nuestros esfuerzos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111115,
			"completionStepIds": [
				4111115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111115",
							"2"
						],
						"stepId": 4111115,
						"stateName": "QUEST_STATE_UNFINISHED"
