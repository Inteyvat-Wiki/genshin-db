				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adler"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111501,
					"content": "¡Mira, otra víctima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111502,
					"content": "Dígame, oh, noble caballero, ¿qué tragedia le sucedió a este desafortunado plebeyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111503
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111503,
					"content": "Em... Pues... ha estado durmiendo todo el día y no hay señales de que se vaya a despertar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111504,
						411111506
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111504,
					"content": "¿Tocó el meteorito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111505
					]
				},
				{
					"id": 411111505,
					"content": "Sí, lo tocó, y ahora está profundamente dormido. De vez en cuando también habla en sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111508,
					"content": "No puedo más... Necesito descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111509
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111509,
					"content": "¿Qué estará haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111510,
					"content": "Su oscuro sueño es como una fruta prohibida en las fauces de una feroz bestia... ¡Ay de los débiles de corazón que miren a sus ojos, tan oscuros como una noche sin luna, pues serán atraídos hacia el abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111511
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111511,
					"content": "¿Quieres decir... que hay algo que lo atrae en su sueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111512,
					"content": "Aunque no tenemos pruebas para demostrarlo, la intuición de la señorita nunca ha fallado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111513
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111513,
					"content": "Humm... Bueno, ¡sigamos investigando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111506,
					"content": "¿Existen otros síntomas además del sueño profundo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111507
					]
				},
				{
					"id": 411111507,
					"content": "No que yo haya visto, aunque de vez en cuando habla en sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				}
			]
		},
		{
			"id": 4111116,
			"completionStepIds": [
				4111116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111116",
							"2"
						],
						"stepId": 4111116,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111601,
					"content": "Saludos, soy la hermana Edna. Vine a cuidar a los enfermos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111602
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111602,
					"content": "¡Pronuncia tu nombre de inmediato, despreciable bellaco de las pesadillas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111603
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111603,
					"content": "Mis disculpas, la señorita no se dirigía a usted... ¿Ha dicho algo el caballero que yace en el suelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111604,
					"content": "Creo que dijo algo sobre tener que volver al trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111605
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111605,
					"content": "Vino... vino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111606
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111606,
					"content": "¿Será que trabaja en el negocio del vino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111607
					]
				},
				{
					"id": 411111607,
					"content": "Parece estar en un letargo profundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111608
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111608,
					"content": "Este no es un sueño ordinario... Este hombre... ¡ha sido maldecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111609
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111609,
					"content": "¿No puedes simplemente despertarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111610,
					"content": "Lo he intentado. Se despertó una vez por un breve momento, pero enseguida se volvió a dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111611,
					"content": "¿Te dijo algo mientras estaba despierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111612,
					"content": "Dijo que había soñado que estaba en la cima de una montaña y que allí hacía mucho frío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111613,
					"content": "Montaña, frío... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111614,
					"content": "Todo indica a la cruel y fría maldición de un demonio de la montaña... ¡Ay! ¡Temo que los demonios hayan descendido de las gélidas montañas y codicien los dominios del hada del manantial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111615,
					"content": "Estamos en una grave situación. Pero no teman, ¡pues la Princesa está aquí para absolverlos de la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111616,
					"content": "Lamento interrumpirlos, ¿tienen un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111617,
					"content": "¡Hola, Draff! ¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111618,
					"content": "Pues... yo... no sé cómo decirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111619,
					"content": "Uno de los <color=#00E1FFFF>meteoritos</color> impactó en la <color=#00E1FFFF>colina de detrás de la aldea</color>. <color=#00E1FFFF>Allan</color> dijo que iba a verlo personalmente... Y luego salió corriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111620,
					"content": "Ya han visto lo peligrosos que pueden ser esos meteoritos. Temo que le haya pasado algo... ¿Podrían venir conmigo a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111621,
					"content": "Espera... Unas rocas gigantes y en llamas caen del cielo, ¿y lo único que le preocupa a Allan es ir a ver qué son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111622,
					"content": "¡Exactamente! Cuando lo traigamos sano y salvo, ¡lo regañaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111623,
					"content": "¡Paimon no podría estar más de acuerdo! ¡Traigámoslo de vuelta de las orejas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111117,
			"completionStepIds": [
				4111117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111117",
							"2"
						],
						"stepId": 4111117,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "¡Uf! Pensé que iba a morir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111702,
					"content": "¡Tonto! ¡¿En qué estabas pensando para deambular tú solo en un momento como este?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111703,
					"content": "¡Lo... lo siento! ¡No lo volveré a hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111704,
					"content": "Perdón por los problemas que les ha causado Allan. ¡Me aseguraré de que aprenda su lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111705,
					"content": "Sí, la próxima vez que hagas una tontería, ¡piénsalo dos veces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111706,
					"content": "El meteorito está justo ahí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Paimon irá a mirar más de cerca... ¿Eh? Princesa, ¡tu <color=#00E1FFFF>Visión</color> está <color=#00E1FFFF>emitiendo destellos</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111708,
					"content": "¿Eh? ¿Acaso mi gema de las tinieblas está presagiando la desaparición de este malvado embrujo gélido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111709,
					"content": "Puede ser... ¿A qué tipo de cosas reacciona tu Visión exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111710,
					"content": "Al más profundo de los enigmas... A los secretos susurrados por las estrellas... A los huesos profanados de los demonios... A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111711,
					"content": "¡¿De qué hablas?! ¿Por qué no puedes hablar como la gente normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111712,
					"content": "Mis disculpas, la señorita no conoce bien el lenguaje de los plebeyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111713,
					"content": "Oh, ¿así que esa es tu función? ¿Eres su traductor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111714,
					"content": "Me temo que me malinterpretan. No soy traductor, sino un humilde transmisor de la voluntad imperial de la señorita. Me atrevería a decir que su <color=#00E1FFFF>Visión</color> está reaccionando a, como lo dirían los plebeyos, la <color=#00E1FFFF>energía elemental</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111715,
					"content": "*Ejem*, gracias, Oz. Aquellos cuyas mentes están confundidas por los asuntos terrenales de este decadente mundo son incapaces de comprender mi noble intención con tanta prontitud como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111716,
					"content": "Entonces, ¿hay energía elemental en el meteorito? ¿Y tu Visión parpadea ante ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111717,
					"content": "¿Puedes rastrear la energía elemental hasta su origen con tu Visión?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "Paimon cree que... tal vez sí. De todos modos, ¡no perdemos nada por intentarlo! Busquemos <color=#00E1FFFF>fragmentos de meteorito</color> usando la <color=#00E1FFFF>Visión</color> de Fischl. Si nos deshacemos de ellos, la zona será menos peligrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111718,
					"content": "¿La fuente de energía no reaccionará de la misma forma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
		{
			"id": 4111118,
