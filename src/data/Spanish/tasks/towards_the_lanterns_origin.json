			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "¡Al fin llegamos a <color=#00E1FFFF>Liyue</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "#¡{F#Señorita}{M#Joven}! Una pregunta, ¿cuánto por esa cosa que flota junto a usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "¡No está a la venta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "¡Paimon no está a la venta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Jajaja... En realidad estoy teniendo dificultades financieras en este momento. Así que, no importa cuánto sea, probablemente no podría pagarlo de todos modos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Solo soy un comerciante común y corriente. En mi mercancía no encontrarás nada extraordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "... ¿Sabes? Mientras más hablas, más sospechoso te oyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "¡Vaya! Alguien no está de humor. ¿Tal vez un caramelo te alegre el día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, ¡creo que esta persona es de confianza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Por cierto, si vinieron a Liyue, seguramente es para ver el Rito de la Linterna, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Esperamos un espectáculo magnífico con la linterna mingxiao de este año. La plaustrita que usamos para la linterna gigante es la más grande en veinte años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "Es tan grande que la gente está empezando a decir que si la legendaria ciudad en las nubes en realidad existe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "... ¡debe tener debajo de ella un pedazo de plaustrita de ese tamaño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "¡Suena increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "#¡Jaja! Nos veremos luego, si así lo quiere el destino. ¡Bienvenid{F#as}{M#os} a Liyue! Bueno, no puedo hablar en nombre de toda la <color=#00E1FFFF>ciudad de Liyue</color>, pero siempre serán {M#bienvenidos}{F#bienvenidas} en mi pequeña tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Créame, no se lo podría permitir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "¡Oye! ¡Eso suena un poco extraño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Pero tengo curiosidad, ¿cuánto pedirías por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Olvídalo, no importa cuánto ofrezcas, Paimon vale más que lo que el Mora puede comprar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}, ¡mira! ¡Una piedra flotante en el cielo! ¡Incluso puede tirar de las cadenas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Si no estuviera atada con cuerdas, Paimon no se imagina a dónde iría a parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "Estas plaustritas se usan para hacer la linterna mingxiao. El Mercado Celeste tiene incrustaciones de estas piedras a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Disculpa, ¿quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Me llamo Jiangzhou. Estoy a cargo de recabar información sobre el progreso de fabricación de la linterna mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "Por lo que veo, es la primera vez que vienen a Liyue a ver el Rito de la Linterna, ¿o me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "¿Cómo lo supiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "No recuerdo haber visto el año pasado a ningún viajero con una mascota extraña a su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Responderé con gusto cualquier pregunta sobre el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "¿Qué es una linterna mingxiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Durante el Rito, la gente libera pequeñas linternas llamadas “linternas celestes”. Pero todo Liyue participa en la creación de una linterna gigante, la linterna mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Una vez al año, cada negocio de Liyue abre un puesto en el Mercado Celeste. Es la única época del año en la que no buscan hacer dinero. El mercado existe con el único propósito de reunir fondos y materiales para la construcción de la linterna mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Si lo desean, pueden ayudarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "¿Y qué ganamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "Sus esfuerzos para construir la linterna mingxiao serán recordados para la posteridad. En la primera luna llena del año, nos despedimos de las cosas viejas para darle la bienvenida a las nuevas. Entonces, sus deseos serán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "¿No hay alguna ganancia material?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "#¡Pero qué pragmátic{F#a}{M#o}! Uno puede apuntar a las estrellas aun con los pies en la tierra. No se puede vivir sin sueños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "En otras palabras, si ayudan a construir la linterna mingxiao, tendrán una recompensa en el <color=#00E1FFFF>Mercado Celeste</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "En otras palabras, ¿si ayudamos podremos comer cosas deliciosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, ¡hay que ayudar! Vamos a preguntar a la gente en el <color=#00E1FFFF>Mercado Celeste</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "La linterna mingxiao de este año está dedicada a Guía de los Cielos. Ese presumido... ¡Seguro que estará encantado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010602,
					"content": "Quisiera saber más sobre Guía de los Cielos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Este año, la linterna mingxiao del Rito de la Linterna tiene la forma de Guía de los Cielos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010604,
					"content": "Espero que hagan más grandes las astas. Después de todo, eran el orgullo de ese Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010605,
					"content": "Se dice que sus cuernos absorbieron la esencia de Rex Lapis. En el pasado, era el objeto más resistente de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010606,
					"content": "Pero la batalla final estalló y una montaña estuvo a punto de derrumbarse sobre una aldea. Para evitar daños, el Adeptus le pidió a un amigo que cortara sus astas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010607,
					"content": "Usó sus cuernos ensangrentados como punto de apoyo para sostener la montaña entera, y siguió luchando hasta derramar su última gota de sangre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010608,
					"content": "Hoy, gracias a él, la Cordillera Tianheng se alza orgullosamente, y la sangre que perdió durante esa batalla mortal se ha convertido en el Río Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010609,
					"content": "¡Jaja! Puedes creer o no esta vieja historia, pero para mí es reconfortante que alguien quiera escucharla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010610,
					"content": "Ciertamente, el Rito de la Linterna existe porque, a lo largo de la historia, la gente optó por crear lazos de amistad en lugar de permanecer en soledad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010611,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Adiós. Que la llama del conocimiento y la virtud brille eternamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
