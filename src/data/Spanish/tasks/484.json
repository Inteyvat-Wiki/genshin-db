			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Oye, mira dónde estamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "No hay más marcas elementales por delante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "El poder elemental sobre el artefacto debe haberse agotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Ave Rapaz debió haberse dado cuenta de que las marcas revelarían su posición y envió a sus secuaces a frenarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Probablemente para esperar hasta que el efecto desapareciera y poder escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "¡No se saldrá con la suya! ¡Vamos por él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
