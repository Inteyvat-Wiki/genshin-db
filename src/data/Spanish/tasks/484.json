			"dialogs": [
				{
					"id": 4840601,
					"content": "Humm... Un pedazo de tela con marcas de Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "A juzgar por el diseño y la forma en que está tejido, es muy posible que provenga de un planeador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Guau, ¿los caballeros exploradores también tienen que ser expertos en tejidos? Es un trabajo más difícil de lo que pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Si esto realmente pertenece a Ave Rapaz, quiere decir que su planeador está roto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "Las marcas elementales señalan a esta dirección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "¿Crees que salió corriendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "¡Solamente hay una forma de averiguarlo!",
