			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "¡Gracias a Los Siete! ¡Los Caballeros de Favonius han llegado! Los Hilichurls ya no se atreverán a perseguirme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "¿Qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "No puedo creerlo, pero... los Hilichurls atacaron nuestra caravana de carruajes. Por suerte, pudimos escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "¿Hilichurls? Pero pensé que los Caballeros de Favonius habíamos arrasado con la mayoría de los campamentos de Hilichurl alrededor de estas partes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "Es un pequeño campamento no muy lejos del pueblo. Tomo una ruta de entrega alterna para asegurarme de mantenerme alejado de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Pero hoy... lo juro por Los Siete, ¡un idiota cayó repentinamente del cielo y aterrizó justo en el campamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Humm... Me suena familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Realmente los enfureció. Persiguieron al tipo de aspecto extraño mientras huía, lo que los sacó al descampado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Me las arreglé para escapar, pero destrozaron mis carruajes de frutas. No sé qué voy a hacer cuando la caravana llegue mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "¿Aspecto extraño? ¿De qué manera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Estaba sosteniendo algo. Debe haber sido pesado, porque no podía volar en línea recta ni para salvar su vida... Por eso debe haber caído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Honestamente, no debería permitirse que personas como esas anden por los aires. ¡No hace falta ser un genio para saber que no debes llevar objetos pesados mientras vuelas! ¡Le haré saber a ese cretino y me aseguraré de que le revoquen su licencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Un objeto pesado... ¿Será el artefacto? Podría ser nuestro sujeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "¿Viste en qué dirección se fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Logré echar un vistazo cuando huí de los Hilichurls. Creo que se fue... por ese lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Parece ser una buena pista. ¡{NICKNAME}, ¡vamos por él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "¡Ah! Y no te preocupes, tan pronto como regrese, les diré a los Caballeros que se hagan cargo del resto de los Hilichurls lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
