				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "#Sin más preámbulos, ¡le doy oficialmente la bienvenida al Gremio a {F#nuestra nueva y ávida aventurera}{M#nuestro nuevo y ávido aventurero}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Aquí está su <color=#00E1FFFF>Manual del aventurero</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "¡¿Hay un manual para eso?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "¡Un nuevo miembro a bordo es una ocasión importante! Una pequeña ceremonia es lo más justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Lleva el registro de encargos y recompensas disponibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Y también es una prueba de membresía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Ah, y una cosa más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "#A veces, te encontrarás atrapad{F#a}{M#o} en cierto Rango de Aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "Si esto ocurre, necesitarás llevar a cabo una hazaña impresionante para ganar el reconocimiento del Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "¿Una hazaña... impresionante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Solo son misiones específicas que te permiten avanzar al siguiente Rango de Aventura al finalizar. Misiones de Ascensión, por así decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Pero eso vendrá después. Muchas oportunidades para ganar reconocimiento vendrán a medida que ganes más Experiencia de Aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Eso es todo por hoy. Tendremos muchas oportunidades de encontrarnos nuevamente en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "#¡Ad astra abyssosque, aventurer{F#a}{M#o}! ¡Con esfuerzo, alcanzarás las estrellas y conquistarás el abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Esto se parece más a un folleto publicitario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Lo es, en cierto sentido. Pero también tiene algunos usos prácticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}