							"2070001",
							"2"
						],
						"stepId": 2070001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "¡Qué mala suerte! Esos Caballeros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "¡Hum! Los Caballeros de Favonius son unos ineptos. Me dijeron que no podía pasar porque había monstruos más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Pero aún no he recibido ninguna noticia de ellos al respecto. ¡Uno no puede fiarse de ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Además, tengo muchas cosas que hacer. ¿Tienen idea de todo el dinero que me están haciendo perder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "#Humm... Tú pareces ser {F#una aventurera}{M#un aventurero}. ¿Qué te parece si te pago por ayudarme con unas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "De acuerdo. Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Fantástico. Me gusta la gente directa como tú. Cuando acabes, te recompensaré como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Quizás esté equivocado, pero cada vez veo más Hilichurls por Mondstadt. ¡Hum! No entiendo qué hacen todo el día esos Caballeros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "#Ya que accediste a ayudarme, ¿podrías despejar la zona de Hilichurls? Aunque estarás tú sol{F#a}{M#o}... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Bah, no importa. Tú decides qué lugar despejar: la cima, la ladera o el pie de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Sea cual sea el lugar, la misión es despejarlo de Hilichurls. Vamos, elige rápido. No me hagas perder el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "¿De cuántos Moras estamos hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "#¡Ja! Eso depende de lo bien que lo hagas. Pero si lo haces bien, ten por seguro que serás recompensad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070002,
