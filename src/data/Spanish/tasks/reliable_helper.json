						207003302
					]
				},
				{
					"id": 207003302,
					"content": "¡¿Acaso no me entiendes cuando hablo, o es que ni siquiera te molestaste en hacerlo bien?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003303,
					"content": "Te dije que no rompieras las cajas. ¿Cómo es que hay tantas rotas? No creo que pueda venderlo ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003304,
					"content": "No vi ningún cargamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003305
					]
				},
				{
					"id": 207003305,
					"content": "¡Eran esas cajas! ¿O es que crees que me gusta ir dejando mi mercancía por ahí tirada?",
