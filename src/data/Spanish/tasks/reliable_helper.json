			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "Ya hice lo que me pediste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "#Vaya, tan lent{F#a}{M#o} como los Caballeros de Favonius. Te dije que lo hicieras en un minuto. ¿Te olvidaste o es que ni siquiera me escuchaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "¡Hum! No prestas atención ni a un detalle tan simple como ese... Toma 1000 Moras. Haz lo que quieras con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "¡¿Solo 1000 Moras?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "¿Cuánto esperabas recibir por hacer el trabajo así? Es la cantidad que te mereces. ¡Tómalo o déjalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
