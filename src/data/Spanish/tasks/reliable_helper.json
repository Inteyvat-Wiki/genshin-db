					"nextDialogs": [
						207003306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003306,
					"content": "Olvídalo. No tengo nada más que hablar con alguien tan descuidado como tú. Toma, 1000 Moras. ¡Vamos! ¡Fuera de mi vista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003307,
					"content": "¿Solo 1000? ¡Es poquísimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003308,
					"content": "¿Te parece poco? ¿No haces bien tu trabajo y esperas que te dé más? ¡Es la cantidad que te mereces! ¡O la tomas o la dejas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
