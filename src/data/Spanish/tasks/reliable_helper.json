					"nextDialogs": [
						207003202
					]
				},
				{
					"id": 207003202,
					"content": "#No está nada mal. Eres buen{F#a}{M#o} en lo que haces. No se rompió ni una caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003203,
					"content": "Toma, 5000 Moras. Volvamos a hacer negocios si se presenta la oportunidad.",
