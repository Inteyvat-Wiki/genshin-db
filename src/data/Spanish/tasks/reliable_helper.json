			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Ya hice lo que me pediste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "#¿Tan rápido? Pero si no ha pasado ni un minuto, ¿no? Eres buen{F#a}{M#o}. Eres muy buen{F#a}{M#o}, ¡jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "No está nada mal. Toma, 5000 Moras. ¡No falta ni uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "#¿Dices que somos muy buen{F#as}{M#os} y solo me das 5000?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "#No sean quisquillos{F#as}{M#os}. He calculado la remuneración con mucho detalle y en proporción a tu desempeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Debes hacer algo muy grande si quieres ganar mucho dinero. Si vuelvo a necesitar tu ayuda, esfuérzate un poco más y te daré una mayor recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
