					"nextDialogs": [
						207003205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003205,
					"content": "#No sean quisquillos{F#as}{M#os}. He calculado la remuneración con mucho detalle y en proporción a tu desempeño.",
