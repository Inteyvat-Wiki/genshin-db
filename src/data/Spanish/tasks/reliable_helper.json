						207004102
					]
				},
				{
					"id": 207004102,
					"content": "Los Hilichurls de la cima son los más complicados de echar. Antes, solía ir allí a disfrutar de la tranquilidad, pero ahora no me atrevo ni a acercarme. Es una lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004103,
					"content": "Humm... Pareces bastante fuerte. Puede que me sirvas para esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004104,
					"content": "Recuerda deshacerte primero del más grande, el que lleva un hacha. Me pongo furioso solo de pensar en él caminando a sus anchas por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004105,
					"content": "Y, luego, acaba con el que lleva un escudo muy grande. ¡Cuánto lo detesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004106,
					"content": "Por último, deshazte de los que llevan un bastón. ¿Cómo se llamaban?... ¿Samachurls? Sí, esos son los más débiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004107
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004107,
					"content": "En fin, ve a derrotarlos a todos. No quiero verlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
