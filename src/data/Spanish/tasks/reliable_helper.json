					"content": "Iré a la ladera de la montaña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003102
					]
				},
				{
					"id": 207003102,
					"content": "Ah, ahí hay un cargamento que llevé para vender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003103,
					"content": "Pero ahora no solo es imposible pasar por allí, sino que unos Hilichurls acechan mi mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003104,
					"content": "Por suerte, no saben distinguir un buen producto de uno malo, y ni siquiera tocaron mis cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003105,
					"content": "Ve a despejar esa zona de Hilichurls. Y recuerda: no toques el cargamento. Las cajas son muy frágiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003106,
					"content": "*Suspira*, si los caminos siguen bloqueados, me temo que no podré vender esa mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
