			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "¿Este es el Gran Santuario Narukami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500202,
					"content": "Hay muchas puertas rojas. ¿Por qué les gustan tanto a los humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500203,
					"content": "Se llaman arcos torii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "En el Santuario Asase también hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Oh, Neko ya lo entiende. Así que son arcos torii... Para que pasen los toritos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500206,
					"content": "Como hay tantos arcos torii, eso quiere decir que aquí hay muchos toritos. Si pasan por los arcos en lugar de por cualquier parte, todo está más ordenado. Los humanos son muy inteligentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500207,
					"content": "¿Ves a Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500208,
					"content": "No se ve a nadie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "Parece que no hay nadie por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "¿Por qué no subimos al Gran Santuario Narukami y preguntamos a las miko de allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "Hibiki debe ser también una miko... Quizás sepan algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "¡Miau! Este santuario es enorme, y también hay muchos humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500302,
					"content": "¡Oh! La caja de ofrendas y los estantes son muy grandes. A Neko no le extraña que venga tanta gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500303,
					"content": "Deberías tomar nota. El Santuario Asase también será así algún día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500304,
					"content": "No creo que haya tanta gente por eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "Neko no ve a Hibiki por ninguna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500307,
					"content": "Bueno, vamos a preguntar a alguien acerca de Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "¿Por qué tengo que ser yo quien tome nota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "#Hola, viajer{F#a}{M#o}. ¡Bienvenid{F#a}{M#o} al Gran Santuario Narukami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "Si te encuentras con problemas o quieres pedir un deseo, no dudes en venir aquí para pedir un palillo de la fortuna y que la Arconte Electro te bendiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "No vinimos por un palillo de la fortuna, queremos preguntarte algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "¿Preguntarme...? Oh... adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "Resulta que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "¿Hibiki, del Santuario Asase? ¿Será Asase Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "¡Sí! ¡Asase Hibiki! Humana, ¿la conoces? ¿Sabes dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500408,
					"content": "Eh... ¡¿Eh?! ¿Un gato que habla? ¿Estoy imaginando cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Ay, humanos, tanto ruido para tan pocas nueces... ¿Es tan raro que Neko hable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500410,
					"content": "¿Conoces a Hibiki? ¿Sabes dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500411,
					"content": "Sí que es raro que un gato me interrogue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "En fin, si de verdad están buscando a Asase Hibiki, vinieron al lugar equivocado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "¿El lugar equivocado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "He visto su nombre en los pocos textos antiguos bien preservados que hay en el santuario. Es la última sucesora del Santuario Asase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "Se dice que hace cuatrocientos o quinientos años, los Tres Yougou, Asase Hibiki, Kamuna Harunosuke y Mikoshi Nagamasa, fueron a la Montaña Yougou para estudiar con los tengu de Yougou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "Durante ese tiempo, Asase hizo prácticas en nuestro santuario y también trabó amistad con la Sacerdotisa Kitsune. Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "Al final, los tres se separaron tras un “desastre” del que no se dan detalles. Se dice que Kamuna Harunosuke cruzó el océano y fue a Liyue para aprender magia adéptica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mikoshi Nagamasa regresó a la Ciudad de Inazuma para servir al shogunato. Y Asase Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "Regresó a la Isla Seirai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Así es. Pero hay muy pocos datos históricos disponibles y los detalles no están claros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Un momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Humm... Hace cuatrocientos o quinientos años. Eso quiere decir que Hibiki vivió hace muchísimo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "Entonces, ¿Neko tiene cuatrocientos o quinientos años de edad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "¿Miau? Neko no está segura. ¿Qué significa “cuatrocientos o quinientos años”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500427,
					"content": "Neko no es humana y no tiene muchas cosas de las que preocuparse. Neko solo sabe cuándo sale el sol y cuándo sale la luna. Si Neko está de mal humor, dormir es el mejor remedio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500428,
					"content": "Paimon tiene mucha envidia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Paimon, si tú eres casi igual...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "¡Oye! ¡Eso no es cierto! ¡Paimon también tiene que preocuparse por ti cada día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "Están diciendo muchas cosas que Neko no entiende. Entonces, ¿dónde está Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500434,
					"content": "Con el debido respeto, me temo que Asase Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Hibiki no está aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "¡Eso es! Hibiki debió ir a otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500438,
					"content": "Tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500439,
					"content": "Bueno, Hibiki es como una niña que corre a sus anchas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500440,
					"content": "En fin, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500441,
					"content": "Ya nos vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "Vayan con cuidado. Estaré aquí si me necesitan para cualquier otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500431,
					"content": "¿Los gatos pueden vivir tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "En general, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500421,
					"content": "Regresó al Santuario Asase...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				}
			]
		},
