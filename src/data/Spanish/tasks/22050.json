				"points": []
			},
			"dialogs": [
				{
					"id": 220500501,
					"content": "Descansemos un poco, Neko está agotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "Pero es tal y como dijo Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "Las distintas islas son completamente diferentes. Además, Neko no sabía que un santuario pudiera estar en una montaña tan alta. ¿A los humanos no les dan miedo las alturas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "El Santuario Asase de Neko es mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Pero ¿dónde estará Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "¿Quieres seguir buscándola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Neko está cansada. Neko lo pensará después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "¡¿Después?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Por supuesto. Hibiki le contó muchas historias a Neko. La historia en el mar, la historia en el lugar con muchos árboles, la historia con una tal Kitsune Saiguu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "Neko las recuerda todas muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "Pero ahora lo principal es volver a casa. El Santuario Asase necesita a su Suma Sacerdotisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "Vuelvan con Neko al santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
