			"dialogs": [
				{
					"id": 220500701,
					"content": "¿Puedo ayudarte con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "Cuéntame sobre Mikoshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Cuenta la leyenda que Mikoshi Nagamasa siempre sirvió al shogunato y que fue una persona tan pura y recta que rozaba el fanatismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Su linaje ha perdurado hasta hoy en día. De hecho, en la ciudad hay gente que se apellida Mikoshi, y la mayoría son sus descendientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "Cuéntame sobre Kamuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "No hay muchas fuentes que hablen sobre él. Después de ir a Liyue a aprender magia de los Adeptus volvió a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Entonces, creó la “magia onmyoudou” y el “Shiki Taishou”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Según los registros escritos, Kamuna selló con esta magia a Ioroi, el tanuki revoltoso, para devolver la paz a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "Pero, después, desapareció sin dejar rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
				},
				{
					"id": 220500711,
					"content": "Vayan con cuidado. Estaré aquí si me necesitan para cualquier otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		}
