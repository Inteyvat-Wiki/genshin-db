				"points": []
			},
			"dialogs": [
				{
					"id": 220500601,
					"content": "¡Por fin llegamos! Pasamos demasiado tiempo al lado de ese santuario, el pelaje de Neko está todo erizado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "#Gracias por acompañar a Neko. Eres {F#una humana}{M#un humano} con {F#la}{M#el} que se puede contar. ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500603,
					"content": "Neko continuará arreglando el santuario. Cuando Hibiki regrese, Neko te la presentará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500604,
					"content": "Miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500605,
					"content": "Hibiki, ¿cuándo regresarás...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
