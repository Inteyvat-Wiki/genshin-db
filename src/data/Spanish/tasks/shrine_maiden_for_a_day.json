			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "Deseo que la Arconte Electro bendiga a esa señora y a su nieta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "¿Tiene problemas de la vista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "¿Ustedes también lo notaron? Sí, no ve bien. Siempre estamos preocupadas por su seguridad cada vez que viene a la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Sin embargo, se niega a aceptar nuestra ayuda. Ella insiste en que conoce el camino como la palma de su mano después de recorrerlo tantas veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Afortunadamente, hay varias miko en el camino que le echan un ojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Que la Arconte Electro las proteja a ella y a su nieta en sus respectivos viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
