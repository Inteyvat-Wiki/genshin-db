	"talks": [
		{
			"id": 7080301,
			"completionStepIds": [
				7080302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080302",
							"2"
						],
						"stepId": 7080302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Temerario Pallad",
					"Joel",
					"Joserf",
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "¿Eh? ¿Quién es este tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "¿No será... el padre de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "#Ah, ¡ahí estás, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030105,
					"content": "Permíteme presentarte a Joserf, el padre de Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030106,
					"content": "#¡Papá! {F#Esta es la viajera de la que te hablé}{M#Este es el viajero del que te hablé}. Me ayudó montones de veces en el pasado, ¡y esta vez incluso hicimos un muñeco de nieve juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel me contó todo sobre ti. No puedo estar más agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Me alegra que por fin se hayan reencontrado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "¡Guau! ¡Esto es increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Nada mal, Pallad, ¡nada mal! ¡Esta vez hiciste un buen trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "¿“Esta vez”? ¿Ocurrió algo la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Ehm... ¿Recuerdas la persona que dije que encontré la última vez en Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030114,
					"content": "Luego de que me acompañaste a la montaña y me ayudaste a derrotar a aquellos monstruos, seguí explorando el área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030115,
					"content": "Durante mi búsqueda, me tropecé y me fui rodando cuesta abajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030116,
					"content": "¿Ro-rodando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Por suerte, la nieve allí abajo era espesa, así que no me lastimé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030118,
					"content": "Justo cuando estaba preparándome para volver a subir, escuché ruidos al lado... Y alguien salió de la nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030119,
					"content": "Al principio no me di cuenta que era la persona que estaba buscando. De hecho, pensé que se trataba de otro aventurero de la expedición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030120,
					"content": "Después de intercambiar unas cuantas palabras me di cuenta que él tenía problemas de memoria. Ni siquiera recordaba su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030121,
					"content": "Hacía demasiado frío, y no había tiempo para pensar, así que lo convencí de que viniera conmigo al campamento y continuaríamos la conversación allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030122,
					"content": "Llegamos al campamento, vimos a Joel, quien se quedó paralizado y con los ojos como platos, y entonces exclamó entre lágrimas: “¡Papá! ¡Papá!”. Entonces, Joserf comenzó a recordarlo todo de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030123,
					"content": "Papá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Papá está aquí, Joel. Papá ya está contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Joserf, ¿no recuerdas nada en absoluto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "¿«La princesa jabalí», tú alimentando zorros?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Lo siento, no lo recuerdo. Tal vez sea por un golpe que me di en la cabeza. No estoy seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Desperté y me vi cubierto de sangre. Mis cosas habían desaparecido y no había nada que me indicara mi identidad o cómo llegué allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Escalé hasta una cueva donde pude recuperarme poco a poco. Cuando mis piernas y pies ya se sentían mejor, mis habilidades de caza me ayudaron a sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Papá... Estaba muy preocupado por ti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Ya estoy bien, Joel. No llores, papá no se irá a ninguna parte. Papá se quedará aquí contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Entonces, Joserf, ¿cuál es el plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Yo... solo quiero quedarme con mi familia por un tiempo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "¡Es maravilloso que hayas podido regresar sano y salvo! Con esto supongo que llegamos a un final feliz. ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Sin embargo, todavía tienes que trabajar en tus habilidades de aventura, Pallad. Tropezarse y rodar cuesta abajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "¡Deberás tomar clases de apoyo conmigo cuando volvamos al gremio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "¿Eh? P-pero, Sr. Cyrus... ¡Al final tuve éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030138,
					"content": "¡Andando! ¡De vuelta al gremio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "¡Sr. Cyrus, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708030109,
					"content": "Verlos juntos de nuevo es lo único importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Una versión gigante de Joel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}