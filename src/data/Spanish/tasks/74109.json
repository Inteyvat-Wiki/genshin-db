			"dialogs": [
				{
					"id": 741090101,
					"content": "Al verte, la Foca Abotargada no sale huyendo, sino que se decide aproximarse hacia ti, mostrándose contenta. Se lanza a tus brazos de un pequeño impulso y suelta suaves soniditos mientras frota su cara contra tu mejilla...\\nEs Gigaumpauva, ¡la Foca Abotargada que criaste junto a Paimon!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741090102
					]
				},
				{
					"id": 741090102,
					"content": "¡Umpa, umpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090103
					],
					"speakerTitle": "Gigaumpauva"
				},
				{
					"id": 741090103,
					"content": "¡Cuánto tiempo sin vernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741090104,
					"content": "#A Paimon le preocupaba que no pudieras vivir feliz en el mar... Pero ahora que te volvimos a ver, ¡sabemos que estás muy bien sin nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090105,
						741090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741090105,
					"content": "(Le indicas a Gigaumpauva que haga una voltereta.)",
