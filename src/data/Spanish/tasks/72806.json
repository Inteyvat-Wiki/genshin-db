			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#¿Oh? ¡Viajer{F#a}{M#o}! ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060202,
					"content": "Aquí tienes una carta y un obsequio de la Editorial Yae...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "¿Una carta de la Editorial Yae? No me pedirán que cambie mi nombre de pluma de nuevo, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060204,
					"content": "Ya les he dicho un millón de veces que usaré mi nombre real...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060205,
					"content": "*Suspira*, ¡bah, olvídalo! Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060206,
					"content": "Quieren que sea parte del jurado en una competición de escritura... Humm... No creo tener suficiente tiempo, pero debería darles las gracias de todos modos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060207,
					"content": "¿Eh? ¿Qué es esto? ¿“Sugerencias creativas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 728060208,
					"content": "#Humm... Necesito leerlas con detenimiento. Gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
