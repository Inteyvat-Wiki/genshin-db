			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingchiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Oh... Esta parte está bien escrita, y el progreso de la historia es refrescante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060402,
					"content": "Xingchiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Ya veo. Fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060404,
					"content": "¡Xingchiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#¿Eh? Ah, eres tú, {NICKNAME}. Cuánto tiempo sin verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060406,
					"content": "Por la forma de saludarme, parece que estás bien. Me alegro. ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060407,
					"content": "En realidad, esperábamos que pudieras ayudarnos a encontrar a alguien. Has leído montones de libros, así que debes conocerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "¿Una persona? ¿Buscan a un escritor? Ya veo. Soy todo oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060409,
					"content": "Vine a Liyue porque me dijeron que aquí vivía un autor, un tal “Zhenyu”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "¿“Zhenyu”? ¿E-en dónde escuchaste ese nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060411,
					"content": "Lo dice aquí, en esta copia de «Una leyenda de espadas».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Estamos buscando a ese tal “Zhenyu”, porque alguien de la Editorial Yae de Inazuma nos pidió que le entregáramos esta carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "¿Sabes algo de él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Humm... Ese Zhenyu de quien hablan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060415,
					"content": "... En realidad soy yo. Es mi nombre de pluma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060416,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Nunca lo mencionaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Pues... no pensé que valiera la pena mencionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060419,
					"content": "Al principio, el editor a cargo de este libro en Liyue me dijo: “el entorno es muy fantasioso, y la trama estaba llena de clichés. A nadie le gustará algo así”, y rechazó mi guion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060420,
					"content": "Pero... *ejem*, no me dejé llevar por sus mentiras, así que imprimí unas copias por mí mismo y las planté a escondidas en la Casa de Libros Wanwen para ver si a alguien le gustaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060421,
					"content": "Como era de esperar, no hubo muchos lectores, así que no le presté más atención. Nunca pensé que sería todo un éxito en Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060422,
					"content": "Aun así, me complace que la gente disfrute de mis escritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 728060423,
					"content": "#Ahora procederé a leer esta carta con detenimiento, viajer{F#a}{M#o}. Te lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingchiu"
				}
			]
		},
