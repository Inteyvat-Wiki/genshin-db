			"dialogs": [
				{
					"id": 413371001,
					"content": "Oh, volviste. ¿Liberaste la linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371002
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371002,
					"content": "Cuando la liberamos, ocurrió una cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "Ya veo. Zhiruo... todavía la recuerdo. En ese entonces, ella cuidaba de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371004,
					"content": "Y todavía recuerda al Clan Guhua, eso me hace feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371005,
					"content": "¿Cómo está Chue'er?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "Ah, su dolor de cabeza está mejorando, quizás solo era un resfriado. Ahora me estoy preparando para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371007,
					"content": "Sun Yu, la Zhiruo que mencionaste hace un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371008,
					"content": "¿Era del Clan Guhua? ¿Era hermosa? ¿Qué tan cercanos eran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371009,
					"content": "Humm... No puedo afirmar que la conociera bien, pero se le daba muy bien curar heridas. Cuando nos lastimábamos, íbamos directo a buscarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Jajaja, ahora que lo pienso, quizás era muy popular entre los discípulos del Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "¿Qué hay de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371012,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "¿Qué tipo de relación había... entre Zhiruo y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371014,
					"content": "Eh... No éramos tan cercanos. Humm, podría decirse que solo era una amistad entre discípulos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "Humm... Entonces, Sun Yu, ¿qué relación tenemos tú y yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371016,
					"content": "¡Jaja! Una amistad entre discípulos, ¡por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371017,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413371018,
					"content": "¿Chue'er? ¿Compañera? ¿Te pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
