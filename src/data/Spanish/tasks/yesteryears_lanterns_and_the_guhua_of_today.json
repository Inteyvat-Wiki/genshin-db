		{
			"id": 4133704,
			"completionStepIds": [
				4133704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133704",
							"2"
						],
						"stepId": 4133704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Gracias. Con esto podremos hacer la linterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "Chue'er, tienes muy buena letra. Cuando termine de hacer la linterna, escribe tú el deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Está bien, lo que tú digas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370404,
					"content": "Chue'er, ¿ocurre algo? ¿No estás feliz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "No es eso, ¡cómo no voy a estar feliz! Si puedo acompañarte a liberar la linterna celeste, estoy más que contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370406,
					"content": "*Ejem*, ¿dónde quieren liberar la linterna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Sí, tienes razón. Deberíamos hacer los preparativos para liberarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Ve tú, Sun Yu. Yo me quedaré aquí. Escalar montañas es agotador... No tengo más energías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370410,
					"content": "Pero... si acabamos de descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Me duele un poco la cabeza. Tal vez sea por el viento de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370412,
					"content": "Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "Yo les ayudo a liberarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Entonces, tengo que molestarte una vez más. Pensaba liberar la linterna celeste en un sitio especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Cuando todavía existía la Escuela Guhua, el maestro solía llevarnos ahí cada Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "Es una pena que, después de su caída, no haya ni un discípulo de Guhua que vaya a liberar linternas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "#Ya que estás dispuest{F#a}{M#o} a ayudarnos, ¿podrías ir a liberar la linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "Marcaré en tu mapa la ubicación. Mientras tanto, me quedaré a cuidar de mi compañera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "*Ejem*, deberían ir a liberar la linterna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133706",
							"2"
						],
						"stepId": 4133706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "¿Vinieron... a liberar la linterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "Solo un discípulo de Guhua conocería este lugar, pero no recuerdo haberte visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "Vine en nombre de otra persona para liberar una linterna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "¿Todavía hay discípulos de Guhua que recuerdan este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Cuando vine, no había ni un alma. A decir verdad, me sentí un poco decepcionada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Es bueno saber que todavía hay gente que recuerda la Escuela Guhua. Me siento más tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "¿Aquí liberaban las linternas los discípulos de Guhua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Humm... En aquel entonces, después de hacer las linternas celestes, el maestro reunía aquí a sus alumnos. Él iba al frente, y nosotros lo seguíamos con las linternas en mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Entonces, la montaña entera quedaba iluminada por las linternas. Era algo impresionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "Pero ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "En fin, primero liberemos las linternas, ¿de acuerdo? Podemos hablar del pasado en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
							"2"
						],
						"stepId": 4133713,
						"stateName": "QUEST_STATE_UNFINISHED"
