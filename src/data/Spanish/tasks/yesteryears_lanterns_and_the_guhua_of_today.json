			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "Cuando dejé el Clan Guhua, ya no quedaban muchos discípulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "El maestro no me culpó. Solo me deseó una buena vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370903,
					"content": "Pero no sabría decir si la vida que he llevado ha sido buena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370904,
					"content": "O mejor dicho, trato de sobrellevarla lo mejor que puedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370905,
					"content": "Escuché que hay un discípulo de Guhua llamado Sun Yu que está buscando la guía de los Adeptus para revivir la Escuela Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370906,
					"content": "Me gustaría ser tan valiente como él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370907,
					"content": "Lo siento, estoy divagando mucho, ¿cierto? Es que necesito salir de vez en cuando, tomar un poco de aire fresco y desahogarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370908,
					"content": "Te ves un poco triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "N-no, no es nada. Es solo que todos los años, en esta época, siento un poco de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370910,
					"content": "Bueno, ya casi es la hora. Les deseo un feliz Rito de la Linterna. ¿Puedes mandarle un mensaje a aquel que te envió a liberar la linterna? Dile que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370911,
					"content": "... que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370912,
					"content": "... Dile que Zhiruo le desea un feliz Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Feliz Rito de la Linterna para ti también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "Gracias, ve con cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
