	"talks": [
		{
			"id": 4133702,
			"completionStepIds": [
				4133702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133702",
							"2"
						],
						"stepId": 4133702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "¿Crees que si libero una linterna celeste aquí, los Adeptus podrán verla? Pero este material...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "¿Eh? Oh, lo siento. Mi compañera y yo estábamos meditando sobre la linterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "Pero no tenemos los materiales suficientes para hacerla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "#Si mi amig{F#a}{M#o} está de acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "Guhua esto, Guhua aquello, ¡solo hablas de Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370207,
					"content": "Al fin llega el Rito de la Linterna, ¡y solo pides deseos para la Escuela Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370208,
					"content": "Chue'er, ambos somos discípulos de Guhua, es natural que nuestra responsabilidad sea restaurar la antigua gloria de la escuela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Sí, sí... Como tú digas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370210,
					"content": "#*Suspira*, estimad{F#a}{M#o} amig{F#a}{M#o}, si estás de acuerdo, ¿podrías ayudarme a recolectar material para las linternas celestes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "¡Cuenta conmigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "*Ejem*, ya hice un recuento de los materiales, y al parecer falta una flor chingxin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "Las flores que recogí se marchitaron, así que ya no me sirven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "¿Se pueden usar para hacer linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Jeje, es un método que ideé con mis compañeros de la Escuela Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Supongo que hacer linternas celestes fragantes es un buen detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Estaré aquí esperándote. Cuando tengas los materiales, tráelos. Perdón por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Parece que tu compañera tiene algo que decir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Oh, no es nada. Haremos lo que Sun Yu diga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 413370215,
					"content": "*Suspira*, Chue'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
