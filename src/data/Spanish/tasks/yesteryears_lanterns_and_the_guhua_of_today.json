			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "Una vez, vi un rayo de esperanza. Se trataba de un joven muchacho que acababa de entrar en la Escuela Guhua. Era apuesto, educado y excepcionalmente talentoso. Parecía que él iba a poder devolvernos nuestra gloria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "Pero era muy difícil seguirle el rastro, y con frecuencia desaparecía durante largos periodos de tiempo... *Suspira*, supongo que me equivoqué al poner mis esperanzas en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "Así que, al final, preferí olvidarme de él y no esperar que regresara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133715",
