			"dialogs": [
				{
					"id": 413371101,
					"content": "Chue'er, ¿por qué de repente te duele la cabeza? ¿No quieres tomar medicina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371102,
					"content": "N-no es necesario, con que me acompañes, estaré bien pronto.",
