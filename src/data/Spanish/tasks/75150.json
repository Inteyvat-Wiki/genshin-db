			"dialogs": [
				{
					"id": 751500401,
					"content": "¿Cómo puedo llegar al Corazón de la Montaña Sagrada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "La entrada al Corazón de la Montaña Sagrada está cerca de aquí. Al reconstruir el centro de la ciudad de Tollan, el señor Xiuhcóatl excavó hacia abajo para crear un entorno experimental estable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500403,
					"content": "Una vez allí, creó el arma definitiva con la que derrotar al Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500404,
					"content": "Sin embargo, el sello causó que el dispositivo sufriera el mayor nivel de corrosión del Abismo, por lo que al final, la ciudad fue ocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500405,
					"content": "La entrada al Corazón de la Montaña Sagrada se encuentra bajo la grieta de la Ciudad Sagrada. Allí está el enemigo oculto bajo las sombras y el lugar donde más grave es la corrosión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragosirviente fuentenigma"
				}
			]
		},
