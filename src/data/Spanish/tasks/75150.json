				{
					"id": 751501503,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501504,
					"content": "Jeje, ¡qué pronto nos hemos reencontrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "Lo siento, pero no he encontrado información sobre ustedes en mi base de datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501506,
					"content": "Hace al menos quinientos años que un humano no pisa este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501507,
					"content": "Un momento, ¿no eres Amaru? Humm, ¿y tampoco Ehécatl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "Existen individuos con esa identificación, pero yo no soy uno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501509,
					"content": "Tal vez haya habido algún tipo de malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501510,
					"content": "Soy un prototipo creado por el señor Xiuhcóatl con el fin de registrar información. Por eso no tengo nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501511,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "No, tampoco es que carezca de nombre. Soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501513,
					"content": "Soy el único dragosirviente sin dueño con derecho a tener inteligencia. Tras la caída del señor Xiuhcóatl, seguí encargándome de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501514,
					"content": "El mantenimiento más básico de la ciudad y el registro de la información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501515,
					"content": "Sin embargo, debido a la invasión del enemigo oculto bajo las sombras, una parte de mis registros se perdió, por lo que no poseo ningún dato sobre mi nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501516,
					"content": "Vaya, pues es verdad que era un malentendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "No importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501518,
					"content": "Humm, este robot es enorme, pero parece un poco bobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, no parece ser esa persona que hablaba con nosotros por medio de máquinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Aun así, ¿no dijo que se encargaba de... registrar información?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Preguntémosle a ver si sabe algo. O... humm... ¡preguntémosle cómo se llega al Corazón de la Montaña Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "A lo mejor eso era lo que quería “esa persona”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
