			"dialogs": [
				{
					"id": 751501301,
					"content": "¿Hay alguna consulta que quiera realizar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501302,
					"content": "¿Cómo puedo llegar al Corazón de la Montaña Sagrada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "La entrada al Corazón de la Montaña Sagrada se encuentra en el acceso que ha sido abierto hace poco. Descienda hasta la fisura más profunda bajo el volcán, la cual es custodiada por un dragón fuentenigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501304,
					"content": "Por otro lado, cualquier persona que quiera entrar al Corazón de la Montaña Sagrada necesita un permiso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501305,
					"content": "Solo así podrá obtener el reconocimiento del dragón fuentenigma que protege... el Corazón de la Montaña Sagrada, es decir, el Huitzilopochtli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501306,
					"content": "¿Dónde puedo conseguir un permiso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Según el acuerdo y las órdenes del señor Xiuhcóatl, para entrar al... Corazón de la Montaña Sagrada, es decir, al Huitzilopochtli... los descendientes de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501308,
					"content": "Por favor, diríjase a la Cámara de Deliberación para solicitar un permiso y espere hasta su expedición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501309,
					"content": "¿Cuánta energía necesita un dragón fuentenigma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Buscando... No se han encontrado los datos correspondientes. Muchos datos se han perdido, probablemente debido a la corrosión que el Abismo ha causado en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501311,
					"content": "Si consigue eliminar los efectos del Abismo y recuperar los datos, tal vez pueda encontrar la información que necesita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501312,
					"content": "He marcado un posible punto de almacenamiento de datos recuperables. Por favor, elimine la corrosión del Abismo de dicha zona para recuperar los datos almacenados en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501313,
					"content": "¿Hay alguna consulta que quiera realizar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751501314,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
