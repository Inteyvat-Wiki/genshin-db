			"dialogs": [
				{
					"id": 751500901,
					"content": "Hola. Se ha detectado una nueva categoría de recuperación de datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500902,
					"content": "Se han actualizado las entradas sobre los núcleos de energía de los Mecanismos Fuentenigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500903,
					"content": "El flogisto es la energía que permite el funcionamiento del núcleo de un Mecanismo Fuentenigma. No obstante, se trata de un flogisto extremadamente concentrado y similar a la luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500904,
					"content": "Se pueden generar unidades estables de flogisto por medio de la reacción controlada de [DATOS NO ENCONTRADOS], lo que permite un control más preciso de la energía empleada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500905,
					"content": "La energía que necesita un Mecanismo Fuentenigma depende de la complejidad de su lógica de funcionamiento y el tamaño de la máquina. Por ejemplo, un dragosirviente fuentenigma necesita [DATOS NO ENCONTRADOS] unidades de flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500906,
					"content": "Por su parte, los dragones fuentenigma, de mayor tamaño, necesitan menos unidades de flogisto, concretamente, tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500907,
					"content": "“La información es energía, y la energía es información”. El medio de almacenamiento de datos que ha recuperado cuenta como una unidad de flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500908,
					"content": "O sea que una bola de fuego equivale a una unidad de flogisto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Sí, puede verlo de esa forma. Yo solo puedo llevar a cabo la extracción si ustedes recuperan las unidades de flogisto corroídas por el Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751500910,
					"content": "También puede verlo como una forma de energía alternativa para los Mecanismos Fuentenigma corroídos por el Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragosirviente fuentenigma"
				}
			]
		},
