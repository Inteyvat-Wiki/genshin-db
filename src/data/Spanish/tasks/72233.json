					"id": 722330501,
					"content": "#¿Algo más que quieras preguntarme, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "Sobre el reino de Byakuya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Antes, el nombre de Enkanomiya era el reino de Byakuya, porque en ese reino subterráneo no había ni sol ni luna, solo la noche blanca y la noche infinita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Uno de mis antepasados fue una miko llamada Eboshi. Fue un personaje importante en la historia del reino de Byakuya, y es por ella que me pusieron a cargo de la ceremonia de ofrendas de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
