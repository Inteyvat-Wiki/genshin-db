						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Estos objetos reciben el nombre de “llaves con patrones”, y se utilizaban en Enkanomiya. Aparecen sobre el suelo cuando el camino está a punto de abrirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Se dice que hay otro juego de llaves que se concederá a los habitantes de la Isla Watatsumi cuando Enkanomiya despierte. Además, hay registros de que existen cinco tipos de llaves con patrones en Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Hasta ahora, hemos encontrado tres tipos en la Isla Watatsumi. Tras devolverlas a su ubicación original, podemos desbloquear el sello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Extrajimos las tres que encontramos y las distribuimos en otros lugares de la Isla Watatsumi. Así podremos restaurar la barrera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "El objetivo era evitar que maleantes insensatos, espías de los Fatui, habitantes de la Isla Narukami o forasteros se colaran en nuestro territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Pero, por supuesto, tú no eres uno de esos forasteros. Jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "En estos momentos es imposible contactar con el Gremio de Aventureros, por lo que tampoco podemos permitir el acceso de aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "¿Acaso les permitieron acceder alguna vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Esto se ha repetido en diferentes momentos de la historia. Al final la colaboración nos beneficia a todos. Al fin y al cabo, tanto ellos como ustedes son los más experimentados en exploraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Oh, ¿eso significa que nadie nos ha robado el trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Paimon, esos modales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "¿Cómo explicarlo?... Esta barrera que activamos de forma temporal no es muy fiable. En el tiempo que nos llevó investigar la ubicación de los símbolos y extraerlos, es muy probable que se colara uno que otro maleante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Después de todo, apenas tenemos quien nos ayude... Por eso, si encuentran algún Fatui, ladrón de tesoros, Samurái Kairagi o cualquier intruso, no duden en darle una buena tunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Entonces, si pueden atravesar la barrera tan fácilmente, ¿de qué sirve que hayamos obtenido la llave de las no sé qué melenitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Solo lograremos que Enkanomiya despierte con la llave de las profundidades selenitas. De la misma manera, solo con esta llave podremos activar el sistema de pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Si hubiera alguien que no entró a Enkanomiya para realizar la ceremonia de ofrendas, quizás haya entrado con a saber qué otro retorcido método.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "En fin, espero que se pongan en marcha lo más pronto posible. Apresúrense y extraigan las llaves con patrones cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Las llaves las pusimos en la aleta y el corazón de Watatsumi. En cuanto a los dos altares, se encuentran en la línea montañosa que hay entre el Santuario Sangonomiya y las profundidades selenitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Esperaré sus noticias en el lugar de siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
		{
			"id": 7223303,
			"completionStepIds": [
				7223308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
