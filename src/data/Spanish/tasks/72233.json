					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}, ¡hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Hola, Tsuyuko. ¿Qué tal van los preparativos para obtener el coral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ah, ni me lo recuerden. Otra vez me encontré con imprevistos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Ahora Paimon comprende por qué tienes esa cara larga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Pero ¿qué intentas decirnos con esas miradas tan persistentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ah, conque se percataron de la gravedad de la situación. Entonces no tengo por qué seguir ocultándolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "¿Por qué querrías ocultarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Aunque obtuvimos la llave de las profundidades selenitas y Enkanomiya se está despertando lentamente, todavía no hemos conseguido un gran progreso en la investigación, pues no disponemos de personal suficiente que nos ayude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Al fin y al cabo, estamos atravesando unas circunstancias especiales. No sé si la tensión con la Isla Narukami se calmará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Entonces... mi ayuda tampoco serviría de mucho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "#Contigo sería diferente. Según la tradición, no habría nadie más adecuado para obtener el coral que {F#una heroína}{M#un héroe} como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Primero, es necesario construir una base y ayudar al héroe a explorar el rastro de nuestros antepasados antes de enfrentarse a la prueba final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "Es un método que garantiza el éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Pero no pueden seguir con el plan por falta de personal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Eso es. Cuando más necesitamos héroes, no se les ve ni por asomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "#Pero parece que por fin encontramos {F#una}{M#uno}. ¡{F#Y una rubia}{M#Y uno rubio}, para ser precisos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Guau, suena problemático. Paimon no cree que este viaje sea buena idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "La ventaja de esto es que durante las exploraciones solemos encontrar tesoros extraños. Por costumbre, los tesoros deben entregarse al Santuario Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Pero si esta vez encontraras algo, supongo que podríamos hacer la vista gorda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Podrías, simplemente, cerrar los ojos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "#¡{F#Nuestra heroína}{M#Nuestro héroe}, valiente caballer{F#a}{M#o}, {F#nuestra salvadora}{M#nuestro salvador} de gran corazón!... ¿Eso significa que aceptas, entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "¡¿Cómo íbamos a ignorar al Santuario Sangonomiya cuando está en peligro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "¡Maravilloso! Está claro que los métodos que nos enseñó Kokomi son realmente persuasivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Incluso predijo que vendrían a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "¡¿Cómo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Oh, nada, nada. Síganme. Quiero mostrarles algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Nos vemos en el altar de ahí enfrente. Si no lo ven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Si no lo vemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Entrecierren sus ojos para ver mejor, está por el sureste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Mi relación con Kokomi es demasiado buena como para hacer eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
