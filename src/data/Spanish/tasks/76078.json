			"dialogs": [
				{
					"id": 760780301,
					"content": "(Aunque los monstruos se hayan dispersado, la oscuridad permanece. Si quieres resolver el problema de este lugar, tal vez necesites la ayuda de un experto que sepa más sobre la Cacería salvaje.)",
					"roleType": "TALK_ROLE_NPC",
