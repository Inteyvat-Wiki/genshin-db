			"dialogs": [
				{
					"id": 760780101,
					"content": "Por lo general, una vez que se ha derrotado a todos los monstruos que acompañan la Cacería salvaje, el miasma debería disiparse con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Pero esta grieta persiste... Es inusual, pero tampoco la primera vez que ocurre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Busquemos por los alrededores, debe haber quedado algo contaminado en el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
