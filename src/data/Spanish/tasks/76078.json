					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Aquí también hay una lámpara del juramento. Debió haberle pertenecido a alguien que vino mucho antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "La lámpara sigue impregnada de la corrupción de la Cacería salvaje. No es difícil imaginar qué pudo pasar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Desde el día en que levantamos la lámpara del juramento, nuestras vidas están vinculadas a su luz, hasta el momento en que nuestra misión llega a su fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Le ofrezco mis respetos más sinceros a aquel que luchó hasta su último aliento por la paz y la seguridad de Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Tomaré su lámpara por el momento. Quédese tranquilo, pues la corona de los héroes caídos mantendrá a buen recaudo su legado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "La llevaré de vuelta al cuartel general y volveremos a prender su llama para confiársela a alguien merecedor de seguir cumpliendo su voluntad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga limpia la lámpara y la guarda solemnemente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Con esto, la Cacería salvaje se ha disipado por completo de este lugar, y el espíritu de nuestro predecesor ha encontrado por fin su reposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
