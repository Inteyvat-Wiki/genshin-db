			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Normalmente, las fisuras deberían desaparecer por sí solas al eliminar a los monstruos cercanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Entonces, ¿por qué permanece aquí la presencia de la Cacería salvaje? Es demasiado extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "¿Tal vez he pasado algo por alto? ¿Podría algo más haber sido contaminado por la influencia de la Cacería salvaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
