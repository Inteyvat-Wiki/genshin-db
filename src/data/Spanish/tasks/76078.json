						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Oh, es una lámpara. Se trata de un objeto de gran importancia que todos los Lampareros llevan consigo. Es la clave para dispersar la Cacería salvaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "La lámpara está aquí, y el miasma de la Cacería salvaje aún permanece en su cubierta, pero su dueño ha desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Aunque es un tanto desconcertante, no es difícil imaginar lo que ocurrió aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "El sacrificio de los Lampareros suele pasar desapercibido. Descubrir de forma inesperada que alguno de mis colegas ha perecido es siempre una verdadera pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "Permite que cuide de la lámpara que dejaste atrás, hombre sin nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Será limpiada y su luz volverá a ser prendida. Luego, se le entregará a un nuevo Lamparero que tome el juramento de proteger Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins limpia la lámpara y la guarda cuidadosamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Esta debe ser la razón por la que la Cacería salvaje no desapareció por completo. La guardaré hasta que alguien pueda venir a recogerla del cuartel general.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "Parece que hay algo debajo de la lámpara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Debe de ser una reliquia que dejó también el compañero. Tal vez debería quedarse junto a la lámpara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
