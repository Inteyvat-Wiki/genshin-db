			"dialogs": [
				{
					"id": 718291201,
					"content": "Ahora enciende el fuego y cuece la carne picada a fuego lentamente dentro de la sopa de antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291202,
					"content": "Ten mucho cuidado con la intensidad del fuego. Si es demasiado débil, la carne no se cocinará, y si es demasiado fuerte, se desmenuzará y perderá su textura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291203,
					"content": "¡Hasta se necesita un caldo especial para hervir la carne! Desde luego que no es el plato más barato que se puede hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
