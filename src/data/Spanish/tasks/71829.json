			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "¿Eh? Pero qué visita tan inesperada. Normalmente, el cocinero me acompaña sin decir una sola palabra. Ahora que estás tú, quizás la comida sea un poco más amena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Pero el cocinero se ve bastante apurado el día de hoy. ¿Estará preocupado por algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Estas albóndigas saben deliciosas. Se deshacen de inmediato en la boca. Y este caldo tan aromático...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "¿Eh? Y además tiene dentro pasta de cangrejo. Con razón tenía un sabor tan inusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "#Toma, viajer{F#a}{M#o}, prueba una. Mira, yo te enseño. Primero, usa los palillos para partir la albóndiga. Luego remójala en el caldo y acompáñala con un bocado de arroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Buen provecho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Ustedes disfruten mientras puedan de la comida. Después de todo, ya no trabajaré más aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290410,
					"content": "¿Ya no trabajarás aquí? ¿Pero qué estás diciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "*Suspira*, ¿acaso es porque como a tus expensas y el gerente se molestó contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "¡Imposible! Pero si siempre llevo pescado a la posada. Con eso debe ser suficiente para pagar mis comidas. Además, el gerente no es tan tacaño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "¡Debes estar bromeando! ¡Solo trajiste unos pocos pescados! Además, todos ellos terminaron en tu barriga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Bueno, eso no lo puedo negar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "*Suspira*, está bien, te lo contaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Un buen emplatado, un delicioso sabor, con estilo, artesanal y con personalidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Jajaja, ese gerente quiere que crees un plato que nunca antes se haya visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "¡Ya veremos quién ríe al último! A ver a expensas de quién comes cuando yo me vaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Está bien, basta. Así que hoy estabas tan apurado por una tontería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Es difícil estar contento cuando tu jefe espera que hagas un milagro de la nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290421,
					"content": "No te apures. No puedo cocinar, pero conozco una receta extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Durante mis años de viaje, tuve la oportunidad de compartir la mesa con una familia acaudalada. El manjar que probé era un pollo con textura de tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "A simple vista, nadie diría que es carne. Su textura es tierna como la del tofu, pero con un sabor a carne y hierbas aromáticas. Es un fascinante plato de carne que imita a la cocina vegetariana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Me dio mucha curiosidad cuando lo comí, así que aprendí la receta. Es solo que... a mí no se me da bien cocinar, así que la receta ha estado todo este tiempo acumulando polvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "¿Cómo conseguiste una receta así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Bueno... En pocas palabras, ayudé a una persona y me invitó a un banquete para agradecérmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Al chef que inventó la receta no le importó compartirla conmigo. Estaba seguro de que solo un puñado de personas serían capaces de cocinar ese plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Según aquel chef, los cocineros que pueden hacerlo no solo tienen unas excelentes habilidades culinarias, sino que también dominan el arte de la espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "*Tch*, ¿para qué clase de comida se necesita dominar la espada? Si es para cortar la carne, me basta con un cuchillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290431,
					"content": "Me temo que partirías la tabla de cortar por la mitad antes de cortar la carne lo suficientemente fina con ese cuchillo tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "Me dijeron que la carne es el punto clave de este plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Por eso, hay que usar el cuchillo como si fuera una espada. Primero quitas la grasa de la carne y la cortas. Luego, usas la parte trasera del cuchillo para picarla. Después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Para un momento, por favor. No va a servir de nada que recites la receta, ya que tú nunca cocinas. No soy tan buen espadachín, y tú no eres buen cocinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Pero ¿dónde podemos encontrar un chef espadachín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Esa persona... podría estar más cerca de lo que imaginas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "¿Y-yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "#Efectivamente. ¿Acaso no eres tanto {F#cocinera}{M#cocinero} como {F#espadachina}{M#espadachín}, {F#viajera}{M#viajero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "#¿Y si dejamos que {F#la viajera}{M#el viajero} intente hacer este plato tan especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Pero el gerente quería que lo hiciese Yanxiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "¿Eh? Lo que quería el gerente es que Yanxiao pensara en un plato, pero no dijo quién debía cocinarlo, así que eso aún se puede hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "¿No es así, chef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Eh... ¡Sí! Así es, así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290446,
					"content": "¿Qué ingredientes se necesitan para hacer un pollo con textura de tofu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Oh, son bastante comunes. Solo se necesita carne de ave, jamón, huevo y flor dorada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "De carne de ave y jamón tenemos reservas aún, pero el huevo y la flor dorada... creo que ya se agotaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290449,
					"content": "*Suspira*, de haberlo sabido antes, no hubiera hecho ese revuelto de matsutakes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290450,
					"content": "#Viajer{F#a}{M#o}, ¿me ayudarías a buscar un huevo y una flor dorada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Cuando los encuentres, veremos cómo hacer ese pollo con textura de tofu entre los dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Oh, no faltará una recompensa, claro. Bien, cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290439,
					"content": "Bueno, es cierto que sé cocinar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "Y también tienes un excelente manejo de la espada, ¿no es así? Yo mismo he sido testigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Debe ser muy difícil de hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Eres todo un experto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Jajaja, si comes estas delicias con frecuencia, hasta un pobre tonto como yo puede apreciar la comida. Ahora te enseñaré cómo se come este estofado de pescado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Yanxiao, ¿no comes con nosotros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "¿Yo? Después del sermón del gerente perdí el apetito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
