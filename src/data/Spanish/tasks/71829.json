					"content": "Está bien. Primero, quítale la grasa a la carne con la espada. Córtala finamente hasta convertirla en carne picada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290703,
					"content": "¿Qué quieres que haga primero?",
					"roleType": "TALK_ROLE_PLAYER",
