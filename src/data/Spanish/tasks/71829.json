						718290703
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718290702,
					"content": "¿Qué procede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290704
					]
				},
				{
					"id": 718290704,
					"content": "Veamos... Tú, parásito, ¿por qué no nos orientas un poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
