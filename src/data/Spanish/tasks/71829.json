			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao",
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Déjame probarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Oh, este sabor... Es exquisito, y parece como si estuviera comiendo tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291403,
					"content": "Qué aspecto tan hermoso, ¡y qué destreza se necesita para cocinarlo! Un plato de carne que pasa como plato vegetariano... Seguro que mucha gente querría probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291404,
					"content": "No está nada mal. ¡Al gerente le gustará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Nunca pensé que tendrías alguna habilidad aparte de ser un parásito, pero me sorprendió que recordaras tan bien la receta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Jeje. Quizás te interese saber que, en un principio, pensaba que esta receta guardaba una técnica secreta de espada, así que la estudié día y noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "En retrospectiva, creo que me obsesioné demasiado con practicar mi técnica de espada. Después de todo, solo es una receta, ¿qué técnica se va a necesitar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "¿Por qué empezaste a practicar con la espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Para buscar a alguien y hacer justicia. Nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "¿Por qué hablas de algo tan importante como si fuera una tontería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Jaja, bueno, una vez que se hizo justicia, vine directamente aquí. Tuve la suerte de que el gerente me dejara quedarme aunque no aportara nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Ahora ya no tengo ningún deseo. Ni quiero volver a empuñar una espada ni tengo ninguna habilidad... Jajaja. Así que quedarme aquí el resto de mi vida no suena tan mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "#Bueno, supongo que puedo darte una copia de la receta. Si tienes tiempo, puedes hacerla para ti mism{F#a}{M#o}. Aunque es un poco difícil, el sabor es excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Humm... Bien, pongamos este plato en otro lado para mostrárselo al gerente cuando venga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291418,
					"content": "Y después... Eh, parásito, no tan deprisa. Ven aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291419,
					"content": "¿Qué quieres? Ya no tengo más recetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Dijiste que no tenías ninguna habilidad aparte de jugar con espaditas, ¿cierto? Vamos, desenvaina tu espada, que te voy a enseñar a cortar carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291421,
					"content": "¿Cortar carne? P-pero tengo miedo de que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "¿“P-pero tengo miedo”? Vamos, tienes que aprender a cortar carne antes de poder cocinarla. Cuando aprendas a hacer varios platos, podrás decir que ya tienes una habilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291423,
					"content": "¿Qué estás...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "¡Hum! Cuando hayas aprendido a cocinar, no tendrás que volver a buscar comida por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291425,
					"content": "¡Vamos, no te quedes ahí parado! Si sigues holgazaneando, ¡olvídate de comer albóndigas mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291426
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718291426,
					"content": "¡Este cocinero! ¿Cómo te atreves a amenazarme de ese modo? Está bien, está bien, ya voy a cortar carne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291415,
					"content": "¿Seguirás quedándote aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291416
