					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "¡Arg! ¡Tú otra vez! Asustaste a todas mis palomas... ¡De nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480102,
					"content": "Las estaba alimentando. ¿Qué tienes que decir al respecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480103,
					"content": "Ups...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "¡Hum! Bueno, mami siempre me dice que si alguien lo siente mucho, lo mostrará con sus acciones, no con sus palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480105,
					"content": "Las palomas del puente son mis amigas. Las alimento todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480106,
					"content": "Pero recientemente los patos vienen y roban su comida, y las palomas ya no tienen suficiente para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480107,
					"content": "Quiero que encuentres tres montones de trigo para mí y les des de comer a los patos. Mientras haces eso, puedo asegurarme de que las palomas del puente coman lo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480108,
					"content": "Una vez que ambas partes hayan comido lo suficiente, tal vez todos puedan hacerse amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480109,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480112,
					"content": "Si tratas bien a los animales, quizás también puedas hacerte amigo de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480110,
					"content": "La amistad con las palomas nunca fue una opción.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "#Independientemente de que quieras ser amig{F#a}{M#o} de ellas o no... ¡Les debes una disculpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480114,
					"content": "¡Así que date prisa y consigue ese trigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
