				},
				{
					"id": 200480303,
					"content": "Tendré más cuidado en el futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "Bien. Te perdono. Toma, es una tortilla de papas de Mondstadt. ¡Son mis favoritas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Mami dice que siempre debes ser amable con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
