			"dialogs": [
				{
					"id": 3550701,
					"content": "¡Estuvo cerca! ¡Casi manda a Paimon por los aires!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550702,
					"content": "Por suerte, Paimon pudo agarrarse de tu cabello, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "La suerte es que no me lo arrancaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "¿Qué fue eso? Paimon pensó que íbamos a ser su cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Seguro que tiene que ver con esa persona rara que hablaba con el dragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "No sabía que había dragones en este mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Sí, Paimon entiende tu preocupación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "¿Eh? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Encima de esa roca enorme hay algo que emite una luz roja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Acerquémonos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
					"content": "¿Es normal que la gente pueda hablar con dragones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550710
					]
				},
				{
					"id": 3550710,
					"content": "¡Por supuesto que no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550704,
