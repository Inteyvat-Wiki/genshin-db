			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#¡{NICKNAME}, aquí, aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570202,
					"content": "¿Te acuerdas de este lugar? Aquí es donde empezamos nuestro viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570203,
					"content": "Ni nos dimos cuenta y ya hemos estado en un montón de sitios diferentes. ¡Paimon siente tanta emoción que podría hasta escribir un poema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570204,
					"content": "Adelante, gran poetisa Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Jaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Ey, no interrumpas. Deja que Paimon piense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570207,
					"content": "¡Ah! ¡Teyvat, qué grande eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570208,
					"content": "¡Ah! ¡Viajamos mucho, pero aún no te recorremos entero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570209,
					"content": "(Permanecer en silencio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "Pero si ni siquiera rima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "¡Ah! Ah... Paimon no puede pensar en nada más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570212,
					"content": "Jajaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "¿Estás reflexionando sobre todas las dificultades que sufrimos en el viaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "¡Hum! Está bien, ríete si quieres. Después de viajar tanto contigo, Paimon ya se acostumbró.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570215,
					"content": "Exacto, eso es lo que Paimon quiere expresar. ¡Tú sí que entiendes a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570216,
					"content": "Pero hablando en serio, después de viajar tanto, es muy fácil olvidarse de los comienzos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570217,
					"content": "Por ejemplo, Paimon ahora casi no puede recordar el sabor del pollo asado con miel, con lo mucho que le gustaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570218,
					"content": "Por eso a Paimon se le ocurrió comprar los álbumes, para recordar los lugares que recorrimos y la gente que conocimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570219,
					"content": "En las novelas ligeras y las kinografías suele haber escenas así. Cuando se regresa al punto de partida, quiere decir que el gran final está cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570220,
					"content": "Si Paimon eligió tomar imágenes aquí no fue porque se sintiera triste o nostálgica, sino porque siente que, si recordamos de dónde venimos, el viaje se nos hará más fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570221,
					"content": "¿Escuchaste a escondidas mi conversación con Kazuha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "¡Paimon, has evolucionado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Oh... Paimon reconoce que escuchó a escondidas tu conversación con Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570224,
					"content": "Ay, con lo mucho que le costó a Paimon crear este ambiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570225,
					"content": "Paimon, entiendo lo que quieres decir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "#Tenemos que seguir avanzando junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "Jeje, Paimon se alegra de que la entiendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570228,
					"content": "¡Muy bien! La mejor guía de todo Teyvat te hará de modelo para esta imagen. ¿Qué pose te parece apropiada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570101,
					"content": "Un momento, ¿y el Daguerrotipo que Paimon te prestó? No lo habrás perdido, ¿verdad? Revisa si lo tienes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
