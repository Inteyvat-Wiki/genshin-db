				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albondimaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "#Ah, aquí estás. Pensé que estarías demasiado ocupad{M#o}{F#a} volando por las islas con esas alas tuyas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270102,
					"content": "Apuesto a que te habías olvidado de tu viejo amigo, Albondimaru, aquí flotando en soledad en la inmensidad del mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270103,
					"content": "Si estamos aquí es porque nos hemos acordado de ti, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "Por cierto, dijiste que necesitabas nuestra ayuda. ¿Qué ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "No es nada importante, en realidad... ¿Recuerdan cuando me ayudaron a encontrar las partes del barco que me faltaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270106,
					"content": "A ver, cómo decirlo... No estoy seguro de si es porque he cumplido mis deseos, o si este mar está mermando poco a poco mis habilidades de comunicación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270107,
					"content": "Pero últimamente me encuentro durmiendo la mayor parte del tiempo en lugar de permanecer consciente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270108,
					"content": "¿Tendrá algo que ver con esa máquina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#Ya veo. Así que me convertí en el Rompeolas de {NICKNAME} y obtuve la capacidad de comunicarme con ustedes gracias a una máquina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270111,
					"content": "Entonces... ¿eso significa que una vez desaparezca el efecto de la máquina, Albondimaru ya no podrá hablar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, tenemos que hacer algo antes de que sea demasiado tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Jaja, no te preocupes, Paimon... Estoy muy feliz de haber tenido la oportunidad de hablar con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270114,
					"content": "Ah... Cuanto más lo pienso, que un barco como yo pueda hablar con ustedes como lo he hecho estos últimos días ya es algo de lo más sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270115,
					"content": "Pero ahora, tengo que pedirles un favor más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270116,
					"content": "Claro, dinos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "¿Recuerdan cuando les dije que una vez recuperado mi cuerpo, podría llevarles de crucero por aquí? Bueno, ya vieron que mi cuerpo quedó hecho un desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270125,
					"content": "Se llevaron la mayoría de los tesoros. No queda nada de valor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270118,
					"content": "Pero esta vez, por mi honor de poderoso barco pirata, ¡juro que encontraremos un gran tesoro! Y si no, ¡que me atrapen las algas marinas y mi madera sirva para dar de comer a los peces! Confíen en mí una última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, Albondimaru tal vez deje de poder hablar muy pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#Y... ya que esta vez seguro que encontraremos un tesoro... ¡Tenemos que ir, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "No cambiarás nunca, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "¡Muy bien! ¡Es hora de zarpar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "¡En marcha, entonces! ¡A bordo, grumetes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270122,
					"content": "Bueno, si tú lo dices...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Será porque desactivamos esa máquina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albondimaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "¡*Fiu*! Eso estuvo cerca. ¡Paimon creyó que nos íbamos a hundir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "¡Eres increíble, Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Jaja, aunque pueda hablar, sigo siendo un simple barco. Las magníficas habilidades de navegación de {NICKNAME} fueron las que nos permitieron atravesar la tormenta a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270604,
					"content": "¿Quieres hacerlo de nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Jaja, preferiría no hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270607,
					"content": "Me temo que la tormenta eléctrica la provoqué yo. Parece que las aguas de aquí son más inestables que antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270608,
					"content": "#Pero... ¡hemos llegado! {NICKNAME}, Paimon, ¡el tesoro está ahí arriba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270609,
					"content": "¿No es este el lugar que visitamos la primera vez que buscábamos un tesoro? ¡Entonces, aquí no había más que la mitad del casco de Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Esta vez, estoy seguro de que aquí hay un tesoro... Supongo que podría decirse que es... ¿cómo lo dije la última vez? Ah, sí, ¡la intuición de un poderoso barco pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270611,
					"content": "¿De verdad? Ah, por cierto, dijiste que tenías dos cosas que contarnos. La primera era que por fin recordabas tu nombre. ¿Cuál es la otra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Jajaja, pensé que ya lo habían olvidado. ¡Se lo diré cuando vuelvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790270605,
					"content": "Gracias por el cumplido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902710",
							"2"
						],
						"stepId": 7902710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albondimaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "¡Kosekimaru! ¡Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "Encontramos el tesoro. ¡Mira, es una maqueta de un barco pirata! ¡Parece que por fin se hizo realidad tu corazonada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "Bueno, ¿qué otra cosa querías contarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790271005,
					"content": "¿Kosekimaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(El barco Kosekimaru no responde...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "Albondimaru"
				},
				{
					"id": 790271007,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "... Humm, pero dijo que nos lo contaría cuando volviéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "Kosekimaru... ¡eres un mentiroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "Kosekimaru ya no puede hablar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
			]
		}
	]
}