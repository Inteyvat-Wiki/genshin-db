	"talks": [
		{
			"id": 7902701,
			"completionStepIds": [
				7902701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902701",
							"2"
						],
						"stepId": 7902701,
						"stateName": "QUEST_STATE_UNFINISHED"
