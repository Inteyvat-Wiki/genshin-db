						"rawParams": [
							"7320113",
							"2"
						],
						"stepId": 7320113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "“Después de todos estos años, este lugar sigue estando rebosante de vida. Cada vez que vengo aquí, recuerdo cuando pasé toda la tarde discutiendo con él sobre el significado de una sola palabra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011302,
					"content": "Nuestra tienda no tendría tanta alegría sin su presencia, así que no se olvide de seguir visitándonos a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		}
	]
}