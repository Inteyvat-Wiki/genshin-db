			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Este es el tablón de anuncios del Café Puspa. Por ciertos motivos, yo seré la nueva gerente en funciones. Si tiene algo de lo que desee informarnos, no dude en dejar un mensaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "“¡Esta semana continuamos con la leyenda del héroe Antara!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010202,
					"content": "“Les presentamos al invitado especial del Café Puspa, ¡el cuentacuentos Madah! ¿Se lo van a perder?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010203,
					"content": "Sr. Madah... Le ofreceremos una taza de café gratis si deja de publicar anuncios aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "“Jeje, Gata, jeje”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010302,
					"content": "Parece que le agrada mucho a Gata, Srta. Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "“¡El Club de Cartas Puspa continúa reclutando nuevos miembros para jugar a Invocación de los Sabios!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010402,
					"content": "“Si quieres charlar sobre estrategias y técnicas de juego, ¡ven a buscarme a la mesa de juego!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010403,
					"content": "Señor Nayab, pida al menos una taza de café si quiere jugar a las cartas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "“Se han registrado varios casos recientes de contrabando de cápsulas de conocimiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010502,
					"content": "“Recordatorio especial de la matra: utilicen medios lícitos para solicitar y obtener conocimiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010503,
					"content": "“Aquellos que adquieran conocimientos prohibidos por medios ilegales serán expulsados de la Academia de Sumeru. Esperamos discreción por parte de los estudiantes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "“Para un estudiante como yo, que se está preparando para un examen, el ambiente de este lugar es mucho más agradable que el de una taberna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010602,
					"content": "“Además de poder mantener mi lucidez con un buen café, aquí también puedo consultar con muchos expertos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010603,
					"content": "“¡El dueño incluso predijo que entraré a la Academia este año!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010604,
					"content": "Espero que consigas todo lo que te propongas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "“¡Tengan cuidado! Un amigo mío se topó con el Caracal Rajá cuando estaba en el noroeste de la selva. Iba caminando durante la noche y tuvo suerte de volver entero. A ser posible, ¡no salgan por la noche!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "“La última investigación realizada por la gran erudita Pursina muestra que beber más café puede ayudar a mejorar las capacidades cognitivas del cerebro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010802,
					"content": "“Si quieres ser admitido en la Academia de Sumeru, visita nuestra cafetería con regularidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010803,
					"content": "Gracias por hacerle publicidad a nuestro café, pero nosotros solo tratamos de brindar un poco más de energía a la gente... Además, si sigues haciendo ese tipo de afirmaciones sin pruebas, los oficiales de la Academia podrían llamarte la atención, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "“Recuerda mi lección cuando juegues a las cartas en esta cafetería”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010902,
					"content": "“No debería haber inventado cartas inexistentes para engañar a los demás jugadores de Invocación de los Sabios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010903,
					"content": "“El señor Chacal me ha ayudado a darme cuenta de mis errores, y estoy aquí para confesarlos todos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732010904,
					"content": "“La mayoría de la gente ni siquiera se da cuenta de sus errores. Pero... ¿quién es ese señor Chacal del que hablabas?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "“He oído que han aparecido muchos bandidos en el desierto y que muchos comerciantes se niegan a recorrer las rutas de allí. El precio de los dátiles podría dispararse”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011002,
					"content": "“¡Estupendo! ¡Pues voy a vender todos mis champiñones por dátiles! Jajaja, ¡esos son el coraje y la visión únicos del clan Alkindi!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011003,
					"content": "Esperamos que pueda ganar una fortuna. No obstante, este establecimiento no se hace responsable de ninguna pérdida que pueda surgir a partir de la información de este tablón de anuncios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
							"2"
						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "“Después de jubilarme del Regimiento de Los Treinta, vengo aquí todos los días a tomar café”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011102,
					"content": "“La gerente en funciones me prepara el mismo café todos los días y el cuentacuentos me cuenta la misma historia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011103,
					"content": "“Quizás este sea el verdadero significado de la vida en Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "“Puede que las historias que cuenta el Sr. Madah estén pasadas de moda, pero las cuenta con el ritmo perfecto. Se nota que tiene mucha experiencia en esto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011202,
					"content": "“Pero ahora todo el mundo está acostumbrado a informarse a través del conmutador Akasha, así que inconscientemente pasan por alto todo el avance tecnológico que hay detrás de él”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011203,
					"content": "“No estoy de acuerdo. Nada es eterno. Una vez que el conmutador deje de ser útil, habrá llegado el momento de deshacerse de él”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011204,
					"content": "“Como sucede con los frutos muy maduros: deben caer a la tierra y ser nutrientes para las nuevas plantas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011205,
					"content": "“Por eso, nunca me han gustado las personas utilitaristas como tú. El arte es una fuente muy valiosa de placer, ¿cómo te atreves a compararlo con la producción y explotación de la industria?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011206,
					"content": "“La gente hedonista es como el que camina sobre una tierra esférica, ¡no existe! ¿Acaso la producción puede existir sin el intercambio comercial?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011207,
					"content": "“Su debate fue sin duda impresionante. Pero... señor Kaveh, es hora de pagar su factura de este mes. ¿Debería ponerla en la cuenta del señor Alhacén como de costumbre?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011208,
					"content": "“No, voy a mostrarle a ese mocoso consentido cómo es en realidad el mundo de los negocios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732011209,
					"content": "“Señorita, por favor, ponga la cuenta al nombre de la magnate Sangemah Bay. Después de todo, ¡no se puede hacer arte sin café!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
