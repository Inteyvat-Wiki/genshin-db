					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181802",
							"2"
						],
						"stepId": 7181802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Querida, ¿volviste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "Disculpe, se equivocó de persona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "¿Eh? Todavía no estoy tan mal... ¿Cómo no te voy a reconocer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "Justo estaba pensando en ti. ¿No crees que en esta festividad deberíamos regalarle un nuevo vestido a nuestra hija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Ah... trajiste compañía. Debe ser la sastra. ¡Pensaste lo mismo que yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Sr. Jiangcheng, soy yo, Bai. Hace dos días le traje tofu, ¿tan rápido se olvidó de mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180207,
					"content": "Ah... Srta. Bai... ¡Pero si es usted! ¡Claro que la recuerdo! Justo hace un rato su padre estaba alardeando de usted conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Eh... ¿Cuándo fue eso?... ¿Lo recuerdas, querida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "... Lo recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "¡Ja! Tal y como dije, no hay ningún problema con mi memoria, y... y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Sr. Jiangcheng, descanse un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180213,
					"content": "#Viajer{F#a}{M#o}, ¿qué tal si ayudas al Sr. Jiangcheng con la limpieza? Yo le haré un poco de compañía mientras tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180214,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Perfecto, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180210,
					"content": "Claro que lo recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
