			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Srta. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Si hubiese estado yo sola, seguro que hubiera sido mucho trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180502,
					"content": "No quiero dejar al Sr. Jiangcheng a solas durante una celebración tan importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180503,
					"content": "¿Qué hay de ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "¿Yo? En un momento regresaré a encargarme de los asuntos del molino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180505,
					"content": "Es herencia de mi padre. Después de su muerte, renuncié a mi trabajo en Liyue para continuar con la tradición familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180506,
					"content": "¿Cómo explicarlo? Estando en el mismo ambiente y haciendo las mismas cosas que hacía él, me vienen muchos recuerdos a la cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180507,
					"content": "Siempre recuerdo las cosas que solía decirme papá, especialmente durante el Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180508,
					"content": "Oh, casi lo olvido, le hice una linterna celeste al Sr. Jiangcheng, pero yo todavía no tengo la mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180509,
					"content": "El problema es que ya no tengo materiales de sobra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180510,
					"content": "#Tendría que recolectar más materiales, pero no creo que tenga tiempo para hacerlo... Viajer{F#a}{M#o}, ¿podrías ayudarme a recolectar algunos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180511,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Bai"
				}
			]
		},
