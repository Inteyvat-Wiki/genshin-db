			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "¿Colgaste la linterna? Se ve muy bien. Seguro que el año que viene será un buen año.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "Definitivamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Bueno, Sr. Jiangcheng, todavía tenemos unos asuntos que atender. Nos vamos por ahora, pero regresaré a visitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180405,
					"content": "Muy bien, muy bien. Los jóvenes siempre tienen cosas que hacer... Nunca se detienen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ah, querida... No te olvides de echar un vistazo a nuestra cosecha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Seguramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
			"id": 7181805,
			"completionStepIds": [
				7181807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
