			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Srta. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "#Hola, viajer{F#a}{M#o}. Gracias por lo de la vez pasada. La Aldea Chingtsé nunca había estado tan animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180102,
					"content": "No hay de qué.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "Los años anteriores solo éramos Zhi y yo. Lo máximo que podíamos hacer era fabricar linternas celestes para los niños, conversar con las personas mayores sobre la vida diaria y preparar un poco de comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180104,
					"content": "En esta ocasión, gracias a ti, pudimos pasar un Rito de la Linterna más animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180105,
					"content": "Si bien está muy animado, me gustaría visitar a los ancianos de la aldea. Hoy tengo pensado ir a ver al Sr. Jiangcheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180106,
					"content": "Si no te importa, ¿podrías acompañarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718180107,
					"content": "#Vamos junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "De acuerdo, vayamos con el Sr. Jiangcheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Bai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
