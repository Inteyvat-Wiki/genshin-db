				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "*Suspira*... Querida, ven a hablar con la Srta. Bai... Su padre hace un tofu buenísimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "De hecho, lo venden en la ciudad de Liyue, ¡es de lo mejor que hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Humm, Srta. Bai, ¿a qué vino? Lo olvidé de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "Vinimos a traer linternas celestes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Linternas celestes... Ah, sí, las linternas celestes... Todos los años se toma tantas molestias, Srta. Bai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Aún lo recuerdas, ¿cierto? Las linternas celestes que yo hacía eran tan buenas que todo el mundo quería que les hiciera una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Esas linternas celestes lucían muy bien en todos los Ritos de la Linterna... Espera, voy a colgarla para ti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Yo la cuelgo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Está bien, pero ten mucho cuidado, no te vayas a lastimar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
		{
			"id": 7181804,
			"completionStepIds": [
				7181806
