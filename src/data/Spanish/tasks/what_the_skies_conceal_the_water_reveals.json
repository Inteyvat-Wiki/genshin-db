						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "Está bien, pero acaba de despertar y todavía está muy débil. Si van a interrogarlo, sean amables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "El Robusto Huang"
				},
				{
					"id": 411131405,
					"content": "Saludos, mortal desafortunado. Tu soberana se dispone a interrogarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Comida... necesito comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131407,
					"content": "¿Estás bien? Parece como si te estuvieras muriendo de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ay... ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131409,
					"content": "¿Qué quieres comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Comida... comida casera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131412,
					"content": "¿Comida casera de la Aldea Chingtsé? Eso solo significa una cosa: ¡<color=#00E1FFFF>salteado de Chingtsé</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Te prepararé algo de comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gao el Sexto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "¡Uff! ¡Eso me revivió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131102,
					"content": "¿Soñaste mientras dormías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "¡Sí! ¡Fue el sueño más agotador de toda mi vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131104,
					"content": "¿Qué podría soñar alguien que lo deje tan agotado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "¿Estabas en una montaña?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Sí, ¿como lo supiste? Estaba en una montaña muy alta... Creo que era la montaña más alta que he visto en mi vida... y hacía mucho frío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131109,
					"content": "¿Qué hacías ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "No estoy seguro. Era como si estuviera... poseído. Estaba obsesionado con escalar la montaña e intentar llegar a la cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131111,
					"content": "¿Había algo especial en la cumbre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "No lo sé. Era como si en el sueño fuera una persona completamente distinta. No me preguntes por qué, no tengo ni idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131113,
					"content": "Entonces, ¿no eras “tú” quien realmente quería subir la montaña?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "¿Cómo explicarlo?... Era como si alguien me controlara metiéndome en la cabeza la idea de escalar la montaña. Sé que suena descabellado, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao el Sexto"
				},
				{
					"id": 411131115,
					"content": "¡¿Un intruso invadió los oscuros rincones de tu alma?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "Así que el sueño no fue suyo, sino que se lo indujeron en el subconsciente... Sí, todo apunta a que se trata de algún tipo de control mental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "#Ya debería estar acostumbrad{F#a}{M#o} a esto, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Todas las víctimas que hemos visto dijeron que tenían frío y que no podían seguir adelante... ¿También estaban escalando la montaña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "¿Cómo pueden todos tener el mismo sueño?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Paimon no quiere ni pensarlo... ¡Necesitamos contarle a <color=#00E1FFFF>Mona</color> todo esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "Eso que han dicho no tiene nada que ver entre sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "¿Estabas en un campo con nieve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Algo así. Era una montaña nevada, para ser precisos. Era muy alta, y hacía mucho frío. Cuando me dormí, estaba en la falda de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao el Sexto"
				}
			]
		},
