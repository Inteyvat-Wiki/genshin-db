					"nextDialogs": [
						411130903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130903,
					"content": "El mismísimo corazón de las tinieblas desciende sobre el mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "¿Tal vez los Fatui querían su energía elemental?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "Quizás. Pero si ese fuera el caso, otras formas de vida también habrían sido atraídas por la energía del meteorito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
					"content": "Miremos más de cerca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
