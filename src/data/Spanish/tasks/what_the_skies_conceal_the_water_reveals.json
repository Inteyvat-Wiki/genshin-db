			"dialogs": [
				{
					"id": 411131201,
					"content": "¡Mortal! ¿Tú también has descendido al reino del sufrimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "Tiene los mismos síntomas que las víctimas de otros sitios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "Disculpa, ¿se ha despertado en algún momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "No, pero de vez en cuando murmura algo mientras duerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 411131205,
					"content": "¿Qué tipo de cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "“Qué frío”, “no puedo más”... Cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 411131207,
					"content": "Las víctimas anteriores también mencionaron que tenían frío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "Un lugar frío... en lo alto de una montaña... ¿Dónde podrá ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
