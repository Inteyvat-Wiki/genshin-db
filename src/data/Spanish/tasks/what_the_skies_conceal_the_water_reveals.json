			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "¡Hola, Mona! Gracias a ti, ¡logramos deshacernos de montones de meteoritos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130102,
					"content": "¡Ajá! Llegan en buen momento, hay algo que necesito que hagan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130103,
					"content": "¿Recuerdan que dije que los meteoritos pertenecían a la constelación de alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130104,
					"content": "Técnicamente, no es posible que unas estrellas tan lejanas se conviertan de repente en meteoritos que caen del cielo. Pero, por contradictorio que sea, es la realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130105,
					"content": "Si queremos llegar al fondo de esto, debemos averiguar de quién es la constelación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130106,
					"content": "Por lo que me contaste, parece que todas las víctimas de los meteoritos cayeron en un sueño profundo, y todas soñaron con una montaña nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130107,
					"content": "No sabemos qué montaña es, pero creo que podemos afirmar que no es Espinadragón. De lo contrario, alguien la habría reconocido, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130108,
					"content": "¿Todos tenían el mismo sueño? ¿Y dónde estaban exactamente en ese sueño? Estas son las preguntas importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130109,
					"content": "Necesito que averigüen más detalles sobre los sueños de estas personas. Cuanta más información tengamos, más cerca estaremos de la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130110,
					"content": "Deberíamos ir a algún lugar con mucha gente para investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130111,
					"content": "Así encontraremos más víctimas que interrogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130112,
					"content": "Yo necesito permanecer en un entorno tranquilo. Les dejo la investigación a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130113,
					"content": "¿Hay algún lugar al que no hayamos ido aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130114,
					"content": "Está la <color=#00E1FFFF>Aldea Chingtsé</color>, en Liyue... Aunque no cuadra con la descripción de “un lugar con mucha gente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130115,
					"content": "Aun así, puede que la Geoarmada haya convertido la zona en un punto de atención médica, al igual que lo hicieron con la Posada Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111302",
							"2"
						],
						"stepId": 4111302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "Hola, somos del Gremio de Aventureros. ¿Puede decirnos si la Aldea Chingtsé se ha visto afectada por los meteoritos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "#¡Aventurer{F#as}{M#os}! ¡Perfecto! Estaba empezando a desesperarme por la falta de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "Los meteoritos llevan días cayendo en la zona. ¡Por no hablar de los problemas que nos han causado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "Si caen sobre los <color=#00E1FFFF>bancales</color>, nadie se atreve a ir a cosechar. Y si caen en la <color=#00E1FFFF>entrada</color> de la aldea, es imposible salir o entrar de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "¿Saben cómo deshacerse de ellos de forma segura? ¡Son un verdadero estorbo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "Parece que la Aldea Chingtsé se ha visto muy afectada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "Sí... Deberíamos ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
