					"nextDialogs": [
						411131003
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411131003,
					"content": "¿Se ha despertado alguna víctima después del incidente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131004
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131004,
