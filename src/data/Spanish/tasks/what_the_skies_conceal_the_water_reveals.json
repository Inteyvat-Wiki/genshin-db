		},
		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
