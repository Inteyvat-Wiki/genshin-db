					"nextDialogs": [
						411131303
					],
					"speakerTitle": "Apolo"
				},
				{
					"id": 411131303,
					"content": "¿Y ha dicho algo mientras dormía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131304,
					"content": "Ahora que lo mencionas... Ayer de repente gritó “¡qué alto!”. Quién sabe con qué estaría soñando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "Apolo"
				},
				{
					"id": 411131305,
					"content": "¿“Qué alto”? ¿Tan alto como la cima de una montaña nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131306,
					"content": "Una elevada montaña sombría, hogar de un poder malévolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131307,
					"content": "Ahora hablemos con ese tipo de allí.",
					"roleType": "TALK_ROLE_NPC",
