			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Veamos, ¿dónde está la persona de la que nos habló Ayaka...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "¿Por qué lo haces? Después de tantos años, ¿por qué de repente te vas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Exactamente. No estábamos preparados para recibir una noticia así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "¡Los niños están impacientes por que los lleves a jugar! Por favor, ¿puedes reconsiderarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Ese debe ser el sujeto que mencionó Ayaka. ¡Vamos a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Parece ser el diario de Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Veamos, ¿qué tenemos aquí...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "“El día de hoy, me reuní con los aldeanos para cocinar pescado seco estofado. Metí la pata y quemé el mío un poco, así que fingí que era pez cabeza de serpiente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "“El día de hoy ayudé a rescatar a un niño que cayó al agua. Al sacarlo, me dijo que su mejor amigo, Banbu, todavía estaba en el agua. Busqué en el agua durante toda la tarde antes de descubrir que Banbu era el nombre de su cangrejo mascota”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "“El día de hoy fui a volar una cometa. La cuerda se rompió, así que la perseguí tan rápido como pude. Al darme cuenta de que no la recuperaría jamás, encontré un lugar para sentarme y observar cómo se alejaba volando”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Humm... Parece el diario de una vida común y corriente en una aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "¿Eh? Espera, ¡aún hay más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "“El día de hoy fui de nuevo a rezar al altar y me quedé allí un tiempo. El omamori que me diste se ha decolorado un poco, pero sigue siendo mi posesión más preciada...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "¡Esa es la información que estábamos buscando! ¡Hora de visitar el altar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Así que este es el omamori del que hablaba Tejima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Interesante... a juzgar por el color y el diseño, Paimon habría pensado que pertenecía a una niña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "En fin, si él lo llevaba consigo todo el tiempo, existe la posibilidad de que algo de su energía elemental permanezca en él. ¿Crees que sirve de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "¡Lo encontramos! Este parece ser un lugar que Tejima visitaba con frecuencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "Hay marcas de que el suelo ha sido removido... ¿Quizás Tejima enterró algo de valor aquí? ¿Quizás es la razón por la que se ha quedado en la aldea todos estos años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "Debe ser algo espectacular si hizo que Tejima se quedara más de treinta años. ¡Vamos a desenterrarlo y echarle un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "¿Es... una carta? El papel se ha vuelto amarillento, debe haber sido escrita hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "“Aldea Konda”... Suena muy familiar, ¿dónde estaba ese lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "Es aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "¿Eh? Entonces, ¿la razón por la que Tejima vino aquí fue para esperar a alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Pero ha estado aquí durante 30 años... Paimon supone que al final esa persona no vino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Bueno, devolvamos a Tejima sus cosas y vayámonos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Pues... Sí, esa es mi letra... y supongo que el omamori y la carta también son míos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "... Pero no tengo ningún recuerdo de nada de lo que está escrito en este diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Aun así... parece que estaba esperando a alguien aquí, y que decidí esperar treinta años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Con el paso del tiempo, supongo que tomé nota de cualquier cosa que me pareciera interesante... Cualquier cosa que pudiera compartir con ella cuando finalmente nos reuniéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "Tantas cosas sucedieron con el curso de los años... El tiempo ha pasado muy rápido. Treinta años se sienten como un pestañeo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "¿Cómo pude haber olvidado algo tan importante para mí? Humm... Ahora que lo pienso, cuando me quitaron la Visión, sentí como si de repente... quedara vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Amor, arrepentimiento... todo lo que sentía por ella... desapareció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "¿Te sientes triste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "No... En realidad, no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Después de todo, he olvidado quién era ella. Su rostro, su voz, las cosas que vivimos juntos... No tengo ni un recuerdo de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "Es como si ella nunca hubiera estado en mi vida... como si todos estos años no hubieran sido más que un sueño desdibujado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Entonces, ¿todavía planeas irte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Creo que... no. Si he aguardado por esto la mayor parte de mi vida, supongo que debo seguir esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Pero ¿qué pasaría si ella apareciera y se diera cuenta de que no recuerdo ni su nombre? Sería una gran decepción, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Cuando lo pienso de esa forma... siento un poco de tristeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Es muy extraño... ¿Por qué pienso en cosas así cuando ni siquiera la recuerdo? Es como esa sensación de vacío, la sensación de que... algo falta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "Gracias por ayudarme a recordar el motivo de mi estancia aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Me quedaré y seguiré esperándola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima no parece estar afligido del todo, pero aun así... Paimon se siente muy triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Yo también...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Es como dijeron Ayaka y Thoma. Si uno pierde su Visión, también pierde todas sus esperanzas y ambiciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Eso explica el estado en el que se encontraba Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Al menos pudimos ayudarlo... ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*Suspira*... ¡Vamos a buscar a la siguiente persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Quizás lo más triste de todo es perder una razón para estar triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
						"stepId": 200406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Ah... ¿Ustedes también vienen a intentar convencer a Tejima de que se quede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "¿Qué ocurrió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "Tejima ha protegido este lugar desde que llegó aquí hace treinta años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Ahuyentar a los ladrones de tesoros, defendernos de los monstruos al acecho, resolver las disputas entre los aldeanos... Ha hecho un gran esfuerzo por cuidar este lugar. Es un miembro importante de la comunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Pero ahora, de repente dice que quiere dejarnos... ¿Le hicimos algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Si ese es el caso, no tenemos problema en disculparnos... Solo queremos que se quede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
						"stepId": 200407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kenjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "¿Por qué cambió de parecer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Si me lo preguntan, creo que tiene que ver con el Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "Está claro que Tejima no ha hecho nada malo, pero aun así confiscaron su Visión. Después de eso... se convirtió en una persona completamente diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "No lo entiendo del todo, pero me di cuenta de que perdió algo muy importante para él. Salió a caminar a solas y dio una vuelta al pueblo un par de veces. De repente, anunció que se iba a recorrer el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "En realidad, no sabemos si dejar que se quede es la mejor idea, pero... no podemos dejar que se vaya en ese estado. Es un alma perdida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Parece que todos lo estiman mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200408",
							"2"
						],
						"stepId": 200408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Tú debes ser Tejima, ¿cierto? Bueno, ¿qué hizo que decidieras irte de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "¿Me hablas a mí? No es que tenga un motivo para irme... pero tampoco tengo un motivo para quedarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Has vivido aquí durante mucho tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Todos dependen de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Es cierto... Pero no elegí quedarme aquí por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "... ¿Qué me hizo querer venir aquí hace treinta años? ¿Por qué me negué a irme todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "No tengo respuestas a esas preguntas, porque ya no lo puedo recordar. Desde que me quitaron la Visión, es como... como si una parte de mis recuerdos se haya ido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Antes, sabía que quería quedarme aquí... Pero la determinación de aquel entonces se ha desvanecido. Así que pensé: ¿qué es lo que me impide irme? El vacío que siento en mi corazón estará ahí de todas formas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Bueno, en ese caso, si te ayudamos a redescubrir la razón por la que elegiste quedarte, ya no tendrás que irte, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Humm... Pero si no recuerdas nada, no será tan fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "¿Y si te esfuerzas en recordar? Quizás así vuelva tu memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Oh, eso me recuerda a que la última vez que le llevé algo de fruta a Tejima, lo vi escribiendo un diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "¿Tengo un diario? Si tú lo dices... Pero, sinceramente, no lo recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "¡Sí, sí que tienes uno! Es más, recuerdo que dijiste que querías tomar nota de algunas cosas interesantes, cosas que serían muy importantes después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "¡Perfecto! Entonces, si queremos evitar que Tejima se marche, lo único que tenemos que hacer es encontrar su diario. Debe de estar en alguna parte por aquí, echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Si no les importa, dejamos la búsqueda del diario en sus manos... Debemos informar a los demás de la situación de Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
