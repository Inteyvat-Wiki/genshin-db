			"trigger": {
				"objectNames": [
					"Gran Maestre Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "¡Excelente! ¡Excelente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360102,
					"content": "No esperaba que la Banda de Arataki fuera capaz de derrotar a tantos de mis luchadores de escaradiablos. Parece que tienen más talento del que creía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360103,
					"content": "Retiro oficialmente lo dicho. Son grandes oponentes dignos de mi reconocimiento. Y ahora... ¡yo me enfrentaré a ustedes con todo mi poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360104,
					"content": "Muy bien, toreritto, te toca. ¡Demuéstrale quién es el líder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "¡Y no te tomes en serio lo de antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "¡Adelante, Luchador Escaradiablo Supremo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Jajajajaja, ¡ya verán! ¡Esta será la batalla definitiva en la que me alzaré con la victoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "No sé cómo habrás liderado a tus secuaces, pero salta a la vista que no se te da muy bien. ¡La Banda de Arataki vencerá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "¡Espero que estés listo, Gran Maestre Hanakado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "¡El Rey contra el Gran Maestre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
