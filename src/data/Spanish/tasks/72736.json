			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gran Maestre Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Ya veo... Bien, combatamos una vez más. Esta vez adivinaré todas tus estrategias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360202,
					"content": "Perder o ganar no es lo importante. ¿Por qué no combatimos solo por diversión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360203,
					"content": "No es fácil encontrar un oponente digno. Sería una pena que el combate llegara a su fin tan pronto, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727360204,
					"content": "¡Ja! ¡Por mí no te cortes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Pero ni sueñes con descubrir mis técnicas ocultas. ¡No tienes tú fe ni nada, enano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Si admites que soy el mejor luchador de escaradiablos, ¡combatiré contigo todas las rondas que quieras y más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Parece que el toreritto y el Gran Maestre Hanakado siguen a lo suyo. Dejemos que combatan hasta cansarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
