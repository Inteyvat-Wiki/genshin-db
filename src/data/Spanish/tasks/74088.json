		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Esto debería de ser la Escuela de Mecánica Aplicada de Butor. Es una de las máximas autoridades en el campo de la investigación de mecanismos tradicionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Pero... desde el punto de vista académico, la evolución y desarrollo de los mecanismos tradicionales se enfrenta a un cuello de botella muy difícil de superar. Desde el punto de vista práctico, es evidente que este tipo de mecanismos se encuentra en clara desventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Por eso, el área de investigación de Butor es cada vez más reducida dentro del Instituto. Su investigación no solo ha sufrido recortes, sino que tampoco cuenta con suficientes investigadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "Tras todos los percances que tuvieron lugar, finalmente se anunció la disolución de su equipo de investigación, de ahí que este lugar quedara abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "El pobre Butor siempre tuvo una suerte terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
