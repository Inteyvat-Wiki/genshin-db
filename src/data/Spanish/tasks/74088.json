			"dialogs": [
				{
					"id": 740880401,
					"content": "#Aquí también debería haber una baliza. Yo me encargo de abrir la compuerta, te dejo el resto a ti, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
