					"Chronie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880601,
					"content": "*Suspira*, no me quito de la cabeza la cara del Sr. Choiseul mientras intentaba zafarse de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "Y ni hablar de Raimundo... Se pavonea por ahí con aires de grandeza, como si nadie estuviera a su altura. ¿Viste cómo me miró?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Creo que tú eres mucho mejor persona en ese sentido. Seguro que si estuvieras en su posición, no te comportarías así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
		}
	]
