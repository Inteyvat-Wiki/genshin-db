						],
						"pointId": 16847
					}
				]
			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "Maravilloso... Ahora, según la profecía de Barbeloth, el humano que necesita ser guiado debería llegar enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Me he aprendido la frase de inicio, y ya he confirmado el efecto de la entrada. ¡Jajaja, esta vez nada saldrá mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "¿Por qué creen que la profecía final le indicó a Lohen que viniera hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Oh, no, ¿ya han llegado? ¿Acaso Durin no terminó de decir su parte? Arg... Tengo que permanecer en silencio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "¿Acaso eso del último enfrentamiento a la fuerza del dragón... se refería a Dvalin? Pero no parece estar por aquí hoy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Técnicamente, ya vi al Guardián del Viento del Este cuando regresé de Nod Krai. Estaba junto a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "¡Ah, cierto! En el Reino de los Lobos, ¡cuando estuvimos entregando las cartas de Varka! Un momento... ¿Significa eso que la profecía ya se ha cumplido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Si somos generosos con la interpretación de “enfrentarme a la fuerza del dragón tres veces”, técnicamente ya lo he hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "¿Pero has “comprendido el verdadero significado del poder”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Supongo que por eso mismo la profecía me guio hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Antes de que este lugar fuera conocido como la Guarida de Stormterror, era el dominio del Dios de la Tempestad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Pero el poderoso dios capaz de conjurar tormentas que cubrieran el mundo entero no pudo contener el deseo de libertad que nació dentro de sus propias paredes de viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "El Dios del Viento del Norte, contra quien había competido en un pasado por el trono divino, encontró la respuesta que siempre había buscado tras abandonar su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "¿Eh? Este muchacho... no parece tan obstinado como decía Varka, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "El Espejo del Alba y Durin... durante un tiempo, ellos también estuvieron perdidos entre la confusión y la duda. Lo que los llevó hasta su poder fue más que simple fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Vaya, vaya... Parece que ya lo vas entendiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Al igual que Ursa, el monstruo que una vez fue ángel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Lo que dices tiene sentido, pero... ¿no estás hablando de forma un tanto extraña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Primero Durin... y ahora Lohen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "“El ángel que eligió el poder seguía anhelando permanecer cerca de la humanidad, hasta que acabó cayendo y se convirtió en un patético monstruo...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "“Oh, humanos que han sido testigos de todo ello, ¿aún aspiran a obtener el poder?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "¡Eh, esa es mi frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "¡¿Cómo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Vaya... Sin quererlo, he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Un placer conocerla, Srta. Nicole. He leído su guion, y debo decir que estoy impresionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "*Suspira*... ¿Por qué tengo la sensación de que a Durin se le cayó una copia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "¿Oh? ¿Eso también formaba parte de la profecía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Solo era una suposición. Si pudiera predecir algo así, no habría... *ejem*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "No importa. Me pareció un guion muy bien escrito y entretenido si se lee como un cuento de hadas. Sin embrago, debo decir que no me agrada que me den sermones... ni siquiera si lo hace un ángel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "... Elegiré creer que te refieres a mi antiguo compañero, aquel que eligió el poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Ya que has leído mi guion, supongo que ya sabes todo lo que tengo que decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Sí, y lo trataré como sugerencias de gran valor. Pero, ahora, si no hay nada más, volveré para continuar ocupándome de mi «Archivo de adversarios formidables».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(No ha dicho que vaya a seguir los consejos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Debo admitir que ha sido un día bastante productivo. Creo que me he vuelto más fuerte, aunque sea un poquito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Gracias a todos... Pueden saludar de mi parte al equipo que hay detrás de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "*Suspira*... ¿Por qué es tan difícil tratar con humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Eh, ¿puede explicarle alguien a Paimon qué está pasando? Se siente bastante... confundida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "¿No recuerdan haberse hecho cargo de Dottore y el veneno que dejó atrás Ursa en Mondstadt? Me han contado que Lohen también lo llegó a pasar muy mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Ya que fue una catástrofe causada por alguien que había sido un ángel en el pasado, es natural que un ángel del presente deba encargarse de corregir el rumbo... Aunque no todo ha ido como tenía previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Parece que el destino de la humanidad se volverá incluso más impredecible... Al fin y al cabo, ya no es solo la guía de los ángeles lo que los empuja hacia el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Pero tantas posibilidades infinitas... ¿Tal vez ahí radique la verdadera fuerza de la humanidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Parece que va a seguir trabajando en su archivo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "¿Por qué parece que todos están recitando un guion de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
