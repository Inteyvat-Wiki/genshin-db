			},
			"dialogs": [
				{
					"id": 700960401,
					"content": "Qué movimientos tan fluidos... Nunca habría dicho que eras una máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Sus ataques también son muy precisos, Sr. Lohen. Casi podrían clasificarse como mecánicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "¡Yujuuu, nuevos componentes! ¡Podré crear nuevos módulos increíbles con ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "¿Ah? Entonces, eso quiere decir que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "¡Ve a buscar más, Ineffa! ¡Cuántas más piezas tengamos, mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Entendido... Mis disculpas, Sr. Lohen. Hablaremos de esto más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Tras un tiempo explorando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "*Zzz*... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Se ha quedado dormida... ¿Será porque se cansó mucho jugando en el Puerto Dornman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "Aino es así: su energía va y viene rápidamente. Lo siento, Sr. Lohen, pero me temo que no puedo moverme ahora mismo. Tendré que quedarme aquí hasta que Aino esté dormida profundamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "... No pasa nada, ya he visto de lo que eres capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "Espero que mis datos de combate le aporten información de utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Por cierto, la persona que nos habló de estos mecanismos especiales, también mencionó Espinadragón. Tal vez quieras ir y comprobar cómo está la situación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
		{
			"id": 7009605,
			"completionStepIds": [
				7009605
			],
