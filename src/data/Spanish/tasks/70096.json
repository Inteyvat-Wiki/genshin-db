			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Nuestro Capitán no es solo fuerte, ¡también logró desarrollar un compuesto capaz de hacerle frente al Abismo! Eso no lo sabías, ¿eh, listillo? ¿Y tú te atreves a decir que soy un experto falso que no tiene idea de nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "¿Y sabes tú sobre la velocidad milagrosa de nuestro Gran Maestro? ¡Usó las líneas ley para viajar desde Nod Krai hasta Mondstadt en menos de lo que canta un gallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
