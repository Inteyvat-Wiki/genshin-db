					}
				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "¡Ineffa, Ineffa! ¡¿Has visto ese molino de viento?! ¡Necesito que registres su estructura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Entendido. Preparándome para tomar una imagen del molino de viento. ¿Te gustaría formar parte de la imagen esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#¿Eh? ¿{NICKNAME}? ¡Paimon! ¡Y también Lohen! ¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Vaya... Esa información sobre un poderoso dragón antiguo de Nod Krai... ¡Paimon debería haberlo imaginado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Evaluando la situación... Parece que el Sr. Lohen espera poder combatir contra mí. ¿Estoy en lo correcto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "En resumen, podría decirse que sí. Cuando estaba en Nod Krai con la expedición, no sospechaba que tuvieras una historia tan extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Pero eso no importa ahora. Hace tiempo que tenía ganas de ver de lo que eres capaz. ¿Qué me dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "¡Jeje! ¡Ineffa, demuéstrale lo que vales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Acepte mis disculpas. Según el itinerario de hoy, aún nos queda visitar Mondstadt para recoger ciertos componentes especiales. Según mi evaluación, luchar contra usted ahora podría afectar a nuestros planes posteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Ah, sí... ¡Casi se me olvida! Oímos que había un tipo de robot gigante en Mondstadt, ¡y por eso vinimos! Pero la verdad es que acabé distrayéndome por el camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "No pasa nada, puedo entenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... ¿Te vas a rendir tan fácilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Si les ayudo contra los Guardianes de las Ruinas, su agenda debería quedar bastante libre, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
		{
