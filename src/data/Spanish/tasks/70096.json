					},
					{
						"sceneId": 3,
						"position": [
							1136.39,
							506.295,
							-832.83
						],
						"pointId": 16842
					},
					{
						"sceneId": 3,
						"position": [
							1136.21,
							506.39,
							-831.26
						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "... Por fin has llegado, tú que buscas el poder y sigues el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "Es Durin... A Paimon no le sorprende en absoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Pero su forma de hablar me resulta algo extraña...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Una máxima soberana, la creación de una bruja y una descendiente de ángeles... Todos blanden poderes muy distintos y, aun así, todos fueron coronados como dragones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "... Eso se debe a que los dragones son un símbolo del poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Así que ¿“luchar contra grandes dragones” se convirtió en una forma de poner a prueba tu propia fuerza?... Creo que empiezo a comprender a la Gran Maestra fundadora un poco mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Veo que aún tienes mucho más que decir, pero ¿qué tal si dejamos que nuestros filos hablen por nosotros? Después de todo, ¡una buena estocada vale más que mil palabras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "¡U-un momento! J-joven humano, la prueba que buscas no está aquí. ¡Deberás aventurarte a la Guarida de Stormterror para enfrentarte a la profecía final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "¿Por qué hablas tan rápido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "¿Estás bien, Durin? Estás hablando de una forma muy extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Uff... Creo que he dicho lo más importante... ¡aunque acabé saltándome muchas cosas!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Eh, creo que Albedo me dijo que necesitaba ayuda con un experimento, así que será mejor que me marche ya. ¡Lo siento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Sí que tenía prisa... Es una verdadera lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "¿Oh? ¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Eh... ¿Por qué estaba aquí Durin exactamente? Aparte de eso sobre “aventurarse en la Guarida de Stormterror”, lo demás parecía una sarta de sinsentidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Algo me dice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Interesante. Tengo mucha curiosidad por ver cómo esa “profecía” se hará realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "Que solo estaba aquí para que el próximo dragón cuente como el tercero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "¡Pareces un actor que tiene mucha prisa por salir de escena!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
		{
			"id": 7009606,
