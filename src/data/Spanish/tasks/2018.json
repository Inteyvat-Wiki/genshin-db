	"talks": [
		{
			"id": 201802,
			"completionStepIds": [
				201802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
