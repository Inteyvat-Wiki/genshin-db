			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara",
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Suma Sacerdotisa Yae, he venido, tal como prometí. Puede estar segura de que nadie me ha seguido ni nadie sabrá de este viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Sabía que cumplirías tu promesa... Estoy segura de que apenas pudiste dejar de pensar en ello estos últimos días. ¿Lograste conciliar el sueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "Yo... Se equivoca. Nunca dudaría de los líderes de mi clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Así que... ¿Dónde están sus pruebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Aquí las tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, qué bien. Hoy todos están cumpliendo sus promesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "No creerías lo que tuvimos que hacer para conseguir todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Dáselas a Sara. Puede examinarlas por sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "Veo que este documento lleva el sello oficial del jefe del clan Kujou. Y no parece una falsificación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "No entiendo... No hay ni una sola palabra sobre la resistencia, Sangonomiya, o la situación en el frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "¿Qué hay de los soldados que dieron su vida, o de las penurias soportadas por el pueblo? ¿Acaso no merecen una mención?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Un desprecio absoluto por la vida humana. ¿Por qué querrían ocultarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Por el bien del Decreto de captura de Visiones, por supuesto. ¿No crees que la Shogun podría reconsiderar su política si todo lo que acabas de mencionar apareciera en este informe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Así que la Comisión Tenryou... ¿está engañando deliberadamente a la Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Sí. Ahora... ¿quién más crees que podría estar beneficiándose del Decreto de captura de Visiones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "También tengo una carta confidencial aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Esta es una carta de la Comisión Tenryou a los Fatui. El jefe del clan Kujou también le ocultó esto a la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "¿Y bien? Las cosas que querías ver, pero que también deseabas no ver, están ante ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "No estarás planeando hacer la vista gorda, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Así que todo a lo que me aferré... es todo... ¿Cómo pudieron...? ¡Arg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Esta traición es imperdonable... ¡Takayuki, me debes una explicación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara se ve bastante enojada. Parece que la rebelión en Tenryou ya está en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "El ejército de la Shogun se quedó sin un líder por ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Sí, alcancémosla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "#Espera, viajer{F#a}{M#o}. Hay algo más de lo que tenemos que hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "La primera vez que entraste en el plano de la eutimia fue frente a la Estatua de la Diosa Omnipresente, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Debes encontrar la manera de recrear las circunstancias de ese día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Si consigues que la Shogun Raiden te “abra su corazón” una vez más ante la Estatua de la Diosa Omnipresente, tendrás la oportunidad que necesitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Llévate esto como regalo de despedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "¿Qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "Los omamori del Gran Santuario Narukami son muy poderosos. Guardé uno para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Jeje, cuando estés en peligro, sácalo y mira lo que pasa. Quizás tus oraciones sean escuchadas y todos tus problemas desaparezcan en un abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "O, si alguna vez piensas en mí durante tu viaje, sácalo, ¿de acuerdo? ¿Quién sabe? Tal vez acabe apareciendo delante de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "#Basta ya, Srta. kitsune. Este no es el momento ni el lugar para burlarse {F#de la viajera}{M#del viajero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Jeje, lo siento. Bueno, entonces es hora de que te enfrentes a mi amiga irremediablemente ingenua. Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Lo atesoraré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Si la seguimos, podríamos encontrarnos con la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "¿Me siguieron hasta aquí? Tienen agallas, lo reconozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "#Como son testigos, supongo que puedo evitar que l{F#as}{M#os} arresten, al menos hasta que obtenga una explicación de Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "#Pero... si resulta que me engañaron sobre este asunto, entonces no solo l{F#as}{M#os} arrestaré de inmediato, sino que serán acusad{F#as}{M#os} de un crimen más. ¿Me expliqué con claridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Más claro, imposible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "¡Hum! De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Ve por delante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "¡Alto ahí! Sara, ¿te has vuelto loca? ¿Cómo te atreves a desobedecer mis órdenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "Señor, yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "¡Vamos, pregúntaselo! ¡No dejes que te intimide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "Señor Takayuki, he visto el informe al trono y la carta a los Fatui... Por favor, ¡necesito una explicación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "¿Así es como mis documentos desaparecieron del cuartel general? Los robaste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "¿Debo interpretar sus palabras como que... estos documentos no son falsos? ¿Los escribió de su puño y letra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Por favor, dígamelo, Señor, necesito saberlo... ¿La Comisión Tenryou realmente traicionó al shogunato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "¡Hum! Así es, tengo tratos con los Fatui. Y sí, el informe que viste lo escribí yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Vaya, lo admitió sin rodeos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "Los diplomáticos de Snezhnaya prometieron una recompensa muy generosa... y todo lo que pidieron de mí a cambio fue que el Decreto de captura de Visiones se mantuviera en vigor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Durante demasiado tiempo, la posición del clan Kujou ha sido codiciada por muchos. No faltan clanes que nos derribarían a la primera oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Así que, cuando surgió la oportunidad de obtener el respaldo de otra nación poderosa y de acabar con nuestros enemigos al mismo tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Me pareció un trato excelente. Simplemente no vi la necesidad de informarte, Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Pero... usted adora a la Shogun... ¿Cómo pudo traicionarla después de todo este tiempo y actuar como si nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "¿Traicionarla? ¿Cómo puedes llamar a esto una traición?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "Quizás los Fatui creen que me están utilizando, pero es lo contrario. ¿Qué pueden conseguir de todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Cuando el rayo caiga en Inazuma, se pondrán de rodillas y temblarán paralizados de miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Al fin y al cabo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "¡Nadie puede enfrentarse al poder supremo de la todopoderosa Shogun Raiden y su Filo del pensamiento vacío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Su intención no era traicionar a la Shogun Raiden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Sí, no adora a la Shogun Raiden en sí misma, sino a su poder como guerrera, especialmente al Filo del pensamiento vacío. De hecho, parece que está obsesionado con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Pero, Señor... ¿qué pasa con la lealtad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Desde que fui adoptada por el clan Kujou, me enseñó la importancia de la lealtad de los vasallos hacia sus superiores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Pero ahora tengo claro que solo quería que le fuera leal al clan Kujou. ¿Tenía miedo de que algún día lo traicionara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "¡Hipócrita! ¡Predicando sobre la virtud solo para enmascarar su propio y miserable egoísmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "¿Egoísmo? Lo único que estoy haciendo es salvar la eternidad del clan Kujou. Estoy bastante seguro de que la todopoderosa Shogun simpatizaría con eso, al igual que el antiguo jefe de nuestro clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Paimon cree que está cegado por su ego. Si piensa que el clan Kujou es rival para los Fatui, se va a llevar una sorpresa desagradable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "No tiene sentido tratar de discutir con él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "En el pasado, dudé del Decreto de captura de Visiones. Me pregunté: ¿es esto realmente lo correcto? ¿Aunque vaya en contra de lo que mi corazón dice que es lo justo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Pero elegí obedecer a la Shogun. Mientras ella guíe el camino, ¿quién de nosotros es capaz de juzgar lo correcto y lo incorrecto cuando aún no hemos llegado al final del camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Pero ahora me doy cuenta de que el camino de la eternidad es uno sin fin, y además... hace tiempo que fue profanado por sus actitudes egoístas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Así que le contaré a la Shogun la verdad sobre todo esto. ¡Al menos así mi conciencia estará tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Terca e inútil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Informa a la Shogun si así lo deseas. La posición del clan Kujou es ahora inamovible, y nada de lo que hagas cambiará eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "La Shogun está en <color=#00E1FFFF>Tenshukaku</color> recibiendo a una diplomática de Snezhnaya llamada Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "¡Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "¿Signora es la que está detrás de todo esto? ¡Ay, otra vez ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Cuando estábamos en Ritou, la señorita Hiiragi mencionó la reunión del Comisionado Kanjou con una mujer que sonaba arrogante... Debimos imaginarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "¿Una diplomática de Snezhnaya? ¡Bueno! Si cree que va a salir de Inazuma de una pieza, se llevará una decepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara salió hecha una furia... ¿Crees que va a irrumpir en Tenshukaku ahora mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Tenemos una cuenta pendiente con Signora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "¡Exacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "¡A <color=#00E1FFFF>Tenshukaku</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Veamos lo que Kujou Sara tiene que decir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Confía demasiado en el poder de la Shogun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
