			"dialogs": [
				{
					"id": 761960301,
					"content": "Mira, no nos dejamos nada, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960302,
					"content": "Humm... ¡No, todo perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "He visto que has formado unos patrones interesantes en el suelo con la plata lunacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960304,
					"content": "¡Sí! Me costó bastante esfuerzo, pero creo que así la gente apreciará más la plata lunacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Ahora que lo dices, he oído que hay una historia popular en Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960306,
					"content": "Cuenta que una doncella que vivía en las estrellas cayó a la tierra y, para poder regresar al cielo, dejó una enorme pintada sobre el suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960307,
					"content": "Después de eso, su padre, el Sol que habitaba en el cielo, vio su mensaje y la llevó de vuelta al cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960308,
					"content": "¡A lo mejor también pudo ver el dibujo que hiciste y se convertirá en un amante de la plata lunacaída!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960309,
					"content": "¡Jajaja! Si eso pasa, ¡soy la mejor embajadora de la plata lunacaída!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Pero más que eso, me preocupa que los pájaros se fijen. Ya sabes cómo son los cuervos con las cosas que relucen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Tienes razón, y además de los cuervos, también hay que tener cuidado con los topos olfateadores y los hurones ladrones que andan por la superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960312,
					"content": "¡Y con Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "¡Jaja, sí! ¡Y también con Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960314,
					"content": "¿Yajuuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Gracias por ayudarme antes. Aunque es solo una pequeña parte de mi colección, te la regalo. ¡Considéralo un presente para Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "¡Hoy sí que es un buen día, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960317,
