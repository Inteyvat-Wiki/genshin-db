			},
			"dialogs": [
				{
					"id": 761960201,
					"content": "¡Dorota! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960202,
					"content": "¡Linnéa, llegas justo a tiempo! Estaba explicándoles a todos las maravillas de la plata lunacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "¡Oh, plata lunacaída, plata lunacaída! ¿Acaso existe en todo el mundo sublunar una gema más perfecta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "¡Mira! Que forma más impecable, ¡y que tacto tan suave y terso! Y ese blanco resplandeciente con matices iridiscentes, ¡su afinidad elemental no tiene parangón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Para mí, ¡solo la luna puede compararse contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "La plata lunacaída es un mineral muy bonito. Yo también he recolectado algunas muestras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960207,
					"content": "¡¿Verdad que sí?! ¡Sabía que me entenderías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Pero bueno, ¡quien más sabe de plata lunacaída soy yo! Aunque seas asesora del Gremio de Aventureros, no te voy a ceder el primer puesto, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Ah, por cierto, normalmente eres tú quien da clases a los aventureros, así que hoy déjame ponerte a prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Tengo aquí tres ejemplares de plata lunacaída. Lamentablemente, dos de ellos tienen pequeñas imperfecciones, pero el otro es mi tesoro más preciado: ¡la plata lunacaída entre las platas lunacaídas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "¿Puedes distinguir cuál de ellos es la plata lunacaída más perfecta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960213,
					"content": "Este de la izquierda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960214,
					"content": "(¿Eh? ¿Qué está haciendo Lumi?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960215,
					"content": "¡Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960216,
					"content": "¡Así que Linnéa también puede equivocarse! En realidad, esta tiene un pequeñísimo defecto en un lugar muy difícil de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Humm, me rindo. Pero la próxima vez... ¡La próxima vez no perderé tan fácilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960218,
					"content": "¡Puedes intentarlo cuando quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnéa aprovecha la ocasión para participar en el evento de exhibición de plata lunacaída organizado por Dorota y pasa un rato muy agradable...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "No esperaba que todos fueran tan entusiastas. Es una lástima que los buenos momentos siempre pasen tan rápido... Ya casi es hora de recoger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Yo te ayudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960234,
					"content": "¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960220,
					"content": "Este de aquí en medio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960221,
					"content": "(Parece que a Lumi le gusta mucho este.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960222,
					"content": "¡Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960223,
					"content": "¡Ah, tú también lo sientes! El encanto irresistible que emana de la perfección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960225,
					"content": "El de la derecha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960226,
					"content": "(¿Eh? ¿Qué está haciendo Lumi?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960227,
					"content": "¡Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960228,
					"content": "¡Así que Linnéa también puede equivocarse! En realidad, esta tiene un pequeñísimo defecto en un lugar muy difícil de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960229
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960229,
					"content": "Humm, me rindo. Pero la próxima vez... ¡La próxima vez no perderé tan fácilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960230
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761960230,
					"content": "¡Puedes intentarlo cuando quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				}
			]
