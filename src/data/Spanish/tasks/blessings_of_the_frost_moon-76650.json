			"dialogs": [
				{
					"id": 766500301,
					"content": "Qué grande que es la Estatua decretolunar... Es cierto que ni un pájaro ni un hurón podrían sacarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Y está sellada dentro de ese espejo taaan grande... Lauma, ¿tan valiosa es esa Estatua decretolunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "Si solo hablamos de Mora, no creo que tenga mucho valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "La técnica de tallado es muy burda, y el material utilizado es un tipo de piedra común de la zona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Pero para la Cantalunas de aquella época y los Descendientes Lunaescarcha de la actualidad, su valor es incalculable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Al menos, después de verificar la existencia de esta Estatua decretolunar, también puedo confirmar la fiabilidad de varios registros al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Así que, sea como sea, nada de esto ha sido en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#Gracias por tu ayuda, {NICKNAME}. No me había equivocado contigo, este Espejo lunacreciente no suponía problema alguno para ti.",
