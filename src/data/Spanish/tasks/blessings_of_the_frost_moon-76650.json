			"dialogs": [
				{
					"id": 766500101,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500102,
					"content": "Esto no es cuestión de tener muchos amigos o no. Incluso si llamaras a todos los ibis de la Isla Hiisi, no sería suficiente para mover el Espejo lunacreciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "Además, incluso si pudieran moverlo, la Estatua decretolunar de su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500105,
					"content": "¿Desenterrarlo? Me temo que ni siquiera tú serías capaz de mover el espejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500107,
					"content": "¿Oh? ¿De verdad puedes llamar a todos los ibis de la Isla Hiisi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "... Pero no creo que sirviera de nada ni aunque viniera toda la familia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500110,
					"content": "Vaya, Paimon los ve muy animados. ¿Qué hacen un hurón ladrón y un pájaro discutiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "¿Acaso están planeando un robo conjunto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Podría decirse que ciertamente estamos urdiendo un plan. Ahora nos encontramos discutiendo los detalles del “crimen”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Lo único es que los métodos de mis “cómplices” toman un enfoque demasiado directo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500116,
					"content": "Que sí, que sí... Ya sé que tienes amigos por todas partes. ¿Dónde has aprendido a hablar así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500118,
					"content": "... ¿De una niña bajita con un brazo de metal y sombrero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500120,
					"content": "Puedes seguir hablando así si te place, pero... tampoco intentes imitar todo lo que hace esa señorita, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Ahora tengo que hablar con {NICKNAME} y Paimon, así que tranquilícense un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500123,
					"content": "El pájaro se ha quedado callado... Vaya, es genial que puedas entender a los animales. A Paimon también le gustaría tener esa habilidad tan increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "Créeme, Paimon, no creo que te gustara mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Eso ha sonado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "#No me malinterpreten, no estoy diciendo que una habilidad así pueda causar desastres ni que tengan que sentirse intranquil{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "Aunque... A veces es cierto que puede resultar abrumador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Cuando descubrí que podía comunicarme con los animales me puse muy contenta al principio, pero luego me di cuenta de que había un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "Esta habilidad permanece activa en todo momento y escapa a mi control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Oh... Claro, Paimon no se había dado cuenta de eso, pero la habilidad de entender a los animales de Lauma no es algo que se pueda controlar, es como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Aunque se encuentre en el bosque o en el agua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "... Siempre había oído que el canto de las aves en las profundidades del bosque proporcionaba una profunda sensación de calma y tranquilidad que puede levantar el ánimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Sin embargo, vaya a donde vaya... no puedo dar con esa sensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Aun cuando me encuentro en el bosque, puedo seguir escuchando la cháchara de los gatos monteses, los conejos, los ciervos astaglaciales, los tejones mantomelena y los ibis plumalarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Hablan a voz en grito sobre quién ha destruido el nido de quién, dónde encontrar las ramas de mejor calidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Así nunca podrás descansar los oídos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "E-está bien... Paimon prefiere no tener esa habilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "A Paimon le gusta despertarse por la mañana con el piar de los pajaritos, pero... si a Paimon la despertaran con una charla sin pies ni cabeza, se pondría de muy mal humor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "#Amb{F#a}{M#o}s sabemos que el piar de los pájaros no te despierta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Pero a día de hoy... ya me he acostumbrado a ello. Si una mañana no escuchara a los pinzones discutiendo sobre qué vaso de qué casa es el mejor para lavarse, me sentiría rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500146,
					"content": "#Gracias por recordármelo, casi se me olvida. Pero, ya que {NICKNAME} está aquí, quizá no tengamos que adoptar un método tan... directo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Yo sí que tengo amigos por todas partes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "Eso no será necesario, solo necesito tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "Confío en que, con tu ingenio, abrir el sello del almacén que creó una de las Cantalunas anteriores con el Espejo lunacreciente... te resultará pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Creado por una Cantalunas anterior...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "#No te preocupes, no creo que te resulte difícil. Ven, vamos junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "¡Necesitaré instrucciones in situ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Solo necesito algo de tiempo para reunir un equipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "Pero si la mayoría de las veces soy yo quien tiene que despertarte a sacudidas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "Todo estará muy animado vayas a donde vayas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "Allá donde haya animales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "Me ha dado un escalofrío...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "No sabrán repartirse el botín de forma equitativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
		{
			"id": 7665002,
