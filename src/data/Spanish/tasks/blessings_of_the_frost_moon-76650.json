					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500217,
					"content": "Oye, no te me subas encima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "#Basta, no te comportes así enfrente de l{F#a}{M#o}s invitad{F#a}{M#o}s.",
