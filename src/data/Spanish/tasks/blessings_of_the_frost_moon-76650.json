				]
			},
			"dialogs": [
				{
					"id": 766500201,
					"content": "Hemos llegado. Lo que están viendo es el Espejo lunacreciente donde está sellada la Estatua decretolunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500202,
					"content": "¿Es muy valiosa esa estatua? Como se han tomado tantas molestias por sellarla... No habrá ninguna trampa ahí dentro, ¿no? De esas que si das un paso en falso, ¡pum!, suelta una flecha mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "#Yo ya estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "#Tranquil{F#a}{M#o}s, ya le pedí al pequeñín que fuera a explorar con antelación. Ahí no se esconde ninguna trampa mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
