					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500215,
					"content": "Jeje, Paimon puede volar, así que no podrás alcanzarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
