					"nextDialogs": [
						766500207
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500207,
					"content": "¡Oh! Es el hurón ladrón... ¡Pues sí que es digno de confianza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500208,
					"content": "Pero parece querer pedir algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "Jeje, eso es cierto. Cada vez que le pido ayuda, tengo que pagarle un Mora más la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500211,
					"content": "Sabe hablar de dinero y todo... ¡Claro, es un hurón ladrón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500212,
					"content": "Aunque, si te ayuda a vigilar la Estatua decretolunar, ¿no debería cambiarse el nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "Paimon"
				},
				{
