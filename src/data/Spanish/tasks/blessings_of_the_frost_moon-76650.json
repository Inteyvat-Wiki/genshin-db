					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 766500228,
					"content": "#Él me comunicará tu posición y el mecanismo que tengas enfrente. Tranquil{F#a}{M#o}, tan solo tendrás que seguir mis instrucciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
