					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "#Ustedes pueden ocuparse del mecanismo de esa zona, {NICKNAME}. Yo me encargaré de este lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Pero ¿cómo lograremos hacerlo a la vez?...",
