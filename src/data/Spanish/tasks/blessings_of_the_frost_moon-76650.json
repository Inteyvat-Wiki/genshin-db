					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "No te preocupes, también tengo ojos en el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪...",
