						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#Dice que nunca había visto a nadie a quien se le diera mejor conseguir tesoros que a {NICKNAME}, y que está dispuesto a seguirl{F#a}{M#o} para abrir todos los cofres del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "#Eso me hace sonar como un{F#a} ladr{F#ona}{M#ón}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Hurón ladrón"
				},
				{
					"id": 766500316,
					"content": "“Si en el futuro encuentro algún cofre que no pueda abrir, ¡vendré a pedirle ayuda!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "S-se ha ido... ¡Ni siquiera nos ha dado la oportunidad de rechazar su petición!",
