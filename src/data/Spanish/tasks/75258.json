			"dialogs": [
				{
					"id": 752580101,
					"content": "¿Eh? ¿Este hombre se ha desmayado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "¡Ey! ¿Oyes a Paimon? ¿Qué te ha pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Ayudan al hombre a levantarse, tras lo cual empieza a recuperar la consciencia...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ay, ay, ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580105,
					"content": "Hola. ¿Te has emborrachado? ¿Necesitas que te acompañamos a casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Qué mareo... ¿Qué me ha pasado?... Necesito hacer memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580108,
					"content": "¡Ah! ¡Ya lo recuerdo! Alguien me dejó inconsciente... Pero no vi quién lo hizo. Espera... ¿no fueron ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580109,
					"content": "¡Oye! Encima que te ayudamos... ¡Deberías darnos las gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Ay, lo siento. Eh... Soy un empleado de la taberna Rocío para Dos. Tenía que ir al puerto del norte a entregar unas mercancías. El gremio de Nod Krai nos había encargado un pedido de hidromiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580111,
					"content": "¡Rayos! ¿Dónde está mi mercancía? ¡Mi hidromiel! ¿Alguien me lo robó? Un momento... ¿fueron ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580112,
					"content": "¡Y dale con eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Ay, es verdad, lo siento. Ahora mismo estoy un poco mareado. Muchas gracias, pero tengo que volver a la taberna y contarles lo que ha pasado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580114,
					"content": "Si de verdad hay bandidos, no vayan al puerto del norte. Podría ser peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Empleado desmayado"
				},
				{
					"id": 752580106,
					"content": "¿Quieres que te acompañemos a casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
