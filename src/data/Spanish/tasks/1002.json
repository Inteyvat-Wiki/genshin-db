					"nextDialogs": [
						10020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020503,
					"content": "¡Tonterías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020504,
					"content": "¡¡Tonterías!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020505,
					"content": "¿Las Siete Estrellas de Liyue? Qué decepcionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020506,
					"content": "¡¿Cómo puede alguien asesinar a Rex Lapis en medio del Rito del Descenso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020507,
					"content": "¡¿Y sospechar de los asistentes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020509,
					"content": "#Viajer{F#a}{M#o}, es de mi conocimiento que ha sido acusad{F#a}{M#o} del asesinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020510,
					"content": "Yo tengo mis propias conclusiones al respecto, pero debo consultarlo con el consejo para no estar equivocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020511,
					"content": "Vaya y lleve consigo el Sello del Permiso y deles mi mensaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020512,
					"content": "¿A quién debo buscar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "¿A dónde debo ir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "Aquí podrá encontrar a Moldeador de Montañas y a Preservadora de Nubes. Pero solo los encontrará si el destino así lo quiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020515,
					"content": "También está el Gran Cazador de Demonios, el guardián Yaksha. Vayan a la Posada Wangshu. Ahí lo han de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escultor de la Luna"
				}
			]
		}
