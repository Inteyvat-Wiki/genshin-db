			"dialogs": [
				{
					"id": 10020201,
					"content": "¿Quién se atreve a poner un pie en el Desfiladero Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020202,
					"content": "Me enviaron aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Por favor, mire esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Un Sello del Permiso... Ha pasado mucho tiempo desde la última vez que presencié uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020205,
					"content": "#Soy uno de los poderosos e iluminados Adeptus, Escultor de la Luna. Viajer{F#a}{M#o}, diga, ¿qué motivos le traen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020206,
					"content": "En realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "¡Son los asesinos! ¡Se atrevieron a huir al Desfiladero Jueyun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Sargento de la Geoarmada"
				},
				{
					"id": 10020208,
					"content": "Jefe, ¿no cree que nos hemos adentrado mucho en el Desfiladero Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Soldado de la Geoarmada"
				},
				{
					"id": 10020209,
					"content": "No tenemos elección. ¡Atrapar a los asesinos es nuestra prioridad número uno! ¡Ármate de valor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Sargento de la Geoarmada"
				},
				{
					"id": 10020210,
					"content": "¿Quiénes se atreven a perturbar nuestras fronteras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10020211,
					"content": "Desháganse de ellos. No toleraré ninguna interrupción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escultor de la Luna"
				}
			]
		},
