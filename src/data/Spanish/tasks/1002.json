					"content": "Vuelvo a preguntar: ¿Cuál es el propósito de su visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
