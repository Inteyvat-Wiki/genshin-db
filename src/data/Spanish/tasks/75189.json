			"dialogs": [
				{
					"id": 751890501,
					"content": "“Sabía que vendrían, así que me adelanté para recibirlos como es debido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890502,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "“Sé que solo estás siendo cortés, pero me alegro genuinamente de verte”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890504,
					"content": "¡Ah, eres tú! Eh... ¿Qué nombre vas a usar esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "“El nombre de esta vez pertenece al escriba de la Cámara de Deliberación, aunque, en realidad, dejó de escribir él mismo a partir de la invención de los dragosirvientes fuentenigma”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890506,
					"content": "“Puedes llamarme... Awanyu”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890507,
					"content": "De acuerdo, Awanyu, ¿estás aquí para ayudarnos a conseguir el permiso con el que entrar al Corazón de la Montaña Sagrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "“Si no lo tuvieran, el simulador astral que hay en el Corazón de la Montaña Sagrada atacaría a cualquier intruso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890509,
					"content": "“He extraído los registros de este tal ‘Awanyu’. El permiso para entrar al Corazón de la Montaña Sagrada se encuentra en la Cámara de Deliberación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890510,
					"content": "“Por ello, me veo obligado a poner pie en este lugar: un punto de reunión para necios presuntuosos, un refugio para los incompetentes que se enorgullecen de su propia incompetencia”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890511,
					"content": "“Así como la guarida en la que esos pretenciosos creen tener el derecho de juzgar a los suyos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragosirviente fuentenigma"
				}
			]
		},
		{
			"id": 7518906,
			"completionStepIds": [
				7518905
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
