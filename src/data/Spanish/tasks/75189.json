			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "“Vamos, veamos dónde han escondido el permiso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890302,
					"content": "“Parece que lo dejaron ahí y ni siquiera se molestaron en esconderlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890303,
					"content": "“Aunque parece que no es más que un recipiente vacío”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890304,
					"content": "¡Aaah! ¿Por qué de repente hay tantos Sabuesos Acechadores? Ay, el permiso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "“Probablemente entraron aprovechando que la puerta no estaba vigilada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890306,
					"content": "¿Y-y qué hacemos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "“No pasa nada, solo tenemos que activar el dispositivo de purificación y reparación de la Cámara de Deliberación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890308,
					"content": "“Por ahí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragosirviente fuentenigma"
				}
			]
		},
