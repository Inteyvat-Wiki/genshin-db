			"dialogs": [
				{
					"id": 751890701,
					"content": "Detectada amenaza de enemigo oculto bajo las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890702,
					"content": "Defensa interna... Activando modo de reparación automática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890703,
					"content": "Paimon no imaginaba que veríamos uno de estos mecanismos en el interior de un lugar como este... ¡Esos monstruos no duraron ni un segundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "“Este lugar se construyó para resistir durante miles de años. No solo puede defenderse de los enemigos, sino que también es capaz de autorrepararse”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890705,
					"content": "La luz es tan dorada y brillante... ¡Paimon tiene ganas de tocarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "“Jaja, me temo que no es muy recomendable que lo hagas. No distingue entre aliados o enemigos, así que quemará cualquier cosa que la toque”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890708,
					"content": "“Qué manera tan burda de hacer las cosas... ¡Hum! Me pregunto quién lo habrá diseñado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890709,
					"content": "También podríamos usarla para abrir la cubierta que protege el permiso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Vale la pena intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Bueno, entonces... tenemos que encontrar una forma de hacer que esta cosa se eleve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Primera vez que propones algo que de verdad podría funcionar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Mmm, ¡gruuu, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "“Sí, es una buena idea. Quién hubiera imaginado que esta emisaria blanca poseería tal sabiduría oculta... Me resulta sorprendente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890715,
					"content": "Paimon no entiende de qué se sorprenden tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
