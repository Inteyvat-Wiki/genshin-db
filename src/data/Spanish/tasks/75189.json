					},
					{
						"sceneId": 101,
						"position": [
							224.009,
							360.155,
							-152.257
						],
						"pointId": 70
					},
					{
						"sceneId": 101,
						"position": [
							224.056,
							360.155,
							-150.196
						],
						"pointId": 71
					},
					{
						"sceneId": 101,
						"position": [
							224.075,
							360.155,
							-154.628
						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "“Allí se encuentra la luz inscripta que puede activar la escama, es decir, el permiso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890602,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Guau... ¡Desde aquí se puede ver toda la Ciudad Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "“Sí, la triste sombra de su antiguo esplendor...”,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890605,
					"content": "Mmm... ¿Grrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "“¿Quieres saber cuál fue el veredicto de aquel juicio? Jeje...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890607,
					"content": "“Los que exigían un juicio sagrado sabían que el maestro de toda la luz y las llamas estaba fingiendo su muerte, pero cuando el rey hacía acto de presencia en uno de sus raros momentos de lucidez”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890608,
					"content": "“Los trece señores y los tres príncipes, que normalmente no dejaban de hablar y gritar, retiraban de inmediato sus palabras y el falso juicio se daba por concluido sin un final definitivo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890609,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "“Más tarde, los tres príncipes murieron en la guerra contra los humanos, diez de los trece señores perecieron en el derrumbe de Tollan, la Ciudad Sagrada, y uno de ello se quedó en Chichén Uctokah”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890611,
					"content": "“Solo uno de los trece señores sigue vivo en el presente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890612,
					"content": "“Pero, seguramente, no en la forma que desearía conservar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890613,
					"content": "“Bien... Continuemos hacia el Corazón de la Montaña Sagrada. Allí está todo enterrado... incluido el gran anhelo del final del viaje”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890614,
					"content": "“Pronto habré cumplido mi misión aquí. Elegido de los dragones, no sabes lo hermoso que solía ser este lugar...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890615,
					"content": "“Adelante, toca la luz inscripta de la escama ardiente y obtén el permiso para llegar al Corazón de la Montaña Sagrada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "¡Awanyu!... Arg, ¡se fue otra vez! Paimon ni siquiera pudo decir su nombre más que un par de veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Bueno, al menos hemos conseguido el permiso para ir al Corazón de la Montaña Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "La luz... desapareció...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
