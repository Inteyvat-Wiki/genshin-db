			"dialogs": [
				{
					"id": 751890401,
					"content": "Por fin... Jeje, ¡ahora sí que tenemos el permiso para entrar al Corazón de la Montaña Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "“No. Como ya dije antes, esto solo es un recipiente vacío para el permiso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890403,
					"content": "“Si esta cosa que está hecha de escamas no contiene la información de ningún portador, no podrá usarse como permiso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890404,
					"content": "“De lo contrario, sería como una llave maestra que podría usar cualquiera mientras fuera un dragón”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890405,
					"content": "Pues ¿a qué esperas? ¡Tráeme un dragón apto para esto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#¿Y de dónde lo sacamos?... Un momento, ¿{REALNAME[ID(2)|SHOWHOST(true)]} no podría contar como dragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "“No... Aún no tiene la autoridad necesaria”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890409,
					"content": "¿Y qué hacemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "“Hace mucho tiempo, cuando el grandioso soberano ya había entrado en el Corazón de la Montaña Sagrada, hubo otros que no pudieron activar el permiso aunque sí poseían cierta autoridad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Dragosirviente fuentenigma"
				},
				{
					"id": 751890411,
					"content": "“Quizá por eso dejaron aquí un permiso tan llamativo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragosirviente fuentenigma"
				}
			]
		},
