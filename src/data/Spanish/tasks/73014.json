				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Gracias, nara {NICKNAME}. Siguiente tarea pueden dejar para Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141502,
					"content": "Ha pasado tanto tiempo que Arapandu no sabe si esta vez funcionará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141503,
					"content": "¿Eh? ¿Cabe la posibilidad de no conseguirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Hace tiempo conseguí, pero esta vez Arapandu no sabe qué pasará. Última y penúltima vez, sol salió, pero quién sabe si próxima vez saldrá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Solo después de que sol salga de nuevo, Paimon podrá decir: “Ah, sol salió otra vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Ay... ¡Qué miedo! ¿Qué haremos si el sol no vuelve a salir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#No es necesario que Paimon se asuste. Nara {NICKNAME} es igual que nara Váruna: valiente y dorad{F#a}{M#o} como sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Si nara Váruna pudo devolvernos sol y luna, nara {NICKNAME} también conseguirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "#¡Sí! Paimon también confía en {NICKNAME}. ¡Ninguna dificultad es insuperable para {F#ella}{M#él}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "No te preocupes, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Por ahora, dejen asunto en manos de Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Oh, parece que... ¿funcionó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Sí, rama y hojas ya se sanaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "¡Qué bien! Además, ¡la danza de los aranara fue genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Quizá deberías aprenderla con ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "¡Suena genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Viendo cuánto comes, te vendría bien hacer ejercicio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "¡Eh! ¡Flotar de acá para allá contigo ya cuenta como ejercicio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Sin embargo, solo con esto no es suficiente para arreglar la máquina divina de Váruna, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "Todavía hay tres partes esparcidas por bosque. Arabalika es muy fuerte, quizá pueda... Pero a Arapandu preocupan mucho Aranakula y Arakunti. Como lluvia no es normal, bosque es peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "#{NICKNAME} y Paimon irán a ver cómo están. Después de todo, si no arreglamos la máquina divina de Váruna, será difícil preparar con calma el Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Con ayuda de Paimon y nara {NICKNAME}, seguro que arreglaremos pronto máquina divina de Váruna y bosque recuperará vitalidad, igual que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula fue a <color=#00E1FFFF>Monumento de Yasna</color>. En profundidades de bosque está monumento que aranara hicieron a nara Váruna. Pero hace mucho tiempo que nadie va debido a hongos y esporas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula tiene costumbre de juntarse con tierra y semillas, así que sabe cómo se nace de tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Vayan a buscar a él y díganle nombre de Arapandu, así no se asustará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Vaya, parece que es un aranara un poco miedoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#¡Ararakalari de Arabalika es muy fuerte! Pero... aun así, estaría bien que Paimon y nara {NICKNAME} fueran a echar un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "Arabalika está en <color=#00E1FFFF>Ruinas de Dahri</color>. Allí huele mucho a hierro... Vayan con cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Sí, iremos con cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti está en <color=#00E1FFFF>Arboleda Onírica</color>. Allí se encuentra entrada a sueños. Él no tiene relación muy cercana con nara, así que, si se esconde, toquen nuestra música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "Ahora que lo dices, tenemos una partitura de los aranara, ¿verdad? Si no encontramos a Arakunti, ¡podemos intentar tocarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "#Arapandu {F#las}{M#los} esperará en descansadero mientras observa bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika y Arakunti saben que, después de haber curado ramas y hojas, tienen que regresar a descansadero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Oh, rubi{F#a}{M#o} y valiente nara {NICKNAME}, que Aramuhukunda te proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "#Eso, ¡cuenta con nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "¡Ey! ¿Qué era eso de allí? ¡Era enorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Ahora, nara {NICKNAME} y Paimon ya saben que máquina divina y arma de Váruna están en lugar aún más profundo, tan profundo como raíces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "#Al parecer, subestimamos {F#al}{M#a la} nara Váruna. Paimon no pensó que sería para tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "No podemos subestimar su poder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Antes de que lluvia negra y nara Váruna llegasen a bosque, Aramuhukunda y diosa Dendro crearon máquina divina de Váruna para que lluvia trajera vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "Lluvia negra, tierra negra y otras muchas cosas malas sembraron caos en bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "#Antes de que {F#él}{M#ella} viniera, Arapandu nunca había visto nara tan valiente. Igual que cuando sol disipa bruma matutina, {F#él}{M#ella} y aranara curaron juntos máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Ahora, ni nara Váruna ni Aramuhukunda están en Vanarana... Pero aranara tienen que reparar de nuevo máquina divina de Váruna por bien de Festival Utsava y de bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Prometimos a Araja y Arama que ayudaríamos a preparar el Festival Utsava, así que, como se suele decir: ¡la llama hace la fuerza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Ehmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "¡Ah! No, no es así. Paimon quería decir que cuantos más seamos, más fácil será hacer las cosas. No tengas miedo, ¡esto no tiene nada que ver con el fuego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Eso te pasa por hacerte la lista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Es que... como estamos en Sumeru, Paimon quería mostrarle a todo el mundo que también sabe muchas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu no tiene miedo. Paimon tiene buen corazón, igual que nara {NICKNAME} y nara Váruna. Todos son amigos de aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti y Arapandu quieren sanar máquina divina de Váruna, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "Hay demasiadas esporas y hongos, no sabemos qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Como Arapandu no tiene ararakalari tan fuerte como Arabalika, lluvia extraña hizo que Hongos se volvieran más violentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Espera, ¿“ararakalari”? Arana dijo que con eso se podía contrarrestar el Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Ararakalari es poderoso, puede ahuyentar a Hongos. Pero Arapandu no tiene mucho ararakalari, así que no hay nada que pueda hacer contra ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "¿El ararakalari se puede usar para eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Debe de ser el nombre de algún tipo de poder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} es más inteligente que Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "*Tsk*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Ararakalari puede variar según cada aranara, pero poder de todos aranara proviene de plantas de bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Arabalika tiene poderoso ararakalari. No teme ni a Hongos grandes ni a gran nara de hierro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "¿Gran nara de hierro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Gran nara de hierro es enorme y tiene dos manos y dos pies, como nara {NICKNAME}, pero solo tiene un ojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "¡Aaah, Paimon ya entiende! ¡Estás hablando de un Guardián de las Ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Muy inteligente, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "¡Ah! En ese árbol de ahí también hay Hongos... Seguro que Arabalika puede con ellos, pero Arapandu no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Nara {NICKNAME}, tú tampoco temes a Hongos. Aunque no uses ararakalari, eres tan fuerte como viento que arranca hojas de árboles con su ¡*fiuuu*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Si no hacemos algo, habrá cada vez más esporas y hongos. Por favor, nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141734,
					"content": "#¡Cuenta con nosotr{F#a}{M#o}s! Con las habilidades {F#de la}{M#del} nara {NICKNAME}, seguro que {F#ella}{M#él} también solucionará el problema con un ¡*fiuuu*! ¿Verdad, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}