				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141001,
					"content": "Este parece un buen sitio para descansar. A juzgar por estos rastros, por aquí deben de haber pasado los aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "Desde aquí, la máquina divina de Váruna se ve todavía más espectacular. Guau... es impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon, ve con cuidado. No vaya a ser que te trague.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "¡Eso no va a pasar! O eso espera Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Bien, después de sanar ramas y hojas de máquina divina de Váruna, nos veremos en descansadero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Y entonces, para sanar máquina divina de Váruna, expulsaremos juntos a bicho malo que mordisquea máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "Por cierto, ¿qué quieres decir con las “ramas” y las “hojas” de la máquina divina de Váruna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "Ramas y hojas de máquina divina están esparcidas por todo bosque. Gracias a ellas, máquina tiene poder de convertir lluvia negra en lluvia buena, lluvia que trae vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Igual que agua de lluvia se transforma en riachuelo y luego riachuelo se convierte en lago, ramas y hojas recogen cada gota de agua para máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "Pero ahora máquina no funciona como antes. Es como si sus pequeñas ramas rotas obstruyen paso de agua de lluvia, que no llega a formar riachuelo. Y si no hay riachuelos, lagos se secan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Ehmm... Paimon sigue sin entenderlo del todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "Es como cuando no comes, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "Ahhh. Si Paimon no come, ¡no tiene fuerzas para hacer nada! Entonces, ¿la máquina divina de Váruna está de mal humor porque tiene hambre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "No creo que sea así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Tienes razón. Cuando tienes hambre, ni siquiera tienes energía para ser gruñón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "Entonces, ahora tenemos que sanar esas ramas y esas hojas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Así es. Arapandu irá con Paimon y nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "Es como cuando un camino para transportar mercancías está bloqueado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "¡Entonces habría que quitar todos los obstáculos para seguir adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "¡Solo tenemos que encontrar otro camino! Al fin y al cabo, ¿por qué sería obligatorio usar esa ruta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Es verdad, ¿por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
			]
		},
		{
			"id": 7301412,
			"completionStepIds": [
				7301412
