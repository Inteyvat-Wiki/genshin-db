			},
			"dialogs": [
				{
					"id": 730141201,
					"content": "Vaya, ¡conque aquí se escondían!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141202,
					"content": "Pero... ¿Eh? ¿Estas son las ramas y las hojas? Parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141203,
					"content": "Parece una piedra colocada por los aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Aramuhukunda y diosa Dendro hicieron hojas y ramas de piedra para concentrar poder de bosque en máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141205,
					"content": "La máquina divina es como un gran árbol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "¡Conque así es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Humm... Tenemos que girar esas tres hojas en dirección de rama, pero Arapandu no es suficientemente fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#Al fin y al cabo, los aranara son muy pequeñitos. No te preocupes, déjalo en manos de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141209,
					"content": "Arabalika quizá pudiera hacer, pero Aranakula y Arakunti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141210,
					"content": "#Primero tenemos que solucionar problema que tenemos delante. Nara {NICKNAME}, Arapandu cuenta contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
