			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "#Nara... Oh, rubi{F#a}{M#o} y valiente nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140302,
					"content": "#Paimon se llama Paimon, y {F#ella}{M#él} es {NICKNAME}. Todo el mundo en Vanarana está ajetreado preparando el Festival Utsava, ¿por qué viniste solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140303,
					"content": "Arapandu tiene misión especial que cumplir por bien de Festival Utsava, de Floresta Apam y de nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140304,
					"content": "Conque te llamas Arapandu... Pero ¿quién es nara Váruna? Paimon cree haber escuchado ese nombre antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140305,
					"content": "#Nara Váruna... {F#Él}{M#Ella} es igual que tú, nara {NICKNAME}: rubi{F#o}{M#a} y valiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140306,
					"content": "Cuando no se podían ver ni sol ni luna, incluso viento roía a grandes árboles de bosque y sus ramas se pudrían con lluvia negra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140307,
					"content": "Bosque sufría y su dolor penetraba en tierra. En todos lados se podía sentir olor a hierro y a sal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140308,
					"content": "¡Por Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140309,
					"content": "#Arapandu no sabe cuántas veces se puso y salió sol hasta que nara Váruna llegó. {F#Ese}{M#Esa} nara de cabellos de oro hablaba una lengua dorada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "#Juntos, {F#él}{M#ella} y aranara trajeron de vuelta sol y luna. Máquina divina de Váruna curó dolor de bosque, detuvo lluvia negra e hizo que olor a hierro y sal desaparecieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "#Todo mundo en Vanarana dio gracias y todo mundo adoraba a {F#él}{M#ella}, igual que adoran a sol, a tierra y a lluvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "#¡Guau! Suena increíble. ¡Seguro que es {F#un buen}{M#una buena} nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Pero {F#la}{M#el} nara {NICKNAME} también ha ayudado a mucha gente y muchas personas están muy agradecidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#¡Seguro que a ti también te caerá bien {F#la}{M#el} nara {NICKNAME}, Arapandu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "Cuando nara Váruna se fue de Vanarana, muchos nacieron de tierra y muchos volvieron a ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Ramas y hojas de máquina divina de Váruna perdieron su fuerza, y arma de Váruna era como pajarito asustado que batía alas sin control. Además, empezó a llover mucho, y lluvia era extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Champiñones caminantes se asentaron en bosque, y entonces por todas partes había semillas que Arapandu nunca antes había visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "¿No crees que tal vez eran hongos y esporas? Pero espera, ¿entonces qué son la máquina divina y el arma de Váruna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "¿Son armas muy poderosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Son como espadas capaces de cortar el valuka en dos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "No, espera, ¡eso es demasiado violento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Humm... No, no es así. Ni nara {NICKNAME} ni Paimon tienen razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Vayamos a lugar alto, Arapandu contará a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Quizá no sean armas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "¿Y entonces qué son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Podrían ser aranara de agua con alas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "¿Eso no son los Animales Hidromiméticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
