			"dialogs": [
				{
					"id": 221020101,
					"content": "Qué molesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "¿Ve estas ojeras? Hace días que no puedo pegar ojo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "¿Ha visto a nuestros huéspedes? Cada uno está más loco que el anterior. ¿Se puede creer que uno se atrevió a saltar desde aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "En fin... acabo de hacer un pedido de comida a la ciudad, debe estar por llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "Los monstruos del camino nunca descansan. ¿Puedo pedirle que se deshaga de ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "¿Qué hace una posada en un lugar como este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Bueno... “Cuando nuestras puertas estén abiertas a viajeros de todos los rincones, puedes esperar todo tipo de personas”. Eso es lo que me gusta decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "Pero, a decir verdad, es solo una simple posada un poco apartada del camino, con muchos huéspedes, pero nada en especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Le estoy agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
