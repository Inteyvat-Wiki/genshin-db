			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Sr. García"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Sr. García, con todo el respeto del mundo, creo que deberíamos buscar la forma de pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "¡Esos vendedores no son más que ladrones! ¡¿Cómo pueden vender unas cuantas insignias a ese precio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140103,
					"content": "A lo mejor es porque se percataron de cómo le brillan los ojos cada vez que ve una de esas insignias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "¿Quieres esas insignias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "#¡Viajer{F#a}{M#o}! Siempre llegas en el momento indicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140106,
					"content": "Gracias al condensado de Slime que me conseguiste la última vez, pude fabricar un buen lubricante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140107,
					"content": "Sin embargo, me encontré con otro problema. Al sustituir algunas partes, me di cuenta de que si las construyo con materiales demasiado consistentes, terminarán dañando el resto de los componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140108,
					"content": "Además, esos componentes duros terminarían por agrietarse al recibir el más mínimo impacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140109,
					"content": "Por eso estoy buscando materiales resistentes que tengan también cierta elasticidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140110,
					"content": "Tras una investigación exhaustiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140111,
					"content": "... Y molestar constantemente al Sr. Ahangar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Se me ocurrió que las insignias que llevan los Ladrones de Tesoros podrían servirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140113,
					"content": "Pero, con esos precios, los comerciantes de insignias también deben ser ladrones de tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140114,
					"content": "En fin... Manos a la obra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "#¡Eres mi {F#salvadora}{M#salvador}! ¡Voy a grabar tu nombre en el mecanismo principal de la máquina contable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140115,
					"content": "Te ayudaré a reunir los materiales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
