				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Humm, Lutong, voy a necesitar que me sostengas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145502,
					"content": "Señor García, debería descansar un poco más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "#Viajer{F#a}{M#o}, llegas en el mejor momento. Tengo que pedirte un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "¿Qué le sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Podría decirse que el señor García está borracho de café. Además, últimamente no duerme mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Al menos decidió beber café y no alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, yo... *Hic*, necesito más insignias de las que llevan los Ladrones de Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145508,
					"content": "#¡Viajer{F#a}{M#o}! ¿Cómo? ¿Tú por aquí? No te había visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145509,
					"content": "¿Me ayudarías a reunir insignias? Solo necesito unas pocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145510,
					"content": "Deberías descansar un rato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Estoy bien, de verdad. Tengo la mente muy clara... Es solo que me tiemblan un poco las manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145514,
					"content": "Así que, por favor, ¿podrías buscar unas cuantas insignias? Te lo compensaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Cuando las tengas, *hic*, dámelas a mí. Tengo que inspeccionarlas. Tengo que crear el rodamiento perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145512,
					"content": "¿Ha acabado así solo por beber café?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Bueno, no se puede culpar al café. La culpa es del Sr. García, que no duerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
