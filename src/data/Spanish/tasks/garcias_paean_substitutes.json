			"dialogs": [
				{
					"id": 230145001,
					"content": "Sería conveniente que encontráramos una fuente de ingresos lo antes posible, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "He oído que en Sumeru hay un gran teatro y que muchas de las compañías que actúan allí necesitan ayuda con su contabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Además, los actores que trabajan en esas compañías... Bueno, ya sabe, tienen muchos recursos, pero no saben administrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Sería una gran oportunidad, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Tu talento para la contabilidad y las oportunidades de negocio es realmente sorprendente, mi querido Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230145006,
					"content": "Tengo que reflexionar al respecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		},
