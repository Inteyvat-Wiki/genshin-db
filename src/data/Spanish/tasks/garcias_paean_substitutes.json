			"dialogs": [
				{
					"id": 230140301,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Con estas será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140302,
					"content": "Me pondré de inmediato a crear los nuevos engranajes. Humm... Aunque tal vez deba empezar por analizar el problema de los rodamientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230140303,
					"content": "#Aquí tienes tu recompensa. De nuevo, muchas gracias por tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Tal y como pintan las cosas, la nuestra será una larga y fructuosa colaboración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "*Suspira*, no es nada fácil administrar las finanzas del Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
