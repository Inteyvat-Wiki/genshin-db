			"dialogs": [
				{
					"id": 750240101,
					"content": "Ay, chicas, qué emocionadas están... *Fiu*, coman algo frío para tranquilizarse y ahora nos ponemos al día, ¿está bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "¡Grauuur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "Caléndula"
				},
				{
					"id": 750240103,
					"content": "Al principio, solo se oyó un grito de dolor, después le siguió un golpe sordo de algo pesado al caer al suelo y finalmente solo quedaron rugidos de saurios...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "¡¿Eh?! ¿Estará bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Ay, lo han rodeado. No podemos ver nada desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Paimon, ¿y si lo ves desde arriba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#Parece que quiere ir {REALNAME[ID(2)|SHOWHOST(true)]}. ¡Ve tú, pequeñín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Eh, parece que no va bien la cosa. ¿Acaso se murió? Ay, no, no, no. Quizá solo se haya desmayado. De todas formas, ¡tenemos que ir a ver qué le pasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Con permiso, ¿se pueden hacer a un lado los tres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "¡Grrra! ¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "Caléndula"
				},
				{
					"id": 750240113,
					"content": "Gruuu... ¿Gruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "Ondas"
				},
				{
					"id": 750240114,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "Jade"
				},
				{
					"id": 750240115,
					"content": "Ay, no parece que vayan a mover una pata... ¿Qué está pasando? A juzgar por lo que oímos, parece que se conocían...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Ojalá tuviéramos más pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#¿Eh? ¿{REALNAME[ID(2)|SHOWHOST(true)]} se dio cuenta de algo? ¡Vamos a seguirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
