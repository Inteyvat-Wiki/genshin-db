					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240902,
					"content": "#Humm... pero el espacio no es suficiente. {REALNAME[ID(2)|SHOWHOST(true)]}, ¿puedes llevarte también a Jade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240903
					],
					"speakerTitle": "Paimon"
				},
				{
