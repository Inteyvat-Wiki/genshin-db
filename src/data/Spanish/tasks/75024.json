			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750240701,
					"content": "(Aquí hay un diario.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240702,
						750240706,
						750240710,
						750240714
					]
				},
				{
					"id": 750240702,
					"content": "Leer la primera parte",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240703
					]
				},
				{
					"id": 750240703,
					"content": "“... Hoy es un día nublado. Le he preparado a Ondas su <color=#00E1FFFF>ceviche</color> favorito. Al verte tan satisfecha, siento que todo ha merecido la pena”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240704
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240704,
					"content": "“... Por muy feliz que esté nadando en el agua, en cuanto le traigo el <color=#00E1FFFF>ceviche</color>, ¡enseguida hace un salto perfecto desde el agua!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240705
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240705,
					"content": "“... Yo sé que me quiere, pero me preocupa que su amor por el <color=#00E1FFFF>ceviche</color> sea mayor que el que siente por mí...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240706,
					"content": "Leer la segunda parte",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240707
					]
				},
				{
					"id": 750240707,
					"content": "“... Esos ojos redonditos y brillantes, esa cola enrollada, esos rugidos de alegría... Oh, Jade, ¿existe en este mundo una sauria más adorable que tú?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240708
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240708,
					"content": "“... Ni una sola vez te han engañado, ni una sola vez has dudado, como si todo ser vivo pudiera convertirse en tu amigo y disfrutar de un rato maravilloso jugando contigo...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240709
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240709,
					"content": "“Si no tuviera tanto trabajo, me encantaría quedarme a jugar contigo todo el día. Me quedaría viéndote correr por el bosque, bañado por el sol, como una niña del viento, ¡una hada despreocupada!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240710,
					"content": "Leer la tercera parte",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240711
					]
				},
				{
					"id": 750240711,
					"content": "“... He cruzado montañas y valles solo para buscar tu paradero. Si de verdad no te importara, podrías haberte marchado...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240712
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240712,
					"content": "“... Pero pensaste en mí y aligeraste tu paso, e incluso recogiste varios mahíses para mí, y aquellas piedras brillantes...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240713
					],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240713,
					"content": "“... Oh, Caléndula, mi adorable Caléndula, solo yo conozco el tierno corazón que se esconde bajo tu dura coraza. Ser una guerrera audaz nunca fue tu intención...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario de alguien"
				},
				{
					"id": 750240714,
					"content": "(Mejor lo dejo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
