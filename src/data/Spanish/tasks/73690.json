			"dialogs": [
				{
					"id": 736900101,
					"content": "¡Hola! Soy Daya, de la Facultad Kshahrewar. ¿También vienes a participar en la Feria de la Academia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "¡La actividad que propone nuestra facultad es “Ingeniería de caminos”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "¿Qué te parece? ¿Te animas a probarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Recuerdo que la Facultad Kshahrewar se dedicaba a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Nos dedicamos al estudio de los mecanismos y a la arquitectura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "*Ejem*, a lo que iba... Para participar en la feria, muchos de nuestros estudiantes pusieron ideas en común y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "¡El resultado fue la creación de nuestro juego, “Ingeniería de caminos”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Básicamente, el juego consiste en que los jugadores tienen que construir caminos con los objetos que les hemos preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Levantar puentes, colocar escaleras... El objetivo final es crear un camino por el que la gente pueda viajar y llegar a su destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Una vez que hayas terminado de construir el camino, realizaremos una inspección final, igual que haríamos con las construcciones terminadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Básicamente, con que construyas una vía segura, habrás superado el reto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Suena complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Jajaja, no te preocupes. No es que vayamos a construir vías de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Si algo sale mal y la vía se derrumba, la reconstruimos y ya está. Tampoco vamos a poner límites en el número de intentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "¡Tan solo deja volar tu imaginación y construye las vías más bonitas posibles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Puedo intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Genial. Echa un vistazo por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Tengo otras cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Vaya... No pasa nada, nuestro puesto estará disponible durante toda la feria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Puedes pasarte a jugar cuando quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "#No me veo como arquitect{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
