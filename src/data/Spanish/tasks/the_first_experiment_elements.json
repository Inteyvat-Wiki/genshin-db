			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon tiene una pregunta. Cuando la semilla germine, ¿en qué se convertirá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "No lo sé, pero tengo el presentimiento de que lo importante está en el proceso, no en el resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Usar la alquimia para despertar vida de fuera de este mundo en Teyvat sería un gran avance para mi comprensión de la esencia de la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Después del despertar, incluso la creación es posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "¡Jaja! ¿Todavía te parece difícil de comprender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "¡N-no! ¡Paimon es inteligente! Pero ¿en qué se convertirá la semilla? Seguro que es más interesante que eso otro que estás diciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "No lo entendiste para nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "#Bueno, si sale una fruta deliciosa, yo {F#las}{M#los} invito a cenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "¡Yuju! Paimon te toma la palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Sabes cómo convencer a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Bueno, digamos que... de vez en cuando tengo que cuidar a una niña. Me temo que es una larga historia... Podría decirse que es una de las pocas disciplinas en las que soy bueno y que no está relacionada con la alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "El objeto de mi primera investigación fueron los elementos. En este mundo, manipular los elementos requiere de una Visión, pero no veo que lleves nada que se le parezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Me gustaría averiguar cómo eres capaz de manipular libremente el poder elemental. Tengo algunas preguntas al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "En primer lugar, ¿tienes más órganos de lo normal? Un segundo corazón, un cuarto estómago... Ya sabes, cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Fascinante. ¿Y esta niña flotante está... conectada a tu cuerpo de alguna manera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "#¡Qué pregunta tan tonta! ¿No puedes ver que estamos separad{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Además, ¡es Paimon, no “niña flotante”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Simplemente estaba considerando la posibilidad de que fueras un órgano externo. Tal vez haya alguna fuerza invisible que te conecte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Conocí a Paimon en mis viajes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, eso descarta esa posibilidad. Entonces, ¿Paimon canaliza el poder elemental hacia ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Pero eso significaría que su poder elemental sería suficiente para perforar rocas de, al menos, diez metros de grosor, o para hacer que la cascada al sur de Aguaclara fluya en sentido contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Humm. No, definitivamente es imposible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "¡Oye! ¿Y tú cómo sabes que no puedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "En ese caso, parece que no hay una diferencia evidente entre la composición de tu cuerpo y la de los humanos de este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Dado que existe una clara discrepancia en la investigación, parece que solo experimentando obtendremos respuestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "En primer lugar, empecemos con ese misterioso poder elemental. Me gustaría examinar cómo se manifiesta externamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Déjame atraer algunos Slimes. Puedes derrotarlos usando el método que te resulte más natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Em... Eso no suena muy “científico”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "La observación directa es imprescindible para un buen experimento. Este es solo un simple ejercicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Claro que, si necesitas un desafío mayor, podríamos traer seis Oceánidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "¡Slimes! ¡Los Slimes están bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "No lo entiendo muy bien, suena un poco engorroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Bueno, prepárate. Los Slimes estarán aquí en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Siempre y cuando no me ataquen bestias hidromiméticas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Pesqué a Paimon con una caña de pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "No, que yo sepa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Te diste cuenta de las intenciones ocultas de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Yo también quiero saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Buen trabajo, ¿sentiste algo fuera de lo común?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "#Si estás herid{F#a}{M#o}, tengo preparadas algunas pociones de emergencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "No tengo ni un rasguño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Excelente. Según mis observaciones, tu flujo elemental externo se manifestó como esperaba, y las reacciones elementales no presentan anomalías. No hay nada fuera de lo común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Ahora que sabemos que el flujo externo se manifiesta de manera normal, probemos con el flujo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "¿Flujo interno? ¿Y eso cómo se prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "Es muy sencillo. Puedo usar la alquimia para crear una poción que extraerá poder elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Si el poder elemental se almacena o se acumula físicamente dentro de tu cuerpo, esta poción provocará una reacción elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "¿Hará un torbellino en mi estómago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "¡Suena aterrador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "No te preocupes. En circunstancias normales, sentirás un mareo temporal sin llegar a lesionarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "¿Y en circunstancias anormales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Ya hice los preparativos necesarios por si ocurre algo inesperado, no te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Eso no es muy reconfortante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Bueno, no es que no haya ningún riesgo, pero si hay algo que bloquee tu flujo elemental, podremos localizarlo con esta prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Pero antes, tengo una advertencia. Si ocurre una reacción elemental interna por cualquier otro motivo, es una mala señal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "Es como una revisión médica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "¡Sí! Esa es una excelente manera de verlo. Antes de comenzar, a la poción que usaremos para la prueba le falta un catalizador, el cual tenemos que encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "Es un tipo de mineral conocido como argento estelar, pero, desafortunadamente, no todos son adecuados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Te llevaré a mi campamento. Podemos recolectar algunas piezas de argento estelar en el camino. Te ayudaré a escoger las más adecuadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Si todo va según lo planeado, deberíamos poder preparar la poción cuando lleguemos al campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "A Paimon aún le preocupan las cuestiones de seguridad, pero puede que saquemos algo positivo de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "¡Mantengamos los ojos abiertos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "¿Se cristalizará en mi estómago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Solo tengo un poco de frío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Este es mi campamento. Agregué a la poción los materiales que recolectamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Mientras esperamos, vean esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Mi asistente Timaeus me está ayudando con la investigación. Supongo que ya se habrán conocido en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Hola, acabo de obtener los datos de tu experimento. El informe está en este tablón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "¡Guau! ¡Mira toda esa información! ¿Obtuvieron todos estos resultados de una sola batalla con Slimes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "¡Jaja! Yo no los llamaría “resultados”. Como mucho son conjeturas y algunas hipótesis muy osadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "#Creo que lo más racional sería exponer la relación filogenética entre {F#la}{M#el} viajer{F#a}{M#o} y los Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "¿Eso es lo más racional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Piénsalo, no tienes una Visión, pero puedes manipular la energía elemental. Los Slimes tampoco tienen Visiones, pero también pueden manipular los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Si seguimos indagando sobre la base de este razonamiento, ¡seguro que obtendremos más pruebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "No está mal como punto de partida, pero técnicamente, los Slimes son formas de vida elementales. En otras palabras, seres que consisten enteramente de elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Una Regisvid Cryo, o incluso una Megaflora, podrían ser una mejor analogía. Pero si tuviera que rastrear las relaciones filogenéticas entre plantas y animales... tendría que remontarme hasta los orígenes del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "En ese sentido, estamos en un dilema, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "¿Eh? Ah, sí, señor. Eso parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "#Después de todo, ya tenemos nuestros primeros datos. Est{F#a}{M#e} viajer{F#a}{M#o} es {F#una}{M#un} visitante de otro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "Si resultara que tiene una relación filogenética con este mundo... sería algo increíble, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "¡Sííí! Uy, disculpe, me emocioné mucho al obtener los datos. No volveré a actuar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Hablando de datos, para completar nuestra investigación, necesitaremos unos pocos más. Por ahora, me quedaré aquí analizando los que tenemos. Si quieren saber el resultado del experimento, ¡vengan a buscarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Excelente, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Parece que la poción está lista. Probaré un poco yo primero. Si todo va bien, te la daré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "#Paimon y yo estamos más relacionad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104206",
							"2"
						],
						"stepId": 1104206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "Acabo de probar un poco, salió tal como esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "Recuerda mantener la calma en todo momento y respira profundamente si te sientes mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "Anotaré todos los resultados y datos observables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#¿Qué tal sabe? {NICKNAME}, ¿por qué pones esa cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Quema un poco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "¡Dijiste que lo probaste tú mismo! ¿Estás seguro de que estaba listo? ¿Qué le está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "¿Eh? Este era precisamente el resultado que esperaba y, de hecho, ha sido muy positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Esta poción canaliza el poder elemental hacia el cuerpo. Lo normal es que ocurra una reacción de rechazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Pero si el flujo elemental interno fluye sin problemas, solo experimentarás una pequeña molestia. Una vez que el flujo se complete, no habrá otros efectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Entonces, ¿sabías que te ibas a enfermar y aun así lo bebiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Jeje, después de todo, es mi propia poción. Es natural que yo sea mi propio sujeto de experimentación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "¿Para sentir empatía con tu sujeto de pruebas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "¡Por supuesto! Eres mi asistente, sería completamente irracional no asumir el riesgo contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "Bueno, ¡creo que ya hemos llegado a una conclusión! En lo que respecta a la energía elemental, no tienes nada que te diferencie del resto de personas de este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Paimon quería que sucediera algo especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "En realidad, es mejor un resultado normal que uno especial. Los resultados especiales tienden a ser... algo indeseables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Parece como si te estuvieras refiriendo a algo en concreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "Lo bueno de ser “normal” es que todo es objeto de referencia y todos te entienden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Las personas que son iguales pueden entenderse, sentir empatía, levantarse los ánimos y apoyarse los unos a los otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Cuando estás enfermo, un médico puede diagnosticarte porque es como tú. Cuando algo sale mal, puedes preguntar por su experiencia a las personas que han cometido el mismo error que tú, porque tú eres como ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Pero una persona especial... no es capaz de disfrutar las cosas que otros damos por sentado. La esencia de su vida es fundamentalmente diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Por ejemplo... Un humano no puede entender la vida de una Regisvid Pyro o un Ojo de la Tormenta. ¿Me explico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Creo que entiendo lo que dices.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "En resumen, este es un resultado positivo. En el futuro, puedes usar tu poder elemental sin miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, los resultados del nuevo experimento están disponibles. ¿Puedes cotejarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "¡Deme un momento, señor! ¡Yo me haré cargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Hay muchas cosas que tengo que considerar. Gracias a usted, he expandido mis horizontes. Ahora veo las cosas con mayor claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Quizás no fue muy preciso por mi parte considerarte un animal, pero ¿comenzar por la premisa de que eres una forma de vida elemental? Eso es realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "No está mal, creo que es una línea de investigación interesante. Sea cual sea la verdad, quiero que antepongas tu investigación a mis propios juicios y conclusiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "¡Puede contar conmigo, señor! ¡Obtendré un resultado satisfactorio para todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "¿Cómo puede seguir igual de entusiasmado tras ese comentario de Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Lo que Paimon quiere decir es que... ¡Esa es la actitud! Sr. Albedo, diga algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Humm... Antes de que podamos continuar con nuestra investigación, necesito preparar algo. Esperen un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "Si te interesa, ¿por qué no echas un vistazo a los alrededores? Puede ayudarte a matar el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Me sigue pareciendo un ejemplo demasiado específico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "¡¿Qué hay del riesgo que puede suponer para ti?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Tal vez sea por la confianza que tengo en mí mismo como académico, además que nos ahorra muchas molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "¡¿Bebiste esto?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
