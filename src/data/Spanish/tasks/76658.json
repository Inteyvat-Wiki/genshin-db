			"dialogs": [
				{
					"id": 766580101,
					"content": "Hola, Ginette. ¿Has terminado de resolver los fallos de los robots que encontramos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Sí, gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Por cierto, hemos descubierto cosas nuevas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "¿De verdad? ¡Cuéntenmelo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Paimon y tú le cuentan a Ginette lo que observaron hace poco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "#Según lo que describen... parece que a esos robots les gustan mucho y por eso quisieron invitarl{F#as}{M#os} a jugar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "¿En serio? ¡Eso es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Humm... ¡Lo sabía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "¿Has descubierto algo más, Ginette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Ahora estoy segura de ello: mi visión solo podrá llevarse a cabo con interacciones entre estos robots. Cuantas más unidades logremos recuperar, más nos acercaremos a mi plan inicial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Ahora ya pueden comunicarse con los demás. Lo único que tenemos que hacer es encontrar al resto de los robots y... ¡Sí! ¡Ya puedo ver los frutos de mi creatividad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "¡Vaya, alguien está muy emocionada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah, perdón... En realidad, aún necesito su ayuda. Ya marqué la siguiente zona en el mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Entonces pongámonos en marcha. Paimon tiene curiosidad por ver cómo evolucionarán estos robots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
