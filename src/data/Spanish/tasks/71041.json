					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitofo",
					"Paimon",
					"Zhichiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "El mecanismo de bloqueo todavía no se ha oxidado, tiene restos de aceite engrasador... Parece que alguien lo cuidó después de que cerrasen las minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410302,
					"content": "La culata también permanece intacta... Pero el seguro está bloqueado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410303,
					"content": "¿De qué habla este tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Los túneles de adelante se sellaron con grandes rocas cuando los mineros se dispersaron... Me temo que tendremos que volver a utilizar este cañón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410305,
					"content": "Pero sin munición, los cañones solo sirven de adorno, sean lo grandes que sean. Tenemos que encontrar munición para poder utilizarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410306,
					"content": "¡Hum! No hables como si yo no lo supiera, señor sabelotodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410307,
					"content": "Hay un almacén por aquí cerca donde podría haber munición para el cañón... Con suerte, los mineros dejarían algo antes de marcharse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410308,
					"content": "¡En marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "¡Vámonos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitofo"
				}
			]
		},
		{
			"id": 7104104,
			"completionStepIds": [
				7104111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104111",
							"2"
						],
						"stepId": 7104111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhichiong",
					"Clitofo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410401,
					"content": "Es aquí. *Cof, cof*, la puerta está bloqueada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410402,
					"content": "Tendremos que utilizar dos llaves a la vez para poder abrir la puerta... *Suspira*, ¿por qué la gente de Liyue se toma tan en serio estas cosas tan insignificantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
