			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitofo",
					"Zhichiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "¡*Fiu*! Gracias por salvarme la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410102,
					"content": "Un momento... ¡Yo te recuerdo! ¡Eres esa persona de la mina que se llamaba Tuclifo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410103,
					"content": "¿Eh? ¡No! Ese no soy yo. ¡Y-yo no vendo medicamentos falsos! Soy Clitofo, sí, pero no ese que vende medicinas falsas, ¡no, señorita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410104,
					"content": "Así que los medicamentos que vendías eran falsos, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "¿Qué? ¡No! ¡Imposible! ¡Los medicamentos que vendo son cien por cien auténticos! ¡Miren a los mineros! ¡Tomaron el remedio milagroso de Clitofo y están estupendamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410106,
					"content": "¿No acabas de decir que no eres ese Clitofo que vende medicamentos falsos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410107,
					"content": "Ah, eh... Sí, eso fue cuando dejé de dedicarme a la venta de medicamentos. Y sucedió cuando... ¡Cuando el Tuclifo ese vendió medicinas falsas suplantando mi identidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410108,
					"content": "¡Vendía medicamentos falsos usando un nombre falso y arruinó mi reputación! Eso es. ¡Por eso juré que vendería los mejores medicamentos durante el resto de mi vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410109,
					"content": "Y justo cuando cambié de rumbo, me capturó una banda de ladrones de tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410110,
					"content": "Pues sí, ese farsante es despreciable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410111,
					"content": "Sí, ¡ese individuo solo quería engañar a los que estaban en el mismo negocio que él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "Entonces, ¿su nombre falso era “Tuclifo”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "¡Clitofo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410114,
					"content": "... Ah, no... Clitofo es el nombre real, no el falso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410115,
					"content": "Entonces “Tuclifo” es el nombre falso... ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "No... Espera... ¡Sí! Se apropió de mi nombre, así que ahora Clitofo es un nombre falso. ¿Ya quedó claro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410117,
					"content": "Oh... Así que “Tuclifo” se convirtió en un nombre real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Qué pena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410120,
					"content": "Confesaste sin que tuviéramos que insistir demasiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410121,
					"content": "Llevémonoslo, la Geoarmada tendrá muchas preguntas que hacerle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410122,
					"content": "También podríamos encargarnos de él aquí y ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410124,
					"content": "¡Eh! No es momento de bromitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410125,
					"content": "Jeje, jejeje. A Paimon le hizo mucha gracia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "P-pero si no te estás riendo. Y no, ¡no tiene nada de gracioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410127,
					"content": "Tienes razón, hay que ponerse serios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "¡E-espera! ¡Tampoco es momento de interrogatorios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410129,
					"content": "No me parece buena idea esto de llevar de un lado para otro a un ladrón de tesoros al que le diste un susto de muerte. Mejor llevémoslo de vuelta al campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410131,
					"content": "¡Oigan! ¡Llévenme con ustedes! ¡Seguro que les soy muy útil! Al fin y al cabo... me echaron de los Ladrones de Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410132,
					"content": "Ahora solo soy alguien que aprendió la lección, ¡un ciudadano respetable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410133,
					"content": "Oh, ¿eso es ser un ciudadano respetable para ti?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "¿Y qué se te da bien entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410135,
					"content": "Humm... Por ejemplo... ¿hacer explosivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410136,
					"content": "¿No quisiste decir “medicamentos falsos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "No, no, dijo “hacer explosivos”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "¿No serán también explosivos falsos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410139,
					"content": "¡No, esta vez son auténticos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410141,
					"content": "No tengo autoridad para dejarte entrar al equipo. Jinwu tiene que decidir qué hacer contigo, pero supongo que te entregará a la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410142,
					"content": "Sin embargo, no te quitaremos el ojo de encima. No puedes confiar en los Ladrones de Tesoros, y mucho menos en uno que vende medicamentos falsos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710410143,
					"content": "Oh, vamos, ¡dije que no lo haré más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710410144,
					"content": "Oh, ¡ya nos hemos enterado! ¡Andando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "Tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
