			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "#Hola, viajer{F#a}{M#o}, me disculpo en nombre de mi primo, seguramente te haya traído un sinfín de problemas. Siempre ha tenido mucho carácter... pero te prometo que no tiene malas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Si se pasa de listo, no dudes en ponerle en su sitio. Y si se atreve a protestar, dile que se las verá conmigo si no obedece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
