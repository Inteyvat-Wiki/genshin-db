				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "Me disculpo por lo de antes, fue una falta de respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Oh, ¿el detective Heizou? Seguro que no soporta a la gente como yo, estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Aunque suena educado y amable, les puedo asegurar que tiene una actitud diferente con los presos acusados de estafa... Me da la sensación de que tiene algo especial en contra de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "¿Acaso también fue víctima de una estafa? Imposible, ¿quién sería capaz de engañar al detective Heizou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
