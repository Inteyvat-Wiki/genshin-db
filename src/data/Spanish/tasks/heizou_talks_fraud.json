			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Es mejor evitar que Heizou se enoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "¿Eh? ¿Quieren saber lo que sucedió? Bueno, en realidad no hay mucho que contar, de veras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Cuando me enteré de que era Heizou el que estaba investigando, supe que se había acabado. Fui por el camino fácil y lo confesé todo. Después de todo, ¿qué más se puede hacer cuando ves que un “ciclón” está a punto de arrollarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "¿Un “ciclón”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Es el apodo de Heizou, todos los prisioneros lo llaman así, ¿no lo habías oído antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "No hay escapatoria, ni lugar donde poder esconderse... Para los delincuentes, Heizou es como una fuerza de la naturaleza que nadie puede detener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "En fin, si lo hubiera sabido antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
	]
