	"talks": [
		{
			"id": 2005801,
			"completionStepIds": [
				2005801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
