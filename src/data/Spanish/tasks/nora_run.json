				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "¿Qué piensas hacer allí arriba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "La señora Grace dice que, si quieres susurrarle algo a alguien, solo tienes que decírselo a un diente de león y soplarlo. El Arconte Anemo llevará el diente de león a los oídos de esa persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "Cuanto más alto sea el lugar donde lo liberes, más rápido llegará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Glory le pidió a un aventurero que fuera a la estatua del Arconte Anemo a liberar un diente de león. ¡Y después de unos cuantos días, Godwin le respondió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Yo también tengo un secreto para papá, y tengo un diente de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Pero la señora Grace no me deja hacerlo... Dice que cuando sea grande podré reunirme con papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "¿Qué puedo hacer para crecer más rápido? De verdad entreno duro, pero sigo sin mejorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Humm... Te vi volando alrededor de la ciudad. ¿Puedes enseñarme a volar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Jiji. Entonces, te veré desde aquí. Al menos, la señora Grace sí me deja hacer eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "¿Quieres que volemos juntos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "¡De ninguna manera! La señora Grace enloquecería si me ve volando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
