			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Lamento molestarte de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "No hay problema, me han tratado bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Es bueno saberlo. Entonces, seré breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Estamos muy agradecidos por los encargos del Gremio que has completado hasta la fecha. La reputación del Gremio de Aventureros se ha fortalecido más por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Pero, como consecuencia, estamos recibiendo una cantidad sin precedentes de encargos, más de lo que los aventureros pueden aceptar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "¿Quieres que reclutemos gente por ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Eh... no. Aprecio la oferta, sería fantástico tener algunos nuevos miembros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Pero a estas alturas, gastar tiempo en encontrar nuevos reclutas no resolvería nuestros problemas inmediatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Mi pregunta es: ¿tus amigos tienen tiempo para ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Necesito consultar con ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Genial, por favor hazlo. ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "Actualmente hay una <color=#00E1FFFF>expedición</color> urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "¿Expedición?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Organizamos expediciones para explorar áreas alrededor de la ciudad y en la naturaleza. Es una forma de mantenernos informados de peligros inminentes, actividades inusuales en los dominios, etcétera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Como las expediciones no son encargadas por terceras partes, no hay un plazo para completarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Pero si las ignoras es bajo tu propio riesgo. Si los problemas se acumulan sin control, podrían tener consecuencias desastrosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "¡Entonces son bastantes importantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "#Estoy segur{F#a}{M#o} de que mis amigos lo entenderán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Lo único que tienes que hacer es convencerlos de que te ayuden. Yo me ocuparé del resto de los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "Ahora, sin más preámbulos, déjame mostrarte las expediciones que están disponibles actualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Confirmar expedición",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "¿Qué hay de la recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "No te preocupes, el Gremio no se lleva el botín de las expediciones. Todo va para ti y tus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "¿Quieres que convenza a todos mis amigos para que se unan al Gremio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "No, no, eso no es lo que quise decir. Sé que tus amigos están ocupados con otras cosas, y pedirles que se conviertan en miembros no sería práctico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "Mi petición es un poco atrevida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "¿Hay una nueva recompensa para mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "#Jajaja, ¡bingo! Y supongo que estás interesad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Puedes enviar a cualquiera de expedición en cualquier momento, y podrán unirse en tus aventuras si los necesitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "También puedes escoger cuánto durará la expedición. Cuando tu amigo regrese, solo ven conmigo y confirma el resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "A medida que aumente tu Rango de Aventura, tendrás a tu disposición expediciones más peligrosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "¡Un gran poder conlleva una gran responsabilidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Y, por supuesto, por la seguridad de todos, el nivel de riesgo coincide con la experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "De nuevo, gracias por tu ayuda. Espero que tú y tus amigos puedan ayudar con nuestras expediciones tanto como sea posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}