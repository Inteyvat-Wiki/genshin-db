				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "Muy buenas, Sra. Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Vaya, vaya, qué pronunciación tan perfecta. Supongo que tenemos una amistad en común, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "La Srta. Colombina me recomendó sus servicios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "Esa señorita es de lo más impredecible. Estoy segura de que su encuentro también estuvo lleno de sorpresas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "En eso estoy de acuerdo. “Impredecible” es la palabra perfecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Encantado de conocerla, mi nombre es Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "El duque que custodia las profundidades submarinas. Un gusto conocerlo en persona, señor alcaide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "No esperaba que una de las grandes brujas como usted hubiera oído hablar de mí. Es todo un honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "¿Será que en su astrolabio ya había previsto mi llegada, Sra. Trismegistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Jiji, puesto que ambos conocemos la identidad del otro, ahorrémonos las formalidades. Puede llamarme Barbeloth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "Entonces llámeme Wriothesley. Esto no es ningún asunto oficial, así que no necesitamos títulos. Solo soy un ciudadano más de Fontaine que está disfrutando de su tiempo libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "De camino aquí me crucé con unas caracolas de cristal recién horneadas. He oído que a las brujas les encanta organizar horas del té, así que tome una, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Oh, este es sin duda un postre muy popular en nuestra hora del té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "Llevo una temporada aquí y he hecho predicciones a muchas personas, pero es la primera vez que alguien me trae un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Gracias, Sr. Wriothesley. Lo compartiré con Alice y las demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "¡Lo he escuchado, Barbie! ¡Tienes que dejarme alguna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "No dejes que Nicole se lo coma todo antes de que yo llegue. ¡No es la primera vez que lo hace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "*¡Ejem!*. Que sí, que sí. Me aseguraré de que te guarde algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Podrías haber aparecido en otro momento, ¿sabes? Estoy aquí tratando de mantener la reputación del Aquelarre frente a nuestro nuevo amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "No pasa nada. ¿Qué tiene de malo? Las personas poderosas no tienen por qué estar serias todo el tiempo. Todos tienen derecho a mostrar un poco de personalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "¡Exacto! Ser optimista y alegre es uno de los requisitos para entrar en el Aquelarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "¿Ah, sí? Pues es la primera vez que lo oigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "¡Es una regla que se me acaba de ocurrir! El Aquelarre está aquí para traer alegría al mundo, ¡así que lo lógico sería que nosotras fuéramos las primeras en ser optimistas y alegres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "A título personal, apoyo que cada quien disfrute de la vida como le plazca... siempre y cuando no se infrinjan las leyes, por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "Esa condición es nula para Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Vaya, eso sí que es preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "¡Oigan, que sigo aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "De todas formas, no planeaba hacer nada ilegal delante del alcaide del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "Y aunque lo hiciera, me imagino que sus salas de confinamiento serán mucho más espaciosas que las de los Caballeros de Favonius, ¿verdad que sí, Sr. Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Jaja, ¿acaso una simple sala de confinamiento podría retener a una bruja tan legendaria como usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "El hecho de que acepte el castigo de buen grado solamente demuestra que es una persona humilde y fiel a su palabra, Srta. Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Exacto. No puedo estar más de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Basta, Sr. Wriothesley. No creo que sea buena idea continuar animándola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Cuando Alice está de buen humor, es capaz de hacer cualquier cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "Efectivamente. Lo sé por experiencia propia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#¡Eso! {NICKNAME} es {F#la Caballera Honoraria}{M#el Caballero Honorario}, ¡así que debe defender la dignidad de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "#¿Eso quiere decir que le va a tocar {F#a la Caballera Honoraria}{M#al Caballero Honorario} perseguir a las brujas que se quieren escapar? Sería todo un espectáculo. Por favor, no olviden invitarme para verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "¡Tú lo que quieres es ver el drama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Paimon no se esperaba que vinieras por tu cuenta, Wriothesley. ¡Nos ahorraste un viaje bajo el agua para ir a buscarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "Ese es el poder de la adivinación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "Por cierto, tenemos una misión que cumplir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Sr. Wriothesley, ya sea por consideración hacia la Srta. Colombina o como agradecimiento por los dulces que nos trajo, por favor, escoja un Arcano lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Quizás haya un obsequio del destino oculto entre alguno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "¿Esto cuenta como una especie de profecía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "Podría decirse que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Entonces supongo que nadie de Fontaine se lo tomaría a la ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Dicho esto, Wriothesley toma la primera carta de la baraja sin más...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "No sé mucho sobre estas cartas, pero esta parece que es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "El Emperador al derecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "Parece que se ha quedado sin palabras... ¿Acaso es algo malo? No se preocupe, puede decírmelo sin rodeos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "Todo lo contrario. Esta carta representa un dominio eterno y una autoridad inquebrantable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "Si esta carta representa su futuro, entonces en realidad ya ha llegado a su destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "Sin embargo... Jejeje, su destino seguirá avanzando y cambiando constantemente, lo que significa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Quizá no sea la persona quien esté cambiando, ¿sino el entorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Mhm. Al menos por ahora, esa parece ser la tendencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Entonces supongo que a partir de ahora puedo confiar un poco más en mi intuición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "Estuve visitando Nod Krai por asuntos oficiales, y la verdad es que fue toda una experiencia. Desde entonces, he estado al tanto de lo que sucede por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "Y una noche, mientras contemplaba una luna extraordinariamente brillante, no pude evitar pensar que este mundo estaba cambiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "El mundo está en constante cambio, pero con la aparición de variables tan inmensas, todos debemos estar preparados para enfrentar lo desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "No obstante, según la carta que ha sacado, no tiene por qué preocuparse demasiado. Da igual cómo cambie el entorno, usted posee la capacidad de adaptarse a él o de hacerle frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "¡Buenas noticias! Parece que ese puñetazo no fue en vano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "Fue un puñetazo cargado de buenos deseos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "Por curiosidad, tengo una pregunta bastante atrevida que me gustaría hacerles, si no les importa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "¡Qué astuto! Está intentando despertar nuestra curiosidad a propósito, Sr. Wriothesley. Ahora no nos queda más remedio que insistir en que pregunte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "Voy a serles sincero, entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "Siempre he querido saber una cosa: ¿cómo se puede garantizar que una profecía se cumpla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Pongamos mi caso como ejemplo. La adivinación dice que me mantendré estable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "Pero ¿y si al escuchar esa profecía me viniera a la mente una idea rebelde e hiciera algo imprudente? ¿Qué pasaría entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "Como, por ejemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "¿Volar el Fuerte Merópide por los aires?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Sí, por ejemplo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "¡¿Todavía sigues pensando en eso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "¡Ooooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "Alice, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "¡Jaja! ¡Pero qué bonita coincidencia! Resulta que conozco a una experta en explosivos de lo más competente. Nunca me cansaré de recomendarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "#Pero entonces {F#la Caballera Honoraria}{M#el Caballero Honorario} tendría que estar a su lado, ¡interviniendo en el momento justo para evitar que ocurra cualquier desastre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "... ¿Lo ve? Así es como se cumple la profecía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "Parece que es toda una experta en destrucción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "Y, además, es superadorable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "Ah, ¿estamos hablando de Klee? A lo mejor no lo sabes, Wriothesley, pero Klee es la hija de Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Bueno, en realidad, yo creo que el título completo debería ser: hija de la gran aventurera de muchos mundos, la malvada Rey Dodo, la guardiana de la antigua Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "¡No tenemos tiempo para eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "Está bien... Es la hija más adorable de Alice, la malvada Rey Dodo, la auténtica Caballera Chispeante: ¡Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Sinceramente, tendríamos que haber seguido el plan original y organizar una fiesta espectacular para todos. Así se podrían conocer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "Así, cuando Klee venga a Fontaine, podrá hacer nuevos amigos con quienes disfrutar de la hora del té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "Suena maravilloso. Ya estoy deseando que llegue el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "Después de todo, yo nunca le diría que no a una buena taza de té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "Lo que no te mata te hace más fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Les pido que mantengan el debido respeto por la sala de confinamiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
