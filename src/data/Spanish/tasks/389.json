			"dialogs": [
				{
					"id": 3890601,
					"content": "No podemos avanzar más. Parece que las ruinas están protegidas por unos <color=#00E1FFFF>sellos</color> antiguos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "¿Será obra de Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "No. Estas ruinas fueron parte de una ciudad antigua en el pasado. Es mera coincidencia que Dvalin se resguarde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Estas ruinas son incluso más antiguas que los Cuatro Vientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt es una ciudad sin rey. Pero antes de eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Fue gobernado por un tirano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "En fin... Les cantaré esa historia más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Las marcas en este sello... Si mi conocimiento en arqueología no me falla, se trata de un <color=#00E1FFFF>accionador de luz</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Si ponemos de vuelta las <color=#00E1FFFF>piezas faltantes</color> en el <color=#00E1FFFF>accionador de luz</color>, podemos llevar a cabo una <color=#00E1FFFF>ceremonia de luz</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Estamos a punto de activar el mecanismo para la ceremonia de luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Pongamos primero la <color=#00E1FFFF>última pieza</color> para ver qué pasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
