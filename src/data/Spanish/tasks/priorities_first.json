			"dialogs": [
				{
					"id": 760000201,
					"content": "Humm... Parece que esta puerta no se puede abrir, pero Paimon tiene muchísima curiosidad por saber qué hay dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000202,
						760000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000202,
					"content": "Probablemente no sea nada importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "Sí. Por la ubicación, no parece que hayan guardado algo muy importante por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "En cualquier caso, ¡intentemos entrar a ver qué hay! Si no, este misterio seguirá molestando a Paimon, como cuando come demasiados perritos calientes de Nod Krai y no los puede digerir. ¡Es horrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "Aunque esta puerta no se abra, tal vez haya otra forma de entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "¿Y si están haciendo experimentos malvados ahí dentro?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "E-experimentos malvados... De ser así, ¡entonces se han relajado mucho con la seguridad de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
