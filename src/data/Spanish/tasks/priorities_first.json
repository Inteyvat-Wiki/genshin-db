			"dialogs": [
				{
					"id": 760000601,
					"content": "¡Hay un montón de frascos! Y dentro... ¿será kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000602,
					"content": "¿Qué estarán planeando los Fatui para guardar todo esto tan profundo bajo tierra?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000603,
						760000605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000603,
					"content": "Pues, obviamente, es para usarlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000604
					]
				},
				{
					"id": 760000604,
					"content": "¡Eso Paimon ya lo sabe! Pero ¿para qué exactamente? Paimon no cree que sea para darse un baño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000607,
					"content": "#{NICKNAME}, investiguemos por aquí primero. ¡A lo mejor encontramos alguna pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000605,
					"content": "¡Seguro que están haciendo algún experimento malvado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000606
					]
				},
				{
					"id": 760000606,
					"content": "Bueno, ¡ya sabemos que los Fatui no son trigo limpio! Pero ¿qué clase de experimento malvado puede ser?",
