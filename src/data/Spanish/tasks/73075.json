			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} y Paimon, gracias. Jardines de Vanarana ahora tienen muchas, muchas viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "Viparyas están felices. ¡Y Arakara también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "#Festival Utsava ya terminó. Antes de que nara rubi{F#a}{M#o} se vaya de Vanarana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "Recibes una viparyas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#¡Una viparyas feliz para nara rubi{F#a}{M#o}! Espero que nara {NICKNAME} y Paimon también sean felices. Viparyas no se marchita, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "No olviden hablar con viparyas a veces, o poner música para ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#Tierra y aranara nunca olvidarán. Deseamos que nara {NICKNAME} y Paimon no olviden tampoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
