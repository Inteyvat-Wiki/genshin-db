				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "#¿Qué tal? ¿Estás cómod{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "¡Ah! ¡Qué susto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Oh, cuánto lo siento. No pretendía asustarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Me llamo Kabayama y suelo sentarme en el lugar donde tú estás ahora. Es un buen lugar donde relajarse y pensar en la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "¿Quieres recuperar tu sitio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Gracias, pero no es necesario. Por cierto, no tienes pinta de ser por aquí, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Es verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Entonces debes de haber visto muchas cosas. Yo nunca he visto el mundo exterior, pero tengo mucha experiencia haciendo mudanzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "*Suspira*, hablando de mudanzas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Nuestras mudanzas son tan frecuentes que cuando era pequeña nunca tuve la oportunidad de hacer amigos de verdad. Vi tantos paisajes increíbles que no pude compartir con nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "¿Sabes qué? Podría mostrarte esos lugares. Si pasas por ellos, siéntate un momento. Luego, vuelve y cuéntame lo que viste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Uno de esos sitios es la puerta de piedra que hay en el punto más alto del Desfiladero. Otro es un espacio rodeado de corales cerca del Templo de la Noche Infinita, y el último se ubica al lado de un pilar en ruinas muy alto en el Corazón de la Serpiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Dejé marcas en todos esos lugares y colgué linternas para iluminar el camino. Seguro que los encontrarás fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
