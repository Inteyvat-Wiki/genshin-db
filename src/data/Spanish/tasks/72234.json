					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Ah, volviste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "¿Todavía no pudiste encontrar todos los lugares? ¡Qué pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Detallaré las ubicaciones de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Uno de esos sitios es la puerta de piedra que hay en el punto más alto del Desfiladero. Otro es un espacio rodeado de corales cerca del Templo de la Noche Infinita, y el último se ubica al lado de un pilar en ruinas muy alto en el Corazón de la Serpiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "Dejé marcas en todos esos lugares y colgué linternas para iluminar el camino. Seguro que los encontrarás fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
