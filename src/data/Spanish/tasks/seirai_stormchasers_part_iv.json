				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "La tempestad... se calmó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580102,
					"content": "Parece que las cuatro piedras sagradas fueron selladas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "¡Eres tú! ¿Cómo llegaste aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580105,
					"content": "Taisuke dijo que pasaste a través de una especie de portal y que desapareciste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580106,
					"content": "¿Qué era esa puerta? Todo es muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580107,
					"content": "¿Qué demonios pasó allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Etsuko y yo escuchamos un rugido que venía de arriba. Sonaba casi como un trueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "Pero es obvio que la tempestad se detuvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Esto fue lo que pasó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Piedras flotantes que formaron una plataforma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Eso es... inaudito. Nunca había oído de tal fenómeno en la Isla Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "Nada de eso suena a un fenómeno natural...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580114,
					"content": "No importa cómo lo mires... es un fenómeno sobrenatural...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580115,
					"content": "Estoy de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Natural o no, la tempestad eléctrica sobre la Isla Seirai se ha calmado, y hemos terminado con nuestro encargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580118,
					"content": "También encontramos una pluma extraña...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Esta es... Taisuke, tienes que ver esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580120,
					"content": "Bien, veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Lo siento, no tengo idea de dónde viene esta pluma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "El patrón y su textura no son como la de ningún pájaro que haya visto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "Y si observas sus dimensiones y proporciones, esta ave debe ser tan grande como la misma plataforma de piedra flotante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "¿Tan importante es esa pluma? Si quieres averiguar más sobre ella, ¿por qué no publicas un encargo en el gremio? ¿Quién sabe? Tal vez encuentres a alguien que pueda darte una pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580125,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "#Bien, en ese caso, gracias por tu ayuda, aventurer{F#a}{M#o}. Taisuke y yo regresaremos al gremio para entregar el informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580128,
					"content": "Por cierto, no es mucho, pero supongo que te debemos algo por la ayuda que nos brindaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, guarda tus cosas. Volvemos al gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580130,
					"content": "Entonces... Etsuko, ¿podemos ir al santuario a ver a la señorita Neko? ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "... Taisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580132,
					"content": "¡Vamos! Es una gata que puede hablar, ¡una gata que habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "*Suspira*... En serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580126,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Tienes razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}