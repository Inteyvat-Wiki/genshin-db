			"dialogs": [
				{
					"id": 120190101,
					"content": "¿Sí? ¿Querías hablar de algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Sobre la leche de dango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "No me cabe duda de que disfrutó al máximo de esa bebida. Estoy segura de que no le pudo poner más contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Lo que realmente quiso decir era: “¿Cuándo crees que podrías abrir una sucursal en el plano de la eutimia?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Cuéntame sobre la “Shogun Raiden”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "La marioneta, ¿cierto? He oído que cambiar el funcionamiento de una marioneta es extremadamente difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Es muy probable que esta sea la primera vez en la historia que alguien se enfrenta a algo así. Creo que puedes imaginarte lo difícil que debe de ser, ya que es algo que ha desconcertado incluso a la sabia y poderosa Ei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Este es un problema que ni siquiera el Filo del pensamiento vacío puede resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "¿Qué hay de las novelas ligeras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "¿No te parece divertida la idea de que alguien renazca como la Shogun Raiden? Eso es lo que se supone que son las novelas ligeras: algo divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Para ella, en cambio... Probablemente sean demasiado vanguardistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Oh, tal vez debería encargar una secuela: «Renací como la Suma Sacerdotisa». ¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}