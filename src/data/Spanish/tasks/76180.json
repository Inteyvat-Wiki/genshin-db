			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "Es muy divertido jugar a estos juegos. Espero poder hacerlo más a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800802,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800804,
					"content": "¿Ya te vas? Está bien, hasta la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800803,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
