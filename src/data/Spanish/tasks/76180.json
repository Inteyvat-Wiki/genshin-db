			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Colombina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "¿Qu-qué? ¡Eso es imposible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800602,
					"content": "Parece que perdiste, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800603,
					"content": "¡Yo... te dejé ganar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800604,
					"content": "¿En serio? Entonces, ¿por qué pareces tan alterada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800605,
					"content": "Maldición... ¡Quiero la revancha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800606,
					"content": "Hum, pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800607,
					"content": "Tú ganas. De verdad eres muy hábil, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800608,
					"content": "La próxima vez juguemos a algo más difícil. Conozco un montón de juegos matemáticos divertidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800609,
					"content": "¡Suena emocionante! Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800610,
					"content": "¿Qué es tan gracioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800611,
					"content": "Rara vez te he visto tan feliz. Casi nunca me invitabas a jugar. Normalmente, solo me echabas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800612,
					"content": "Oye... ¡No me hagas parecer una matona! A partir de ahora te invitaré a más horas del té, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800613,
					"content": "Me encantaría. Me gustan estas pequeñas reuniones, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
