			"dialogs": [
				{
					"id": 761800401,
					"content": "Antes siempre nos reuníamos en tu jardín, Sandrone. Ahora eres tú quien viene a visitarme a tomar el té. Es una sensación muy extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800402,
					"content": "Sigo siendo yo quien lo prepara todo. A mí no me parece que haya cambiado mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800403,
					"content": "Mhm, y tu comida sigue siendo tan deliciosa como la recordaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800404,
					"content": "#Humm... He oído que {NICKNAME} te visita bastante a menudo. ¿Qué suelen hacer junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800405,
					"content": "A veces charlamos, otras jugamos con las kuuhenki, y también nos gusta verlas dibujar. Ah, y también jugamos a las damas lunares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800406,
					"content": "¿Las damas lunares? ¿Es ese juego en el que hay que intentar alinear tres piezas? ¿Quién suele ganar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800407,
					"content": "#No llevo la cuenta, pero tengo que decir que {NICKNAME} es muy buen{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761800408,
					"content": "Je, yo te enseñaré lo que es ser bueno de verdad. ¿Te animas a jugar una partida? Si empatamos, lo consideraremos como que has ganado tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800409,
					"content": "Claro. ¡Juguemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
