				"points": []
			},
			"dialogs": [
				{
					"id": 742490201,
					"content": "¡Ahhh! Nunca me cansaré de las tranquilas horas del té de la tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490204,
					"content": "Vaya, vaya... El tiempo vuela cuando uno se divierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
