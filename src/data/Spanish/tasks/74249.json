				]
			},
			"dialogs": [
				{
					"id": 742490101,
					"content": "Me siento fatal por dejarte todo el trabajo a ti otra vez, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "No es nada. Es lo mínimo que puedo hacer después del apoyo que me brindaste durante el Festival Fontinal Kinográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490103,
					"content": "¡Por favor! Los actores fueron los verdaderos protagonistas del espectáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "¿No tienes pensado volver a actuar, Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490105,
					"content": "Bueno... Nunca digas nunca... Pero, por ahora, prefiero trabajar tras bastidores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "A decir verdad, cuando aún vivía en Fontaine, hasta yo sabía quién eras: Furina, la superestrella querida por todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490107,
					"content": "¡Ay, por favor, no! No digas que creciste viendo mis actuaciones... Me hace sentir muy incómoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Oh, no tienes por qué preocuparte por eso. Solo quería decirte que, cuando me fui de Fontaine, tuve el honor de verte tal y como eras en aquel entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490109,
					"content": "Pero al volver a verte después de tanto tiempo, creo que me gusta más tu forma de ser ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490110,
					"content": "¿Eh? ¿Mi forma de ser ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Sí. Antes parecías muy tensa en el escenario, pero últimamente te veo mucho más relajada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490112,
					"content": "Jaja... Gracias por decirlo. La verdad es que últimamente estoy disfrutando mucho más de la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "¿Y tú, Srta. Guillotin? ¿Estás contenta con tu estilo de vida actual? Me refiero a en comparación con cuando te marchaste de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Todo va bien, aunque supongo que eso se debe sobre todo a que he cambiado mi forma de ver las cosas. La verdad es que siempre me ha gustado Fontaine y siempre lo he sentido como mi hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490115,
					"content": "No digo que sea mejor que otras naciones, pero me trae muchos recuerdos. La vida aquí puede ser tan tranquila como el agua en calma, pero también puede estar llena de cambios inesperados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490116,
					"content": "Hace poco aprendí a ver el lado positivo de la vida. Supongo que la gente de otros lugares ve su tierra natal más o menos de la misma manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490117,
					"content": "Vaya... Qué bien lo has expresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Quizá esto suponga una pequeña falta de protocolo en una hora del té, pero... propongo un brindis. ¡Por Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Jaja... Por nuestra tierra natal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 7424902,
