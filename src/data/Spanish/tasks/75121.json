			"dialogs": [
				{
					"id": 751210101,
					"content": "Me pidieron venir por dos libros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Le describes a Kuroda los libros descatalogados que quería Citlalí.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "La primera edición de «La todopoderosa Shogun: renacida como Raiden con un poder ilimitado» y la edición limitada de «Se lo ruego, Suma Sacerdotisa»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Tengo que decir que esa amiga tuya es toda una profesional y, en lo que se refiere al valor de colección, ninguno de los libros actualmente publicados por la Editorial Yae se puede comparar a estos dos ejemplares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Es una pena que no conozca a la lectora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "¿Aún puedo conseguirlos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Ya es imposible encontrar cualquiera de estos libros en el mercado, por no mencionar que hace tiempo que se agotaron las existencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Sin embargo, resulta que conservo aquí un ejemplar de cada uno de ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Te los puedo comprar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "No, no, estos dos volúmenes estarán mejor en manos de tu amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Permíteme regalártelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
