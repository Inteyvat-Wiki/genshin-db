			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "Ay, ¡qué dolor de cabeza! ¿Qué se supone que debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "¡Estoy entrenando para las pruebas de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530104,
					"content": "*Suspira*, pero no soy tan poderosa como Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530105,
					"content": "Creo que es mejor para mí centrarme en la técnica en lugar de la fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530106,
					"content": "Por ejemplo, estaba pensando en cómo romper todos estos maniquíes de madera de un solo golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530107,
					"content": "Si tienes tiempo libre, ¿me ayudarías a pensar cómo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530108,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Claro, tómate tu tiempo. Después de todo, estos maniquíes no irán a ningún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530111,
					"content": "Tampoco mi vida va a ninguna parte mientras esté atrapada tratando de resolver esto. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530114,
					"content": "A esta distancia, tal vez la mejor solución sería hacerme cargo de un lado y lanzar una bomba al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530115,
					"content": "Jaja, solo bromeo. De todos modos, no tengo idea de dónde conseguiría una bomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530109,
					"content": "#¿Qué tal si lo intentamos junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "¿Así que te gusta el combate en equipo? Es bueno tener siempre a alguien que te apoye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530113,
					"content": "Para personas como yo, lo mejor que pueden hacer es intentar subsistir como luchadores solitarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2005302,
