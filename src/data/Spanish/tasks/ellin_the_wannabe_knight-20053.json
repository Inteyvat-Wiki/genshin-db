					"content": "¿Eh? Nunca pensé en intentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530303,
					"content": "¡Gracias! Lo intentaré ahora mismo.",
