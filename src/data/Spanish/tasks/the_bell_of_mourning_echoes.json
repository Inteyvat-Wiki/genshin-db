			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sújovij"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "¡Disculpen! A Paimon le gustaría preguntarles algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Les muestran a los soldados ratnik los objetos que encontraron antes, y les cuentan cómo lucharon contra la Cacería salvaje junto a un hombre extraño ataviado con el uniforme de los Lampareros...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "¿Será Sigurd? Él... no ha logrado descansar en paz hasta el momento. Si pudiera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "No digas eso, no es solo responsabilidad tuya. Mientras la Cacería salvaje exista, él no dejará de luchar... Lo único que podemos hacer es poner todo nuestro empeño en llevar a cabo nuestra misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sújovij"
				},
				{
					"id": 760010105,
					"content": "Entonces, Sigurd también fue Lamparero, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Sí, fue un gran starshiná. Luchó valientemente hasta el último momento cuando el ejército de la Cacería salvaje invadió Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sújovij"
				},
				{
					"id": 760010107,
					"content": "Dicen que cuando sonaba la campana de alarma, los monstruos que habían perdido la razón quedaban aterrorizados y no se atrevían a seguir avanzando... No imaginaba que ustedes dos encontrarían sus pertenencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sújovij"
				},
				{
					"id": 760010108,
					"content": "Si pueden, coloquen estos objetos frente a su tumba, en las ruinas del campo de batalla al este de la Isla Lempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sújovij"
				},
				{
					"id": 760010109,
					"content": "Puedes dejarlo en nuestras manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Gracias. Espero que el día en que su alma pueda descansar en paz llegue pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sújovij"
				}
			]
		},
