					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Sr. Kayvan, inténtelo de nuevo con el nuevo modelo de cebo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Ya lo intenté muchas veces, ¡el resultado siempre es el mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "¿Eh? ¿Por qué están pescando juntos otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "#Viajer{F#a}{M#o}, nos encontramos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Son ustedes dos, ¡hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "¿Descubriste por qué no lograbas pescar ni un pez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "¡Jaja! En absoluto. El erudito y yo probamos de todo, mejoramos tanto las cañas como los anzuelos y hasta la técnica de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "También cambiamos no sé cuantas veces de zona y de forma de abordar el problema... Incluso me hizo pescar en un estanque repleto de peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Pero no importa lo que haga, ¡siempre acabo pescando cosas que no son peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "No se preocupe, Sr. Kayvan. ¿No le prometió aquel erudito que seguiría investigando? Seguro que averiguará el motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Mire, hasta le diseñó nuevos modelos de cebos. También me mandó acompañarle y registrar cada detalle de sus intentos de pesca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Espero que de verdad pueda averiguar el motivo... Pero hasta entonces, seguiré pescando a mi manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "#Viajer{F#a}{M#o}, si tienes tiempo, ¿podrías buscarme otra vez más materiales para los cebos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "¿Te sirvió de algo ir a preguntar al erudito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
