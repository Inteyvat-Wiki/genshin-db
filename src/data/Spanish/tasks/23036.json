			"dialogs": [
				{
					"id": 230360601,
					"content": "¡No está nada mal! ¡Y ahora a pescar! ¡Seguro que esta vez pica uno de los grandes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360602,
					"content": "Kayvan prepara el cebo y empieza a pescar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "Poco después, Kayvan pesca una caja empapada...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "Esto... Deja que eche un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360605,
					"content": "¿Eh? Parece que el contenido es otra vez un objeto perdido o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360606,
					"content": "Típico de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "Uff... Hemos estado pescando al aire libre desde que acompañé al Sr. Kayvan a ver al erudito para mejorar los cebos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360609,
					"content": "Pero cada vez que el Sr. Kayvan pesca algo... siempre se trata de alguna cosa rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360610,
					"content": "Entre ellas hay objetos perdidos, minerales del lecho del río, paquetes que se cayeron por la borda de alguna embarcación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360611,
					"content": "Incluso una vez, hubo un aventurero que se había caído al río por descuido que usó el sedal del Sr. Kayvan para trepar a la orilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360612,
					"content": "Pero peces, no pica ni uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360613,
					"content": "Mi vida de pescador está acabada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360614,
					"content": "N-No se desanime, Sr. Kayvan... Mire, el propietario de este objeto perdido seguro que está muy angustiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360615,
					"content": "¡Se pondrá muy contento cuando sepa que usted lo recuperó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360616,
					"content": "Llevemos estos objetos perdidos al Gremio de Aventureros. ¡Quién sabe si podemos obtener una recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360617,
					"content": "¡Pero...! ¡De verdad! Yo solo quiero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360618,
					"content": "¡Pescar un pez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360607,
					"content": "¿“Otra vez”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				}
			]
		},
