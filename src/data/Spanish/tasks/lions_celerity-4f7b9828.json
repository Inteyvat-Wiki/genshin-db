						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Otra vez en este lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "La última vez que vinimos, si lo medimos en vidas humanas, fue hace muchas, muchas, muchas generaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Parece que nos han vuelto a enviar a la Cámara de la Apatía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "¿Y cómo vamos a salir de aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "La forma normal de salir sería a través de la meditación... aprendiendo a controlar la mente y los pensamientos, y dejando ir todo deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Para así mantener un estado de completa apatía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Suena sencillo, pero dependiendo de la naturaleza de una persona y la fuerza de sus deseos, podría requerir desde unos cuantos años a varios siglos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Para alguien como tú, que lleva a cuestas el destino del mundo, sería difícil deshacerse de esos deseos... y no creo que sea algo que debieras hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "¿Qué hacemos entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Encontremos a Zeitlind y ya buscaremos la forma de lograrlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761480712,
					"content": "¿Qué has recogido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Un momento, ¿Diestrín también se ha visto arrastrado dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "En ese caso, puede que aún tengamos una oportunidad de cambiar las tornas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Como Diestrín también es un Vigilante, debería poder usar el poder que contienen estos fragmentos para abrir a la fuerza un camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Deberíamos ponerle un nombre a este tipo de fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "He oído hablar de unos ataúdes de lo más recargados. Los colocó una de las hermanas de la Señora del Santuario. Ataúdes del Maranasati, creo que se llamaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Así que podemos llamarlos fragmentos del pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
}