				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "No esperaba que el ambiente aquí fuera tan peculiar... En ese caso, el sistema de alimentación del Clavo de Pursina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010202,
					"content": "#¿Eh? ¡{NICKNAME}! ¡Paimon! Cuanto tiempo sin vernos. ¿Qué hacen ustedes en la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010203,
					"content": "Ahora que me acuerdo, Khedive dijo que le fuiste de gran ayuda al equipo de espeleología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010204,
					"content": "El problema es que el ambiente en la Sima se ha vuelto aún más peligroso que antes. No es un buen lugar para dar un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010205,
					"content": "¿Quién eres tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "¿No nos conocimos hace poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010207,
					"content": "Ya sé que siempre que nos vemos te pido ayuda, pero no es razón para fingir que no me conoces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010208,
					"content": "Olvídalo. Mejor me vuelvo a presentar. Soy Hosseini, investigador de la Academia de Sumeru. He estado trabajando en un amplificador de energía e incluso viajé a Inazuma para llevar a cabo algunas investigaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010209,
					"content": "Pero me quedé sin fondos para continuar mi investigación, así que me vi obligado a regresar a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010210,
					"content": "Oh, Paimon cree recordarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010211,
					"content": "¿Ya te acuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010212,
					"content": "¡Eres el hombre del amplificador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010213,
					"content": "... Estoy seguro de que nunca me he presentado con ese nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010214,
					"content": "En cualquier caso, estaba de camino a Sumeru cuando recibí un encargo de un colega de la Academia, Khedive. Él me brindó su apoyo en el pasado para financiar algunas de mis investigaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010215,
					"content": "Así que aquí me tienen en la Sima, ayudándolo a resolver este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010216,
					"content": "Espero que mi explicación haya sido lo suficientemente clara. ¿Y ustedes? ¿Qué hacen en la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010217,
					"content": "También recibimos un encargo de Khedive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "¡Ah, así que se trataba de ustedes! Cuando Khedive dijo que buscaría ayuda, la verdad es que me preocupé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010220,
					"content": "Pero si se trata de ustedes, me quedo más tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010221,
					"content": "Ocuparme yo mismo del fango oscuro de la Sima me llevaría mucho tiempo y esfuerzo. Con su ayuda, la probabilidad de encontrar una solución es mucho más alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010222,
					"content": "¿Qué necesitas que hagamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "¿Has oído hablar de los Clavos de Pursina? Son unos dispositivos capaces de interrumpir el flujo de energía de las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010224,
					"content": "Según mis especulaciones, el fango oscuro puede eliminarse colocando un Clavo de Pursina en el punto exacto de donde brota el fango para interrumpir el flujo de las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010225,
					"content": "¿Pero qué relación tienen el fango oscuro y las líneas ley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010226,
					"content": "Verás, el fango oscuro apareció como resultado de las anomalías en las líneas ley, así que es muy probable que guarden algún tipo de relación. Al menos eso es lo que Khedive y yo pensamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010227,
					"content": "Por eso, podemos usar el Clavo para interrumpir, o incluso cerrar, el flujo de las líneas ley. Eso detendría el fango oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010228,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "Ya intentamos usar los Clavos de Pursina para interrumpir las líneas ley en el pasado, pero es la primera vez que los estamos utilizando para sellarlas por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010230,
					"content": "Hice algunos cálculos y ajusté los parámetros de los Clavos. En teoría, debería funcionar.",
					"roleType": "TALK_ROLE_NPC",
