							202.515
						],
						"pointId": 310701435
					}
				]
			},
			"dialogs": [
				{
					"id": 715010101,
					"content": "Humm... Parece que la situación ha empeorado en los últimos dos días. Esto afectará a las operaciones del equipo de espeleología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010102,
					"content": "¿Quién podría aceptar este encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010103,
						715010104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010103,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				},
				{
					"id": 715010105,
					"content": "#Oh, ¡{NICKNAME} y Paimon! Llegan justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010106,
					"content": "¿Justo a tiempo para qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010107,
					"content": "Parece que ocurrió algo importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010108,
					"content": "Por alguna extraña razón, últimamente una sustancia parecida a un lodo de color negro ha estado emanando de los túneles y minas de la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010109,
					"content": "Todo fue muy repentino, así que el equipo de espeleología todavía no tiene ninguna solución al problema. Las investigaciones se han detenido una y otra vez. Al final, Khedive ha decidido pedirle ayuda al Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010110,
					"content": "¿Eh? ¿Lodo negro? ¿Se estará refiriendo a eso que vimos en el subsuelo de la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010111,
					"content": "Sí, eso mismo. De alguna manera ha inundado las minas y túneles. El proceso de investigación del equipo de espeleología se ha visto afectado, y ni qué decir de las actividades diarias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010112,
					"content": "Después de todo, los túneles son esenciales para transportar bienes y materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010113,
					"content": "¿Cuánto hace que ocurre esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010114
					]
				},
				{
					"id": 715010114,
					"content": "Desde hace ya un tiempo. Khedive dice que ha encontrado a un investigador de Sumeru dispuesto a ayudar, pero parece que el investigador también necesita ayuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010115,
					"content": "Me he estado rompiendo la cabeza para encontrar a alguien capaz de echar una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010116,
					"content": "¡Si es un encargo de Khedive, la recompensa debe ser buena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010117,
					"content": "¿Nadie se ha ofrecido a ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010118,
					"content": "No, nadie quiere aceptar el encargo. Ese lodo negro es muy peligroso. Muchos se han interesado por la recompensa, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010119,
					"content": "En cuanto se enteraron de que se trataba de la Sima, se echaron para atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010120,
					"content": "Muy pocos aventureros están familiarizados con el territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010121,
					"content": "Así que quien acepte este encargo tiene que ser alguien que no le tema al peligro y que conozca la Sima como la palma de su mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010122,
					"content": "Estaba pensando en quién podría encargarse de este asunto, cuando aparecieron ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010123,
					"content": "#Vaya... {NICKNAME}, parece una situación realmente seria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010124,
						715010125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010124,
					"content": "Sí. Deberíamos ir a echar un vistazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010126,
					"content": "Entonces, ¡vamos a la Sima a buscar a Khedive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010127,
					"content": "Oh, en cuanto a eso... Khedive dijo que busquen directamente al investigador de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010128,
					"content": "Citando sus palabras, dijo: “Si alguien está dispuesto a ayudar, dígale que se acerque al campamento de la Sima. Ese tipo siempre se encuentra por ahí preparando su equipo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010129
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010129,
					"content": "Bien. Entonces, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010130
					]
				},
				{
					"id": 715010130,
					"content": "¡Gracias! ¡La seguridad de la Sima está en sus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010125,
					"content": "Hay que ayudar a Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010104,
					"content": "¿Qué te pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				}
			]
		},
		{
			"id": 7150102,
			"completionStepIds": [
				7150102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
