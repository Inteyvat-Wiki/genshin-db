			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "“¡Me quedé dormido! Tengo que volver antes de mañana, de lo contrario nadie cuidará de Xiangjun... Qué tonto soy...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050202,
					"content": "“Recuerdo que para ir de la Vaguada Yaodie al Monte Xuanlian había un camino estrecho... Sí, ese camino estrecho, luego hay que atravesar una cueva, y ya llegaría...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050203,
					"content": "“Dicen que hay monstruos por allí, pero ahora no tengo más opción que ir por el atajo...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050204,
					"content": "Parece que esto lo dejó aquí su abuelo. ¡Él tomó el camino estrecho! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "“... Ya había previsto encontrarme con monstruos... Pero...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050502,
					"content": "“... Me sigue sangrando el muslo... no puedo detener la hemorragia... ”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050503,
					"content": "“... Tengo mucho sueño..., pero estoy a un paso del Monte Xuanlian... Xiangjun... Conseguiré el agua adéptica como sea...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050504,
					"content": "“... Xiangjun... Estoy seguro de que conseguiré el agua adéptica...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Notas de alguien"
				},
				{
					"id": 711050505,
					"content": "¡Oh, no! Lo atacaron los demonios y parece estar gravemente herido... Paimon no entiende por qué insiste en conseguir el agua adéptica aun estando en esas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "¡Tenemos que darnos prisa! ¡Hay que ayudarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
