			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Humm, debe de ser aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "¿Por qué Paimon no ve a nadie? Tampoco hay ningún rastro por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "¿Puede que ya haya regresado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Paimon no cree que sea posible. Si el abuelo de Xiangjun está herido, ¿cómo podría ir tan lejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Pero tampoco lo hemos encontrado aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "¿Puede que alguien lo rescatara en el camino? A Paimon le parece bastante probable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "¿Volvemos a la Aldea Chiaoying a preguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Llevémonos un poco de agua adéptica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "¿Agua adéptica? Cierto... Si de verdad alguien lo rescató, seguro que aún necesita esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Y no nos cuesta nada llevarle un poco. Jeje, qué considerado por tu parte, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "#Oh... Viajer{F#a}{M#o}, por la prisa que tienen, ¿están en problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050802,
					"content": "Luo... ¿Sabe dónde está la casa de Xiangjun y su abuelo? Estamos buscándolos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "¿Xiangjun? No la conozco. ¿Es de aquí? Si vive en la aldea, debería sonarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050804,
					"content": "¿No la conoces? Paimon está muy confundida... Nos encontramos con una niña que se llamaba Xiangjun, y nos dijo que vivía en la Aldea Chiaoying. Nos pidió ayuda para encontrar a su abuelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "¡Tenía una balsa de bambú grandísima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Humm... Una balsa de bambú es algo común, pero el nombre de Xiangjun... Les puedo asegurar que no existe nadie con ese nombre en la aldea. ¿Saben cómo se llama su abuelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050807,
					"content": "No, pero su abuelo es herborista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "¿Herborista? Según recuerdo, antes había un herborista en la aldea, pero falleció hace tres años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050809,
					"content": "¡¿Falleció?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Fue víctima de los monstruos... *Suspira*... No creo que sea la persona que buscan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050811,
					"content": "Ese herborista estaba un poco loco, por lo que nunca llegó a casarse, y mucho menos a tener nietos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050812,
					"content": "Paimon está muy confundida... Entonces, ¿qué hay de esa Xiangjun con la que nos encontramos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "¡¿Y si era un demonio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "¿Qué tipo de hierbas medicinales buscan los herboristas de la aldea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Son unas plantas que nunca he visto. Solo entiendo un poco sobre té, del resto no tengo ni idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050816,
					"content": "Pero recuerdo que lo encontramos cerca del Monte Xuanlian cuando ocurrió todo. Tenía una botella de agua en la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050817,
					"content": "Dijo que tenía una hierba adéptica en su jardín que solo sobreviviría al regarla con agua adéptica. Qué tontería... Si el agua viene del río, ¿qué tiene de especial? Arriesgó su vida por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050818,
					"content": "*Suspira*... Por respeto al fallecido, después de su funeral, vertimos el agua que trajo en su jardín para que pudiera descansar en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050819,
					"content": "¿El agua adéptica del Monte Xuanlian? Estuvimos allí y también trajimos un poco... Ese herborista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Es la persona que buscábamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "#¡Pues qué raro! ¿Por qué no me acompañan? L{F#a}{M#o}s puedo llevar a su jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711050822,
					"content": "Ya que trajeron esa agua, rocíenla en su jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luo"
				}
			]
		},
