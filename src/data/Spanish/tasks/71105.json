				{
					"id": 711051101,
					"content": "Si no necesitan nada más, voy a marcharme. Quédense todo lo que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711051102,
					"content": "Entonces, ¿en la aldea no hay nadie llamada Xiangjun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Iré a preguntar a los demás, a lo mejor la niña se confundió y es de otra aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Luo"
				},
				{
					"id": 711051104,
					"content": "Gracias por hacer todo esto. Han regado la planta en nombre de ese “Adéptico” y todo. Estoy seguro de que si él lo supiera, les daría su bendición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luo"
				}
			]
		}
	]
