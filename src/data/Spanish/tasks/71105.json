			"dialogs": [
				{
					"id": 711050101,
					"content": "Abuelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050102,
					"content": "Hola, pequeña. ¿Qué haces aquí a estas horas? ¿Cómo te llamas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Me llamo Xiangjun... Estoy buscando a mi abuelo... Un monstruo se lo llevó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050104,
					"content": "¿Un mon... monstruo? ¿Hay monstruos aquí? ¿Qué tipo de monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "Yo... no lo sé tampoco... Me lo contó mi abuelo. Siempre decía que había monstruos en las montañas y que no fuera por allí... Pero ya lleva tres días sin volver a casa desde que se fue al monte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050106,
					"content": "Te lo habrá dicho para asustarte, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Paimon piensa lo mismo... ¿Te dijo para qué fue a la montaña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Mi abuelo es el herborista de la aldea. Hace unos días trajo una hierba adéptica, que dicen que solo crece al regarla con agua adéptica del Monte Xuanlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050109,
					"content": "¿Se habrá encontrado con algún monstruo que custodiaba el agua adéptica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050110,
					"content": "No te preocupes, Xiangjun. Ya es muy tarde, y tal vez tu abuelo solo haya tenido algún contratiempo. Déjanos llevarte a casa primero, ¿está bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Pero tengo que rescatar al abuelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050112,
					"content": "Podemos ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050114,
					"content": "¡Por supuesto! Pero si no regresas a casa, tu abuelo se preocupará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Sí... No puedo dejar que el abuelo se preocupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050116,
					"content": "#Nosotr{M#os}{F#as} iremos a buscarlo. ¿Dónde vives? Te llevaremos a casa antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "No hace falta. Vivo en la Aldea Chiaoying, está muy cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050118,
					"content": "¿Pueden ir ahora mismo a buscarlo? Me da miedo que esté en peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050119,
					"content": "Claro, sin problema. Pero ¿sabes a dónde fue exactamente tu abuelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Solo sé que se fue por esa dirección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 711050121,
					"content": "Entonces empezaremos a buscar por esa zona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "¡Gracias! Entonces vuelvo a casa ya, no quiero molestar más... Esperaré pacientemente buenas noticias en la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
