			"dialogs": [
				{
					"id": 3790401,
					"content": "Funcionó, tal y como pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790402,
					"content": "Este brillo rejuvenecedor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790403,
					"content": "¿Elogiándose a usted misma? ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790404,
					"content": "... Estoy hablando de la Lira Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790405,
					"content": "#Gracias a que {NICKNAME} purificó el cristal, la Lira ya no perderá más poder Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790406,
					"content": "Aun así, está lejos de estar completo. Sería genial si pudiéramos conseguir más lágrimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790407,
					"content": "Yo puedo ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "¿Cómo piensas reunirlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790411,
					"content": "Dvalin ya debe estar llorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790412,
					"content": "Sufriendo a solas, en un lugar desierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790413,
					"content": "Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790414,
					"content": "Pobrecito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790415,
					"content": "#No sé si {F#la Caballera Honoraria}{M#el Caballero Honorario} podrá hacerlo {F#sola}{M#solo}. Los demás Caballeros de Favonius te acompañaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790416,
					"content": "#Tras conseguir la Lágrima cristalizada, dejaremos a {NICKNAME} a cargo de la purificación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790417,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "¡Oh! Héroes que se ayudan mutuamente y emprenden juntos una aventura. ¡Es fascinante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790419,
					"content": "Perfecto para componer una canción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790420,
					"content": "¿Eh? ¿Eso es lo que vas a hacer? ¿Cantar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790421,
					"content": "¿Qué clase de bardo sería si no lo hiciera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790422,
					"content": "¡Ja! ¡Qué descaro! Te mereces un apodo horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790423,
					"content": "¡Ah, Paimon lo tiene! ¡De ahora en adelante serás “<color=#00E1FFFF>el bardo de pacotilla</color>”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790409,
					"content": "Cierto. ¿Cómo lo hacemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "¿Cómo podemos hacer que Dvalin llore? ¿Pegándole?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
	]
}