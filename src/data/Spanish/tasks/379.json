			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "#¡Oh! ¡Bienvenid{F#as}{M#os} de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790202,
					"content": "Esa es... ¡La Lira Sagrada! ¡La consiguieron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790203,
					"content": "Los motivos decorativos del viento tallados en madera de palisandro... Las cuerdas aún frías al tacto... ¡Qué nostalgia me trae!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790204,
					"content": "¿Y bien? ¿Crees poder invocar a Dvalin con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790205,
					"content": "Pues... Aunque es claramente la de verdad, no creo que funcione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790206,
					"content": "Como pueden ver, la Lira tiene miles de años de historia, y su poder Anemo se ha agotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "Bajo estas condiciones, ni siquiera valdría para tocar música en la taberna de Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790208,
					"content": "¡Muchos bardos pelearían por tocar en el escenario de mi taberna! ¡No hagas suposiciones así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3790209,
					"content": "Sr. Diluc, ¿tiene que discutir ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790210,
					"content": "¡Y tú, bardo! ¿Tomaste prestada la Lira solo para tocar ante un montón de borrachos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790211,
					"content": "¡Jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790212,
					"content": "¿De qué te ríes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790213,
					"content": "En fin, no podemos invocar a Dvalin con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790214,
					"content": "La lira en sí misma está bien, pero las cuerdas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790215,
					"content": "#¡Hora de brillar, foraster{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790216,
					"content": "¿Me hablas a mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "No te preocupes, no está rota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790219,
					"content": "Es solo que la intensidad de su poder Anemo ha disminuido considerablemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, ¿todavía tienes la Lágrima cristalizada de Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790221,
					"content": "(asiente con la cabeza)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "No sé arreglar instrumentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
