				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "¡Es enorme! Paimon está convencida de que solo puede haber sido obra de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Pero... ¿Cómo manejamos esta cosa? Necesitaríamos muchísima fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "De todos modos, ahora mismo es imposible. Está rota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "¿Cómo que... rota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Después de milenios de desgaste, es difícil darle mantenimiento incluso a los artilugios de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "¿Y qué hacemos? Vamos, Sr. Zhongli, ¡use su infinito conocimiento como persona de la alta sociedad que es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Humm. Dicho así, suena como si fuera un burgués parásito e inútil que lo único para lo que sirve es para decir datos curiosos a petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Dicho esto, déjenme pensar... Lo tengo. Cuando empezó a construirse la Balista Guizhong, se hicieron piezas de repuesto en caso de que sufriera cualquier daño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "Si no me equivoco, deberíamos poder encontrar el almacén de suministros militares aquí, en el Paso Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Una vez tengamos el material, quizás podamos arreglar la Balista Guizhong si comprendemos su funcionamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Entonces... ¿está diciendo que entiende cómo funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Bueno... Algo sé, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Si reunimos el <color=#00E1FFFF>material suficiente</color>, al menos podríamos probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Sí, creo que este material servirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Esperen un momento. Voy a ver si puedo arreglarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Ya está. La estructura de la Balista Guizhong era más complicada de lo que preví.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "¡Guau! ¿Y ahora cómo se usa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "Fácil. Si hacemos así... Miren, este artilugio construido por los Adeptus tiene incluso binoculares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Aquí tenemos... nada. Y aquí... tampoco nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "¡Eh! ¿Qué creen que están haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150607,
					"content": "Así que arreglaron la torreta... ¿Qué tienen en mente, si se puede saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150608,
					"content": "No es una torre, es la Balista Guizhong. Y, por si no lo sabías, es de buena educación presentarse antes de preguntar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "¡Ja! ¿Acaso no sabes con quién estás hablando? Estás viendo al líder de los Ladrones de Tesoros, anciano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150610,
					"content": "Se supone que esta zona está repleta de tesoros, pero es imposible acercarse a ellos con esta cosa vigilando. Parece una simple máquina, pero créanme, ¡tiene vida propia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150611,
					"content": "La última vez que estuvimos por aquí, casi convierte a uno de los nuestros en una brocheta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150612,
					"content": "Al final, yo y unos pocos tuvimos que arriesgar nuestras vidas para romperla. ¡¿Y ahora vienen ustedes y la arreglan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150613,
					"content": "¡Pues lo próximo que repararán son sus propias caras! ¡Eso si salen vivos de esta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "El pecoso Huang"
				},
				{
					"id": 10150614,
					"content": "*Tch tch*, ¿cómo se atreven a vandalizar el legado de un Adeptus para fines personales? ¡Qué desgracia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Son ustedes los que necesitan una lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#¡Tiene toda la razón! ¡{NICKNAME}, prepárate para luchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Perdón, no pudimos cumplir con nuestra parte del contrato. No encontramos ni rastro de la Cococabra semi-iluminada de la que nos hablaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ah... Qué lástima. No pasa nada, pero es una lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "¡Ay, pobre Qiqi! ¡De repente, Paimon se siente culpable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, ¿tienes alguna otra pista que nos pueda servir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Ah... La leche de la Cococabra está deliciosa. Más que la de las cabras normales. Solo una bestia semi-iluminada puede hacer leche tan deliciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Perdón. Tengo muy mala memoria. No recuerdo el nombre de la leche. Por eso lo anoté. ¿Dónde lo puse...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah, aquí está. La leche deliciosa se llama... “Leche de coco”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Les debo una disculpa. Mi intención era tener un trato justo con Qiqi, pero al parecer actué impulsivamente y acepté su encargo demasiado rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "No se preocupe, Sr. Zhongli. Como dicen en Liyue: “Todo es aleatorio así que... ¿cómo podemos predecir las cosas?”. ¿Quién iba a saber que todo acabaría así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Disculpen, ¿Qiqi dijo algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Oh... {NICKNAME}, Paimon te deja a ti la tarea de destruir los sueños de una niña pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Lamento decirte que la leche de coco no viene de la Cococabra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Parece que Qiqi no se lo tomó muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Necesita tiempo para procesarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Jaja, alguien aprendió una valiosa lección de vida hoy, ¿eh? Gracias a todos por cuidar a mi pequeña Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "¿Y usted es...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Disculpen mi descortesía. Soy Baizhu, el dueño de la Farmacia Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Y Paimon creía que Qiqi era la jefa... ¡Resulta que el jefe es un chiflado que lleva ingredientes medicinales colgando en el cuello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Qué lamentable. Qiqi es una niña muy inocente, pero esta mascota que llevan lo es aún más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "¡Ah! ¡La medicina... la serpiente habló!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "¡Una serpiente que habla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "¡Sss! Normalmente no hablo, pero ante los nuevos clientes debo hablar para que no me confundan con una fugitiva del botiquín, ¡porque soy una serpiente viva, que respira y sisea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Jajaja, no le presten atención a Changsheng. Es una buena chica, de verdad. En cuanto a ustedes tres... ¿Qué les trae por aquí, aparte de crear todo este caos con Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Disculpe, caballero, ¿vende incienso eterno en su tienda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "¿Incienso eterno? Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "¡Uf, al fin! Si no, esto sí que habría sido una pérdida de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Serán tres millones de Moras. Es de la mejor calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "¡¿Tres millones?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "¡Mejor asaltamos la Casa Dorada! Aunque ahora fue ocupada por las Siete Estrellas... Tendrá una mayor seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Humm... Tres millones... Un número inocuo en sí mismo, pero una suma difícil de conseguir desde un punto de vista pragmático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "¡Es una cantidad exorbitante! Nunca podríamos hacer tanto dinero. En cuanto a Zhongli, le faltan tres millones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "En efecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Qué sincero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "¿Y qué hacemos? ¿Aquí es donde volvemos con Nobile de rodillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "¡Jajajajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150745,
					"content": "Cococabra... ¡Cococabra! ¡Qué risa! ¡No sé ni cómo se lo creyeron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150746,
					"content": "¡Oye! ¡No te rías de nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Estoy llorando de la risa. Bueno, como agradecimiento por haberme hecho reír tanto, les ayudaré con su problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150748,
					"content": "Perdone... Dr. Baizhu, ¿verdad? Soy Nobile, uno de Los Once de los Fatui. Perdone mi atrevimiento por lo que voy a decir, pero creo que podríamos colaborar juntos en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150749,
					"content": "Si la Farmacia Bubu lo necesitase, los Fatui podrían construir un canal de suministro rápido y directo de leche de coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150750,
					"content": "Qué extraño... Sabía que los Fatui suelen meterse en los negocios de otros con ofertas seductoras, ¿pero todo esto por un poco de leche de coco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Leche de coco. Dr. Baizhu, rápido. Qiqi quiere leche de coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Ah, por supuesto Qiqi, todo lo que quieras... Gracias, Nobile, espero una colaboración con muchos éxitos para el futuro. Por ser usted, puedo hacerle un descuento en el incienso eterno: serán dos millones novecientos noventa mil Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Ni que hubiera mucha diferencia con los tres millones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Humm... Dos millones novecientos noventa mil Moras... Un número inocuo en sí mismo, pero una rebaja de 10 000 Moras desde un punto de vista pragmático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Bien. Ya que el asunto queda resuelto, podemos volver a la Terraza Yujing. Sr. Nobile, Dr. Baizhu, pequeña Qiqi, les veré pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Qué gente tan curiosa. Hacía mucho que no me reía tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150757,
					"content": "Bueno, estabas escuchando a escondidas, ¿no? ¿Qué me perdí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150758,
					"content": "Sí, maestro Nobile. Mencionaron que la Casa Dorada fue ocupada por las Siete Estrellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Ya veo. Ninguang y el resto de las Siete Estrellas... Si están escondiendo algo en la Casa Dorada, solo puede ser la Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150760,
					"content": "#Perdón, {NICKNAME}, pero te avisé desde el principio, ¿cierto? Como dice el antiguo dicho de Liyue: los muros tienen oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10150737,
					"content": "¡Mejor asaltamos la Casa Dorada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Aunque ahora fue ocupada por las Siete Estrellas... Tendrá una mayor seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Ya nada me sorprende en Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Algún día tenía que crecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "La leche de coco proviene de los cocoteros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "¿Para qué necesitas a esa Cococabra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "¡Ahí estás! ¡Pero si eres más pequeña que el mostrador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "¿Es una zombi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "¡Es verdad! Y tiene una especie de talismán en la frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "#Bienvenid{F#as}{M#os} a la Farmacia Bubu. Soy Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Hace tiempo que Qiqi murió. Luego, a Qiqi la salvaron los Adeptus. Ahora, Qiqi es una zombi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Lo dices como si fuera la cosa más normal del mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Esto sería impensable en Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Hola... amiguita. ¿Vendes incienso eterno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Perdone... ¿Tiene receta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Pues... No creo que se necesite una receta para el incienso eterno. No es un medicamento regulado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Si tiene receta, Qiqi le da la medicina. Es una orden que Qiqi se dio a sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "¿Una orden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Los zombis están limitados a actuar dentro de los límites que le ordenen. Pero en este caso, quien da la orden es ella misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Qiqi, amiguita, no tenemos receta, pero te estaríamos muy agradecidos si pudieras ayudarnos a encontrar algo de incienso eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "¿Eh? ¿Así de fácil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Pero si Qiqi les ayuda, ustedes ayudan a Qiqi. Un trato justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "¿Desde cuándo los clientes tienen que hacerle favores a los vendedores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Eso no importa. Piensen en ello como un trato de igual a igual. Así, todos ganamos. En Liyue, el arte de los negocios consiste en saber ponerse en el lugar del otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Vayan a la Cordillera Tianheng. Encuentren la Balista Guizhong. Cacen una Cococabra. Por favor y gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "No entendí bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "La Balista Guizhong... He oído hablar de ese dispositivo antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "Es una especie de torre-ballesta instalada en la Cordillera Tianheng por los Adeptus. Es un antiguo dispositivo mecánico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Al situarse en el Paso Tianheng, tiene la capacidad de hacer frente a monstruos de enorme tamaño para defenderse de cualquier amenaza externa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "¡El Sr. Zhongli conoce Liyue como la palma de su mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "No es tan así... Por ejemplo, nunca había oído hablar de esa “Cococabra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "La “Cococabra”. Es una bestia semi-iluminada legendaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "¿Podrías darnos más detalles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "No. Solo que la “Cococabra” es una bestia semi-iluminada legendaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "No sé qué aspecto tiene. No sé dónde hay más cantidad de ellas. No sé de dónde proviene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "¿Algo más que no sepas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Bien... Vayamos a los alrededores de la <color=#00E1FFFF>Balista Guizhong</color>. Quizás encontremos alguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "¿Qué criatura será esa “Cococabra”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "No es de mucha ayuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Yo creo que nos está tomando el pelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "No lo creo. ¿La Balista de Guizhong? He oído hablar de ese dispositivo antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Es imposible hablar con ella...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Me temo que es justo por lo que dijo: se trata de una orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "No sabía que había zombis en las tierras del Arconte Geo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Mira quién habla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "¡Oye! Puedo volar, así que mi estatura no es un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "No sé. Tiene un aspecto un poco raro... ¿Qué es ese talismán que tiene en la frente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "¿Acaso es... una zombi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
