					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151102,
					"content": "Uf... ¡Por fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151103,
					"content": "#Y bien, aventurer{F#a}{M#o}, ¿qué has aprendido de nuestra aventura hasta ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151104,
					"content": "Vaya viaje más raro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "¿Raro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151106,
					"content": "No sé si he experimentado lo que es la riqueza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Jajaja. ¿Cuál es tu respuesta, entonces? Las dudas que surgen en un viaje siempre son complicadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151109,
					"content": "#Bueno, te dejo que lo medites por ti mism{F#a}{M#o}. Cierto, en cuanto al pago por su ayuda, he decidido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151110,
					"content": "Invitarles a cenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151111,
					"content": "¿El Sr. Zhongli invitando a algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "¿Eh? Ah, no se preocupen. Esta vez no me olvidaré de traer dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151114,
					"content": "#Esta noche, l{F#as}{M#os} llevaré a amb{F#as}{M#os} a una antigua bodega que se elogia en toda Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151115,
					"content": "¿Una bodega? ¿De esas en las que se toma alcohol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151116,
					"content": "Así es. Nos veremos en la taberna Los Tres Cuencos, cerca del puerto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151112,
					"content": "¡Esto es inaudito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "O la pobreza extrema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
			]
		},
