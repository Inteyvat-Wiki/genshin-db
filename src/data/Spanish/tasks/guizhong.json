			"dialogs": [
				{
					"id": 10151101,
					"content": "Bueno, ya contratamos a los ayudantes y tenemos el incienso eterno. Nos queda muy poco para terminar con los preparativos del Rito del Ascenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
