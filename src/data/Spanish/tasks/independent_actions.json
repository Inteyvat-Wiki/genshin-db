			"dialogs": [
				{
					"id": 1903203101,
					"content": "*Buaa*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203102,
					"content": "¿Puedes... ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203103,
					"content": "¿Ayudarte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "¡Ese exorcista de cabello azul me da miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203106,
					"content": "¿Puedes llevártelo de aquí? Me da miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203107,
					"content": "¿Te afecta su energía positiva?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "No me atrevo a acercarme a él. Su energía positiva... ¡es horrible! ¡Me hará desaparecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203110,
					"content": "No quiero desaparecer... por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203111,
					"content": "Me pregunto si te considerará un “espíritu maligno”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "Está bien, tengo una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203114,
					"content": "Vi desde lejos a ese tipo de pelo azul discutiendo con alguien hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203115,
					"content": "Asustaré a esos alborotadores, pero tienes que pedirle al exorcista que me deje ir, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203116,
					"content": "¿Me estás diciendo la verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "¡Por supuesto! Yo nunca miento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203120,
					"content": "Entonces, ¿qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203121,
					"content": "Él tiene la última palabra, pero intentaré explicarle la situación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Entonces, ¿eso es un “sí”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203123,
					"content": "Espero que el exorcista de pelo azul sea una buena persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203124,
					"content": "Yo le ayudaré, y tú hablarás con él. Y luego... tú me ayudarás. ¿Hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203118,
					"content": "#Yo mism{F#a}{M#o} puedo sacarlo de apuros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Sí, pero será complicado. Ya tengo un plan, ¡tienes que creerme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Chianchian"
				},
				{
					"id": 1903203112,
					"content": "Él tiene la última palabra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "No me sorprende que no tengas amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "¿Por qué yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}