			"dialogs": [
				{
					"id": 752520601,
					"content": "Eras un cliente de la taberna. Nos hemos visto antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "¿En serio? Ya decía yo que me resultabas familiar. Sin embargo, veo a mucha gente a lo largo del día, así que no me suelo quedar con las caras... Pero eso no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525207,
			"completionStepIds": [
				7525205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
