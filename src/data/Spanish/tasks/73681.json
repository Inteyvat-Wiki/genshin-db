			"dialogs": [
				{
					"id": 736810101,
					"content": "#Viajer{F#a}{M#o}, Paimon, hola. He oído que han participado en el evento de las cajas rebosantes. ¿Qué les parece? ¿Se están divirtiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "¡Es muy divertido! Paimon no sabe si es gracias al mercado de licores del Festival de la Vendimia, ¡pero hemos conseguido decoraciones de todo tipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Jaja, ciertamente, hay gente que prepara ese tipo de obsequios. Por cierto, ya que tenemos un puesto de comida, ¿les gustaría poner aquí algunas de sus decoraciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Decorar el puesto podría ayudarnos a captar más clientela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "#Además, seguro que la gente que preparó los obsequios se alegraría mucho de verlos en tu puesto, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#¡Tiene razón! ¡{NICKNAME}, vamos a decorar nuestro puesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
