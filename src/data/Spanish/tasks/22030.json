			"dialogs": [
				{
					"id": 220300201,
					"content": "Aquí es. Los monstruos han levantado campamentos a la izquierda y a la derecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Este servidor fue sigilosamente a reconocer el área y descubrió que en el campamento de la izquierda los monstruos son bastante débiles, pero muy numerosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "En cambio, en el de la derecha hay pocos monstruos, pero son muy fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Me gustaría que usted despejara uno de los lados. Yo me encargaré del otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
