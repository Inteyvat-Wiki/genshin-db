			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "¡Muchas gracias! Estos ingredientes todavía pueden utilizarse, pero no puedo esperar más. Empezaré a cocinar ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "Ya está. Gracias a su ayuda he podido cocinar este plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Eres un perfeccionista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "¡Por supuesto! Ya se trate de arreglos florales, la ceremonia del té, cocinar, o el manejo de la espada, si no se aspira a la perfección la actividad pierde todo su sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "La vía de la perfección es el ideal que rige mi vida. Pero el señor Xudong no está de acuerdo conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "El señor Xudong me dijo una vez que en Liyue se prefiere la “vía del medio”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Esta vía trata de evitar los extremos, tanto en las personas como en las acciones. Todo debe ser equilibrado y moderado.",
