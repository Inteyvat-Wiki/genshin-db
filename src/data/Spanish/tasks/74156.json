			"dialogs": [
				{
					"id": 741560401,
					"content": "¡Qué nervios! Según lo que ponía en la nota, solo tenemos que esperarlo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Pues a esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "De acuerdo, hagamos eso entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "#Tras esperar un rato en silencio, la ventana se abre acompañada de un crujido, y tras ella aparece un rostro familiar. Benoit inspecciona el exterior y, tras verl{F#a}{M#o}s, sale cuidadosamente por la ventana.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, ¿pero qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "¡Vamos, rápido! Si nos descubren, estamos acabados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Tengo unas cuantas preguntas que hacerle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
