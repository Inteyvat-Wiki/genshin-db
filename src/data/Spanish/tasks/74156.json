				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Pueden resolverlo ellos mismos. No volveré a entrometerme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Mi querida Automne, ¿de verdad quieres hacerme esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "¿Qué niña del Río Ceniciento tuvo tanta suerte como tú? Los dulces que comías, tus vestidos de satén, los libros que leías... Todo eso costaba mucho dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Mientras otros pasaban frío y hambre, tú le ponías collares y vestidos al perro de la familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Fui yo quien labró esa vida. ¿No crees que merezco ser recompensado por ello? ¿Cómo esperas conseguir algo sin dar nada a cambio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "¿Que yo he sido cruel contigo? ¡He sido más que generoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Automne, piénsalo bien. ¿Para qué parte de tu vida no te he preparado? Si elegiste el camino equivocado, fue tu propia decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Ah, Benoit, se te da demasiado bien darle la vuelta a las cosas. Te las das de padre generoso y amable, pero en el fondo todo lo haces para perseguir tus propios fines egoístas. Todo lo haces por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561109,
					"content": "Solo me has tratado bien para cosechar más tarde lo sembrado. Déjate de palabrería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "La mayor misericordia que puedo mostrarte es darte una muerte rápida. Pero antes, dime, ¿dónde está mi hija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "No hay rastro de ella ni en tu antigua casa ni en la de ahora. ¿A dónde la has mandado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Si te lo digo, ¿dejarás que me vaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "No, pero morirás de forma menos dolorosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "... Si te lo digo, muero. Si no te lo digo, muero igualmente... Jeje, ¿por qué debería de ponerte las cosas fáciles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "*Suspira*... Automne, se te da muy mal mentir. Ahora nunca averiguaremos dónde está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561116,
					"content": "Yo sé dónde está, pero no se lo pienso decir. ¡De ninguna manera! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Jamás la encontrarán. Jamás de los jamases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Me lo voy a llevar de vuelta a casa. ¿Tienen alguna objeción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Adelante. No interferiremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "Y-ya se encargan ustedes de sus asuntos. No es asunto nuestro. No, no lo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit sigue repitiendo “¡Jamás la encontrarán!”, mientras Automne se lo lleva en silencio a casa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "No tenía pensado que nadie más se enterara de esto. Después de todo, hay una orden de arresto contra ella y, todo sea dicho, contra mí también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561123,
					"content": "Si nos denuncian ante la Oficina Judicial, puede que ganen una buena recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561124,
					"content": "Pero no se lo recomiendo. Si lo hacen... Mis amigos no olvidan. Hagan la prueba si quieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561125,
					"content": "No voy a denunciar nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Jaja, pensé que dirías algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561128,
					"content": "En ese caso, esta rosarcoíris es para ti. Apreciamos mucho este tipo de flor por el significado tan variado que contiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561129,
					"content": "Ahora mismo, simboliza un aviso. Un aviso de que espero que no cambies de parecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561130,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561131,
					"content": "Así que... de eso se trataba. ¡Qué familia más complicada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon no sabe qué decir ni cómo evaluar la situación. Menos mal que no avisamos antes a la Oficina Judicial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Paimon se siente mal por Automne. Al final, no va a poder encontrar a su hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "¡Y Paimon creía en un principio que Benoit era un buen tipo! Humm... ¿Crees que Paimon es fácil de engañar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "¿Ahora te das cuenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "¡Oye, no te pases! Anda que reírte de Paimon en un momento como este... ¡Hum! ¡Paimon no te va a perdonar a menos que la invites a comer algo rico en el Bistró Debord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Tienes menos luces que un Slime, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "No necesito el dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
