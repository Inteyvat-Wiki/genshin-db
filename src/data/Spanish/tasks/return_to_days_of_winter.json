			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "#G-gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290502,
					"content": "Los monstruos no dejaban de perseguirme, incluso después de correr hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290503,
					"content": "¿Viniste a recolectar ganchos de lobo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "¿Eh? Sí, a petición de Marjorie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290505,
					"content": "¿No pudiste encontrar a alguien que te acompañara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "¿Quién querría acompañarme solo para recolectar plantas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290508,
					"content": "Entiendo lo que quieres decir, pero los ganchos de lobo solo se encuentran en el Reino de los Lobos, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290509,
					"content": "Y ya recolectaron los que crecen en las zonas más seguras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290510,
					"content": "Es por eso que tuve que adentrarme tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290511,
					"content": "Pero no hablemos más de eso, ¿podrías llevarle estos ganchos de lobo a Marjorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290512,
					"content": "Yo necesito descansar, estoy agotado de tanto correr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 200290507,
					"content": "No deberías ir tan lejos a solas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
