					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "Porque yo... ¡le di muchas comiditas! Por eso me manda un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, ese Fatui no es una buena persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
