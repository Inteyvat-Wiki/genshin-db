			"dialogs": [
				{
					"id": 200290601,
					"content": "#Viajer{F#a}{M#o}, ¿encontraste a Schuster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290602,
					"content": "Sí, me pidió que te entregue estos ganchos de lobo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "¡Oh! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290604,
					"content": "Le daré una recompensa a Schuster cuando regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290605,
					"content": "Por cierto, estabas buscando un regalo para un niño, ¿cierto? Espera un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290606,
					"content": "Marjorie comienza a hacer el regalo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "¡Ya está! Tómalo. ¡Gracias por traerme los ganchos de lobo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290608,
					"content": "Este muñeco tiene una ligera fragancia. Estoy segura de que al niño que lo reciba le encantará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
