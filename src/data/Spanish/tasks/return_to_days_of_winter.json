				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "#¡Hola! ¿Necesitas algo, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290202,
					"content": "Estoy buscando regalos para niños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "¿Regalos para niños...? Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290204,
					"content": "Oh, ahora que lo dices... He estado intentando hacer algunos juguetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290205,
					"content": "Pero se necesitan ganchos de lobo para darles color, y ya se me acabaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290206,
					"content": "Le pedí a Schuster que saliera a buscar algunos ganchos de lobo, pero hasta ahora no ha regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290207,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a buscar a Schuster en el campo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290208,
					"content": "Cuando tenga suficientes ganchos de lobo, podré terminar de hacer los juguetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290209,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "Schuster dijo que iría a <color=#00E1FFFF>los alrededores del Reino de los Lobos</color> a buscar los ganchos de lobo. Puedes buscarlo ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290212,
					"content": "#¡Muchas gracias, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290210,
					"content": "¿A dónde fue Schuster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
