			"dialogs": [
				{
					"id": 200290101,
					"content": "Uff, parece que volveré a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290102,
					"content": "¿Te marchas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "¿Eh? Ah, eres tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290104,
					"content": "Sí, recibí órdenes de mis superiores de que puedo regresar a Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290105,
					"content": "Parece que he sido transferido a otro de Los Once y ya no tendré que quedarme en Mondstadt esperando órdenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290106,
					"content": "No sé a quién de Los Once me asignarán, pero espero que no sea Scaramuccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "¿Cuándo te irías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Mis superiores no me han dado detalles. Lo único que dijeron es que tenga mis cosas listas para irme en cuanto lo ordenen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "*Suspira*... Al fin podré salir de este lugar. Ya no tendré que soportar las miradas inquisidoras de esas monjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "#¡Oh, cierto! Viajer{F#a}{M#o}, llevamos mucho tiempo trabajando juntos, ¿podrías hacerme un último favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Es lo mismo de siempre, ¿qué tal si me ayudas y yo te doy una recompensa? Nunca harás un trabajo gratis conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "¿Ahora qué historia me vas a contar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Jajaja, ¡ya te he contado todas las historias de los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Si me ayudas, esta vez te pagaré en Moras. ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "A menos que quieras escuchar los cuentos de hadas que le conté a Lily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "¿Qué clase de ayuda es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Está bien, seré franco... El favor que quiero pedirte tiene que ver con Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Aparte de ti, creo que Lily es la única persona en toda Mondstadt que está dispuesta a escuchar a este “malvado Fatui”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Si me voy, no creo que tenga la oportunidad de regresar a Mondstadt... Quería darle a Lily un último regalo como recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Pero, como podrás imaginar, me arrojarán miradas despectivas si voy a comprarlo yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "#Así que prefiero dejarlo en tus manos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Ve a la tienda de Marjorie y ayúdame a buscar un regalo adecuado para una niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "¿Todavía pasas tiempo con Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Bueno... De vez en cuando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Nunca faltan historias sobre los Fatui contigo aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
			"id": 2002902,
			"completionStepIds": [
				2002902
