						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "*Suspira*... Lily, tienes que mantenerte alejada de ese hombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "¿Por qué? ¡El señor Flauti es muy bueno conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Me cuenta muchas historias, ¡es muy amable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, hazle caso a papá. No es tan sencillo. *Suspira*, papá te lo explicará cuando seas mayor...",
