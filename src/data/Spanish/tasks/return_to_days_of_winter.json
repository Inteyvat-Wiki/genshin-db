					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Oh... ¿Por qué el Sr. Flauti tiene que irse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "¿De verdad se va? Es mejor así. Paso el día entero preocupado porque Lily se la pasa hablando con ese tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Papá, ¡quiero decirle adiós al señor Flauti!",
					"roleType": "TALK_ROLE_NPC",
