						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Bueno, basta de charla, aquí está tu recompensa. Este será nuestro último intercambio equivalente en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*Suspira*... Espero que mi próxima misión no sea tan problemática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
