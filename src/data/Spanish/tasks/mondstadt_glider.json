			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Soy Otto, de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "¡Guau! ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Muéstrame tu licencia de vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "¿Licencia de vuelo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "#¡Está prohibido volar sin licencia! ¡Bajo la Sección 7.ª del Artículo 12 del Código Penal de Mondstadt, quedas arrestad{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Tienes derecho a permanecer en silencio. El viento podrá usar en tu contra todo lo que digas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "¡Un momento! Soy su instructora de vuelo. Estamos haciendo una prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Pues escogieron el peor momento para hacer sus pruebas de vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "¿Y por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "#Los Caballeros de Favonius recibieron un reporte de una hermana en la Catedral que afirma que vio a Ave Rapaz planeando por aquí. Pensé que tu estudiante era {F#una}{M#un} cómplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "¿Ave Rapaz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Es un criminal famoso en Mondstadt. Siempre utiliza el planeador para cometer sus crímenes, de ahí su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "¡Guau! ¿Y vuela rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Hasta ahora no hemos podido atraparlo... Nuestro plan era atraerlo a la Catedral con un artefacto de valor y tenderle una emboscada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "Pero, al final, logró escaparse con todo y el artefacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Afortunadamente, la hermana puso una marca secreta en el artefacto usando magia elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "Pero ese ladrón es demasiado rápido, y no pudimos seguirle el rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Pues si de buscar a un criminal volador se trata, ¡yo soy la más indicada! ¿Por dónde se fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Por lo que sé, la última vez fue visto en los alrededores de Aguaclara, pero eso fue hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#¡Déjamelo a mí! {NICKNAME} y yo lo atraparemos. ¡Ave Rapaz no tiene ninguna oportunidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "No te preocupes, tan pronto como atrapemos a ese criminal retomaremos donde nos quedamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "Iré a hablar con Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "Entonces... ¿aprobé el examen de vuelo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "¡Se la comió el Barón Bunny!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
