			"dialogs": [
				{
					"id": 4270201,
					"content": "¡Aquí estoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270202,
					"content": "Ya lo arreglé todo. Sigamos con el examen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270203,
					"content": "Es igual que la prueba anterior: vuela a través de los marcadores y llega a la meta sin detenerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270204,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
