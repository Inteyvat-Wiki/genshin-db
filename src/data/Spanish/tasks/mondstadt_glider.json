					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "¡Parece que has descubierto la clave del planeador! Vamos a la fase final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270402,
					"content": "De cualquier forma, ya has volado antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270403,
					"content": "Ahora, hagamos la última prueba. Después de ella, obtendrás tu licencia de vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270404,
					"content": "Piensa en la licencia de vuelo. En sus marcas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270405,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
