					"nextDialogs": [
						101100213
					]
				},
				{
					"id": 101100213,
					"content": "Jaja, ¿te refieres a mí y al Sr. Floti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100214,
					"content": "El Sr. Floti es mi mejor amigo. Vivimos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100215
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100215,
					"content": "¡Saluda, Sr. Floti! Estas personas pueden verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100207,
					"content": "Hola. ¿Tienes un minuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				}
			]
		},
