					"content": "Vaya. Eso sí que no me lo esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100306,
					"content": "¡¿El amigo imaginario de Timmie es un... Guardián de las Ruinas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100307,
						101100308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100307,
					"content": "No creo lo que ven mis ojos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100309
					]
				},
				{
					"id": 101100309,
					"content": "Paimon se muere de miedo. ¡Seguro que esa cosa nos atacará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100310,
					"content": "Jaja... ¿Qué dices si posponemos nuestra conversación con Timmie por el momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100311,
						101100312
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100311,
					"content": "Paimon, es la hora de que digas tu frase preferida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
				},
				{
					"id": 101100313,
					"content": "¿Eh? ¿Paimon tiene una frase preferida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100314
					],
					"speakerTitle": "Paimon"
