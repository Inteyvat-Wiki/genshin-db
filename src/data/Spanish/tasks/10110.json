					"content": "Ellin es una chica muy diligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100706
					]
				},
				{
					"id": 101100706,
					"content": "Se esfuerza tanto que... Bueno, es un poco extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100709,
					"content": "¿Eh? Oh, hola. ¿Que están haciendo?",
