					"content": "Sí, ¡porque quiero ser una caballera! Y si tengo que ir a una aventura con Jean, ¡pues mejor aún!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100715
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100715,
					"content": "Ellin admira mucho a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100716,
						101100717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100716,
					"content": "No tiene nada de malo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100718,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100719
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100719,
					"content": "#Ahora que lo pienso, no todos los días puedo disfrutar de la compañía {F#de la Caballera Honoraria}{M#del Caballero Honorario}... ¿Te gustaría unirte a mi <color=#00E1FFFF>entrenamiento de espada</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100717,
					"content": "Creo que tendrás éxito, Ellin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100707,
					"content": "Está decidida a convertirse en caballera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100708
					]
				},
				{
					"id": 101100708,
					"content": "Sí, se lo toma tan en serio, ¡que da miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
