			"dialogs": [
				{
					"id": 101100404,
					"content": "La gracia de beber vino es que tienes que beberlo en la taberna o, si no, te pierdes la mitad de la diversión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100405
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100405,
					"content": "Parece que puedes encontrar la manera de entretenerte, incluso si bebes solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100406,
					"content": "Jaja, si no te conociera mejor, diría que estás siendo deliberadamente descortés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100407
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100407,
					"content": "Más te vale no emborracharte en mi taberna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100408
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100408,
					"content": "¿Oh? ¿Y qué harías si lo hiciera? ¿Me lanzarías como si fuera basura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100409
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100409,
					"content": "¿Lanzarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100410
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100410,
					"content": "Sí, ya sabes... de la misma manera que tiraste por los suelos el legado de tu padre cuando vendiste su mansión. ¿Acaso lo olvidaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100411
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100411,
					"content": "No veo ninguna razón para aferrarme a cosas que ya han cumplido con su propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100412,
					"content": "¿En serio? ¿Y qué hay de ese jarrón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100413
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100413,
					"content": "Lo siento, no sé de qué me hablas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100414
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100414,
					"content": "Qué extraño, porque el Sr. Diluc tiene un jarrón en su casa. Es realmente hermoso e inconfundible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100415
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 101100415,
					"content": "Tenías razón... Los adultos no parecen tener amigos imaginarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100416,
					"content": "Tal como les dije, les falta esa capacidad de sorprenderse que tienen los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100417,
					"content": "Parece que los adultos son iguales en todos lados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100418
					]
				},
				{
					"id": 101100418,
					"content": "Entonces, ¿la gente deja de soñar cuando crece? Pues, entonces, ¡Paimon no quiere crecer nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100419,
					"content": "Esto plantea una pregunta interesante: ¿a qué edad desaparecen los amigos imaginarios exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100420,
					"content": "Vamos a averiguarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
