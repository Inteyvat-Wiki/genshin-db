			"dialogs": [
				{
					"id": 101100901,
					"content": "¡Guau! Gracias, está claro que todavía tengo un largo camino por recorrer en mi entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100902
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100902,
					"content": "¡Qué modesta! Yo creo que ya eres bastante profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100903
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100903,
					"content": "Bueno, entrenar me cansa, así que creo que necesito trabajar en mis habilidades físicas. Pero algún día aplastaré a todos los maniquíes de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100904
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100904,
					"content": "¡Ánimo! ¡Tú puedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100905,
					"content": "Gracias... ¡Por Los Siete! ¡Estaba tan concentrada que olvidé que tenía algo que hacer el día de hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100906,
					"content": "Pero me duele tanto el cuerpo por el entrenamiento que apenas puedo moverme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100907,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¿podrías entregarle un mensaje a Jack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100908,
					"content": "¿Quién es Jack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100909
					]
				},
				{
					"id": 101100909,
					"content": "Es un amigo mío. Se convirtió en un aventurero hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100910
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100910,
					"content": "Nos íbamos a encontrar esta noche y discutir nuestros planes para ir de aventura... ¿Podrías decirle que cambiemos de día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100911
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100911,
					"content": "Si no me equivoco, debe estar en el <color=#00E1FFFF>Templo de la Leona</color>. Hoy iba a ir de aventura con Stanley.",
