			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#¡Mira, {NICKNAME}, por allá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "¿Está ahí parada a solas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "¿Por qué parece como si estuviera hablando y riéndose con alguien? ¡Oh, Paimon tiene miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "#Yo también tenía un amigo imaginario cuando era pequeñ{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#¿Qué? ¿O sea que tú también hacías eso, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Ehm... Entonces, ¿es... un amigo invisible que a veces sale contigo? ¿O simplemente existe en tu imaginación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "“Imaginario” significa que está “dentro de tu imaginación”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Un amigo... imaginario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "Oh, quieres decir “amigo imaginado”, ¿verdad? ¿Por qué no lo dijiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "Entonces, ¿cuándo podrá Paimon conocer a tu “amigo imaginario”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Hace tiempo que no aparece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "¿En serio? Entonces, ¿los amigos imaginarios... desaparecen cuando creces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Oh... Paimon estaba ansiosa por conocer al tuyo... Oye, ¿crees que tu {M#hermana}{F#hermano} también tenga un amigo imaginario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Seguramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "¿En serio? Qué afortunados son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "¿Has oído hablar de un juego muy popular en Liyue? Es un juego de cuatro jugadores, ¡pero ustedes dos podrían jugarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "#¡Viajer{F#a}{M#o}! Qué gusto verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "¡Bardo de pacotilla! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Jaja, vine porque últimamente Lisa ha estado haciendo artilugios muy interesantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Si Lisa dice “interesante”, no puede significar nada bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Oye, ¡esa no es forma de hablar de la elegante Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Para este artilugio en particular, Lisa tuvo que importar unos materiales peligrosos de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "¿Dijiste “peligrosos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "¿Un monóculo equipado con una especie de... detector?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "¡Así es! Parece un monóculo, pero en realidad se llama “detector de nirnama”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Lamentablemente, Lisa no puede usarlo por sí misma, así que lo tomé prestado... Y también le ayudo a probarlo para ver si realmente funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "¿Eh? ¿Por qué no puede usarlo Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Humm... ¿Quizás porque carece de la inocencia propia de un niño? O tal vez hay alguna otra razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "#Si quieren saberlo, pregúntenselo ustedes mism{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "Entonces, ¿tú también puedes verlos? Cuéntanos, ¿cómo es ese amigo imaginario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Jaja... Eso no se lo puedo decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "#De todos modos, ahora es todo tuyo, viajer{F#a}{M#o}. Echa un vistazo, a ver si puedes ver al amigo imaginario de Nora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "¿Lo ves? ¿Lo ves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Guau, ¡funciona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Como pensaba, tú también lo puedes usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "¡Paimon también quiere ver! Espera, este artilugio no es del tamaño de Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#Muy bien, ¡entonces tendrás que ser los ojos de Paimon, {NICKNAME}! Veamos cómo son los amigos imaginarios de <color=#00E1FFFF>los demás</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "¡Sí! Parece que son buenas amigas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "A mí me parece un monóculo normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "¿Verdad? Sin embargo, al parecer, se llama detector de nirnama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Lamentablemente, sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Se volvió invisible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "“En tu imaginación” significa que es “imaginario”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Imaginación... imaginario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Ahí está. El amigo imaginario de Flora: ¡un floti floti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Entonces, ¿los amigos imaginarios también pueden ser plantas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "#Jeje, hola viajer{F#a}{M#o}, hola bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Hola, Flora. ¿Puedo hacerte una pregunta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Por supuesto. ¿En qué te puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "¿Qué es eso que está a tu lado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "¿Eh? ¿Te refieres al Sr. Floti? La mayoría de la gente no puede verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "El Sr. Floti es mi mejor amigo. ¡Crecimos juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(*Grr*... ¡No es justo! Paimon odia sentirse excluida...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora, ¿por qué eres amiga de un floti floti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "¿Qué tiene de malo? Siempre quise ser amiga de una planta que pudiera volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "¿Ser amiga de una planta voladora? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Jeje, porque cuando hace viento, ¡podríamos volar juntos por el cielo! Reconócelo, sería genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "¡Más bien, el viento te mandaría a volar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Jeje, bueno, eso es lo que suele decir la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100223
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100223,
					"content": "Conocí esta planta por una historia que me contó un explorador sobre una de sus aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100224
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100224,
					"content": "Creo que se llamaba... ¡Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100225,
						101100226
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100225,
					"content": "Oh, conozco a Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100227,
					"content": "Stanley es un aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100228
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100228,
					"content": "Por las historias que cuenta, ¡se podría decir que es todo un experto aventurero! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100229
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100229,
					"content": "¡Las “increíbles aventuras de Stanley” son superfamosas en Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100230
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100230,
					"content": "Creo que se encuentra en la ciudad en este momento. Deberías ir a pedirle que te cuente alguna de sus historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100231,
					"content": "¡Suena divertido! Pero mejor lo dejamos para otra ocasión. Ahora mismo, tenemos otros asuntos que atender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100226,
					"content": "No me suena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
