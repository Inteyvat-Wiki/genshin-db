				{
					"id": 101100314,
					"content": "Sí, la de explorar el área de enfrente más tarde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100315
					]
				},
				{
					"id": 101100315,
					"content": "¿En serio? De acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100316,
					"content": "“¿Qué tal si exploramos el área de enfrente más tarde?”",
