					"nextDialogs": [
						101100710
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100710,
					"content": "¿Siempre estás entrenando aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100711,
					"content": "Así es. Hoy escuché a Stanley hablar sobre sus aventuras. ¡Fue increíble! Me motivó mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100712
					],
					"speakerTitle": "Ellin"
				},
				{
