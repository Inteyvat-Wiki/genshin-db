			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "¡Ya has regresado! ¿Has conseguido esas imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "Guau... Son muy buenas imágenes, mucho mejores que las que toma mi ayudante. Siempre que necesitamos que capture imágenes como referencia en las mediciones del terreno, tarda un buen rato en conseguir una adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Si me acompañaras tú a medir el terreno, se nos romperían muchos menos Daguerrotipos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "¿De verdad podrás escribir un poema basándote en estas imágenes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Eso creo... Sí. Ay, si no lo logro, al menos usaré estas imágenes como postales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Escribiré buenos deseos en el reverso y las enviaré al Ministerio de Asuntos Civiles. Así, cuando esos tipos reciban sus regalos, ¡no podrán quejarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "*Ejem*... Pero eso es solo como último recurso. Mientras tanto, tendré que buscar la manera de escribir un buen poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Los vientos de las cinco tribus se alzan... No, soplan... Espera, ¿cuántas tribus tenía Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503210,
