					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "¡Ya sé! He oído que los letreros de las tiendas del Pueblo de los Manantiales son muy especiales. En particular el de un establecimiento llamado “Cabaña Musical Yembé”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "¿Podrías tomar una imagen de la Cabaña Musical Yembé por la mañana para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503211,
			"completionStepIds": [
				2503201
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
