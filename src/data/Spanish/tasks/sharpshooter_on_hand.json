	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Humm... La poesía surge de una imagen... No, no. Más bien sería plasmar una imagen con la poesía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Eh... Parece que tampoco es eso. Las dos frases significan lo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "¿De qué hablas? ¿Son versos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Ah, hola. Así es, estoy intentando escribir un poema sobre los paisajes de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Pero... A decir verdad, los paisajes son muy diferentes a los de Liyue, y tampoco sé mucho sobre la historia de Natlan, así que no sé por dónde empezar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Además, tampoco soy un poeta profesional. Apenas sé rimar ni componer quintillas jocosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "*Suspira*, pero ya que he salido a darme una vuelta, no puedo volver con las manos vacías. Mis compañeros del Ministerio de Asuntos Civiles me tomarán el pelo y dirán: “¿Saliste a buscar inspiración o a que te diera el aire?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "¿Trabajas en el Ministerio de Asuntos Civiles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Podría decirse que sí. Me contrataron hace poco en el Ministerio de Asuntos Civiles para realizar mediciones del suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "Ay, en realidad se trata de llevar a alguien a Liyue a comprobar si hay algún cambio en el terreno y modificar los mapas si es necesario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Después de terminar la ronda quedé extenuado, ni siquiera sé cuántos pares de zapatos se me rompieron por el camino... Así que pedí algunos días de vacaciones para relajarme un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "Es solo que... en la solicitud escribí que pedía las vacaciones para buscar inspiración y escribir poesía. No sé en qué estaba pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "No había imaginado que la persona encargada de aprobar las vacaciones del Ministerio de Asuntos Civiles me contestaría deseándome buena suerte con mi poesía... Ni que me concedieran medio mes de vacaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "¿Y eso no es bueno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "¿Bueno? Supongo que sí, pero ahora todos en el Ministerio de Asuntos Civiles saben para qué pedí vacaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "Ay, es cierto que Natlan es un lugar emocionante con paisajes hermosos, buena comida y todo tipo de criaturas interesantes, en especial esos adorables saurios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Pero hasta el momento no he conseguido escribir ni un solo verso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Ni siquiera me ha servido de nada el Daguerrotipo que tomé prestado para reunir material de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "No tengo problema con las imágenes de paisajes, pero no se me da nada bien tomar imágenes de tiendas o multitudes, siempre me quedan borrosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Bueno... ¿Quieres que te ayude?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "¡¿De verdad?! Gracias a Los Siete, por fin alguien se ofrece a ayudarme... Tengo que reunir materiales que me sirvan de inspiración para escribir mi poesía sea como sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "A mí se me da muy bien tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "¿Y has encontrado la inspiración para tu poesía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "No. Pero... la noticia de mis vacaciones y el objetivo de las mismas se ha extendido como la pólvora. ¡El Ministerio de Asuntos Civiles entero sabe que vine a Natlan en busca de inspiración!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "¿Estás escribiendo un poema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
			"completionStepIds": [
				2503206,
