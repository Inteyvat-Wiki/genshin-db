			"dialogs": [
				{
					"id": 741140301,
					"content": "#¡Es {F#la}{M#el} mejor, {NICKNAME}! ¡Confío en usted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140302,
					"content": "Si no fuera por su ayuda, la caja entera de kinografías se habría echado a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140303,
					"content": "Tenemos que volver a la ciudad para entregar estas kinografías al señor Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140304,
					"content": "#Y de paso, comeremos allí. {NICKNAME}, ¿le apetece venir con nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140305,
					"content": "Cuando terminemos de comer, le daré la paga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140306,
					"content": "Estupendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "¡Genial! Pues en eso quedamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, tú te encargarás de llevar la caja de kinografías al señor Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, tú... vas a comprar ingredientes por la zona. Últimamente estoy ensayando con la sopa de Poisson. Aprovechando esta oportunidad, el señor Geisert podrá degustar mi cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140311,
					"content": "Jefa, si vamos a un restaurante a comer, ¿por qué tienes que cocinar tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Porque sale más rentable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140313,
					"content": "*Ejem*, vamos, ¡manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, venga conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140307,
					"content": "Claro, justo me estaba entrando hambre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
