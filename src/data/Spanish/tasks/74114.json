			"dialogs": [
				{
					"id": 741140401,
					"content": "Qué olla más peculiar... Ehmm... Supongo que... ¿se usará como las de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140402,
					"content": "Jefa, ¡ya tengo los ingredientes! Pero ya no quedaban jazmimpolutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "Y tampoco he encontrado otra tienda que los tenga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#Ay, solo me faltaría ese ingrediente... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140405,
					"content": "Voy a por ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Gracias por la ayuda. No se preocupe, sé cómo son las reglas en el Gremio. No saldrá gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140406,
					"content": "Súmelo a la paga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
