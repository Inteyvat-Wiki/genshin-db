			"dialogs": [
				{
					"id": 741140101,
					"content": "No pasa nada, nuestra caja es impermeable. Solo tenemos que bajarnos al agua y sacar la caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140102,
					"content": "Pero jefa, nadie de aquí sabe bucear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Yo sé nadar, pero bucear... no doy la talla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Ehmm... El encargo que publicamos en el Gremio de Aventureros, ¿aún sigue colgado ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140105,
					"content": "¿No nos habías pedido que lo retiráramos de inmediato, jefa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Lo hicimos ayer. El gremio ha dicho que hoy pueden devolvernos el pago adelantado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Ehmm... Si volvemos a publicar un encargo, ¿nos cobrarán gastos adicionales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140108,
					"content": "¿Han terminado de filmar la kinografía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#¡Hombre! Si es nuestr{F#a}{M#o} aventurer{F#a}{M#o} {NICKNAME}, ¡vino en el momento más oportuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140111,
					"content": "¿Sabe bucear? ¿O conoce a algún buceador que tenga tiempo para ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140112,
					"content": "Acaso quieren... ¿filmar una kinografía debajo del mar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "No somos tan hábiles y tampoco tenemos suficiente dinero como para comprar esos aparatos kinográficos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "Solo queríamos recuperar la caja donde guardamos las kinografías, la cual ha caído en el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#¡No hacía falta dar tantos detalles! {NICKNAME}, ayúdenos, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140116,
					"content": "En cuanto a la remuneración, no se preocupe, le pagaremos como la otra vez, nada más terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140109,
					"content": "¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
