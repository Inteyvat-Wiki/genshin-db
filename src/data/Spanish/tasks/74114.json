			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, le presento al maestro de la kinografía, el señor Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140602,
					"content": "#Señor Geisert, est{F#a}{M#e} es {NICKNAME}, {F#una}{M#un} aventurer{F#a}{M#o} competente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140603,
					"content": "#Si en un futuro desea filmar una kinografía de acción, ¡{NICKNAME} podría ser sin duda {F#la}{M#el} protagonista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140604,
					"content": "Jaja, la directora Chiu está exagerando, no soy ningún maestro de la kinografía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Solo tengo cierta experiencia en el manejo de las luces y las sombras para filmar kinografías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Ayayay, está siendo muy modesto. La iluminación de sus kinografías son excesivamente cautivadoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140607,
					"content": "¿El manejo de las luces y las sombras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Sí. En mis teorías de la kinografía, si controlas el tono de la luz y la sombra, puedes regular las emociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Pero... es una lástima que en el mundo kinográfico de Fontaine, mis teorías aún no hayan sido reconocidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "A la mayoría de los directores les gusta más representar las historias de una forma más directa, a través de los movimientos o los escenarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Filmé varias kinografías basadas en la representación por medio de la luz y la sombra, prácticamente a nadie le interesaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Hasta que por fin, una directora llegó a valorar mis teorías de las luces y las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "¿Directora? ¿Yo? Jajaja, no bromee. Solo soy una comerciante de té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140616,
					"content": "¿Quién dijo que una comerciante de té no podría llegar a ser una directora? Antes, yo era un reportero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Reportero... Entonces, ¿también se le daba muy bien escribir reportajes? Como los que salen en el periódico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140618,
					"content": "Digamos que sí. ¿Por?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Oh... Mira qué bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140620,
					"content": "¡Ah! ¡Nada, nada! Tendremos muchas oportunidades para colaborar juntos, ¡¡jajaja!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140621,
					"content": "Todos toman asiento ante la risa franca de la directora Chiu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Después de la comida, la directora Chiu prepara otra ración y la pone en tu mochila.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "¿Las luces y las sombras son muy importantes en la kinografía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Por supuesto. En mis teorías de la kinografía, los tonos de las luces y las sombras son una herramienta importante para expresar las emociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
