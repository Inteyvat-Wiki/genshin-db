			},
			"dialogs": [
				{
					"id": 741140201,
					"content": "*Suspira*, ¿las kinografías no se estarán mojando?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 741140202,
					"content": "Tranquila, jefa, la caja es lo suficientemente resistente. El agua no va a entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "Menos mal que nuestro kinetoscopio no se ha caído, porque si no... La habremos liado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
				}
			]
		},
