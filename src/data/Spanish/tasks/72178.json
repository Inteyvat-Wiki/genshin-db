					]
				},
				{
					"id": 721780504,
					"content": "(Este altar está en ruinas. La fachada de madera está llena de orificios. Al decolorarse, revela unos surcos rojo oscuro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
