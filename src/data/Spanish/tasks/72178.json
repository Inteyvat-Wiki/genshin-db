			"dialogs": [
				{
					"id": 721780101,
					"content": "(Parece un altar ordinario, no hay rastros elementales extraños.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780102,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Parece que este altar está en buenas condiciones, y le han dado mantenimiento en días recientes. Quien sea que lo haya hecho, debe ser una persona muy atenta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780104,
					"content": "(Fuera de eso, no hay rastros de nadie más aquí.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780105,
					"content": "Qué extraño... Es como si alguien hubiera estado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
