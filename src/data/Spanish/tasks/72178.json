			"dialogs": [
				{
					"id": 721780401,
					"content": "¿Será este el altar al que se refería Chouji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Parece un altar ordinario, no hay rastros elementales extraños.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780403,
					"content": "Observar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(El altar es sencillo pero elegante. Su madera brilla ligeramente y recibe a los visitantes y sus ofrendas con un silencio solemne.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780405,
					"content": "(Alrededor del altar hay muchos pétalos del Cerezo Sagrado. No parece que hayan acabado ahí de manera natural, sino que alguien los esparció intencionadamente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780406,
					"content": "Bueno, aquí tampoco hay rastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Mira, pétalos de cerezo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Ah, claro. ¡Chouji mencionó que su mamá realizaba este tipo de ofrendas en el altar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "No puede ser una coincidencia que haya tantos pétalos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "¡Volvamos a contarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "Es la ofrenda de la madre de Chouji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
