					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Este altar está limpio, y desprende un leve aroma a Cerezo Sagrado. Alguien ha orado aquí recientemente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780205,
					"content": "(Fuera de eso, no hay rastro alguno.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780206,
					"content": "Este aroma es... ¡el Cerezo Sagrado! ¡Quizás la madre de Chouji estuvo aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "¡Y no hace mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
