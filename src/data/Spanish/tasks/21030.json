				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng",
					"Maestro Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "¿Eh? ¿Estos dos minerales no son iguales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300102,
					"content": "¡Por supuesto que no! La calidad y el precio de los objetos creados con estos minerales son completamente diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300103,
					"content": "Pero... ¿cómo es que queda tan poco de estos dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300104,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300105,
					"content": "¿Qué están haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Hola, viajer{F#a}{M#o}. Estoy ayudando a mi papá a revisar los utensilios de hierro que encargó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300107,
					"content": "¡El señor herrero es muy bueno! ¡Dijo que también forjaría una espada pequeña para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300108,
					"content": "Pero me contó que últimamente no tiene suficientes materiales, así que es posible que los objetos que quiere papá se retrasen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300109,
					"content": "Y tampoco sé cuándo estará lista mi espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300110,
					"content": "*Suspira*... No hay mucho que podamos hacer. Últimamente hemos estado muy ocupados y nos quedamos sin mineral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300111,
					"content": "Y las zonas en las que abundan los minerales están llenas de monstruos, así que no me atrevo a ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300112,
					"content": "Primero tengo que acabar los pedidos pendientes que tengo ahora y después buscaré un aventurero que me acompañe a un lugar donde pueda minar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300113,
					"content": "Pero ¿cuándo será eso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300114,
					"content": "#Oye, {NICKNAME}, tú eres buen{F#a}{M#o} luchando contra los monstruos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300115,
					"content": "Si es así, ¿podrías ayudarnos? ¡Por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300116,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#Viajer{F#a}{M#o}, ¿irías a inspeccionar la zona? En ese caso, marcaré en tu mapa los lugares donde suelo buscar minerales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300119,
					"content": "Estos son. Ten cuidado cuando estés allá, hay muchísimos monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300120,
					"content": "#¡Cuento contigo, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300117,
					"content": "Veré qué puedo hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
