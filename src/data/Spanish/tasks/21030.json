				"points": []
			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "#¿Cómo van las cosas por allá, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300202,
					"content": "Ahora el lugar es seguro, por el momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "¡Eres increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300204,
					"content": "Papá dice que contratará a unos cuantos escoltas para que nos protejan durante nuestro viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300205,
					"content": "#Espero que sean tan buenos como tú, viajer{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300206,
					"content": "Señor herrero, ¿entonces ahora puede ir a recoger minerales y hacer los utensilios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210300207,
					"content": "Jajaja, ¡por supuesto! Me prepararé y saldré enseguida. ¡Traeré esos minerales y continuaré con mi trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300208,
					"content": "Pero yo solo no puedo cargar con tantos... Con suerte, no habrá ningún monstruo en la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro Zhang"
				}
			]
		},
