				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "¡No hay tal cosa como un plan perfecto cuando estás en una aventura! ¿Cómo vas a progresar si sigues pensando así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200470102,
					"content": "Si el plan no es perfecto, ¡entonces debemos estar preparados para cualquier imprevisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "¿De qué están discutiendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Verás, estamos planeando explorar el <color=#00E1FFFF>Templo de los Mil Vientos</color>, pero la Sra. Patxa no tiene ninguna experiencia en aventuras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "El interior del templo está lleno de monstruos últimamente, sin mencionar al aterrador Guardián de las Ruinas en la entrada... Solo arriesgaremos nuestras vidas si nos precipitamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Solamente trato de garantizar la seguridad de la Sra. Patxa. Bueno, está bien, la de ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Estoy tratando de persuadirla de los beneficios de idear un plan meticuloso e infalible para esta aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Pero me temo que si comenzamos con un reconocimiento básico cerca de los terrenos del templo, Patxa se emocionará demasiado y se lanzará a la carga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Necesito quedarme aquí y vigilarla. ¿Podrías ir a examinar el área por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "¡Maravilloso! Pero asegúrate de observar todo cuidadosamente. Un solo detalle pasado por alto podría significar el fracaso de nuestra aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Pase lo que pase, necesito que me cuentes todo al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "¿Por qué no vigilo a Patxa por ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "No, ¡no funcionaría! Yo, eh... Hay todo tipo de detalles en el plan actual que todavía necesito revisar con ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Ayúdame a buscar pistas. ¡Por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
