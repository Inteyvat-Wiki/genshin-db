			"dialogs": [
				{
					"id": 200470201,
					"content": "¿Encontraste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470202,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "¡Por favor, todo depende de ti! El éxito o fracaso de la aventura está en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
