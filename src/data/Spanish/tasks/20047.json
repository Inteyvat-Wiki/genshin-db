			},
			"dialogs": [
				{
					"id": 200470301,
					"content": "¿Nada aún? ¿Nada en absoluto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470302,
					"content": "Descubrí algunas cosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "... Ya veo, ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "Básicamente es así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Esta es una excelente noticia. Maravilloso. ¡Fantástico! Gracias, toma esto por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "¡Sra. Patxa! Ha habido un cambio importante de plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		}
