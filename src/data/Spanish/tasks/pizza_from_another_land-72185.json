			"dialogs": [
				{
					"id": 721850201,
					"content": "*Suspira*... ¿Hay algo en el mundo que satisfaga mis papilas gustativas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "Es sobre la pizza del Restaurante Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Oh, la pizza que mencionaste sabe muy bien, y tiene muchos ingredientes locales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Sin embargo, también he probado la auténtica pizza de champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Recuerdo que tenía queso, repollo y champiñones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Jajaja, es solo que, creo que un plato exótico debería conservar su sabor auténtico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
