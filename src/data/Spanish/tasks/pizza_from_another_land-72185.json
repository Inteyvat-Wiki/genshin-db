				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#Viajer{F#a}{M#o}, regresaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "¿Y bien? ¿Le preguntaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "Sobre la opinión de los clientes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "Una pizza de champiñones auténtica... Humm, podría intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Los ingredientes que necesitamos son queso, repollo y champiñones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "A excepción del queso, normalmente tenemos los demás ingredientes en inventario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "#Viajer{F#a}{M#o}, ¿te molestaría conseguirme un pedazo de queso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Cuento contigo. Con un pedazo de queso es suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "¿De verdad no tienen usan queso en esta tienda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "No es que no lo usemos, pero no solemos hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Después de todo, no hay muchos ingredientes en la tienda que necesiten queso, así que no tenemos mucho en existencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "#En fin, cuento contigo, viajer{F#a}{M#o}. Por favor, tráeme un pedazo de queso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
