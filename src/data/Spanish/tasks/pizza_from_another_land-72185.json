						721850502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850502,
					"content": "Una pizza de champiñones auténtica de Mondstadt... Me pregunto si podré hacerla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850503,
					"content": "¡Listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850504,
					"content": "Esta pizza... no está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850505,
					"content": "#Gracias por tu ayuda, viajer{F#a}{M#o}. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850506,
					"content": "Me aseguraré de probar qué tal sabe esta pizza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850507,
					"content": "Si sale bien, debería lanzarla como el nuevo producto oficial.",
