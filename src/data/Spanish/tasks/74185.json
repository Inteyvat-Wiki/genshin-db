			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "Jeje, ¡mira, Osifuz! ¡Esta será tu casa a partir de ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "¿Miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741850303,
					"content": "Aun así, todo esto es muy raro. Si Casiodoro ya no está, ¿entonces quién es Osifuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "¿El gato original antes de ser poseído por Casiodoro, o el Os con quien hemos vivido una gran aventura? Humm, Paimon está hecha un lío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Déjalo, Paimon, pensar no es lo tuyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "¡Es que Paimon no entiende nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "En fin, al menos hemos encontrado una casa para Osifuz. ¡Cuando tengamos tiempo, tenemos que venir a jugar con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741850307,
					"content": "Osifuz es Osifuz, y ya está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Paimon no entiende nada, pero tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
