			"dialogs": [
				{
					"id": 741850101,
					"content": "¡Est, ya estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oooh, pero si son... Ah, no, ¿quiénes son ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850103,
					"content": "#¿Eh? ¡Somos {NICKNAME} y Paimon! ¿Es que no nos reconoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} y Paimon... Sí, me suenan de algo esos nombres, ¡pero juraría que los escuché en un sueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850105,
					"content": "Humm, pero si estabas totalmente despierto cuando nos conocimos, Est. Además, cuando estábamos ahí abajo, ¿acaso no vimos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*Suspira*, soñé que toda la gente del pueblo menos yo se había convertido en estatuas de piedra, y no sabía qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850107,
					"content": "#Entonces llegaron dos {F#heroínas}{M#héroes} que tenían como misión salvar a todo el mundo. Un momento... ¿es que no fue un sueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850108,
					"content": "Tal vez sí, tal vez no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Sí, lo importante es que todo el mundo ha vuelto a la normalidad, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Sí, pero parece que todos tuvieron sueños extraños. ¿Qué habrá pasado? ¿Es que nos hipnotizaron a todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850112,
					"content": "Necesitaríamos más de un día para contártelo todo... En fin, ¡de momento olvida eso de la hipnosis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Hablando de hipnosis, ¿han hipnotizado a ese gato para que vaya con ustedes? ¡Parece muy inteligente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850114,
					"content": "Lo es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "#Ha sido nuestro compañero, pero no podemos llevarlo de viaje con nosotr{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Pues qué casualidad, porque en el club tenemos una caseta de sobra para gatos. Está libre desde que el investigador que estudiaba la hipnosis se llevó a su gato consigo de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850119,
					"content": "Si quieren, podrían dejarlo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850120,
					"content": "Por alguna razón, siento que el destino ha querido unirnos, así que cuidaré muy bien de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741850121,
					"content": "La caseta está al otro lado del edificio, la encontrarán enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Est"
				},
				{
					"id": 741850116,
					"content": "Es compañero nuestro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "#Sí, pero no podemos llevarlo de viaje con nosotr{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Eso no importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
