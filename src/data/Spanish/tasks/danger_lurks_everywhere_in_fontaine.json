			},
			"dialogs": [
				{
					"id": 748000501,
					"content": "Cierto, tienes toda la razón... Cabe la posibilidad de que eso suceda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000502,
					"content": "Se te va a enfriar el café.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Casi me terminé la bebida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Está bien, gracias, {NICKNAME}. Gracias por haberme escoltado todo el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000505,
					"content": "#¿Escoltarte?... En realidad nosotr{F#a}{M#o}s solo hemos caminado a tu lado, no hemos hecho nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "No ha ocurrido nada malo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "No tuvimos que enfrentar ninguna amenaza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Así es. Parece que estaba pensando demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000509,
					"content": "Este café está muy rico, jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000510,
					"content": "... ¿Tú crees que alguien podría haber puesto veneno en mi café?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000511,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "(Lo que hay que oír...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "¿De dónde has sacado esa idea? Si ya casi nos lo hemos terminado... y no ha pasado naaada de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "No, no, no, quizá hay una... forma especial de añadir el veneno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000515,
					"content": "Primero, el autor del crimen ha disuelto el veneno en nuestro café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000516,
					"content": "Pero ese veneno por sí solo no sería suficiente para provocar un efecto en la víctima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000517,
					"content": "Una vez hayamos terminado nuestras bebidas, el autor del crimen nos seguirá allá donde vayamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000518,
					"content": "Esperará a que nos hayamos dormido, y entonces se colará en la habitación para echar la segunda dosis de veneno en el interior de nuestra cantimplora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000519,
					"content": "Entonces, cuando al día siguiente salgamos de casa y bebas de la cantimplora, los dos tipos de veneno surtirán efecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000520,
					"content": "#Y luego nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000599,
					"content": "De repente, escuchan unos pasos que se acercan apresuradamente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "¿De qué habla esta clienta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "¿Café? ¿Envenenado? Oiga, no haga ese tipo de bromas en mi cafetería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Si los otros clientes llegan a escucharle, ¡tendré que pedirle que salga de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Jefe, déjeme que se lo explique...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "¡Oye, que es mi amiga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Le explicas a Arouet la situación de la Srta. Guijarro. Entonces, se marcha sin tener más remedio.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "A modo de disculpa, la Srta. Guijarro compra otras tres tazas de café...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Has visto con tus propios ojos cómo el mesero preparaba el café, no pensarás que le habrá echado algo...",
					"roleType": "TALK_ROLE_NPC",
