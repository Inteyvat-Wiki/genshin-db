			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "¿Qué haces otra vez escondiéndote? En esta zona no hay nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "#¿No han visto ese Mecagendarme de ahí? ¡Está justo delante de nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000403,
					"content": "Y... ¿qué pasa con él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Uff, vayámonos de aquí cuanto antes. ¿Qué pasa si de repente pierde el control y se vuelve loco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000406,
					"content": "O... quizás su núcleo acabe explotando de repente... ¡o tal vez haya alguien controlándolo a distancia para que nos ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000407,
					"content": "Yo veo que funciona con normalidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Es una de las cosas que más temo. Que un dispositivo que aparentemente funciona con normalidad acabe asesinando al primer inocentón que pase por su lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000409,
					"content": "Nadie podría hacerse responsable de un accidente así, hasta sería imposible encontrar a la mente criminal que ideó todo el plan... ¡Esos cachivaches son todo un peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000410,
					"content": "Ya se ha ido, puedes salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Oh, de verdad no se ha vuelto loco. Eso sí que no me lo esperaba. Siento como si hubiéramos vuelto a renacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000412,
					"content": "Es prácticamente imposible que pueda suceder algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Yo me estaba refiriendo a... un “accidente provocado por humanos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000415,
					"content": "Un momento. Si no hay ninguna mente criminal organizadora del crimen, entonces nadie podría responsabilizarse del delito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000416,
					"content": "¡Eso es! ¡Me vino la inspiración! ¡Rápido, vamos! Vayamos a una cafetería, ¡tengo que apresurarme a escribir sobre esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 748000417,
					"content": "Oye, ¡no corras tanto! ¿No te asusta que alguien pueda tirarte una piedra a la cabeza para que te quedes inconsciente de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Ha funcionado a la perfección en todo momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Oh... ¿Entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
		{
