					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "*Fiu*, ¿ya se acabó? ¿Aquellas voces venían de estos dos muñecos? ¿Se trata de algún tipo de juguete nuevo? Qué lindos, ¿dónde podría...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Ay, no, no, eso no es lo importante ahora. Qiqi, vayamos a buscar primero al Dr. Baizhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#Sí, es la hora... Tengo que irme. Hasta... la próxima, {NICKNAME}... y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
