					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "¿Te acordaste de algo, Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Oh... Eh... Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Tranquila, no hace falta que te disculpes. Todavía queda un trecho hasta el Palacio Mermonia. Sigamos caminando. Estoy segura de que pronto recordarás dónde está tu casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "#¡{NICKNAME}, mira! ¡Es Qiqi! Vaya, está con una melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah... {NICKNAME}, y Pai... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Hola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "¿Conocen a Qiqi? ¡Qué suerte! Me la encontré mientras estaba investigando un caso cerca del Puerto Lumidulce... A juzgar por su tamaño, debería ser una niña humana... Es una niña, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Soy... soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "¡Es nuestra amiga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "#¡A-así es! Nos conocemos desde hace mucho tiempo. ¡Somos muy buen{F#as}{M#os} amig{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Jeje, menos mal que reaccionaste rápido. Si Qiqi hubiera dicho que es una zombi, la melusina se habría llevado un buen susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "#Sí... Buen{F#as}{M#os} amig{F#as}{M#os}... Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Qué coincidencia más fortuita. Para ser sincera, es la primera vez que me encuentro tan perdida sin saber qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Como ya sabrán, le falla un poco la memoria. Parece que le cuesta recordar cualquier otra cosa que no sea su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Sí, le suele pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Pobrecita. Tenía pensado llevarla a la Gendarmería Fantasmal para dejarla a buen recaudo, y de paso ver si Qiqi lograba recuperar algunos recuerdos por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "#Ya que son sus amig{F#as}{M#os}, supongo que sabrán dónde vive, ¿verdad? Podría llevarla directamente hasta su casa, así nos ahorraríamos muchos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Sí, sabemos dónde vive. Pero, eh... está superlejos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Super... ¿lejos? Yo seguí a un Seelie y... llegué al Puerto Lumidulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "¿Eh? ¿Te acordaste de algo? ¿Y qué pasó antes de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Antes... El Dr. Baizhu me llevó con él a ver a sus pacientes al Puerto Yi... Eh, Yi-nosequé. Fui a recoger hierbas, y luego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "¡Ah! Te refieres al Puerto Yilong, ¿verdad? La gran detective Paimon ya sabe qué fue lo que pasó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu llevó a Qiqi consigo para ver a sus pacientes en el Puerto Yilong, y Qiqi se perdió mientras recolectaba hierbas por la zona. Entonces, se encontró con un Seelie y lo siguió hasta llegar al Puerto Lumidulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Jeje, menos mal que {NICKNAME} y Paimon se han leído «El detective y el ladrón». ¡Este tipo de deducciones tan sencillas son pan comido para Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Sabes que ese libro es completamente ficticio, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "¡Ajá! Eso lo explica todo. Entonces, ¡llevaré a Qiqi de vuelta al Puerto Yilong ahora mismo! El Dr. Baizhu es su tutor legal, ¿verdad? ¡Seguro que estará muy preocupado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Espera, Qiqi está entre las personas de la profecía de Barbeloth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "¡Es verdad! A Paimon casi se le olvida ese asunto. ¡BARBELOTH! ¿Estás ahí? ¡¿Nos oyes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "No hace falta que grites tanto. Llevo aquí todo el tiempo y no quería interrumpir su conversación. Escuchar está en el instinto de toda buena adivina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "La guía de ese Seelie bien podría considerarse una guía del destino. Jiji... Ya que has llegado hasta aquí, Qiqi, ¿por qué no dejas que te lea la fortuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "¿For... tuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Barbie, querida, perdona que te interrumpa. La verdad es que no se te da muy bien hablar con los niños. Estás asustando a la pobre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Déjame a mí. Mira y aprende: así es como se debe entregar una sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "*Ejem*. Hola, pequeña Qiqi, eres miembro del Miniaquelarre, ¿verdad? Soy la mamá de tu aliada Klee, la bruja más increíble del mundo: ¡la tía Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Hola, tía Alice. Encantada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Qué niña tan linda y educada. Ven aquí, deja que la amiga de la tía Alice te prepare una ceremonia sorpresa de adivinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "¿Ceremonia... de adivinación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "¡Exacto! Mira las cartas que tienes delante, ¿a que son bonitas? ¿Te gustan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Sí... Me gustan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Estupendo. ¿Podrías escoger una para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Humm... ¿Esta puede ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "¡Por supuesto que sí! Como te has portado tan bien, ¡te puedes quedar con esta carta como premio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "... ¿G-gracias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Bueno, Barbie, se acabó tu tiempo de descanso. Te toca a ti interpretar esta carta para la pequeña Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Deja de sacudirme... Estoy despierta, ¡he estado escuchando toda la conversación! Oh, es El Colgado al derecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Son pocos los que logran sacar esta carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Eso quiere decir que eres muy especial, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Simboliza la trascendencia y la espera, y también implica un distanciamiento de lo mundano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Hay cadenas que te atan, pero tú no quieres liberarte de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Las cadenas... ¿Son mis órdenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "En apariencia, no es incorrecto que lo entiendas de esa manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "En cuanto a tu futuro, lo único que tienes que hacer es esperar. No es que te falte tiempo, pero... Vaya, qué extraño, qué extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "¡Espera, espera! Estás diciendo demasiadas cosas de golpe. Dale un respiro a la pobre niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Primero dejemos que Qiqi disfrute en paz del regalo que tiene en sus manos. Hay que tener paciencia con los niños y darles un poco más de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "¿Qué te parece, Qiqi? ¿Te ha gustado esta sorpresita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Esta carta es bonita... Gracias, tía Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "¡Ay, qué adorable! Te has acordado de mi nombre, ¿eh? Muy bien. Me encantaría seguir charlando contigo un ratito más, pero es hora de que vuelvas a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Si la tía Barbie tiene algo más que decir, la próxima vez que el Miniaquelarre se reúna, ¡podría hacerle una predicción a cada brujita! Sería maravilloso, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
