					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "... ¿Quieres dejar de aumentar mi carga de trabajo sin pedirme permiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "#¡Decidido! Nos vemos en otra ocasión, Qiqi, y también l{F#a}{M#o}s demás testigos.",
