				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150901,
					"content": "Muñecas, cometas, molinos... Obviamente me tenía que regalar estas cosas de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150902,
					"content": "*Suspira*, es una pena que no haya podido enviarle mis regalos también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150903,
					"content": "Yo se los llevaré por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "¿Me ayudarás? Bueno... Aunque tampoco tienes una Visión, parece que esos monstruos no son nada para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150905,
					"content": "Si se los llevaras tú, te estaría muy agradecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150906,
					"content": "*Suspira*, ojalá pudiera ser tan fuerte como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Liu"
				}
			]
		},
