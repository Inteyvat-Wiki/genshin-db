						708151202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151202,
					"content": "Quiso que te diera esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151203
					]
				},
				{
					"id": 708151203,
					"content": "Esto... ¿es de mi pequeña Liu? ¿Es para mí? ¡Cuántos hay! ¿Cuánto habrá trabajado para conseguir esto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151204
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151204,
					"content": "Me dan ganas de dejarlo todo y volver a la Aldea Chingtsé ahora mismo. Pero el Ministerio de Asuntos Civiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151205,
					"content": "Muchas gracias. Acepten esto como agradecimiento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151206,
					"content": "*Suspira*, no tengo ni idea de cuándo acabará todo esto, ni tampoco cuándo el Ministerio aprobará mis vacaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
