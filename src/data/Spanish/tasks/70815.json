			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeña Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "¿Estás aquí para llevarme de vuelta a la Aldea Chingtsé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150702,
					"content": "La Abuela Ruoxin está preocupada por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "¡Hum! Así que sí estás aquí para llevarme de vuelta. Pues que sepas que no voy a volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150706,
					"content": "Vuelve y dile a los aldeanos que voy a Liyue a buscar a papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150707,
					"content": "No tienen que preocuparse. Una vez que lo encuentre, hablaré con él un rato y luego volveré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150704,
					"content": "Tengo algo que es para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "No voy a dejar que me sobornes. No quiero nada tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Pequeña Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeña Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "¿Se puede saber por qué me sigues? ¡Te dije que voy a Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150802,
					"content": "Yo misma evitaré los monstruos. No me atraparán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150803,
					"content": "¡No me trates como si fuera una niña! ¡Ya soy mayor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150804,
					"content": "Esto es de tu papá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "¿De papá? ¿Te dijo que me lo dieras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150806,
					"content": "Seguro que son juguetes para niños... Siempre me regala o cometas, o muñecas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150807,
					"content": "¿No te gustan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "Claro que me gustan. Son regalos de papá, ¿cómo no van a gustarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150809,
					"content": "Pero si me siguen gustando, ¿no quiere decir que siempre seré una niña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150810,
					"content": "Si sigo jugando con esos juguetes, ¿cuándo me convertiré en una aventurera, o cuándo tendré mi propia Visión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150811,
					"content": "¿Para qué quieres una Visión?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Si tuviera una Visión, podría hacer tantas cosas... Como ganar dinero y muchas cosas más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150813,
					"content": "Entonces, papá no tendría que trabajar en Liyue todo el tiempo. Podría volver y pasar tiempo conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150814,
					"content": "Ahora mismo, ni siquiera puedo ir yo misma hasta Liyue sin una Visión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150815,
					"content": "Pero como papá te envió hasta aquí con sus regalos, puede que ir a buscarlo le cause más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Yo también tenía regalos para él</color>. Quería darle una sorpresa... Pero ya no puedo dárselos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Si alguien pudiera ayudarme a hacerlo</color>... No importa, volveré a la aldea. No hace falta que me sigas, conozco el camino de vuelta a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Liu"
				}
			]
		},
		{
