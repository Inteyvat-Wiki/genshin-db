			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "Ese Jiayi... ¿Cómo pudo decir a última hora que no vendría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708150602,
					"content": "No la ve más que unas cuantas veces al año. ¿Es así como se comporta un padre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Lo hace por Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Eso es lo que dice todos los años. He perdido la cuenta del número de veces que lo ha dicho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Está haciendo su trabajo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Bueno, también es su trabajo cuidar de su hija. La pequeña Liu está creciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Si no tiene cuidado, ella será la que trabaje fuera de la aldea cuando él regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708150608,
					"content": "¿Cuándo se reunirán ese padre y su hija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
