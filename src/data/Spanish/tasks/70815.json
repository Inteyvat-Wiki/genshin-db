			"dialogs": [
				{
					"id": 708151101,
					"content": "¿Ya le diste mis regalos a Liu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151102,
						708151104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151102,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "Genial. Le encantan esos juguetes. Gracias por tu ayuda. Toma esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151104,
					"content": "Le gustaría aún más que volvieras a la aldea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Yo también quiero volver, pero con Liyue en este estado, no creo que sea posible por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "Aun así, muchas gracias. Espero que esos regalos la animen un poco. Son sus favoritos, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151107,
					"content": "Acepten esto como agradecimiento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
