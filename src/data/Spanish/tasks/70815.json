			},
			"dialogs": [
				{
					"id": 708151001,
					"content": "Has vuelto. Gracias por tu ayuda. La pequeña Liu ya regresó, y con bolsa llena de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151002
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708151002,
					"content": "Son regalos de Jiayi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151003
					]
				},
				{
					"id": 708151003,
					"content": "¿En serio? Pero si lo que realmente quiere ella es que vuelva él en persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151004
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708151004,
					"content": "Esta niña ha crecido tanto como el bambú del pueblo. Se vuelven mayores de un día para otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151005
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 708151005,
					"content": "El tiempo que un padre no pasa con sus hijos cuando son pequeños nunca se podrá recuperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
