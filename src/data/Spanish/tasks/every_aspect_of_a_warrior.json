			"dialogs": [
				{
					"id": 750330801,
					"content": "¿Una carrera de nuevo? Jaja, ¡verán de lo que soy capaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330802
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330802,
					"content": "¡Cuánta confianza tienes! ¡Acomitl, no podemos perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330803,
					"content": "Puedo aceptar una derrota contra Manyoya, pero no quiero perder ni de broma contra Matahga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330804
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330804,
					"content": "#{NICKNAME}, mucho ánimo. Ten cuidado con Matahga, que a veces se guarda un as bajo la manga. Le gusta mucho esa estrategia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330805
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330805,
					"content": "#Cuando estés preparad{F#a}{M#o}, avisa a mi padre y volamos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acomitl"
