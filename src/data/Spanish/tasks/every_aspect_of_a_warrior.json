			},
			"dialogs": [
				{
					"id": 750330601,
					"content": "#Ay, perdí otra vez. A pesar de tanto entrenamiento perdí contra {M#él}{F#ella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "Ya te lo dije. Si insistes mucho en ganar, no conseguirás nada, pero envidio esa energía que tienes de lanzarte sin miedo a nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
					"content": "Acomitl también era así de niño. En aquel entonces, siempre estaba detrás de mí diciendo que su sueño era convertirse en un maestro domasaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330604,
					"content": "No te burles de mí, Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Todos ustedes son mis queridos hijos y, a la vez, guerreros, y deben saber que todos los guerreros tienen que enfrentarse a diferentes problemas en cada momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330606,
					"content": "No pasa nada. Yo estaré orgulloso de ustedes siempre y cuando sean fieles a sus corazones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
