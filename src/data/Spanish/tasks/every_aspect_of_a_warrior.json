			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "#Vuela una vez con ellos, jovencit{F#a}{M#o}. Te recuerdo que volar con expertos de vuelo de la Tribu Plumaflora es una oportunidad única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Vayan tras la <color=#00E1FFFF>antorcha voladora</color> que hay en el circuito, y quien la alcance primero será el ganador. Así los entrenaba cuando eran niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>La antorcha flota gracias a un globo que está adornado con plumas rojas</color>. Lo fabriqué yo personalmente y simboliza la responsabilidad y el honor de un guerrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "Lo reconocerás en cuanto lo veas. ¿Qué opinas? ¿Quieres probar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Jaja, pues vamos al punto de partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "Deja que me prepare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "#Pues esperaremos a que estés preparad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
		{
			"id": 7503304,
