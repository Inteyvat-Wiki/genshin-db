				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "No tiene sentido... ¡¿Cómo has hecho eso?! ¡Es... es el fin de mi reputación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Ha sido un honor combatir contra usted, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665003,
					"content": "¡Y encima es educada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Jeje... ¿Ocupado perdiendo mientras no estábamos, to{RUBY#[D]Luchador Escaradiablo Supremo}reitto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Yo no lo veo así. A menos que el Luchador Escaradiablo Supremo se rinda ahora mismo, todavía no ha perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665006,
					"content": "Ya sea durante un combate o en la vida, es normal sufrir algún revés, pero solo habrás perdido realmente si te rindes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665007,
					"content": "¡A-así se habla! ¡Aún no he admitido la derrota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Sin embargo, es inútil buscar excusas para justificarse todo el tiempo. Habla menos y dedica tu energía a luchar contra tu oponente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665009,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Rey oni, parece que no se te da bien enfrentarte a este tipo de oponente. Te recomiendo que envíes a uno de tus subordinados a luchar contra ella y que observes su combate con atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716665011,
					"content": "La observación es una parte importante del entrenamiento de un guerrero. Algunas habilidades se aprenden ejecutándolas uno mismo, y otras observando cómo las usan los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716665012,
					"content": "¡Tienes razón! ¡Menos mal que mi compadre anda por aquí! ¡Todo tuyo, Mano del Rey Oni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Jeje, ¡por fin es tu turno! ¡Demuéstrale quién manda, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "¡Pan comido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Entonces, ¿voy a combatir mano a mano con {F#la legendaria}{M#el legendario} {NICKNAME}? Tendré que estar alerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665015,
					"content": "¡Aaah! ¡Qué miedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
