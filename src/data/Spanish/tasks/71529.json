			"dialogs": [
				{
					"id": 716665101,
					"content": "Buen trabajo. La victoria es tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665102,
					"content": "#Creo que puedo decir que es un honor haber perdido contra {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Antes Muerta que Ordinaria"
				},
				{
					"id": 716665103,
					"content": "¡Aaah! ¡¿Así que así es cómo se gana?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "¡Sip! Cuando te enfrentas a un enemigo astuto, hay que ser creativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "#Si ves que tus tácticas no funcionan, solo tienes que cambiar de enfoque. Cuando Paimon está de viaje con {NICKNAME}, ¡somos muy flexibles a la hora de pensar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "¡Si solo te centras en una forma de hacer las cosas, no podrás solucionar el problema por mucho que te esfuerces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Creo recordar que Kuki dijo una vez algo parecido. Supongo que tiene sentido, después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Pero bueno, ya pensaré en ello más tarde. Ahora, ¡tengo que centrarme en las peleas de escaradiablos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
