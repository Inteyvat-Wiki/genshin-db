			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "¿Eh? ¿Qué ha sido eso? La Estatua de Los Siete ha brillado de una manera exagerada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Qué raro, ¿había ocurrido algo así antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "Es normal que la estatua brille, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, te encuentras bien, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "¿Eh? E-el agua me está hablando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Sí, claro. Si le puedes hacer bromas a Paimon es que estás en perfecto estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Aunque, después de ese brillo, Paimon siente que hay más humedad. ¿Tal vez sea por toda esa energía elemental Hydro que liberó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Dicen que si sabes manejar bien la energía elemental en Fontaine, ¡serás capaz de nadar bajo el agua! ¡Quizá puedas encontrar tesoros hundidos en el mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Paimon cuenta contigo para la búsqueda de tesoros, ella se ocupará de... ¡velar por ti en la costa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "#Qué sol{F#a}{M#o} me voy a sentir en el agua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "*Bua*, ¡p-pero a Paimon le da miedo meterse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "¿Qué pasa si Paimon es arrastrada accidentalmente por una corriente y se marea, y no consigue salir volando por mucho que lo intente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Como cuando te encontraste con Paimon en Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "¡Te pescaré de nuevo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "... ¿Lo prometes? E-está bien, Paimon se sacrificará para acompañarte. Tienes que cumplir tu palabra, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "¡Haz algo, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "¡Guau! ¡Es como si tuviera branquias para respirar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Sí, sí, primero te tienen que crecer unas. Hum, a ti no te pasa nada. ¡Le has hecho a Paimon preocuparse por ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "¿Como si saliera agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Sin duda es la nación de la Arconte Hydro, incluso las Estatuas de Los Siete son fuentes de agua... Pero Paimon nunca había visto ese brillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}