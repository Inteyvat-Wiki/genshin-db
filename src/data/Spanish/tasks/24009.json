			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "A ver, deja que mire. Mis amigos me han dado algunos consejos y los he apuntado en mi cuaderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "¿Qué se supone que escribí aquí? A ver... Submarino... rocas pétreas... ¿con plantas?... Contornos rocosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Ah, claro, ya lo entiendo. Durante un tiempo, me dediqué al estudio compulsivo de rocas. De hecho, creo que son los objetos que mejor representan la belleza natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Bueno, a lo que vamos, me gustaría que tomaras algunas imágenes de rocas submarinas. Me pregunto qué clase de contornos serás capaz de capturar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
