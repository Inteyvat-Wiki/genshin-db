			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Le falta... tensión, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Creo que le falta un punto de determinismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "¿Tomando imágenes del paisaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Así es, las necesito como inspiración para mis pinturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Me llamo Depierris y soy pintor. Es un placer conocerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Ah, claro, igualmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Normalmente invitaría a mis nuevos amigos a un café, pero me temo que no hay ninguno por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Hagamos esto. Toma esta copa de fonta y brindemos por el comienzo oficial de nuestra amistad. ¿Has probado ya la fonta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "No, es mi primera visita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ya veo. ¡Entonces seguro que pasas un buen rato! Deberías ir a la ciudad, ¡tendrás que familiarizarte con las acualíneas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Luego puedes dar una vuelta por las calles y ver las máquinas que hay por todas partes. Como artista, he de admitir que yo no le encuentro el valor estético a todos esos mecanismos, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Y para terminar, deberías sentarte y disfrutar de una buena taza de café en el café, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "¡Tal vez alguien se te acerque para entablar conversación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Eso sí, si se te acerca alguien del Club de Aficionados a la Daguerrotipia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Prepárate para toda una sarta de tonterías... Algunos de los miembros se dedican en exclusivo a ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "¿Qué es lo que hacen exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Bueno, verás, algunos de ellos están decididos a contribuir a la destrucción del patrimonio cultural de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "No creas que estoy hablando por hablar. ¿Sabes de lo que hablan en ese club?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "“Si solo hablamos de imágenes, los resultados de un Daguerrotipo son mucho mejores que los de cualquier pintura”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "¡Qué osados! “Si solo hablamos de imágenes”... ¿Qué clase de tontería es esa? No son más que sandeces, por mucho que intenten airearlas por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Si nos limitamos a basarnos en imágenes, ¿a qué queda reducida la estética?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Reconozco que algunos de nosotros todavía estamos tratando de alcanzar una técnica más naturalista... ¡Pero aun así nos guiamos por la estética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "¡La estética es el factor clave! Tú lo entiendes, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "N-no mucho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "La contemplación del artista es solo el primer paso en el proceso de creación. También debemos explorar la sensibilidad y la belleza de todo corazón para poder plasmarlas en el lienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "¿Por qué deberíamos permitir que esos fanáticos de los Daguerrotipos se definan como simplones incapaces de comprender el verdadero sentido de la estética?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Tengo amigos que adoran los Daguerrotipos y paso mucho tiempo hablando con ellos. A veces, son sus imágenes las que me sirven de inspiración. Otras, son mis obras las que los inspiran a ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "¡Pero no soporto a los que no saben nada del tema y aun así van alardeando por ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "¡Son una desgracia para la daguerrotipia y la pintura! ¡Son una panda de...! *Cof, cof*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Toma, bebe un poco de agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Gracias... Siempre que sale el tema a colación, me pongo echo una furia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Por eso, mis amigos y yo hemos pensado en utilizar este Daguerrotipo para tomar algunas imágenes y usarlas como inspiración para una serie de pinturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "¡Queremos hacer una exhibición con todas las imágenes y obras para que la gente sea capaz de apreciar la diferencia entre la pintura y la daguerrotipia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "El problema es... que las imágenes que he tomado no sirven de nada. Mis amigos dicen que los mejores paisajes se encuentran en los más inhóspitos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Bajo el agua o en lo más alto de un acantilado, o en las inhabitadas profundidades de los bosques... Pero yo no me atrevo a ir a ese tipo de lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Y si contratara a un aventurero, me llevaría demasiado tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Aunque... Mi querid{F#a}{M#o} amig{F#a}{M#o}, ¿estarías interesad{F#a}{M#o} en trabajar para un artista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Mientras que no tenga que usar un pincel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "¡No te preocupes! Cada uno se encargará de su punto fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Y no te preocupes por el pago. Tengo experiencia contratando aventureros para diversos encargos, estoy familiarizado con el sistema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "Si no he contratado a nadie es porque el proceso lleva demasiado tiempo y tengo algo de prisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Bueno, decidido pues. Con tu ayuda, estoy seguro de que podré pintar algunas obras magníficas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "A mí solo se me da bien la parte de las aventuras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "¿S-sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "¿Acaso son peligrosos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Bueno, podrían hacer como han hecho con Fontaine y destruir el patrimonio cultural con el que hayas tenido relación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "¿Eres un aficionado a los Daguerrotipos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "¿“Aficionado”? No, claro que no. Es solo una herramienta de referencia. Prefiero la sensación que me producen mis pinceles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
