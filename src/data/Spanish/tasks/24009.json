				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "A ver, deja que mire. Mis amigos me han dado algunos consejos y los he apuntado en mi cuaderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Plantas acuáticas, ondulación, contrastes lumínicos, metamorfosis... Humm, la verdad es que no tengo ni idea de lo que intentaba escribir en aquel momento. Es probable que estuviera más borracho que un pollo al vino para entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Bueno, lo que necesito es que captures algunas imágenes de plantas subacuáticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Creo entender que estaba interesado en los contrastes de luz sobre las plantas subacuáticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400904,
			"completionStepIds": [
				2400904
			],
