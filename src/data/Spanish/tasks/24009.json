				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090401,
					"content": "A ver, deja que mire. Mis amigos me han dado algunos consejos y los he apuntado en mi cuaderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "¡“Las ruinas submarinas”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "¿Por qué escribiría con tanta fuerza esa frase? Casi traspaso el papel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Aunque supongo que unas ruinas submarinas siempre tienen su encanto, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Entonces, ayúdame a tomar una imagen de algunas ruinas submarinas. ¡Cuanto más grandes sean y más en ruinas estén, mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400906,
			"completionStepIds": [
				2400906
			],
