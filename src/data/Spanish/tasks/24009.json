					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "¡Te lo agradezco! Con esto debería bastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Toma, por las molestias. Y ahora, ¡a comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Creo que la próxima vez pondré algunas galletas dentro de la mochila también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
