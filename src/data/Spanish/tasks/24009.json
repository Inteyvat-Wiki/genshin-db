			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "No, así no sirve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "¿Qué tipo de imagen necesitas esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Esta vez no necesito ninguna imagen. De hecho, tengo que pedirte otro tipo de favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "*Ejem*, verás, me da vergüenza reconocerlo, pero... ¿podrías conseguirme algo de comer? No sé, pan de ajo, por ejemplo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "¿No llevas nada de comer encima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Claro que no. Traje pan, mermelada y algo de cecina. Hubiera sido suficiente para pasar el día, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Bueno, el caso es que lo dejé todo a un lado porque estaba demasiado concentrado en mi obra maestra y para cuando me di cuenta, la comida ya no estaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Tal vez fuera un animal o un viajero hambriento que no pudo resistirse. Espero que al menos ellos disfruten de la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "El problema es que yo también tengo hambre ahora y no puedo volver a la ciudad todavía... Tengo que terminar de recopilar materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Entendido, espera aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "¡Muchas gracias! Puedes comprar pan de ajo en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Jajaja... Ay, que me mareo. Puede que sea por el hambre, o porque le he dado demasiado al coco hoy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Te traeré algo de comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "¿Te has gastado todo el presupuesto para comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "¿A dónde tengo que ir ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
			"completionStepIds": [
				2400914
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
