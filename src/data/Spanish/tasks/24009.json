			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "#¡Viajer{F#a}{M#o}, llegas justo a tiempo! He encontrado el sitio perfecto para capturar imágenes. ¡Solo necesito que me eches una manita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "¿Sigues buscando inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "¿Lo dudabas? Con estos materiales no me basta. ¿Cómo voy a pintar toda una escena con una sola imagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Normalmente, si voy a usar imágenes como fuente de referencia, necesitaría docenas, a veces hasta un centenar de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "¿Tantas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Ya te lo he dicho, el objetivo de esas imágenes es la creación artística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Si te limitas a plasmar lo que ves en el lienzo, no sería una pintura, sería una imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "El deber de un artista es utilizar su sentido artístico y su sensibilidad para observar, capturar, transformar y moldear el mundo que le rodea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Hasta ser capaz de identificar la verdadera belleza de cada objeto y plasmarla en el lienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "No he entendido ni jota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "*Suspira*, lo que quiero decir es que solo me sirven de referencia los aspectos más hermosos de cada imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Por ejemplo, el contraste de sombras y luz aquí es espectacular, pero el paisaje deja mucho que desear en comparación. Así que, para mi obra, solo utilizaría de inspiración ese contraste lumínico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "En esta otra imagen, sin embargo, la postura del viajero es verdaderamente interesante. Y esta de aquí se basa en las esculturales líneas arquitectónicas de este edificio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "Es como si fuera un rompecabezas mental, ¿sabes? La belleza o ausencia de la misma de la obra final dependerá de tu sentido de la estética y de tu habilidad para captar los elementos que verdaderamente vale la pena incluir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Bueno, esa tampoco es una descripción muy precisa que digamos, puesto que los artistas también transformamos esos elementos referenciales... Pero, bueno, al menos se hacen una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "¿Cuál es la palabra mágica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Ah, sí, claro. ¡Por favor! Tus habilidades para la toma de imágenes no tienen parangón, así que a mis amigos y a mí nos gustaría verte en acción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Estoy seguro de que con tu ayuda podré crear algo formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Por favor, por el bien del sentido artístico, y los Moras que he preparado, ¡ayúdame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "¿Cómo se piden las cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "¿Me estás hablando en hilichurlio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "¿Es que las usas para otras cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
