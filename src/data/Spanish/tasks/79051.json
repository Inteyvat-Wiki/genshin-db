			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "Mira, aquí hay un diario. Parece que está en buenas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510102,
					"content": "*Suspira*, ¡menos mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510103,
					"content": "¡Consiguió salir del bache y mejoró sus habilidades para la pintura! ¡Seguro que le irá muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510104,
					"content": "Aunque al final se marchó sin las Gotitas. Paimon se siente un poco triste después de leer eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510105,
					"content": "Tal vez los artistas sean incapaces de aceptar imitaciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Sí, Paimon lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510108,
					"content": "Aunque hay algo que resulta muy confuso. En el diario dice que el mural puede cambiar de forma y de lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510109,
					"content": "Pero el mural parece en perfecto estado, incluso después de todo lo que pasó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510110,
					"content": "La clave está en las Gotitas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "¡Claro! ¡Por eso saben tanto sobre el proyector refractor y cómo arreglar el mural!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510113,
					"content": "Ay, Paimon cree que es muy bonito. Las Gotitas no parecen muy listas, pero son muy cariñosas y leales. Merece la pena tenerlas de amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leer"
				},
				{
					"id": 790510111,
					"content": "Las Gotitas protegieron el mural de su amigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Tiene sentido que quisiera conservar su genuidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
