	"talks": [
		{
			"id": 7181001,
			"completionStepIds": [
				7181001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
