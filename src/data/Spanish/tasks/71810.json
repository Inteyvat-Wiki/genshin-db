			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "¿Cómo voy a escribir mi tesis así? ¿Qué hago?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Pues... ¿Eh? ¡Oh, eres tú! ¿Me recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Soy la persona que encontraste en una jaula de los Ladrones de Tesoros en el Paso Lingju. Jeje, gracias por salvarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Después de que me rescataste, fui a ver a Soraya en la Posada Wangshu. Tuve suerte y la pude encontrar allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Soraya es tan buena persona... No solo me invitó a comer, sino que también me ayudó organizar mis apuntes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Pero, entonces, me dijo que el tema que había elegido ya lo habían tratado en muchas tesis anteriores de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "A menos que escriba una tesis excepcional, no creo que me den el visto bueno... Soraya me aconsejó que cambiara la perspectiva. Por ejemplo, puedo escribir sobre algo relacionado con los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Pero, como no tengo una Visión y no puedo usar los elementos, no tengo ni idea de por dónde empezar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "Así que no me quedó más remedio que venir a la ciudad a probar suerte y ver si puedo encontrar algún material útil por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Espera... Cuando me salvaste, luchaste de una manera realmente única...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "¿Por casualidad no tendrás una Visión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "No, no la tengo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "¿Eh? ¿Puedes luchar así sin una Visión? ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Olvídalo, seguro que es una historia muy larga y complicada. En cualquier caso, me gustaría pedirte algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "¿Podrías mostrarme tu forma de luchar? Quizás encuentre algo que pueda usar para mejorar mi tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "¡Por favor, ayúdame! Si no termino esta tesis, estaré acabada cuando regrese a la Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "¡Muchas gracias! Vayamos afuera, entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Recuerdo haber visto un grupo de Hilichurls alrededor de esta zona. ¡Úsalos como objetivo para mostrarme tu estilo de combate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "¿Tan horrible es la Academia de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Es un lugar aterrador. Siempre que sueño con ella, me despierto llorando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Prefiero quedarme en la jaula de los Ladrones de Tesoros antes que tener que hacer otro borrador o defensa de la tesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Bueno, ya hemos hablado suficiente de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Recuerdo haber visto un grupo de Hilichurls alrededor de esta zona. ¡Úsalos como objetivo para mostrarme tu estilo de combate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Guau... Tu estilo de lucha es único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "Ah, cierto, escuché que las personas con una Visión pueden sentir la presencia de los elementos. Creo que se conoce como Visión Elemental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Aunque no tienes una Visión, te he visto usar la Energía Elemental, así que también deberías tener esa habilidad, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "He visto unos Slimes cerca de aquí, ¿podrías mostrarme tu Visión Elemental y usarla para encontrarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Como alguien sin una Visión, no noté en absoluto que usaras tu Visión Elemental. ¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Supongo que es algo que solo pueden sentir otros portadores de Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Aun así, gracias por mostrarme todas estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "*Suspira*, me encantaría tener una Visión... Lo mejor sería una Visión Electro. Se vería tan bien... Y así podría defenderme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Aunque... tal vez una Visión Electro sería la más difícil de conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "Si te esfuerzas, seguro que conseguirás una.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "No sé... Por mucho que me esfuerce, no creo que consiga una Visión Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Espera, ¿no lo sabes? Nadie ha conseguido una desde hace un año.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Al parecer, la Academia de Sumeru lleva un tiempo investigando el asunto, y llegó a la conclusión de que el hecho de que no se estén otorgando Visiones Electro a los mortales es voluntad de la Arconte Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "También escuché que esa misma Arconte proclamó el “Decreto de captura de Visiones” que tiene como objetivo confiscar la mayoría de las Visiones de la gente de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "Aquellos que se niegan a entregar su Visión son duramente castigados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Una vez quise viajar a Inazuma para escribir una tesis sobre ese decreto, pero parece un lugar tan peligroso que no me atrevo a ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Pero tú no tienes una Visión. No debería ocurrirte nada malo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "¡Oye, no digas eso! Piénsalo: si las personas con Visión están sufriendo, ¿no crees que quienes no tengan una estarían aún peor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
					"content": "Supongo que primero debería quedarme en Liyue a terminar mi tesis tranquilamente. Después, informaré a la Academia de Sumeru de mis hallazgos lo antes posible. Si me demoro más, el sermón que me darán no tendrá fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100316,
					"content": "Ah, cierto, aún no te he dado las gracias por mostrarme todas esas cosas. Toma, acepta esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100317,
					"content": "¡Ahora sí podré terminar mi tesis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		}
	]
}