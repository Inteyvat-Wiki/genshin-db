				"points": []
			},
			"dialogs": [
				{
					"id": 750730201,
					"content": "#Oh, mi benefacto{F#ra}{M#r}, no puedes dejarme sola en una jaula tan alta con tantos Qucusaurios volando alrededor...",
					"roleType": "TALK_ROLE_NPC",
