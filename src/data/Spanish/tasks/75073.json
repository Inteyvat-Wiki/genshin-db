				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#¡Oh, mi benefacto{F#ra}{M#r}! Gracias por intervenir y ayudarme a despejar estos Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "A decir verdad, estaba de pie en un acantilado mirando el paisaje y, al no prestar atención, un Hilichurl me dejó inconsciente. Cuando me desperté, ya estaba encerrada aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "Encerrada, sí... ¡Ah, la llave!... Pues la llave está en la caja de allí, ¿podrías prestarme tu preciosa manita y hacerme otro pequeño e insignificante favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Te lo agradecería mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
