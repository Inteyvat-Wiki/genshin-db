			},
			"dialogs": [
				{
					"id": 750730301,
					"content": "*Snif*, por fin salgo de esta jaula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Este globo aerostático se está moviendo mucho. Quién sabe, tal vez solo un soplido de viento podría hacer caer toda la jaula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Temo que ni siquiera la abu Itztli podría salvarme entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "¿Quién eres y por qué estás aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ah, todavía no me he presentado. Pues mi nombre es Conulaf, y soy una sacerdotisa aprendiz de los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Actualmente estoy aprendiendo a ser una sacerdotisa cualificada. Había estado siempre en la tribu, hasta que un día los ancianos me dijeron: “Deberías irte de viaje y conocer el mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Así que me echaron de la tribu con el pretexto de mi formación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "Pero si conocer el mundo implica ser capturada por los Hilichurls... Sería mejor quedarse en casa, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Irte de aventuras tú sola es peligroso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Así es. Si no hubieras pasado por aquí, no sé cuánto tiempo habría estado atrapada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "Bueno, en fin, gracias por salvarme... Después de comer tanto viento aquí arriba, será mejor que baje primero y reflexione bien sobre cómo continuar mi formación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "#No llevo mucho dinero encima, pero mi familia dice que siempre hay que devolver los favores, ¡así que te daré todo esto, mi benefacto{F#ra}{M#r}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Mientras seas lo suficientemente fuerte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "#Jaja, no me vaciles. En el mundo solo hay una milésima parte que llega a ser {F#una aventurera}{M#un aventurero} tan fuerte como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
