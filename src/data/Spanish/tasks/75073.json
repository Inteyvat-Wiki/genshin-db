					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730405
					]
				},
				{
					"id": 750730405,
					"content": "#Oh, eres tú, mi benefacto{F#ra}{M#r}. ¡Qué suerte que nos hayamos vuelto a encontrar en nuestro viaje! O mejor dicho, ¡que me hayas salvado una vez más!",
					"roleType": "TALK_ROLE_NPC",
