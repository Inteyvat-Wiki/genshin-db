						],
						"pointId": 351700005
					}
				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "¿Eh? ¿E-eso era un Qucusaurio? ¡Conque de verdad fue él quien trajo la estatua hasta aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Un momento... ¿Acaba de saltar al cráter del volcán mientras llevaba la estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Ahí está el cráter. Guau, la verdad es que es impresionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Humm, cuando preguntamos, ¿no nos dijeron que en él se concentraba una gran cantidad de flogisto gaseoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "¡Claro! Para <color=#00E1FFFF>atravesar el flogisto gaseoso</color>, ¡tenemos que hacer lo mismo que ese Qucusaurio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Aunque... Ay... ¡Está muy alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "No pasa nada, yo te llevaré en brazos, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "¿De verdad tú también quieres saltar al cráter? Bueno, está bien... Si es contigo, entonces Paimon no tiene nada que temer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Pero lo peligroso no solo es la altura, ¡recuerden también el flogisto gaseoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "En fin, no nos queda más remedio que prepararnos bien y ponernos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "No pasará nada mientras te agarres bien en el instante en el que aterricemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "¡Paimon no puede hacer eso! En primer lugar, porque no tiene tanta fuerza, y en segundo, porque ¡¿qué es eso del “instante en el que aterricemos”?! ¡Es imposible que Paimon se agarre en el momento justo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "Y tú, ¡Paimon te prohíbe que le sigas el juego! *Suspira*... Están tan seguros de sí mismos que Paimon ya ni siquiera está nerviosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
