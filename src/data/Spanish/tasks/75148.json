					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "Elegidos de los dragones... Oh, elegidos de los dragones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480102,
					"content": "¡Suban a la cúspide y salten al fuego de la Montaña Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480103,
					"content": "¡Adelante, rompan el sello dorado y desvelen el resplandor de las innumerables llamas remanentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480104,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "¿Qué pasa? ¿Otra vez vieron algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480106,
					"content": "Sí... y esta vez lo vimos más nítidamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "¿Será porque estamos más cerca del volcán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480109,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "Es como si esa persona que no deja de hablar con ustedes estuviera dentro del volcán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480111,
					"content": "Si al acercarnos han vuelto a ver algo, debe de ser porque vamos por el buen camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480112,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "Sí... y parecía que estaba más cerca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
		{
			"id": 7514802,
