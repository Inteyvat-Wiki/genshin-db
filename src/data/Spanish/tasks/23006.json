			"dialogs": [
				{
					"id": 230060301,
					"content": "#¿Qué pasa, viajer{F#a}{M#o}? ¿Tienes alguna pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Sobre Zakariya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "El Dr. Zakariya es un médico excepcional y todo un devoto de la Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Suele trabajar sin descanso para ocuparse de todos sus pacientes. Muchas veces hasta se olvida de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Además, él insiste en que es su deber contribuir a que las bendiciones de la Arconte Dendro lleguen al mayor número de personas posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Entonces, ¿confían en las bendiciones de la Arconte Dendro para curar a la gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Bueno, para ser más precisos, el tratamiento en sí es la bendición de la Arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "Ella nos bendijo con la capacidad de encontrar remedio para las enfermedades y cultivar hierbas medicinales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Hemos de estarle agradecidos por protegernos a todos de los males de este mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
