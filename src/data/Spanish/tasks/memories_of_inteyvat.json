			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "Es un campamento de Hilichurls muy rudimentario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060402,
					"content": "Estos Hilichurls tienen un aspecto lamentable. Parece que algunos de ellos... dieron su último aliento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060403,
					"content": "¿Esto es lo que Halfdan quería mostrarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060404,
					"content": "Eso no importa. Vale la pena investigar todo aquí. Inspeccionemos el lugar hasta el último rincón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
