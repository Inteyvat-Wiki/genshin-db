			"dialogs": [
				{
					"id": 706970101,
					"content": "#¡{NICKNAME}! Qué sorpresa encontrarte en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Es la primera vez que vengo a un lugar tan frío, ¡así que todo esto es una experiencia nueva para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Las guerras de nieve, los muñecos de nieve... ¡incluso hay cómics!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "Quién iba a decir que «La saga de los combatientes fervientes», una serie tan famosa en Inazuma, también tendría seguidores aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "He tenido una charla increíble con unos seguidores de Natlan, y me inspiró a hacer esta figura acrílica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "¿Has oído hablar de «La saga de los combatientes fervientes»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Le cuentas a Yoimiya el asunto de la legión de los combatientes fervientes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Vaya, ¿a tus amigos también les guste ese cómic? ¡Qué coincidencia tan curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Entonces les regalaré esta figura acrílica de Fietena, una de los combatientes fervientes. Irá perfecta con su legión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
