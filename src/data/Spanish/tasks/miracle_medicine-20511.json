				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "¿Funcionará esta medicina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#¡Viajer{F#a}{M#o}! Llegas justo a tiempo. Estoy muy preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "¿Recuerdas a mi hermana, Anna? Siempre ha estado enferma y, por mucho que intente curarse, nada funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Escuché que en Liyue había un médico que hace milagros y es muy bueno curando a personas con enfermedades raras, así que le pedí a alguien que fuera a pedirle una receta médica por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Los materiales necesarios son muy raros, pero, aun así, quiero probar a ver si funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Así que... ¿Te importaría ayudarme a buscar una baya Dendro-procesada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "¿Existe algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "¡Yo tampoco lo sé! ¿Los Slimes Dendro realmente comen bayas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "¿Podrías encargarte de ello? Conozco un lugar en el que hay tanto Slimes Dendro como bayas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "¿Podrías ir, por favor? Espero que puedas encontrarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Me suena a un charlatán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "¿Tú también lo piensas? Pero tampoco tengo otra opción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Conozco un lugar en el que hay tanto Slimes Dendro como bayas. ¿Podrías ir a mirar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "La medicina que haga con el material la probaré yo primero. No puedo permitir que Anna empeore aún más, me cueste lo que me cueste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "También podría traerte un Slime Dendro entero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "¿Qu-qué? ¿Quieres que le meta yo la baya al Slime Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "No creo que pueda... Una vez, recogiendo hierbas medicinales para Anna, un grupo de Slimes Dendro me persiguió hasta la Aldea Aguaclara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Conozco un lugar en el que hay tanto Slimes Dendro como bayas. ¿Podrías ir a mirar? Espero que lo encuentres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Pero... S-si realmente no puedes hacerlo, tráeme un Slime Dendro. ¡Todo sea por Anna! ¡Puedo hacerlo! ¡Sé que podré hacerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
