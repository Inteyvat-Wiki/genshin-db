				},
				{
					"id": 205110402,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "¿Es esta? No tiene nada de especial, ahora que la veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "Parece una baya común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Bueno, prepararé la medicina tal y como se explica en la receta que me dio el médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "Gracias. Toma esto como agradecimiento por tu trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "Es posible que en el futuro te necesite de nuevo, así que ni se te ocurra decir que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
