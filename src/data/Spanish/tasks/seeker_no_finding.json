			"dialogs": [
				{
					"id": 750110201,
					"content": "*Fiu*, este debe de ser el último mecanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Parece igual que el resto de mecanismos. Chikya, ¿seguro que no te han engañado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Grr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "¡Claro que no! Tengo confianza plena en mí misma cuando se trata de pergaminos antiguos... Bueno, más bien, ¡tengo bastante confianza en mis habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110205,
					"content": "¡Tu confianza va perdiendo puntos por momentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Sea como sea, este no debe de ser el último mecanismo. Que yo sepa, deberían ser más grandes y... ¿completos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110207,
					"content": "Islas flotantes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "Joven promesa, no podré entender ni una palabra de lo que me digas a no ser que me hables con oraciones completas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110209,
					"content": "En cuanto a si el tesoro y el elixir existen realmente, eso solo lo sabremos cuando hayamos agotado nuestras opciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110210,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Puede que esta vez no funcione, pero puede que a la próxima sí. Si no están aquí, pues estarán en otro lugar. ¡Ocurrirá un milagro tarde o temprano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110212,
					"content": "Tu optimismo no tiene límites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "¡Me tomaré eso como un cumplido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110216,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Jeje, mira, {REALNAME[ID(2)|SHOWHOST(true)]} también está emocionado. Vamos, {NICKNAME}, ¡usa flogisto para activar el mecanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110214,
					"content": "No perder la esperanza ni la motivación por seguir intentándolo es el mayor logro de todos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "¡Este no es un lugar para el pesimismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				}
			]
		},
