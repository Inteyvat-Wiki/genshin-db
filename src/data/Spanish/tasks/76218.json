			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sandrone"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh, ya estás aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180102,
					"content": "¡Hola, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Gracias por la invitación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "¿Eh? ¿No decía tu carta que íbamos a tomar el té? ¿Cómo es que aquí no hay nada? ¡No le digas a Paimon que esta reunión es sin aperitivos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Ja, no digas bobadas, Paimon. ¿De verdad crees que me olvidaría de la comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180107,
					"content": "¡Vaya! ¿E-esa mesa acaba de aparecer de la nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Jeje, impresionante, ¿verdad? Esta es mi nueva mesita de té portátil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180109,
					"content": "Es fácil de transportar y guardar, y además está equipada con un dispositivo de suspensión, igual que Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180110,
					"content": "#Pero lo más impresionante es que... Eh, bueno, no quiero presumir y que esto suene a publicidad. Mejor compruébenlo ustedes mism{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180111,
					"content": "Tomen, preparé té y algunos aperitivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180112,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "¡Mmm! ¡Están buenísimos! ¡Eres una supercocinera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180115,
					"content": "Pero ¿qué te inspiró para crear algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Quería poder disfrutar de agradables horas del té con mis amigos, estuvieran donde estuvieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180117,
					"content": "Como ya dije en otra ocasión, aferrarse a lo que ya tienes no es la única forma de conservar lo que es valioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180118,
					"content": "Últimamente he sentido ganas de salir a pasear y visitar a mis amigos más a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180119,
					"content": "Pero presentarme sin avisar en casa de otros y esperar que me preparen té y algunos aperitivos, para luego dejar que sean ellos quienes recojan la mesa... No es precisamente lo que una dama debería hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180120,
					"content": "Jeje, Paimon cree que a tus amigos no les importaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "A mí me importa. Además, un invento tan sencillo como este no me supone ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180122,
					"content": "No se preocupen. Viendo que les gusta tanto, puedo hacerles uno a ustedes también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180123,
					"content": "¡¿Eh?! ¿Seguro que puedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "No pasa nada. Como ya dije, puedo hacer algo así en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180125,
					"content": "En ese caso, muchas gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "No hay de qué. Al fin y al cabo, me ayudaste mucho durante el Festival Fontinal, así que puedes tomarte esto como mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180104,
					"content": "Espero que no te hayamos hecho esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}