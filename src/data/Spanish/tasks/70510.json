			"dialogs": [
				{
					"id": 705100401,
					"content": "Guau... Últimamente no dejan de llegar clientes a la taberna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100402,
					"content": "Algunos vienen por las bebidas, pero la mayoría vienen por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100403,
					"content": "Humm... ¿por qué a Paimon le cuesta creer eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100404,
					"content": "Nunca había visto una Semana de entrenamiento para cantineros con tanto éxito. Hemos conseguido tanto Mora como prestigio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100405,
					"content": "#Así que bien hecho, amig{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100406,
					"content": "#¿Eh? ¿Solo han pasado unos días y ya somos amig{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100407,
					"content": "De alguna manera, sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "Estaba pensando si te gustaría quedarte a trabajar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100410,
					"content": "#¡De ninguna manera! Es verdad que las bebidas ilimitadas son tentadoras, pero Paimon le prometió a {NICKNAME} que l{F#a}{M#o} acompañaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100411,
					"content": "De acuerdo, no insistiré. De hecho, Charles también lo mencionó antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100412,
					"content": "En fin, siéntanse libres de visitar El Obsequio del Ángel, ¡y no olviden traer a sus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100413,
					"content": "Puedes estar seguro de eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "¡Adiós y buena suerte en su viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100408,
					"content": "No está del todo equivocado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
