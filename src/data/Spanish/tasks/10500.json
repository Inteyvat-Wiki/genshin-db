			"dialogs": [
				{
					"id": 105000301,
					"content": "¡Ese es! ¡Pensé que lo había perdido para siempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000302
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000302,
					"content": "¡Lo encontraron! No está nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000303,
					"content": "Sr. Zhu, debe cuidar de los objetos valiosos un poco mejor. Puede que no sea tan afortunado la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000304,
					"content": "Tienes razón. ¿Cómo podría mirar a mi familia a la cara si hubiera perdido el anillo número 253 que me dio mi madre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000305,
						105000306,
						105000307
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000305,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				},
				{
					"id": 105000308,
					"content": "Ah, lo siento, permítanme explicarles. Mi familia es propietaria de una mina de jade y, para asegurarse de que yo encontrara una buena esposa, mi madre mandó a hacer muchos accesorios de jade como reliquias familiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000309
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000309,
					"content": "Creo que podría haber más de quinientos de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000310
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000310,
					"content": "Entonces, ¿por qué decidiste establecer una posada aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000311,
					"content": "Bueno, heredé el negocio familiar demasiado temprano, así que las cosas se pusieron aburridas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000312
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000312,
					"content": "Gracias de todos modos. Aquí están sus Moras, tal como acordamos. Por favor, acéptenlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000313
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000313,
					"content": "Muchas gra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000314,
					"content": "Muchas gracias. ¡Los aceptaré con mucho gusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000315,
						105000316
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000315,
					"content": "¡Qué rapidez!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "Oye, ¡pero nosotros hicimos todo el trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000318,
					"content": "#{F#Una}{M#Un} discípul{F#a}{M#o} es {F#una}{M#un} discípul{F#a}{M#o}. ¿Cómo pueden llevarse el mérito de su maestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000319,
						105000321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000319,
					"content": "Tiene sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000320
					]
				},
				{
					"id": 105000320,
					"content": "#{NICKNAME}, ¿no dijimos que solo estábamos fingiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000323,
					"content": "Bueno, debes comenzar a practicar desde ahora. Si mi rival es tan inteligente como creo que es, te descubrirá en un abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000324
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000324,
					"content": "*Grrr*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000325
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000325,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000326
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000326,
					"content": "¿Qué fue ese sonido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000327,
					"content": "Oh, cierto, no debes haber comido en dos días, ¿cierto? Porque no tenías ni un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000328
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000328,
					"content": "¡Ah! ¡Cállate! ¡No es nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000329,
					"content": "#¡Hum! En fin, creo que mi discípul{F#a}{M#o} hizo un buen trabajo, ¡así que le invitaré a una comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000330
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000330,
					"content": "Si te diriges al norte, encontrarás la <color=#00E1FFFF>Posada Wangshu</color>. Oí que su comida está deliciosa. ¿Por qué no vamos a probarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000331
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000331,
					"content": "¡No hace falta que me lo agradezcas! ¡Es mi deber como maestra responsable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000332
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000332,
					"content": "¿Paimon escuchó bien? ¿Nos invitará a comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000333,
						105000335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000333,
					"content": "Como dirías tú: “¡Vamos tras ella!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000334
					]
				},
				{
					"id": 105000334,
					"content": "¡Vamos tras ella! ¡Por una buena comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000335,
					"content": "Como dirías tú: “Es una buena persona”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000336
					]
				},
				{
					"id": 105000336,
					"content": "¡De verdad lo es! ¡Vamos por ese festín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000321,
					"content": "#En realidad, nunca dije que sería tu discípul{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000322
					]
				},
				{
					"id": 105000322,
					"content": "¡Exactamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000316,
					"content": "¡Ni siquiera Paimon es tan rápida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
