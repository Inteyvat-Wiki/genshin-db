						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "¡Hace cuánto tiempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "¡Es Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "¿Mi facilidad para ver a través de tus secretos no te evoca ningún recuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000904,
					"content": "¡Ah, Paimon lo recuerda! ¡Eres la astróloga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000905,
					"content": "Así es. Soy yo, Mona Megistus, la astróloga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000906,
					"content": "En esta ocasión vengo a Mondstadt a recoger una caja que le pertenece a mi maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Era parte de un acuerdo que hizo con una amiga hace 50 años. Pero ya no es tan ágil como antes, así que ahora soy yo la que estoy a cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "#No estoy segura de qué tiene que ver una caja con nosotr{F#as}{M#os}. ¿Por qué tenemos que acompañarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Pues ... eso es porque tengo que enfrentarme al guardián de la caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000911,
					"content": "Entonces, quieres ponerte a prueba a ti misma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "Básicamente, lo haces por tu reputación, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "Mi maestra y su amiga lucharon en las artes místicas toda su vida sin una clara vencedora. Si triunfo en lo que mi maestra no pudo, ¡significará que soy mejor que ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000114,
					"content": "Ejem, bueno, quiero demostrar el poder y el prestigio de la astrología, para ser precisos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000116,
					"content": "¿De qué hablas? ¡Lo importante es aprovechar esta oportunidad para demostrar el poder y el prestigio de la astrología!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Pero según mis predicciones, sé que la amiga de mi maestra se fue de Mondstadt, dejando a su sucesora como la actual guardiana de esa caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Igual que yo, esa sucesora también debe haber superado a su maestra, así que no debo ser descuidada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000918,
					"content": "Pero... no tengo idea de cómo funciona la astrología.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "¿Por qué pensaste en mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "Me gustaría asegurar mi victoria en esta batalla y, tras pensarlo un poco, ¡pensé en ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000121,
					"content": "#¿Cómo terminó {NICKNAME} involucrad{F#a}{M#o} en esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "El conocimiento que me transmitió mi maestra debe ser transmitido a otra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "#Si yo llevara a mí discípul{F#a}{M#o} a nuestro encuentro, tendría la ventaja, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000924,
					"content": "Me niego a hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "#¿Desde cuándo soy tu discípul{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "#Y tú eres {F#la gran heroína}{M#el gran héroe} de Mondstadt, así que estás al mismo nivel que yo. Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000128,
					"content": "#Vamos, no hace falta que te conviertas en mi discípul{F#a}{M#o}. Solo tienes que fingirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "También habrá algo para ti si vienes conmigo a buscar esa caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Una vez que me encuentre con esa sucesora y tenga la oportunidad de intercambiar conocimientos con ella, podré leer tu destino con mayor precisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Entonces, tendré respuestas para ti, incluso con respecto a asuntos relacionados con dioses y familiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000133,
					"content": "Las condiciones no suenan nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "Bueno, supongo que te seguiremos la corriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "Eso... ¡eso sería mucho más rápido que ir buscando nación por nación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000135,
					"content": "Jeje, una sabia decisión. Entonces, ¡en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Pero antes de ir, me gustaría visitar cierto lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		}
	]
