				"objectNames": [
					"Sr. Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(No es de extrañar que a una posada establecida aquí no le vaya bien el negocio...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, has venido en el momento justo. ¿De casualidad no viste un anillo de jade mientras te dirigías aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000203,
					"content": "¿Un anillo de jade? No recuerdo haberlo visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Vaya... Mi madre me dio ese anillo, ¡pero en un descuido se la tragó un Slime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000205,
					"content": "¿Humm? ¡Eso no es problema para Mona! Es muy buena en astrología...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "No. La astrología está destinada a ser utilizada para comprender la realidad y observar el destino, no para asuntos tan mundanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "¿Pero no dijiste que el dueño de este lugar te había tratado muy bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Esto es una cuestión de dignidad y de mentalidad. Si un astrólogo cree que sus artes pueden resolver todos los problemas del mundo, las estrellas lo abandonarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Sus adivinaciones perderían la capacidad de guiar a otros, y no podría ver a través de la niebla de lo desconocido. Los principios son los principios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Una habilidad tan poderosa y no la usas para ganarte la vida. ¿No es una lástima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*Suspira*, bueno, iba a ofrecerte veinte mil Moras como recompensa si estabas dispuesta a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 105000213,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "Te cambió la cara por completo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "¡¿Veinte mil...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Estabas hablando de la dignidad de un astrólogo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "¿Qué pasó con lo de “los principios son los principios”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "¡Ah, no es nada! Yo... Estaba pensando que la persona que encuentre ese anillo tendrá mucha suerte. Si lo hace, conseguirá veinte mil Moras así como así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "*Ejem*, sí, por supuesto. Pero... el negocio del dueño no ha ido muy bien. Debe ser un anillo verdaderamente extraordinario si vale la pena gastar tanto dinero para encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "No sería correcto que nos fuéramos así. Deberíamos ayudarle a buscarlo. Puede haber otros medios que podamos emplear además de la astrología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, Paimon ha visto esto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Por supuesto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "Supongo que ahora es asunto mío...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, lo tengo, ¡te lo dejaré a ti! ¡Esta es la primera misión que te estoy dando como tu maestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Humm... Si se lo tragó un Slime, tal vez podamos usar cebo elemental para atraer a todos los Slimes cercanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "¿Te suena? Es algo que el Viñedo del Amanecer creó por accidente al intentar hacer vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "La fórmula es secreta, pero es muy bueno para atraer Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "¡Bien hecho, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Cuando de comida se trata, nunca guardas nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Y... Jeje, ¡Paimon guardó algo de cebo elemental de entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Paimon es la mejor compañera, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "#Oh, ¡no seas quisquillos{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Parece que ya tienen algo en mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "¡Sí, volveremos en un santiamén!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050009,
			"completionStepIds": [
				1050002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
