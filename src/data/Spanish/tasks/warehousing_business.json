			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nayat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "¡Ay, esos buitres escarlata! ¡Nunca se van!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400202,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Tú eres... {F#la}{M#el} viajer{F#a}{M#o}, ¿verdad? Ebeid me ha hablado mucho de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400204,
					"content": "No muchos viajeros pasan por nuestra aldea, así que no esperaba verte por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400205,
					"content": "Oh, veo que ya conociste a Habachi. Es una persona muy seria. Por favor, no te ofendas si suena un poco molesto cuando habla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400206,
					"content": "Al fin y al cabo, gran parte de las provisiones de la aldea se guardan en este almacén. No solo la comida, sino también las armas, e incluso el Mora y otras mercancías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400207,
					"content": "Hay pocos jóvenes en la aldea, así que tienen que contribuir a protegerla y de ayudar a la gente con diferentes tareas. Habachi siempre ha vigilado el almacén él solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400208,
					"content": "Yo no soy de gran ayuda, solo puedo llevar la contabilidad y hacer recuento de las mercancías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400209,
					"content": "¿De qué buitres escarlata hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*Suspira*, ni me los menciones. Hace un momento llegó un cargamento de carne seca al almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400211,
					"content": "No sé si será por el olor, pero de vez en cuando algunos de estos buitres aparecen y se quedan acechando en la colina cerca del almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400212,
					"content": "No pueden comer la carne seca que se encuentra dentro del almacén, pero atacan a cualquiera que coma delante de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400213,
					"content": "Los guardias de la aldea no tienen tiempo para encargarse de ellos, y el Sr. Habachi anda muy ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400214,
					"content": "#Viajer{F#a}{M#o}, si tienes tiempo, ¿podrías encargarte de ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400215,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Entonces lo dejo en tus manos. Esos buitres escarlata son feroces, es mejor mantenerse alejado. Si puedes usar un arco y flechas, será más seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400217,
					"content": "¿Han atacado algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Mercancías, carne seca, e incluso las cajas de comida del Sr. Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400219,
					"content": "Cuando el Sr. Habachi come mientras está de guardia, suele separar las verduras de su comida. Los buitres a menudo aprovechan esta oportunidad y bajan volando para llevarse la carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400220,
					"content": "Como no debe abandonar su puesto, no hay nada que pueda hacer para perseguirlos. Solo le queda verlos volar y comer lo que sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400221,
					"content": "#Por favor, viajer{F#a}{M#o}, acaba con los buitres escarlata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				}
			]
		},
