			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#Viajer{F#a}{M#o}, llegas justo a tiempo. ¿Puedes ayudar al Sr. Habachi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400802,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*Suspira*, un grupo de ladrones de tesoros ha interceptado un cargamento a las afueras de la aldea. Hemos desplegado a todos los guardias disponibles para ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400805,
					"content": "Habachi dijo que no eran suficientes, así que tomó su arma y se unió a ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400806,
					"content": "Pero parece ser que son demasiados. No podrá hacerse cargo de ellos por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400807,
					"content": "#Viajer{F#a}{M#o}, he marcado su ubicación en el mapa. ¿Puedes ir a ayudarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400808,
					"content": "Iré ahora mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "#Cuento contigo, viajer{F#a}{M#o}. Espero que no le pase nada malo al Sr. Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400810,
					"content": "¿Es bueno peleando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "Enfrentarse a un par de ladrones de tesoros no debería ser un problema para él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400812,
					"content": "Pero dicen que esta vez es un grupo entero de ladrones de tesoros. Si no fuera porque uno de los miembros de la caravana huyó lo suficientemente rápido para informar del ataque, nadie se habría enterado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400813,
					"content": "Si Candace estuviera aquí, ningún ladrón de tesoros se atrevería a acercarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400814,
					"content": "Deben haber estado esperando esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400815,
					"content": "#Viajer{F#a}{M#o}, por favor, ayuda al Sr. Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400803,
					"content": "Pareces preocupada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
