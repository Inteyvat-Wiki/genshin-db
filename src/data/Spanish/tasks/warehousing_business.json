				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "#Viajer{F#a}{M#o}, ¿conseguiste la mercancía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400702,
					"content": "Sí, aquí está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "¡Excelente! Déjala aquí, por favor. ¡Gracias por tu ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400704,
					"content": "El Sr. Habachi está haciendo el inventario de las demás mercancías en el almacén, así que yo me haré cargo de esta comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400705,
					"content": "*Suspira*, espero que las pérdidas no sean tan graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				}
			]
		},
