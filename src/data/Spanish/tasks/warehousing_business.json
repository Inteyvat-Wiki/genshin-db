			"dialogs": [
				{
					"id": 230401002,
					"content": "#Uff, muchas gracias, viajer{F#a}{M#o}. Si no fuera por tu ayuda, no habríamos podido recuperar la mercancía.",
					"roleType": "TALK_ROLE_NPC",
