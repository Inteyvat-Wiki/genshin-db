			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nayat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "¿Cómo te fue? ¿Pudiste acabar con los buitres escarlata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400402,
					"content": "Todo solucionado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "¡Muchas gracias! Por fin el Sr. Habachi podrá comer tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400405,
					"content": "Cierto. Esto es para ti, como recompensa por tu trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400406,
					"content": "Humm, ¿qué otras mercancías llegarán hoy al almacén?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400403,
					"content": "No los verás por un buen tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304005",
							"2"
						],
						"stepId": 2304005,
						"stateName": "QUEST_STATE_UNFINISHED"
