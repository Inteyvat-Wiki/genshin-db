				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nayat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "*Suspira*, el Sr. Habachi debería descansar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400502,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "#Viajer{F#a}{M#o}, llegas justo a tiempo. ¿Puedes ayudarme con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400504,
					"content": "Acaba de llegar un lote de comida seca. El Sr. Habachi estaba a punto de enviarlo al almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400505,
					"content": "Pero el olor atrajo a una bandada de buitres escarlata y vinieron volando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400506,
					"content": "Aunque los otros guardias no tardaron en llegar para ahuyentarlos, igual lograron picotear la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400507,
					"content": "#Los demás han ido a advertir a los otros equipos de transporte y el Sr. Habachi está ocupado recuperando la comida que todavía es comestible. Viajer{F#a}{M#o}, ¿puedes ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400508,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Lo dejo en tus manos. Disculpa las molestias. Tengo que ayudar a recibir otro lote de mercancías y estoy demasiado ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400510,
					"content": "¿Habachi se encuentra bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*Suspira*, le dije que se tomara un descanso, pero no me escuchó. Dijo que después de recolectar la mercancía, tendría que hacer otro inventario del almacén. Su cuerpo no lo va a soportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Nayat"
				},
				{
					"id": 230400512,
					"content": "#La mercancía debe estar cerca del Ascensor Blanco. Viajer{F#a}{M#o}, por favor, ayúdanos a recuperarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nayat"
				}
			]
		},
