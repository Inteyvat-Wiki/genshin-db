			"dialogs": [
				{
					"id": 711209101,
					"content": "¡Otra vez ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711209102,
					"content": "#La curiosidad mató al gato, amig{F#as}{M#os}. Finjan que no nos vieron, y nosotros haremos como que no l{F#as}{M#os} vimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209103,
					"content": "¿Qué están vigilando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "#¿Saben por qué nos pagan, amig{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209105,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "¡*Ejem*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209107,
					"content": "(Solo se lo diré a ustedes... Es un secreto, no se lo digan a nadie más... Acérquense...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209108,
					"content": "(¡Claro! ¡Paimon te escucha!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "#¡¡Para darle su merecido a entrometid{F#as}{M#os} como ustedes!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209110,
					"content": "¡Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Del interior de la cueva se escucha un sonido extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "¡Tengo gases!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711209113,
					"content": "Oh... Es cierto, tiene gases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711209114,
					"content": "E-entonces no pasa nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
