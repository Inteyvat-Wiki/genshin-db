			"dialogs": [
				{
					"id": 711200101,
					"content": "¡Fuera de aquí! ¡Este es el territorio del jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200102,
					"content": "¡Ay, qué agresivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "¿Quiénes son ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Eso depende de ti. ¡Si te portas bien, podemos ser amigos, pero si te entrometes, tendremos que darte una lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711200105,
					"content": "¡Te aconsejo que seas inteligente y vuelvas por donde viniste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200109,
					"content": "¡Ustedes son muy sospechosos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "#¿Sospechosos? Nosotros solo vigilamos la puerta. ¡Aquí l{F#as}{M#os} únic{F#as}{M#os} sospechos{F#as}{M#os} son ustedes, que no paran de fisgonear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Serpiente Enroscada"
				},
				{
					"id": 711200111,
					"content": "¡En fin, no tenemos nada de lo que hablar! ¡No nos estorben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200106,
					"content": "¿De qué jefe es este territorio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "¿De qué jefe? Ja... ¡Si te lo digo te llevarás un susto de muerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200108,
					"content": "¡Lo hacemos por tu bien! No vayas por ahí preguntando cosas que no deberías saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Serpiente Enroscada"
				}
			]
		},
