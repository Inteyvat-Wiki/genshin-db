					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ninguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "Supongo que han oído hablar de la Guerra de los Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211302,
					"content": "Me suena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Antes, muchos dioses caminaban por el mundo, pero hubo tantas guerras entre ellos que el conflicto no terminó hasta hace dos mil años. Mucha sangre se derramó, e incontables vidas se perdieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211305,
					"content": "Al final, solo quedaron siete ganadores en Teyvat. Construyeron naciones y ciudades sobre los restos de los vencidos, y así comenzó la era de Los Siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211306,
					"content": "¿Ven el Bosque de Piedra Guyun? No es una formación rocosa natural, sino lanzas de roca gigantes arrojadas por Rex Lapis durante la guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211307,
					"content": "Bajo esas lanzas yacen aquellos que fueron sometidos por Rex Lapis: los dioses que fracasaron en su intento por convertirse en Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211308,
					"content": "Los dioses no solo pueden morir, sino que los miembros de Los Siete han cambiado en el transcurso de dos milenios. La muerte de Rex Lapis es un desastre inimaginable para Liyue, pero el sistema de Los Siete en Teyvat no colapsará solo por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211309,
					"content": "Tarde o temprano aparecerá otro Arconte Geo, pero ¿cómo olvidar a Rex Lapis? Cuando llegue ese momento, el vínculo entre el pueblo de Liyue, los Adeptus y los dioses ya no será el mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211310,
					"content": "Aun estando en una nueva era, las Siete Estrellas pertenecemos a los días en que Rex Lapis existía. ¿De verdad nos creen capaces de haber sido cómplices de su muerte? ¿De no haber previsto las repercusiones de ello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211311,
					"content": "Pero, entonces, ¿por qué resguardan la Exuvia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211313,
					"content": "Ese día, ocurrió un incidente inesperado en la Terraza Yujing. Yo tampoco me lo esperaba, como probablemente vieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211314,
					"content": "El enemigo de las Siete Estrellas espera al acecho dentro de Liyue. Si no actuamos contra él rápidamente, estaremos en desventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211315,
					"content": "Resguardar la Exuvia fue una maniobra necesaria para adelantarme y tomar el control de la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211316,
					"content": "¿A quién se refiere con “enemigo”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "#Dímelo tú, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211318,
					"content": "¿Es “él”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Oigan, ¿a qué están jugando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Bien dicho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211322,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "¡Ja! La vista desde aquí es impresionante, pero hace mucho viento. Ya hicimos todos los preparativos para recibir a los huéspedes. Por favor, acompáñenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10211319,
					"content": "Tiene que ser “él”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Tengo una idea general.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
