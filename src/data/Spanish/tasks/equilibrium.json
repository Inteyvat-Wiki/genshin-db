			"dialogs": [
				{
					"id": 10213101,
					"content": "¿Ya seleccionó uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10213102,
					"content": "De ser así, no tiene que confirmarlo conmigo. Simplemente elija uno y lléveselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10213103,
					"content": "Y después, ¿por qué no nos sentamos un rato en la Cámara de Jade o damos un paseo? Descansar también es una parte importante de viajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10213104,
					"content": "Gracias por su hospitalidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Oh, no hace falta que sea tan formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10213106,
					"content": "Tenemos que irnos. Nos vemos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "¿Se van? De acuerdo. Espero que la próxima vez que nos veamos, haya hecho lo correcto... o que esté a punto de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				}
			]
