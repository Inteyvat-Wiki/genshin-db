			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210201,
					"content": "¿Eh? ¿Es imaginación de Paimon, o hay una fragancia dulce muy fuerte en el aire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210202,
					"content": "Además, ¿oíste ese sonido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210203,
					"content": "Suena como si alguien estuviera pidiendo ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "Al parecer, viene de esa jaula de ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210207,
					"content": "Oh, parece que los Ladrones de Tesoros encerraron a alguien ahí dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210205,
					"content": "Suena como si alguien estuviera cantando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "¡No! ¡Definitivamente era alguien en problemas! Vino de esas ruinas de allá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102103",
							"2"
						],
						"stepId": 102103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Buyun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Según Keching, esto es lo que tenemos que decir...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Disculpe, ¿aquí venden lunas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Así es, ¿cuántas quiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210304,
					"content": "No deberíamos hablar de cantidades aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "#Muy bien. Por favor, usen esto para subir a la Cámara. ¿Así que ustedes son {F#las invitadas}{M#los invitados} con {F#las}{M#los} que la maestra Ninguang acordó verse el día de hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210306,
					"content": "¡Así es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Y, sin embargo, el código que usaron era para el Equilibrio Terrenal, no para invitados. ¿Qué está pasando?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buyun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102104",
							"2"
						],
						"stepId": 102104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ninguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "#{F#La}{M#Lo} estuve esperando, viajer{F#a}{M#o} que regresó del Desfiladero Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210402,
					"content": "¡Oh, es Ninguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Como es la primera vez que nos vemos, preparamos un obsequio, ¡espero que sea de su agrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "#¿Para mí? Tienen mi agradecimiento. Aunque son mis invitad{F#as}{M#os}, parece que les hice pasar por muchas dificultades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210405,
					"content": "Jeje, no fue nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "La Cámara de Jade es magnífica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "¡Jaja! Me complace que sea de su agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210409,
					"content": "Este palacio está a más altitud que el pico de cualquier montaña. Es un punto estratégico para observar toda Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210410,
					"content": "He reunido los fondos necesarios para construirlo desde que comencé a aprender el arte de los negocios. Tras convertirme en el Equilibrio Celestial, contraté a los mejores artesanos para expandirlo incesantemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210411,
					"content": "Al principio, era solo del tamaño de una habitación. Ahora es lo suficientemente grande como para tapar la luna del cielo de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210412,
					"content": "Tengo la convicción de que, un día, su sombra eclipsará a las Siete Naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210413,
					"content": "(Qué ambiciosa es el “Equilibrio Celestial”...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "No mucha gente de fuera de Liyue se gana el derecho de ascender a la Cámara de Jade, pero la Gran Maestra Intendente de los Caballeros de Favonius habló muy bien de usted en mi correspondencia con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210415,
					"content": "Es por eso que, desde el primer día en que llegó a Liyue, no le he quitado los ojos de encima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210416,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "Comprendí sus intenciones cuando se dirigieron a la Posada Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210418,
					"content": "Un momento. Entonces, ¡¿Verr Goldet es una de ustedes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "¿Verr Goldet? No, no solo ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210420,
					"content": "Toda la Posada Wangshu es de los nuestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210421,
					"content": "¡¡#%@%*&!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "Hace poco me encontré con el Equilibrio Terrenal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "En la Balista Guizhong, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210424,
					"content": "¿Nos ha estado espiando todo este tiempo desde el cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "#¡Jaja! A esta distancia, es difícil espiarl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210426,
					"content": "Nos bastó con nuestros ojos y nuestros oídos. Después de todo, son ustedes dos personas muy interesantes, es normal sentir interés por ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210427,
					"content": "Keching dijo que las Siete Estrellas no le desean el mal a Rex Lapis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "#Bueno, no esperaba que confiaran en nosotros teniendo en cuenta su inclinación hacia los Adeptus. El motivo por el cual {F#las}{M#los} invité es para aclarar algunos malentendidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210408,
					"content": "Es la primera vez que vengo a un lugar tan alto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ninguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "¡Guau! ¡Qué sala tan grande! Paimon nunca había visto un lugar tan lujoso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "Siéntanse en plena libertad, están en su casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210603,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "#L{F#as}{M#os} invité como amig{F#as}{M#os}. Y cuando las amistades vienen a visitar, lo más importante es que disfruten su estancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210605,
					"content": "Eso de ahí es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "¿Eh? ¿Ese es el muro de la leyenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Vaya, parece que estás bien informada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210608,
					"content": "¡Claro! Incluso los cuentacuentos hablan de él... Todo el mundo quiere un pedazo de papel de ese muro. ¡Es superfamoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "Es porque en ese muro se registran los secretos más confidenciales de Liyue, algo que atrae mucho a los comerciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210610,
					"content": "#Pero esos secretos no deben ser interesantes para usted, viajer{F#a}{M#o}. Usted es muy especial, y creo que es consciente de ello, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210611,
					"content": "Si pudiera, me gustaría ganarme su confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210612,
					"content": "Sin embargo, si tuviera que escoger a alguien de confianza entre Keching y yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210613,
					"content": "Entre tú, que crees en los dioses, y ella...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Jaja. Así que escogería a Keching, ¿cierto? Eso pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210616,
					"content": "Al principio, pensé que era muy testaruda. Con una persona así entre las Siete Estrellas, siempre tenía que arreglar los problema que causaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210617,
					"content": "Pero, después, fue cuando dijo: “El tiempo de los Adeptus ha llegado a su fin. Si las Siete Estrellas de Liyue se niegan a encarar esta verdad, ¿qué futuro hay para Liyue?”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210618,
					"content": "Tengo que admitir que mis dudas se disiparon en ese momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210619,
					"content": "No puedo negar que la muerte de Rex Lapis pueda ser beneficiosa para las Siete Estrellas, pero por el bien de Liyue, no podemos quedarnos de brazos cruzados ante los rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210620,
					"content": "Supongo que los Fatui están detrás de estos rumores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Sí... Parece que desde el principio sabía a lo que me refería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210622,
					"content": "Yo di la orden de cerrar el recinto y resguardar la Exuvia para estabilizar la situación, y para prevenir que ocurriera un incidente similar al de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210623,
					"content": "Los Fatui han aprovechado la muerte de Rex Lapis para actuar más allá de los límites de la diplomacia. Como Equilibrio Celestial, soy responsable de Liyue, y no voy a guardar las apariencias cuando se trata de hacerles frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210624,
					"content": "También teníamos la intención de permitir que llevaran a cabo el Rito del Ascenso para ganar tiempo y tomar las riendas de la administración de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210625,
					"content": "Oh, es tal y como dijo Zhongli. Las Siete Estrellas solo proporcionaron un escenario para usarnos para sus propios fines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "¡Cierto! Hablando de fines... ¿puedo añadir algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210628,
					"content": "#Paimon escuchó que los huéspedes que traen obsequios obtienen algo a cambio... ¿eso nos incluye a nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "¡Paimon! ¿Puedes dejar de pensar en eso por un momento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "¡Jaja! Está bien, me gustan las personas francas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210631,
					"content": "Es cierto, les he causado muchos problemas recientemente. ¿Qué les parece si, como recompensa, se llevan cualquier artículo de por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10210632,
					"content": "¡Qué bien! ¡Paimon sabía que diría eso! Veamos, ¿qué podríamos llevarnos?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "¡Queremos uno de los <color=#00E1FFFF>papeles</color> del muro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "¿?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "¡No mires así a Paimon! Aunque sean del tamaño del dedo meñique, ¡los papeles del muro valen una fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "¡Imagina cuánto ha de valer un papel entero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "La prefiero a ella, que es escéptica de las divinidades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102108",
							"2"
						],
						"stepId": 102108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "#Gracias, amables viajer{F#as}{M#os}. Si no me hubieran rescatado, ¡me habría podrido en esta celda! Esos Ladrones de Tesoros... Cuando estaban de buen humor, arreglaban esas macetas con flores dulces, pero cuando estaban de mal humor, lo que arreglaban era mi cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210802,
					"content": "Oh, no fue nada. ¡No tienes que agradecérnoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "Jaja, lo entiendo. No se preocupen, se lo pagaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210804,
					"content": "De verdad, no hace falta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "¡No digas eso! Solo pude escapar de este suplicio gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210806,
					"content": "Me llamo Meng Dan, soy el proveedor de la tienda Joyas Mingxing de Liyue. Suelo salir de paseo por las montañas en busca de antigüedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210807,
					"content": "No imaginé que los Ladrones de Tesoros tendrían la mira en las mismas ruinas que yo. Antes de que me diera cuenta, ¡ya me habían aprisionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210808,
					"content": "¿Hay algo que les haga falta? Antigüedades, tesoros, tengo todo tipo de artilugios... Siempre y cuando les guste lo que tengo, claro está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210809,
					"content": "Tus buenas intenciones son suficientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "¡Espera! De hecho, hay algo que estamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "¿Eh? ¿Y qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210812,
					"content": "¿Tienes una caja para envolver regalos? Una que sea bonita, de las que se usan para dulces y eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Por supuesto, ¿cómo podría vender antigüedades sin cajas para regalos? En <color=#00E1FFFF>Joyas Mingxing</color> tenemos el mejor servicio de envoltorio de obsequios de las Siete Naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210814,
					"content": "Dame un segundo, hablaré con mi jefa. Pueden ir a verla siempre que necesiten la caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210815,
					"content": "¡Qué bien! ¡Ahora nuestro Slime confitado tendrá una bonita presentación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
			"completionStepIds": [
				102111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102111",
							"2"
						],
						"stepId": 102111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Hola, un tipo llamado Meng Dan dijo que nos daría una caja bonita de su tienda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "Meng Dan me lo contó, gracias por salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Él es quien nos trae muchos de los mejores artículos de nuestra tienda. Si algo le llegara a ocurrir, sería imposible mantener este negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Aquí tienen. Esta caja es una antigüedad en sí misma, tiene al menos 140 años de historia. La acabo de limpiar, ¿les sirve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "¡Por supuesto! ¡Es perfecta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Por cierto, ¿podemos tomar prestado algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Por supuesto, pueden tomar lo que sea del estante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "#¡{NICKNAME}, este jarrón de porcelana es precioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Si usamos esta antigüedad para batir la mezcla, ¡haremos el dulce perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "¡Listo! ¡El único y exclusivo Slime confitado! Ponlo con cuidado dentro de la caja y espolvorea un poco más de azúcar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Oh, cierto, quizás quieran usar un par de flores frescas como decoración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "¡Genial! ¡Se ve hermoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(Por alguna razón, no tengo la conciencia tranquila...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Bien, ahora que todo está en la caja, ¡vamos a darle una visita a Ninguang en la Cámara de Jade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102112,
			"completionStepIds": [
				102112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102112",
							"2"
						],
						"stepId": 102112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "¿Eh? Ahora que Paimon lo ve, no hace falta escoger. Se ve perfectamente cuál es el papel más grande, ¡escojamos ese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "La la la... Veamos qué tiene escrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "¿Eh? Hay un lugar marcado con un círculo aquí. ¿Quizás es un tesoro? ¿O quizás sea nuestro pase hacia la fortuna? Veamos qué tiene escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "“Sello”... “del Permiso”... Ajá, y... “Fatui”... “investigación”... “duplicado”... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Al parecer no es un tesoro, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "Este papel dice que un espía de las Siete Estrellas descubrió rastros de una investigación de los Fatui sobre el <color=#00E1FFFF>Sello del Permiso</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Oh, Ninguang dijo que los Fatui han hecho todo tipo maldades desde las sombras en Liyue. Han difundido rumores y deseado apoderarse del cuerpo del Arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "Pero ¿qué hay de la investigación sobre el Sello del Permiso? Me pregunto qué estarán haciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#Debe haber alguna conexión entre el Sello del Permiso y tú, {NICKNAME}. Parece que aún hay mucho por descubrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "Veo muchas casualidades juntas aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Oh, ¿tú crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Bueno... entonces será mejor que vayamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "No, tengo otra idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Oh, te refieres a que, como no podemos confiar del todo en Ninguang, debemos comprobar que lo que dice es cierto, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "#Paimon no lo entendió así... ¡Creo que Ninguang ha sido muy buena con nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "Bueno, no importa. Como bien dijiste: ¡en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Antes de vernos con Zhongli en el Pantano Dihua, vayamos a inspeccionar el lugar que mencionan estos documentos a ver si es verdad que los Fatui están tramando algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Claramente, Ninguang está tratando de llevarnos allí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
