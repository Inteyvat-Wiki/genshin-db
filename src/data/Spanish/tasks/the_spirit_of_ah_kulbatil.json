					},
					{
						"sceneId": 3,
						"position": [
							-1878.149,
							54.657,
							9647.234
						],
						"pointId": 350900049
					},
					{
						"sceneId": 3,
						"position": [
							-1870.51,
							54.438,
							9653.687
						],
						"pointId": 350900101
					},
					{
						"sceneId": 3,
						"position": [
							-1871.654,
							54.438,
							9655.254
						],
						"pointId": 350900102
					}
				]
			},
			"dialogs": [
				{
					"id": 401730301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730302,
					"content": "(¡No me puedo creer que se haya escapado! Esto es terrible... Me he confiado demasiado. ¡Maldición! Voy a quedar como una tonta...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730303,
					"content": "(Este Kokuchuu debe de ser un escapista profesional o algo así. Pero no puedo decirles eso. Tendré que pensar en otra cosa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730304,
					"content": "¡Citlalí! ¿Lo atrapaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730305,
					"content": "Viendo que ella es la única persona que hay... Diría que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730306,
					"content": "Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730307,
					"content": "He pensado en dejarlo ir por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730308,
					"content": "Pero le he dejado una marca en el cuerpo. Si vuelve a acercarse, podré rastrear cada movimiento que haga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730309,
					"content": "Oh, así que solo había fingido salir de la cueva, pero, en realidad, estaba al acecho para tenderle una trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730310,
					"content": "¡Ah! ¡Así fue como capturaste a Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730311,
					"content": "Pero ¿cómo sabías que Kokuchuu iba a venir aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730312,
					"content": "Porque aquí fue donde dejé el cebo. Sobre la mesa dejé el mapa del Mare Jivari y el fragmento del arco. Tenía la sensación de que eso era lo que realmente buscaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730313,
					"content": "Y, efectivamente, la trampa se activó momentos después de que nos fuéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730314,
					"content": "¿Eh? ¡Entonces sí que es verdad que habías puesto trampas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730315,
					"content": "Por supuesto, solo que estaban programadas para no activarse con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730316,
					"content": "¿Ven? Se lo dije.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730317,
					"content": "Así que el Sr. Kokuchuu me utilizó después de todo... Todo este tiempo, lo único que buscaba era información sobre el Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730318,
					"content": "Así es. En un principio me pregunté por qué dejó el fragmento en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730319,
					"content": "Pero en el momento en el que confirmé la ubicación del Mare Jivari, me di cuenta de que era un señuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730320,
					"content": "Contaba con que el espíritu de Leylan se perdiera y que la tribu viniera a rescatarlo. Entonces, al ayudar a Leylan, le estaríamos ayudando a él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730321,
					"content": "¡Oh! ¡Así que él también estaba pescando! Todo era una estratagema para atraer a un clarividente de verdad que pudiera mirar en el interior del fragmento por él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730322,
					"content": "En efecto. Y alguien mordió el anzuelo, el hilo y la caña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730323,
					"content": "Lo siento. Ese fui yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730324,
					"content": "Pero usted también lo hizo, abuela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730325,
					"content": "¡Si lo hice fue por tu culpa, mocoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730326,
					"content": "En cualquier caso, Kokuchuu nos la ha jugado como ha querido. Se las arregló para lograr sus objetivos sin correr ningún riesgo. Es un tipo bastante astuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730327,
					"content": "¡La verdad es que sí! Si se hubiera encontrado con Citlalí, ¡lo habría descubierto enseguida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730328,
					"content": "Aunque, en realidad... Citlalí, ¿por qué lo dejaste ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730329,
					"content": "*Ejem*... Porque no podía arriesgarme a usar todo mi poder aquí. Era un tipo bastante escurridizo, y si lo hubiera retenido aquí a la fuerza, podría haber causado consecuencias imprevistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730330,
					"content": "¿Fue culpa mía por elegir el lugar equivocado?... Lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730331,
					"content": "Cuando decidí ayudar a Leylan, busqué un lugar con mucha energía espiritual y acabé eligiendo el escondite de este sabio loco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730332,
					"content": "¿Sabio loco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730333,
					"content": "Sí, está durmiendo la siesta justo detrás de esa pared. Sería problemático despertarlo. Por eso no tengo más remedio que contenerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730334,
					"content": "Pero tengo buenas noticias: le arrebaté el fragmento y el mapa antes de que huyera. Puede que me contuviera, pero tampoco le iba a dejar salirse con la suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730335,
					"content": "¡Genial! ¡Así que se ha ido con las manos vacías! Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730336,
					"content": "Sí, más o menos... Lo malo es que le echó un vistazo al mapa antes de irse. No es que la última ubicación conocida del Mare Jivari sea un gran secreto, pero aun así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730337,
					"content": "Sí, suena preocupante... ¿Y si está tramando algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730338,
					"content": "No te preocupes, pienso ir tras él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730339,
					"content": "#Ah, y Leylan, si no tienes objeción, me gustaría regalarle este fragmento y el mapa a {NICKNAME}. Podría serle útil en una etapa posterior de su viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730340,
					"content": "#¡Por supuesto! Faltaría más. {NICKNAME} se lo merece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730341,
					"content": "¿Estás seguro? Es un regalo muy valioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "#Ninguno de nosotros está interesado en tenerlos. Y si hay alguna posibilidad de que te lleven al Mare Jivari, estoy segura de que {F#una aventurera}{M#un aventurero} como tú no querría dejar pasar esa oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730343,
					"content": "La abu Itztli tiene buena intuición para estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730344,
					"content": "Entonces, eh, abu Itztli... ¿Usted cree que sigo siendo un negado espiritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730345,
					"content": "¿Qué clase de pregunta tonta es esa? Viste a través de mi ilusión, ¿no? En parte fue porque la hice imperfecta deliberadamente, pero aun así, es algo que un negado espiritual sería incapaz de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730346,
					"content": "Ororon, dale a este tipo algunas clases cuando tengas tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730347,
					"content": "Lo que seas capaz de aprender, Leylan, dependerá exclusivamente de tu esfuerzo y capacidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730348,
					"content": "Increíble... La vida está llena de sorpresas. Mientras sigas adelante, siempre puedes encontrarte con un fertilizante en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730349,
					"content": "Me alegro mucho por ti, Leylan. Hagámoslo lo mejor que podamos. Quién sabe, puede que algún día ambos nos convirtamos en hermosos repollos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
