						],
						"stepId": 4017304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlalí"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
