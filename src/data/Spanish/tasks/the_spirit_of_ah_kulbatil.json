			"dialogs": [
				{
					"id": 401730101,
					"content": "Hola de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730102,
					"content": "¡Citlalí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730103,
					"content": "El jefe me dio la espada ceremonial. Tiene cierto poder que resulta necesario en situaciones como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730104,
					"content": "No se han olvidado de lo que vamos a hacer hoy, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730105,
					"content": "Por supuesto que no. Vamos a despertar a Leylan, y después le preguntaremos a qué estaba jugando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730106,
					"content": "He preparado el resto de las herramientas para la ceremonia según sus instrucciones, abuela. Tenemos todo lo que necesitamos, así que hoy no debería haber ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730107,
					"content": "Buen trabajo. Entonces, sin más dilación, comencemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730108,
					"content": "Citlalí invoca la espada ceremonial conocida como la “Calamidad de Eshu”.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "Hago mi ofrenda del humo místico: el regalo de las estrellas para una noche sin luna, una guirnalda onírica para el viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730110,
					"content": "Gloria a la Soberana de la Muerte. Desvanécete, desvanécete, desvanécete. Así sea tres veces, y luego tres veces más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730111,
					"content": "¡Aaah! ¿Es algún tipo de conjuro? ¡De repente hace más frío! ¡¿Qué está pasando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730112,
					"content": "Baja la voz. No queremos molestarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730113,
					"content": "Nosotros, hijos del rey-sacerdote, juramos cumplir con nuestro pacto ancestral y destruir el velo del Reino de la Noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730114,
					"content": "Soy Citlalí, atiende mi llamado. ¡Soy Ah K'ulbatil, pastora del apocalipsis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730116,
					"content": "¡Miren! El espíritu de Leylan ha vuelto y se dirige hacia su cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730117,
					"content": "Atravesaré el manto de la noche con el sílex, y expulsaré a todas las almas que no pertenezcan al reino de los muertos.\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730118,
					"content": "¡Obedéceme, Leylan, y regresa a la tierra bañada por el sol! ¡Regresa a tu camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730119,
					"content": "¿F-funcionó?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730120,
					"content": "Eh... ¿Eh? ¿Dónde estoy?... ¿Y ustedes quiénes son?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730121,
					"content": "¡Aaah! ¡Abu Itztli! Qu-quiero decir... ¡Suma Sacerdotisa Citlalí! ¡Por favor, tenga piedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730122,
					"content": "Parece que alguien tiene remordimientos, ¿eh? Conque sabías perfectamente lo que estabas haciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730123,
					"content": "¿Tienes una idea de lo poco que ha faltado para que no puedas regresar? ¿O a lo mejor creías que la vida sería más divertida siendo un objeto inanimado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730124,
					"content": "¡L-lo siento! He metido la pata... Asumo las consecuencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730125,
					"content": "Oh, ¿estás seguro de eso? Entonces, dile adiós a tus padres. Diles esto:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730126,
					"content": "“Adiós, mamá y papá. He decidido que me encanta vivir la vida siendo un cascarón vacío, así que le he pedido a la abu Itztli que me convierta en una estatua de piedra. Así podré proteger la casa durante varios siglos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730127,
					"content": "¡Por favor, no! ¡Se lo ruego! ¡No volverá a ocurrir, se lo prometo! Le estoy enormemente agradecido, Suma Sacerdotisa Citlalí. ¡Gracias por salvarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730128,
					"content": "Hum, no es a mí a quien tienes que darle las gracias. Dáselas a mi nieto. Si no se hubiera dado cuenta de que ocurría algo raro, ni siquiera me habría involucrado en este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730129,
					"content": "No ha sido nada, Leylan. Y no te preocupes por la abuela. Ella es como esos perros que ladran pero no muerden. Nos alegramos de que estés bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730130,
					"content": "Además, alguien te engañó para hacer esto, ¿no? Ese tipo, Kokuchuu... Él es el verdadero culpable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730131,
					"content": "No... El Sr. Kokuchuu no tiene nada que ver. Ha sido todo cosa mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730132,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730133,
					"content": "Bueno, él sugirió lo de usar una poderosa reliquia espiritual como medio, pero fui yo quien tomó la decisión. No fui coaccionado ni nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730134,
					"content": "Lo siento. Ha sido culpa mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730135,
					"content": "Jaja, le han lavado el cerebro pero bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730136,
					"content": "Humm... Entonces, ¿fue Kokuchuu quien trajo la reliquia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730137,
					"content": "Así es. Dijo que era un tesoro relacionado con el Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730138,
					"content": "¡Eso demuestra que se estaba aprovechando de ti! ¡Te utilizó para llevar a cabo el ejercicio de clarividencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730139,
					"content": "Pero si soy un negado espiritual incapaz de lanzar un solo hechizo... ¿De qué le iba yo a servir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730140,
					"content": "Los tipos como yo no podríamos sentir un espíritu aunque pasáramos el resto de nuestras vidas sentados meditando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730141,
					"content": "Pero el Sr. Kokuchuu dijo que si utilizaba un método alternativo para forzar el hechizo y me sumergía en una sustancia rica espiritualmente, podría ser capaz de vislumbrar uno. Parecía mi única opción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730142,
					"content": "¡Pero qué clase de solución es esa!... ¡Es como obligar a un cojo a correr un maratón! Si no fuera por Citlalí, ¡no habrías podido regresar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730143,
					"content": "Lo sé, y lo siento... Es solo que... todos en mi tribu tienen mucho talento, y luego estoy yo, el negado espiritual... No quería seguir siendo el raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730144,
					"content": "Te entiendo muy bien, Leylan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730145,
					"content": "Algunas semillas crecen fácilmente hasta convertirse en un bonito repollo, pero también hay otras que, por mucho que se esfuercen, no logran producir ni un solo brote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730146,
					"content": "No sé por qué ocurren ese tipo de cosas... ¿Tal vez así sea la vida? Pues en ella hay muchas cosas carentes de solución...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730147,
					"content": "Sé que decir esto tampoco cambia nada, pero espero que te haga sentir un poco mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730148,
					"content": "Bueno, dejemos esta conversación por ahora. Tenemos que llevarte con Matla para que te haga un reconocimiento médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				}
			]
		},
