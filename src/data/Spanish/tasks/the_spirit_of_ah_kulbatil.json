							9674.684
						],
						"pointId": 350900106
					}
				]
			},
			"dialogs": [
				{
					"id": 401730201,
					"content": "Bueno, todo bien. Parece que no tienes ninguna anomalía. Solo estás algo desnutrido, así que con que comas algo, te pondrás bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730202
					],
					"speakerTitle": "Matla"
				},
				{
					"id": 401730202,
					"content": "Menos mal. Había oído de casos de gente cuyo cuerpo empezaba a tener necrosis tras pasar mucho tiempo meditando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730203,
					"content": "Qué miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730204,
					"content": "Sí... De todos modos, Leylan, aunque no nos conocíamos hasta ahora, me alegro mucho de que estés bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730205,
					"content": "Bueno, quizás tú no me conocieras, pero... yo he oído hablar mucho de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730206
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730206,
					"content": "#Lo mismo ocurre con la Suma Sacerdotisa Citlalí, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730207
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730207,
					"content": "#¿Eh? ¿Nosotr{F#a}{M#o}s también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730208,
					"content": "Me da un poco de vergüenza decirlo, pero ustedes son la clase de persona con la que siempre soñé en convertirme. Sin embargo, la realidad demuestra que... solo puedo soñar con ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730209
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730209,
					"content": "De verdad, ¿por qué tuve que nacer siendo un negado espiritual? Jaja, bueno, en realidad no importa. Ya estoy acostumbrado a ser un inútil. Gracias a todos por salvarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730210
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730210,
					"content": "Ororon, creo que tienes razón, son cosas de la vida. Prometo que no correré otro riesgo como este en el futuro. Ya les he causado suficientes problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730211
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730211,
					"content": "Leylan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730212,
					"content": "No hace falta que me consuelen, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730213
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730213,
					"content": "Oye, mocoso, ¿de qué estás hablando? Mírame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730214
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730214,
					"content": "¿Eh? ¿Qué pasa, Suma Sacerdotisa Citlalí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730215
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730215,
					"content": "Te he dicho que me mires. Fíjate bien. ¿Notas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730216
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730216,
					"content": "¿De qué está hablando, abuela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730217,
					"content": "#Humm... {NICKNAME}, ¿crees que ella también tiene escrito en la frente “Solo soy alguien a quien le gusta ayudar a los demás”, así en grande y en negrita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730218,
					"content": "Espera, creo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730219
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730219,
					"content": "O es cosa de mi imaginación, o... su cuerpo entero es una ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730220
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730220,
					"content": "No... Debe ser mi imaginación. Yo no podría ver algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730221
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730221,
					"content": "Un momento, yo conozco este truco... Es el mismo que utilicé anteriormente. La abuela debe estar ya muy lejos tras haberse escabullido delante de nuestras narices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730222,
					"content": "¿Ves? Ahora puedes percibir ciertas anomalías espirituales. Felicidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730223
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730223,
					"content": "¿D-de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730224
					],
					"speakerTitle": "Leylan"
				},
				{
					"id": 401730224,
					"content": "¿Pero a dónde va, abuela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730225,
					"content": "¿A dónde voy a ir? Pues a pescar, obviamente. Zoquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730226
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730226,
					"content": "Alguien ha activado la trampa que dejé en la cueva. Parece que nuestro amigo Kokuchuu ha picado el anzuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730227
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730227,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730228,
					"content": "Ya hablaremos más tarde. Vengan a buscarme a la cueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				}
			]
		},
		{
			"id": 4017303,
			"completionStepIds": [
				4017304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4017304",
