					"content": "Su equipo de alquimia parece cosa de aficionados... Golpeamos algunas cosas de casualidad y ya no funcionan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540902
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540902,
					"content": "Vamos a confiscar los bienes robados lo antes posible. Ustedes podrían ayudarnos con todo lo demás.",
					"roleType": "TALK_ROLE_NPC",
