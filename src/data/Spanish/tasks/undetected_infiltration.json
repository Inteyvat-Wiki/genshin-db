			"dialogs": [
				{
					"id": 710541001,
					"content": "Las ballestas se encuentran en buen estado. Ahora son nuestras. Me pregunto cuántos años les caerán solo por tener estas armas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710541002
					],
					"speakerTitle": "Yanbo"
				},
				{
