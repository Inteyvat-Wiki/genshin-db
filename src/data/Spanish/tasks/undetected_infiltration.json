			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "#Llegaron. Sabía que estarían dispuest{F#as}{M#os} a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540202,
					"content": "Los Ladrones de Tesoros deben estar negociando con los Fatui en el gran campamento del este. También han establecido otros tres campamentos más pequeños a lo largo del camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540203,
					"content": "Según nuestro informante, los campamentos son: la <color=#00E1FFFF>cocina</color> al sureste, la <color=#00E1FFFF>armería</color> al este, y el <color=#00E1FFFF>puesto de alquimia</color> al noreste. Si podemos tomar por sorpresa estos tres campamentos, podremos cortar sus suministros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540204,
					"content": "Debido al incidente con la Cámara de Jade, disponemos de pocas patrullas en esta zona, así que han aprovechado para hacer de las suyas. Pero también han bajado la guardia. Es nuestra oportunidad para atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540205,
					"content": "Es solo que... Debido al malentendido de antes, solo disponemos del personal suficiente para atacar uno de los campamentos. Pero si lo necesitan, definitivamente ayudaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
