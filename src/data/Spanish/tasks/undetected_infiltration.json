			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "¡Alto, paren! ¡Por favor, déjennos explicárselo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540102,
					"content": "¿Acaso no son ladrones de tesoros? ¡Entréguense! ¡No necesitamos más explicaciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540103,
					"content": "#Yanbo, Capitán de la Geoarmada en la jurisdicción de la Sima. Es un honor conocerl{F#a}{M#o}, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540104,
					"content": "A usted y... a su famosa compañera flotante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540105,
					"content": "¡Oye! ¡Cómo te atreves a olvidar el nombre de Paimon! ¡Paimon es Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540106,
					"content": "Jaja... Lo siento, lo siento. Creo que ha habido un pequeño malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540107,
					"content": "Espera un momento... ¿No son ladrones de tesoros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "Por supuesto que no, todo lo contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540112,
					"content": "*Ejem*... Bueno, es cierto que esta zona era una base de los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540113,
					"content": "Después de que los trabajadores abandonaran el lugar, esos tipos intentaron infiltrarse... Al principio, solo se dedicaban al contrabando de minerales y de arena cristalizada y a jugar al escondite con nuestras patrullas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540114,
					"content": "Luego incluso se atrevieron a tomar el viejo almacén que dejaron los mineros, ¡y a fabricar sus propias joyas baratas para venderlas! Ay... Fue muy triste ver algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540115,
					"content": "¿Qué fue triste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "Esas joyas de tan baja calidad solo pueden engañar a los que visitan Liyue por primera vez o a los estudiosos alejados de la realidad. Seguro que quieren introducirlas en el mercado a bajos precios. Me temo que acabarán por destruir algunas marcas prestigiosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540117,
					"content": "¡Pero ellos no tienen una marca comercial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540118,
					"content": "Jaja, tienes razón. Hacer dinero con estas cosas es realmente rastrero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540119,
					"content": "Por eso vinimos a hacernos cargo de los ladrones de tesoros que estaban aquí. Nos disfrazamos como ellos y nos escondimos... Bueno, eso fue hace ya tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540120,
					"content": "Hemos averiguado que uno de sus líderes está en contacto con los Fatui, y se sospecha que comercian con materiales peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540121,
					"content": "¿Qué conexión hay entre los Fatui y los Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "Aunque ya habíamos frustrado los planes de los Fatui, siguen operando a las afueras de Liyue... No podemos subestimar sus capacidades y destreza en combate. De hecho, los consideramos bastante peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540123,
					"content": "Si se alían con los Ladrones de Tesoros en nuestra contra... podría suponer un verdadero riesgo para la seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540126,
					"content": "En resumen, teníamos todo lo que necesitábamos para un ataque. Lo único que teníamos que hacer era desenmascararlos y descubrir qué estaban tramando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540127,
					"content": "#Pero cuando nosotr{F#as}{M#os} llegamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540128,
					"content": "#*Suspira*... Sabíamos que eran buen{F#as}{M#os}, pero no pensábamos que fueran tan fuertes... Han derrotado a más de la mitad de mis hombres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540129,
					"content": "Por supuesto, nosotros vinimos por otra razón... Aquí se encuentra una de las llaves rocosas del sello de las Siete Estrellas. No podíamos permitir que cayera en manos de los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540130,
					"content": "Eh... Lo siento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "#Jajaja, ¡está bien! No nos dimos cuenta de que eran ustedes, es culpa nuestra... Nos dieron la orden de dejarl{F#as}{M#os} pasar, ¡pero no pensamos que llegarían tan rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540134,
					"content": "Guau... ¡Este tipo es bastante agradable! ¿Significa que ya podemos irnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540135,
					"content": "#Lo cierto es que yo no l{F#as}{M#os} culpo, pero las leyes de Liyue, sí. Jeje, lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540136,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540137,
					"content": "¡La próxima vez explícate bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "Humm, veamos: agresión y asalto, obstrucción de los deberes de la Geormada, destrucción del sello de las Siete Estrellas, y... contaminación de la escena del crimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540140,
					"content": "Si a eso le añadimos el perdón de la Geoarmada... Felicidades, ¡se podrán quedar en Liyue otros cinco o diez años!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540141,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540142,
					"content": "¿Tengo derecho a un abogado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "Sí... ¡Dennos la lista de abogados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540146,
					"content": "*Ejem*, sin embargo, dejen que termine de hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540147,
					"content": "A pesar de todo, los ciudadanos respetuosos con la ley o los extranjeros pueden utilizar cualquier medio para ayudar a la Geoarmada en sus deberes y obtener a cambio una compensación... Eso dicta la ley de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540148,
					"content": "Así que no se preocupen, la pelea no fue en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540149,
					"content": "¿Qué ganamos por ayudarles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "#Bueno, los bienes robados no se pueden tocar, pero, si están dispuest{F#as}{M#os} a ayudarnos, cualquier artículo que encuentren en el camino, como un cofre secreto de los Ladrones de Tesoros o cosas de ese estilo, será suyo y podrán hacer lo que quieran con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540151,
					"content": "Además, mis colegas y yo también hemos reunido algo de Moras, espero que sea suficiente. *Suspira*... Después de todo, la ayuda inesperada no entraba dentro de nuestro presupuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540152,
					"content": "Entonces... Eso significa que no tenemos que ir a la cárcel ¡y además conseguiremos un tesoro! ¿Verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540153,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540154,
					"content": "¡Está bien! ¡Trato hecho! ¡Muéstrennos el camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540155,
					"content": "¡Espera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "Bueno, si me disculpan, iré al punto de reunión. No lleguen tarde o tendremos que empezar sin ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540158,
					"content": "¡Vamos! ¡Sigámosles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540159,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "¡Rápido, estamos ayudando a la Geoarmada con asuntos oficiales! ¡Además, podremos conseguir Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540156,
					"content": "¡Todavía no he...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "De haberlo sabido habría golpeado más fuerte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "¡Hum! ¡Solo golpeamos a unas personas que parecían problemáticas! ¡¿Quién les dijo que se vistieran como ladrones de tesoros?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540138,
					"content": "¡Lo hizo a propósito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "Parece que golpeamos a la persona equivocada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "Sí, pero la culpa fue nuestra, no de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540124,
					"content": "¿Cuáles son los materiales peligrosos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "Mi informante dijo que los Fatui estaban comprando algo a los Ladrones de Tesoros a cambio de grandes cantidades de Mora y armamento... Pero solo encontró comida y artículos domésticos, así que tal vez fue una trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540109,
					"content": "Son... ¿la Geoarmada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "#Jaja, me disculpo por el malentendido... De hecho, pensábamos que ustedes eran {F#las malas}{M#los malos}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540111,
					"content": "Bueno... En cierto sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
