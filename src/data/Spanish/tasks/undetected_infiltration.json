			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "¡Eso fue increíble! Gracias por su ayuda. Cierto, aquí está su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540702,
					"content": "¡Guau! ¡Cuántos Moras! ¿Eh? ¿En qué momento te cambiaste de ropa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540723,
					"content": "Cuando ustedes pelean... *Ejem*... Bueno, no es importante... Pero tuvimos que ponernos los uniformes por si se les ocurría darnos una paliza por error otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540703,
					"content": "La Geoarmada agradece su ayuda, como siempre. Ah, y, tal y como acordamos, siéntanse libres de echar un vistazo y llevarse lo que necesiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540704,
					"content": "Bueno, quiero decir... Sin incluir los bienes robados que hemos incautado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540705,
					"content": "Felicidades, fue un gran trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "Jaja, claro, fue gracias a ustedes que todo salió bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540709,
					"content": "Eh, quiero decir... Mientras no vayan por el camino fácil como esos ladrones, no les molestaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540710,
					"content": "Hum, ¡no somos esa clase de personas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540711,
					"content": "Jaja, es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540712,
					"content": "*Suspira*... Bueno, de vuelta al tema. Una persona como tú que puede usar los elementos para hacer el bien o el mal... Es una fuerza que no hay que subestimar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540713,
					"content": "Una misión que nos habría tomado semanas, o incluso meses, no fue más que un juego de niños para ti... Si el poder elemental se usara para el mal, podría producir un daño enorme con muy poco esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540714,
					"content": "Por eso creo que no tener una Visión no es algo tan malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540715,
					"content": "He visto a personas que dieron su vida por tener poderes sobrehumanos, solo para convertirse en herramientas y marionetas que otros utilizaban a su antojo. Dime, ¿crees que vale la pena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "La gran mayoría de las personas no tiene una Visión, y quienes realmente pueden entenderlos y protegerlos son también personas comunes y corrientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540718,
					"content": "Como alguien común y corriente, es un honor para mí cumplir con mi deber de protegerlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540719,
					"content": "Si un día ya nadie más obtiene Visiones, o incluso si los Adeptus que custodian Liyue mueren... creo que yo aún seguiría cumpliendo con mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540720,
					"content": "Oh, lo siento... Hablo demasiado. No les estaré robando demasiado tiempo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540721,
					"content": "Bueno, todavía tenemos que revisar y registrar los bienes robados, así que basta de cháchara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540722,
					"content": "En nombre de mis compañeros, quiero darles las gracias por su ayuda y desearles lo mejor en su viaje. ¡Duros como la roca, inamovibles como un peñasco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540707,
					"content": "¿Significa que no tendremos que ir a la cárcel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "Por supuesto. Ustedes ayudaron a la Geoarmada... Bueno, ayudaron a detener a los ladrones con la ayuda de la Geoarmada. ¿Cómo podríamos mandarles a prisión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				}
			]
		},
