			},
			"dialogs": [
				{
					"id": 710540301,
					"content": "Les sugiero que primero se hagan cargo de la <color=#00E1FFFF>cocina</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "Entendido, nos ocuparemos de ello de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
