			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#Ah, tú debes ser {NICKNAME}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "No sé si te acuerdas de mi nombre. Soy Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Hola, Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Hola, hola, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "#Bueno, pues, debes ser muy buen{F#a}{M#o}, ¿no? Te enfrentaste a la Shogun Raiden y te aventuraste a visitar Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "Es cierto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "¡Genial! Tengo una pista sobre cierto tesoro, pero podría ser peligroso. ¿Te interesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "Aunque siempre fui fanático de los misterios, no me gustaría ponerme en un serio peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "Me interesa, cuéntame más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Encontré esto cuando patrullaba el Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "Aunque a simple vista no parece más que una simple losa de piedra, pienso que es la clave para encontrar el tesoro secreto de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "¿El tesoro secreto de Bunkoku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "No sobrevivieron muchos detalles sobre el reino de Byakuya en la historia de Watatsumi, así que tampoco sé gran cosa sobre el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "Una versión dice que Bunkoku fue el segundo Primer Ministro en la historia del reino de Byakuya. Empobreció al pueblo con la imposición de altos impuestos junto con el Hijo del Sol y entonces escondió el tesoro que reunió en la cámara del Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "Finalmente, ocultó la cámara secreta con los espectros solares e invocó criaturas despiadadas y espíritus vengativos de las líneas ley para que la protegieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "Bunkoku quizás tenía un nombre antiguo que sonaba a algo parecido a “Teseo”, o algo así, pero a nadie le importaría tanto como para recopilar en detalle la historia de un traidor despreciable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Regresemos a la losa de piedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "Esta losa de piedra seguramente sea la clave para desbloquear la cámara del tesoro de Bunkoku. Tengo bastante experiencia en el estudio de historias sobrenaturales y casos misteriosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Aquí dice... Humm... Lo tengo en la punta de la lengua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Di la verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "En realidad, encontré la losa de piedra en el almacén del Dainichi Mikoshi, y junto a ella encontré una nota que contiene el texto original y su traducción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Parece que los documentos escritos durante el periodo de transición vienen junto con una traducción. Según dice en esta nota, la losa de piedra está directamente relacionada con el acertijo de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "También dice que hay un total de ocho losas. Hasta ahora, solo hemos recuperado una. Según la nota, la cámara secreta está en una ubicación cercana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "¿Podría molestarles un momento para que echen un vistazo ahí? No me importa el tesoro, si soy sincero. Me contentaría con solo ver la solución al acertijo de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
