					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "¡Yabe! ¡Soy Yabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761204,
					"content": "*Suspira*, vamos, ¿no puedes recordar mi nombre? No me digas que también olvidaste lo que te encomendé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME} solo bromeaba. Descubrimos la verdad sobre el tesoro secreto de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761206,
					"content": "Pones a Yabe al corriente de lo sucedido...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "¿Quieren decir que realmente hay una cámara secreta oculta por los espectros solares? ¿Y que luego sucedió algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761208,
					"content": "¿Y que, además, la cámara estaba custodiada por espíritus y fantasmas vengativos? Oh, eso es terrible. Menos mal que no fui con ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761209,
					"content": "¿Temías hacernos daño?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "Temía que me dieran una paliza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761211,
					"content": "Bueno, me siento contento y frustrado al mismo tiempo. Gracias. Aunque el acertijo sea irresoluble, no hay nada que no se pueda resolver con energía elemental, aunque eso le quita cierto encanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761212,
					"content": "Por fin resolvimos el acertijo de Bunkoku. Se lo diré a todo el mundo cuando regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
