					"nextDialogs": [
						722760504
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760504,
					"content": "Según dice en la nota, las otras losas de piedra se encuentran en tres zonas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760505
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760505,
					"content": "Supongo que tienen el mapa sencillo de Tsumi, déjenme que les indique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760506
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760506,
					"content": "¿Por qué no nos dijiste esto antes?",
