			"dialogs": [
				{
					"id": 722760801,
					"content": "Qué extraño. ¿A dónde fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760802
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760802,
					"content": "Hay una sombra de Tokoyo aquí... ¿Será Bunkoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760803,
					"content": "¡No me confundas con alguien tan despreciable! Yo soy Koyanagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760804
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760804,
					"content": "Pero ya que conocen el nombre de Bunkoku, ¿me siguieron hasta aquí con malas intenciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760805
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760805,
					"content": "Un amigo mío tuvo que leer y analizar muchos documentos para poder encontrar el tesoro secreto de Bunkoku. ¡No permitiré de ninguna manera que me lo arrebaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760806
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760806,
					"content": "#Te equivocas. Nosotr{F#as}{M#os}... eh... llegamos aquí por pura casualidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760807,
					"content": "¡Hum! Entonces márchense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760808,
					"content": "#(Alguien estuvo aquí antes que nosotr{F#as}{M#os}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760809,
					"content": "(¿Acaso nos arrebataron el tesoro?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760810,
						722760812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760810,
					"content": "No puede ser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760811
					]
				},
				{
					"id": 722760811,
					"content": "Eso pensó también Paimon. Si encontraron el tesoro, el acertijo de Bunkoku no sería un misterio a día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760814,
					"content": "¿Qué están murmurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760815
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760815,
					"content": "¡N-nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760816,
					"content": "(Bueno, sigamos investigando este sitio.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760812,
					"content": "Tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760813
					]
				},
				{
					"id": 722760813,
					"content": "No, no, no. Si hubieran encontrado el tesoro, el acertijo de Bunkoku se habría resuelto hace mucho. No continuaría siendo un misterio a día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				}
			]
