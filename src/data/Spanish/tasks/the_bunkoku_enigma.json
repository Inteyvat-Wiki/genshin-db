					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761003,
					"content": "¿Cómo fui capaz de atacar a mi amigo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761004,
					"content": "Creo que me poseyeron esos espíritus vengativos que Bunkoku invocó. Me controlaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761005,
					"content": "El tesoro no vale nada en comparación con nuestra amistad. Y-yo... nunca lo atacaría por un tesoro insignificante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761006,
					"content": "Confía tanto en mí que incluso me invitó a ver el tesoro de Bunkoku... Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761007,
					"content": "No soy así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761008,
					"content": "Humm, entonces, ¿la última losa escondía la verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761009,
					"content": "Creo que deberíamos dejarlo solo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761011,
					"content": "Deberíamos regresar y decírselo a Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
