					"nextDialogs": [
						722760508
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760508,
					"content": "Si esta es una broma de mal gusto de nuestros antepasados, me sentiría muy mal al decirte que te adentraras en la niebla oscura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760509
					],
					"speakerTitle": "Yabe"
				},
				{
