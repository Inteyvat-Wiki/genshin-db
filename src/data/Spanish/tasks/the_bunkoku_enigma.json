			"dialogs": [
				{
					"id": 722760301,
					"content": "Eh, ¿escuchaste eso? Parece que hay un sonido extraño que viene de arriba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760302,
					"content": "Mira, hay un extraño patrón en el techo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760303
					],
					"speakerTitle": "Paimon"
