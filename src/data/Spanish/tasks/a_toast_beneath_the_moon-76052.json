			"dialogs": [
				{
					"id": 760520501,
					"content": "*Glu, glu, glu*....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520502,
					"content": "¡Te lo has terminado de un trago! Vaya, parece que te ha gustado mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "No sabía a nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520504,
					"content": "¿Qu-que no sabía a nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520506,
					"content": "¿No te lo habrás bebido demasiado rápido?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Oh, no es necesario, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520509,
					"content": "Hace tiempo, no comprendía por qué la gente se ponía tan contenta cuando llegaba el tiempo de la cosecha, hasta que un día, yo misma toqué el fruto maduro que colgaba de una rama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520510,
					"content": "Pude sentir la vitalidad que irradiaba a través de la textura de su piel. Los nutrientes provenientes de la luz del sol, del agua, la tierra y el aire le habían dado esa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520511,
					"content": "Con cada mordisco, el dulce y fresco sabor lo inundaba todo como refrescantes olas de blanca espuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520512,
					"content": "Así fue como comprendí el irresistible poder de los aromas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520513,
					"content": "¡Oh, qué reflexión tan interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Al tomar esta fuerza vital en nosotros mismos, completamos el ciclo de la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520515,
					"content": "Oh, eso ya no suena tan bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Por eso prefiero la fruta fresca. Me permite ver lo que me he llevado de este mundo y cómo era originalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520517,
					"content": "A la vez, también me recuerda lo que le debo a este mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520507,
					"content": "¿Te preparo otra taza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
