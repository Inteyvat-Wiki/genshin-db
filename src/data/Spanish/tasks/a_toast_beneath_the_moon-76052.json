						760520402
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520402,
					"content": "Oh, ¿dónde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "En la habitación de Sandrone. Cuando descubrió mi interés por el aroma que desprendían ese tipo de bebidas, se propuso llevar una en la mano durante horas sin bebérsela a propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520404,
					"content": "Como si... estuviera esperando a que le preguntara por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520405,
					"content": "¿Y lo hiciste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520407,
					"content": "¿Qué le preguntaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "“¿No deberías beber aceite para máquinas en su lugar?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520409,
					"content": "Y... ¿qué dijo ella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520411,
					"content": "Nada agradable. Será mejor que no lo diga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520413,
					"content": "¿Solo has probado un sorbo y ya has perdido el interés?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Lo siento, está un poco amargo. No sabe muy bien. Normal que Sandrone pusiera esa cara al bebérselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520415,
					"content": "Paimon cree que eso fue por otro motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
