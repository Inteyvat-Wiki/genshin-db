				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520102,
					"content": "¿Estás bien, Colombina? No pareces muy animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Oh, son ustedes. Estoy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520104,
					"content": "(¿Estará pensando otra vez en la luna?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "¿Hay algo que pueda hacer por ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520108,
					"content": "No pasa nada, puedes decirlo aunque solo sea un problema pequeño. Te sentirás mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Es que me apetece... beber en la taberna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520110,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520112,
					"content": "¡Paimon lo siente! Es solo que se ha sorprendido un poco. Casi nunca hablas de las cosas que quieres para ti misma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "Además... ¿eso era todo? ¿Una bebida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "¿Te parece demasiado simple?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Bueno, tal vez Paimon esperaba un deseo del estilo de “Bajen la luna por mí” o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Pero Paimon puede comprenderlo. Colombina no puede actuar como querría en estos momentos, así que ir a la taberna a beber podría acabar siendo igual de complicado que bajar la luna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "No solo en estos momentos. Cuando estaba con los Fatui, nadie quería atraparme, pero todos se escondían de mí cuando salía a pasear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520118,
					"content": "(La tercera de Los Once... Es normal que ese título inspirara miedo en todos aquellos que no la conocieran...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "¿Eh? Aunque... ¡De repente, a Paimon no le parece un deseo tan difícil de cumplir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Si lo único que quieres es una bebida al nivel de una taberna, ¡{NICKNAME} sabe prepararlas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "... ¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520122,
					"content": "Pero tampoco tengas demasiadas expectativas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "¿Algún requisito en cuanto al sabor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520125,
					"content": "No he probado muchas bebidas de fuera, así que no sabría muy bien cómo guiarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520126,
					"content": "¿Algo que no sea demasiado pesado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520127,
					"content": "¿A qué te refieres con eso de “pesado”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "A algo como el abrigo de los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520129,
					"content": "Cuanto más intentas explicarlo, más perdida está Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Supongo que quieres algo fragante y ligero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Claro, decide tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520131,
					"content": "Déjalo en mis manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
