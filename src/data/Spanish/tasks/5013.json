			"dialogs": [
				{
					"id": 50130801,
					"content": "Ya nos hemos deshecho de todos los monstruos que había en los Vástagos del Eco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "¡Voy a encargarme de ese tumor del Abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Todo bien en el Pueblo de los Manantiales también. ¡Les dimos una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Los Augures Vientonocturno también están bien. ¿Debería ayudar en la Tribu Plumaflora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 50130805,
					"content": "Ya estoy yendo yo. Al parecer, la situación es grave allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "No hará falta. Ya me he encargado yo de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "¡¿Tán rápido?! Pero ¿tú no estabas en la Arena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Sí, es que no te haces una idea de las ganas que tenía de darle a alguien una buena tunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "O-oh, bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansán, la Comunidad de la Feracidad está muy lejos de la Arena, ¿qué hacemos con ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Ah, no te preocupes. Me he puesto en contacto con Varesa y me ha dicho que ya están a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50130812,
					"content": "Pues parece que ya están todas las zonas a salvo y que el Abismo se está debilitando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "¡Sí! Su único plan era sacarnos la ventaja numérica, ¡pero eso no va a funcionar ahora que tenemos la «Oda de la resurrección»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Un momento... El Abismo está mandando un grupo considerablemente grande a la Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Seguramente se haya dado cuenta de que su mayor obstáculo es la «Oda de la resurrección» y quieran acabar con el Fuego Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Pues no se van a salir con la suya. ¡Amigos míos, todos a la Arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "Han caído más tumores del Abismo cerca de la Arena. Dividamos fuerzas para acabar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Ah, y también necesitamos que alguien vigile la entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Yo me encargaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Muy bien, ¡esta es la batalla final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
}