					"speakerTitle": "Venti"
				},
				{
					"id": 3930102,
					"content": "Han pasado tantas cosas últimamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "Espero que esta canción se cante durante años en Mondstadt, igual que «La leyenda de Vennessa».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930105,
					"content": "Esa canción me gusta desde que era pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930106,
					"content": "#{NICKNAME}, ¿cómo te encuentras hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930107,
					"content": "Estoy completamente segura de que podemos lograrlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930108,
					"content": "Maestra Jean, siempre tan fiable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "Incluso el Sr. Diluc nos acompañó hasta el final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930111,
					"content": "Y pensar que al principio lo involucramos en todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930112,
					"content": "por accidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930113,
					"content": "Ustedes me confiaron sus secretos. Yo solamente les devolví el favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3930114,
					"content": "Así que lo que trajo al Sr. Diluc hasta aquí fue la “confianza”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "¿Y tal vez la “responsabilidad” fue lo que trajo a Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930116,
					"content": "¿Qué hay del bardo de pacotilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930121,
					"content": "La libertad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930122,
					"content": "¿La libertad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930123,
					"content": "Cuando llegaron a Mondstadt, ¿no les dijeron que es la Capital de la Libertad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930124,
					"content": "Amber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "¡Jaja! ¡Ten por seguro que ella es una hija de la libertad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930126,
					"content": "Mondstadt es una ciudad romántica sin un rey que la gobierne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930127,
					"content": "Y la gente de Mondstadt es la más libre de las Siete Naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930128,
					"content": "Espero que algún día el dragón que protege a Mondstadt sea también libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930129,
					"content": "Nadie debió engañarlo diciéndole que Mondstadt lo traicionó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930130,
					"content": "Y no debieron decirle que era su deber proteger la ciudad para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930131,
					"content": "Él tiene el derecho y la libertad de escoger su camino en la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930132,
					"content": "Venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930133,
					"content": "#Bien, {NICKNAME}, que los vientos que han soplado durante milenios en Mondstadt te acompañen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930134,
					"content": "Como la última vez, canalizaré el poder Anemo hacia ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930135,
					"content": "¿La última vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#¡Ya veo! Por eso {NICKNAME} dijo que esa voz le era familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930136,
					"content": "¡Lo sabía! ¡La voz que escuché era tuya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "¿Tal vez la “responsabilidad” trajo a Jean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "Y lo que trajo al Sr. Diluc hasta aquí fue la “confianza”, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930119,
					"content": "¿Qué hay del bardo de pacotilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930120,
					"content": "¿Qué hay de Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "#No te preocupes, ¡yo también estoy list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "Ya somos como dos viejos colegas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
