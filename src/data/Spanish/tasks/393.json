			"dialogs": [
				{
					"id": 3930101,
					"content": "Cuando acabe todo, pienso componer una canción de nuestras aventuras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
