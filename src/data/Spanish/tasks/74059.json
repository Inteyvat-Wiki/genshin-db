			"dialogs": [
				{
					"id": 740590401,
					"content": "Si Pucca realmente puede proporcionarme material con frecuencia a largo plazo, quizá podamos producir estos relojes en masa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590402,
					"content": "Sea como sea, ¡se encargarán ustedes!",
