			"dialogs": [
				{
					"id": 740590201,
					"content": "#Pero si son {NICKNAME} y Paimon, ¡cuánto tiempo sin vernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590202,
					"content": "¿Vinieron a recoger más piedras extrañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590203,
					"content": "Oh, ¡has acertado! Pero esta vez tenemos una laaarga historia que contarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Le muestran a Pucca el reloj que les entregó Chesil y le cuentan su plan de utilizar el mineral extraño para fabricar relojes.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "¡C-cuánto talento tiene ese hombre! ¡¿De veras es posible utilizar estas piedras para fabricar relojes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590206,
					"content": "¿Eh? Pero las piedras solo servirán para elaborar el rotor en el interior del reloj...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "¡Entonces será capaz de hacer tic tac debajo del agua! ¡Nunca había visto un reloj como este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590208,
					"content": "Oh, Chisel mencionó que se inspiraron en una ostra para determinar su estructura... ¿O será que dijo concha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Jeje, ¡me pongo contenta solo con escuchar el sonido que emite este reloj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590210,
					"content": "No esperaba que una piedra tan común pudiera usarse para fabricar algo tan maravilloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590211,
					"content": "Antes estaba convencida de que solo podría elaborar objetos de valor utilizando piedras poco comunes. No imaginé que podrían construirse objetos tan alucinantes con una piedra que podría recoger en cualquier parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590212,
					"content": "Todo tiene una utilidad en este mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Oh, ahora siento un poco más de confianza en mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590214,
					"content": "Pucca coloca el reloj en un lugar bonito con sumo cuidado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Ahora, solo tendrás que dejar esos minerales listos para cuando Chesil quiera comprarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Y entonces podrás tener tu propio taller de minerales, ¡igual que tu hermana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Pucca, tienes tantos tipos de piedras... ¡Quizá haya otras que también te puedan servir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Sí, lo dejaré todo preparado con antelación. ¡Mil gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590219,
					"content": "Si alguna vez buscan algún otro tipo de piedra, ¡ya saben que pueden venir a buscarme cuando quieran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740590220,
					"content": "Jeje, ¡no ha sido nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
