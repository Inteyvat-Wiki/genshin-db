			"dialogs": [
				{
					"id": 750711001,
					"content": "#Jaja, mis querid{F#as}{M#os} amig{F#as}{M#os}, {NICKNAME} y Paimon. Mi musa y... ¡mi minimusa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711002,
					"content": "#Ah, ¡y {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711003,
					"content": "¡¿Mini?! ¡Mira quién fue a hablar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Jaja, ¡no le des importancia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711006,
					"content": "¡Hum! ¡A Paimon le molesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "¿Tienes nueva inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Por supuesto, aunque... eh... Jeje, nueva inspiración significa que... les tendré que pedir ayuda de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711009,
					"content": "¡No hay problema! ¡Tú siempre nos pagas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Jaja, muy bien, ¡mis pequeños mercenarios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711017,
					"content": "Miren, esta vez voy a tomar una imagen de un Tepetlisaurio... Shh, tenemos que tener cuidado de no molestarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711018,
					"content": "Es la primera vez que tengo contacto con este tipo de saurios, pero llevo una temporada observándolos... Son criaturas realmente fascinantes, cada una con una personalidad única bajo su firme coraza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711019,
					"content": "Jeje, después de darle de comer algunas veces, ahora ya puede entender algunas órdenes simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711020,
					"content": "#Pero lo que necesito, mis querid{F#a}{M#o}s domasaurios, es que me traigan un Tepetlisaurio que se haya separado de su grupo para que pueda tomar una imagen de él interactuando con los de su especie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711021,
					"content": "Jaja, ¿es fácil, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711022,
					"content": "Sí, ¡a Paimon le parece facilísimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Como no eres tú la que hace la tarea...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Jaja, ¡ese es el espíritu! Vamos, en cuanto me traigan al Tepetlisaurio que se ha separado del grupo, ¡podremos empezar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711024,
					"content": "(¡No es tan sencillo!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "¿Necesitas ayuda de tus musas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Musa... suena a mousse... A Paimon se le está haciendo la boca agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "*Rugido de la barriga*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Eh... Es musa, ¡no mousse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711015,
					"content": "Jeje, con tal de que nos pagues, ¡podremos ir a comprar mousse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "Jaja, como quieras... Pero, efectivamente, tengo dinero, ¡así que no tienen que preocuparse por la recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnífico"
				}
			]
		},
