			"dialogs": [
				{
					"id": 750711321,
					"content": "Derrotan al enemigo y rompen la puerta de la jaula que encerraba al animal de carga. El animal de carga sale felizmente y les regala un grito de júbilo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "*Uff*... ¡Lo conseguimos! ¡Qué emocionante ha sido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "¡Shh! Mira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711303,
					"content": "¡*Clic*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711304,
					"content": "Perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711305,
					"content": "Guau, se llevan muy bien. Paimon creía que el animal de carga sería devorado... o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Jeje, los Tepetlisaurios tienen aspecto de malotes, pero en realidad son muy apacibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711307,
					"content": "Por fin hemos terminado. Toma la copia. Y aquí tienen la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711308,
					"content": "*Suspira*... Yo que pensaba capturar la escena de una cría de Tepetlisaurio mostrando cariño a uno adulto, ¡va el animal de carga y le roba el protagonismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711309,
					"content": "Jaja, pero Paimon piensa que los animales de carga también son adorables. ¡Seguro que piensas lo mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Mi opinión no es importante. ¡Lo que importa es lo que opine el comité de daguerrotipia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711311,
					"content": "No obstante, es peligroso para este pequeño animal de carga andar por un entorno desconocido como Natlan, y yo justamente necesito un compañero que me ayude a llevar algunas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711312,
					"content": "Jeje, supongo que no tengo más remedio que adoptarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711313,
					"content": "¿Y qué pasa con su dueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hum, ¡pues no haber dejado a este pequeñín en un sitio tan peligroso! ¡Que se haga responsable de sus acciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711317,
					"content": "Bueno, dejemos ese tema. ¡Galería de daguerrotipia de Fontaine, allá voy! Jaja, ¡ustedes también tienen que venir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711318,
					"content": "#Disculpen, pero esta vez de verdad que me voy de Natlan. ¡Adiós, {NICKNAME} y Paimon! ¡Adiós, pequeño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711319,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711320,
					"content": "#Ah, y... ¡tomen! ¡Un recuerdo para que no se olviden de mí, amig{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				}
			]
		},
		{
