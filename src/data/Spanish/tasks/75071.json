			"dialogs": [
				{
					"id": 750711101,
					"content": "¿Te has dado cuenta? Nuestro pequeño amigo parece haberse percatado de algo... ¿Será algún pariente suyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750711102,
					"content": "¡Se ha ido para allá! ¡Vamos a seguirlo! ¡Que no se nos pierda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				}
