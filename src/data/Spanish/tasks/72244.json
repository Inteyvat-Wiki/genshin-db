			"dialogs": [
				{
					"id": 722441101,
					"content": "#Una, dos, tres... {NICKNAME}, ¡parece que ya mostramos nuestros respetos a las siete tumbas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Volvamos al altar de piedra para contárselo al espíritu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
