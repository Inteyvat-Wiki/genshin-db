			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clímene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Las siete luces espirituales se han encendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440302,
					"content": "Parece que has completado tu misión. Siempre recordaré cuánto me ayudaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440303,
					"content": "Ahora permíteme abrir el camino hacia el Emplazamiento del Guía de las Almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440304,
					"content": "#Oh, viajer{F#a}{M#o} de tierras lejanas, sé que te he causado muchas molestias... Pero, por favor, me gustaría que presenciaras la ceremonia del descanso de sus almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440305,
					"content": "Sigue este camino. Yo te esperaré al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clímene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clímene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#Ah, viajer{F#a}{M#o}, llegaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440402,
					"content": "Este es el Emplazamiento del Guía de las Almas. Aquí yacen mis últimos pensamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440403,
					"content": "Cuando los Hijos del Sol alcanzaban cierta edad, asistían a una ceremonia para entrar al Dainichi Mikoshi en el día de su nacimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440404,
					"content": "¿Entrar al Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Sí, esa ceremonia se conoce como el “ritual del regreso solar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440407,
					"content": "Los Hijos del Sol nacieron en el Dainichi Mikoshi y debían regresar al trono del sol antes de ser contaminados por el mundo mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440408,
					"content": "La temperatura del Dainichi Mikoshi era tan alta que calentaba todo el reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440409,
					"content": "De los Hijos del Sol, lo único que regresaba al Emplazamiento del Guía de las Almas eran jirones de sus almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440410,
					"content": "Pero sigo pensando que quizás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440411,
					"content": "¿Quizás...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Si fuera yo quien abriera el Emplazamiento, podría usar mis recuerdos para completar lo que queda de sus almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440426,
					"content": "Permíteme intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440427,
					"content": "Piramumon... Orupeusu... Estoy aquí. ¿No van a volver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440429,
					"content": "¿Qué pasó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*Suspira*, de los siete Hijos del Sol, Piramumon y Orupeusu fueron criados por mí, y ni siquiera ellos están dispuestos a responder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440413,
					"content": "Parece que mis recuerdos no son suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440414,
					"content": "Si tan solo hubiera algo que pudiera usar como medio... Si tuviera la Brida divina, la insignia de los Hijos del Sol, tal vez podría funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440415,
					"content": "Qué lástima que la Brida divina se perdiera hace mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440416,
					"content": "*Suspira*, esta nación, el reino de Byakuya, sigue odiando a esos niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440417,
					"content": "Parece que intentar liberar sus almas no es más que un sueño imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440418,
					"content": "#Viajer{F#a}{M#o}... considera esta mi última petición. ¿Podrías ayudarme a encontrar la Brida divina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440419,
					"content": "Sé que las posibilidades de encontrarla son mínimas y que estoy abusando de tu amabilidad al pedirte este favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440420,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440421,
					"content": "Lo comprendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Yo... ¡te lo agradezco mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440424,
					"content": "La Brida divina ha estado desaparecida durante mucho tiempo. No te apresures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440425,
					"content": "Si tienes alguna noticia, por favor, avísame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440422,
					"content": "Haré todo lo posible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Significa que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
