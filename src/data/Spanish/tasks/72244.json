			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clímene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Humm, qué extraño. No había visto a alguien con tu atuendo desde hace muchos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440102,
					"content": "Por tus modales, no creo que seas del reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440103,
					"content": "#¿Acaso eres {F#una viajera}{M#un viajero} de lejos que cayó en este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440104,
					"content": "Exacto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "No pensé que hubiera forma de acceder al reino de Byakuya desde el mundo exterior... Realmente sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440106,
					"content": "Nací aquí y nunca había visto a nadie del mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440107,
					"content": "Alguien me dijo una vez que quería ver el mundo exterior y lo tomé como una broma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440108,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440109,
					"content": "#Viajer{F#a}{M#o}, a decir verdad, tengo una petición que hacerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440110,
					"content": "Hay siete tumbas de la realeza diseminadas por el reino de Byakuya. En ellas están enterrados los restos de nuestros Hijos {RUBY#[S]Faetones}del Sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440111,
					"content": "Hijos del Sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Sí, aquí adoramos al Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440113,
					"content": "Cada cierta cantidad de años, un niño es elegido como el Hijo del Sol y obtiene el control del reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440114,
					"content": "Tuvimos... siete Hijos del Sol en total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440115,
					"content": "#Oh, {F#extraña viajera}{M#extraño viajero} de otra tierra, por favor, ten la amabilidad de presentar tus respetos en sus tumbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440116,
					"content": "#Pero ¿por qué necesitas que {F#unas forasteras}{M#unos forasteros} hagamos eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "¿No son normalmente sus familiares y amigos quienes les presentan respetos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "De hecho, ese sería el caso normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440119,
					"content": "Por desgracia, me temo que nadie en este reino querría hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440120,
					"content": "En realidad, es probable que nadie haya visitado esas tumbas en mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440121,
					"content": "Pero... ¿por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "¿Acaso a la gente de aquí no le gustan los Hijos del Sol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "“No gustar” es quizás demasiado amable... “Detestar” podría ser más adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440124,
					"content": "Como dije antes, los Hijos del Sol se convertían en dirigentes en cuanto nacían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440125,
					"content": "Pero ¿cómo podían unos simples niños gobernar un reino? Los que realmente controlaban todo eran personas poderosas desde las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440126,
					"content": "Los Hijos del Sol eran meras marionetas, y esa gente manipulaba todos sus movimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440127,
					"content": "Sin embargo, la codicia de esos poderosos no tenía fin. Se enriquecieron a costa del trabajo del pueblo, y dirigían a los Hijos del Sol para que cometieran actos atroces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440128,
					"content": "Y así, la ira del pueblo aumentó, y muchos de esos pecados fueron atribuidos a los Hijos del Sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440129,
					"content": "Qué terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "¡Los Hijos del Sol eran inocentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "¿Inocentes? No, en absoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440132,
					"content": "Para el pueblo del reino de Byakuya, la ignorancia de los Hijos del Sol fue el mayor de sus pecados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440133,
					"content": "Aunque un pecado sea cometido por ignorancia, puede herir a otros. ¿La persona que comete esa falta puede realmente considerarse inocente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440134,
					"content": "Sería difícil, ¿no? Porque el daño que causa es irreparable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440135,
					"content": "Si eso crees, ¿por qué me pides esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Bueno, digamos que es... una solicitud que viene de mi corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440138,
					"content": "Me llamo Clímene. Yo era la responsable de cuidar a los Hijos del Sol en su día a día en el Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440139,
					"content": "Aunque sabía que hacían mal, y era consciente de que estaban siendo manipulados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440140,
					"content": "Seguían siendo los niños que veía crecer. Me compadecí de ellos, y lloré por ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440141,
					"content": "Y al final de todo, no podía odiarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440142,
					"content": "Aunque mi trabajo era permanecer a su lado todos los días, yo estaba bajo estricta vigilancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440143,
					"content": "No tenía permitido decir ni una sola palabra cuando estaba con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440144,
					"content": "Pero cuando estábamos solos, cuando necesitaban ayuda y sentían miedo, me contaban tantas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440145,
					"content": "Y yo no podía responderles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440146,
					"content": "Si hubiera tenido el valor de decirles algo, lo que fuera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440147,
					"content": "Tal vez... todo hubiera sido diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440148,
					"content": "Por favor, te lo ruego. No puedo verlos a la cara después de todo lo que pasó, así que esta es la única forma que tengo de honrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440149,
					"content": "#Por favor, viajer{F#a}{M#o}, ayúdame solo esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440150,
					"content": "Lo único que te pido es que coloques una perla de coral en cada una de sus tumbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440153,
					"content": "De esta manera, podrás encender las luces espirituales en el altar de piedra y abrir el camino hacia el Emplazamiento del Guía de las Almas para traer paz a sus espíritus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440151,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Muchas gracias. Lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440136,
					"content": "¿Por qué quieres que presente mis respetos en sus tumbas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
		{
