				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ah... Sí, esta es... ¡es la Brida divina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440602,
					"content": "#Nunca pensé que llegaría el día en el que volvería a verla... {F#Viajera}{M#Viajero}, ¿dónde la encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440603,
					"content": "La conseguí de Aberaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "¿Del mismísimo Aberaku no Mikoto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440605,
					"content": "Qué extraño. Recuerdo perfectamente que él fue una figura importante cuando nuestra nación acababa de fundarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440606,
					"content": "Pero luego se dijo que pretendía usurpar el trono del Hijo del Sol y por eso lo acusaron de traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440607,
					"content": "Aunque, ya que dices que te la dio él, quizás haya ciertas cosas que yo no haya comprendido bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440608,
					"content": "El destino quiso que la Brida divina resurgiera ahora... Ah, todavía puedo recordar los rostros de esos niños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440609,
					"content": "De esta manera, por fin podré pagar por mis errores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440610,
					"content": "#{F#Viajera}{M#Viajero}, coloca la Brida divina en el estanque del Emplazamiento del Guía de las Almas. De esta forma, seguramente podremos revivir sus almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722440611,
					"content": "Sí, cuando sus almas estén completas, ¡podrán dirigirse hacia una mejor vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clímene"
				}
			]
		},
