			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clímene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon... Adorabas los libros, alegando que existe un mundo más allá de nuestro conocimiento, aunque no te creí en ese entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441202,
					"content": "Siempre sonreí y negué con la cabeza ante tus locas afirmaciones. ¡Ay! Debería haberte creído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441203,
					"content": "Dijiste que un día escaparías del Dainichi Mikoshi y te aventurarías en otra travesía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441204,
					"content": "Vete ahora, Piramumon. No dejes que nadie se interponga en tu camino. ¡Márchate y sé libre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441205,
					"content": "Y tú, Orupeusu, Orupeusu... Lo que daría por volver a oírte cantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441206,
					"content": "Nadie podía escuchar tu voz clara y pura sin que deseara en su corazón cantar al unísono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441207,
					"content": "La noche antes del ritual del regreso solar, de repente deseaste escuchar mi voz. Sin importar cómo, solo deseabas oírme cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441208,
					"content": "Me dijiste que, aunque mi canto sonara horrible, nunca te reirías de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441209,
					"content": "Lo sabías, ¿verdad?... Sabías que este sería tu último regreso solar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441210,
					"content": "Y aun así... Hasta el final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441211,
					"content": "¿Clímene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "... Disculpen. Eso fue inapropiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441213,
					"content": "Se supone que la mujer a cargo de los Hijos del Sol debe proteger su pureza... Nunca debe casarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441214,
					"content": "Por eso nunca tuve hijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441215,
					"content": "Esos niños, que cuidé y vi crecer... En cierto momento llegaron a ser como mis propios hijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441216,
					"content": "#Gracias, {F#viajera}{M#viajero}. Gracias por encontrar la Brida divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441217,
					"content": "Esta Brida pasó por las manos de todos los Hijos del Sol, y los recuerdos vividos con ella son suficientes para llenar el vacío de sus almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441218,
					"content": "... Aunque esos recuerdos tengan una doble cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441219,
					"content": "¿Doble cara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Por supuesto. En este caso, los recuerdos son dobles. Por un lado, están tus propios recuerdos. Por otro, están los recuerdos que otros tienen de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441222,
					"content": "Esos vacíos se llenan con los propios recuerdos de los Hijos del Sol, grabados en la Brida divina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441223,
					"content": "Y con los recuerdos de ellos como niños que fueron culpados por el reino de Byakuya, esos que se convirtieron en hijos del pecado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441224,
					"content": "Mis propios recuerdos no son suficientes, así que tuve que complementarlos con los de la gente de nuestro reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441225,
					"content": "Gracias a esos pecados de los que fueron acusados, ahora son recordados por el reino de Byakuya y pueden dejar sus espíritus atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441226,
					"content": "#Gracias, {F#viajera}{M#viajero}. Mi mayor deseo ya se ha cumplido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441227,
					"content": "Por fin... puedo estar en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441228,
					"content": "Sí... por fin puedo estar con esos niños de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clímene"
				},
				{
					"id": 722441220,
					"content": "¿Los recuerdos tienen caras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
