	"talks": [
		{
			"id": 7066101,
			"completionStepIds": [
				7066101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
