			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "#¡Ad astra abyssosque! ¡Bienvenid{F#a}{M#o} al Gremio de Aventureros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Acabamos de recibir un encargo del Gremio de Pescadores. Dicen que la actividad pesquera en los alrededores ha sido inusual últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Sin embargo, no dieron más detalles. ¿Podrías ir a ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Creo que, tratándose de ti, podrás superar cualquier problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "¿Gremio de Pescadores? ¿De los que pescan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "¿Eh? Creo que no te entiendo... Si no son de los que pescan, ¿de qué más van a ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "¡Ah, el Gremio de Pescadores! ¡Suena a que deben pescar muchos peces deliciosos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "¡Dejemos de perder el tiempo y vayamos a averiguar! Je... Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "Los peces han estado muy activos últimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "Ah, ¡al fin llegó la ayuda! ¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "Mi nombre es Nantuck, soy un pescador experimentado del Gremio de Pescadores de Mondstadt. *Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Recientemente, nuevas especies de peces han aparecido en aguas cercanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "Me puse en contacto con los socios del gremio en otras regiones, y tal como imaginaba, ha estado ocurriendo por todos lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "¡Incluso hay gente que dice que se trata del boom pesquero más grande del siglo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "En realidad, no sabemos a ciencia cierta los detalles detrás del fenómeno, pero supongo que tiene que ver con que las condiciones ambientales han mejorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Oh... Paimon supone que los peces deben estar dando problemas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "¡No te preocupes, Paimon se hará cargo! Siempre y cuando no sepan mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Jaja, no es un problema, para nada. Por supuesto, para el Gremio de Pescadores, mientras más peces, mejor. Pero primero, necesitamos suficientes pescadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "A decir verdad, con la mano de obra que tenemos actualmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "Atrapar todas las nuevas especies en un periodo tan corto de tiempo para llevar a cabo una investigación... es un poco estresante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "Por otro lado, también es una gran oportunidad para que el Gremio de Pescadores crezca, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "Es por eso que publiqué un encargo en el Gremio de Aventureros. ¿Y bien? ¿Les interesaría unirse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "¡La pesca es divertida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "#No hay problema, soy buen{F#a}{M#o} pescando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "#¡Excelente! ¡Te veo muy entusiasmad{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "Entonces comencemos yendo al otro lado del Lago de Sidra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "Allí está el lugar de pesca que preparé para los principiantes. Primero les enseñaré lo básico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "¿Puedo meterme directamente en el agua para atraparlos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Es muy peligroso saltar directamente al agua. Ustedes, los aventureros, sí que tienen agallas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Es una lástima que esos peces no sean tan valientes como ustedes. En cuanto se metan en el agua, saldrán huyendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "Lo mejor es que no lo intenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
