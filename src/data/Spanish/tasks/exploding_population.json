		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "¡Aquí es! ¿Ven esos peces que hay en el agua? Bonitos, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Estos utensilios son para ti: cañas de pescar, cebo y recetas para cebo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "En primer lugar, coloca el cebo en el anzuelo, apunta hacia donde se reúnen los peces ¡y arrójalo! Entonces, es solo cuestión de esperar a que uno muerda el anzuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Escuché que los nuevos tienen una especie de “suerte de principiante”. En aquel entonces, ¡yo atrapé una perca de medio metro! Vamos, inténtalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Espero que pueda pescar otra Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "¡Oye! ¡Una Paimon es más que suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "¿Paimon? Qué nombre tan extraño, ¿es una especie de pez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "Es un “marisco milagroso” que pesqué la última vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "¡Oye! ¡¿Paimon pasó de ser “comida de emergencia” a “marisco milagroso”?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "#¡Ya veo! No imaginé que fueras {F#una pescadora}{M#un pescador} con experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "¡Ahora estoy más emocionado por ver qué logras atrapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066106,
			"completionStepIds": [
				7066106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066106",
							"2"
						],
						"stepId": 7066106,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"7066110",
							"3"
						],
						"stepId": 7066110,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "¿Y bien? ¡A juzgar por tu expresión, pescaste algo bueno! Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "¡Oh, es una nueva especie! Nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "¡Eres casi como yo en mi época dorada! ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "¿También puedes atrapar peces con las manos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "*Ejem*... Parece que estos son peces pequeños para ti... Literal y metafóricamente. Deberíamos intentar un desafío mayor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
