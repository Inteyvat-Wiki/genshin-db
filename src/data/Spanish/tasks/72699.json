			"dialogs": [
				{
					"id": 726990101,
					"content": "No conozco tus habilidades con la espada, pero espero con ansias este combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990102,
					"content": "¿Tú también...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "En realidad, cuando dije que participarían cuatro luchadores, también me estaba contando a mí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990104,
					"content": "Aunque yo soy el organizador del combate, no tengo más remedio que luchar, pues hay muy pocos participantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990105,
					"content": "Además, este cuerpo ha nacido para luchar. Me llamo Yasuhiko Tarou, tú decidiste retarme, ¡prepárate para morir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990106,
					"content": "Jaja, ¡siempre quise decir esa frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990107,
					"content": "¡¿Eh?! ¿Pero de qué está hablando este tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726990108,
					"content": "No podemos subestimarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "¡Bien dicho! Tratando a todos los oponentes por igual, haces que te respete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990110,
					"content": "Si no hubiera juzgado y subestimado al cuarto luchador por su apariencia, no habría tenido una derrota tan estrepitosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990111,
					"content": "#¡Pero yo ya no soy así! Bueno, {NICKNAME}, ¡comencemos con el combate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990114,
					"content": "Ven aquí si te atreves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990112,
					"content": "Espera un momento, tengo que prepararme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "Sin problema. Prepárate bien antes de comenzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				}
			]
		}
	]
