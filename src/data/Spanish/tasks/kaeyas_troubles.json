						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610404,
					"content": "¡Hum! ¡No vinimos para hacer algo tan simple!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610405,
					"content": "Estamos buscando una espada superpoderosa que cayó de Celestia. ¡Mató a la banshee de ocho cabezas y la hidra de cabello plateado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610407,
					"content": "Es la hidra de ocho cabezas y la banshee de cabello plateado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "Paimon, no hables de más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "¡Es una superespada megapoderosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610408,
					"content": "¡Eso es lo que dije! ¡Una espada superépica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610409,
					"content": "De todos modos, mientras no les diga la ubicación del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610411,
					"content": "¡No pasa nada! Mientras no les diga la ubicación del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610413,
					"content": "(Ya metió la pata...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "Entonces, Cyrus, ¿sabes dónde se supone que están las ruinas de Arcadia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610414,
					"content": "Las ruinas de Arcadia... Nunca he oído hablar de un lugar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610415,
					"content": "Pero gracias por tu información. Si encuentras estas ruinas, me encantaría verlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610416,
					"content": "¿Eh? ¿Mi... información?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610429,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
