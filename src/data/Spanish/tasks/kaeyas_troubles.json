			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "Esto está muy mal... Qué lío... ¿Qué voy a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "¿Qué pasa, Kaeya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#¡Oh, gracias a los mil vientos! ¡{NICKNAME}, tu llegada debe ser una bendición de los dioses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "#Enviad{F#a}{M#o} del dios Anemo, para salvar a este pobre mortal, ¿podría dedicarme un poco de su tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "¡Déjate de cumplidos y ve al grano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "#No estoy particularmente ocupad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "¡Maravilloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "¡No puedo dejar que mis compañeros se enteren de esto! No puedo pedirle ayuda a nadie más que a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "Pero primero, vayamos a un lugar más adecuado para hablar de ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "Vayamos al patio afuera de los cuarteles para hablar. Vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "Cuánto secretismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "Dime, ¿que sucedió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "¿Estás bien? Tú nunca sueles estar así de inquieto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "Este lugar está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610202,
					"content": "¡Ahora cuéntanos de qué se trata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610203,
					"content": "¿Por dónde empezar? Oh, cierto, déjenme contarles primero un secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610204,
					"content": "Es un secreto de mi pasado, y confío en que lo guardarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610205,
					"content": "No te preocupes. Paimon es una tumba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610206,
					"content": "El hecho es que... ¡mi abuelo era un pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610207,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610208,
					"content": "¿Por qué suenas tan desinteresada? ¿Crees que me lo estoy inventando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610209,
					"content": "¡Mira mi parche en el ojo! ¡Lo heredé de mi abuelo y es una prueba contundente de que estamos relacionados por sangre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610210,
					"content": "No sabía que los parches del ojo se heredaban.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#¡Por Los Siete! {NICKNAME}, ¿cómo no puedes saber algo tan básico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610212,
					"content": "¡Es como los niños que heredan el pelo de sus padres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610214,
					"content": "Ayer estaba leyendo las notas que dejó mi abuelo, y me topé con unos escritos que hablan de un <color=#00E1FFFF>tesoro</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610215,
					"content": "... ¿Un tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610216,
					"content": "Según sus notas, el tesoro está enterrado en las Ruinas de Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610217,
					"content": "Un tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610218,
					"content": "Pero actualmente se desconoce su paradero, aunque he intentado buscar pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610219,
					"content": "¡Un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610220,
					"content": "¿Qué tipo de tesoro es, Kaeya? ¿Oro? No, no, no, ¿gemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610221,
					"content": "¡Hum! El oro y las gemas no son más que tesoros de tercera categoría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610222,
					"content": "El tesoro de mi abuelo es una espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610223,
					"content": "¡Una espada mágica que otorga al portador un poder sin igual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610224,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610225,
					"content": "La espada fue arrojada al mar por un dios de Celestia. Más tarde, la recuperó la tripulación de mi abuelo por mera coincidencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610226,
					"content": "En el momento en que tomó la espada, los truenos rugieron, las olas aullaron y un viento furioso envolvió los cielos despejados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610227,
					"content": "Con el poder de la espada mágica, mi abuelo derrotó a una hidra, una banshee de cabello plateado, un malvado dragón del abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610228,
					"content": "Pero el inmenso poder de la espada atrajo a muchos piratas codiciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610229,
					"content": "Para evitar conflictos triviales, mi abuelo escondió la espada mágica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610230,
					"content": "Una hidra, una banshee... ¿Realmente existen tales cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "El mundo en el que vivimos es fascinante porque está lleno de maravillas desconocidas e inexplicables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610233,
					"content": "Estas aventuras tan increíbles solo podrían ocurrir en la emocionante vida de un pirata, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610234,
					"content": "¡Guau! ¡Increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610235,
					"content": "Una pandilla de <color=#00E1FFFF>Ladrones de Tesoros</color> ha estado muy activa últimamente y han robado las reliquias de muchas ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610236,
					"content": "Me temo que pronto descubrirán las ruinas de Arcadia, y la espada mágica se perderá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610237,
					"content": "¡No dejaremos que caiga en las manos equivocadas! Debemos conseguir la espada antes que ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610238,
					"content": "#¡Puedes estar tranquilo, {NICKNAME} y Paimon están aquí para ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610239,
					"content": "¿Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610240,
					"content": "Pero, por favor, manténganlo en secreto. ¡Espero buenas noticias de ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610241,
					"content": "#Oye, {NICKNAME}, ¿qué piensas? ¿No suena emocionante? Quiero decir, ¡es una espada superpoderosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610242,
					"content": "¿Será verdad lo que dice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Bueno... vayamos al <color=#00E1FFFF>Gremio de Aventureros</color> y veamos si podemos obtener más información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610245,
					"content": "Los aventureros deberían saber más sobre las ruinas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610243,
					"content": "¿Será realmente cierto lo que dice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "Me dejas sin palabras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610214
					]
				}
			]
		},
		{
			"id": 46104,
