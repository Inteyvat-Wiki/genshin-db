			"dialogs": [
				{
					"id": 4610801,
					"content": "Oh, han vuelto. ¿Tienen noticias para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610802
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610802,
					"content": "Preguntamos en el Gremio de Aventureros y... no tenemos ninguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610803,
					"content": "¡Jaja! Eso pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610804
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610804,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610805,
					"content": "Quiero decir, ¿qué hay de divertido en encontrarlo sin ningún esfuerzo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610806,
					"content": "Pero yo sí tengo algunas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610807,
					"content": "Envié a alguien al mercado negro para recopilar información... Y, al parecer, encontró a una persona que sabía algo sobre las ruinas de Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610808,
					"content": "¿De verdad? ¿Y dónde está esa persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610809,
					"content": "Calma, calma. Según las reglas del mercado negro, enviarán a alguien para verse con nosotros y así evitar que se fugue información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610810,
					"content": "Nos encontraremos con el informante en el Bosque Susurrante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610811,
					"content": "Entonces, ¿qué estamos esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610812,
					"content": "Es mejor que no lo haga Kaeya en persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "Correcto. Me leíste la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610814,
					"content": "Soy un caballero, así que no debería tener ningún trato con el mercado negro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610816,
					"content": "Tienen mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610817,
					"content": "#Claro está, serán recompensad{F#as}{M#os} por las molestias... De parte de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610818,
					"content": "Jeje, ¡no hay problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610815,
					"content": "Regresaremos con la información.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
			]
		},
