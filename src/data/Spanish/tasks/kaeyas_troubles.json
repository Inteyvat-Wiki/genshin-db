			"dialogs": [
				{
					"id": 4610612,
					"content": "Me gustaría saber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610602
					]
				},
				{
					"id": 4610602,
					"content": "¡Oye! ¿Tienes alguna información sobre las ruinas de Arcadia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610603,
					"content": "¿Arcadia? No creo haber oído nada sobre tal lugar. Lo siento, todavía soy nuevo aquí, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610604,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610605,
					"content": "Pero puedes intentar publicar un encargo y ver si algún veterano sabe algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610606,
					"content": "¡No, no, no! De ninguna manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610607,
					"content": "¡No podemos permitir que nos roben el tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610608,
					"content": "(Ya metió la pata...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610609
					]
				},
				{
					"id": 4610609,
					"content": "¿En serio? ¿Un tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610610
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610610,
					"content": "Bueno, entonces estaré pendiente de tu tesoro. Digo... de las ruinas de Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610611
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610611,
					"content": "Bien. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
