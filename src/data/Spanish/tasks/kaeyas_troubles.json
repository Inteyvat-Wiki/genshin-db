			"dialogs": [
				{
					"id": 4610513,
					"content": "No. Estamos aquí por...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610502
					]
				},
				{
					"id": 4610502,
					"content": "No. Solo queremos saber si has estado en las ruinas de Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610503,
					"content": "¿Ruinas de Arcadia? Qué raro, no pensé que existiría un lugar en el que nunca he estado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610504,
					"content": "¿Eh? ¿Ni siquiera el Gran Stanley lo sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610505,
					"content": "¡Da igual eso de Arcadia! Te contaré lo que me sucedió en el Mare Jivari y en el Reino del Géiser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610506,
					"content": "No tenemos tiempo para tus historias. Concéntrate, por favor. Necesitamos pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610507,
					"content": "El Mare Jivari... Era un lugar de muerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610508,
					"content": "Ya empezó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610509,
					"content": "Cuando encontremos el <color=#00E1FFFF>tesoro</color>, ¡los “Cuentos de los tesoros de Arcadia” serán mejores que tus aburridas historias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610510,
					"content": "(Ya metió la pata...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
					"id": 4610511,
					"content": "¿Tesoro? ¿Y también un cuento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610512
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610512,
					"content": "¡Hum! Es una pérdida de tiempo hablar con él. Vámonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
