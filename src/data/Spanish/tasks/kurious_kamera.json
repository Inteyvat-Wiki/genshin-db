			"dialogs": [
				{
					"id": 414010101,
					"content": "Qué extraño... ¿Qué le pasa a este Daguerrotipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010102,
					"content": "¿Qué le pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "Parece que algo se rompió, porque no funciona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010104,
					"content": "Hice un pedido de Daguerrotipos en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010105,
					"content": "El vendedor dijo que este lote tenía la tecnología más novedosa de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010106,
					"content": "Incluso dijo que podía imprimir imágenes con colores especiales y con efectos únicos, así que compré uno para probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010107,
					"content": "Al final, no sé si es porque estoy haciendo algo mal, o porque el Daguerrotipo tiene algún problema, pero no imprime las imágenes como debería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010108,
					"content": "¿Tal vez es porque estoy haciendo algo mal?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010109,
					"content": "Por cierto, ¿sabes algo de Daguerrotipos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010110,
					"content": "Sé un par de cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "Excelente, ¿podrías echarme una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010114,
					"content": "#Por lo que veo, eres {F#una viajera}{M#un viajero}, ¿cierto? Seguramente has estado por todas partes y sabes muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010115,
					"content": "Lo que quiero pedirte es que lleves este Daguerrotipo contigo y tomes imágenes de cosas coloridas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010116,
					"content": "Cuando hayas tomado las imágenes, imprímelas y dámelas. Quiero saber si el Daguerrotipo tiene algún problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010117,
					"content": "Si ese es el caso, le pondré una reclamación al vendedor. Con esas imágenes como prueba, no podrá negarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010118,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Gracias, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010120,
					"content": "¿A qué te refieres con “cosas coloridas”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Oh, ya sabes... Me refiero a cosas muy nítidas, como el rojo del chile de Jueyun, o el azul de las flores heladas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010122,
					"content": "Cuando hayas tomado las imágenes, tráeme las impresiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010112,
					"content": "No he tocado uno en mi vida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Oh, no hay problema. Es muy fácil de usar... ¿Puedo pedirte ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				}
			]
		}
	]
}