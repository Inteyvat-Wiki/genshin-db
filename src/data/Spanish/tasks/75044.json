				"points": []
			},
			"dialogs": [
				{
					"id": 750444701,
					"content": "(Aquí hay algo escrito con una letra infantil y un poco fea:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Notas infantiles"
				},
				{
					"id": 750444702,
					"content": "Te presento el juego “Un, dos, tres, saurio, alcánzame”. Las reglas son las siguientes:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Notas infantiles"
				},
				{
					"id": 750444703,
					"content": "1. Cuando el manitú Dong-Dong no esté haciendo “dong-dong”, súbete a la estatua del saurio para que esta avance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Notas infantiles"
				},
				{
					"id": 750444704,
					"content": "2. Cuando la cuenta regresiva del manitú Dong-Dong haga “¡dong!”, bájate de la estatua del saurio para no perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Notas infantiles"
				},
				{
					"id": 750444705,
					"content": "3. ¡El primero en llegar al manitú Dong-Dong gana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Notas infantiles"
				},
				{
					"id": 750444706,
					"content": "¡Ni se te ocurra decir que este juego es como el de contar hasta tres y comprobar que nadie se esté moviendo! Las reglas de este juego son muy importantes. Si no las respetas, ¡no ganarás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notas infantiles"
				}
			]
		}
	]
