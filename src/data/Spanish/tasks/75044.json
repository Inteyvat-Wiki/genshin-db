				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(La biografía del inspector retirado Frank Drebin, antiguo trabajador de la policía especial de la Gendarmería Fantasmal de Fontaine. Efectivamente, el inspector es un robusto gato blanco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "«Detective Zarpablanca»"
				},
				{
					"id": 750443702,
					"content": "(Hay una gran huella de gato en la cubierta de este libro, tal vez un recuerdo especial que el inspector dejó para sus subordinados.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "«Detective Zarpablanca»"
				},
				{
					"id": 750443703,
					"content": "¡Qué tontería! ¡Bien podría haber escrito un libro dedicado a Paimon y haberlo llamado «Detective Peloblanco»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
