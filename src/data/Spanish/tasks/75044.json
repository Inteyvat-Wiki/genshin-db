			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "“Que la gloria siempre esté... el pacificador... el misericordioso... Och-Kan...”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "“A causa de la negligencia de los artesanos Mahutzintl, Tlanalco y... responsables de la construcción de las bombas de agua... hay un retraso en... Por piedad... no se les impondrá un castigo... sus provisiones se suspenderán durante tres semanas...”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
