						750444402
					],
					"speakerTitle": "Manitú"
				},
				{
					"id": 750444402,
					"content": "Ahora que Paimon se fija, es un poco extraño que el único recipiente vacío sea el jarrón que hay delante de este manitú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "¿Será que es el único de su grupo que no encontró lo que buscaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Pobrecito... {NICKNAME}, deberíamos ayudarle a buscar algo que meter en el jarrón, pero ¿qué podría ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444405,
					"content": "Meter algo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
