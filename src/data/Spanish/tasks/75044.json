				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "“Tras el muro de piedra del norte hay un caminito que conduce hasta la parte superior de la cascada. Podría servir como <color=#00E1FFFF>cámara del tesoro</color>”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "“Hice unas marcas para no olvidar cómo llegar...”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "“Las heridas de Sayani han vuelto a empeorar y el ambiente es demasiado húmedo... Intenté convencerla para que descansara, pero se negó a hacerlo con una sonrisa en la cara... Dice que, si descansa, ralentizará el avance del grupo y no conseguiremos las provisiones extra...”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "“Por la noche, cuando nadie se dé cuenta, le llevaré una antorcha para cauterizar sus heridas, o de lo contrario sus extremidades también se gangrenarán...”.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
