			"dialogs": [
				{
					"id": 750443601,
					"content": "(Una novela romántica escrita por Dorothy Leeckson. En su portada descolorida hay una mujer tumbada en una cama que está rodeada de flores.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "«Flor de lavanda»"
				},
				{
					"id": 750443602,
					"content": "#(Tras leer por encima el libro, te sientes reconfortad{F#a}{M#o} y satisfech{F#a}{M#o}, pero no aprendiste nada útil.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "«Flor de lavanda»"
				},
				{
					"id": 750443603,
					"content": "Entonces... ¿es el jardinero de su casa o el cuñado del primo de su mejor amigo? Uff, ¡qué dolor de cabeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
