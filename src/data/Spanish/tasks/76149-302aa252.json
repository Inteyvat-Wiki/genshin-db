			},
			"dialogs": [
				{
					"id": 761490101,
					"content": "¿Quién es? ¡¿Quién anda ahí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#Soy {NICKNAME}, y pertenezco a esta era.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Aunque no sé nada de tu tiempo, me llamo Alara. Fui una vez un Asceta de la Era del Silencio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Ya no recuerdo cuánto tiempo ha pasado desde que llegué aquí. Incluso en un lugar como este, mi silenciosa cultivación ha sido interrumpida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Así que es verdad... cultivar una mente sin pensamientos ni deseos lleva a reencarnarse en el Cielo Maligno de la Apatía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "No ha sido nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "No hace falta que me des las gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "¡Ah, gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Bueno, salvarte ha sido cosa de casualidad. Dicho eso, estamos intentando encontrar una manera de salir de aquí que no sea la meditación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "¿No dominan el arte de la meditación? ¿O acaso no se enseña en su era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "La primera vez tardé cientos de años en poder dejar este lugar. Renuncié a mi búsqueda de la verdad... y a mi anhelo de volver a ver a mis seres queridos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Esta vez, no estoy dispuesto a renunciar a eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Pueden contar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761490115,
					"content": "Diestrín ha recogido otro fragmento del pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "¿Del pesar? Oh, te refieres a la técnica de meditación Maranasati. La conozco, así como su utilidad para cultivar el estado mental al enfrentarse a la muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Ahora que hemos encontrado a Lind, busquemos la forma de salir de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "¿Seguro que podemos salir de aquí por nuestra cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta y Nihilita pueden moverse libremente por este lugar, y suelen traer a otras personas consigo. Así que Diestrín también debería ser capaz de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761490121,
					"content": "Ya han recogido tres fragmentos del pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Aunque debería decir que solo es un nombre temporal, ya que no sé para qué los usará Diestrín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "¿Ahora qué, Diestrín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761490125,
					"content": "Sigamos sus indicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
