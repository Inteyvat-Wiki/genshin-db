			"dialogs": [
				{
					"id": 750701401,
					"content": "¡Arg! ¡Tenemos que repetirlo! Eh... Si no les importa, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750701402,
					"content": "*Suspira*... Ya que estamos aquí, no nos queda otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Sigamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Genial, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750701405,
					"content": "Necesito un descanso, por favor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Eso. Saltar desde un acantilado es un trabajo cansado, ¡deja que nos tomemos un respiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "#Mis disculpas, qué falta de consideración por mi parte. Empezamos cuando estén preparad{F#as}{M#os}. Estaré esperando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				}
			]
		},
