			"dialogs": [
				{
					"id": 750701601,
					"content": "*Suspira*... Como ves, el resultado... no es ideal. De hecho, parece un reflejo de mí como persona... ¡alguien que no logra nada en la vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750701602,
					"content": "Ay... ¡Mi familia siempre me decía que arbolitos como yo solemos proyectar sombras gigantes! ¡Ahora sé que todo era mentira! ¡Todo! ¡Solo querían humillarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701603
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750701603,
					"content": "*Snif*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701604
					],
					"speakerTitle": "Magnífico"
				},
				{
