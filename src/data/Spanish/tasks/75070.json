			"dialogs": [
				{
					"id": 750700901,
					"content": "Jaja, ¡es perfecta! ¡Toma, esta copia es para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750700902,
					"content": "¡Guau! ¡Paimon está maravillada con el resultado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Tomen, aquí está la recompensa, esta es la segunda vez... miento, la tercera vez que recibo su ayuda, ¡ya empiezo a dudar de si podría llegar hasta el final de mi viaje de daguerrotipia sin ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750700904,
					"content": "Mi siguiente destino es aquí... Ya lo marqué en su mapa. Pueden venir a verme cuando quieran, siempre estaré esperando una nueva cooperación con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750700905,
					"content": "¡Ah! Ya es casi la hora, ¡tengo que irme! ¡Les deseo mucha suerte en todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750700906,
					"content": "Magnífico recoge su equipaje y se sube felizmente al globo aerostático.\\nMientras el globo se aleja poco a poco, las carcajadas del pequeño Magnífico dejan un prolongado eco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
