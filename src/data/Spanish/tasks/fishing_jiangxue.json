			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "¿Cuándo morderán el anzuelo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Estoy pescando. Esta vez es un pez grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040104,
					"content": "Tengo un amigo al que le gusta cocinar. Si logro pescar algo grande, seguramente se alegrará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040105,
					"content": "Solo que hay monstruos alrededor que ahuyentan a los peces con su escándalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040106,
					"content": "Puedo percibir que tienes un gran poder elemental. ¿Podrías ayudarme a acabar con los monstruos para que pueda pescar en paz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040107,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040112,
					"content": "¿Cómo sabes cuándo se acercan los monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040113,
					"content": "No hace falta saberlo, solo alza la mirada y los verás. Mira, detrás de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040114,
					"content": "¿Detrás...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040109,
					"content": "Cómo sabes que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "Alguna vez tuve una Visión. Nunca sentí la necesidad de usarla, pero aún puedo percibir los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040111,
					"content": "Con los poderes elementales de tu lado, serán pan comido para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "L-lo venciste... Paimon ni siquiera vio tus movimientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "¿Quién diablos eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Un simple pescador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Qué extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Exacto, soy una persona extraña, pero en este mundo hay muchas personas como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Por ejemplo, en la posada hay un cocinero que era hábil con la espada. Ahora le gusta cocinar. Tiene un aspecto rudo, pero es de buen corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "O por ejemplo, la dueña de la posada dice ser de Mondstadt, pero nadie de allá la conoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Y luego estás tú, que puedes usar poderes elementales sin tener una Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Hay gente que es “extraña”, pero no “temible”, así que no tienes de qué preocuparte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Toma esto como obsequio. Yo me quedaré un rato más pescando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}