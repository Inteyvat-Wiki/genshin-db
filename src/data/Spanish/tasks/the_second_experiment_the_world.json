			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Ya volví. ¿Vieron algo interesante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "Para mí, nada tiene ni pies ni cabeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "No te preocupes, todos son objetos para fines alquímicos, no suelen verse todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Bueno, sigamos con la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Puede haber diferencias significativas entre diferentes mundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Miren Teyvat, por ejemplo. Aquí, aquellos con Visiones pueden manipular los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Pero pueden existir mundos en los que solo una persona, o incluso todo el mundo puede manipularlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Entonces, {NICKNAME}, además de los elementos, ¿posees alguna habilidad única? ¿De las que no existen en este mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Creo que responder a esta pregunta requiere la misma metodología que la última vez. En otras palabras, es hora del próximo experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "¿Luchar contra Slimes de nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "¡No, no! Esta vez no requerirá de tanto esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "Mira este pilar de aquí. Usa tu fuerza de voluntad para intentar romperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "Lo siento, no creo que pueda hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "¿Eso es tu mejor esfuerzo? Humm... Bueno, supongo que no hay remedio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "¿Por qué te sientes decepcionado? Eso es imposible de hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "¡Ah! ¿Alguna vez has intentado usar tu poder elemental con comida? No me refiero a cocinar como tal, sino a canalizar tu poder en los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Tengo curiosidad por ver cómo responden el sabor y la textura. Incluso podría hacer que... se multiplicase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Los alquimistas son muy imaginativos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Jaja, supongo que a la gente le sorprende que sienta curiosidad por cosas intrascendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "En fin, ¿por qué no nos preparas un pescado salteado con mantequilla? Acabo de terminar de preparar la receta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "¿Cocina? ¡Esperaba más experimentos de científico loco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Esta receta no solo es un alimento básico para mí, ¡también se puede experimentar con ella y es muy nutritiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "¡Hum, Paimon está segura de que tienes hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Pero suena delicioso... Está bien, ¡Paimon lo aprueba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "¿Ahora sí te parece bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Ajá, ¡los mejores amigos siempre piensan igual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Entonces, te lo dejo a ti. Espero los resultados con ansias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "Si sobra un poco, Timaeus puede terminárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Eh... Paimon no cree que eso vaya a ser un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Guardaré un poco para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "¿Es por eso o solo porque tienes hambre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Paimon, inténtalo tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "¡¿Crees que Paimon puede hacer algo así?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "¿Eso es tu mejor esfuerzo? Humm... Bueno, supongo que no hay remedio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Ya he bebido suficientes pociones, gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "Todo estaba un poco desordenado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Humm, estoy de acuerdo. Me encantaría tener un poco de tiempo para ordenarlos. Sin embargo, los experimentos son lo primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Vaya, ¿lograste encontrarlos? Increíble, mil gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Entonces, esa “Visión Elemental”... fue lo que te permitió encontrar estos objetos y encontrarme a mí en la montaña, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "¡Sí! Supongo que cuenta como un superpoder, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Desafortunadamente, tener Visión Elemental es poco común, pero no es algo inaudito en Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Solo un poder de otro mundo nunca antes visto ayudaría a mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Es decir, que... fallamos de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "No se desanimen, estaba totalmente dentro de mis expectativas. Además, conseguí mis objetos de vuelta. A esto le llamo un experimento valioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Pero es admirable que dedujeras que los objetos tendrían rastros elementales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "De acuerdo. Hasta ahora, nuestra investigación se ha centrado en ti como alguien de otro mundo. Ahora comenzaremos a investigar tu identidad como uno de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Estoy contigo hasta el final.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "En esencia, las diferencias entre los humanos se reflejan en nuestras capacidades intelectuales y físicas. Empecemos por estas últimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "¿Puedes ver desde aquí lo que está haciendo Sacarosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "Y si saltaras desde aquí y aterrizaras en ese acantilado de ahí, ¿podrías verla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "Y si hicieras trizas la montaña de enfrente de un solo golpe, ¿podrías verla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Humm, entonces no debería entusiasmarme demasiado. En fin, tendremos una comprensión más profunda con un experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Conozco el lugar perfecto para una prueba física. Por favor, síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "Parece que todavía estamos en la prueba de los superpoderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Ya no puedo escabullirme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
