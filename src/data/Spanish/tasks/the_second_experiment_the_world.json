			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Humm... Un resultado promedio para un buen plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "En cuanto a la hipótesis de la multiplicación, no es la que esperaba. Parece que la comida presenta los mismos problemas en tu mundo que en el nuestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "A menos que... ¿Acaso las leyes naturales de este mundo limitan tus habilidades únicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Simplemente no sabemos cómo canalizar el poder elemental en la comida. No es tan fácil como agregar hierbas y especias, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "No se preocupen, al menos le daremos un buen uso a la comida, no hay por qué desanimarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Y aquí está tu ración, ¡disfrútala! Puedo empacarla para llevar si quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "¡Guau, gracias! Qué bueno que lo recordaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Eres la nueva persona favorita de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "#Puedo ver que son buen{F#as}{M#os} amig{F#as}{M#os}, Paimon estuvo velando por tu seguridad durante todo el experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Aunque no podría hacer mucho si las cosas salieran mal, pero esa es otra cuestión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "¡Oye! ¡Justo cuando estabas siendo amable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Pero tus recetas son deliciosas, así que lo dejaré pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "#Y tienes razón, somos buen{F#as}{M#os} amig{F#as}{M#os}. También tienes buenos amigos, ¿cierto? ¿Buenos estudiantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "Oh... sí. Supongo que yo también soy afortunado. En fin, pasemos al siguiente experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Hay todo tipo de elementos alquímicos por aquí. Conservarlos en un lugar adecuado es todo un desafío. Hace tiempo tuve la desgracia de poner algunos en el lugar equivocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Conseguí recuperar la mayoría, pero hay dos frascos que no puedo encontrar: el de extracto de cristalóptero Anemo y el de polvo de Hipóstasis Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon apenas terminó de comer, ¿y ya quieres que vayamos a recolectar de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "No se preocupen si no los encuentran. Estaba pensando en reemplazarlos por otros, pero encontrarlos me ahorraría las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Si tuviera, digamos, un “superpoder”, como visión nocturna o detección de vibraciones, los objetos perdidos serían cosa del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Quizás se me cayeron en alguno de los lugares que estuviste mirando antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Entonces... Supongo que será mejor que le echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Debe haber rastros elementales en los objetos perdidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "¡Oh, cierto! ¡Puedes usar tu Visión Elemental!",
