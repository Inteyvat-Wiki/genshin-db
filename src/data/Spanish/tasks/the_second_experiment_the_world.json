					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "No se preocupen si no los encuentran. Estaba pensando en reemplazarlos por otros, pero encontrarlos me ahorraría las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Si tuviera, digamos, un “superpoder”, como visión nocturna o detección de vibraciones, los objetos perdidos serían cosa del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Quizás se me cayeron en alguno de los lugares que estuviste mirando antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Entonces... Supongo que será mejor que le echemos un vistazo.",
