	"talks": [
		{
			"id": 7224501,
			"completionStepIds": [
				7224501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
