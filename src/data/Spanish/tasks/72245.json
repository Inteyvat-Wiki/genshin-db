			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orupeusu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#*Suspira*, conque eres {F#una viajera}{M#un viajero} de tierras recónditas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "¿Cuál es tu propósito? Me dolió verte caminar hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "¿Que te duele? ¿Por qué te iba a doler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Para un cantante como yo, cualquier cosa en este mundo es motivo de lamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Donde hay encuentros hay despedidas, y aquellos que nacen regresarán a las profundidades de la tierra algún día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "#Los encuentros se hacen demasiado efímeros como para aliviar el dolor de las largas separaciones... Y en cuanto a ti, viajer{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Solo aquellos que realmente persiguen algo son capaces de embarcarse en un viaje fuera de su mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Los nativos, que han vivido aquí por mucho tiempo, pueden verlo como algo romántico, pero para los viajeros, su travesía puede suponer un dolor inexplicable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Si hubieras venido antes, habría cantado algo para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Pero hace tiempo prometí a alguien que, si no escuchaba su voz, yo tampoco volvería a cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "Tan solo puedo desearte lo mejor. Aunque parezcas mayor que yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Deseo que todos tus sueños se hagan realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}