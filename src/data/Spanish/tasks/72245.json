			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Surepio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#{F#Viajeras}{M#Viajeros} de tierras recónditas... *Cof*, parecen cansad{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Lleven cuidado. ¿Sabían que muchas enfermedades comienzan a raíz de un cansancio excesivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Deben asegurarse de descansar lo suficiente todos los días, de manera que... *cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "#*Cof, cof, cof*... puedan crecer san{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "¿Sabes? Tú no pareces muy sano que digamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Jajaja, es una enfermedad que arrastro desde hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "#Tienes que mantener un cuerpo sano para cultivar un alma sana, {F#viajera}{M#viajero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*Suspira*, si tuviera más tiempo, seguro que me convertiría en el mejor médico del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "De esa forma, incluso con un cuerpo como el mío, podría caminar fuera de mi cuarto y jugar a mi antojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
