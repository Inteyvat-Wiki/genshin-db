			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piramumon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "#¡Oh! A juzgar por su apariencia, ¡deben ser {F#forasteras}{M#forasteros}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "¿De qué lares proceden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "De Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "¿Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Le describes a Piramumon los paisajes de Mondstadt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Nunca escuché hablar sobre una ciudad con ese nombre. Y pensar que existe un lugar así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Jajaja, ¡es como yo decía, entonces! ¡No era posible que el mundo se limitara al tamaño del reino de Byakuya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Si el reino de Byakuya constituyera el mundo entero, sería el mundo más solitario de la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Los textos antiguos relatan los tiempos anteriores a la fundación de nuestro reino. Fue entonces cuando comencé a creer que había otras tierras además de la nuestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Pero en realidad tenía miedo, ¿saben? Temía que realmente no existieran más regiones allá afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "#{F#Viajera}{M#Viajero}, no puedes imaginar la tranquilidad que me transmite tu llegada. Jaja, resulta que hay más lugares fascinantes en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "La única pena es que tengo que asistir a esa ceremonia llamada “ritual del regreso solar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "#{F#Viajera}{M#Viajero}, ¿qué tal si me cuentas cómo llegaste aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Una vez que termine la ceremonia, buscaré la oportunidad de escaparme del Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "¡Y podremos tomarnos un juguito! ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
		{
			"id": 7224507,
			"completionStepIds": [
				7224507
