			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "#¿Eh? Nunca he visto a nadie vestid{F#a}{M#o} como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "¿Se cayeron de... de alguna parte más allá del cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "¡Bueno! ¡El mundo no se acaba en nuestra gloriosa nación! Entonces, déjenme ver sus mapas para que los examine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Le prestas tu mapa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Guau, fascinante. No solo el relieve es preciso, incluso incluye los caminos de las montañas y los ríos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Bueno, entonces... ¿Cómo de grande es esa nación que llaman “Teyvat”? ¿Cuál es su tamaño en comparación con el reino de Byakuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat es un continente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "Y Enkanomiya... Es decir, el reino de Byakuya, es esta parte pequeña del sur del mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "¡Eso es una sandez! ¡Nuestras tierras son vastas e inmensas! ¿Cómo pueden ocupar un espacio tan insignificante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Este mapa puede parecer dibujado con precisión, pero lo cierto es que es un completo fraude. ¡Llévenselo de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "Y pensar que por un momento sentí admiración por esa charlatanería barata... ¡Qué deshonra para mis ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Bueno, tú mismo, ¡mira este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224503,
