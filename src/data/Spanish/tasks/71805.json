			"dialogs": [
				{
					"id": 718050501,
					"content": "#¿Necesitas algo, jovencit{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Tío Tian"
				},
				{
					"id": 718050502,
					"content": "Este es el libro que le pediste a Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Ah, sí, recuerdo que pedí «Versos de Equilibrium» a la Casa de Libros Wanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Tío Tian"
				},
				{
					"id": 718050504,
					"content": "Así es, este es el libro que quería. ¡Por fin llegó! Pensé que, como últimamente tenía tantos clientes, Jifang se había olvidado de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Tío Tian"
				},
				{
					"id": 718050505,
					"content": "Qué bien que haya llegado. Y está perfectamente encuadernado. ¡Jifang cuida de todos los detalles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Tío Tian"
				},
				{
					"id": 718050506,
					"content": "#Gracias por traerlo hasta aquí, jovencit{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tío Tian"
				}
			]
		},
