			"dialogs": [
				{
					"id": 718050401,
					"content": "#¿Necesitas algo, jovencit{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Burgués De'an"
				},
				{
					"id": 718050402,
					"content": "Este es el libro que le pediste a Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Oh, ¿el cuarto volumen de «Rex Incognito»? Lo pedí hace mucho tiempo, ¿cómo es que tardó tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Burgués De'an"
				},
				{
					"id": 718050404,
					"content": "A ver... ¿Eh? ¿Es la primera edición? Por eso le llevó tanto tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Burgués De'an"
				},
				{
					"id": 718050405,
					"content": "Pensé que, como últimamente tenía tantos clientes, Jifang se había olvidado de mi libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Burgués De'an"
				},
				{
					"id": 718050406,
					"content": "#Gracias por traerlo hasta aquí, jovencit{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Burgués De'an"
				}
			]
		},
