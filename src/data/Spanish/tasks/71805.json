				},
				{
					"id": 718050702,
					"content": "Ambos son clientes nuestros desde hace mucho tiempo. Suelo preparar personalmente sus libros con antelación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050703,
					"content": "Pero de repente empezaron a llegar tantos clientes que me agobié, y aún no he preparado los libros que pidieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050704,
					"content": "Seguro que están muy impacientes...",
