			"dialogs": [
				{
					"id": 200650201,
					"content": "¿Cómo lo llevas? ¿Has tenido un momento de iluminación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650202,
					"content": "Todavía sigo pensando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650203
					]
				},
				{
					"id": 200650203,
					"content": "Oh... He conocido a algunos otros aventureros antes. Eran iguales a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650204,
					"content": "Luchan contra monstruos como un profesional, pero están irremediablemente perdidos cuando se trata de romper algunos palos de madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650205,
					"content": "Y refuerzan la madera como si fuera para un refugio contra tormentas o algo así, sobrestimando su propia fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650206,
					"content": "Si están tan desesperados por un desafío, ¿por qué no se van al campo y se pelean con el monstruo más grande que puedan encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
