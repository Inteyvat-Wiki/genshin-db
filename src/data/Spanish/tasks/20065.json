			"dialogs": [
				{
					"id": 200650101,
					"content": "Ay, ¡qué dolor de cabeza! ¿Qué se supone que debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "¡Estoy entrenando para las pruebas de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "*Suspira*, pero no soy tan poderosa como Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "Creo que es mejor para mí centrarme en la técnica en lugar de la fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Por ejemplo, estaba pensando en cómo romper todos estos maniquíes de madera de un solo golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "Estos maniquíes son firmes, pero no puedes tomártelo a la ligera. Mi pobre padre... ¿de dónde los habrá sacado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006502,
			"completionStepIds": [],
