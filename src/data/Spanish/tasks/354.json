				"points": []
			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "#Que el dios Anemo les proteja, foraster{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540402,
					"content": "Soy Amber, Caballera Exploradora de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540403,
					"content": "No parecen ser de Mondstadt. ¡Identifíquense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540404,
					"content": "No buscamos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540405,
					"content": "Eso es justo lo que diría alguien sospechoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540406,
					"content": "#Saludos. Me llamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "No suena a un nombre de por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540408,
					"content": "¿Qué le ocurre a tu mascota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540409,
					"content": "Es mi amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "#Llevamos viajando junt{F#as}{M#os} tan solo dos meses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540411,
					"content": "#¡Pero ya somos mejores amig{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540414,
					"content": "#En pocas palabras, son viajer{F#as}{M#os}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540415,
					"content": "Últimamente hay un dragón merodeando cerca de Mondstadt. Será mejor que entren a la ciudad lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540416,
					"content": "#No está lejos de aquí. L{F#as}{M#os} escoltaré hasta allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540417,
					"content": "¿Eh? ¿No tienes otros asuntos que hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540418,
					"content": "#Por supuesto, pero no se preocupen. Puedo cumplir con mis tareas y protegerl{F#as}{M#os} a la vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540419,
					"content": "Además, no sé si puedo confiar en ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540420,
					"content": "¿Por qué tan desconfiada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "Oh... lo siento. No son palabras dignas de una caballera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540423,
					"content": "#Les pido disculpas, foraster{F#as}{M#os}... y honorables viajer{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540424,
					"content": "¡Eso sonó muy falso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540425,
					"content": "¿Tienes algo en contra de las normas de vocabulario del «Manual de los Caballeros» de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540421,
					"content": "#Esa no es forma de hablarle a tus invitad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "Es mi comida de emergencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "¡Oye! ¡Eso es aún peor que ser tu mascota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}