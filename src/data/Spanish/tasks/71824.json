			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Tengo que apresurarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240102,
					"content": "¿Va bien el negocio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "No es eso... Estamos en pleno festival, y algunos empleados de la posada regresaron a sus hogares, así que me toca hacer todo el trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240104,
					"content": "Afortunadamente, no hay muchos clientes, así que puedo hacerme cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240105,
					"content": "*Ejem*, tengo que darte las gracias por ayudarme la última vez. Si no fuera por ti, no podría haber vuelto al trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Entonces, ¿has visto últimamente a..?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "¡N-no! ¡Por supuesto que no! Créeme, si apareciera de nuevo, me moriría del susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240109,
					"content": "Si tanto quieres saber sobre... ella, ve a preguntarle a la jefa. D-de verdad, yo no sé nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718240107,
					"content": "Entonces, ¿últimamente ella ha...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
