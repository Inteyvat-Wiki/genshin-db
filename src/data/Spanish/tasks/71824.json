					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240302,
					"content": "Sí, por así decirlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Bueno, espero que así se ponga más contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Me pregunto qué deseo pedirá...",
