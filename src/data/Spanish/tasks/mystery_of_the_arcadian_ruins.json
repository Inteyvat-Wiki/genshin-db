				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "¿Por qué me pasan estas cosas? No debería haber ayudado a <color=#00E1FFFF>ese hombre</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620302,
					"content": "¿A quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "¡Muchas gracias por salvarme! Eres mucho más confiable que esos tipos de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620304,
					"content": "#No es nada. {NICKNAME} es {F#una viajera}{M#un viajero}, tiene que lidiar con cosas similares todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "#¿Viajer{F#a}{M#o}? He oído historias acerca de ti. No pensé que me rescataría <color=#00E1FFFF>la persona que vine a ver</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620306,
					"content": "Oh, entonces tú eres la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "¡Jaja! Al principio no sabía cómo recompensarles. Pero ahora creo que les daré la información gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620308,
					"content": "Las personas en nuestro círculo sabemos lo importante que es la red de contactos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620309,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Claro. Me salvaron la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620312,
					"content": "¡Qué suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Pero... eso beneficia a Kaeya, ¿no? Se supone que debía pagar por la información...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Escuchen bien, entonces. Lo que oí sobre las ruinas de Arcadia es lo siguiente:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620315,
					"content": "“Tres gigantes de seis brazos viven en la ciudad del lago. Dos custodian la estatua, uno custodia el tesoro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620316,
					"content": "De acuerdo... Espera, ¿de qué hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "También hay un mapa que venía con la nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620317,
					"content": "¿Y el tesoro está en... la X?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Parece que la pista es más como un acertijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Para ti es pan comido, ¿verdad, {NICKNAME}? ¡Entonces, Paimon te lo deja a ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "¡Claro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Bueno, si no puedes resolverlo, podemos preguntarle a Kaeya. Parece que sabe de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Te dejaré la información para que puedas revisarla en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620327,
					"content": "Gracias, Vile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "“Tres gigantes de seis brazos viven en la ciudad del lago. Dos custodian la estatua, uno custodia el tesoro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "#¿Qué significará? Si no quieres molestar a Kaeya, ¡mejor descúbrelo por ti mism{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "Claro... Espero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Gracias, amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
