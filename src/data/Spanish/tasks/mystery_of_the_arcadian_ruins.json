			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "¡Déjame ver qué dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "“Ella no lo ama en absoluto. La pasión que brota en las aguas claras es solo una fachada. Cuando está fría y sola, su verdadero sentir se desborda”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Hay otro mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "¿Más acertijos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Qué dolor de cabeza. El cerebro de Paimon no da para más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Tampoco es que lo hayas usado mucho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "#¡Muy gracios{F#a}{M#o}! Podrías pedirle ayuda a Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
