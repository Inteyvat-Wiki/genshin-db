			"dialogs": [
				{
					"id": 200720101,
					"content": "¿Qué hay de las flores que había en Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "Solo pude recuperar una caja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "¿No pudiste recuperar todas las flores? Oh, bueno... Teniendo en cuenta cómo es esa montaña, debe ser difícil recolectar materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Pero con este puñado no es suficiente para compararlos, solo me queda esperar a otra oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Hiciste un buen trabajo, así que preparé una recompensa para ti. Quizás vuelva a molestarte en otra ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007202,
			"completionStepIds": [
				2007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
