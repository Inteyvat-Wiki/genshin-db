				"points": []
			},
			"dialogs": [
				{
					"id": 200720401,
					"content": "Por aquí, por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720402,
					"content": "¿Recuerdas que la última vez te pedí que dejaras unas flores en Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720403,
					"content": "Ya pasó un día, quisiera ver los efectos de la refrigeración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720404,
					"content": "¿Podrías ir a la montaña y traerme de vuelta esas flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720405,
						200720407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720405,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720406
					]
				},
				{
					"id": 200720406,
					"content": "Confío en ti, estaré aquí esperando. ¡Por favor, apresúrate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720407,
					"content": "¿Dónde las dejé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720408
					]
				},
				{
					"id": 200720408,
					"content": "¿Lo olvidaste? Están <color=#00E1FFFF>cerca de la Estatua de Los Siete</color>, en <color=#00E1FFFF>un lugar con agua en la montaña</color> y <color=#00E1FFFF>cerca de una cueva</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720409,
					"content": "Marcaré los lugares de nuevo en tu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
	]
