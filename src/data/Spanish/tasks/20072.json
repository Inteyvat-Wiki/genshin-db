			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720201,
					"content": "¿Cómo están las flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720202,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "¿Oh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720204,
					"content": "Me descuidé y las cajas y flores se estropearon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "¡¿Se... estropearon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720206,
					"content": "Ay, escogí esas flores con mucho cuidado. No es tan fácil encontrar flores tan buenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720207,
					"content": "#¿Espinadragón es tan peligrosa como para derrotar a {F#una viajera}{M#un viajero} como tú? Todas mis flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720208,
					"content": "En fin, agradezco que te dieras la vuelta. Esto es para ti, tómalo. Tengo que ir a cuidar las flores de la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720209,
					"content": "*Suspira*, ¿y si mejor uso el método de preservación de Sara?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007203,
