			"dialogs": [
				{
					"id": 200720301,
					"content": "¿Qué hay de las flores que había en Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720302,
					"content": "Aquí las tengo todas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720303
					]
				},
				{
					"id": 200720303,
					"content": "¿Las trajiste? ¡Qué bien! Déjame ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720304,
					"content": "Jeje, nada mal. Humm... Parece que este método de verdad funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720305,
					"content": "Pero Espinadragón queda muy lejos de Mondstadt, y no puedo acudir a ti cada vez que te necesite, así que debo pensar en un método más conveniente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720306,
					"content": "En fin, gracias por ayudarme. Este obsequio es para ti, tómalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
