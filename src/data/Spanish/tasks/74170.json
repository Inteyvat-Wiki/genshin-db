			"dialogs": [
				{
					"id": 741700210,
					"content": "Dejemos el desafío para después. Me gustaría saber qué pasó con Coutrot...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Ni siquiera aprendió la lección cuando lo echaron del Instituto de Ciencias de Fontaine, ese tipo es un estúpido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "#Pero ahora no tiene a nadie que le cubra las espaldas, así que pueden estar tranquil{F#a}{M#o}s, ya no causará más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
