			"dialogs": [
				{
					"id": 741700217,
					"content": "Dejemos el desafío para luego, quiero saber qué es esta máquina de aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "Asombroso, ¿verdad? Parece que hizo varias modificaciones en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Yo creo que este sitio ahora es muy apto para el turismo de ruinas... Aunque quizá yo no sea la persona más indicada para decir eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*Ejem*, todo lo que acabo de contar no es más que mi punto de vista. Bajo ningún concepto representa al Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
