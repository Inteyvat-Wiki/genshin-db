			"dialogs": [
				{
					"id": 741700213,
					"content": "Una pregunta, ¿quién es Kuisel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "No lo sé. No recuerdo que en el Instituto de Ciencias de Fontaine hayan mencionado ese nombre... Quizás a ese tal Kuisel le convenga que nadie sepa de su existencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Como él mismo dijo, Kuisel es simplemente un personaje que le es útil. Cuanto más diferente de la persona que lo encarna, mejor. Así será menos probable que lo reconozcan... supongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*Suspira*, pero si me preguntan a mí, creo que ha cambiado mucho con el paso del tiempo. Me costó mucho reconocerlo la primera vez que lo vi después de tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
