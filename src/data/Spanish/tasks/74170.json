					"nextDialogs": [
						741700209
					]
				},
				{
					"id": 741700209,
					"content": "De acuerdo, me encargaré de medir el tiempo. Y recuerda, tienes que <color=#00E1FFFF>recuperar todas las réplicas de balizas del edificio en el tiempo establecido</color>. Avísame cuando hayas terminado.",
					"roleType": "TALK_ROLE_NPC",
