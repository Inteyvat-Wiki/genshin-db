			"dialogs": [
				{
					"id": 741701801,
					"content": "Ah, ¿crees que no te di tiempo suficiente? Ni siquiera tú has podido conseguirlo en el tiempo establecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701802
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701802,
					"content": "¿Quieres volver a intentarlo? Recuerda, <color=#00E1FFFF>tienes que devolver todas las réplicas de balizas al interior del edificio en el tiempo establecido</color>. Avísame cuando hayas terminado.",
					"roleType": "TALK_ROLE_NPC",
