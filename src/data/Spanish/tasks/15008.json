			"dialogs": [
				{
					"id": 150080101,
					"content": "#¡Aquí, {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Mualani ya está aquí. Eh, y también está ese señor extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "#Buenos días a amb{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "¡Buenos días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "¿Cuándo partimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Jaja, pareces un niño pequeño, siempre ansioso antes de comenzar un viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Lo que quiero es empezar cuanto antes... Como bien sabrás, esto no se trata de un paseo relajado. Espero que todos podamos ser más profesionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "No te preocupes, soy una guía muy profesional. *Ejem, ejem*... Bueno, ¡nuestra expedición a la isla misteriosa ha comenzado oficialmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Antes de nada, ¿ven esta estatua de aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Sí, ¿se trata de alguna pista importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "No es ninguna pista, es un monumento conmemorativo que levantó el primer jefe del Pueblo de los Manantiales tras volver de la isla misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Lo que hay que hacer antes de partir es tocar esta estatua para rezar a los ancestros y que nos entreguen su bendición. Así, nuestro camino hasta la isla misteriosa será mucho más fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "... ¿Hay algún fundamento teórico para tal afirmación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "¿Fundamento teórico? No, pero mi maestro me enseñó que este es el primer paso esencial que debe realizarse antes de emprender el camino a la isla misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "Muy bien, demuestras un comportamiento muy profesional al no criticar algo que se escapa de tu campo de especialización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Está bien, es solo que así no podré incluirlo en la tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "¡Vamos todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Aquí muestro mis respetos a mi ancestro. Esta sucesora suya va a embarcarse en la senda que una vez caminó y será testigo de sus hazañas. Partimos bajo su atenta mirada y regresaremos bajo su protección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "¡De verdad parece que vayamos a emprender una aventura increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Ahora, prepárense. Tenemos que ir a buscar la primera pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
