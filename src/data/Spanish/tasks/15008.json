			},
			"dialogs": [
				{
					"id": 150080401,
					"content": "¡La encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "Eso es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "¡Esta es la clave para adentrarse en la manada de Koholasaurios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "Si el olfato de los Koholasaurios es tan agudo, aunque intentáramos ocultar el sonido de nuestros pasos y evitar su campo de visión, podrían descubrirnos al acercarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "Pero esta planta puede resolver ese mismo problema, ya que su aroma se parece bastante al olor corporal de los Koholasaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "Podemos extraer algo de jugo y untárnoslo por el cuerpo. ¡Así podremos engañar a los hocicos de los Koholasaurios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "¿Tenemos que untárnoslo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "No pasa nada, en realidad se usa para la elaboración de productos cosméticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "Mualani reúne un poco de jugo y cada uno se unta una capa para camuflar su olor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Humm... Es muy resbaladizo, pero es cierto que huele a Koholasaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Perfecto. ¡Vayamos a probarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
