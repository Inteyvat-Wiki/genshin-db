				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "¿Eh? ¿Por qué le parece a Paimon que hay un estanque nuevo de repente? ¿Qué pone en ese letrero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "¿“Peligro, no se acerquen”? ¿Qué quiere decir eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Significa exactamente lo que dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010104,
					"content": "¡Aah! Sandrone... ¡le has dado un buen susto a Paimon! ¿Pusiste tú este letrero aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Sí, con la intención de mantener alejados a los curiosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010106,
					"content": "¿Qué tiene de especial este estanque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Está lleno de pirañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010108,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Jaja, es broma. ¿No me dirás que te lo creíste de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010110,
					"content": "Me enteré de que algunos de los peces del acuario son muy territoriales y pueden ponerse bastante agresivos. Así que los trasladé aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010111,
					"content": "¡No le des a Paimon esos sustos! ¿O sea que este lugar es como una zona de cuarentena especial para los peces agresivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Exacto, el agua de este estanque es mucho más profunda y hay bastante más espacio. Eso ayuda a tranquilizar a los peces más territoriales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010113,
					"content": "También le pedí a Sigewinne en el Fuerte Merópide un cebo especial para ayudar a calmarlos un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010114,
					"content": "Guau... ¡Parece que de verdad te preocupa el bienestar de los peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Bueno, creo que nadie quiere ver el acuario convertido en un baño de sangre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010116,
					"content": "#¡Claro! De todas formas, ¿por qué no nos dejas encargarnos de esto a nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Si insisten... Cuando los peces del estanque se sientan lo suficientemente cómodos como para nadar en la superficie, significará que se están recuperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010118,
					"content": "¿O sea que cuando estén relajados y contentos los podemos volver a poner en el acuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Eso ya lo decidirán ustedes. Yo solo me encargo de sacar a los más revoltosos y ponerlos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010120,
					"content": "¡Entendido! Pero ese cartel da demasiado miedo. ¿No podríamos cambiarlo por algo un poco menos... aterrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Humm... Como quieras. Son sus peces, así que la decisión es suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}