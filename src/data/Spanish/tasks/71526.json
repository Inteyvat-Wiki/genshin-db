				]
			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Uff... ¡Eso ha estado cerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "¡Casi me da algo! ¡Esta pequeña tiene las garras afiladas! Incluso a mí me habría dado guerra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "¿Cómo se te da tan bien esto sin que nadie te haya enseñado? ¿Es que todos en Liyue nacen siendo unos genios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "¿Así que así es como se juega a los escaradiablos? ¡Ahora lo entiendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Bonsái con Patas de Gato"
				},
				{
					"id": 716663105,
					"content": "Si tienen tiempo, ¿querrían jugar un poco más conmigo? ¡Y también me gustaría verlos jugar para aprender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Bonsái con Patas de Gato"
				},
				{
					"id": 716663106,
					"content": "Parece que Changchang tiene un talento innato... ¡Qué miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Oye, toreritto. Si tú tuvieras ese talento, quizá serías capaz de comunicarte con las criaturas acorazadas tan solo con escuchar a Guoba hablar con Tornado Cristalino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Jaja... Jajajaja... ¡Ya me gustaría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
