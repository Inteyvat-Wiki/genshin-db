			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "¡Los escaradiablos son nuestros amigos, igual que lo puede ser un perro o un gato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Bonsái con Patas de Gato"
				},
				{
					"id": 716663002,
					"content": "¿Otro niño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Humm, sí, pero el Gran Maestre Hanakado también es un niño, y uno de los niños de la última vez también era muy bueno. Parece que la edad no es relevante para medir la habilidad en las peleas de escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Aunque Bonsái con Patas de Gato no tiene experiencia en las peleas de escaradiablos, ¡su escaradiablo parece ser muy poderoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716663005,
					"content": "No sé de qué están hablando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Bonsái con Patas de Gato"
				},
				{
					"id": 716663006,
					"content": "Mi escaradiablo es un regalo que me trajo mi padre. Se lo dio un amigo que conoció durante uno de sus viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Bonsái con Patas de Gato"
				},
				{
					"id": 716663007,
					"content": "¡Jojo! ¡Suena a que tu padre es un tipo con caché!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Bueno, de este duelo te encargas tú, Onicalavanda Perforacielos. No quiero que me tachen de abusón o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "¡Hum! Lo haces parecer como si Paimon fuera la luchadora más débil o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Aunque puede que Paimon sea la opción más segura. Ustedes dos son tan competitivos cuando pelean que no saben controlarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "¡No estés nerviosa, pequeña! Solo es un juego, ¡así que vamos a pasarlo bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7166631,
