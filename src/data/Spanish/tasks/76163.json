			"dialogs": [
				{
					"id": 761630101,
					"content": "... Sonnet. Ahora que lo pienso, en estos últimos años dejas de lado cada vez más trabajo para escaparte a jugar con los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "¡N-no tiene nada de malo! Podemos dejarles el trabajo a esos emisarios lunares, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Si el nuevo amo que ustedes dos eligieron está dispuesto a enviar subordinados para aligerarnos la carga, entonces no me queda más remedio que aceptarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Además, ¡tú también te diviertes muchísimo, Canon! ¡Hasta fuiste a participar en una celebración humana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "... Eso formaba parte de mi trabajo. Su sumo sacerdote invocó mi nombre, así que era natural que respondiera a su llamado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "¿Eh? ¿Hacerte pasar por una chica humana normal y bailar frente a tu propia estatua también cuenta como parte del trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "... Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "... No te pedí que me llamaras por mi nombre... En fin. Ya que la nueva emisaria lunar tampoco parece tener problema en ayudar a Sonnet con su trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Se llama Zibai. Hay que recordar bien los nombres de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "... Ya que Zibai no tiene objeciones, no diré nada más. Pero, Sonnet, como voluntad de la luna, no puedes olvidar las bases de las fórmulas que mantienen el funcionamiento del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Prepárate. Voy a ponerte algunos ejercicios básicos para verificar isomorfismos de morfismos. Y olvídate de bajar a la tierra hasta que los resuelvas todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Jeje, qué malvada. Pareces la villana de una novela humana que quiere atrapar a la princesa fugitiva y llevarla de vuelta a la Luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "¡Eso, eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "... Tú misma eres la luna. No digas eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}