					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "Humm... Bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780302,
					"content": "¿Qué pasa, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Esta ciudad sombría. Muy triste, no sé por qué. Raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780304,
					"content": "Yo me siento igual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Bueno, vayamos al centro de esta ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "¡Qué raro, Kichiboushi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267804",
