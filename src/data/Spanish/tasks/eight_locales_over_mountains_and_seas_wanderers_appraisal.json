					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Ayayay... Qué fuerte viento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780402,
					"content": "¡No podemos pasar a través de esta pared de viento! Tenemos que rodearla para poder continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Kichiboushi, síguenos para rodearla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "¡Por fin llegamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "Las vistas son mucho mejores desde aquí arriba. Mira, nosotros vinimos desde allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "¿Paimon gusta de lugares altos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780504,
					"content": "Tienen vistas magníficas, y además son ideales para planear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "¿Tomterro dormir en esta torre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780508,
					"content": "Sí, durmió aquí mucho, mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Aunque {NICKNAME} y Stormterror combatieron, no es un dragón malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "Solo le sucedió algo desafortunado. Le hicieron daño y unos malvados lo engañaron, y por eso creyó que su amigo el Arconte Anemo ya no lo quería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Oh... ¿Y luego qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780512,
					"content": "#Entonces... {NICKNAME}, ¿tú lo recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "Durante el combate, purificamos su sangre envenenada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Pero la plataforma en la que estábamos peleando se derrumbó. Parecía que nosotros y el Arconte Anemo íbamos a caer en un lugar profundo y oscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "¡Oh! Qué horrible... ¿Qué hicieron? ¿Fueron volando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780516,
					"content": "Dvalin nos salvó y nos llevó volando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "¿Dva...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780518,
					"content": "Así se llama Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#Stormterror en realidad tiene un nombre propio, al igual que Kichiboushi, Paimon, y {NICKNAME}. Su nombre es Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "Al comienzo, Dvalin estaba herido y unos malos le engañaron. Se enfadó mucho y por eso atacó Mondstadt. Como todos pensaban que era un dragón malo, lo llamaron “Stormterror”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Después, derrotamos a esos malos y ayudamos al Arconte Anemo a purificar su sangre envenenada. Fue entonces cuando se dio cuenta de que el Arconte no le había abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "¡Guau! Entonces, Dva... Tomterro se volvió bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780524,
					"content": "¡Exactamente! Por eso hoy Paimon te trajo aquí para entrenar, para contarte la historia de Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Cuando seas mayor, también tendrás malentendidos, te harán daño y experimentarás cosas tristes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Pero no debes convertirte en una mala persona porque “el viento siempre cambia su curso”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Y algún día, soplará hacia un futuro mejor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "¿Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780529,
					"content": "¿Es complicado de entender, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Sí entender, pero no mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780531,
					"content": "#Pero Kichiboushi sabe que esto ser importante. No va a olvidar lo que dicen Paimon y {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780532,
					"content": "¡Jeje! A Paimon le tomó mucho tiempo contar toda la historia. ¡Al menos no fue en vano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "Bueno, como sea. Asegúrate de no ser demasiado travieso ni portarte mal, ¡eso puede hacer que te conviertan en una estatua en el futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "El entrenamiento de hoy ha terminado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780537,
					"content": "¡No estés triste! ¡Hay que regresar con una sonrisa, así Ioroi también estará feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "#Muy bien. Paimon y {NICKNAME} deben terminar sus deberes como guías...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Es hora de llevar a Kichiboushi de vuelta con Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780541,
					"content": "¡Vamos, Kichiboushi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Parece que completamos el encargo de Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Stormterror nos salvó y nos llevó volando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "“A los tontos y al humo les encantan los lugares altos”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "¡Ey! No tiene nada que ver con eso. En los lugares altos, las vistas son espectaculares y el aire es más fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267808,
