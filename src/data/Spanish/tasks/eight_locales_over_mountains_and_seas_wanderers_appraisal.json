			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Ciudad grande, pero... triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780102,
					"content": "Una vez vinimos aquí con muchos amigos y luchamos contra Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "¿Tomterro ser dragón con dientes grandes y afilados y sus alas dar miedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780104,
					"content": "Bueno, no daba tanto miedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Kichiboushi, ¿recuerdas esa estatua del Arconte Anemo que vimos en Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "¿Estatua del Arconte Anemo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780108,
					"content": "Esa estatua grande y alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "¡Oh! ¡Sí! Arconte Anemo tiene manos grandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780110,
					"content": "¡Pues Stormterror es su amigo! El Arconte Anemo también vino de esta ciudad hace mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780112,
					"content": "Pero Tomterro es muy grande, ¿cómo entra aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780113,
					"content": "Creo que ya he escuchado esta pregunta antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "¡Paimon sabe! Es porque no entra caminando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Kichiboushi sabe. Tomterro volar, no caminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780117,
					"content": "¡Arg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "¿Eh? Paimon parece no feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780119,
					"content": "Humm... Después hablamos de eso. ¡Primero, capturemos una imagen para conmemorar la ocasión! Kichiboushi, ¡no te muevas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "¡Kichiboushi no mueve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726780114,
					"content": "Es Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "En realidad era un dragón adorable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
		{
