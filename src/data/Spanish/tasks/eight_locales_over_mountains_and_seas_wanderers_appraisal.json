			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "¡Ioroi, regresamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Oh, ¡al fin volvieron! ¿Qué tal estuvo el entrenamiento de Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Chas, chas, ¡buum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790104,
					"content": "Jajaja, ¡qué bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Vaya, otra vez Paimon no puede entender a Kichiboushi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "Incluso capturamos muchas imágenes. Mira, Ioroi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Le enseñas a Ioroi las imágenes que le tomaste a Kichiboushi y le cuentas sus aventuras.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "#... Y así completamos la petición que nos hiciste de llevar a Kichiboushi de viaje con nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "#Sí, bien. Muy bien, no l{F#as}{M#os} juzgué mal. Si ustedes fueran tanuki, también serían grandes y reconocid{F#as}{M#os}. ¡Tal vez junt{F#as}{M#os} serían la mitad de fuertes que yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Eso no suena muy impresionante...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Pero, como ya completamos esta misión, es hora de irnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790113,
					"content": "Calma, calma, no te pongas así. ¡Paimon va a enseñarte una cosa más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Cuando te despidas de tus amigos, debes hacerlo con una sonrisa. Así estarás más contento cuando se vuelvan a encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "Humm... Bueno, está bien. Déjenmelo a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi dice “entiendo, pelo blanco”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "¿Eh? Acaso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "¿Kichiboushi no puede hablar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Ha pasado un buen tiempo. Los efectos de la comida tanuki deben haber desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "¡Hum! Si pudiera liberarme de este sello, sería más fácil hacerles entender el lenguaje de los tanuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "¿Eh? Claro, voy a transmitirles el mensaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "“Kichiboushi tiene que esforzarse mucho en el entrenamiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "“Para convertirse en un tanuki grande como Ioroi”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "Tienes buena labia. Jajaja, me recuerdas a mí cuando era pequeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "“Así, cuando pelo blanco y pelo rubio no comen comida de tanuki también entenderme”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "¡Sí! Te estaremos esperando. La próxima vez volveremos a entrenar juntos, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Ánimo, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "No permitas que te sellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "¿Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726790132,
					"content": "Olvídenlo. Lo dejaré pasar esta vez, solo porque llevaron a Kichiboushi a entrenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Ah, sí. Una vez hubo un tipo llamado Utamarou que pintó el tanuki encerrado en el Bosque Chinju y dejó algunos bocetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Puedes quedarte con ellos, para verlos siempre que quieras recordar la belleza de los tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "*Suspira*, si tan solo ustedes también fueran tanuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "En ese caso, ya nos habrían convertido en piedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hum, es cierto. Bueno, váyanse ya. Todavía tengo que enseñarle algo de magia a Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "¿Otra vez no podemos entender a Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}