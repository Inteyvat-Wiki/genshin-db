			"dialogs": [
				{
					"id": 790131201,
					"content": "¡Aquí debería verse bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Mensaje"
				},
				{
					"id": 790131202,
					"content": "Esperemos que Wolfgang lo vea y no acabe en la sala de estas ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Mensaje"
				},
				{
					"id": 790131203,
					"content": "Regresemos a ver, quizá esta vez las notas vuelvan a cambiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mensaje"
				}
			]
		},
