			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132901,
					"content": "(Estas marcas parecen antiguas. En ellas se puede leer algo:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132902,
					"content": "“El viento es demasiado fuerte aquí, así que no usaré un cuaderno esta vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132910,
					"content": "“Y pensar que me he topado con un pollo asado con miel todavía calentito aquí... ¡Esto sí que es un milagro!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132903,
					"content": "“No sé quién dejó el pollo asado con miel aquí, ni mucho menos cómo adivinó que yo tenía ese antojo, pero por muy raro que parezca, solo puedo sentirme agradecido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132904,
					"content": "“A la persona que dejó esas marcas: ¡gracias! Ese pollo asado con miel fue el más delicioso que he comido en mi vida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132905,
					"content": "“Seas quien seas, te estoy agradecido, soy consciente del peligro al que me expongo... Pero de veras quiero ir a Espinadragón”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132906,
					"content": "“¿Quién sabe? Tal vez el único vestigio de mi incursión en Espinadragón sea una señal de ‘Cuidado con las trampas’”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132907,
					"content": "“Pero si así alguien puede evitar los peligros que yo hubiese afrontado y llegar más lejos que yo... Eso sí que lograría reconfortarme, más incluso que volver a probar el delicioso sabor del pollo asado con miel”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132908,
					"content": "“Gracias a quienquiera que haya dejado estas marcas. Pero es precisamente por el honor de hacer frente a los peligros de Espinadragón que existen aventureros como yo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790132909,
					"content": "“Mis mejores deseos, Wolfgang”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marcas"
				}
			]
		},
