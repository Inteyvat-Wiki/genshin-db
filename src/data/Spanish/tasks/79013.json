			"dialogs": [
				{
					"id": 790133501,
					"content": "Aquí tampoco hay ningún cuaderno. Parece que Wolfgang todavía no ha llegado hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133502,
					"content": "¡Deberíamos dejarle una pista para que sepa cómo abrir la puerta de esta sala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133503,
						790133504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133503,
					"content": "Será complicado para él abrir la puerta de esta sala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				},
				{
					"id": 790133505,
					"content": "Es cierto, si Wolfgang no puede utilizar los elementos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133506,
					"content": "Entonces no servirá de nada. ¿Qué vamos a hacer ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133507,
						790133508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133507,
					"content": "Tenemos que evitar que entre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133509,
					"content": "¡Oh, eso es! Podemos dejar una nota en el exterior para que sepa que aquí hay una cámara secreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133510,
					"content": "¡Así no entrará y no se quedará atrapado en las ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133511,
					"content": "¡Vamos! ¡Rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133508,
					"content": "¡Dejemos un mensaje afuera de la puerta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133504,
					"content": "Solo podrá abrir la puerta si tiene poderes elementales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				}
			]
		},
