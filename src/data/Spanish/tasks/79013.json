				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Con razón no encontrábamos ninguna nota. Resulta que grabó sus palabras en este pilar... Eso quiere decir que consiguió llegar hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Pero ¿de dónde sacó toda esta confianza? Si no fuera por nuestra ayuda, todavía seguiría atrapado en alguna de esas salas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "Si va a Espinadragón, ¡seguro que acaba siendo carne congelada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "Paimon, te has pasado con eso de “carne congelada”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "P-Paimon solo quería decir que si va a Espinadragón, seguro que acaba enfrentándose a un sinfín de peligros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "¡Tenemos que advertirle que no vaya a Espinadragón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Dejémosle otro mensaje entonces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "Hum, Paimon también cree que es buena idea. Además, ¡esta vez también podríamos dejarle un poco de pollo asado con miel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "¿Quién sabe? Quizás, al comer el pollo asado con miel, de pronto recuerda la calidez de Mondstadt, ¡y así ya no querrá irse a Espinadragón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "El pollo asado con miel se estropeará antes de que eso suceda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Ay, vamos, ¡a pollo regalado no le mires el pico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Eso podemos darlo por seguro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Pues claro, con el frío glacial que hace en Espinadragón y todos esos Hilichurls deambulando por ahí... ¡Por no hablar del Rey Jabalí de las Nieves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
