			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "Jeje, el pollo asado con miel está delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130202,
					"content": "¡Paimon ya entiende por qué ese tal Wolfgang lo extraña tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130203,
					"content": "A Paimon le da mucha lástima. Aquí atrapado sin poder disfrutar de un pollo asado con miel como los Arcontes mandan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130204,
					"content": "Qué cuaderno más antiguo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "Pues sí, pero... ¿Recuerdas cuando nos metimos en el estanque que hay en esta isla y nos transportó hasta otro lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130217,
					"content": "Los edificios que había en la isla del estanque parecían más completos que los de fuera, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130218,
					"content": "Comparado con ellos, los edificios de esta isla parecen más bien en ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130219,
					"content": "Tal vez los edificios del interior del estanque sean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "¡Eso tendría sentido! Puede que los edificios de la isla del estanque tengan el mismo aspecto que las ruinas antiguas de fuera de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, ¿crees que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130223,
					"content": "¿Que la isla del estanque es la misma isla, pero en el pasado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "¡Exacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130207,
					"content": "Además, ¡podríamos salvar a ese aventurero si encontramos el lugar donde se quedó encerrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130208,
					"content": "Solo será posible dentro de la ilusión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Bueno, de acuerdo, pero... Aunque no sea real y ese aventurero sea imaginario... ¿No crees que deberíamos intentar salvarlo? Su historia es tan triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130211,
					"content": "#Vamos, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130212,
					"content": "Supongo que llevas razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "¡Jeje! Paimon ya sabía que estarías de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130216,
					"content": "Deberíamos empezar por la isla que hay en el estanque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130214,
					"content": "Está bien, echaremos un vistazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "¡Yuju! ¡A salvar al aventurero Wolfgang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130209,
					"content": "Eso no cambiará la realidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "Tal vez los edificios del interior del estanque reflejan su aspecto original...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "Parece que fue hace ya mucho tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
