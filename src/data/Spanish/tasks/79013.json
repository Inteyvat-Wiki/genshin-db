			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(Estas marcas parecen antiguas. En ellas se puede leer algo:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131802,
					"content": "“El viento es demasiado fuerte aquí, así que no usaré un cuaderno esta vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131803,
					"content": "“El sol brilla en todo su esplendor. Me llena de satisfacción el saber que afronté mis temores y logré llegar hasta aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131804,
					"content": "“Me pregunto si alguien más llegará a ver este hermoso paisaje”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131805,
					"content": "“... A pesar de todos los peligros que encontré, conseguí llegar hasta aquí. Próximo destino: ¡Espinadragón!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131806,
					"content": "“Este sitio no está nada mal, lo único que falta es un poco de pollo asado con miel...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Marcas"
				},
				{
					"id": 790131807,
					"content": "“Wolfgang”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marcas"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7901327",
							"2"
						],
						"stepId": 7901327,
						"stateName": "QUEST_STATE_UNFINISHED"
