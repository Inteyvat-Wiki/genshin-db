					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132601,
					"content": "Parece que no volvió a entrar, es un verdadero alivio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132602,
					"content": "Pero Paimon no entiende esa actitud tan arrogante, ¡lo que hay que aguantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132603,
					"content": "Sí que se le ve más orgulloso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132604
					]
				},
				{
					"id": 790132604,
					"content": "Mencionó unas “ruinas que hay en lo alto”. Deberían estar al lado de las que se derrumbaron y cayeron al mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132605,
					"content": "Vayamos a comprobarlo. Paimon no está segura de que este hombre sea capaz de escalar hasta un lugar tan alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
