			},
			"dialogs": [
				{
					"id": 790132501,
					"content": "Este cuaderno... Ah, ¡es de Wolfgang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132502,
						790132503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132502,
					"content": "¿Otra vez se quedó atrapado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				},
				{
					"id": 790132504,
					"content": "Desde luego que la gente solo aprende a base de golpes y porrazos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132505,
					"content": "#Este sitio sumergido bajo el agua... Deben de ser las ruinas de la montaña que vimos en la isla del estanque... {NICKNAME}, vayamos allí a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132503,
					"content": "Me temo que no aprendió la lección...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				}
			]
		},
		{
			"id": 7901326,
			"completionStepIds": [
				7901325
