			"dialogs": [
				{
					"id": 790131101,
					"content": "¡La puerta se abrió! Esta vez era un mecanismo bien fastidioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}, parece que Wolfgang no dejó ninguna nota aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131103,
					"content": "Eso quiere decir que aún no ha venido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "Entonces, es como si hubiésemos abierto la sala por él de antemano... ¡Esta vez no debería quedarse encerrado aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131105,
					"content": "Eso dará igual si el mecanismo puede activarse repetidamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Entonces, ¿qué hacemos? ¡Oh, podemos dejarle un mensaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131108,
					"content": "Dejemos grabado en algún lugar visible un mensaje diciéndole cómo descifrar el mecanismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131106,
					"content": "Cuando él venga, tal vez el mecanismo se haya activado de nuevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
			"id": 7901312,
