			"dialogs": [
				{
					"id": 790132701,
					"content": "Paimon espera que a Wolfgang se le quite de la cabeza la idea de ir a Espinadragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132702
					],
					"speakerTitle": "Mensaje"
				},
				{
					"id": 790132702,
					"content": "Atravesemos el estanque y regresemos a las ruinas donde estábamos para echar una ojeada... ¡Quizás nos llevemos una sorpresa y haya cambiado de opinión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mensaje"
				}
			]
		},
		{
			"id": 7901329,
			"completionStepIds": [
				7901322
