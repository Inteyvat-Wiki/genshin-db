				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132401,
					"content": "¡Conque realmente consiguió escapar de la sala! ¡Por eso presumía de audaz! ¡Pero es obvio que escapó gracias al mensaje que pusimos en ese lugar tan fácil de ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132410,
					"content": "Y... ¡¿cuántos cuadernos llevaba este tipo consigo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132402,
					"content": "*Suspira*, no regresó a casa tras escapar... Se empeñó en continuar sus aventuras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132403,
						790132404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132403,
					"content": "Porque pensaba que salió del atolladero él solo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				},
				{
					"id": 790132405,
					"content": "Así es, la sala donde permanecería atrapado para siempre en un principio ahora se convirtió en una simple dificultad más que superó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132406,
					"content": "Pero las ruinas de la montaña que él mencionó no se ven en la isla de fuera del estanque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132407,
					"content": "Será porque pasó mucho tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132408
					]
				},
				{
					"id": 790132408,
					"content": "¿Será que se derrumbaron y cayeron al agua?... Paimon cree haber visto unos edificios muy parecidos en el mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132409,
					"content": "¡Deberíamos explorar el mar de los alrededores cuando tengamos tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132404,
					"content": "Porque pensaba que escapó sin ayuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				}
			]
		},
		{
			"id": 7901325,
			"completionStepIds": [
				7901324
