				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "¿Eh? ¿Qué son todas estas fanfarronadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131602,
					"content": "No, tenemos que ir a Espinadragón y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Los cambios en la ilusión no pueden cambiar el pasado, lo sabes, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "... Oh, tienes razón. Este Wolfgang solo apareció porque todo el Archipiélago Manzana Dorada está bajo la influencia de esa máquina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "Por eso Paimon creyó que fue rescatado... Pero, en realidad, nunca pudo salir de la sala original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "Pero, pero... ¡Ese Wolfgang es de lo más irritante! Con toda la ayuda que le brindamos, y se pone a pensar en lo bien que estaría “allanar el camino” a otros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "¿No podría valorar su vida un poco más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Cada uno tiene algo a lo que aspira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Sí, sí, Paimon lo entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Solo que... ojalá hubiera tenido un final mejor, como regresar a Mondstadt, o convertirse en un gran aventurero y... y luego poder ir a la taberna a jugar con los gatos y comer tanto pollo asado con miel como le apetezca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "¿Por qué nunca pueden tener un final feliz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "Bueno, es gracias a personas como él que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Wolfgang nunca podrá llegar a Espinadragón...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
			"completionStepIds": [
				7901318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
