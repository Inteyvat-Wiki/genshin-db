				{
					"id": 120211101,
					"content": "Humm. Yo no llamaría “hacer las cosas al pie de la letra”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Pero a veces pasa. Las batallas son complejas y la situación evoluciona constantemente. No siempre es bueno atenerse rígidamente a un plan predeterminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Jeje... Tan pronto como la lucha comenzó, el plan se fue al traste y fuimos improvisando...",
