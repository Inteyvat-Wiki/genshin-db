			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Este debe ser el campamento Fatui del que hablaba el comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210102,
					"content": "Parece que antes era un campamento de Hilichurls. ¿Por qué lo ocuparían los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210103,
					"content": "Parece estar bien vigilado, ¿cómo lograremos entrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210104,
					"content": "No por la fuerza, eso seguro. Pero eso no supone un problema. El terreno aquí nos da ventaja, y no han descubierto nuestra posición aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210105,
					"content": "Nuestro enemigo está en la luz, mientras que nosotros estamos en las sombras. Estratégicamente, tenemos la ventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210106,
					"content": "¿Y qué tiene en mente la Gran Estratega?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Creo que tenemos tres opciones disponibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210108,
					"content": "Opción 1: acabar con el rey y hacer jaque mate. La presencia de los Fatui en Inazuma es débil en este momento, nada más que unos pocos soldados dispersos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210109,
					"content": "Si atacamos desde arriba y derribamos primero a su líder, el resto de ellos se verá en apuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210110,
					"content": "Opción 2: golpear donde más duele. Por ejemplo, allí. Un almacén de barriles de pólvora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210111,
					"content": "Si logramos encender discretamente la pólvora sin alertarlos, les infligiríamos un golpe devastador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210112,
					"content": "Los tomaríamos completamente desprevenidos. Tanto su moral como su capacidad de lucha se verían gravemente afectadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210113,
					"content": "#Opción 3: usar el entorno contra ellos. Estamos cerca del mar, así que el aire es muy húmedo. Yo puedo recoger el vapor de agua, tú añades un poco de relámpago, y junt{F#as}{M#os} podemos electrocutarlos hasta que se rindan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210114,
					"content": "¡Como era de esperarse de nuestra gran estratega! Aunque hay mucho que pensar... ¿qué opción debemos elegir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210115,
					"content": "Eso dependerá de la evaluación de nuestras propias habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210116,
					"content": "Un ataque sorpresa desde el aire es la solución más rápida, pero requiere habilidades de combate superiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210117,
					"content": "#Con una explosión, podríamos reducir rápidamente su número sin una batalla prolongada, pero debemos ser sumamente sigilos{F#as}{M#os} durante la operación, o nos arriesgamos a exponernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210118,
					"content": "#Si decidimos aprovechar el entorno, tenemos que prepararnos para un largo asedio. Entonces, {NICKNAME}, ¿qué opción prefieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210119,
					"content": "El ataque aéreo sorpresa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "#Jaja... Digno {F#de la capitana}{M#del capitán} del Escuadrón Pez Espada. Confío plenamente en tus habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210121,
					"content": "#¡Entonces ya está decidido! Luchemos junt{F#as}{M#os}. No soy una gran guerrera, pero puedo proporcionar algo de apoyo. No dejaré que pelees tú sol{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210122,
					"content": "Tenemos que acabar con ellos lo antes posible y recuperar los bienes del comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210123,
					"content": "El plan de la pólvora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Jaja, parece que compartes mis preferencias estratégicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210125,
					"content": "Esta es mi táctica preferida. Nos expone a la menor cantidad de peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210126,
					"content": "Démosles una sorpresa que nunca olvidarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210127,
					"content": "Démosles un buen calambre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "De acuerdo. Los atraeremos primero para minimizar el daño al campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210129,
					"content": "No he tenido muchas oportunidades de luchar junto a ti en el pasado. No sé si podré seguir tu ritmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210130,
					"content": "Aun así, no hay que preocuparse. Aunque no puedo decir que sea una guerrera, estoy familiarizada con el campo de batalla. Estoy a la altura de esta pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210131,
					"content": "De acuerdo. Despejemos el campamento y averigüemos qué traman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
