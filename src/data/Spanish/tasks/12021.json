					"content": "Jeje, ¡todo gracias a tus geniales tácticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211003,
					"content": "En realidad, incluso las mejores tácticas viven o mueren por la fuerza de quienes las ejecutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211004,
					"content": "Ganar una batalla requiere el esfuerzo conjunto de todos los implicados. La victoria nunca pertenece a una sola persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211005,
					"content": "Ahora que lo mencionas, Paimon hizo una gran contribución, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211006,
					"content": "Siento discrepar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211008,
					"content": "Debo admitir que no esperaba encontrar a los Fatui escondidos en un campamento de Hilichurls. Deben de haber estado operando desde aquí en secreto durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211009,
					"content": "¿Cuál es su objetivo? ¿Están los soldados en lo cierto? ¿Estarán realmente aliados con la Comisión Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211010,
					"content": "Busquemos pruebas en el campamento. Si la historia del comerciante es cierta, sus mercancías deberían estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211011,
					"content": "¡Muy bien! Es hora de echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
