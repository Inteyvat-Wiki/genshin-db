			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Debo admitir que no esperaba encontrar a los Fatui escondidos en un campamento de Hilichurls. Deben de haber estado operando desde aquí en secreto durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210202,
					"content": "¿Cuál es su objetivo? ¿Están los soldados en lo cierto? ¿Estarán realmente aliados con la Comisión Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210203,
					"content": "Busquemos pruebas en el campamento. Si la historia del comerciante es cierta, sus mercancías deberían estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210204,
					"content": "¡Muy bien! Es hora de echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202103,
			"completionStepIds": [
				1202108,
				1202118
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202108",
							"2"
						],
						"stepId": 1202108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "¡Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210302,
					"content": "Kokomi, encontramos las cosas del comerciante. ¡Mira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Humm... Ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Oh, no es nada. Solo me distraje por un segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Veamos... Sí, estos son los bienes robados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Alimentos, medicinas, herramientas agrícolas... Todo es esencial para recuperarse de una guerra. Probablemente el comerciante los estaba almacenando hasta que pudiera obtener ganancias jugosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "Por otro lado, dudo que la Comisión Tenryou necesite estos artículos, por lo que la idea de que él los estuviera suministrando no tiene mucho sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "Lo más probable es que solo sea un comerciante oportunista. Nada tan escandaloso como Matsuda y Uchimura imaginaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Aunque no es un santo, ¿cierto? ¿Cómo podría acumular cosas que la gente necesita desesperadamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "No vamos a devolvérselas y dejar que se vaya como si nada, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "No te preocupes, ya había previsto algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "En el decreto temporal de posguerra que emití recientemente, incluí limitaciones a los precios de los bienes esenciales de uso diario. Estos artículos llegarán al pueblo a un precio razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Si se hubiera tomado el tiempo de leer el decreto, es poco probable que hubiera acabado en este aprieto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Jeje, Kokomi, ¡tú piensas en todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Ojalá fuera cierto. Por ejemplo, esta supuesta cooperación entre la Comisión Tenryou y los Fatui... Todavía estoy perpleja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "Y estar baja en energía no ayuda precisamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "¿Eh? ¿Qué quieres decir con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Nada. Vamos, llevemos la mercancía de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "No falta mucho para la fiesta de la victoria. Resolver esto antes de que comience será una auténtica carrera contrarreloj...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "¡Entendido! ¡Primero recuperemos la paz y luego vayamos a la fiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "¿En qué estás pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naruse",
					"Matsuda",
					"Sangonomiya Kokomi",
					"Uchimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "¡Mis productos! ¡Los recuperaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "#¡Gracias, Su Excelencia! ¡Y gracias a usted, capit{F#ana}{M#án}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "¿Lo ven? ¡Les dije que era inocente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "¡Hum! Yo no estoy tan seguro. Podrías haber conspirado fácilmente con los Fatui de antemano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "Según la información que encontramos en el campamento de los Fatui, nada sugiere que haya tenido contacto con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Si ese hubiera sido el caso, conociendo cómo operan los Fatui, habrían dejado alguna prueba de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Nada de peros. Ya recuperamos la mercancía. Como acordamos, es suficiente para demostrar su inocencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Mis disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Supongo que nos dejamos llevar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "¡Ja! ¿Qué les dije? Ustedes, soldados bobos, no tienen ni idea, ¡son todo músculos y nada de cerebro! Venir a mí con sus descabelladas teorías conspiratorias... No vuelvan a molestarme, ¿entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "No tan rápido. Puede que seas inocente de sus acusaciones, pero el acaparamiento de bienes esenciales es un crimen según el decreto temporal. Debes asumir las consecuencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Ya admitiste ser el propietario de estos bienes, así que tenemos que responder con las medidas adecuadas. Además de imponer la venta de estos bienes a las tarifas aceptadas, también habrá una multa, cuyo importe es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "¡Espere, espere! Su Excelencia... ¿De qué lado está usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "No tengo por qué tomar partido. Como Sacerdotisa Divina de la Isla Watatsumi, me rijo por el principio de recompensar el bien y castigar el mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Así como el mérito debe ser reconocido, los errores deben ser penalizados. Puede que hayamos demostrado que eres inocente de las acusaciones más graves que se te imputan, pero eso no te exime de asumir las consecuencias de tus errores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "¡No te quedes parado! ¡Llévatelo! ¡Hora de pagar por tus delitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Su Excelencia, dice que todos los bienes le pertenecen, pero no tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Los que tienen el emblema de la Comisión Tenryou son probablemente suyos, pero el resto, no. Especialmente estos que son claramente para uso del santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Humm... Parece que los Fatui simplemente juntaron todos sus bienes robados en un solo lugar. Déjame a mí las cosas del santuario. En cuanto al resto, intenta localizar a los propietarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "Sé que es mucho pedir, pero se lo agradecería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "Para nada, Su Excelencia, ya nos ponemos a ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Pero si me lo permite... Tal vez no había señales de colaboración en este caso, pero nuestra gente sabe lo que vio. Algo está pasando entre la Comisión Tenryou y los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Sé que las conversaciones de paz se acercan, así que... por favor, mantenga una mentalidad abierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Entiendo sus preocupaciones, y lo tomaré en cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, llevaré estos objetos al Santuario Sangonomiya. ¿Por qué no me acompañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "De hecho, el primer santuario de la Isla Watatsumi no estaba situado en Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Estaba cerca de la Estatua de Los Siete. En aquel entonces, la gente de esta isla reconocía la existencia de la Shogun, a pesar de no venerarla como lo hace el shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210806,
					"content": "Pero después de que ella abatiera a nuestra deidad protectora, el santuario fue abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210807,
					"content": "Las relaciones entre la Isla Watatsumi y el shogunato se agriaron desde entonces, y la desconfianza se ha profundizado con el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "He estado esperando plantear todo esto en las conversaciones de paz y discutirlo adecuadamente. Al final, debemos hacer a un lado los agravios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Su Excelencia, ¿qué le trae por aquí en su apretada agenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Se ve un poco cansada... Tiene que cuidarse mejor, ¿de acuerdo? El destino de todos nosotros dependen de usted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Gracias por su preocupación, pero estoy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Su Excelencia, se lo ruego, preste atención a mi consejo. Después de todo este tiempo luchando contra el ejército de la Shogun, no puede declarar la paz así sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Si nos reconciliamos con ellos, el dios que alguna vez nos protegió habrá muerto en vano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Vamos, eso quedó en el pasado. Además, la lucha acaba de terminar. Deberíamos estar agradecidos de al fin alcanzar la paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Lo sé, lo sé, es solo que... Debemos permanecer fuertes en las negociaciones. No podemos parecer demasiado dispuestos a hacer concesiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Entiendo sus preocupaciones. Consideraré las opciones cuidadosamente y me aseguraré de proceder de forma apropiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Espléndido... Todos contamos con usted, Su Excelencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "¿Su Excelencia? ¡Qué casualidad! Me alegra encontrarme con usted en un lugar como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "¿Sabe? Mi hija se inscribió en el proceso de selección de miko para el santuario este año. Si entra en el Santuario Sangonomiya, ¡seré una madre muy feliz! Usted es una líder amable y gentil. Estará en muy buenas manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "Siempre le digo a mi hija que si tiene la oportunidad de aprender directamente de Su Excelencia, debe aprovecharla al máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Es decir, usted todavía es tan joven, pero tan madura e inteligente. Mi hija siempre la ha visto como un modelo a seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Bueno, si viene a Sangonomiya, cuidaré de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "¡Ah, Su Excelencia! Me alegro de que esté aquí. Como usted sabe, la producción agrícola ha recibido un golpe fuerte este año. Permítame ponerle al tanto de las últimas novedades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "#Oh, Su Excelencia, ¿no es est{F#a}{M#e} {F#la capitana}{M#el capitán} del Escuadrón Pez Espada n.º 2? ¿Tendrá su base en la Isla Watatsumi a partir de ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Su Excelencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "Uf... Por favor, mantengan la calma, responderé a todas sus preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Aunque para las más largas, preferiría que escribieran un informe y lo presentaran en el santuario. Así podré responder a cada una cuando tenga tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}, ¿estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "Estoy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Je... Este tipo de cosas son muy fáciles para ti, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Ah, Su Excelencia, aquí está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "Hubo un problema. Todavía estamos esperando la entrega de un lote completo de artículos ceremoniales. Estoy empezando a pensar que han sido robados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Oh, ya los recuperamos, no hay de qué preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "¿De verdad? ¡Fantástico! ¡Nunca deja de sorprendernos, Su Excelencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Clasifiqué todas las peticiones recibidas recientemente y las puse en su mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Además, según la agenda, llega justo a tiempo para su reunión de hoy sobre el desarrollo de la industria textil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "¿Eso es hoy?... ¿Ahora mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Sí. Las dos jóvenes ya llegaron y la están esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Humm, ya veo... *Suspira*, {NICKNAME}, esperaba poder dar un paseo por la isla contigo, pero tendremos que dejarlo para otro momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Reunámonos mañana en la entrada del Santuario Sangonomiya. Entonces, iremos a hacer los preparativos para la fiesta de la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "¡Sí, la fiesta de la victoria! Para que quede claro, habrá mucha comida deliciosa, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Jaja... Por supuesto. Habrá algunas especialidades de la Isla Watatsumi que estoy segura que disfrutarás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "¡Muy bien! ¡Nos vemos mañana entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "Esto pone a prueba mi paciencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "Sí, puede ser un dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
