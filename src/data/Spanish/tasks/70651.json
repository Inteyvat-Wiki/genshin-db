				{
					"id": 706510101,
					"content": "Humm... Me estoy quedando sin minerales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510102
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510102,
					"content": "¿Dónde puedo encontrar minerales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706510103
					]
				},
				{
					"id": 706510103,
					"content": "¿Minerales? ¿Quieres forjar algo? ¿Armas o armadura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510104
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510104,
					"content": "Si quieres minerales, sé dónde puedes encontrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510105,
					"content": "Pero los hay de muchos tipos. Los más comunes son los pedazos de hierro, seguidos de los muy útiles pedazos de hierro blanco o los pedazos de cristal, de gran calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510106,
					"content": "También tienes los pedazos de cristal mágico, que son de muy buena calidad y se pueden usar para forjar objetos excelentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
