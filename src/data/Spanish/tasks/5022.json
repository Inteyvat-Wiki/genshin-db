			"dialogs": [
				{
					"id": 50220801,
					"content": "#Buenos días, {NICKNAME}. ¿Tuviste una pesadilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "#Paimon oyó que no dejabas de dar vueltas en la cama, así que pensó que habrías dormido mal. ¿Estás nervios{F#a}{M#o} porque pronto llegará la batalla decisiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(Ya apenas me acuerdo de lo que soñé anoche...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Es como si hubiera una niebla que me impide recordar lo que sucedió. De hecho, me duele la cabeza al hacer memoria.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "Hoy acordamos vernos con Mavuika, ¡así que, vamos! ¡Espabílate! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
