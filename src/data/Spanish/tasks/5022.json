				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(Siento como si el cuerpo se me hubiera congelado al cruzar la barrera de luz.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Debe de ser porque la protección de la Señora de la Noche no llega hasta aquí. El frío y la oscuridad me calan los huesos, y no dejo de oír lamentos de cansancio y sufrimiento.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(No saben cuánto tiempo llevan deambulando ni cuánto tiempo les queda aún...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(¿Eh? Ese de ahí es...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Aunque nuestro hogar se ha convertido en un lejano recuerdo, las llamas de la guerra siguen rugiendo iracundas. Ya hemos derramado la última gota de nuestra sangre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "El Capitán"
				},
				{
					"id": 50220706,
					"content": "Aguanten un poco más, guerreros míos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "El Capitán"
				},
				{
					"id": 50220707,
					"content": "(¿Qué hace Capitano aquí? ¿Y qué está diciendo?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Llegará el día en que los lleve al lugar que les prometí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Capitán"
				}
			]
		},
