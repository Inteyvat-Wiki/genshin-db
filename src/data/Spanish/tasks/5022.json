			"dialogs": [
				{
					"id": 50220401,
					"content": "(¿Qué es este sitio? Es... ¿el Reino de la Noche?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(¿Qué estoy haciendo aquí? Hace un momento estaba... Eh...)",
					"roleType": "TALK_ROLE_PLAYER",
