				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#{NICKNAME}, qué casualidad. ¿Tú también has venido por el Rito de la Linterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "¿Estás preparando una felicitación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Sí, quiero prepararle una a Candace, pero no estoy satisfecha con ninguna de ellas, así que estaba pensando en empezar una nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "¿Candace no ha venido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Vendrá, pero... más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Al principio, ni siquiera aceptó venir conmigo a Liyue, pues quería quedarse a proteger la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Le dije que, siendo fin de año, era momento de tomarse un descanso. Como yo tenía que venir a Liyue para escoltar a un grupo de comerciantes, podía acompañarme y pasar el Rito de la Linterna conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Como no se quedaba tranquila, incluso le ofrecí la opción de que algunos de mis chicos vigilaran la aldea en su ausencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Pero Candace es tan terca que no podía convencerla. Al final, la gente de la aldea tuvo que insistirle para que accediera a tomarse unas vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Pero todavía tiene que organizar algunas cosas. Cuando termine con eso, vendrá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "No había otra solución, porque el grupo de comerciantes no podía esperarnos... Por eso estoy aquí ahora, esperándola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Estaba pensando en comprarle algo, pero aquí hay tantas cosas que no sabía qué elegir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Al final, acabé eligiendo un collar. Luego me contaron que en Liyue tienen la costumbre de acompañar el regalo con una felicitación. Por eso pensé en diseñar una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Pero, bueno... Como ya te había dicho, no estoy muy contenta con el resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Qué bien que estés aquí, {NICKNAME}. Tú que sabes de todo, ¿tienes algún consejo sobre cómo preparar una felicitación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Claro, déjame ver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
