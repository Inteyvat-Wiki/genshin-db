			"dialogs": [
				{
					"id": 715350401,
					"content": "#Vaya, qué habilidos{F#a}{M#o} eres... Esta felicitación es muy bonita, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "La consideraré como un regalo tuyo. Ahora no tengo nada valioso a mano, pero cuando regrese a Sumeru, te enviaré un obsequio a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Quiero hacer otra. Cuando llegue Candace, le regalaré el collar junto con la felicitación. Seguro que se pondrá muy contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Qué raro, ya ha pasado mucho tiempo... ¿Por qué sigue sin aparecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
