			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "¡Gracias! Me han salvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Esos Slimes salieron de la nada. No pensé que aparecerían por estos lugares... ¡Antes de darme cuenta, ya estaba rodeado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Por favor, no le digas a mi padre... Siempre insiste que me quede en casa, diciendo que los Slimes de por aquí se están volviendo más hostiles recientemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Con Slimes apareciendo cada vez más cerca de la ciudad, me he quedado atrapado en casa durante días. Me las arreglé para salir hoy sin que él lo notara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Si no te importa, ¿podrías comprobar que la costa está despejada? Y si no, ¿podrías deshacerte de los Slimes por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "¡Excelente! Así mi padre nunca lo sabrá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Tengo otras cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "Pero... no puedo meter a mi padre en esto... ¡Por favor, eres el único que puede ayudarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
