					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "¡No imaginé que romperían el sello de las Siete Estrellas! Creo que debo escribirlo en el reporte semanal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Pero que suene genial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "#*Ejem*... Sean seri{F#as}{M#os}, la situación es grave. Es tan grave, que las mismas Siete Estrellas evaluarán la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "En otras palabras, después de que entregue el reporte semanal, es probable que una de ellas venga en persona a detenerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "¡Hum! Y cuando eso ocurra, no estaré yo para protegerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "Entonces tampoco esperes que luego vaya yo a salvarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "#¡Hum! ¿Asustad{F#a}{M#o}? Bueno, hay gente esperando por ti, ¡andando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
