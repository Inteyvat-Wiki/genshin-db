			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "*¡Buaa!* Todavía no he escrito mi deseo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Yi Xian, pórtate bien, el señor de la Geoarmada ya fue por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "¿Dónde está Tsai Le?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "¿Estás buscando a ese señor de la Geoarmada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Hace un momento, cuando Yi Xian estaba escribiendo su deseo en una linterna celeste, se le escapó volando en esa dirección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "Ese señor de la Geoarmada dijo que había visto la linterna colgada de un árbol, así que fue a ayudarnos para recuperarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "¿Tan especial era esa linterna celeste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Eso le dije a Yi Xian, pero ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Oh... ¡No, no! Esa me la hizo mi hermano. Le tomó mucho tiempo terminarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Yi Xian, el señor de la Geoarmada volverá pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "Disculpa, si lo necesitas con mucha urgencia, podrías ir a buscarlo por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190408,
					"content": "¿No podían haber hecho otra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
		{
			"id": 7181905,
			"completionStepIds": [
				7181906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
