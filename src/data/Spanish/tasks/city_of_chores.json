			"trigger": {
				"objectNames": [
					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "*Suspira*, hay tantas cosas por hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Oh, no es nada. Estaba organizando los asuntos pendientes del Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190104,
					"content": "Es solo que... mientras más se planea, más cosas hay por hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190105,
					"content": "Aunque algunos colegas me ayudaron con una parte, este año me toca a mí coordinar la entrega de las linternas celestes. Si no aprieto el paso, no estaré a tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190106,
					"content": "¿Entregar linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Pues... cuando digo “entregar”, no es lo que tú te imaginas. No es simplemente entregarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190109,
					"content": "Dicho de forma simple... Se trata de trasladar los buenos deseos a la gente, de crear un ambiente festivo, ese tipo de cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190110,
					"content": "Por ejemplo, durante el Rito de la Linterna, aunque la mayoría de las personas regresan a sus hogares y las tiendas también cierran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190111,
					"content": "... hay trabajadores esenciales que no pueden tomarse un descanso, especialmente aquellos a cargo del orden durante la celebración, como la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190112,
					"content": "El Ministerio de Asuntos Civiles suele asignar a alguien para que les entregue algunos regalos a ellos también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190113,
					"content": "Hoy justamente estoy preparando lo necesario para ir a entregar linternas celestes a los guardias de la Geoarmada encargados de la seguridad de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190114,
					"content": "Pero... no hay suficientes manos. Algunos regalos ya se entregaron, pero aún quedan muchos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190115,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a entregar algunos regalos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190116,
					"content": "Sí, no hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "¿De verdad? Perfecto, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190118,
					"content": "¿A quién debo entregárselos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "A ver... Los miembros de la Geoarmada que todavía no los han recibido son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190120,
					"content": "Xiangming... Hongyi... y Tsai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190121,
					"content": "Marcaré la ubicación de sus puestos. Bien, ¡cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190107,
					"content": "¿Hay que hacer muchas entregas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
			"id": 7181902,
			"completionStepIds": [
				7181902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
