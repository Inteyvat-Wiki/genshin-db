			"dialogs": [
				{
					"id": 718190301,
					"content": "¿Qué es lo que pasa con este pozo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Tengo un obsequio del Rito de la Linterna para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Oh, ¿esto lo envía el Ministerio de Asuntos Civiles? Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Pero todavía tengo que quedarme en mi puesto por un tiempo, no vaya a ser que alguien venga a tomar agua durante el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "*Suspira*... No sé qué le ocurrió al pozo, pero el agua no es potable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
		{
