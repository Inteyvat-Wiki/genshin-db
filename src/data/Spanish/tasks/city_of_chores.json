			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "Ah... ¿Cómo se sube? Humm... Tal vez deba pensar en otro método...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190502,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "#Oh, hola, viajer{F#a}{M#o}. Jaja, nada importante. Solo intento encontrar una forma de escalar el árbol para bajar esa linterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190504,
					"content": "Pero, con esta armadura, es imposible subir. En cuanto llego a la mitad, me resbalo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190505,
					"content": "#Eh... Viajer{F#a}{M#o}, ¿y si tú me ayudas? Recuperar la linterna celeste no debe ser problema para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190506,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Genial, gracias. Terminemos con esto lo antes posible para animar a esa niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsai Le"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
