			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangming"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "¿Eh? ¿Necesitas algo? Estoy de guardia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Tengo un obsequio del Rito de la Linterna para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "¡Baja la voz! Estoy de guardia, ¿de qué obsequio hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "¿Eh? ¿Te envía el Ministerio de Asuntos Civiles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "*Suspira*, otra vez es el Rito de la Linterna. Y yo que pensaba regresar a casa este año...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Pero, a juzgar por la situación, no puedo relajarme... Supongo que otra vez llegaré a casa tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Gracias por venir hasta aquí para darme esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*Suspira*, ¿cuándo se irá este tipo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
