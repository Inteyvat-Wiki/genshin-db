				"objectNames": [
					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "¡Regresaste! ¿Qué tal te fue con la entrega de regalos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190702,
					"content": "Entregué cada uno a la persona indicada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "Gracias, has sido de gran ayuda... De no ser por ti, yo no podría con todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190704,
					"content": "¿Ellos tienen que estar en sus puestos durante todo el festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Pues... aunque el Ministerio de Asuntos Civiles organice el trabajo por turnos para la Geoarmada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190706,
					"content": "... Liyue en realidad es muy grande. Hay muchos sitios en los que necesitan patrullar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190707,
					"content": "Incluso si tomaran turnos, seguiría sin haber suficiente personal. Así que siempre hay quien debe trabajar durante el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190708,
					"content": "Además, como el Rito de la Linterna es tan grande todos los años, la carga de trabajo aumenta en algunos puestos. No importa cómo se asigne el trabajo, nunca hay suficientes manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190709,
					"content": "Parece un trabajo muy duro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "No, está bien. Es nuestro deber... Solo queremos que todo salga bien en el Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190712,
					"content": "Ah, sí. En realidad, durante la festividad hay mucha gente que necesita ayuda. Sería bueno si pudieras ayudarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190713,
					"content": "Cuanta más gente se una a la celebración del Rito de la Linterna, mayor será el ambiente festivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190714,
					"content": "La razón por la que enviamos linternas celestes es porque deseamos que todos tengan la oportunidad de liberarlas, y que sus sueños se cumplan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190715,
					"content": "En un sentido más amplio, enviamos el Rito de la Linterna a todas partes para que todo el mundo pueda vivir la experiencia del festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190716,
					"content": "Después de todo, el Rito de la Linterna es para todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190717,
					"content": "Bien, todavía tengo unos asuntos pendientes, así que puedes volver a lo tuyo. Te deseo un feliz Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190710,
					"content": "Eso es mucho trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
