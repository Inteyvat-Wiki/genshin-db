				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "¿Cómo te fue? ¿La conseguiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190602,
					"content": "Ya la tengo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "A ver... Sí, esta es, gracias. Ahora mismo iré a devolverles su linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190604,
					"content": "Espero que sigan en el mismo lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190605,
					"content": "Por cierto, tengo un obsequio para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "Ah, lo debe enviar el Ministerio de Asuntos Civiles. Gracias por traerlo hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190607,
					"content": "¿Esto también es responsabilidad de la Geoarmada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "¿Te refieres a recuperar linternas celestes? Jajaja, ¡por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190609,
					"content": "No importa si se trata de recuperar linternas, ahuyentar a los maleantes o pelear contra monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190610,
					"content": "Ayudar al que lo necesita es el deber de la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190611,
					"content": "Bueno, te lo agradezco nuevamente. Debo apresurarme a llevarle a los niños su linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Tsai Le"
				},
				{
					"id": 718190612,
					"content": "Luego tengo que ir a encargarme de otros asuntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsai Le"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
