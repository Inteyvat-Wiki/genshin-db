			"dialogs": [
				{
					"id": 715070101,
					"content": "¡Funcionó mejor de lo que pensaba! He registrado todas las variables y datos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070102,
					"content": "Y lo más importante, hemos conseguido eliminar todo el fango oscuro de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070103,
					"content": "Pero es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070104,
					"content": "¿Por qué estás tan triste? Que la mina esté despejada es algo bueno, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715070105,
					"content": "Déjame pensar... Bueno, cuando Khedive y yo analizamos la situación, pensamos que las aberturas de las líneas ley por donde salía el fango oscuro debían estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070106,
					"content": "Pero las aberturas no se despejarían tan fácilmente, así que las verdaderas aberturas deben estar en otro lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070107,
					"content": "El fango oscuro no solo ha afectado la zona de la mina, sino también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070108,
					"content": "Los túneles del frente minero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "Sí... Significa que la entrada por donde brota el fango oscuro se encuentra en los túneles. Esas áreas son aún más estrechas. Por eso el fango se acumula y atrae más monstruos, lo que empeora el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070110,
					"content": "Pero yo tengo fe en el Clavo de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070111,
					"content": "Después de todo, fue diseñado por la gran Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070112,
					"content": "Solo tengo que hacer un par de ajustes más. Después, buscaré a los mineros que aceptaron trasladar el Clavo a la mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}