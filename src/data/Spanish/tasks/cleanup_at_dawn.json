					"content": "Barrer es lo mío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240302
					]
				},
				{
					"id": 708240302,
					"content": "#¿En serio? ¡Espléndido! Si está dispuest{F#a}{M#o} a limpiar, estaré muy agradecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240303
