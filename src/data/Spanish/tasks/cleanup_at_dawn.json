				"points": []
			},
			"dialogs": [
				{
					"id": 708240101,
					"content": "¡Limpien el lugar de nuevo, y quiero que esta vez quede impecable! ¡Tenemos que dar una buena primera impresión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "¡Lo siento, señorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 708240103,
					"content": "¡Tendremos más cuidado, señorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "#Ah, es usted, viajer{F#a}{M#o}. Bienvenid{F#a}{M#o} al Viñedo del Amanecer. Puede que la tormenta haya pasado, pero aquí en el viñedo todavía estamos limpiando el desastre que causó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Estoy tratando de coordinar la limpieza, pero estas chicas, de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "¡Lo siento, señorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 708240108,
					"content": "¡Tendremos más cuidado, señorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Sí, sí, ¡eso ya lo dijeron! ¿Por qué en lugar de esforzarse por disculparse, no se esfuerzan en limpiar? ¡Apresúrense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Estas niñas... *suspira*, son tan descuidadas. A este paso no veo cuándo acabaremos. Y todavía falta por limpiar el interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
