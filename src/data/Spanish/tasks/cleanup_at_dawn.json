			"dialogs": [
				{
					"id": 708240401,
					"content": "¿Ya terminó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "Sí, quedó impecable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Maravilloso, fue de gran ayuda. No puedo imaginar cuánto tiempo me hubiera llevado esto sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "Si tan solo lograra que las chicas lo hicieran... No sé cuántas cosas han tumbado en el proceso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "#Gracias. Por favor, tome esto. Le pido disculpas por molestarl{F#a}{M#o}. Después de todo, es {F#una invitada}{M#un invitado}. Siento tener que pedirle ayuda en la limpieza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "La próxima vez que nos visite, la bodega estará inmaculada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
