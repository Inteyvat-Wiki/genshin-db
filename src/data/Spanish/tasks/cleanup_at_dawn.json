				{
					"id": 708240201,
					"content": "Yo puedo ayudarles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "¿Sabe barrer? En realidad, olvídelo. Nos falta personal, así que cualquier ayuda es buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Entre conmigo, hay mucha limpieza que hacer aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082403,
