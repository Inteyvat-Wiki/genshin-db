			"dialogs": [
				{
					"id": 120120801,
					"content": "El espectáculo de pirotecnia de Naganohara debe estar a punto de comenzar. Mi hija se fue hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120802,
					"content": "No podía esperar para salir de casa. Está claro que está muy enamorada de ese chico de la ciudad, se le nota en la cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120803,
					"content": "*Suspira*, supongo que, al menos, es feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Satoru"
				}
			]
		},
		{
