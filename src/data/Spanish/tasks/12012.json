			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Yoimiya, ¡ha ocurrido algo malo! Han venido unas personas de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "¿Eh? ¿Por qué?... ¿Lo saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Papá, ¿estás bien? No te han hecho nada, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "Les dije que el espectáculo iba a empezar pronto y que el lugar estaba lleno de fuegos artificiales, por lo que no debían entrar porque sería un peligro de incendio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "Pero no escucharon. Parecía que sabían que Sakujirou estaba dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Por suerte, Sakujirou les oyó llegar a tiempo y consiguió escapar por la ventana. La Comisión Tenryou no pudo capturarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "Estas son malas noticias. No creo que Sakujirou haya tenido tiempo suficiente para decidirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Papá, ¿viste a dónde fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "La Comisión Tenryou lo perseguirá sin duda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "¿Oíste alguno de sus nombres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "¡Eso! ¡Nombres, necesitamos nombres! Aparecer así de repente... ¡debe ser cosa de Keisuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "Normalmente, la Comisión no montaría un escándalo tan grande por un polizón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Lo siento, no oigo bien y tampoco pude verlos bien. Si te preguntas por dónde se fueron, salieron de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "Sin embargo, no oí sus nombres... *Suspira*, no oí nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "Bueno, yo sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "Iba a buscar minerales a casa de un amigo y me topé con ellos por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "Creo que su líder se llamaba Keisuke, como han dicho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "¡Tal y como pensaba! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "Si Sakujirou aún no se ha decidido, el hecho de que esos dos se encuentren no resolverá nada. Es más, no habrá vuelta atrás para Sakujirou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#No podemos dejar que eso ocurra. Ven conmigo, {NICKNAME}, ¡vamos a buscarlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
