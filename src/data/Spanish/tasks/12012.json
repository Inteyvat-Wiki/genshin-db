	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "¡Bueno! ¡Pero si es Yoimiya! Pasa, querida, ven y toma asiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "#¿Est{F#as}{M#os} son tus amig{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "#Sí, son viajer{F#as}{M#os} que vienen de lejos. A los forasteros les resulta muy difícil entrar en Inazuma hoy en día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "En efecto, son tiempos sin precedentes. Pero dado que han venido hasta aquí, los lugareños deberíamos darles una cálida bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Humm... Oh, antes de que lo olvide, he traído los fuegos artificiales que pidieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, gracias, querida. Tu familia es tan buena con nosotros todos los años. Primero tu padre, y ahora tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Me pregunto si seguiré vivo para ver al próximo heredero de Pirotecnia Naganohara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Claro que sí, ¡los dos gozan de buena salud! No digas esas cosas, da mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "Sin embargo, ya no somos tan jóvenes como antes. El cuerpo lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Antes podía pasarme todo el día trabajando la tierra, llevando agua de un lado a otro, pero ahora, incluso un momento de trabajo ligero me deja con todo tipo de dolores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Ayer quise desbrozar un poco, pero en cuanto me agaché para empezar, de repente sentí que si seguía adelante, no podría volver a levantarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "#No te preocupes, no digas más: ¡Nosotr{F#as}{M#os} nos encargamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "No, no, no, no podemos ponerte a trabajar cuando eres una invitada en nuestra casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Iré a buscar el té y unos aperitivos, y luego continuaremos nuestra conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Está bien, no es la primera vez que te ayudo con las tareas. Es solo que no he tenido mucho tiempo últimamente con el espectáculo de los fuegos artificiales que se avecina, pero una vez que se acabe, me aseguraré de venir más a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "No es ningún problema, de verdad. No nos importa ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "*Suspira*... Son muy amables... No como mi hijo. Ya ha crecido y todavía no ha encontrado a nadie, pero aun así nunca visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Si estás segura de que no es un problema, entonces... Tengo un poco de rábano encurtido aquí, ¿te importaría entregárselo a Satoru al otro lado de la aldea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Claro, no nos llevará ni un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Los ancianos no se mueven mucho, así que vamos a ayudarles. Primero <color=#00E1FFFF>nos desharemos de las malas hierbas</color> y luego <color=#00E1FFFF>repartiremos el rábano encurtido</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Hola, Satoru, ¿cómo has estado? ¿Cómo sigues?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Lo mismo de siempre, no ha cambiado mucho. Te ves llena de vida, como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Todo ello gracias al apoyo de nuestros fieles clientes. El negocio familiar no deja de mejorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Hace un tiempo vendimos algunos fuegos artificiales a Liyue, y se dice que fueron un verdadero éxito. Así que parece que vamos a tener más negocios allí en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Pero eso debe suponer mucho más trabajo para ti. ¿Estás segura de que tú y el Sr. Ryuunosuke pueden arreglárselas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Si es demasiado, no olvides que siempre puedes pedirme ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Deberíamos estar bien. Creo que podemos arreglárnoslas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Ah, sí, esto es un rábano encurtido de la señora Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Vaya, ¡muchas gracias! Antes no me gustaba mucho el rábano encurtido, ¿te lo puedes creer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Pero entonces probé algunas de las cosas caseras de la Sra. Imatani, y no me cansé de ellas. Ahora es un alimento básico de la familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Hablando de tu familia, ¿cómo están todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Les va bien. Tenemos alguna que otra discusión acalorada, pero... supongo que así son todas las familias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Poder tener a tu familia cerca es mejor que no poder verlos nunca, aunque suponga tener que soportar algún conflicto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "El Sr. y la Sra. Imatani parecen tener una gran relación, pero aun así, deben sentirse solos porque su hijo nunca les visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "A mí no me lo han parecido. Creo que simplemente están acostumbrados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Sin embargo, tienes razón. Debería pasarme más a menudo en el futuro. Así no se aburrirán tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Seguro que les encantaría, y a todos nosotros también. Eres más que bienvenida en la Aldea Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "¡Qué rápido! Ah, los jóvenes son tan ágiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Las personas más jóvenes tienen montones de energía, y las mayores tienen una gran sabiduría. Cada uno tiene sus puntos fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Hablando de juventud... ¿Sabes qué? Este año se han cumplido cincuenta años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Oh, ¡así es! Dios mío, cómo vuela el tiempo... Apenas te das cuenta de que los años pasan, pero de repente, han pasado cincuenta años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "¿Cincuenta años desde qué? ¿Algún día importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Jaja, bueno, si quieres saberlo, fue hace cincuenta años, en la época en que esta joven aún intentaba conquistarme, que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "#Deja de intentar impresionarl{F#as}{M#os}. Ambos sabemos que eras tú el que estaba irremediablemente enamorado y trataba desesperadamente de ganarse mi afecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Pues bien, dejemos de lado los pormenores. Hace cincuenta años, le propuse matrimonio a mi mujer en el espectáculo de pirotecnia de Naganohara. Desde entonces estamos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Enhorabuena a los dos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "A decir verdad, todavía estaba un poco inseguro. No estaba seguro de lo que estaba haciendo cuando entré en la tienda de los Naganohara y pedí mis fuegos artificiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Incluso mientras se elevaba hacia el cielo... todavía no tenía ni idea de lo que iba a decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Pero entonces explotó... El cielo se iluminó... Volví a mirar hacia ella y vi sus ojos, centelleando a la luz de los fuegos artificiales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "... Antes de que me diera cuenta de lo que estaba pasando, aparentemente, ya lo había dicho, y ella había dicho que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "Cincuenta años... En algunos aspectos, es mucho tiempo, en otros, no es nada. En realidad, es solo un número.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Pero cincuenta años estando juntos... Eso sí que es algo que merece la pena conmemorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "No tenía ni idea de que era su aniversario. Si lo hubiera sabido, habría hecho unos fuegos artificiales especiales, solo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "No, no pasa nada. Todos los años lanzamos los mismos fuegos artificiales. No sería lo mismo sin ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Ver estallar los fuegos artificiales nos transporta a esos días. Incluso a esta edad, seguimos mirando hacia atrás sin lamentar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Qué buena relación tienen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Sin embargo, ya basta de hablar de nosotros. Yoimiya, ¿no estás ocupada con el espectáculo de fuegos artificiales que se avecina? ¿Había algo que necesitabas discutir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Sí... es algo difícil, pero ahí va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Sakujirou... Entonces, volvió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "¿Eh? ¿Lo conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Era el mejor amigo de nuestro hijo cuando eran jóvenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*Suspira*... Eran inseparables. Crecieron juntos, lo compartían todo entre ellos e iban juntos a todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Pero un día tuvieron una terrible discusión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Sakujirou parecía sentir que Inazuma era demasiado tranquilo, y quería ver cómo era el mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Pero nuestro Keisuke siguió el ejemplo de su padre y de su madre. Consideraba que no había nada de malo en la paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Ya sabes cómo son los niños, se ponen muy nerviosos con este tipo de cosas. Al final, Sakujirou se marchó enojado, y eso fue todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke no nos dijo nada ni a mí ni a mi mujer sobre la pelea. Percibimos que estaba muy dolido por ello, pero no quería hablar con nosotros de cómo se sentía realmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Con el tiempo, ya sea por reprimir su enojo o por algún otro motivo, se unió a la Comisión Tenryou. Ya casi nunca viene a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Si fuera por otro motivo, podría hablar con Keisuke, y seguro que estaría dispuesto a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Pero como se trata de Sakujirou... No creo que podamos involucrarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Qué extraña coincidencia. Quién lo iba a decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Ahora lo entiendo. Cuando le pregunté a Sakujirou por qué había vuelto, se limitó a decir “por los errores del pasado” y no quiso dar más detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Ahora, por fin entiendo por qué no puede decidir qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Dos mejores amigos de la infancia... Al crecer, uno se une a la Comisión Tenryou y el otro a la lista de los más buscados de la Comisión Tenryou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Supongo que es el destino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Bueno, no se preocupen, si ese es el caso, no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Podemos encontrar otra forma de ayudar a Sakujirou, no hay necesidad de complicarse las cosas. Esto parece algo que deben resolver Sakujirou y Keisuke entre ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Sí, sería estupendo que pudieran volver a ser como antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Creo que, después de todos estos años, deberían dejar de lado sus rencores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Yo tampoco lo habría imaginado nunca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Debes estar muy orgulloso de lo que tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
