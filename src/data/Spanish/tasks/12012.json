					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120902,
					"content": "Un día, ese chico tendrá que enfrentarse a sus sentimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120903,
					"content": "Esta es una lección de vida que no puede aprender de sus padres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Kaori"
				}
