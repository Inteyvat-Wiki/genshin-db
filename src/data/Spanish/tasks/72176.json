							"2"
						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Oh, ¿es muy difícil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760203,
					"content": "¡Paimon solo estaba calentando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "¿Quieres intentarlo de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760205,
					"content": "#¡Por supuesto! ¡{NICKNAME}, muéstrale a Kujirai lo buen{F#as}{M#os} que somos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "¡Una vez más!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "¡Yuju! ¡El objetivo es encontrar la temari dentro del límite de tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "¡Eres genial! ¡La encontraste de inmediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Jeje, {NICKNAME} es {F#una viajera experimentada}{M#un viajero experimentado} que ha recorrido muchas naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "¡Guau! ¿También has estado en Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760705,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "¡Genial! Escuché de mi amiga la aventurera que hay muchos lugares bonitos en Mondstadt, como las Ruinas de Stormterror con una torre superalta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760707,
					"content": "Es “la Guarida de Stormterror”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Sí, me pregunto cuál es más alta, si esa torre o Tenshukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760710,
					"content": "Kujirai, ¿qué haces solo en el campo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Cuando mi hermana estaba pescando, pensó que asustaría a los peces, así que me dijo que saliera a jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760712,
					"content": "Una vez que me encontré con mi amiga la aventurera, dijo que parecía aburrido, así que me dio muchas temari y me dijo: “encuentra viajeros avariciosos y juega con ellos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760713,
					"content": "Viajeros avariciosos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "#¡No somos avaricios{F#as}{M#os}! ¡Es solo que a Paimon le preocupa que te aburras jugando a solas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "Sí, yo también creo que son buenas personas, así que me siento muy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760716,
					"content": "¿Qué haces solo en medio del campo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Eres solo un niño en medio de la naturaleza, ¿no te preocupa encontrarte con algún peligro? Sin mencionar esa “cosa buena” que llevas contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "Eres muy amable. No te preocupes, mi amiga la aventurera me enseñó que si algo llega a pasar, las temari se pueden convertir en bombas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760719,
					"content": "¡Qué peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "¡Para nada! ¡He mandado a volar a muchos malos, como Hilichurls y Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760721,
					"content": "¡El peligroso eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Por cierto, {NICKNAME}, si quieres jugar con las temari con otros amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760723,
					"content": "... ¡dejaré las temari aquí! Estas son las reglas:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760724,
					"content": "Cuando escondas una temari, debes hacerlo antes de que la canción de las temari acabe. La persona que la busque también debe encontrarla en ese límite de tiempo. ¡Así es más justo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760725,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "... Da un poco de miedo pensar que estamos jugando con bombas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "No teman. Mi amiga la aventurera me dijo que “Las bombas solo estallan con los malos. Tal vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760728,
					"content": "¡¿“Tal vez”?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#Bien, ¡iré a jugar a otra parte! ¡Adiós, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760708,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}