	"talks": [
		{
			"id": 7217601,
			"completionStepIds": [
				7217601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217601",
							"2"
						],
						"stepId": 7217601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Pequeño Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#¡Hola, viajer{F#a}{M#o}! Tengo algo genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760102,
					"content": "Gracias, pero paso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Qué pena, verse obligado a hacer negocios turbios a una edad tan temprana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "¡No es lo que estás pensando! Quería preguntarte si querías jugar una partida de temari conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760105,
					"content": "¿Temari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "Es simple, esconderé la temari en algún lugar cercano. Si la encuentras dentro del tiempo que dura una canción temari, ganas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760107,
					"content": "¿Así se juega?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "¿Eh? Una aventurera genial me enseñó. También dijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760109,
					"content": "“Kujirai, recuérdalo bien, debes decir: ‘si ganas, obtendrás algo bueno’”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760110,
					"content": "Así que... Si ganas, obtendrás algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760111,
					"content": "#¡Algo bueno, {NICKNAME}! ¡Paimon cree que lo justo es que juguemos con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Sigo pensando que así no se juega con las temari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Debe ser un juego que solo los lugareños conocen. No le prestes tanta atención a los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Tú eres el pequeño Kujirai, ¿cierto? ¡Juguemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Kujirai"
				},
				{
					"id": 721760115,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
