			},
			"dialogs": [
				{
					"id": 747040101,
					"content": "¡Hola, Colombina! ¿Estás admirando los peces de nuestro acuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040102,
					"content": "Ajá. Han hecho un trabajo increíble con este lugar. Hay muchos peces que nunca había visto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040103,
					"content": "¿Habías estado en un acuario antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040104,
					"content": "No, aunque vi algunos tanques de peces en Snezhnaya. Pero en aquel entonces no iba con los ojos abiertos como ahora, así que nunca llegué a apreciar las cosas como debía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040105,
					"content": "¿Y qué te parece ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "Es precioso. No sabía que el mundo submarino fuera tan vibrante y colorido. Es como... vivir en una primavera eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040107,
					"content": "Oh, miren ese pez. ¿No creen que se parece a Sandrone? Y esos dos de allá, uno siguiendo al otro... ¡son igualitos a ustedes dos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040108,
					"content": "#¡Oye, tienes razón! Ahora que lo dices, se parecen mucho a nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040109,
					"content": "Ese que parece tan ocupado me recuerda a Lauma. Y ese que está observando todo en silencio desde el coral parece Néfer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040110,
					"content": "Eh... Parece que te gusta encontrarle el parecido a los peces con tus amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040111,
					"content": "No es eso exactamente. Me gustan mis amigos y por eso pienso en ellos, incluso cuando estoy mirando los peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040112,
					"content": "¡Vaya, Paimon se alegra mucho de oírte decir eso! ¿Hay más peces que te recuerden a otros amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040113,
					"content": "Humm... Últimamente he hecho muchos nuevos amigos, así que me temo que no podré encontrar un pez que se parezca a cada uno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040114,
					"content": "Tiene sentido. ¡De todas formas, seguiremos añadiendo más pececitos al acuario! Deberías volver de vez en cuando. ¡Tal vez la próxima vez encuentres a más de tus amigos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040115,
					"content": "¿Van a meter a mis amigos en el acuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747040116,
					"content": "¡Claro que no! ¡Paimon solo habla de peces que se parezcan a tus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}