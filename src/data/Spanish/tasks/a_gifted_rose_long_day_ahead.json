				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "*Suspira*, todavía no he preparado la comida, así que no tengo mucho que ofrecerles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "No es necesario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Así que esta es tu amiga, qué chiquilla tan linda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "¿Vendrán a ver las flores cuando florezcan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Lo haremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Supongo que tardarán un par de días en florecer. Vuelvan entonces para verlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "No se preocupe, no tengo hambre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
