			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Mira, fíjate en esta semilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "No ha cambiado nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Así es. Llevo años cultivando la tierra, pero cultivar flores parece ser algo completamente distinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Si no, no me explico por qué no han florecido todavía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Deje que Paimon vea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Abuelito, Paimon tiene la sensación de que el jardín está muy seco. Y la tierra no es muy fértil en la Aldea Aaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Ya hemos ayudado antes a cultivar flores, así que tenemos experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Tiene sentido. Estas flores son muy especiales. Puede que no las haya regado y fertilizado lo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Pero el jardín está un poco lejos de las fuentes de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Yo tampoco tengo mucha en casa para mi uso diario, así que no es fácil conseguir agua para regarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Yo le ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Muy bien, entonces te dejaré a ti lo del riego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
