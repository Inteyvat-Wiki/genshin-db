					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "Primero rieguen estas tres semillas. Yo mientras pensaré cómo solucionar lo del fertilizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Trabajé más de diez años en el campo, así que sé cómo preparar fertilizante casero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
	]
