					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "¡Jeje! ¡Dodoco ha derrotado a un montón de soldados globopez cornudos malvados! ¡Ni siquiera los globopeces cornudos son rival para él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "¡Dodoco, Bomba saltarina y Chispas explosivas forman un gran equipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "¡Son imparables!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Este juego le recuerda a Paimon al asunto del Lago de Sidra... ¿Acaso Lisa se basó en eso para elegir la temática del juego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Pero, pensándolo bien, si no encuentran a esos peces invasores... ¿Por qué no dejar que Klee haga explotar por los aires cada uno de los arrecifes? ¿No solucionaría eso el problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "#Si no se ven capaces de solucionarlo, ¡que nos den unas cuantas bombas, que nosotr{F#a}{M#o}s nos encargamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Formarías buen equipo con Klee, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Humm, parece que están disfrutando del juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "¡Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "¡Por fin te dejas ver por aquí, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "El juego que has diseñado es muy divertido. ¡Nos lo hemos pasado muy bien jugando con Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Me alegro de que les haya gustado. Humm... ¿Debería introducir alguna actualización?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "¡Sííí! ¡Klee quiere más historias sobre las aventuras de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "No, espera... Klee recuerda que estuviste muuucho tiempo preparando este juego. ¡Seguro que es agotador! No está bien que te demos tanto trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Oooh, qué considerado por tu parte, Klee. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Pero si te gusta este juego y hace que te quedes jugando tranquilamente en la ciudad, no importa cuánto tiempo me lleve, estará bien invertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "Por supuesto, entiendo que lo que más te guste sea salir libremente de aventuras, pero mira este juego como un simple pasatiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "#Pero bueno, a lo que iba. Les traigo buenas noticias, además de un regalo para ustedes, querid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "¡Un regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "#¡Yo también tengo un regalo para {F#la}{M#el} Caballer{F#a}{M#o} Honorari{F#a}{M#o} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Antes de pasar a los regalos, dejen que les cuente las buenas noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "¿Se ha solucionado el problema del Lago de Sidra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "En efecto. Dos caballeros de la Compañía de Investigación encontraron el nido de las especies invasivas y se encargaron de él en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "Los caballeros también han averiguado la causa de la invasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "El incidente lo ocasionó un descuido de una comerciante. No lo hizo con mala intención, así que los caballeros solo le dieron una charla y le hicieron pagar la multa correspondiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "*Suspira*... Menos mal que no ha ocurrido nada malo. Aun así, ¡Paimon cree que esa comerciante fue demasiado descuidada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "¡El agua del Lago de Sidra está a salvo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "¿Es ya la hora de los regalos? ¿Puede empezar Klee con el suyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Tengo curiosidad. Últimamente, Klee ha estado volviendo pronto a casa sin que nadie se lo recuerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "He estado leyendo un libro de Albedo para aprender a construir cosas por las noches, ¡y he hecho esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "¡Tachááán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "¡Guau! ¡Es Dodoco con una Bomba saltarina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "¡Sí! ¡He hecho esta figura basándome en el Dodoco de las Dodoaventuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Aunque no puedo hacer que este Dodoco lance Bombas saltarinas de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "¡Espero que ver esta figura te recuerde al tiempo que hemos pasado juntos jugando y haga explotar tus problemas y el aburrimiento por los aires!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "¡Un muñeco de Dodoco! ¡Qué sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "¡Así podremos ver a Klee y a Dodoco en cualquier momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "¡Muchas gracias, Klee! Es un regalo muy creativo y considerado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "¡Jeje! ¡Me alegro de que les guste mi regalo! ¡El esfuerzo ha valido la pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "¿Cuál es tu regalo, Lisa? ¡Quiero saber qué es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Bueno, me temo que mi regalo no es tan creativo como el tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "Es un libro de aventuras de las Dodoaventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "¡Un libro de aventuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "¡Un libro entero de historias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "¡Las dos monadas regresan a Mondstadt y unen fuerzas con Klee en su aventura con Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "#Junt{F#a}{M#o}s derrotan a los malvados soldados globopez cornudos, y tomaron felizmente el té por la tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Es el mejor final para las Dodoaventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "¿Has pensado en la historia entera cuando diseñaste el juego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "#No. En esta historia ustedes tres son l{F#a}{M#o}s protagonistas, así que su papel es fundamental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Había reservado un lugar especial en el libro para una ilustración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "#Pero se me ha ocurrido una idea mejor. Ya que estamos tod{F#a}{M#o}s aquí en una ocasión tan especial, ¿por qué no nos tomamos una imagen junt{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "#¡Claro! ¡Hemos visto a nuestras amigas y hemos jugado junt{F#a}{M#o}s! ¡Es un momento digno de recordar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "¡Tomémonos esa imagen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#¡Vamos, Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¡Aquí, aquí! ¿Estás lista, Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360163,
					"content": "Me lo he pasado muy bien hoy. Tres, dos, uno... ¡Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360161,
					"content": "¡Hay que atesorar los pequeños placeres de la vida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "#¡Ahora, Klee y Dodoco estarán siempre con nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "¡La industria vitivinícola de Mondstadt está a salvo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "¿Klee ya puede salir a jugar fuera de la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "Nada de bombas para ti, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "¡Toma eso, pez malo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
}