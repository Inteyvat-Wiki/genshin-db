						751380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380104,
					"content": "¿Tú también viste a alguien raro en el Tonatiuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380105,
					"content": "Grrr... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "Paimon no entiende, ¿eso es un sí o un no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380107,
					"content": "Gruuu... ¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "Ay, ¡Paimon no te entiende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380109,
					"content": "#Lo importante es que {REALNAME[ID(2)|SHOWHOST(true)]} está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "Sí, pero ¿y Bona? ¿Dónde estará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380111,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "¿Se separaron? ¿O acaso Bona...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380113,
					"content": "Tal vez Bona solo era el personaje de una historia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "Humm, puede ser. Al fin y al cabo, la gente normal no vive cientos de años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380115,
					"content": "Al menos terminamos la aventura que ella no pudo acabar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "Sí, y también le prometimos que le contaríamos a la gente esta aventura. Cuando todo el mundo sepa que encontramos el Tonatiuh, Bona se convertirá en una aventurera superfamosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380117,
					"content": "Nuestra aventura aún no ha terminado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "Aún nos queda ir a ver a esa persona al volcán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "Llegaremos hasta el fondo de todo esto y veremos a esa persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380120,
					"content": "¿Crees que ese tipo podría ser el Sabio Robafuegos? No hemos dejado de encontrar mensajes y pistas sobre él, ¡así que Paimon ya tiene mucha curiosidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380121,
					"content": "Pero si dijo que ha estado adoptando diferentes identidades, podríamos habérnoslo encontrado y no haberlo reconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380122,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#Tú también tienes curiosidad, ¿eh, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380124,
					"content": "#Ahora que tenemos ambos amuletos, ya podemos ir al volcán con {REALNAME[ID(2)|SHOWHOST(true)]} para descubrir el gran secreto y quitarle la maldición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380125,
					"content": "Perdón, Bona, pero tenemos que llevarnos el Disco Dorado de la Diplomacia. ¡Te lo contaremos todo una vez que hayamos entendido lo que pasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
