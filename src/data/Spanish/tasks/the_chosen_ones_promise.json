					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#¡Qué bien! {NICKNAME} estuvo en... Humm, Paimon no sabe cómo explicarlo... Bueno, el caso es que te vio en un sueño junto a un tipo muy extraño.",
					"roleType": "TALK_ROLE_NPC",
