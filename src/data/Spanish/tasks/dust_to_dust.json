	"talks": [
		{
			"id": 100396,
			"completionStepIds": [
				101801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "¡Al fin volvieron! ¿Cómo les fue en el Desfiladero Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031802,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031806,
					"content": "¿Qué? ¿No lograste ver a todos los Adeptus? Como dicen, depende del destino, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031807,
					"content": "¡No hay problema! Si no tienes otra cosa que hacer, puedes probar tu suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031808,
					"content": "Además, el informe sobre el Gran Cazador de Demonios es de mucho valor. Como recompensa por tu información, yo también tengo algo que compartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031809,
					"content": "La actitud de las Siete Estrellas ante la muerte de un dios... Da mucho que pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031810,
					"content": "Declararon que, debido a que no se había encontrado al verdadero asesino, a nadie se le permitirá rendir homenaje a la Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031811,
					"content": "Han intentado detener los rumores, pero con tantos asistentes al Rito del Descenso, ni siquiera las Siete Estrellas pueden evitar que estos se difundan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031812,
					"content": "¿Dijiste “Exuvia”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Es bien sabido en Liyue que Rex Lapis también es un Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031814,
					"content": "El Arconte Geo es el Patrono de los contratos, y también es considerado como la Exuvia, el Adeptus Primigenio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031815,
					"content": "En ese entonces, todos los poderosos e iluminados Adeptus pactaron para proteger Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031816,
					"content": "Entonces, no es de extrañar que estén tan preocupados por el bienestar de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Así es. Ellos son responsables y los más aptos para llevar a cabo esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031818,
					"content": "Si llegara a haber un problema con las Siete Estrellas que controlan Liyue, tienen la autoridad para tomar medidas punitivas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031820,
					"content": "Pienso igual que tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Su forma de actuar me parece inaceptable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Si el alma del Arconte Geo asciende a los cielos, ¿por qué las Siete Estrellas resguardan sus restos? Es muy sospechoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031822,
					"content": "¡Así es! ¡Él es la razón por la que estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Si las Siete Estrellas de Liyue están escondiendo la Exuvia y no dejan que nadie se acerque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#¡La misión de {NICKNAME} de encontrar a Los Siete habrá llegado a su fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "No tiene nada que ver contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Sin comentarios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Oh, ¿estás buscando a Los Siete? Si puedo preguntar, ¿con qué fin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031828,
					"content": "Jeje... buena respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031829,
					"content": "#{F#Una}{M#Un} caballer{F#a}{M#o} que se deja engañar fácilmente por los Fatui no sería {F#una}{M#un} {F#buena}{M#buen} caballer{F#a}{M#o}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031830,
					"content": "Aun así, también puedo ayudarte con eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031831,
					"content": "¿Eh? ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Dame algo de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031833,
					"content": "Necesito tiempo... para encontrar a una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031834,
					"content": "Encontraré a alguien que pueda sacarte de este callejón sin salida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031835,
					"content": "Es realmente fascinante. Mientras más intentan contener la situación, mayor es el caos que emerge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10031836,
					"content": "Si quieren quedarse a ver cómo se cae todo a pedazos, es mejor que sobrevivan hasta que nos volvamos a encontrar ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
