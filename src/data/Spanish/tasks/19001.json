			"dialogs": [
				{
					"id": 190010101,
					"content": "Espero que la hermana Bárbara esté bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010102,
					"content": "¿Le ocurrió algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "La hermana Bárbara dijo que iría a recoger hierbas medicinales, pero no ha vuelto desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010104,
					"content": "*Suspira*, quizás deba informar a los Caballeros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010105,
					"content": "¡Iré a buscarla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "#¿Tú? Oh, supongo que {F#la Caballera Honoraria}{M#el Caballero Honorario} está a la altura de esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010107,
					"content": "Además, me ahorraría la molestia de informar a los Caballeros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010108,
					"content": "Está bien, lo dejo en tus manos. Antes de que la hermana Bárbara se fuera, dijo que se dirigía al Reino de los Lobos a recoger algunas hierbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010109,
					"content": "Puedes comenzar buscándola por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
