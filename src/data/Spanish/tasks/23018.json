			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Estas medicinas son para Gurgen. Debería estar en el invernadero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Lleva días trabajando muy duro, así que parece que se ha dislocado el brazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Llévale las medicinas y dile que se quede en casa descansando y rezando a la Arconte. El trabajo puede esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Ven a verme cuando le hayas entregado las medicinas. Te daré el pago por tus servicios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "¿Que rece a la Arconte Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "¿Cómo va a hacernos caso si no mencionamos a la Arconte? Tú solo díselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301803",
							"2"
						],
						"stepId": 2301803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180301,
					"content": "¿Eh? Esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Es tu medicina. Quédate en casa y rézale a la Arconte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "*Suspira*, muchas gracias. Así que rezarle a la Arconte... Sí, supongo que debería hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180304,
