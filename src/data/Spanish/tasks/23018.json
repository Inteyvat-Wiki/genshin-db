			"dialogs": [
				{
					"id": 230181601,
					"content": "Aquí estás. ¿Cómo ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Me dijo que llevaba varios días sin comer carne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "¡¿Qué?! ¡La idea era que comiera más ligero, no que dejara de comer carne por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Tal vez quiera recibir muchas más bendiciones de la Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "En fin, ya pensaré en otra cosa para hacer que se tome las medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "De todas formas, gracias por tu ayuda. Aquí tienes el pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
		},
