				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*Suspira*. No me dan más que preocupaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "¿Puedo ayudar en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Últimamente estamos muy escasos de personal. Hace días que no tengo ni un respiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "#Viajer{F#a}{M#o}, si no estás muy ocupad{F#a}{M#o}, ¿podrías llevarle estas medicinas a los pacientes? Ya de paso, pregúntales qué tal están.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Yo te ayudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Cuento contigo. A la Arconte Dendro pongo por testigo, necesito que alguien que no se pasa el día hablando de bendiciones me eche una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "¡Ja! A la Arconte Dendro pongo por testigo... Parece que me he acostumbrado a decir esa frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Deberías descansar un rato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Imposible. Tengo varios pacientes graves que requieren de mi atención. Tengo que ocuparme de su medicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "*Suspira*. Seguro que me preguntarán de nuevo cómo pueden recibir las bendiciones de la Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "#Cuento contigo, viajer{F#a}{M#o}. Realmente me vendría bien que alguien que no se pasa el día hablando de bendiciones me eche una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Humm, tú eres {F#una viajera}{M#un viajero}, ¿verdad? Bienvenid{F#a}{M#o} al bimaristán, un hospital donde apoyamos a todo el mundo... difundiendo las bendiciones de la Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Atendemos a todo aquel que lo necesite, sin importar su condición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Pero precisamente por eso, últimamente hemos recibido una cantidad ingente de pacientes. Nos falta personal para atender a tanta gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "*Suspira*. Puede que la magnanimidad de la Arconte Dendro sea infinita, pero el presupuesto y los recursos humanos no lo son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Algunos de nuestros pacientes no tienen el más mínimo interés por seguir nuestros consejos. Solo se interesan por recibir lo antes posible la bendición de la Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Jaja, las bendiciones de la Arconte Dendro... ¡Por el amor de Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Si la Arconte Dendro pudiera repartir sus bendiciones tan fácilmente, ¡los pacientes no estarían enfermos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "*Suspira*. Lo lamento, no debería hablar así. No se lo digas a Golshan. Si se entera, no dejará nunca de sermonearme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "¿Es que no eres un fiel creyente de la Arconte Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Claro que lo soy. ¿Quién no lo es en la Ciudad de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Aunque yo sustituiría la palabra fiel por racional. Sí, soy un creyente bastante racional, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "*Suspira*. Ya estoy otra vez. Lo siento. Supongo que estoy agotado, así que no me hagas mucho caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Algunas personas dicen que el proceso de curación en sí mismo es precisamente la bendición de la Arconte Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*Suspira*. Tú no hagas mucho caso de lo que te digan. Los pacientes se toman estas cosas demasiado en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Si la Arconte Dendro fuera omnipotente como ellos dicen, curaría a los pacientes de un plumazo con unos simples champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
