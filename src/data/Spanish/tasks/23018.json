				{
					"id": 230181801,
					"content": "¿Qué es eso? No debería, pero es que huele tan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181802
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181802,
					"content": "Lo cierto es que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181803
					]
				},
				{
					"id": 230181803,
					"content": "¿Qué? ¿Comer ligero no quiere decir que deje de comer carne? ¿Incluso los eruditos de la Academia de Sumeru comen así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "¡C-conque así es! Pensé que si comía carne, la Arconte Dendro se enfadaría conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Si hasta los eruditos comen carne, entonces me siento más tranquilo. ¡Te lo agradezco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
				}
			]
		},
