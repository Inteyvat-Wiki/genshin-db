			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#¡Nos encontramos de nuevo, {NICKNAME}! Y... humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Por cierto, ¿esta pequeñina voladora está a la venta? Es fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "¿Estás bien...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "¡Es obvio que no! ¿Cómo puede olvidarse de las cosas tan rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "¿De qué están hablando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Pff... ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "¿...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "¡Ajaja! *Ejem*, ¡jajaja! ¡Deberían verse las caras! ¡Pff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Basta, basta... lo siento... es... ¡Jajaja! ¡Es mi broma favorita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "¡No tiene nada de gracioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "No entiendo tu sentido del humor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "*Ejem*, está bien, está bien, no más bromas. Lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "En serio, ¡Paimon pensaba que un aventurero así de famoso sería una persona más seria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Jaja, no te quedes con esa impresión de los aventureros. El Gremio de Aventureros es conocido como un grupo de bichos raros. Me atrevo a decir que soy una persona “normal” para ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "... Solo por un pelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Gracias por los hongos de todos modos. De momento no han hecho efecto... Quizás hay que consumirlos por mucho tiempo o tal vez no tienen propiedades medicinales en absoluto. Sea como fuere, no saben mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "No puedo comerlos todos, tengo que guardar unos pocos para que mi amigo de Sumeru investigue su valor medicinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Paimon tiene la impresión de que lo olvidarás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "*Ejem*, en fin, volviendo al tema, ¿ya fueron a buscar los murales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Aquí están las imágenes que pediste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "¡Oh, no me alcanzan las palabras para expresar lo agradecido que estoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Humm... Interesante, muy interesante. ¿No han encontrado más murales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Estos son todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Eso es incluso más interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Los habitantes de la Isla Tsurumi adoraban a un ave monstruosa que dominaba el elemento Electro, y su civilización se centraba en rituales y otros asuntos ceremoniales relacionados. La mayoría de las personas que conocen algo de historia no refutan esta postura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Pero en los murales que me has mostrado no hay rastro del Ave del Trueno. Lo que la gente adora es otra cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "El sol, la luna, las estrellas... y esos símbolos extraños... Tal vez los nativos de la Isla Tsurumi tenían un cierto nivel de desarrollo antes de que llegara el Ave del Trueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Más allá de eso... la niebla y la luna, las estrellas y la oscuridad... No tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Es mejor no abusar de tu cerebro... La memoria ya te está fallando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "... Oh, lo siento. Estaba tan absorto en mis pensamientos que olvidé que ustedes estaban aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Gracias de nuevo por su ayuda. Ya tengo suficiente material para el resto de mi diario... ¡Y no me olvidaré de mencionar sus nombres si tengo la suerte de que un historiador me tome en serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "#Muy bien, creo que es hora de que regrese a informar al gremio. Siento haber ocupado tanto de su tiempo. ¡Espero verl{F#as}{M#os} de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Qué tipo tan ocupado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah, sí, algo más. No es importante, pero espero que puedan ayudarme a buscar a alguien. Es ese niño que mencioné antes, cuyo nombre era... ehmm... Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Ah, sí, Ruu. Ese era su nombre. Esta vez le traje unas cosas para que las pruebe... Espero que aún estén frescas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Desde la última vez que vine, no he dejado de pensar en ese niño. Es difícil de imaginar que haya podido tener una vida fácil en una isla tan peligrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Muy bien, ya no l{F#as}{M#os} molestaré más. ¡Nos veremos en la próxima parada de nuestros respectivos viajes! ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Estos son todos los que encontramos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Supongo que es la forma en que los olvidadizos hacen que el mundo sea más llevadero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "¿Funcionaron los hongos fluorescentes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "¡Eso! ¿Por qué sigue empeorando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}