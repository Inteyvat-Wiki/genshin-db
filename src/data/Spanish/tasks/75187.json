			"dialogs": [
				{
					"id": 751870101,
					"content": "#No tiene un patrón en forma de llama en los cuernos... No es {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870102,
					"content": "Eh... ¿De dónde ha salido este pequeñín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870103,
					"content": "El huevo de saurio de Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "¡Oh, así que es el huevo de saurio de entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870105,
					"content": "¿Gruuu? ¿Grrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Aguará"
				},
				{
					"id": 751870106,
					"content": "Paimon no esperaba que saliera un Tepetlisaurio de ese huevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870107,
					"content": "Paimon recuerda que la persona que protegía este huevo le dio un nombre... ¿Entonces este pequeñín se llama Aguará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870108,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Aguará"
				},
				{
					"id": 751870109,
					"content": "¡Oh, parece que reconoces tu nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870110,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguará"
				},
				{
					"id": 751870111,
					"content": "#Es como {REALNAME[ID(2)|SHOWHOST(true)]}, no tiene hogar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#¡Ven con nosotr{F#a}{M#o}s entonces! ¡{NICKNAME} y yo somos expert{F#a}{M#o}s en entablar amistad con Tepetlisaurios, jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Aguará"
				},
				{
					"id": 751870114,
					"content": "¡Jeje, Paimon sabía que estarías de acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870115,
					"content": "Le atas un pañuelo tal y como hiciste una vez con tu antiguo compañero.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "¡Perfecto! ¡El último saurito que llevó un pañuelo así acabó convirtiéndose en alguien increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870117,
					"content": "¡Aguará! Paimon espera... ¡Paimon espera que tú también crezcas sano y fuerte, como él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
