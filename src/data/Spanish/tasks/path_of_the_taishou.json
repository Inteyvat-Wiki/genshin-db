			"dialogs": [
				{
					"id": 400230101,
					"content": "#¡Viajer{F#a}{M#o}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230102,
					"content": "Les expliqué la situación a los de la Comisión Tenryou y les mostré los documentos originales. Al final, creyeron que tanto la Cámara Mística Onmyou como yo somos inocentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230103,
					"content": "¡Bien! Eso significa que puedes concentrarte en tu misión, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230104,
					"content": "Así es. Ya restauré la Cámara Mística Onmyou a su estado original, un dominio dedicado al entrenamiento de las artes marciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230105,
					"content": "Con el tiempo, la magia de este dominio se podría ir agotando. Cuando llegue ese momento, lo cerraré y dejaré que su poder se vaya recargando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230109,
					"content": "Ahora podría ser un buen momento, ¿se atreven a enfrentarse al desafío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230106,
					"content": "#¡Estoy list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "¡Sí! ¡Paimon también se une!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230107,
					"content": "¡Vamos!",
