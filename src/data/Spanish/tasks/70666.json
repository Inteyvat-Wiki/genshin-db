			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Príncipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "#¡Miau! (¡Miauravilloso! ¡Felicidades! Has superado el duelo de ascensión. ¡Ahora eres {F#una invocadora experimentada}{M#un invocador experimentado}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660202,
					"content": "¿Miau? (¿Eh? ¿Solo hace falta superar un reto para convertirse en invocador experimentado? Bueno, supongo que es porque la mayor parte de los jugadores solo juega por diversión y no se lo toma en serio...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660203,
					"content": "(Solo unos pocos son capaces de probar su determinación en el juego. Aunque sea un entretenimiento, también requiere dedicación y esfuerzo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660204,
					"content": "¡Miau! (¡Ah, sí! Ahora que te has ganado mi reconocimiento, podrás participar en las partidas de otros jugadores que haya en la taberna. Seguro que acaban por apreciar tu compañía.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660205,
					"content": "¿Los demás jugadores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Miau. (Así es. Al igual que yo, son gatos. Aunque no deberías subestimarles.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660207,
					"content": "¡Miau! (Cuando llegue el momento, Shuyun sujetará las cartas en su lugar. Y bien, tal y como marca la tradición, ¡aún tengo algo que decir!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660208,
					"content": "#({NICKNAME}, ¡que la juerga te acompañe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Príncipe"
				}
			]
		},
