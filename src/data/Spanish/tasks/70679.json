			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "¡Hola! ¡Hola! ¡Qué coincidencia! Nos volvemos a encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Perdón, tú eres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "¡Soy Gygax! De «Cazadores y rebeldes», ¿me recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "¡Así que eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "¡Ahora lo recuerdo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Tu expresión me dice que sigues sin acordarte de nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "De todos modos, mira esto. Seguro que recuerdas «Cazadores y rebeldes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "La última vez me ayudaste a probar el juego y me diste algunos consejos para mejorarlo, ¿cierto? Tuve en cuenta la mayoría de tus ideas, eran muy buenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Basándome en las reglas y modos de juego que había, llevé a cabo ciertas optimizaciones. Bueno, varias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Espero que ahora no sea más complicado de entender...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "No te preocupes, estoy convencido de que te encantará el nuevo modo de juego. Te explicaré cómo se juega en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "En esta nueva edición de «Cazadores y rebeldes», es la primera vez que incorporo unas cosas llamadas “señalizadores”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "¡Basta con que los rebeldes activen 4 de estos señalizadores para derrotar al cazador y ganar la partida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Por su parte, el cazador seguirá haciendo lo mismo: atrapar a todos los rebeldes para ganar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Sin embargo, en esta edición de «Cazadores y rebeldes», si el rebelde es atrapado, no será directamente eliminado, sino que entrará en un “área de vigilancia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Después de un tiempo o si otros rebeldes le ayudan, la persona que fue atrapada podrá escapar del área de vigilancia y seguir compitiendo contra el cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Ahora bien, si el cazador vuelve a atrapar a un rebelde al que ya atrapó una vez, dicho rebelde no podrá seguir jugando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Suena un poco complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Que no te abrumen las reglas, lo habrás captado bien cuando hayas jugado un par de partidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "¡Echemos una partida entonces!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "¡De acuerdo! Ven por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "No pasa nada. Vuelve cuando quieras, yo estaré por aquí un tiempo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Cuántas reglas nuevas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "No habrás agregado ningún modo de juego raro, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Ya caigo... ¡Eres el tipo de «Cazadores y rebeldes»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "¡Me llamo Gygax! Pero me alegro de que «Cazadores y rebeldes» sea más conocido que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}