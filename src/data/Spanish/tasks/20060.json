				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "La medicina está lista, pero este medicamento solo trata los síntomas, no la enfermedad. Si quiere curarla por completo, deberá tomar la medicina para siempre y no dejarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Se lo he dicho muchas veces, pero no me escucha. Siempre dice “está bien así”, nadie puede persuadirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "De acuerdo, llévaselo al señor Tunner lo más pronto posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "De nada, solamente cumplo con mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Perdón por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "No es nada. ¡Oh! Si hubiera alguien que pudiera cuidar del señor Tunner, no tendría que estar tomando medicina todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
