			},
			"dialogs": [
				{
					"id": 200600901,
					"content": "¿Cuándo se irá esta enfermedad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600902,
						200600904
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600902,
					"content": "Aquí tienes el medicamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600903
					]
				},
				{
					"id": 200600903,
					"content": "Oh, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600907
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600907,
					"content": "¡Qué vergüenza! Mi hijo está allá fuera luchando, y yo no puedo hacer nada para ayudarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600908,
					"content": "Lo único que puedo hacer es no molestar a mi hijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600909
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600909,
					"content": "Por cierto, por favor, acepta esto. Es el humilde agradecimiento de un pobre anciano.",
					"roleType": "TALK_ROLE_NPC",
