			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Em... ¡Hola! Veo que llevas flores dulces contigo. Puede que sea un poco repentino, pero ¿puedo comprarte una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Mi padre no deja de toser. Le pedí a Jilliana un remedio para la tos, pero me dijo que no tenía suficientes ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Yo también voy por medicamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "¿De verdad? De acuerdo... olvídalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Perdón por retenerte. Apresúrate y ve a la Catedral. La hermana Jilliana todavía está allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Encontrar flores dulces no debe ser tan difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "¿Eh? Oh... Lo sé, pero tengo que vigilar la puerta. No puedo alejarme de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Incluso tuve que tomarme un tiempo de mi almuerzo solo para ir a ver a Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Bien, parece que también estás en camino de entregar medicamentos. No tomaré más de tu tiempo. Si llegas pronto a la catedral, Jilliana aún debería estar allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
		{
