			"dialogs": [
				{
					"id": 200600301,
					"content": "Deberían ser suficientes, vamos a buscar a la <color=#00E1FFFF>hermana Jilliana</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
