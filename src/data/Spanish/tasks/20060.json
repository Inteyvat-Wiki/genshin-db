			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "#Saludos, estimad{F#a}{M#o} client{F#a}{M#e}. ¿Conoce a mi hijo, Guy? *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Estoy bien, el mismo problema de siempre, nada de qué preocuparse. Simplemente no hay forma de curarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "He ido a la <color=#00E1FFFF>Catedral</color>, y las hermanas no me pudieron curar, solamente me recetaron paliativos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "¡Ay! Estoy muy viejo, ya no puedo caminar tanto. Solía pedirle a Moke y Hillie que fueran por mis medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Pero hoy tenían algo que hacer... *Cof*, así que se lo pedí de favor a la <color=#00E1FFFF>señorita Jilliana</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Siempre y cuando cuente con los materiales, ella puede preparar la medicina. Solo necesito <color=#00E1FFFF>tres flores dulces</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*Cof, cof*, te lo pido, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Son solo tres flores dulces. Ve a la Catedral y busca a la hermana Jilliana, y <color=#00E1FFFF>no dejes que Guy se entere.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Escuché que la Catedral también está relacionada con los Caballeros de Favonius. Mi hijo es uno de ellos, así que, por favor, ten cuidado con lo que digas o hagas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Que los dioses no permitan que termine haciendo algo tonto a causa de su viejo. Eso sería terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Perdón por tener que escucharme por horas y horas, apresúrate y ten cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Podría pedirle a tu hijo, Guy, que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "*Suspira*, si el muchacho quiere salir a luchar contra los monstruos, ¿quiénes somos nosotros para interponernos en su camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
