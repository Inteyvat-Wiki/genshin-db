				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "Un momento... Creo que es suficiente con las flores dulces que tenemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200600402,
					"content": "¿Quieres ir directo con la <color=#00E1FFFF>hermana Jilliana</color>? ¿O quieres buscar más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006005,
			"completionStepIds": [
