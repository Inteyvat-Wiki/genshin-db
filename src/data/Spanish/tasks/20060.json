				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "Ese Tunner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600702,
					"content": "Vine por una medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "¿Eh? Moke y Hillie no vinieron el día de hoy. ¿A qué viniste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600704,
					"content": "¿Tienes todos los materiales? Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006009",
							"2"
						],
						"stepId": 2006009,
						"stateName": "QUEST_STATE_UNFINISHED"
