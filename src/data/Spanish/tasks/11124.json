			"dialogs": [
				{
					"id": 111240101,
					"content": "Esta estela fue erigida por Moldeador de Montañas. En ella, describe a Azhdaha como un temible dragón, y sirve como advertencia para que las generaciones posteriores se mantengan alejadas del sello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "Es una pena... La línea que separa el bien del mal es muy delgada. Si una oración puede resumir el bien y el mal que vivían en él... es esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Observas en silencio a Zhongli de pie bajo la sombra del árbol...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(En medio del silencio, solo se escucha una suave brisa. El tiempo parece transformarse en un río invisible que gotea lentamente...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Un momento fugaz, mil años en el mundo mortal. La roca lo siente, al igual que la tierra y los dioses.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
