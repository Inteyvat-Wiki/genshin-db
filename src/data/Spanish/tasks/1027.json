					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "Eso es, quiero echar otro vistazo. Y esta vez, yo, Itto, el ónico e inimitable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "¡Jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "¡Guau! ¿Qué pasa, refunfuñona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "Ya va siendo hora de una buena calavanda asada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "¿Eh? ¿Estamos en una situación de vida o muerte aquí abajo y tú estás pensado en calavanda asada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "¡Muuu! Muuu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "¿Has oído eso? Ushi dice que tienes toda la razón... Espera, ¿de qué lado estás, torito guapo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Muuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "Es importante reponer fuerzas. Debemos mantener nuestras energías y la mente listas para enfrentar lo desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Hasta Ushi lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Está bien, ustedes dos... ¿Eh? ¿Ya están comiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Esperen, ¿todavía está caliente? Oh, qué bien huele eso... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "De acuerdo, entonces primero comeremos algo rápido y después seguiremos pensando una solución. ¡Oigan, no se lo coman todo! ¡Déjenme un poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 102702,
