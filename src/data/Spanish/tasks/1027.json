			"dialogs": [
				{
					"id": 10280701,
					"content": "Nuestra situación actual es funesta. No parece que vayamos a encontrar una salida por ahora. Deberíamos mentalizarnos de que permaneceremos aquí durante un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Por suerte, parece que no nos faltarán provisiones, y en un equipo tan variopinto como el nuestro, tampoco faltará quien sepa encarar los momentos críticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Solo concéntrense en cuidar de sí mismos, yo me encargaré del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		}
