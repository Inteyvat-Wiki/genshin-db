			"dialogs": [
				{
					"id": 223060301,
					"content": "Sí, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060302
					]
				},
				{
					"id": 223060302,
					"content": "Bien, te marcaré los lugares ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060303,
					"content": "Después de que encuentres los tesoros, no olvides regresar para repartirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
