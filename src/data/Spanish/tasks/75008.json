			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "¡Manqu, ya estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Ay, ¡qué larga se me ha hecho la espera! A decir verdad, tenía el alma en vilo de lo preocupado que estaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "Aunque fui yo quien propuso todo esto, jamás me perdonaría que no hubieran vuelto de las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Pero, bueno, si me permiten ir directo al grano... Encontraron el amuleto que el Sabio Robafuegos dejó en las ruinas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "Sí, aunque fue muy complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Sabía que lo lograrían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "¡Resultó ser esta cosa similar a un disco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "Oh, un Disco Dorado de la Diplomacia... Conque los discos legendarios existen de verdad. Genial, lo anotaré en los resultados de mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Así que esta cosa se llama “Disco Dorado de la Diplomacia”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "S-sí. Ay, disculpen que me emocione tanto, pero dicen que este objeto pasó por las manos del mismísimo Sabio Robafuegos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "Por un momento, me he preguntado si podría quedármelo como una especie de reliquia familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#¡De eso nada! Lo necesitamos para salvar a {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Lo sé, pero... solo tenía pistas de cuál podía ser el paradero de este amuleto. El otro no tengo ni idea de dónde puede estar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "En Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Oh, disculpa, {NICKNAME}, ¿has dicho “Ochkanatlan”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "Explicar lo que viste al tocar la estela",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Vaya, así que está en Ochkanatlan... Eso se encuentra al norte de la Tribu Plumaflora, en las ruinas de una antigua ciudad que hay al otro lado del mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "#En ese caso, me van a tener que disculpar, pero no puedo ayudarl{F#a}{M#o}s. Ochkanatlan es un lugar prohibido para la gente de mi tribu, y aún más prohibido para la Asociación de Arqueología Sáurica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Por lo que sé, hace muchos años, unos miembros de la Asociación de Arqueología Sáurica aceptaron un encargo para ir allí a investigar. Al parecer, lo último que se supo de ellos es que desaparecieron de repente sin dejar rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "Desde entonces, la asociación no ha vuelto a inmiscuirse en ningún asunto relacionado con Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "No te preocupes, ¡lo que nos has contado ya es de gran ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Muchas gracias por toda su ayuda. No saben lo importante que es para mí poder ver en persona un Disco Dorado de la Diplomacia. Tengo que anotar todo esto antes de que se me olvide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#{NICKNAME}, Paimon, de nuevo, muchísimas gracias. Les deseo lo mejor en sus viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#Y en cuanto a ti, {REALNAME[ID(2)|SHOWHOST(true)]}, espero que puedas deshacerte de la marca de la bendición del Maestro de las Llamas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "¡Nos vemos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Sí... Estoy seguro de que volveremos a encontrarnos al final de este viaje, en el lugar donde descansan todas las almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "¡Fue coser y cantar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
