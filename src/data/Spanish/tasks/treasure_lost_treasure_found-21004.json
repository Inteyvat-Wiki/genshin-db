			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Ni los propios dioses pueden escapar del destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Encontré cuatro pistas en cuatro ruinas distintas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Cuatro ruinas, cuatro pistas... El mismo número que los Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Pero cada una de estas inscripciones contiene una clave para comprender el significado de los Cuatro Mandamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Si queremos descifrar el misterio, la clave está en los Cuatro Mandamientos de Guizhong. Estas cuatro pistas son complementarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "“La unión entre estos Cuatro Mandamientos”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "“La unión entre estos Cuatro Mandamientos”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "“La unión”... ¿Quizás se refiere a que hay alguna forma de unir estas cuatro secciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Espera, ya lo recuerdo, estos Cuatro Mandamientos se encuentran cada uno en unas ruinas distintas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Humm... Es solo una suposición, pero quizás las cuatro <color=#00E1FFFF>ruinas</color> son la clave para descifrar el verdadero significado de los Cuatro Mandamientos de Guizhong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Pero no sé exactamente cómo. Tengo que reflexionarlo. Si tienes alguna idea, puedes investigar directamente por tu cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "A final de cuentas, soy una erudita frágil y delicada y, a diferencia de ti, me canso con tan solo dar tres pasos. *Suspira*, envidio tu estado físico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "De acuerdo, me quedaré aquí a investigar los detalles. Si alguna idea se te viene a la mente, o encuentras algo, estaré aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
