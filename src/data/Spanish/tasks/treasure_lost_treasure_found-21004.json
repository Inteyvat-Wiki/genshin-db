					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Marcaré en tu mapa las primeras ruinas que encontré. Es un buen lugar para comenzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "Si encuentras algo, no cometas el error de principiantes de salir corriendo de la emoción. Recuerda <color=#00E1FFFF>anotar la pista</color> primero.",
					"roleType": "TALK_ROLE_NPC",
