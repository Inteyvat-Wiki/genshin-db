				{
					"id": 210049201,
					"content": "Sobre los Cuatro Mandamientos de Guizhong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049202
					]
				},
				{
					"id": 210049202,
					"content": "¿Olvidaste los Cuatro Mandamientos? No hay problema. A decir verdad, son un poco difíciles de recordar, pero por fortuna tengo buena memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049203,
					"content": "Los Cuatro Mandamientos de Guizhong dicen así: “Enseña con sabiduría, gobierna con virtud, mantente firme y únete en la ambición. La unión entre estos Cuatro Mandamientos se conocerá como la «Congregación de Guili»”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
