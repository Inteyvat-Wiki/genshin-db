			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "“Cuatro Mandamientos de Guizhong”... ¿A qué se refiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "#¡Jaja! Estás muy entusiasmad{F#a}{M#o}. De acuerdo, comencemos por leer los Cuatro Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "“Enseña con sabiduría, gobierna con virtud, mantente firme y únete en la ambición. La unión entre estos Cuatro Mandamientos se conocerá como la «Congregación de Guili»”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "A juzgar por este escrito, parecen los mandamientos de la vida diaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Pero en ninguna parte sugiere la existencia de un tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "Veo que no tenemos más remedio... Tendremos que hacerlo a la antigua usanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Las siete inscripciones que descubrimos se encuentran en ruinas diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Ya que no sabemos por dónde comenzar, ¿por qué no seguimos buscando ruinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "¿En dónde deberíamos buscar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Veamos... Si vamos a buscar pistas, sugiero que delimitemos el área de la Llanura Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Pero yo soy solo una erudita, me temo que no puedo seguirte el paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Así que dejo en tus manos la búsqueda de ruinas. Si encuentras alguna pista, regresa a informarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "Por cierto, alguna vez encontré unas ruinas cerca de aquí. En ellas había un disco muy extraño con un escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Pero solo pude hacer un estudio independiente, no he podido cotejarlo con otras investigaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Ahora que lo recuerdo, tal vez ese disco está relacionado con los Cuatro Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "¡Lo tengo! Marcaré la ubicación en tu mapa. Puedes ir a averiguar, quizás encuentres alguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "¿T-todas las ruinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "#Por supuesto que no, si extendiéramos el rango a toda Liyue, ni siquiera nosotr{F#as}{M#os} dos podríamos cubrir todo ese territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Ya que es un tesoro de la Congregación de Guili, en la Llanura Guili, podemos reducir nuestra área de búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Por ahora solo busquemos en los alrededores de la Llanura Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Por cierto, yo soy solo una erudita, me temo que no puedo seguirte el paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Así que dejo en tus manos la búsqueda de ruinas. Si encuentras alguna pista, regresa a informarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "¡Iré a buscar todas las ruinas de Liyue!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "¡Espera! No te emociones tanto, Liyue es enorme. ¿Tienes idea de cuánto tiempo pasarás buscando todas las ruinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "¡Te cambia la expresión con solo oír la palabra “tesoro”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Ya que es un tesoro de la Congregación de Guili, en la Llanura Guili, primero reduzcamos el área de búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Veamos... por ahora hay que limitarnos a buscar dentro de la Llanura Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "¡Oye, no te vayas antes de que termine de hablar! Recuerda, debes buscar las ruinas con cuidado. Si descubres algo, ven a informarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "No lo olvides, solo tienes que buscar dentro de la Llanura Guili, ¡no te desvíes del camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "¡En busca del tesoro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "En cuanto dijiste “tesoro”, brilló tu rostro... En fin, comencemos por leer los Cuatro Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
