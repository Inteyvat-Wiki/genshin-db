						210040902
					]
				},
				{
					"id": 210040902,
					"content": "¿Te vas? De acuerdo. Recuerda, si te encuentras con algo interesante, no olvides contármelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
