			"dialogs": [
				{
					"id": 210049301,
					"content": "¿Quizás fue una lucha territorial entre dioses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049302
					]
				},
				{
					"id": 210049302,
					"content": "¿Lucha territorial? Pero de acuerdo a esto, la Congregación de Guili tuvo una existencia pacífica bajo el gobierno de Guizhong por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049303,
					"content": "Aunque tengo la impresión de que Guizhong no es una diosa muy poderosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049304,
					"content": "Pero la Congregación de Guili no solo hace referencia a Guizhong. También mencionan otro dios. Nadie sería tan tonto como para atacar a dos dioses juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
