				},
				{
					"id": 210042203,
					"content": "Pero si sigo pensando así, no podré hacer ningún nuevo descubrimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
