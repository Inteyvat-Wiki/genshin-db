			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "¿Y bien? ¿Encontraron el tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Sí, estaba en el “punto de unión”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Ya veo... Así que estaba en el “punto de unión entre los Cuatro Mandamientos”, tal y como decían los Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Estoy segura que quien haya creado este acertijo, era un fiel seguidor de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Tanto es así que conservaron los Cuatro Mandamientos de Guizhong para las generaciones futuras, a pesar de que la Congregación de Guili fue eliminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Y en cuanto a la propia Guizhong, quien estableció los mandamientos, debe haber sido adorada por su pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Claramente, deseaba que su gente fuera sabia, se apegara a un código moral, que fuera fuerte y saludable, y que se solidarizaran en la tarea de proteger su hogar: la Congregación de Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Pero fracasó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "¿Tú crees? Supongo que tienes razón, al final, ella murió... y cuando la Congregación de Guili fue destruida, su gente ya no tenía un lugar al que llamar hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Y sin embargo, hoy, los Cuatro Mandamientos de Guizhong han visto la luz del día una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Estas fueron las palabras escritas por Guizhong para servir como máximas y bendiciones para su pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Alguna vez, ella guió a su gente para salir y tomar esta misma tierra, guiada por estos mandamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Puede que ya no esté con nosotros, pero sus creencias, los ideales que defendió, perdurarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Quienquiera que la venerara tanto, era muy inteligente. Usaron el tesoro escondido como anzuelo para asegurarse de que los Cuatro Mandamientos de Guizhong se siguieran transmitiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Aunque me pregunto si para esa persona, el tesoro que apreciaban eran los metales raros y las piedras preciosas, o los Cuatro Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Jaja, bueno, al menos para mí, está claro que los mandamientos son los verdaderos tesoros aquí. Un cofre lleno de oro o gemas no tiene comparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "... Pero si la gente tuviera que elegir, ¿cuántos escogerían una lista de mandamientos sobre la riqueza material?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Parece una diosa de naturaleza gentil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "No estoy segura de que la “naturaleza gentil” sea un rasgo particularmente común entre los dioses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Pero quizás hace mucho, mucho tiempo, entre los dioses que guiaban a los pueblos del mundo, estaban aquellos gentiles por naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Los que protegieron a su gente... caminaron entre ellos... los llevaron de la mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "... Pero fueron los dioses amables quienes finalmente fueron incapaces de proteger a su gente. Miren a Guizhong: tuvo que elaborar una cacería de tesoros complicada solo para preservar los cuatro mandamientos que alguna vez fueron el alma de toda una civilización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Si pudiera conocerla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "¿Quieres conocer a un diosa? Tienes ideas muy locas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Pero tengo curiosidad, ¿qué le dirías a Guizhong si realmente la conocieras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "¿“Ánimo, Guizhong, hiciste lo mejor que pudiste”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Si fuera yo... Creo que recitaría los Cuatro Mandamientos de Guizhong sin problemas de memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Y le diría que su visión y sus ideales están vivos y bien, que la gente de esta tierra todavía recuerda las cosas que enseñó a sus antepasados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Creo que para alguien como Guizhong, quien perdió todo... Eso sería lo único que podría levantarle el ánimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
