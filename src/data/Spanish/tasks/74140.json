			"dialogs": [
				{
					"id": 741401101,
					"content": "Oh, nos volvemos a ver. Ah, ¿esta vez has traído a Paimon contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "#¡Eh! Paimon estaba aquí la última vez que “meditamos” junt{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "¿Ah, sí? Quizás me haya olvidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "En cualquier caso, muchas gracias. Gracias a ustedes pude encontrar la ubicación del espejo, el lugar donde florecen las flores, y he conseguido conocer mejor este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Humm... Canotila, tu forma de hablar está confundiendo a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "¿Eh? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "De acuerdo, de acuerdo, ya lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(Humm... ¿Qué le está diciendo al perro? ¿Es que las melusinas hablan idioma perruno?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(No me lo puedo creer.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Bueno, qué remedio, hasta la próxima vez que nos veamos. Aunque digas eso, volveré para jugar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#Vámonos, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
