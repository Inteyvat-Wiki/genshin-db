			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Ching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "¡Qué horror! ¿Qué he hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Ching"
				},
				{
					"id": 210070202,
					"content": "Finalmente logré escapar mientras no estaban mirando para poder ser el primero en llegar a la mina y encontrar el tesoro, pero... ¿de dónde salieron todos estos monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Ching"
				},
				{
					"id": 210070203,
					"content": "Qué horror, qué horror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Ching"
				}
			]
		},
		{
