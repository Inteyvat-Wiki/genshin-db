			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Cheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "¡Qué hermanos ni qué nada! Ellos solo piensan en quedarse con las mejores cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "Y papá está perdiendo la cordura ahora que es viejo... O se ha vuelto olvidadizo, o pretende mirar al otro lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Seguramente no saben que el tesoro está en la mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "Tengo que sacar el tesoro pronto, y luego irme lejos, muy lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
		{
			"id": 2100704,
			"completionStepIds": [
				2100713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
