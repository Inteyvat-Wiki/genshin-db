			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Se fueron... todos se fueron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Ching, Yuan Liang, Yuan Cheng... Son unos tontos. Tendrán que pensar más cuidadosamente y mirar más allá que hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Ching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "¡Mira! Son las personas de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "“Un árbol solitario, sin un bosque propio...”. ¡Jaja! Al parecer uno solo no puede resolverlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Ching"
				},
				{
					"id": 210070603,
					"content": "“A las hojas rojas otoñales, que parten solas sin vendavales...” Si tan solo pudiera confiar en mi hermano y en ese anciano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "“A las hojas rojas otoñales, que con una brisa se separaron en su viaje...” El tesoro... todo sea por el tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Un árbol grueso y frondoso da sombra al hogar... Queridos hijos, se supone que somos una familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Ustedes creyeron que escondí el tesoro en un túnel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Pero no hay ningún tesoro... ¿Recuerdan este árbol? Lo plantamos juntos cuando eran pequeños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Yo vine todos los años a enterrar unas cosas. Esperaba que cuando ustedes crecieran pudiéramos desenterrarlas juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Y cuando llegara el momento, podríamos comprar con eso algo de comer, algo de beber, pasarla juntos y hablar de trivialidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Hijos... mis queridos hijos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}