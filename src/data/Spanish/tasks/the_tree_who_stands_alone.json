				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Liang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Jeje... Este tesoro es todo mío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "Mis hermanos son unos tontos. Después de descifrar unas cuantas líneas salieron corriendo, creyendo que resolvieron el acertijo. Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "¿Honrar la voluntad del padre? ¡Bah! Había una línea que valía la pena leer en esa cosa, y es la que menciona el tesoro en la mina. Ese tesoro es mío, ¡mío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
		{
			"id": 2100705,
			"completionStepIds": [
				2100714
			],
