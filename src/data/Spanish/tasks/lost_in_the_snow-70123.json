			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "Hasta ahora, todo va bien. Hay un buen clima, suficientes suministros, los monstruos están tranquilos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "Anotaciones pulcramente escritas"
				},
				{
					"id": 701230202,
					"content": "Además, encontré el volumen VI de «La princesa jabalí» en mi mochila. Joel debe haberlo metido a escondidas. Este chico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "Anotaciones pulcramente escritas"
				},
				{
					"id": 701230203,
					"content": "El libro cuenta el viaje de una valiente princesa jabalí y sus compañeros hacia la cima de una montaña nevada... Y, bueno, yo mismo me encuentro subiendo a la cima de una. Considerando lo bien que está saliendo todo hasta ahora... ¿Quién sabe? Quizás este libro me esté trayendo buena suerte. Gracias, Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "Anotaciones pulcramente escritas"
				},
				{
					"id": 701230204,
					"content": "En fin, ya debería retomar mi camino hacia el siguiente campamento para reabastecerme y registrar mi progreso. Luego bajaré de la montaña porque Joel me está esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anotaciones pulcramente escritas"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "Nada extraño sucedió en el camino hacia aquí. Sigue habiendo buen clima. Parece que mi suerte por fin mejoró.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "Anotaciones pulcramente escritas"
				},
				{
					"id": 701230302,
					"content": "Quizás pueda apresurarme y llegar a la cima después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "Anotaciones pulcramente escritas"
				},
				{
					"id": 701230303,
					"content": "Haré un intento. Si pasa algo, volveré de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anotaciones pulcramente escritas"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "La tormenta de nieve en la cima ocurrió demasiado rápido. Apenas tuve tiempo de meterme en esta cueva. La mitad de mis suministros también se perdió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230402,
					"content": "No sé por qué, pero las rocas sobre la cueva se derrumbaron de repente. La entrada ha quedado sellada. Esto no es nada bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230403,
					"content": "Pero... creo que hay otra salida. El otro extremo de esta cueva es un acantilado, sí, pero debajo no hay nada más que nieve espesa. Si intento bajar una cierta distancia y luego saltar el resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230404,
					"content": "Mis suministros no durarán más que unos cuantos días más. Tengo que actuar pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230405,
					"content": "Le prometí a Joel que lo llevaría a ver la nieve. No romperé esa promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230406,
					"content": "Por cierto, si alguien ve estas notas, por favor, ponga algo de comida para los zorros en ese plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "Anotaciones garabateadas"
				},
				{
					"id": 701230407,
					"content": "Me hicieron compañía todo el tiempo que estuve atrapado aquí. Si tengo la oportunidad, me encantaría traer a Joel para verlos de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anotaciones garabateadas"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
