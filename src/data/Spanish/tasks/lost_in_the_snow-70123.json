				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "¿Y bien? ¿Alguna noticia de papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230502,
					"content": "Esto es lo que descubrimos en la caverna en la cima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "Papá... No, eso no puede ser. ¡Papá es un gran aventurero! Seguro que salió sin dificultades de un problema tan pequeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230504,
					"content": "Dijo que encontró una forma de bajar la montaña en sus apuntes, ¿no? Seguro que está a salvo. ¿Verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230505,
					"content": "Supongo que bajó y está a salvo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "Exactamente. ¡Eso debe ser! Podría estar descansando ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230507,
					"content": "O... podría haber establecido un nuevo campamento en la cima y está descansando allí ahora mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230508,
					"content": "Estoy seguro de que en cuanto termine de descansar, vendrá a buscarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230509,
					"content": "Lo seguiré esperando aquí. Por cierto, gracias por ayudarme. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230511,
					"content": "No encontré nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "¿En serio? Pero ese Caballero de Favonius dijo que papá subió a la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230513,
					"content": "Tal vez se haya equivocado... O tal vez papá instaló un nuevo campamento en otro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230514,
					"content": "Bueno, supongo que lo esperaré aquí... Apuesto a que papá estará muy preocupado si llega a casa y no me encuentra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230515,
					"content": "Gracias por ayudarme. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230516,
					"content": "¿Dónde estarás, papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				}
			]
		},
