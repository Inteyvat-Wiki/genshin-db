			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "¿A dónde fue papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "Ah... Hola, n-no encuentro a mi papá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230104,
					"content": "Dijo que me recogería para venir a la montaña a ver la nieve, pero ya pasó el día que acordamos y no me vino a buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230105,
					"content": "Puede que no haya venido aún porque encontró un valioso mapa del tesoro o algo así. Debe ser eso, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230106,
					"content": "Por eso vine solo a Espinadragón. Si él no podía encontrarme, yo lo encontraría a él... O eso pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230107,
					"content": "Cuando llegué, tampoco encontré aquí a papá. Aquel Caballero de Favonius dijo que se había ido a la cima de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230108,
					"content": "Quería ir a buscarlo yo mismo, pero ese Caballero no me deja. Solo me queda esperar aquí a que papá regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230109,
					"content": "Pero... pero ni siquiera ha dado una señal, estoy muy preocupado por él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230110,
					"content": "Si te diriges a Espinadragón, ¿podrías ayudarme a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230111,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "¡¿Lo harás?! ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230114,
					"content": "Déjame pensar... Según el Caballero de Favonius, papá mencionó que primero seguiría <color=#00E1FFFF>el Camino Nevado hacia la cima</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230115,
					"content": "Después, dijo que iría a <color=#00E1FFFF>la ladera occidental de la montaña</color> para echar un vistazo y, por último, <color=#00E1FFFF>escalaría a la cima</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230116,
					"content": "Por favor, ayúdame a buscar en esas áreas, papá todavía puede estar cerca de alguna de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230117,
					"content": "Me prometió que veríamos la nieve juntos, y él nunca rompería su promesa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230112,
					"content": "¿Dónde debería buscarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		},
		{
			"id": 7012302,
			"completionStepIds": [
				7012302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
