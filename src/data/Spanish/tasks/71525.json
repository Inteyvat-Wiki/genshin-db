				]
			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "¡Fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662102,
					"content": "Veo que la Banda de Arataki ha transformado las peleas de escaradiablos en una competición muy animada. Sí, podrían ser los cimientos de una buena historia que contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662103,
					"content": "Un gustazo combatir contra usted, señor Tian. ¡Tremendo duelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "Se dice “un placer combatir contra usted”, rey oni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716662105,
					"content": "¡Bah, matices! ¡Minucias! Lo importante es... ¡Gracias por su apoyo, señor Tian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Yo también le estoy agradecido, señor Arataki. Tengo pensado quedarme un rato a mirar para así enriquecer mi obra. Por favor, céntrense en el combate. Hagan como si no estuviera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662107,
					"content": "Qué oponente tan elegante. Cuando hablo con él, mi cabeza da vueltas con todas esas palabras, pero quizá sea porque... ¿estoy aprendiendo cosas más allá de las peleas de escaradiablos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "¡Parece que el Ferviente y Radiante Entrenamiento de Escaradiablos de Arataki ha empezado con buen pie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
