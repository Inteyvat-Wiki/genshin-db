					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Hola a todos, soy Tian Lengua de acero. Estoy aquí con el cartel oficial del Ferviente y Radiante Entrenamiento de Escaradiablos de Arataki. Esto también se puede considerar como el permiso para organizar el evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662002,
					"content": "¡Guau! Esta imagen es... ¿Titán Carmesí y toreritto? ¡Se han pasado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "¡Ah, genial! Aunque no sea mi obra maestra... ¡Miren qué composición! ¡Y qué delineado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "¡Qué pasada, gente! ¡Esto es épico! ¡Refleja a la perfección mi grandiosidad como luchador de escaradiablos profesional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "¡Oye, tú!... Ah, espera... ¿Cómo llaman a los extraños la gente de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716662007,
					"content": "¡Eso! Señor Tian, ¡tu ilustración es lo más! En el nombre de la Banda de Arataki, ¡muchísimas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Me halaga, jefe de la Banda de Arataki. Pero yo no soy más que un cuentacuentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662009,
					"content": "Este cartel es obra de cierta señorita del Ministerio de Asuntos Civiles. La señorita Yanfei suele cuidar de ella, así que cuando se enteró de este evento, se ofreció a contribuir con esta obra maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662010,
					"content": "¡Ohh, así que es cosa de Yanfei! ¿Ha pensado incluso en esto? ¡Qué nivel de previsión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "El Gran Maestre Hanakado dijo que el Ferviente y Radiante Entrenamiento de Escaradiablos de Arataki es un ambicioso programa de entrenamiento capaz de marcar un antes y un después en las peleas de escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662012,
					"content": "Yo no soy experto en peleas de escaradiablos, pero he oído hablar de ellas y siempre he querido probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662013,
					"content": "Quién sabe, tal vez me sirva de inspiración para escribir una buena historia que contar en el vecindario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Analista de Movimientos"
				},
				{
					"id": 716662014,
					"content": "Las peleas de escaradiablos son algo que requiere talento, como es el caso de la Onicalavanda Perforacielos. Tan solo fue una pequeña prueba, pero hizo una gran demostración de habilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716662015,
					"content": "En cuanto el señor Tian entienda la diversión de las peleas de escaradiablos, podremos darnos a conocer gracias a sus historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716662016,
					"content": "¡Eso estaría genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Muy bien. Entonces, eh... ¡S-señor Tian, que gane el mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
