			"dialogs": [
				{
					"id": 205200501,
					"content": "¿Encontraste carne congelada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200502,
					"content": "Aquí la tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Excelente. Entonces, ¿esta es la carne congelada? Aparte de estar muy fría, no noto ninguna diferencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Bueno, da igual. Mientras pueda terminar el encargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "#Gracias, viajer{F#a}{M#o}. Todo esto habría sido un desastre de no ser por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "Acepta esta recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
