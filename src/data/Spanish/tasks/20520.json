			"dialogs": [
				{
					"id": 205200101,
					"content": "#V-viajer{F#a}{M#o}... ¿p-puedes a-ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "¿Qué te pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "T-te lo p-pido p-por favor, necesito c-calor... Hace m-mucho f-frío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "O qu-quizás un p-plato caliente s-sirva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "P-por favor, t-tengo mucho f-frío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
