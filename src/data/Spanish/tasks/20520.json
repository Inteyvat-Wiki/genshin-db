			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#Uf... Me siento mucho mejor. Gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "¿Qué demonios haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*Suspira*, vine por un encargo, pero resultó no ser tan fácil como imaginaba. He estado todo el tiempo en este campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Pero no pienso quedarme aquí para siempre, así que pensaba hacer otra cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "El chef Harris estaba buscando a alguien que le ayude a encontrar carne congelada en la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Además, dijo que era suficiente con encontrar un jabalí pequeño congelado, que no era necesario adentrarse en la montaña, así que no había ningún peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Pensé que sería pan comido, así que acepté su encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Además, me había estado preparando con tiempo, ajustándome al clima de Espinadragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "Y también quería terminar el encargo de la señorita alquimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "No imaginé que terminaría congelado al comenzar mi ascenso. Tuve suerte de que me encontraras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Lo único de lo que me arrepiento es que... no podré completar el encargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "#Viajer{F#a}{M#o}, parece que estás familiarizad{F#a}{M#o} con esta montaña. ¿Puedes hacerme un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Te lo ruego, solo necesito que me ayudes a encontrar un trozo de carne congelada. Con uno bastará, es todo lo que necesito para completar el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "¡Excelente! Entonces, déjame marcar en tu mapa las ubicaciones donde Harris dijo que podría encontrar jabalíes pequeños congelados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Bien, entonces iré al campamento en la falda de la montaña y esperaré noticias de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
