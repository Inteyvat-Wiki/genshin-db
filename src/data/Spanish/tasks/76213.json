			"dialogs": [
				{
					"id": 762130101,
					"content": "¿Eh? Parece que esta habitación está bloqueada por un montón de libros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "¿Buscan algún libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130103,
					"content": "Humm... No es eso. Solo tenemos un poquito de curiosidad por saber qué hay ahí dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "Parece que podemos entrar dando un rodeo por el lado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "No se puede entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130106,
					"content": "Yo muevo los libros, yo muevo los libros. Si no es así, entonces no está completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130107,
					"content": "No entendí absolutamente nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Yo muevo los libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130109,
					"content": "¿Qué quieres decir con “mover los libros”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Si los libros no están aquí, entonces alguien debe haberlos movido de sitio. Lo único que hago es echarles un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130111,
					"content": "Entonces, voy a probar con Diestrín.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Ve todo recto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongshen"
				}
			]
		},
