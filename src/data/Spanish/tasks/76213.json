			"dialogs": [
				{
					"id": 762130201,
					"content": "Sueños, ilusiones, burbujas y sombras: ¿por qué esforzarse por comprenderlos? Aunque estudies los principios durante mil años, si mantienes tu mente completamente quieta y “sin nacer”, simplemente no lo entenderás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130202,
					"content": "Entonces... ¿Estás buscando un libro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "¿Has estado aquí antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130204,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Entonces lo entiendes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130208,
					"content": "¿Entiendo... qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Cuando necesites dormir, duerme. Cuando necesites entender, entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130211,
					"content": "Ya deberías volver. Cuando el mundo se acabe, simplemente déjate llevar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongshen"
				},
				{
					"id": 762130209,
					"content": "¿Cómo voy a entenderlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "No entiendo ni jota. ¡Adiós!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongshen"
				}
			]
		}
