			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Hola. ¿Tienes algún mensaje de mi hijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "¿Yo? Mis amigos de la bodega me llaman “el Viejo Tunner”. Soy agricultor aquí en el Viñedo del Amanecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Mi familia ha cultivado aquí por generaciones. La mayoría de los buenos vinos que has probado probablemente fueron fermentados con las uvas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Todos los propietarios de la bodega han tratado a nuestra familia muy generosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Pero no creo que sea bueno para mi hijo heredar esta tierra y convertirse en agricultor para toda su vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "¿Tu hijo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "¡Guy! ¡Mi amado hijo se llama Guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "¿Qué? ¿Nunca has oído hablar de él? Jaja, está bien. Tarde o temprano, lo conocerás. Toda Mondstadt lo conocerá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "¡Mi hijo Guy me dijo que iba a ser el caballero más fuerte de Favonius! Yo creo en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Gasté todo el dinero que tanto me costó ganar por su bien, para darle un futuro mejor que el mío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "¡Guy está decidido a cumplir su sueño! Se convirtió en escudero a los 16 años, por lo que nuestro hogar ha dependido de él desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "¡Adiós! Si te encuentras con mi hijo, Guy, ¡dile que vuelva a casa de vez en cuando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
