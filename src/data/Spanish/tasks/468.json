			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "¿Hay algo en lo que pueda ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "#... Ah, {F#una}{M#un} viajer{F#a}{M#o}. Qué amable de tu parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Ahora es la temporada de maduración de las uvas. Pero una manada de jabalíes salió de la nada y tienen la viña en la mira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "No puedo ahuyentarlos yo solo, y mi hijo no está conmigo ahora, así que lo único que puedo hacer es verlos destruir mi tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "Si puedes ayudarme a echar a esos jabalíes, ¡te lo pagaré generosamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
