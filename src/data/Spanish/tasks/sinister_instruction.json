			"dialogs": [
				{
					"id": 721411101,
					"content": "Ora y escucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "Él es fuerte porque escucha, ve y oye todo porque es fuerte. Y así ve todo lo que hay, y lo oye todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Ni los tontos de Sangonomiya ni los de la isla de Narukami tienen ninguna comprensión ni sentimiento al respecto. Así que lo único que saben es luchar entre ellos y dejar que la sangre ciegue sus ojos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Pero tú debes comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "Esto no tiene sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "La respuesta está en la oración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411108,
					"content": "Recuerda que, si oras tres veces al día, recibirás una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
