					"speakerTitle": "Washizu"
				},
				{
					"id": 721411202,
					"content": "¿Estás bien...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "¡Está enojado y su cólera será terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "¿Y por qué? ¡Por esa mujer! ¡La que se niega a pagar tributo! ¡Una persona malvada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "¿Esa mujer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Está huyendo, ¡pero no puede escapar de él! ¡Dieciocho pares de ojos sangrientos! ¡Miles de colmillos afilados! ¡Infinitas bocas y lenguas, siempre anhelando sangre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "¡No puede esconderse, no puede esconderse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "Ah, ¡el país desierto de sentimiento! Y tú, la estúpida mendiga que clama ser sabia y se oculta en el bosque, ¡nadie puede protegerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "¡Tranquilízate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "¡Ya recibiste la bendición! ¡Ve a orar! ¡Ve a orar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "¡Bien dicho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "¡Oh, maldición!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "¡Oh, su cólera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "¡Ah, ya se acerca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
