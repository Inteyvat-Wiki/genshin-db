					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "Hiciste un gran trabajo, ¡bien hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "Recuerda que algunos te engañarán con máscaras, pero él te ayudará, siempre te ayudará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Esa mujer es como los demonios kitsune de las leyendas. La dejé ir una vez. Él está muy enojado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "Está enojado de nuevo... Es mi culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Por favor, perdóname... Me sacrificaré de nuevo. Encontraré otro sacrificio para tu retorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
