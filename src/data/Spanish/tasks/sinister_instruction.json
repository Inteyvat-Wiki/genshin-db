						721411802
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411802,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Gracias por perdonar mis pecados. Por favor, déjame volver a ti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411804,
					"content": "¿Me hablas a mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Qué... Pero ¿por qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "Presidí cada sacrificio ¡y acepté cada una de tus gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411807,
					"content": "Y ella, marcada por ti, habiendo trabajado para ti, ¡ha optado por huir de tus bendiciones y nos ha traicionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411808,
					"content": "¿De qué estás hablando...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "¡Ah! Bueno, eh... Lo siento... Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411810,
					"content": "No debemos dudar de su elección, seguir aguantando y seguir orando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411811,
					"content": "¿Puedes oírme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Seguir aguantando... Seguir orando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "Washizu"
