			"dialogs": [
				{
					"id": 766600101,
					"content": "#Bienvenid{F#a}{M#o}s, aventurer{F#a}{M#o}s. ¿Les muestro los encargos disponibles para hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600102,
					"content": "Aah... Me siento como en casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "#Oh... ¿Tienen prisa por hacer algo? ¿En qué puedo ayudarl{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600105,
					"content": "No, no, para nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "¡Solo que nos alegra mucho verte, jeje! Katheryne, eres la mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766600108,
					"content": "Gracias por ser tan amables... Disculpen, me temo que no entendí su sentido del humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600109,
					"content": "#En cualquier caso, bienvenid{F#a}{M#o}s a Nod Krai. Esta es una tierra colmada de oportunidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600110,
					"content": "Estoy segura de que aquí vivirán grandes aventuras y encontrarán tesoros sin igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600111,
					"content": "#Les deseo lo mejor, aventurer{F#a}{M#o}s. ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600106,
					"content": "Solo que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "Menos mal que eres tú, Katheryne.",
