				"objectNames": [
					"Yasmín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "¡Yasmín! ¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "N-No puedo respirar. ¡Salgamos de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "¿Qué es eso? *Cof, cof*... ¿Y ese olor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "Parece que Ladep hizo un trabajo excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280505,
					"content": "Con esto hemos acabado de rociar aquí. Vayamos al siguiente lugar. No está muy lejos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				}
			]
		}
	]
