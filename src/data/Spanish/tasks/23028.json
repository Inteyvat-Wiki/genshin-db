			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "#Viajer{F#a}{M#o}, qué bueno que estás aquí. Necesito ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280102,
					"content": "¿Le pasó algo malo al Árbol Sagrado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "No, de momento está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280104,
					"content": "Mi trabajo es asegurarme de que siempre esté bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280105,
					"content": "Para ello, rocío estas pociones sobre el Árbol Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280106,
					"content": "Pero no puedo cargar con tantas pociones yo sola. Y Ladep y Farés están muy ocupados con su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280107,
					"content": "Así que, si no te importa, ¿podrías ayudarme a llevar estas pociones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280108,
					"content": "¿Quiénes son Ladep y Farés?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Son estudiantes, igual que yo. Ladep estudia en la Facultad Spantamad, y Farés en la Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280110,
					"content": "Estamos colaborando en una investigación. Aunque somos de escuelas diferentes, trabajamos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280111,
					"content": "Estas pociones son el resultado de nuestra investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280113,
					"content": "De acuerdo, yo llevaré este frasco. ¿Puedes ayudarme con el resto, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280114,
					"content": "Ten cuidado al moverlas. Ladep no quería que la gente se las bebiera por equivocación, así que les añadió unos aromatizantes realmente desagradables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280115,
					"content": "Si se abre y te manchas, el olor te perseguirá el resto de tus días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280112,
					"content": "Muy bien, pues a trabajar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
