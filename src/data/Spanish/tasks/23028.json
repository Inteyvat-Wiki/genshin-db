				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avén",
					"Yasmín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmín, ¿qué haces aquí? ¿Has venido a rociar la poción otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Avén"
				},
				{
					"id": 230280402,
					"content": "Las raíces de esta zona están en perfecto estado. No tienes que seguir rociándolas con pociones cada dos por tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Avén"
				},
				{
					"id": 230280403,
					"content": "Aunque ahora mismo no haya ningún problema, es nuestro trabajo seguir cuidando del Árbol Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280404,
					"content": "Buscar soluciones cuando ya hay un problema es como preparar un rollito de pescado y darte cuenta de que la carne está cruda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280405,
					"content": "Tendrías que volver a empezar o deshacer los rollos ya hechos. Eso sí que sería un problemón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280406,
					"content": "Ya veo que no me vas a hacer ni caso... Pero ya te dije la última vez que las pociones huelen fatal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Avén"
				},
				{
					"id": 230280407,
					"content": "Yo vivo por aquí y no me gusta irme a dormir con ese hedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Avén"
				},
				{
					"id": 230280408,
					"content": "No te preocupes, le he pedido a Ladep que lo arregle. Ahora ya no huelen tan mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280409,
					"content": "*Suspira*, de acuerdo. Entonces me voy, y ni se te ocurra rociar eso cerca de mi jardín. No lo soporto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Avén"
				},
				{
					"id": 230280410,
					"content": "#Sí, ya lo sé. Viajer{F#a}{M#o}, pásame la poción que hay dentro de esa caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280411,
					"content": "Rocías las pociones con Yasmín.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Esta poción huele muy raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "¿Es que tú no lo notas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "¿El olor, dices? He olido cosas mucho peores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280415,
					"content": "Perfecto, ya he registrado todos los datos. Farés estará encantado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280416,
					"content": "#Aquí tienes el pago. Gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230280417,
					"content": "Me pregunto cómo les estará yendo a Ladep y Farés con el trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				}
			]
		},
