			"dialogs": [
				{
					"id": 701280101,
					"content": "Humm, esta botella se siente pesada. Parece que hay algo dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280102,
					"content": "“Un viejo amigo nuestro vino ayer con malas noticias...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280103,
					"content": "“No he recibido una respuesta tuya en mucho tiempo. Quizás él tenga razón, y debería aceptar la realidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280104,
					"content": "“Pero, si todavía estás vagando por la tierra y recibes esta misiva, espero que puedas enviarme una respuesta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280105,
					"content": "“Adjunta tu insignia a la carta para que pueda reconocerte a través de ella cuando llegue el momento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280106,
					"content": "“¿Te acuerdas del Restaurante Uyuu? Allí nos habremos de reunir. En la presente encontrarás dinero para comprar vino”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280107,
					"content": "“Pero si no eres quien esperaba recibir esta carta...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701280108,
					"content": "“Puedes quedarte con este recuerdo de todos modos. Quizás puedas encontrar a su dueño original por mí. Quédate con estos Moras como agradecimiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botella a la deriva"
				}
			]
		}
	]
