			"completionStepIds": [
				7301615
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301615",
							"2"
						],
						"stepId": 7301615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Uff... ¡Qué miedo! ¡Menos mal que contamos con Arabalika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Ya dijo Arabalika que Paimon se metería en problemas si no tenía cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Ehmm... Es cierto, Paimon sabe que se equivocó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Si en unas ruinas hay alguna máquina, claramente se moverá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "#Sí, cierto. Por algo las llaman “máquinas de las ruinas”... Al fin y al cabo, nosotr{F#as}{M#os} somos l{F#as}{M#os} intrus{F#as}{M#os} aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} y Paimon son intrus{F#as}{M#os} de bosque, pero Arabalika no. Es solo que grandes pedazos de hierro no atienden a razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Por eso, Arabalika tendrá que hacer que sí atiendan a razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Ay... ¡Entonces Paimon también se portará bien y atenderá a razones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Paimon, lo prometido es deuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "¡Claro! Mañana... ¡no, a partir de ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Solo aranara pueden despertar estas piedras. Nara {NICKNAME}, Paimon, dejen resto a Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "¡Estamos un paso más cerca de reparar la máquina divina de Váruna! Cuando lo hayamos hecho, ya no habrá tantas esporas flotando por la Floresta Apam. Solo con pensar en ello a Paimon le pica la nariz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "Máquina divina de Váruna purificará lluvia para que no sea negra y para que no haya tantas esporas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Pero sí seguirá habiendo hongos. Paimon tendrá que tener cuidado de no ser devorada por hongo, como casi le ocurre a Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "De acuerdo, ¡Paimon tendrá cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Aquí ya no necesitan a Arabalika. Arabalika regresará a descansadero a buscar a Arapandu. Nara {NICKNAME}, Paimon, ¿quieren regresar con Arabalika?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161518,
					"content": "Sí, vamos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
				{
					"id": 730161519,
					"content": "Sí, bosque es peligroso, es más seguro regresar juntos.",
