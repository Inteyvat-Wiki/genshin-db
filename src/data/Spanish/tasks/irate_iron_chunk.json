						"rawParams": [
							"7301603",
							"2"
						],
						"stepId": 7301603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Son nara... ¿y cosa que puede volar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Así es. Paimon es Paimon, y {F#ella}{M#él} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Tú debes de ser Arabalika. Por cierto, no parece que nos tengas miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "#Nara rubi{F#a}{M#o}, hueles como Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "Ah, claro, Arapandu dijo que viniéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Arabalika no percibe malas intenciones por su parte. Si hubieran querido lastimar a Arabalika, lo habrían hecho mientras gran pedazo de hierro seguía moviéndose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "#Así es. Eso sería hacer leña del aranara caído. ¡Nosotr{F#as}{M#os} nunca haríamos eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "¿Por qué no? Si Arabalika fuera enemigo, no sería mala idea inmovilizarlo. Animales también hacen eso al cazar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "Humm... Bueno, tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Te ves confundida, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "Eh... ¡da igual! ¡El caso es que nunca haríamos leña de un aranara caído!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Porque los aranara son nuestros amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#¡Eso! Los aranara son nuestros amigos, ¡así que {NICKNAME} y Paimon jamás los lastimarían!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Hum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Agh... ¿Por qué no parece convencido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "No le has causado una buena primera impresión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Pero a Paimon no le parece que haya hecho nada malo... Será que el carácter de los aranara es impredecible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Por cierto, Arapandu dijo que el ararakalari de Arabalika es muy poderoso. ¡Seguro que lo utilizó para derrotar antes a ese Guardián de las Ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "¿Paimon sabe qué es ararakalari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "Oh, ¡claro que Paimon lo sabe! ¡Es... esa cosa! Ese poder que se usa para... ¡bum! ¡Y listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Hum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "¡Ah! ¡Paimon tiene la impresión de que la vuelve a mirar por encima del hombro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Centrémonos en lo que tenemos que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Sí... Vinimos a ayudar a reparar la máquina divina de Váruna. Por aquí debería haber algunas de sus ramas y sus hojas. ¿Por qué Paimon no las ve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "¿Qué dicen de “hojas” y “ramas”? Son más bien raíces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "¿Eh? Ah, ¿sí? Pero Arapandu dijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "Máquina divina de Váruna extrae su poder de sistema de raíces que recorre todo bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Ah... Eso tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Además, raíces están bajo tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "#Piedras y pedazos de hierro que hay aquí no pertenecen a aranara. Para bajar, primero tendrán que derrotar a pedazo de hierro. Es muy fuerte, pero nara rubi{F#a}{M#o} también es fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#¡Claro! {NICKNAME} ha derrotado a incontables pedazos de hierro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "¿En serio? ¡Entonces Arabalika quiere ver qué tan fuerte es nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "¿Eh? ¡Se metió bajo tierra! ¡Ah! ¿Habrá ido hacia algún Guardián de las Ruinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, ¡sigámoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "A lo mejor es así con todo el mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "¿Cómo puede ser? Tiene un aspecto adorable, pero un temperamento horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Ya derrotamos a grandes pedazos de hierro. Ahora tenemos que dejar que fluya agua para poder ir bajo tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Ha pasado mucho tiempo desde última vez que Arabalika vino y es muy diferente de antes. Quizás haya también grandes pedazos de hierro bajo tierra. Arabalika puede notar olor a hierro, y eso no es bueno. ¡Debemos tener cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Nara {NICKNAME} es muy fuerte, así que no debe tener miedo. Pero Paimon es tan débil como Aranakula, así que debe tener cuidado para no ser devorada por champiñón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Ehm... ¡Es porque tú eres muy fuerte, Arabalika! Hemos conocido a muchos aranara, pero ninguno podía tumbar a un Guardián de las Ruinas de un solo golpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon no sabe mucho sobre aranara. Por ejemplo, Aradasha habría acabado con pedazo de hierro en abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "Aradasha solía tener ararakalari muy poderoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "¿Solía? ¿Ahora ya no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Ahora Aradasha no está. Por eso Arabalika tiene que entrenar mucho para fortalecer su ararakalari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Paimon también entrenaría su ararakalari... ¡Si tuviera uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Si lo tuvieras, tú te encargarías de pelear desde ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Jeje, ¡claro! ¡Así Paimon podría protegerte, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "¡Ánimo, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "¡Déjalo en manos de Paimon! ¡Paimon lo conseguirá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon tiene sueños muy ambiciosos, aunque Arabalika no sabe si eso es bueno o malo. Pero ahora tenemos que encontrar mecanismo de piedra para que agua fluya. Si no, no podremos acceder a subsuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranara pueden meterse bajo tierra, pero no bajo agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Muy bien, {NICKNAME}, ¡echemos un vistazo por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "No creo que pudieras entrenarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "¡Paimon sí que podría si se lo propusiera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "Eso suena a excusa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "¿Y si Paimon espera a que estemos en un lugar seguro, después de comer y descansar, y le pide a Arabalika que le enseñe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "P-parece que están todos rotos... ¡Ninguno se puede mover! ¡Qué susto tan grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "*Ejem*, Paimon quiere decir... Bah, solo es un pedazo de hierro oxidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Bosque es muy peligroso ahora. Si Paimon no tiene cuidado, se meterá en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Vaya, qué estricto eres, Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Es que te falta disciplina, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Ah, ¿sí? Entonces, si Paimon fuese tan estricta como Arabalika, ¿podría ser tan fuerte como él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Deberías ser más estricta contigo misma, no con los demás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Muy bien, Paimon intentará ser más estricta consigo misma... ¡a partir de mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Bueno, ya que la rama de la piedra está aquí, ahora solo tenemos que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Encontrar tres piedras que vayan en misma dirección. Con eso bastará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "¡Paimon lo tenía en la punta de la lengua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Por cierto, Arabalika habla como Arapandu: no utiliza metáforas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Así es más fácil entenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "¡Muy claro y directo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Arapandu piensa mucho, pero Arabalika no piensa demasiado. Arabalika solo entiende de proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "En ocasión, Arapandu protegió bosque junto a nara Váruna. Juntos consiguieron eliminar ominosa tierra corrupta y repararon máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "Hace mucho tiempo que nara Váruna se fue de bosque. Y puede que tampoco regrese para Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "#Arapandu sabe. Ya ha pasado mucho tiempo desde entonces, suficiente para que semilla se convierta en árbol gigante y para que {F#ese}{M#esa} nara que se fue de bosque nunca regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Pero Arapandu quiere reparar de nuevo máquina divina de Váruna por bien de Vanarana, por Festival Utsava y por nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "Arabalika nunca conoció a nara Váruna, pero todos aranara sabemos lo que hizo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika no sabe pensar tanto como Arapandu, pero sí sabe que es suficientemente fuerte como para proteger bosque y a aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Nara Váruna ya no está, pero aranara aún pueden reparar su máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "#¡Claro! ¡Y aquí están Paimon y {NICKNAME} para ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Hay algo extraño en olor a hierro de por aquí. Nara {NICKNAME}, Arabalika confía en ti. Arabalika estará esperando a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "#Paimon no sabe qué habrá notado Arabalika... Pero seguro que los aranara saben más sobre el bosque que nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#En cualquier caso, {NICKNAME}, busquemos por aquí tres hojas desperdigadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Pero no se parece a los demás aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "¿Qué sería “parecerse a los demás aranara”? Paimon no lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
