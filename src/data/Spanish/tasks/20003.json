					"content": "¡Mona, es hora de pagar el alquiler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Humm... Parece que Mona no está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Qué raro. ¿No suele estar en casa? ¿Habrá salido a hacer algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "O... ¿tal vez tiene tanta hambre que no tiene fuerzas para venir a abrir la puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "No creo que sea tan extremo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Oh, ¿en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Pero ¿dónde deberíamos ir a buscar a Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Dijo que encontró una forma de ganar dinero, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
