			"dialogs": [
				{
					"id": 790640601,
					"content": "¡Sospechosos detectados! Aunque no sé qué norma han infringido, pero estamos en alerta roja. ¡Vengan con nosotros y entréguense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Guardia gigante"
				},
				{
					"id": 790640602,
					"content": "Se escapan cada uno por una dirección. Cappet grita: “¡Sálvese quien pueda!”.\\nDespués de dar esquinazo a los guardias, se reúnen de nuevo en el lugar de antes. Menos mal que nadie ha sido capturado...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Intentémoslo de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Detective"
				}
			]
		},
