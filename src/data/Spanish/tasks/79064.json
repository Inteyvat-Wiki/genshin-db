			"dialogs": [
				{
					"id": 790640301,
					"content": "#Chicos, ¡estoy de vuelta! ¡Traje {F#a la}{M#al} esperad{F#a}{M#o} {F#marquesa}{M#marqués} y sus asistentes para encontrar los orígenes perdidos de nuestro clan!",
