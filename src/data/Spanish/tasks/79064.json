					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor azul"
				},
				{
					"id": 790640302,
					"content": "No nos han dicho esta mañana nada al respecto. Fuera de aquí, no queremos problemas.",
