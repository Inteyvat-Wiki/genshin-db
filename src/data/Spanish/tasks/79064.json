			"dialogs": [
				{
					"id": 790640801,
					"content": "Este es el cuartel general de los guardias. Seguro que el guardia gigante será comprensivo si le explicamos la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor azul"
				},
				{
					"id": 790640802,
					"content": "Hola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "¿Qué pasa? Estoy ocupado recordando viejos tiempos con una imagen de mi amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Alguien llamando a la puerta"
				},
				{
					"id": 790640804,
					"content": "Reconozco esa voz. ¿Es Winston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor azul"
				},
				{
					"id": 790640805,
					"content": "Jajaja, al final has venido a mí... Te lo dije, soy tu único amigo en este mundo. ¿Por qué aceptaste realizar una misión con dos completos extraños? ¿En qué estabas pensando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Alguien llamando a la puerta"
				},
				{
					"id": 790640806,
					"content": "Eras tan inocente: “¡Seguro que me haré amigo de ellos!”. Y al final, ¿qué? Solo yo te estoy esperando, y solo yo sigo siendo tu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Alguien llamando a la puerta"
				},
				{
					"id": 790640807,
					"content": "#Te equivocas... No solo vinieron ellos dos conmigo, sino que, además, tengo a {F#la}{M#el} {F#marquesa}{M#marqués} {NICKNAME} y sus amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor azul"
				},
				{
					"id": 790640808,
					"content": "¿Hiciste amigos a mis espaldas? Vaya, vaya, Albizzi, veo que te has hecho mayor. ¡Ya no lo soporto más! Lárgate, ¡no quiero volver a verte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "Alguien llamando a la puerta"
				},
				{
					"id": 790640809,
					"content": "Pero antes necesito que desactives la alarma. Tengo a los personajes más importantes de la historia conmigo y estamos muy cerca de resolver el misterio de nuestro lugar sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor azul"
				},
				{
					"id": 790640810,
					"content": "¡Fuera de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "Alguien llamando a la puerta"
				},
				{
					"id": 790640811,
					"content": "Winston hace sonar la alarma. Un guardia gigante agarra a todos y los deja fuera.\\n“Es mejor separarte de Winston por el momento, ambos necesitan un descanso”.\\nEl guardia gigante les da este amable consejo.\\nTodo el proceso se ha hecho con mucha cortesía.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}