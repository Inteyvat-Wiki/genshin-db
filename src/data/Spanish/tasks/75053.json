			"dialogs": [
				{
					"id": 750530101,
					"content": "#Oye, foraster{F#a}{M#o}, qué buena visión tienes... ¿Te gustaría probar el reto “Pluma a la vista”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530102,
					"content": "Podrás entrenar tu vista... y conseguir recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530103,
					"content": "Oh, ¡qué descripción tan concisa! Tan concisa que parece que no explicaste nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530104,
					"content": "Les diré las reglas... si es que les gustaría intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530105,
					"content": "Veamos cuáles son las reglas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Los tres Qucusaurios volarán hacia fuera. Deberás mantener tu mirada en el que está en el centro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530107,
					"content": "Cuando regresen volando, <color=#00E1FFFF>deberás reconocer al que estaba originalmente en el centro</color>. Eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530108,
					"content": "Entonces, ¿estos tres cambiarán de posición en el aire, y tenemos que encontrar el que estaba en el centro cuando vuelvan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530109,
					"content": "Exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530110,
					"content": "A Paimon no le extraña que digas que este reto es bueno para entrenar la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530111,
					"content": "Empecemos con algo fácil. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530112,
					"content": "Y si no tienen problemas... podemos pasar a la prueba oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530113,
					"content": "Si superas el reto, obtendrás la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530114,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "De acuerdo. De todos modos, seguiré aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530116,
					"content": "Voy a intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "#Cuando estés preparad{F#a}{M#o}, ¡golpea la diana para empezar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		},
