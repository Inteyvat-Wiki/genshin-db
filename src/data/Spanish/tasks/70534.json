			"dialogs": [
				{
					"id": 705340101,
					"content": "*Suspira*, ¿pero por qué hay que crear otro juego de mesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "#¡Ay, viajer{F#a}{M#o}, qué susto me has dado! Vaya, ¿tú también participas en el Torneo del Rey de los Invocadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "¿Con qué estás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Este es un minijuego diseñado por un aventurero del Gremio, algo así como... un juego de mesa en el que se combinan los combates de Invocación de los Sabios. Al parecer se llama “Genios de la estrategia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Como se está celebrando el Torneo del Rey de los Invocadores, el Gremio se fijó en el juego que diseñó ese aventurero y lo ha aprovechado para organizar una pequeña actividad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "¿Se pueden combinar los combates e Invocación de los Sabios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Jajaja, a decir verdad, yo tampoco lo sé muy bien, pero aquí tengo un manual de instrucciones. Uff, mira, es enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Por lo que yo entiendo, la clave de Genios de la estrategia radica en el uso de los dados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "En fin, si te apetece probarlo, puedes venir en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "¿Cómo es posible combinar ambas cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "¿De qué juego de mesa hablas?",
					"roleType": "TALK_ROLE_PLAYER",
