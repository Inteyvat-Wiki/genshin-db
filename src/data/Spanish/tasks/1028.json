					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "¿Quién iba a imaginar que nos quedaríamos atrapados en un sitio como este? Estamos ante un auténtico dilema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "A pesar de todo lo que he estudiado en mi vida, lo único que sé hacer es meter a gente en prisión... Pero no tengo ni idea de cómo salir de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Incluso firmé un contrato con mi padre para “vivir una vida feliz”... No podemos perder la esperanza ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Intentaré ser positiva... Al menos exploré un nuevo lugar, conocí más del mundo y me reuní con viejos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Humm... Sí, todavía queda una pizca de esperanza, supongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
			"id": 102807,
			"completionStepIds": [
				102802,
				102807
			],
