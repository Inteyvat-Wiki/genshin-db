			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Hola. ¿Buscas algún libro en especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Quería un libro llamado «La perla de Teyvat».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "¿«La perla de Teyvat»? No lo tengo aquí. ¿Lo necesitas con mucha urgencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Bueno, es para la reconstrucción de la Cámara de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "¿En serio la están reconstruyendo? Eso requiere una preparación adecuada. Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Quizás podrías preguntarle a Chingzhou. Él es una persona muy bien leída, puede que sepa dónde encontrar «La perla de Teyvat».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Si no me falla la memoria, Chingzhou suele alojarse en la Posada Wangshu. Puedes ver si se encuentra ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "¿Qué más podría escribir?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130302,
					"content": "¿Sabes algo acerca del libro «La perla de Teyvat»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "¿«La perla de Teyvat»? Oh, sí, recuerdo aquel libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130304,
					"content": "Una vez estuve de aquí para allá en busca de material para redactar un poema sobre comerciantes y casualmente me topé con ese libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130305,
					"content": "No entendí en su totalidad el contenido, pero algunas de sus anécdotas fueron muy inspiradoras para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130306,
					"content": "Permíteme recordar el nombre de ese poema. Dame un segundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130307,
					"content": "¿Recuerdas dónde se puede encontrar ese libro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "¿Lo están buscando? Debo confesar que no lo recuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130309,
					"content": "Sin embargo, si lo necesitan con urgencia, podría escribirles una copia a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130310,
					"content": "¿Escribirlo a mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Ah, no era un libro muy largo, ni tampoco difícil de memorizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130313,
					"content": "Además, el bibliotecario tampoco dejó que me lo llevara prestado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130314,
					"content": "Y como la poesía no es algo que se pueda leer con prisa, escribí una copia para continuar mi lectura... Su contenido tampoco es muy largo, así que lo tengo más o menos memorizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130315,
					"content": "Así que ese es el superpoder de los poetas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "#Sí, pero he de decir que es insignificante, {F#señorita}{M#caballero}. Quizás puedas hacerme un favor a cambio del libro escrito a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130317,
					"content": "Me da un poco de vergüenza decirlo, pero... he estado tan concentrado en recopilar material que olvidé comer. Ahora mismo tengo un hambre voraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130318,
					"content": "¿Me podrías ayudar a conseguir una ración de tiras de tres sabores? A cambio, te escribiré una copia de «La perla de Teyvat».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130319,
					"content": "Calculo que habré terminado de escribirlo a la hora que regreses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130311,
					"content": "¿Te lo aprendiste de memoria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
