			"dialogs": [
				{
					"id": 718130401,
					"content": "«La perla de Teyvat»... Ah, sí. “Cada industria y cada negocio, como los manantiales y los arroyos, comienza en las montañas y acaba en los mares”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "“Este gran plan traza el curso que nos guiará de forma lenta, pero segura, hacia la longevidad de Liyue y la prosperidad de la gente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130502,
					"content": "Ah, volviste. Un segundo, me faltan las últimas líneas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130503,
					"content": "Listo, terminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130504,
					"content": "Aquí están tus tiras de tres sabores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Calma, calma. Primero, revisa si estás conforme con el libro. Estoy seguro de que mi caligrafía será de tu agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718130506,
					"content": "Así que ese es otro superpoder de los poetas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "#Jajaja, me elogias demasiado, {F#señorita}{M#caballero}. Este libro es para ti, no lo pierdas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maestro Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "¿Eh? ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130602,
					"content": "Quería unos pequeños adornos de bambú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "¿Dijiste pequeños adornos de bambú? Puedo hacerlos, pero ¿podrías decirme de quién es este pedido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130604,
					"content": "Es de esta lista que hizo Baiwen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Oh... ¡Un pedido del Pabellón Yuehai! En ese caso, debo tenerlo listo lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130606,
					"content": "Sin embargo, hay un problema: no sé por qué, el bosque de bambú del que recolecto materiales ha sido invadido repentinamente por una gran cantidad de jabalíes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130607,
					"content": "Aunque no sea un problema muy grave, normalmente debo rodearlos para recolectar bambú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130608,
					"content": "Si ustedes pudieran ahuyentar a esos jabalíes, yo podría ir a recolectar bambú para empezar el trabajo enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130609,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Entonces, yo esperaré aquí. Una vez que hayas ahuyentado a esos jabalíes, regresa a avisarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro Lu"
				}
			]
		},
