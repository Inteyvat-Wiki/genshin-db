			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maestro Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "¿Ahuyentaste a esos jabalíes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130702,
					"content": "A todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Bien, en un momento iré a recolectar el bambú. Cuando tenga los adornos listos, los enviaré directamente al Pabellón Yuehai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130704,
					"content": "Este pedido es bastante grande. Voy a hacer una buena fortuna con esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro Lu"
				}
			]
		},
