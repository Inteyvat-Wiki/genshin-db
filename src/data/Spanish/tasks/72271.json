					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "Tengo un tesoro que me gustaría vender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Oh, ¿qué objetos extraños encontraste esta vez? Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Le hablas a Linlang sobre el condensado dragohueso.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Si lo que me cuentas es cierto, esto es una reliquia impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Sin embargo, a simple vista no detecto nada especial. Quizás haya que utilizarla durante un tiempo para que muestre sus cualidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "Tal y como yo lo veo, parece que esas magníficas propiedades de las que hablas son un tanto... exageradas. Quizás tan solo fue algo que te encargó alguien incapaz de cumplir con su cometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "No te lo tomes a pecho. Solo digo lo primero que me pasa por la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "De todas formas, esto sucede muy a menudo en nuestro trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "También creo que no la guardaste en un lugar seguro, porque parece que está un poco desgastada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Me temo que eso conllevará una reducción de su precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "#¿Qué les parece 80{NON_BREAK_SPACE}000 Mora? Más 5 pescados de la abundancia como especialidad gastronómica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Creo que es un buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "¿Para qué lo vas a usar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Para ser sincera, le doy más valor a la historia que esconden los objetos que a su utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Supongo que esto sería de gran interés para nuestros cuentacuentos, para la compañía de ópera, o quizás para los caballeros y damas de la Terraza Yujing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Entonces se convertiría en una reliquia muy antigua, incluso si simplemente la exhibiera en el mostrador de la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Me parece un precio justo. Trato hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "#Tú siempre tan direct{F#a}{M#o}. Bueno, entonces aquí tienes tu Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Si encuentras algún tesoro similar, aquí estaré esperando tu regreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Déjame pensarlo un poco más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Sin problema. Después de todo, deberías comprobar bien los objetos... bueno, más bien los precios, cuando estás a punto de vender una reliquia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Puedes volver a consultarme cuando lo hayas pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
