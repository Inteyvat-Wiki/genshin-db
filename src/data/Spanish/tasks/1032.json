			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi, parece que nuestra pequeña calavanda está durmiendo. ¿Qué crees que estará soñando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "¿Muu? Muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Se ve agotada. Verla así me hace sentir lástima por ella, como nunca cierra la boca... Ay, pobrecita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "Nuestro colega también parece agotado. Estoy preocupado por ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Muu, muu, muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "¿Que yo también duermo así cuando estoy en prisión? ¡Jaja, es verdad! Duermo como un rey.",
