						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "Oh, no te preocupes. No escribiré nada sobre lo que nos contaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "No es eso. Me refería a que puedes contar conmigo para analizarlo.",
