					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Tal vez la clave para escapar está oculta en un detalle que pasamos por alto. Debo revisarlo todo una vez más.",
