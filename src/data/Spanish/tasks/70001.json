	"talks": [
		{
			"id": 7000102,
			"completionStepIds": [
				7000102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000102",
							"2"
						],
						"stepId": 7000102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "#Ah, hola, viajer{F#a}{M#o}. Nos volvemos a ver. ¿Qué tal? ¿Estás disfrutando del ambiente de la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010202,
					"content": "Sí, bastante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Me alegro. Ehm... sé que no va con el ambiente de esta época, pero necesito tu ayuda con algo relacionado con el Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010204,
					"content": "Bueno, mejor dicho, “ese señor” necesita tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010205,
					"content": "Pensé que durante el Festival no se podían encargar tareas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "Oh, no te preocupes por eso. Lo que te quiero pedir no está contemplado dentro de las reglas del festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010207,
					"content": "Seguro que tú también has notado lo animada que es esta festividad. La gente no para de ir y venir y hay actividades en todas partes. Prácticamente todo el mundo disfruta del embriagador ambiente festivo. Y los Caballeros de Favonius están muy ocupados intentando mantener el orden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010208,
					"content": "Entre este gentío incapaz de protegerse y lo ocupados que están los Caballeros, este sería el momento perfecto para que los Ladrones de Tesoros hicieran una de las suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010209,
					"content": "Según la información de “ese señor”, algunos ladrones ya se infiltraron en la ciudad aprovechando el desorden, fingiendo celebrar la fiesta cerca de las tiendas de la puerta principal. Pero, en realidad, están preparando el camino para actuar más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010210,
					"content": "Si los Caballeros empezaran a buscarlos ahora, no solo alertarían a los ladrones, sino que arruinarían la atmósfera del festival. Pero tampoco podemos ignorarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010211,
					"content": "Supongo que es aquí donde entro yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Exacto. Ese señor pidió específicamente que tú tomaras el caso. Según él, eres la persona ideal para el trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010213,
					"content": "Bueno, vayamos directo al grano. De acuerdo a los informes que he reunido, los Ladrones de Tesoros que se han infiltrado llevan <color=#00E1FFFF>una bolsa</color> para identificarse entre sí y usan un <color=#00E1FFFF>código</color> para confirmar la identidad de sus camaradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>“Cuando en el cielo floten las flores de viento es cuando los caminantes deben estar atentos”</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010215,
					"content": "Es fácil de recordar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Si logras responder a la contraseña, pasarás como uno de ellos. Además, podrías sacarles información sobre su campamento en las afueras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010218,
					"content": "Una vez que tengas el informe, aprovecha la oportunidad y deshazte de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010219,
					"content": "¿Por qué no se lo encargas a los Caballeros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Los Caballeros están hasta el cuello intentando mantener el orden durante el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010221,
					"content": "En momentos como este, es el deber de los ciudadanos... cargar con un poco de las responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010222,
					"content": "#Bueno, dejaré que te encargues, {F#Caballera Honoraria}{M#Caballero Honorario}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010216,
					"content": "Típico de ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000103",
							"2"
						],
						"stepId": 7000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ciudadano sospechoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Todo está bastante animado, qué bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Ciudadano sospechoso"
				},
				{
					"id": 700010302,
					"content": "“Cuando en el cielo floten las flores de viento...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "¿Oh? Ah, sí. “... es cuando los caminantes deben estar atentos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Ciudadano sospechoso"
				},
				{
					"id": 700010304,
					"content": "Así que eres de los nuestros, qué bien que viniste. He estado observando a varios tortolitos inadvertidos. Vamos a ganarnos unos cuantos Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Ciudadano sospechoso"
				},
				{
					"id": 700010305,
					"content": "Tú llama su atención y yo estaré atento a la oportunidad de entrar en acción. Cuando terminemos, vayamos a Levantaviento a buscar a los demás y ver qué consiguieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Ciudadano sospechoso"
				},
				{
					"id": 700010306,
					"content": "Antes que nada, tendrás que venir conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "¡¿Eh?! U-un momento, tú no perteneces a los Ladrones de Tesoros. ¡¿Quién eres?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Ciudadano sospechoso"
				},
				{
					"id": 700010308,
					"content": "Soy de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Ya se lo llevaron los Caballeros. ¿Pero cómo llegaron tan rápido...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Humm, no nos preocupemos por eso en este momento. A Paimon le pareció escuchar que el ladrón quería reunirse con sus colegas en Levantaviento. Vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000104,
			"completionStepIds": [
				7000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000106",
							"2"
						],
						"stepId": 7000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ciudadano inquieto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "¿Eh? ¿Qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Ciudadano inquieto"
				},
				{
					"id": 700010402,
					"content": "“Cuando en el cielo floten las flores de viento...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "¿Flores de viento? ¿Te refieres a los dientes de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Ciudadano inquieto"
				},
				{
					"id": 700010404,
					"content": "¿Qué tiene de raro? Es de lo más normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Ciudadano inquieto"
				},
				{
					"id": 700010405,
					"content": "¡Perdón por molestar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Parece que era un ciudadano normal. Preguntemos a otra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ciudadano triste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Me pregunto si todavía tengo oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Ciudadano triste"
				},
				{
					"id": 700010502,
					"content": "¿Eh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Ciudadano triste"
				},
				{
					"id": 700010503,
					"content": "“Cuando en el cielo floten las flores de viento...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Ah, sí. Intentas decirme que debo tratar de disfrutar el Festival de las Flores de Viento sin importar lo que haya ocurrido, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Ciudadano triste"
				},
				{
					"id": 700010505,
					"content": "En realidad, tienes razón. ¿Por qué debería desanimarme solo porque me rechazaron? El festival no ha terminado aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Ciudadano triste"
				},
				{
					"id": 700010506,
					"content": "Gracias por los ánimos. ¡Recobraré la compostura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Ciudadano triste"
				},
				{
					"id": 700010507,
					"content": "Parece que nos han malinterpretado. Pero alguien así no podría levantar ninguna sospecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000111",
							"2"
						],
						"stepId": 7000111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "¿Cómo te fue con el asunto de los Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010602,
					"content": "Ya está resuelto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "#Ah... Como era de esperarse {F#de la Caballera Honoraria}{M#del Caballero Honorario}. Bien hecho. Fue muy astuta la forma en que hablaste con ese ladrón de tesoros. No me sorprende que “ese señor” te tenga en buena estima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010604,
					"content": "¿N-nos has estado viendo todo este tiempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010605
					]
				},
				{
					"id": 700010605,
					"content": "Claro. De no ser así, ¿cómo hubiera podido llamar a los Caballeros de Favonius para que lleguen a tiempo?",
