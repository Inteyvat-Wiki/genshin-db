				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Así que es en esta área... ¿Estás seguro, Pallad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Estoy muy seguro, Sr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020203,
					"content": "¿Están hablando del papá de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#¡Pero si es {F#la viajera}{M#el viajero}! Supongo que Joel te pidió que vinieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Ese niño envía todos los días a alguien a preguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Sin embargo... ¡esta vez tenemos buenas noticias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Hace poco estábamos organizando un entrenamiento especial en Espinadragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Permítame explicar el resto, Sr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020209,
					"content": "Mientras estábamos en el entrenamiento, me desvié del camino planeado debido a una gran ventisca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020210,
					"content": "De repente, mientras regresaba a tientas al trayecto original, vi una figura borrosa sobre un acantilado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020211,
					"content": "Pensé que, igual que yo, se trataba de un aventurero perdido, así que le grité.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020212,
					"content": "Sin embargo, mis gritos atrajeron a los monstruos antes de poder llamar su atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020213,
					"content": "No sé tú, pero yo no tengo la confianza para derrotarlos en esas condiciones, así que salí huyendo tan rápido como pude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020214,
					"content": "Al volver, le conté al Sr. Cyrus lo sucedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020215,
					"content": "¿La persona que viste era el padre de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "No podemos decirlo a ciencia cierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "En fin, al menos ahora sabemos que hay una persona atrapada en Espinadragón, así que nuestro deber es rescatarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Sea el padre de Joel o no, eso ya dependerá de la suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "En fin, ya envié a todo el personal capacitado a Espinadragón para distribuirse y explorar la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Yo también estoy preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020222,
					"content": "Iré contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "¿De verdad? ¡Magnífico! Entonces, en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020223,
					"content": "Yo me hago cargo de los monstruos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Podría ser otro aventurero perdido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
