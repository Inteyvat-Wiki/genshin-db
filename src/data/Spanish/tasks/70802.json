				{
					"id": 708020401,
					"content": "#Ah, viajer{F#a}{M#o}, estás de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020402,
					"content": "Pallad ya comenzó la búsqueda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Ya veo. ¡Ja! Sabía que en el fondo era un muchacho responsable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Una vez que termine los asuntos pendientes, iré a Espinadragón a ver a Joel y darle las noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "Así que, si puedes, dile que iré pronto a verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "Necesito un tiempo para terminar el trabajo, ¡no dejes a ese muchacho esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "¿De verdad encontraremos a esa persona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "Pues... No hay garantía. Solo puedo decir que haremos lo que podamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				}
			]
