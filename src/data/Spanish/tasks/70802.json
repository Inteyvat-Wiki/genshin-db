						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "Ah... Así que Cyrus no ha encontrado a papá, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020503,
					"content": "Confía en él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "Lo sé... Le preguntaré más detalles a Cyrus cuando venga. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020506,
					"content": "¿Dónde estarás, papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020504,
					"content": "Al menos tienen pistas.",
					"roleType": "TALK_ROLE_PLAYER",
