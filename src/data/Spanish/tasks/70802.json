					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020304,
					"content": "Sin embargo, ya que los alrededores son seguros, seguiré con mi búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 708020305,
					"content": "¿Te importaría acompañarme a informar al Sr. Cyrus que he comenzado con la búsqueda? ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Temerario Pallad"
				}
			]
		},
