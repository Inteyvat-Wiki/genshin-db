			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Sí, sí, gaviones, ya sé que tienen hambre, pero yo tampoco me he llenado la panza todavía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Qué más da, mientras estén contentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#¿Viajer{F#a}{M#o}? Me alegro de verte, pero si necesitas algo de mí, me temo que tendrás que esperar. Todavía no me he terminado las papas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "La verdad es que no necesito nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Ah, bueno, pues mejor. Tengo que darme prisa y terminar de comer lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Es mi almuerzo. Hoy tengo cosas que hacer con el Sr. Roialte, así que eso es lo único que me daba tiempo a comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "No tengo por costumbre comer en el Palacio Mermonia, siempre busco un sitio donde comer lo que sea rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Pero... No sé porqué, pero esos dichosos gaviones purpuráureos no dejan de venir a por mis papas fritas. Da igual cuantas les dé, siempre quieren más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Es que hay tantos gaviones y tan poquitas papas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Sí, lo sé, pero no es mi responsabilidad alimentar a todos los gaviones de Teyvat, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Bueno, pues si son tus papas, no dejes que se las coman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Si no, te vas a pasar todo el día muerto de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Pareces un poco deprimido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "#¿Ah, sí? Qué va... Bueno, un poco. Estás en todo, chiquill{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Verás, últimamente me pregunto mucho qué significado tiene mi trabajo. Me paso el día en la Oficina Administrativa trabajando a destajo, pero no veo ningún resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Ni ayudo ni le hago las cosas más fáciles a nadie. El Sr. Roialte dice que mi trabajo es muy importante, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Me paso el día tecleando en mi máquina de escribir. Tac, tac, tac. ¿Y de qué sirve? Bien podría perder otra tecla, así al menos Estelle sacaría un puñado de Moras de ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Lo siento, no debería decir esas cosas. Simplemente estoy un poco perdido en todo lo que hago. Tal vez me vendría bien un descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Deberías terminar de comer primero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Sí, llevas razón, pero ya no tengo tiempo suficiente como para ir a comprar otra ración de papas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Bueno, no importa, les daré las que me quedan a los gaviones. Yo puedo comer algo cuando resuelva mis asuntos con el Sr. Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "No creo que nos lleve demasiado. Medio día, tal vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "¿Y vas a estar sin comer hasta entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Yo me encargo de los gaviones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "¿Eh? Eso sería demasiado pedir. Solo es una ración de papas después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "De eso nada. Por muy ocupado que estés, deberías comer bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Deja que yo resuelva el problema de los gaviones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Deja que resolvamos lo de los gaviones por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Pareces un poco triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Algunos de ellos todavía no han probado bocado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "¿Por qué estás comiendo papas fritas aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
