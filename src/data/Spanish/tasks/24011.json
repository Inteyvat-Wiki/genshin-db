				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Gaviones glotones, márchense cuando hayan terminado de zamparse mis papas fritas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "¿Cómo van las cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "No, en absoluto. En cuanto vio que los gaviones se acercaban, se escondió tras de mí con el rabo entre las patas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*Suspira*, tampoco le culpo. Los cachorros así solo tienen un trabajo y es querer a sus dueños y que sus dueños los quieran a ellos. No están hechos para enfrentarse a nada ni nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Ese también es nuestro trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Puede, pero, a veces, el amor también puede considerarse un derecho, y cuando el amor y el derecho entran en acción, las cosas tienden a complicarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Ay, perdón, ya me he ido de la lengua otra vez. Últimamente he tenido que solucionar algunos temas un tanto emocionales y todavía ando un poco trastocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*Suspira*, aunque ahora lo que más ocupado me tiene es terminarme esta ración de papas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "¿Te ha funcionado lo del perro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
