			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "¿Por qué no vas a comer a otro sitio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Tampoco es que tenga muchas más opciones. Si me quedo cerca del Palacio Mermonia, podría cruzarme con mis compañeros del trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Y entonces empezarían a hablar de trabajo mientras como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Pero si me alejo mucho, me arriesgo a llegar tarde y perderme algún anuncio importarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Si tengo en cuenta esos dos factores, este es el mejor sitio para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
