			"dialogs": [
				{
					"id": 240111101,
					"content": "¿Por qué no te compras un perro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "¿Quieres que me compre un perro para asustar a los gaviones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
					"content": "Pues no es tan mala idea. A lo mejor podría pedirle a alguien que me preste el suyo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
