			"dialogs": [
				{
					"id": 3720101,
					"content": "Espera, ustedes son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Persona de verde"
				},
				{
					"id": 3720102,
					"content": "#¡Cierto! Ustedes son l{F#a}{M#o}s que asustaron a Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Persona de verde"
				},
				{
					"id": 3720103,
					"content": "¿Dvalin? ¿Quién es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720104,
					"content": "Es el verdadero nombre de Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "¡Ah, cierto! La mayoría de gente le llama “Stormterror”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720107,
					"content": "¿Por qué le llamas así? ¿Acaso son buenos amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720108,
					"content": "Sí, muy buenos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Persona de verde"
				},
				{
					"id": 3720109,
					"content": "#Oye, {NICKNAME}, Paimon cree que a esta persona le falta un tornillo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720110,
					"content": "Ehm... Perdón por molestar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "#Hola, foraster{F#a}{M#o}. Nos hemos visto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Persona de verde"
				},
				{
					"id": 3720113,
					"content": "Soy Venti, el bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720114,
					"content": "Para ser más precisos, soy el tres veces ganador de “El bardo más popular de Mondstadt”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720115,
					"content": "¿Puedo ayudarles en algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720116,
					"content": "Ya que sabes quiénes somos, no hace falta dar muchas explicaciones, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720117,
					"content": "¡Por supuesto, queremos saber más sobre Stormterror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720118,
					"content": "¿Quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720119,
					"content": "¡No te hagas el loco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, ¿puedes enseñárselo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720121,
					"content": "¡Oh! Eso es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720122,
					"content": "¿Qué? ¿Alguien purificó el cristal? ¿Cuándo ocurrió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720123,
					"content": "No lo sé. Ocurrió de repente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Es de Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720126,
					"content": "Es una lágrima de sufrimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720127,
					"content": "... ¿Lágrima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720124,
					"content": "La última vez que lo vi, estaba lleno de impurezas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Disculpa, ¿quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "¿Lo olvidaste? Lisa lo mencionó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
		{
