			"dialogs": [
				{
					"id": 706990101,
					"content": "#¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}! Qué suerte tenemos de que vayas a probar nuestro programa de entretenimiento. ¡Así sí que puedo quedarme tranquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "Para ser honesto, es la primera vez que participo en este tipo de trabajos de desarrollo. Estoy un poco nervioso y siento que no doy abasto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Aunque solo se trata de ponerle una carcasa a un mecanismo ya desarrollado, hay que tener en cuenta todos los aspectos del diseño y ajustar muchos parámetros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Si tuviéramos que hacer un equipamiento especializado desde cero como el comandante Albedo, ¡quién sabe cuántos problemas encontraríamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Yo creo que está funcionando muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "#Oh... Gracias... ¡Gracias por el reconocimiento, Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Yo... ¡me esforzaré al máximo para desarrollar más cosas útiles por mi cuenta para la Compañía de Reconocimiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "He ganado algunos muñecos, y me gustaría entregarte este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "Ya tengo uno igual, así que cada vez que vea este muñeco, ¡recordaré las palabras de aliento que me diste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Confía en ti mismo y no dejarás de mejorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
