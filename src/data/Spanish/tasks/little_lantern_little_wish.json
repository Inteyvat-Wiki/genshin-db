				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "#¡Ho-hola, e-estimad{F#a}{M#o} client{F#a}{M#e}! Eh... Puede descansar las piernas un rato aquí y tomar un té, y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410203,
					"content": "Vinimos a traerte una linterna celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "¿Una... linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410205,
					"content": "Toma, esta linterna es tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "¿Mengmeng? ¿Tú hiciste esta linterna? G-gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410207,
					"content": "#{F#Ella}{M#Él} me enseñó a hacerla. No es perfecta, pero... ¿te gusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "¡Es perfecta! Me gusta mucho. Justamente estaba preocupado porque no tenía tiempo para hacer una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410209,
					"content": "Gracias, Mengmeng. Le pediré a alguien que me ayude a colgarla en la puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410210,
					"content": "¿Por qué necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Eh... pues... Mi padre siempre está enfermo, así que no puede colgarla. Y yo soy muy pequeño, así que seguramente no alcance a hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410213,
					"content": "Si quiero colgar la linterna celeste en la puerta, solo me queda pedirle a alguien más que me ayude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410214,
					"content": "Yo la colgaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "¿De verdad? ¡Qué bien! Gracias. Me preocupaba que, si tuviera que ir a pedirle ayuda a alguien, no habría nadie para cuidar la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410215,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "¿No hay nadie en casa que te pueda ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "La linterna celeste se ve muy bien ahí colgada. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410402,
					"content": "Yu, vamos a jugar. Conozco un buen lugar con flores muy bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#{F#Esta}{M#Este} viajer{F#a}{M#o} me enseñó a hacer linternas celestes. ¿Por qué no vamos y te enseño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Yo... no puedo. Tengo que quedarme a cuidar de la tienda. Papá dice que, aunque no haya muchos clientes, tengo que mantenerla limpia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410405,
					"content": "Bueno, no tenemos que hacer una linterna celeste. También podemos charlar. ¿Qué te parece? Volveremos pronto, no te quitaré mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410407,
					"content": "Te ayudaré a limpiar la tienda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "¿Eh? ¿En serio? E-entonces... gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410410,
					"content": "¡Iremos solo un momento! ¡No tardaremos mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "Entonces... ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Déjame la limpieza a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "Parece que esos dos todavía están jugando. No hay de qué preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Pero, a juzgar por el ambiente, tal vez no deberíamos molestarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Me gustaría saber de qué están hablando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Entonces, si hago una guirnalda para tu papá, ¿crees que mejorará pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "No lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410707,
					"content": "En los libros dicen que te recuperas más rápido si eres feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Creo que tu papá debe estar muy feliz, porque eres muy responsable y le ayudas todos los días a cuidar de la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Pero papá a veces dice: “No te quedes ahí en la tienda, vamos, sal a jugar”, o cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410710,
					"content": "“Si no juegas con Mengmeng, terminará por arrancar todas las flores”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410711,
					"content": "Pero este lugar está repleto de flores, ¡nunca acabaría de arrancarlas!... Espera, haré una guirnalda para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Gracias, Mengmeng. *Suspira*, ya deberíamos volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410713,
					"content": "Bueno... Cuando tu papá mejore, tendrás más tiempo libre, ¿cierto? Entonces, ven a jugar conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Sí... Seguramente papá se pondrá mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410715,
					"content": "¿Eh? ¿Cuándo llegaste aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410716,
					"content": "Acabo de llegar.",
