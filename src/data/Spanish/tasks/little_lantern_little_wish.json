			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Qué difícil es hacer linternas celestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "¿Sabes cómo hacer linternas celestes? Por más que lo intento, no logro hacerlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Paso el hilo por el agujero, y luego de regreso, y luego... se me cae o se rompe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "De verdad quiero hacer una linterna celeste para Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu siempre está cuidando del puesto de té y no tiene tiempo para jugar ni para hacer una linterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Pero seguramente tiene algún deseo, así que quiero hacer una para él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "Te ayudaré a hacer una.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Pero... quiero hacer una yo misma para regalársela a Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "Además, quiero saber cuál es el truco para hacer una linterna, así se lo podré explicar a Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "¿Podrías... enseñarme a hacer una linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Con gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Esta linterna celeste debe ser suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "¡Gracias! ¡Vamos rápido a dársela a Yu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "¿Y si hago una para ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
