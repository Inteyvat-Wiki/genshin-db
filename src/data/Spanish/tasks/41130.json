			},
			"dialogs": [
				{
					"id": 411300401,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "¡Genial! Avisaré al resto e iremos inmediatamente. ¡Debemos actuar rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Nos veremos aquí cuando hayamos despejado todo el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
