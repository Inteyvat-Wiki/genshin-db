			},
			"dialogs": [
				{
					"id": 411300501,
					"content": "#Lo siento, estoy ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300502
					]
				},
				{
					"id": 411300502,
					"content": "Oh... Está bien, no te preocupes. Seguiré pensando en cómo enfrentarnos a esos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113006,
			"completionStepIds": [
				4113012
			],
