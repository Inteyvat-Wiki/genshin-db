			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113012",
							"2"
						],
						"stepId": 4113012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "¿Qué tal? ¿Derrotaste al monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "¡Genial! Por fin podré estar tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "#Gracias por tu ayuda, viajer{F#a}{M#o}. Toma esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "Aun así... ¿Por qué aparecerían tan de repente esos monstruos alrededor de la Aldea Chingtsé? No entiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Bueno, sea como sea, debo informar de ello al Ministerio de Asuntos Civiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300607,
					"content": "Espero que puedan enviar a más gente para ayudarnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		}
	]
