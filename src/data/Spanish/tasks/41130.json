						],
						"stepId": 4113001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "#¡Viajer{F#a}{M#o}! ¡Aquí, aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "Se trata de la Aldea Chingtsé otra vez. Esos meteoritos que cayeron han hecho que los monstruos de la aldea pierdan la cabeza. Han estado arrasándolo todo a su paso, y están a punto de rodear la Aldea Chingtsé por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "Mientras nosotros protejamos la aldea, no pasará nada, pero seguimos dependiendo de la ciudad para obtener suministros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Con esta situación, el Ministerio de Asuntos Civiles no puede enviar muchos soldados para escoltar los suministros. Sería un grave problema si los grupos de monstruos los atacaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "Algunos compañeros y yo hemos estado pensando en ello y... aunque no podemos alejarnos mucho de la Aldea Chingtsé, podemos ayudar a derrotar a los monstruos de los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "De esta manera, podremos echarle una mano a los que vengan protegiendo los suministros. Sin embargo, nuestros exploradores nos dijeron que los monstruos se están reuniendo en muchos lugares distintos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "Solo con nosotros, sería complicado despejar sus campamentos a tiempo. Y me preocupa que algo malo le suceda a la Aldea Chingtsé si tardamos demasiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarnos y deshacerte de una parte de los monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Eso no servirá de nada... Necesitamos refuerzos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "Ya despejé los campamentos de monstruos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Muchas gracias, pero me temo que ha ocurrido un imprevisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "Pensé que los monstruos que deambulaban por los alrededores de la Aldea Chingtsé eran normales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "Despejé un campamento junto a mis soldados e íbamos a descansar antes de seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "Pero, entonces, un Lawachurl Acorazado apareció de la nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "Nos atacó antes de que pudiéramos reaccionar a tiempo y mucha gente salió herida... Así que tuvimos que retroceder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "Ese monstruo es una amenaza demasiado grande como para ignorarlo, pero los otros soldados aún no han regresado de despejar otros campamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarnos a derrotar a ese monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Muchas gracias, y perdón... Hacerlo debería ser responsabilidad nuestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "¿Cómo están los heridos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "Conseguimos ayuda rápidamente, así que nadie está herido de gravedad, pero les costará moverse por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "#Por eso, te necesitamos para derrotar al monstruo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "Lo siento mucho... Esto debería ser responsabilidad nuestra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
