			"dialogs": [
				{
					"id": 200350201,
					"content": "¿Has encontrado mi llave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350202
					],
					"speakerTitle": "Wyatt"
				},
				{
