						200350402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350402,
					"content": "Encontré esta llave, ¿es la tuya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200350403
					]
				},
				{
					"id": 200350403,
					"content": "¡Sí! ¡Es esa! No puedo permitir que vuelva a suceder... Realmente debo controlar mi consumo de alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350404
					],
					"speakerTitle": "Wyatt"
				},
				{
