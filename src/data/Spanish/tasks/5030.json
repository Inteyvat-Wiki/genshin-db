						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "¿Se encontraron con algún problema en el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Bueno, nos encontramos con unos monstruos del Abismo y tuvimos que luchar por nuestras vidas. Pero todos lo hicieron genial. Fueron tan valientes y ágiles como unos guerreros bien entrenados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Supongo que la memoria muscular nunca se atrofia, jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Me siento muy afortunado de seguir vivo. Tenemos que sobrevivir para poder recuperar lo que hemos perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Ustedes también tienen que sobrevivir, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
