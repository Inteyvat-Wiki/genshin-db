			},
			"dialogs": [
				{
					"id": 50301401,
					"content": "#Cuánto me alegro de que hayan regresado san{F#a}{M#o}s y salv{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "¡Ya te dijimos que nos veríamos en la Arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Jeje. ¿Saben? Es la primera vez en mi vida que derroto a un monstruo del Abismo, y al hacerlo, me di cuenta de que... no son tan duros como pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "Dejé que el miedo se apoderara de mí y por culpa de ello perdí la oportunidad de proteger a mucha gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "No seas tan duro contigo mismo. Lo más importante ahora mismo es permanecer vivos. Tenemos que sobrevivir para que alguien pueda contar las historias de todas esas personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Vivirán para siempre en nuestros corazones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
		},
