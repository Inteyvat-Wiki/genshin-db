			"dialogs": [
				{
					"id": 50300601,
					"content": "Menos mal que Mayáhuel está aquí. Con su conocimiento, hemos curado a un montón de gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
					"speakerTitle": "Quispe"
				},
				{
					"id": 50300602,
					"content": "Sin embargo, me preocupa que se esté esforzando de más. No ha parado en todo este tiempo. Necesito que alguien le tome el relevo para convencerla de que se tome un descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quispe"
				}
			]
