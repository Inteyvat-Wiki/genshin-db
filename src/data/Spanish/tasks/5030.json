				"points": []
			},
			"dialogs": [
				{
					"id": 50300901,
					"content": "Oh, son ustedes dos. Pensé que no volveríamos a vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "Peleé bien y ganamos, aunque el precio a pagar fue alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "¿Ustedes van a seguir luchando? Si lo van a hacer, por favor, tengan cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Es un honor luchar contra el Abismo, pero el camino hacia la victoria no es el honor y la gloria, sino sobrevivir hasta el día siguiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
