			"dialogs": [
				{
					"id": 50300301,
					"content": "¿Qué tal, nos quedan suficientes medicinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayáhuel"
				},
				{
					"id": 50300302,
					"content": "Estamos bajo mínimos. Nos quedan unas pocas reservas de emergencia, pero no podemos utilizarlas. Son para los médicos y los guerreros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Quispe"
				},
				{
					"id": 50300303,
					"content": "Lo sé, lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayáhuel"
				},
				{
					"id": 50300304,
					"content": "Bueno... pues dame los míos.",
