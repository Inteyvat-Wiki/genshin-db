				"objectNames": [
					"Uturunku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "¡Son ustedes dos! ¡Genial! De verdad, muchas gracias por haberme animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Muchas personas en Natlan consideran un honor luchar contra el Abismo, pero dejan que la emoción tome en control de ellos y acaban poniéndose en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Tenían ustedes razón. Luchar es importante, pero también lo es permanecer vivo. Luchamos por la gente que amamos y por la posibilidad de verlos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Les conté su opinión a mis compañeros de armas y todos se sintieron muy inspirados al oírla. Ahora todos luchan con más determinación, ¡y estamos volviendo la situación a nuestro favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Así que, una vez más, ¡gracias de corazón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
