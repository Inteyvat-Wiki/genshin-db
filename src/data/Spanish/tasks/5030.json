			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Por Los Siete, estoy ya sin aliento... No tenemos ni gente ni suministros, y hay un montón de heridas que no puedo curar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Quispe"
				},
				{
					"id": 50300102,
					"content": "Ojalá tuviera a un doctor conmigo... Arg, no, no puedo pensar en eso. ¡Tengo que estar a la altura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Vi que trajeron con ustedes a Chuychú... Qué tragedia. Era la doctora más prometedora que he conocido nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Teníamos una estrecha colaboración. Ella tenía unos estándares muy altos para suministros médicos y a veces ponía de su propio dinero para tratar a sus pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Me solía decir todo lo que valoraba la experiencia por encima del dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Decía que tenía que perfeccionar sus habilidades para salvar a más gente aún, pero sobre todo, para ayudar a la persona que más quería salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Por desgracia, la persona a la que no pudo salvar al final fue a sí misma, y ahora Natlan ha perdido a una de las personas con más talento que teníamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
