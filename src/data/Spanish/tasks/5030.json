					"nextDialogs": [
						50301004
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301004,
					"content": "Odio no poder hacer mi trabajo, sobre todo con lo que han empeorado las cosas, pero uno tiene que ser consciente de sus límites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raman"
