					"nextDialogs": [
						50301103
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301103,
					"content": "No hay de qué, nos alegra que estén bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301104,
					"content": "También debería darles las gracias a esos señores que nos ayudaron... ¿Cómo era que se llamaban? ¿Los Fati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301105
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301105,
					"content": "¡Los Fatui!",
