					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "¡Eso, los Fatui! Son muy fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "La verdad es que yo tampoco he tenido nunca una muy buena opinión sobre ellos, pero esta vez me han hecho mirarlos con otros ojos. Ya veo que hasta entre ellos puede haber buena gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
