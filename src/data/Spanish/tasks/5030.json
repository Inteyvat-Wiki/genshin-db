						50300505
					],
					"speakerTitle": "Mayáhuel"
				},
				{
					"id": 50301601,
					"content": "Oh, son ustedes. Qué alegría que estén bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayáhuel"
				},
				{
					"id": 50300506,
					"content": "¿Cómo está tu hijo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "No lo sé. Se ha cortado toda comunicación y tengo que concentrarme en todos los heridos que llegan sin cesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayáhuel"
				},
				{
					"id": 50300508,
					"content": "Pero confío en él. Sé que, llegado el momento, sabrá tomar la decisión correcta, porque es mi hijo y siempre estaré orgullosa de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayáhuel"
				}
			]
		},
