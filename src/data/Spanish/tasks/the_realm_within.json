				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "Ciertamente, esta es la Campana purificadora, y en muy buenas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Pongamos el perfume que preparamos en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "¿Conoces a Madam Ping?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Por supuesto. Si no, ¿cómo iba a saber que la Campana la tenía ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Es un poco sospechoso... Pero si no quiere hablar de ello, no insistiremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "¡Ah, por cierto! Madam Ping nos pidió que le dijéramos algo:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "“Si tiene tiempo, venga a beber una taza de té conmigo. Puede que no tenga muchas cosas, pero sí una buena tetera”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Jajaja, ese tono de voz no queda contigo. Pero es cierto que su tetera es muy buena. Es la mejor para hacer té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Tan pronto como tenga tiempo, la visitaré y llevaré un buen té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Bueno, ¿cuál es el siguiente paso en la preparación del Rito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Lo siguiente es... ir a comprar <color=#00E1FFFF>Cometas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "¡Oh! ¡A Paimon le encantan las cometas! ¿Nos vas a llevar a volar cometas? ¿Es nuestra hora de descanso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Jaja, no, no. Es cierto que las cometas son un juguete para niños, pero también tienen un significado simbólico en los ritos de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Se los explicaré más adelante. Pero lo primero es lo primero: debemos comprar las cometas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Oh, está bien. Es cada vez más curioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "¿Eres un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "¿Un Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
