			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Todo está en constante cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140102,
					"content": "Saludos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "#¿Eh? Jovencit{F#a}{M#o}, ¿vienes a mirar las flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140104,
					"content": "Qué lástima. Llegaste en mal momento. Los lirios de cristal ya se marchitaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140107,
					"content": "¿Qué les pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "En mis tiempos, se decía que los lirios de cristal podían leer el corazón de las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140109,
					"content": "Si escuchan sonidos agradables, como una risa o una canción, se ponen contentos y les crecerán unas hermosas flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140110,
					"content": "Pero si escuchan demasiados sonidos desagradables, como rumores y chismes infundados, se marchitarán rápidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140111,
					"content": "Oh... Entonces, las flores están sintiendo cómo está la situación actual de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Así es. Los rumores sobre la muerte de Rex Lapis no son poca cosa. Se escuchan por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140113,
					"content": "Algunos dicen que es un complot de los Fatui. Otros dicen que son un invento de las Siete Estrellas, y otros piensan que aquello que yace en el mar se está despertando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140114,
					"content": "Este puerto es como un montón de madera junta. La más mínima chispa crearía un fuego que nos consumiría a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140115,
					"content": "#Bueno, no diré más. Ya saben, soy mayor y me gusta hablar... Jovencit{F#a}{M#o}, ¿qué era lo que querías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140116,
					"content": "¿Podría prestarnos la Campana purificadora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ah, recuerdo ese artilugio. Debe estar por aquí, pero no sé dónde exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140118,
					"content": "Un viejo amigo mío solía llevarla consigo cuando éramos jóvenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140119,
					"content": "Se dio cuenta de que yo solía quedarme mirándola fijamente y, entonces, me la regaló.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140120,
					"content": "Pero también me dijo que, si alguna vez alguien quería tomarla prestada, no debería negarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140127,
					"content": "En todos estos años, mucha gente ha venido a pedirla prestada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140128,
					"content": "Pero no recuerdo cuándo fue la última vez que alguien vino por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140129,
					"content": "Ay... Ya soy mayor, me duelen los huesos y soy muy lenta buscando cosas. No sé si pueden esperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140130,
					"content": "#La podemos buscar nosotr{F#as}{M#os} mism{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "#Sí, le acompañamos de vuelta a casa y, después, la buscamos nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "¡Y también le ayudaremos a organizar todo esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Muy bien, jóvenes. No se preocupen, la Campana no debe estar muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140136,
					"content": "¿Eh, vive usted por aquí? ¡Guau! Pero si esto es la Terraza Yujing... Debe ser muy caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Jaja. Una anciana como yo no puede permitirse una casa en la ciudad. ¿Ven esta tetera? Todas mis posesiones están dentro de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140138,
					"content": "¿Cómo funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "¿Sus llaves están ahí dentro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "#Jajaja. Jovencit{F#as}{M#os}, la Campana está en esta tetera. Si quieren encontrarla, solo tienen que mirar por ustedes mism{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140140,
					"content": "¿Todas sus posesiones son una campana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "¡Oye, no seas descortés!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "Y, si es así, ¡seguro que es porque es una campana muy valiosa! ¿Verdad, señora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Paimon, métete en la tetera a ver qué hay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "¿Qué? ¡Paimon no cabe ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "¿Por qué iba a hacerlo? ¡Levanta la tapa y mira tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "#¡Soy {F#una buscadora}{M#un buscador} de objetos perdidos certificad{F#a}{M#o} por los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "#¿Cómo puedes sentirte orgullos{F#a}{M#o} de algo tan extraño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Quería saber si podría prestarnos esa cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "¿Qué cosa? ¡Ah! ¿La Campana purificadora, dicen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140123,
					"content": "#Aparte de ella, no tengo nada más que pudiera interesarle a {F#una}{M#un} joven como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140124,
					"content": "Lo siento. La Campana no es mía, es de un viejo amigo que solía llevarla puesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140125,
					"content": "De joven era muy coqueta. Me gustaba esa Campana, así que le insistí mucho para que me la diera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140126,
					"content": "No consiguió hacerme cambiar de opinión, así que al final me la regaló. Pero también me dijo que, si alguna vez alguien quería tomarla prestada, no podía negarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140105,
					"content": "¿Le ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "No, no es nada. Solo que vi que los lirios de cristal ya se marchitaron y me pareció una lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "#Jovencit{F#as}{M#os}, ¿no tenían tanta prisa en buscar la Campana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140202,
					"content": "Pero tengan cuidado. Hace tiempo que no limpio la tetera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140203,
					"content": "No será fácil limpiar esa ropa tan hermosa que llevan si se ensucia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "#¡Qué rápido la encontraron! Son un{F#as}{M#os} jóvenes muy ágiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140302,
					"content": "¿E-es usted un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Adeptus... Hacía mucho tiempo que no escuchaba a nadie decir esa palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140304,
					"content": "En cuanto a tu pregunta, supongo que ya sabes la respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140312,
					"content": "Humm... Paimon cree entenderlo y, al mismo tiempo, no. En fin, ¿de verdad nos va a dar la campana así, sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "¿No le parece extraño que hayamos venido a buscar la campana justo cuando algo le ocurrió a Rex Lapis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "#No sean ingenu{F#as}{M#os}. Muchas cosas han ocurrido en Liyue a lo largo de su historia. En todo este tiempo, ha presenciado la partida de numerosos Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140315,
					"content": "Pero, fuese como fuese, la celebración del Rito del Ascenso siempre fue lo primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140316,
					"content": "Lo que no está bien es que, de un día para otro, empecemos a gritar “¡Atrapen al asesino!” y demoremos el Rito del Ascenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140317,
					"content": "Ahora que han venido por la campana, imagino que, quizás, se deba a que un viejo amigo mío finalmente decidió tomar cartas en el asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140318,
					"content": "Así que, ¿cómo no voy a querer prestársela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140319,
					"content": "¿Y si su amigo no le devuelve la campana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Jajaja. Si se atreviera a hacer eso, entonces tendría que hacerle una visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140321,
					"content": "Además, como no nos hemos visto en mucho tiempo, podríamos aprovechar para beber un té mientras nos ponemos al día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140326,
					"content": "Bueno, ya tienen la campana. Hagan lo que tengan que hacer, y no se demoren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140327,
					"content": "Ah, y díganle a la persona que les mandó venir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140328,
					"content": "que si tiene tiempo, venga a beber una taza de té conmigo. Puede que no tenga muchas cosas, pero sí una buena tetera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140329,
					"content": "¡De acuerdo! ¡Gracias, señora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Entonces, ¿me regala la campana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "¡Oye! La campana es de ella. Se la tenemos que devolver después de usarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "#¿Regalártela? Jaja, eres {F#una}{M#un} joven muy sincer{F#a}{M#o}. Si la quieres, puedes quedártela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140325,
					"content": "Pero te advierto: la campana está muy apegada a esta casa. Podría estar de vuelta en cualquier momento sin que te dieras cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140305,
					"content": "¿Es una de las Siete Estrellas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Las Siete Estrellas... Esos jovencitos dejaron de pedirnos consejo a mis amigos y a mí hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140307,
					"content": "Pero es cierto que no hacen mal su trabajo. Así yo y mis amigos podemos estar tranquilos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140308,
					"content": "¿Es de los Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "#¿Los Fatui? Jajaja. Jovencit{F#a}{M#o}, ¿pero qué cosas dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140310,
					"content": "Con lo mayor que soy, ¿tú crees que estoy de humor para discutir con ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140311,
					"content": "Pero si se pasan de la raya, haré lo que tenga que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 101404,
