					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Lo sentimos, no atendemos a la gente común. Les pido que se retiren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "¡Espera! No somos gente común...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "#Entonces... a juzgar por su atuendo, deben ser dos foraster{F#as}{M#os} que se infiltraron en la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "¿Es nuestra ropa realmente tan...? Oh, oh... Paimon quiso decir que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Esta es nuestra carta de invitación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Humm, el sello de la Comisión Yashiro... Debe ser del Sr. Thoma. Parece que son más de lo que salta a la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "#En cuyo caso, bienvenid{F#as}{M#os} a la Casa de Té Komore, un refugio seguro para la Comisión Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Bien, así está mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
