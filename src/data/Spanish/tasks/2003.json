				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Así que este es el tipo de lugar donde vive la crema y nata de Inazuma, ¿eh? Paimon esperaba que fuera... más elegante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Es difícil superar a la Cámara de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "#Al fin. Querid{F#as}{M#os} invitad{F#as}{M#os} de honor, sean bienvenid{F#as}{M#os} a la residencia Kamisato. La Srta. Kamisato está encantada de conocerl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "¿Es la Princesa Garza de la que no dejas de hablar? Entonces... ¿dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Oh... ¿Detrás del biombo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Sí, jaja, como descendiente de la Comisión Yashiro, así es como la Srta. Kamisato acostumbra a recibir invitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Considérenlo como una antigua tradición de la Comisión Yashiro. Espero que puedan comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Lo entiendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Tiene sentido. Después de todo, ella es una persona superimportante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "#Perdonen mi falta de cortesía por recibirl{F#as}{M#os} de esta manera, especialmente después de un viaje tan largo y agotador en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "He esperado su llegada con muchas ansias. Thoma me asegura que posees el poder para cambiar el cauce de la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Actualmente, en Inazuma, las aspiraciones de la gente son pisoteadas injustamente en nombre del Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Aunque la Comisión Yashiro está al servicio de la Shogun, por razones de oficio debemos mantener un vínculo estrecho con el pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "El poder de una comisión aumenta o disminuye con la confianza de su gente. Por lo tanto, quedarnos de brazos cruzados ante esta situación es permanecer indiferentes a nuestro propio destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "#Viajer{F#a}{M#o}, con tu poder podremos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Solo vine a ver a la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Es como le dije, señorita. No nos llevará a ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Con su permiso, me retiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "No, por favor... ¡Espera! Te lo pido, no te vayas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Te presentaré a la Shogun Raiden con una condición... Debes cumplir tres pequeños deseos por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "¿Qué deseos son esos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "Son los deseos de tres personas que han perdido sus Visiones... Quizás cuando las conozcan, lo entenderán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Un guerrero que protege una aldea, un antiguo samurái que ayudó a implementar el Decreto de captura de Visiones, y un maestro de la espada decidido a convertirse en el mejor del mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "Así es. Por favor, hagan todo lo que puedan para ayudarlos. Estaré esperando a su regreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "Acepto el trato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Jeje... Te lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "#Ánimo, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030433,
					"content": "Suena a una tarea difícil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "No vine a iniciar una rebelión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(Es un poco decepcionante...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Es difícil superar al Viñedo del Amanecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
			]
		},
