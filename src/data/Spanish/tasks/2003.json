	"talks": [
		{
			"id": 200301,
			"completionStepIds": [
				200301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200301",
							"2"
						],
						"stepId": 200301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Bueno, ahora que estamos aquí, ¿dónde está Thoma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "#*Suspira*, Paimon no lo ve por ninguna parte. ¿Crees que olvidó su promesa de reunirse con nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "¿Quién olvidó su promesa? ¡Empezaba a pensar que se habían olvidado de mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030104,
					"content": "¡¿Q-Qué?! ¡¿Ese perro nos está hablando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "Jajaja, relájense, no hay de qué sorprenderse. Supongo que esta es la primera vez que me ven en esta forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030106,
					"content": "¿Eres... un perro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "¿No vieron nada así cuando estaban en Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030109,
					"content": "Ahora que lo dices de esa forma, suena menos fuera de lo común...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Pero sigue siendo extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Jajaja. De acuerdo, basta de diversión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030113,
					"content": "¡Oye! ¡Estás a punto de ganarte un apodo horrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "#Bueno, ya sea en el salón de té o en Ritou, llevo mucho tiempo esperándol{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030115,
					"content": "#... así que se me ocurrió recibirl{F#as}{M#os} de una manera especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030116,
					"content": "Espero que puedan perdonarme por esa pequeña prueba por la que pasaron antes. Era realmente necesaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030117,
					"content": "#Nos ayudó a decidir si podía llevarl{F#as}{M#os} ante la Srta. Kamisato, y si tendrían el valor de enfrentarse al relámpago junto a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030118,
					"content": "¡No creas que Paimon te perdonará solo porque ahora te estás poniendo serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Jaja... Lo siento, ¿quizás me excedí? Les pido disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030120,
					"content": "¿Qué tal nos fue en la prueba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Desde el principio te has visto eludiendo las reglas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030123,
					"content": "#Naturalmente, esto es porque no estás dispuest{F#a}{M#o} a ceder, debido a tu determinación inquebrantable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030124,
					"content": "Hace mucho tiempo, teníamos un amigo que era muy similar... pero cuando cayó el rayo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030125,
					"content": "Te refieres al amigo de Kazuha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ah, entonces has oído hablar de su historia, humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030128,
					"content": "Su luz nunca ha dejado de brillar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030129,
					"content": "Entonces, ¿podemos vernos con la Princesa Garza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "#Sí, por supuesto. L{F#as}{M#os} llevaré a la residencia Kamisato, donde se encuentra la Comisión Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030131,
					"content": "Pero antes de eso, esperaba que me pudieran acompañar a otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030132,
					"content": "¿Eh? ¿A dónde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "Me gustaría que vinieran conmigo a la Estatua de la Diosa Omnipresente. Todavía está en construcción, pero ya se puede ver desde prácticamente cualquier punto de la Isla Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030126,
					"content": "Quieres decir que murió en un duelo ante el trono...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "¿A qué te refieres con “el valor de enfrentarse al relámpago”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Reconozco un perro cuando lo veo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "¿Dónde quedó el Thoma de aspecto humano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Este lugar es muy deprimente. Seguro que la gente no viene aquí a menudo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "¿Eh? ¿Es imaginación de Paimon o hay cosas incrustadas en la estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Son Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030204,
					"content": "¡Visiones! ¡¿Quieres decir que todas las Visiones que recogen con el Decreto de captura de Visiones están incrustadas en esta estatua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "¿Por qué la Shogun emitió el Decreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Así que ya han oído hablar del Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030207,
					"content": "Antes de darles una explicación, quizás debería recordarles primero que Mondstadt es la Ciudad de la Libertad y Liyue es la Ciudad de los Contratos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030208,
					"content": "En cuanto a Inazuma... es conocida como “la Nación de la Eternidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030209,
					"content": "La Shogun Raiden es la mayor autoridad de la nación, así como su deidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030210,
					"content": "En cuanto a la “eternidad” de la que hablo, se refiere a su mandato eterno e inmutable sobre la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030211,
					"content": "Como tal, deposita su confianza en el Triunvirato para administrar los asuntos de la nación y en el Decreto de cierre de fronteras para limitar el flujo de la población.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030212,
					"content": "La Shogun desea mantener a Inazuma estática, permitiendo que la corriente del tiempo fluya sin perturbaciones y eternamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030213,
					"content": "Parece que cada divinidad tiene su propia forma de pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Bueno, mi comprensión limitada llega hasta aquí. En cuanto a la razón tras el reciente Decreto de captura de Visiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030215,
					"content": "Quizás la Shogun cree que las Visiones otorgan al pueblo la facultad de cambiar, y tal inestabilidad no tiene cabida en la eternidad a la que ella aspira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030216,
					"content": "Sea como fuere, la Shogun Raiden ordenó a la Comisión Tenryou rastrear la nación entera en busca de Visiones para incrustar todas y cada una de ellas en esta estatua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030217,
					"content": "... Y esta Estatua de la Diosa Omnipresente puede interpretarse como símbolo de la eternidad de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030218,
					"content": "Si ese es el caso, ¿no crees que la Shogun Raiden está siendo... egoísta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "#Jaja, solo un{F#as}{M#os} foraster{F#as}{M#os} como ustedes se atreverían a hablar sin pelos en la lengua sobre la Shogun Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030220,
					"content": "Sin embargo... estoy de acuerdo. El Decreto de captura de Visiones no debería existir, y la Srta. Kamisato se comprometió a luchar contra él desde el día en que fue proclamado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030223,
					"content": "¿Qué fue ese sonido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Oye, {NICKNAME}, ¿qué pasa? Te ves distraíd{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "¿Eh? ¿De qué sonido hablan? No escuché nada... ¿Ocurrió algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030225,
					"content": "Podía escuchar... las ambiciones de la gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Sí, tocaste la estatua y luego... ¿qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "¿“Ambiciones”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030227,
					"content": "Humm... Tal y como dicen los rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030228,
					"content": "¿No has oído hablar de ello? Dicen que cuando la ambición de uno es muy fuerte, los propios dioses te miran favorablemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030229,
					"content": "De ahí es de donde vienen las Visiones... En otras palabras, la Visión de una persona representa su ambición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030230,
					"content": "Entonces, si lo que dices es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030232,
					"content": "Entonces, una Visión simboliza la ambición y no el poder...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "... Las ambiciones de la gente son más fuertes de lo que pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030233,
					"content": "Bien, es hora de ir a la siguiente parada en nuestro recorrido por la isla Narukami: la residencia Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030234,
					"content": "¡Yuju! ¡Al fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200303,
