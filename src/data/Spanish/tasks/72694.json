			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940301,
					"content": "¿Has recolectado las materias primas con el Recolectamateriales? El aspecto de los juguetes fabricados depende en gran medida de las materias primas usadas, así que tienes que pensártelo bien, jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269404,
			"completionStepIds": [
				7269404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269404",
							"2"
						],
						"stepId": 7269404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "¿Cómo va la recolección de materiales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940402,
					"content": "Ya están todos en el Recolectamateriales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Estupendo. Entonces, metamos los materiales recogidos en mi grandiosa y única...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "En tu “Megamáquina”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940405,
					"content": "Bueno, está bien. Metamos los materiales en la Megamáquina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940406,
					"content": "Bertrand inserta el Recolectamateriales en la ranura de la Megamáquina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "¡Guau! ¿Y ahora qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940408,
					"content": "¿Se pondrá esta máquina a hacer “tut, tut, tut” y luego “cric, crac, cric, crac” y, “¡pum!”, sacará un juguete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940409,
					"content": "¡Jajaja! Por supuesto que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940410,
					"content": "... No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940411,
					"content": "¿Qué creías? Solo hemos terminado uno de los tres procesos, aún falta mucho para fabricar juguetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940412,
					"content": "¿Así que hay que completar todos los procesos para obtener los juguetes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940413,
					"content": "Exacto. Los juguetes solo pueden fabricarse tras completar todos los procesos por orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940414,
					"content": "Suena fastidioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "¡Pero bueno! Siempre con las mismas prisas. Cada etapa de fabricación de juguetes requiere su tiempo. Cada proceso requiere de todo nuestro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940417,
					"content": "¿Todo nuestro qué? Ah, Paimon ya entiende. Si estamos fabricando juguetes, ¡lo que necesitamos es todo nuestro entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940418,
					"content": "¡Exacto! Todo mi entusiasmo por los Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940419,
					"content": "Oh, aunque no es lo que Paimon se esperaba, ¡Paimon comparte ese entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940420,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Jeje, Paimon solo lo decía por decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940422,
					"content": "Entonces, Bertrand, ¿qué tenemos que hacer a continuación? ¿Completar los siguientes procesos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940423,
					"content": "No tan rápido. Dado que hace poco que ajusté la máquina y este proceso aún está en fase de pruebas, tendré que comprobar que no haya ningún problema al procesar los materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940424,
					"content": "Me llevará un tiempo, así que pueden regresar más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940415,
					"content": "Suena complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
		{
			"id": 7269405,
