	"talks": [
		{
			"id": 7269401,
			"completionStepIds": [
				7269401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269401",
							"2"
						],
						"stepId": 7269401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "#Viajer{F#a}{M#o}, Paimon, ¡hola! ¡Llegan justo a tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "¿Justo a tiempo para qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "#Para llevar a cabo una misión que les va como anillo al dedo. Justo estaba pensando en llamarl{F#a}{M#e}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "¿Una misión que nos va como anillo al dedo? No se tratará de algo como buscar cosas o eliminar Hilichurls, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "O subir al tejado a recoger basura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "No, no, nada de eso. Esta vez sí que es una misión idónea para ustedes. Lo que quiero decir con eso de “como anillo al dedo” es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "Esta misión no solo es muy divertida, sino que también podrán obtener una gran recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "¡¿Una jugosa recompensa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Lo de interesante no cuenta, ¿eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "¿Eh? ¡Ah! Claro, claro. Lo principal es que sea interesante. ¿De qué encargo se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "Bien, quien manda este encargo es un fabricante de Fontaine llamado Bertrand que vino a hacer negocios a Inazuma. Está buscando ayuda para fabricar algunos productos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "Se ve que es un hombre de negocios, la cifra que puso en el apartado de recompensa al registrar su encargo en el Gremio de Aventureros es bastante considerable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "Pero hay ciertos motivos que le impiden salir de Ritou. Él mismo les puede explicar los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "¡Bien, iremos a Ritou a buscarlo ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "O transportar alguna mercancía extraña...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Jaja, ya está todo listo. Venderé cada juguete por miles de Moras... ¡Y venderé miles de ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "¡Así ganaré millones de Moras! Jejeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "¡Hola! ¿Eres Bertrand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "¿Eh? Sí, soy yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "¿Qué pasa? ¿Acaso han oído hablar de mí y vienen a comprar los juguetes que fabrico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Es una pena, pero no puedo vendérselos ahora mismo porque aún no he comenzado a producirlos a gran escala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "#Pero no se apuren, ya estoy montando una cadena de producción. Así que si están interesad{F#as}{M#os}, pueden registrarse primero y pagar un depósito. Cuando los productos estén listos, les avisaré para que paguen el resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "¡Un momento, un momento! No hemos venido a comprar tus juguetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Oh, entonces... Vamos, díganme qué quieren. ¿No ven que estoy ocupado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "Hablando en plata, mi tiempo es oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "¡Guau! Vaya cambio de actitud tan repentino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Estamos aquí para ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "#¡Por Los Siete! Son {F#las}{M#los} aventurer{F#as}{M#os} que solicité como ayudantes, ¿cierto? ¡Bienvenid{F#as}{M#os}! ¡Deberían haber dicho desde el principio que venían a ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Así es, yo publiqué ese encargo en el Gremio de Aventureros, ¿serían tan amables de decirme sus nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Vaya, otro cambio repentino de actitud...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Paimon se llama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "¿Y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}... Ese nombre me suena, no será que... ¿también son criminales buscados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Lo hemos sido más de una vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Puede que lo escuchara cuando fui arres... quiero decir, cuando fui citado a la Comisión Tenryou para responder unas preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "¿Qué es lo que hiciste para que la Comisión Tenryou fuera a llamar a tu puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "Oh, no es nada grave. Solo que el último lote de juguetes que fabriqué tenía unos insignificantes defectillos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "¿Insignificantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "¿Defectillos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Jeje, es solo que explotaban si golpeabas accidentalmente el mecanismo de accionamiento interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "¿Dices que explotaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "*Ejem*, solo es un pequeño defecto, tampoco es que nadie resultara herido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Pero esos guardias de la Comisión Tenryou requisaron todos los juguetes sin mediar palabra... ¡Podría haberlos vendido como bombas de aspecto adorable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "*Suspira*, incluso solicité un préstamo a la Cámara de Comercio Internacional cuando vine de Fontaine para poner el negocio en marcha. ¿Cómo iba a imaginarme que restringirían mis movimientos a Ritou? Si sigo así, será mi ruina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Pues a Paimon le parece que tú te lo buscaste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "¡Un momento! Si le debes dinero a la Cámara de Comercio Internacional, ¿cómo vas a pagar la recompensa tan jugosa que pusiste en tu encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "No se apuren, aún me queda algo de dinero. Además, podré pagar todas mis deudas sin problemas si consigo volver a fabricar juguetes y venderlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "¡Y así podré pagarles esa jugosa recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "¿De verdad dará resultado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "No subestimes el potencial de mercado que tienen los juguetes en Inazuma. Mis juguetes eran muy populares antes de que descubrieran que podían explotar... Y se volvieron más populares aún después de tal descubrimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "Y si no puedo venderlos, siempre puedo pagar con ellos la deuda que tengo con Kurisu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Por eso les ruego que me ayuden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Bien, pero... ¿en qué quieres que te ayudemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "Bueno, fabrico todos mis juguetes con esta “grandiosa y única máquina de fabricación de ingeniería con caldera de segunda generación superestable” que yo mismo he desarrollado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "Por cierto, hablando de mi grandiosa y única máquina de fabricación de ingeniería con caldera de segunda generación superestable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Ese nombre es demasiado largo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Sí, sería mejor llamarla... A ver que Paimon piense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "La llamaremos “Megamáquina”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "No, no. ¡Eso es demasiado corto! ¡Así no da sensación de grandeza en absoluto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Cuanto más corto sea, más fácil de recordar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "Paimon cree que “Megamáquina” suena superbién.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "*Suspira*... De acuerdo, lo cierto es que en el pasado alguien me dijo que se me daba mal poner nombres, así que confiaré en ti esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "Tampoco es que a Paimon se le de muy bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Jajaja, en todo caso, mi “Megamáquina” puede analizar los materiales introducidos, procesarlos de la manera más adecuada y proceder al montaje, todo de forma automática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Pero la última vez añadí algunos mecanismos extraños que dieron lugar a juguetes explosivos. Esta vez he tenido muy en cuenta este error y la he modificado... En teoría, este problema debería estar resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "¿“En teoría”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "Por eso precisamente necesito a alguien que me ayude a hacer algunas pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "En resumidas cuentas, el proceso de recolección consta de tres partes: la recolección de materias primas, la recarga elemental y la activación del núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Necesitamos cosas como minerales, frutas o flores que servirán como materias primas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "La siguiente etapa consiste en imbuir los materiales con energía elemental para asegurar que el producto funcione, y la última consiste en usar la energía procedente de los núcleos de criaturas elementales para mantener la carga del producto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Hoy intentaremos la primera etapa, ¡la recolección de materias primas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Toma este Recolectamateriales. Recuerda introducir directamente en él cualquier material que recojas para evitar que se contamine con otros elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Bien, ajustaré de nuevo el aparato. ¡Dejo la recolección de materiales en sus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "¿Cómo que “también”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Jaja, es una larga historia. A mí también me interrogó la Comisión Tenryou debido a algunos pequeños incidentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "Dejaste un encargo en el Gremio de Aventureros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
		{
			"id": 7269403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
