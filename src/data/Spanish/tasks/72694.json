					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940501,
					"content": "Si esto es lo que gano por vender uno de estos, ¡entonces tengo que vender veinte mil para pagar mi deuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940502,
					"content": "Parece que pagar la deuda no va a ser tan sencillo... ¿Qué pasa? ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "¿Qué quieres vender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Me dispongo a vender juguetes, pero... desgraciadamente, todavía están en preparación. No dudes en venir cuando estén terminados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "Si no tienes nada que decir, entonces no me molestes. Estoy preparando unos productos muy importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		}
	]
}