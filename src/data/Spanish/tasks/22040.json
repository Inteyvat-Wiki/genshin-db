			"dialogs": [
				{
					"id": 220400101,
					"content": "Así no hay forma de hacer negocios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ah, lo siento. Solo estaba pensando en mis cosas. ¿Estás aquí para comprar ropa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Las sedas de alta calidad de Liyue siguen agotadas, pero todavía nos quedan los últimos kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "¿Solías importar material de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Sí. Antes podíamos conseguir seda de alta gama de Liyue, como las que el Gremio de Comerciantes de Feiyun fabrica con flores de seda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Pero con la situación actual de Inazuma, no podemos importar esa clase de seda desde hace un tiempo. Tuvimos que depender de nuestras existencias disponibles para seguir trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Cada rollo de seda que usamos es uno más que no vamos a recuperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "En un principio, pensaba diseñar algunos novedosos patrones de kimonos por mi cuenta, o usar algunos tintes nuevos para hacer telas nuevas y atraer clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Pero no puedo pensar en un patrón “novedoso”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "#Viajer{F#a}{M#o}, tú conoces del mundo, ¿has visto algún patrón que consideres “novedoso”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "No precisamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Ya veo... Humm... Quizás sea un poco indiscreto de mi parte, pero ¿podrías preguntarle a otros forasteros qué patrones les gustarían?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Soy la única cuidando de Telas y Kimonos Ogura por el momento, así que no puedo dejar la tienda. Solo me queda pedirle ayuda a otros si quiero recolectar información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Genial, déjame pensar... Deberías ir a preguntarle a la señorita Tang Wen y al señor Ramsay. Quizás ellos tengan algunas nuevas ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
