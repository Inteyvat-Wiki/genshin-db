			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maestro del Té Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015401,
					"content": "... Olas gigantescas se cernían sobre la flota mientras nubes de tormenta negras cubrían los cielos. La tripulación de la Flota Crux Meridianam tenía motivos para estar asustada. Porque, a pesar de que sus barcos eran las mejores naves que jamás habían navegado por los mares, y aunque tenía los mejores marineros,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015402
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223015402,
					"content": "incluso el barco más grande es como un barco de juguete cuando la madre naturaleza desata toda su ira. Las olas rugientes empujaron violentamente hacia el abismo a los diminutos navíos de la flota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015403
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223015403,
					"content": "Pero algo aún peor se estaba gestando. Del interior de las imponentes olas surgió una bestia oscura y gigantesca con ojos como llamas. Los marineros, aterrorizados e indefensos, rogaban por la salvación del Arconte Geo, sin atreverse siquiera a mirar a la bestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015404
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223015404,
					"content": "Y, sin embargo, en la proa del barco se podía ver la intrépida figura de una persona apoyada sobre una espada. La heroica silueta contemplaba a la gigantesca bestia de los furiosos mares mientras esta se alzaba como una montaña sobre la superficie del agua y apuntaba hacia ella riéndose. “Muy bien, querías que te encontrara, ¿cierto?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015405
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223015405,
					"content": "¿Quién era esa heroína? ¿Qué era ese monstruo? ¿Y cuál era la causa de sus rencores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro del Té Liu Su"
				}
			]
		},
