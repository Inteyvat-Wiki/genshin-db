			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maestro del Té Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Si tan solo recordara por dónde me quedé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010102,
					"content": "¿De qué hablabas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Hola, ¿viniste a escuchar más historias? ¿O viniste a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010104,
					"content": "¿Yo? Me gano unas cuantas monedas contando historias para poder comprar té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010105,
					"content": "He contado tantas historias que a veces me confundo. Puedo llegar a desvariar y mezclarlas todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010106,
					"content": "Hace unos días, unos invitados querían escuchar «La ira de Haishan», una historia de la Flota Crux Meridianam, y otros querían escuchar «Lluvia de cuchillas», de la Escuela Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010107,
					"content": "Tengo que ganarme la vida, ¿no? Así que elegí la parte que mejor recordaba de cada historia para que todos estuvieran contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010108,
					"content": "No pensé que le fuera a gustar tanto al público, y ahora quieren saber qué pasó después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010109,
					"content": "Hacía años que no leía estos dos libros, así que tuve que buscarlos por todas partes en mi casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010110,
					"content": "Pero olvidé en qué parte me había quedado en cada libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010111,
					"content": "¿Podrías preguntarle a la gente en qué parte me quedé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010112,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Siento meterte en esto, si yo fuera a preguntar, acabaría con mi reputación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010118,
					"content": "Ahora que lo pienso, hay tres personas a las que les puedes preguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010119,
					"content": "Uno es <color=#00E1FFFF>el Burgués Maotsai</color>. Él nunca se pierde una de mis narraciones. Otro es <color=#00E1FFFF>Fan Erye</color>, el dueño de esta casa de té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010120,
					"content": "Y la última es <color=#00E1FFFF>Jiangzhou</color>. La última vez que conté el libro, la vi escuchándome durante un rato, pero se fue al poco tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010114,
					"content": "¿Por qué no empiezas desde el principio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "También lo pensé, y de paso podría ganar el doble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010116,
					"content": "Pero Fan Erye me echaría a la calle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010117,
					"content": "Siento tener que involucrarte. Ve a preguntar. Yo estaré aquí hojeando los libros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Maestro del Té Liu Su"
				}
			]
		},
		{
			"id": 2230102,
