				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "¡Volviste! Siento molestarte, bien hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010202,
					"content": "Mientras más cuento esta historia, más se me olvida. Vaya problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010203,
					"content": "¿Y bien? ¿Les preguntaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro del Té Liu Su"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
