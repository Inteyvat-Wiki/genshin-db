				{
					"id": 223011701,
					"content": "*Suspira*, ¿cuándo podré tomarme un descanso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011702
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011702,
					"content": "Disculpe, ¿ha escuchado la narración de Liu Su?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011703
					]
				},
				{
					"id": 223011703,
					"content": "¿La historia de... Liu Su?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011704
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011704,
					"content": "Sí, recuerdo que la vez pasada que pasé por aquí me detuve un momento a escucharlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011705
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011705,
					"content": "Pero no recuerdo bien... Déjame pensar... Creo que la historia se llamaba <color=#00E1FFFF>«Lluvia de cuchillas»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011706
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011706,
					"content": "Por varias razones, la situación del Clan Guhua estaba en muy malas condiciones, y en ese momento llegó un sujeto a retarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011707
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011707,
					"content": "Pero llegué tarde, y poco después terminó de contar la historia. Si recuerdo bien, se quedó en que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011708,
					"content": "El protagonista iba a ganar, pero de repente fue emboscado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011709,
					"content": "En ese momento me llamaron para volver al trabajo. De verdad quiero saber qué pasó después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangzhou"
				}
			]
		},
