			"dialogs": [
				{
					"id": 223011401,
					"content": "¡Ese Maestro Liu me pone de los nervios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011402
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011402,
					"content": "Disculpe, ¿ha escuchado la narración de Liu Su?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "Por supuesto, pero es que me pone de los nervios. La última vez que fui a la Casa de Té Heyu lo escuché contar <color=#00E1FFFF>«Lluvia de cuchillas»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011404,
					"content": "Acababa de hablar del monasterio del Clan Guhua en ruinas. Los contendientes llegaban a raudales mientras los discípulos del monasterio desertaban uno tras otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011405,
					"content": "Los discípulos que quedaron tenían la intención de proteger el monasterio, pero el prestigio de la Escuela Guhua se hizo pedazos inevitablemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011406,
					"content": "Pero justo cuando el maestro del Clan Guhua perdió toda esperanza y estaba dispuesto a marcharse para emprender una vida de ascetismo, un joven cuya espada era imbatible llegó a las puertas del monasterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011407,
					"content": "Y, entonces... Ahí se detuvo. ¡Vamos, no nos haga eso! Dijo que sabríamos el desenlace a la próxima, pero ya han pasado muchos días y la historia no parece progresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 223011408,
					"content": "La próxima vez que lo vea, ¡tendrá que dar una explicación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Burgués Maotsai"
				}
			]
		},
