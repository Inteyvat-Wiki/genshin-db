					"Maestro del Té Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "¿Sigues aquí? ¡Jaja! ¿Qué te pareció mi libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010402,
					"content": "¿Algo más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "«Lluvia de cuchillas» y «La ira de Haishan» son dos obras gigantescas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010404,
					"content": "No se pueden contar en pocas palabras. Si quieres escucharlos, puedes venir a las próximas sesiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010407,
					"content": "Gracias por tu ayuda. Toma, tal vez te pida que vuelvas para apoyarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 223010405,
					"content": "Creí que dijiste que el desenlace lo revelarías en el próximo capítulo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "¡Jaja! Si quieres saber el final, tienes que venir más seguido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Maestro del Té Liu Su"
				}
			]
		},
