			"dialogs": [
				{
					"id": 220430301,
					"content": "Sí, estos servirán. Siento pedirte ayuda después de que hayas venido hasta aquí para llegar al santuario... Toma esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Cuando perfeccione la técnica, te enviaré la estatua que mejor me salga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Humm, ¿en qué pose debería tallar a la Suma Sacerdotisa esta vez...?",
