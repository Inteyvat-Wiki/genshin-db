				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Menos mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "#Oh, viajer{F#a}{M#o}, eres tú. ¿Estás al corriente de lo que ocurrió en la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Bueno, al menos no ocurrió nada más después de ese incidente... Y lo que es más importante, los puestos de comida de la ciudad siguen abiertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "Si no, ¿cómo podría seguir comiendo cosas tan deliciosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Ah, hablas de comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Oye, no menosprecies la comida. La mejor forma de saber si un lugar es bueno o no es viendo cómo sabe su gastronomía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Ah, hablar de esto me está dando hambre de nuevo. Tal vez debería ir por algo de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Erye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Cuanto más escucho esta ópera, menos la entiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090302,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "#Oh, viajer{F#a}{M#o}, eres tú. La Casa de Té Heyu sacó varias piezas de ópera hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090304,
					"content": "Son un poco... Bueno, es cierto que tienen un ritmo muy alegre, pero no las comprendo del todo, ni tampoco entiendo por qué a los jóvenes les gustan tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090305,
					"content": "¿Y cuál es tu opinión al respecto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Pues... personalmente, lo que más me gusta son los clásicos. Es a lo que estoy acostumbrado, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090307,
					"content": "Pero Liyue está cambiando, así que supongo que el hecho de que haya óperas nuevas va acorde a esta situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090308,
					"content": "*Suspira*, aun así, estos cambios han sucedido demasiado rápido, y hace mucho tiempo que no ha habido una actuación de ópera antigua. Me pregunto si Rex Lapis... Bueno, no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Erye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180909",
							"2"
						],
						"stepId": 7180909,
