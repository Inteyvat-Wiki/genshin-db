			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "#¿Realizó algún hallazgo, {F#señorita}{M#caballero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090402,
					"content": "Unos cuantos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Oh, ¿en serio? Adelante, le escucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090404,
					"content": "Hay muchos perros en el muelle sur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Oh, maravilloso. Seguro que dotan a la escena de un ambiente muy vivaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090406,
					"content": "Hay muchos pinzones en la Farmacia Bubu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Pinzones... Oh, un símbolo de tiempos de paz, perfecto para mi imaginario lírico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090408,
					"content": "Hay gente a la que solo le interesa la comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Eso no tiene nada de malo. Comer es una de las principales necesidades y placeres de la vida, especialmente en una urbe como Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090410,
					"content": "Todo esto es fascinante. Lo anotaré. Quizás pueda utilizarlo para mis composiciones poéticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090411,
					"content": "Hay gente que piensa que las cosas están cambiando muy rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Bueno, tal opinión es razonable. La actual Liyue experimenta cambios prácticamente a diario. Incluso a mí me resulta complicado aceptar tremendas transformaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090413,
					"content": "Sin embargo, dicha cuestión es demasiado amplia. Temo que no pueda abarcarlo todo en un solo poema. No obstante, lo anotaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090414,
					"content": "Esto bastará. Puedo afirmar que, efectivamente, solicitar su ayuda fue una sabia elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090415,
					"content": "Creo que, gracias a estos temas, podré agregar varios poemas nuevos para mi próxima antología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090416,
					"content": "Ah, cierto. Además de algunos bienes materiales, también le he preparado un pequeño obsequio. Le ruego lo acepte como muestra de mi gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 718090417,
					"content": "Cuando se publique mi nueva antología de poemas, puede cambiar este autógrafo por un ejemplar gratuito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
