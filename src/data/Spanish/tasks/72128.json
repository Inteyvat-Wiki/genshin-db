					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Eres muy perspicaz. Sí, eso es lo que estoy haciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Pero por ahora no te puedo contar el motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "¿Tienen algo especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "Desde luego, tienen algo especial desde el punto de vista comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "“Una caracola afectada por la energía de los tatarigami”... Jaja, ¡seguro que se venderá a un buen precio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "*Ejem*, de todos modos, si me traes ese tipo de caracola, podrás abrir los cofres, ¿entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "Bien, te has quedado sin oportunidades por esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Si quieres volver a abrir uno, trae más caracolas más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "Eso es sospechoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
					"id": 721280510,
					"content": "#Es solo una caracola, así que no seas paranoic{F#a}{M#o}.",
