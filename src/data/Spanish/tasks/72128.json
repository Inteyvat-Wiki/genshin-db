						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Lo siento, pero solo puedes elegir un cofre cada vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
