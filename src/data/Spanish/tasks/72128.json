			"dialogs": [
				{
					"id": 721280102,
					"content": "Oh, espera un momento, esos cofres no se pueden abrir así como así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "¿Son tuyos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Por supuesto, los puse todos aquí a propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "Están llenos de todo tipo de tesoros que yo he recogido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "Si quieres abrirlos, no es que no puedas, pero tendrás que darme algo a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "¿Quieres Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Jajaja, no necesito Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "Quiero un tipo de caracola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "Deberías poder encontrar muchas de estas caracolas por la playa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "Si quieres abrir los cofres y llevarte los tesoros, a cambio dame esas caracolas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "Pero no te diré lo que hay en estos cofres, lo que consigas depende de tu suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "¿Qué te parece? Tráeme esas caracolas y podrás abrir los cofres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "¿Qué es lo que quieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "¿Qué contienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
