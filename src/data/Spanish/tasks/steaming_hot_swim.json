			"dialogs": [
				{
					"id": 250250101,
					"content": "Súbete a la orilla, por favor, que tengo que limpiar la poza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Koholasaurio perezoso"
				},
				{
					"id": 250250103,
					"content": "¡Sé buen chico y ven aquí! Si no, ¡tendré que sacarte yo misma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Koholasaurio perezoso"
				},
				{
					"id": 250250105,
					"content": "Vaya... Y se va nadando, así sin más. ¿Cómo voy a atraparlo ahora?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "¿Eh? ¿Vienes a bañarte en las aguas termales? Lo siento, justo estoy limpiando esta poza, puede que tengas que esperar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Además, esa cría se niega a salir del agua, le diga lo que le diga. Ay, con todas las pozas que me quedan por adecentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "¿Acaso se ha enfadado porque lo saqué a la fuerza hace unos días? Qué fastidio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
