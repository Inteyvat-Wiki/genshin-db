				"objectNames": [
					"El Cobarde Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "¡Ah! ¡Aléjate! ¡Fuera de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230402,
					"content": "¿Eh? Uf, no eres un monstruo... Espera, ¿quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230403,
					"content": "¿Como está la situación con los monstruos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "¡Ja! ¿Tú qué crees? Acabo de venir huyendo de unos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230405,
					"content": "Había muchísimos, y parecía que querían atacar la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230406,
					"content": "Si no hubiera corrido tan rápido, no estaría aquí ahora mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230407,
					"content": "¿Dónde están esos monstruos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Muy cerca, al lado de la aldea. Si caminas un poco, los encontrarás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230409,
					"content": "Tú también deberías refugiarte en algún sitio. Descansaré aquí un poco y luego iré a avisar a toda la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Cobarde Morrow"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
