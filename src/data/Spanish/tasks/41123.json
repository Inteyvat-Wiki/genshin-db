			"dialogs": [
				{
					"id": 411230901,
					"content": "¿Averiguaste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230902,
					"content": "La Aldea Aguaclara ya está a salvo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "¡Excelente! Estaba muy preocupado de no poder enviar a nadie para ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "Huffman"
				},
				{
