			"dialogs": [
				{
					"id": 411231101,
					"content": "#Hola, {F#Caballera Honoraria}{M#Caballero Honorario}. Te aconsejo que no salgas de la ciudad en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231102,
					"content": "Seguramente habrás visto los meteoritos que cayeron afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231103,
					"content": "Por alguna razón, han comenzado a caer con más fuerza que antes, así que el campo es muy peligroso ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231104,
					"content": "Cada vez hay más cosas que hacer en la ciudad, y los Caballeros ya no dan abasto. Además, acabábamos de descubrir una gran cantidad de Ladrones de Tesoros en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231105,
					"content": "Esos tipos harían lo que fuera por un puñado de Moras. Me temo que también intentarán sacar provecho de esta situación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231106,
					"content": "¿Podrías ayudarme a echar a esos ladrones de los alrededores de la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231107,
						411231109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231107,
					"content": "Cuenta conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231108
					]
				},
				{
					"id": 411231108,
					"content": "#No esperaba menos de ti, {F#Caballera Honoraria}{M#Caballero Honorario}. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231109,
					"content": "¿Los Ladrones de Tesoros no le tienen miedo a los meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231110
					]
				},
				{
					"id": 411231110,
					"content": "¡Ja! Por dinero, esos bribones no le tendrían miedo a nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231111,
					"content": "Gracias, y lo siento. Sé que no deberíamos pedirte ayuda para esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
