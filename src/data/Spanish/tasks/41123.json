			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Cobarde Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "¿Eh? ¿Tú otra vez? ¿Que has estado haciendo todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230802,
					"content": "Derroté a todos los monstruos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "#Derrotaste a todos los... ¿Qué? ¿En serio? ¿Tú sol{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230804,
					"content": "Puedes comprobarlo por ti mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Humm... No me atrevo a ir solo. Si me ven, ¡me matarán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230806,
					"content": "Bueno, sea cierto o falso, tengo que avisar a todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 411230807,
					"content": "Si es verdad lo que dices, los Caballeros de la aldea lo verán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Cobarde Morrow"
				}
			]
		},
		{
