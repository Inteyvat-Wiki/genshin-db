			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "#Hola, viajer{F#a}{M#o}. Te aconsejo que no salgas de la ciudad en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Seguramente habrás visto los meteoritos que cayeron afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "Por alguna razón, han comenzado a caer con más fuerza que antes, así que el campo es muy peligroso ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "Cada vez hay más cosas que hacer en la ciudad, y los Caballeros ya no dan abasto. Además, acabábamos de descubrir una gran cantidad de Ladrones de Tesoros en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Esos tipos harían lo que fuera por un puñado de Moras. Me temo que también intentarán sacar provecho de esta situación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "¿Podrías ayudarme a echar a esos ladrones de los alrededores de la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "Sé que debería ser tarea de los Caballeros, pero me temo que no tenemos gente suficiente para resolver este problema. ¿Podrías ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Gracias, y lo siento. Sé que no deberíamos pedirte ayuda para esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "¿Los Ladrones de Tesoros no le tienen miedo a los meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "¡Ja! Por dinero, esos bribones no le tendrían miedo a nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "Gracias, y lo siento. Sé que no deberíamos pedirte ayuda para esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
