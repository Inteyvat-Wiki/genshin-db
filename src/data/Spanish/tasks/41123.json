			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "¿Conseguiste echar a esos Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "¡Genial! Has sido de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230304,
					"content": "Con suerte, habrán aprendido la lección y no volverán a molestarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230305,
					"content": "Bueno, si no necesitas nada más...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Oh, espera un momento... Necesito tu ayuda para algo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230307,
					"content": "Desde que cayeron los meteoritos, nos han informado de la existencia de una gran cantidad de monstruos extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230308,
					"content": "En los informes se dice que los meteoritos han hecho que los monstruos se vuelvan extremadamente agresivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230309,
					"content": "Las defensas de la ciudad podrán aguantarlos, así que por eso no debemos preocuparnos. Pero uno de esos meteoritos aterrizó justo al lado de la Aldea Aguaclara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230310,
					"content": "Aguaclara es el hogar de muchos cazadores. Les hemos enviado refuerzos, pero el terreno es muy complicado de vigilar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230311,
					"content": "Si algún monstruo se infiltrara en la aldea, podría ser un desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230312,
					"content": "¿Podrías ir a la Aldea Aguaclara a ver si hay monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230313,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Bien, cuento contigo. Haré lo que pueda para enviar más caballeros para que te ayuden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230315,
					"content": "¿Cómo están las cosas en Aguaclara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Francamente, las cosas no pintan bien. Ya estábamos muy ocupados con las secuelas que dejaron los meteoritos, y ahora también debemos protegernos de los monstruos y los Ladrones de Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230317,
					"content": "Es imposible encargarse de tantas cosas al mismo tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230318,
					"content": "Lo siento, pero también debo dejar esto en tus manos. Mientras tanto, intentaré enviar caballeros para que te ayuden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
