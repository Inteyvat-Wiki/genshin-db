						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "¡Oh! Parece que hay algo escrito en la espada. A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "“... Acariciando la espada y entregándome a la canción continúo mi camino, dando muerte a dragones y bebiendo su sangre. La luz divina fluye como un rayo, y el gélido filo anhela derrumbar montañas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Inscripción en una espada"
				},
				{
					"id": 711090603,
					"content": "“... Bajo la Cordillera Tianheng, mataré a los tigres; entre el mar de nubes, asesinaré al dragón. Cuando regrese victorioso, viviremos en paz para siempre...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Inscripción en una espada"
				},
				{
					"id": 711090604,
					"content": "Parece que al lado hay otra estela de piedra... ¡Oh, la caligrafía es diferente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "“... Deseaba dejar aquí el manjar de pescado y cordero, pero se habría echado a perder. Por tanto, aquí he escrito la receta, para que puedan prepararla ustedes mismos. ¡Cuánta belleza!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Inscripción antigua"
				},
				{
					"id": 711090606,
					"content": "“... No queda nada más de él, solo su espada y este panorama”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Inscripción antigua"
				},
				{
					"id": 711090607,
					"content": "“... ¿Qué harás cuando te encuentres en un camino sin salida? Ya conoces la respuesta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Inscripción antigua"
				},
				{
					"id": 711090608,
					"content": "“... No tomes... el tesoro. Deja solo... De aquí en adelante...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Inscripción ininteligible"
				},
				{
					"id": 711090609,
					"content": "“Que mi última batalla... sea en honor...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Inscripción ininteligible"
				},
				{
					"id": 711090610,
					"content": "Guau... Las últimas líneas están demasiado retorcidas, ¡Paimon no entiende lo que pone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Seguramente ponga que no se llevó nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*Solloza*, al final no encontramos nada de valor. Todo fue en vano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "¡Pues eso parece!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Aunque Paimon no esperaba ver algo así en circunstancias tan desesperadas... Paimon supone que ha valido la pena, aunque sea un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "No pasa nada, te prepararé algo de comer para que te animes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#¡¿De verdad?! ¡Lo prometido es deuda, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Yo tampoco lo entiendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
