						],
						"pointId": 5063
					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "¡Guau! Paimon no se imaginaba que este salón en ruinas podría ocultar un secreto así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "¡Yo tampoco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Además, parece que Huang Tercero tampoco conocía la existencia de este lugar... ¡Espera! ¿Acaso se encuentra aquí la cámara del tesoro de Guhua de la que hablan las leyendas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#Y... ¡{NICKNAME}, mira! ¡Algo brilla ahí, sobre aquella plataforma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "¡El tesoro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Bueno, ¡vamos a comprobarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "¿Un mecanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Por eso no podemos juzgar un libro por su portada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "“... El firmamento es inescrutable, y son pocos aquellos que llegan a contemplarlo. El destino es caprichoso, y son pocos aquellos que logran una prosperidad duradera... Incluso aquellos que reciben su favor encuentran obstáculos, y a mucho peor se enfrentan los que no...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Estela con inscripción"
				},
				{
					"id": 711090502,
					"content": "“... Esta estela permanece aquí para preguntar lo siguiente a los que vengan: ¿Qué harás cuando te encuentres en un camino sin salida?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Estela con inscripción"
				},
				{
					"id": 711090503,
					"content": "Tocar la estela",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "Marcharse",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
			"completionStepIds": [
