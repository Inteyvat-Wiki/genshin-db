			"dialogs": [
				{
					"id": 751450101,
					"content": "Elegidos de los dragones... Oh, elegidos de los dragones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "La Montaña Sagrada se encuentra ante ustedes... Si quieren... deberán eliminar... al enemigo oculto bajo las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "Oh, elegidos de los dragones... Entren... Entren a la Montaña Sagrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "¿E-el volcán acaba de entrar en erupción?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Humm, no... Todo estaba en calma. ¿Es que han visto una erupción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#¿{NICKNAME}? ¿{REALNAME[ID(2)|SHOWHOST(true)]}? ¿Por qué tan pensativos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Se parecen a esos detectives de las novelas cuando por fin descubren la verdad sobre un caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Digamos que hemos visto... otra “verdad”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "Explicar a Paimon lo que viste",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Oh, ¿quieres decir que has visto algo similar a cuando conocimos a {REALNAME[ID(2)|SHOWHOST(true)]} al llegar a Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "¿Y también unas imágenes raras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "En aquella otra ocasión, dijiste que viste unas palabras extrañas. Humm... Paimon no las vio, así que no sabe nada, pero ¿podría haberlas dicho la misma persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Creo que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Pero esta vez también han visto unas ruinas enormes, el Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "Y la Montaña Sagrada... Humm, si Paimon no recuerda mal, la gente de Natlan llama a ese volcán “Montaña Sagrada”. ¿Habrá alguna relación entre el volcán y lo que vieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Paimon tiene la sensación de que la persona que nos entregó a {REALNAME[ID(2)|SHOWHOST(true)]} quiere que entremos en la Montaña Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "Quizás allí podamos desvelar el misterio que hay en torno a él, y puede que hasta veamos a su familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "#En fin, estemos atent{F#a}{M#o}s ante cualquier información relacionada con el volcán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Ah, la Comunidad de la Feracidad, una de las seis tribus de Natlan, está al lado del volcán, ¿no? ¡A lo mejor allí averiguamos algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Efectivamente... Paimon, ¡tú eres la asesina del pastel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "¡Maldición! ¿Cómo lo averiguaste? Paimon estaba segura de que nadie la vio comerse ese pastel... Es broma, en realidad, ¡Paimon robó el estofado de carne flameante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Por eso tú... Espera, no, ¿qué es lo que acabas de ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "Explicar a Paimon lo que viste",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Conque otra vez viste unas palabras extrañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
