			},
			"dialogs": [
				{
					"id": 722460301,
					"content": "Srta. Sumida, ¿cuál es el plan ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Humm... He oído que en Mondstadt hay una biblioteca enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224604,
