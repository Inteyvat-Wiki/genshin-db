				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460401,
					"content": "“El mundo es vasto e infinito...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460402,
					"content": "¿Es una cita de «Escuadrón Joururi»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460403,
					"content": "Vaya, tienes buena memoria, Kama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460404,
					"content": "Después de todo, es una historia que usted me contó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				}
			]
		}
	]
