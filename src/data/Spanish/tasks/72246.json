	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "¡Qué brazalete tan lindo! ¡Qué florero tan bonito! ¡Qué objetos tan hermosos hay en Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "*Ejem*... No, no está bien. Palabras tan superfluas no son dignas de una novelista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Quizás debería comprar un florero de lo más exquisito para usarlo como referencia literaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Humm... ¡Sí, eso es lo que escribiré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "“¡La clave estaba en una Visión oculta dentro del jarrón!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "¡Suena muy interesante! ¿Tú que piensas, Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Me da ig...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "... En mi opinión personal, hay que moderar la descripción del florero. Una descripción exagerada sonaría muy forzada, pero una descripción escueta dejaría al lector insatisfecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "¡Tienes razón! Lo anotaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "Oh, ¡lo siento! Cambiemos de lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "Además, ¿cuántas veces te he dicho que no me llames “señorita”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "¿Eh? Pensándolo bien, somos como dos viajeros comunes y corrientes. Si uno se refiere al otro con cortesía, es un elemento literario común...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "¡Guau! ¡Qué felicidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "¡Después de todo, es la biblioteca más grande de todo el norte! ¡Cuando tenga oportunidad, leeré toda «La melancolía de Vera» de una sentada! ¡Qué emoción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Srta. Sumida, baje un poco la voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Oh, lo siento. Me dejé llevar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "No es eso, temo que se haga daño. Esa bibliotecaria tiene un aura realmente imponente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Oh, ¿en serio? Pero si me da la impresión de que es una típica hechicera haragana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "Aunque, pensándolo bien, personajes así resultan ser los más poderosos. No, no, definitivamente es mejor no provocarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "Oh, tienes razón. A la próxima escribiré una obra que gire en torno a un personaje como ella. «La hechicera de la biblioteca»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "¿Qué tal su viaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Cuánto tiempo sin vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Oh, es {F#la legendaria}{M#el legendario} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Nuestro viaje... Yo solía viajar mucho para recolectar materiales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "Para describir la morada del trueno, tuve que ir a la Garganta Musoujin, para describir a la serpiente divina, tuve que ir a la Cabeza de la Serpiente, y para describir a los fugitivos, tuve que pedirle a Kama que se una al ejército...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Qué trabajo tan duro, Kama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "No es gran cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Pero esta vez es un viaje auténtico. Una travesía a tierras lejanas y sin rumbo fijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Al fin he descubierto que hay tantas cosas interesantes de las que vale la pena escribir, como «El viaje de Kino».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Kama y yo buscábamos las vistas y las tiendas que los lugareños nos recomendaron. Mientras acampábamos en la naturaleza, compartimos la hoguera con otros viajeros e intercambiamos historias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "Pero al despertar, descubrimos que robaron todos nuestros suministros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "... ¿Están bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Sí, no hay problema. Cuando encontramos a esos ladrones, descubrimos que eran una docena, así que pensé que no había forma de que nos regresaran las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Pero Kama logró convencerlos de que nos devolvieran hasta el último Mora. ¡Incluso alrededor había medallones con una insignia de un cuervo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Estoy segura que puedo escribir una buena trama, pero Kama se niega a explicarme cómo lo hizo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Solo cumplía con mi deber. La Srta. Sumida no tiene de qué preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "No, no. ¡Kama, de verdad puedo confiar en ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Contigo a mi lado, dudo que tengamos problemas, ¡incluso si nuestras aventuras nos llevan a la orilla del mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "Hablando de eso, realmente has cambiado mucho desde todo el incidente en la Isla Tsurumi. Ahora hay cosas que quieres intentar, y tienes tus propias opiniones y puntos de vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Bueno, si no le parece adecuado, Srta. Sumida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "No, no, ¡me parece genial! Vale la pena tomar en cuenta tu opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "Bueno, entonces los dejaré a solas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Sí. Nos vemos, {NICKNAME}. Encontrémonos al final, como en «Flores para la princesa Fischl».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#Nos vemos, {NICKNAME}. Cuídate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Tal vez nos encontremos de nuevo en algún otro lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Kama es impresionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
