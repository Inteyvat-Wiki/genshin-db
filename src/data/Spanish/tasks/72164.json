			"dialogs": [
				{
					"id": 721640201,
					"content": "¿Ya terminaron de limpiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640202,
					"content": "Todo está reluciente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Miau, miau, miauravilloso. Neko también echó a esos bichos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640204,
					"content": "El santuario cada vez se ve mejor. El baúl está reparado y todo está limpio... Sí, seguro que más gente vendrá a presentar sus respetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Miau, miau... Neko devolverá este santuario a su antigua gloria antes de que Hibiki regrese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Bueno, gracias por su ayuda... Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640207,
					"content": "Hablar el lenguaje humano es agotador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640208,
					"content": "Neko va a descansar. Tal vez necesite su ayuda más tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640209,
					"content": "Cuando llegue el momento, vuelvan aquí... ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
