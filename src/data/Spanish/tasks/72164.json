			"dialogs": [
				{
					"id": 721640301,
					"content": "¡Miau! Hibiki le encargó esta tarea específicamente a Neko. Un trabajo vital que nadie más puede hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640302,
						721640311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640302,
					"content": "Sobre tu nombre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "Neko es Neko. Este nombre lo eligió Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640304,
					"content": "Ella era la que recibía a los visitantes del santuario, y Neko no tenía que hacerse cargo de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640305,
					"content": "En aquel entonces, Neko no tenía nombre ni cargo. Dormía donde quería y jugaba con quien quería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640306,
					"content": "Un día, Hibiki dijo que, a partir de ese momento, Neko se llamaría Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640307,
					"content": "Ahora Hibiki no está, pero un santuario debe tener una Suma Sacerdotisa, así que Neko tomó el puesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640308,
					"content": "Neko espera poder devolver al santuario su popularidad original antes de que Hibiki regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640309,
					"content": "Cuando regrese, Neko podrá dormir en su regazo y no tendrá que esperar a que repare el baúl de ofrendas o utilice ese palo largo para quitar las hojas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640310,
					"content": "#Bueno, Neko {F#las}{M#los} dejará con sus tareas. Unos bichos han entrado en el santuario y Neko tiene que echarlos a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640311,
					"content": "¿Quién se encargaba antes de limpiar el santuario?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "Hibiki. Y Domeki ayudaba a veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640313,
					"content": "Hibiki tomaba ese palo a menudo y lo movía de acá para allá antes de que saliera el sol. Después echaba agua en el suelo. Uf, agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640314,
					"content": "Un momento, ¿o primero echaba el agua? Neko no recuerda bien el orden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640315,
					"content": "A veces, Domeki también venía y usaba unas cosas de metal que hacían “chas, chas”, y las hojas y las ramas caían al suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
