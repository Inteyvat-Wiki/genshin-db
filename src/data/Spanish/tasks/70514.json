			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "La gente de Mondstadt es más apasionada de lo que pensé. Hasta los Hilichurls de aquí son muy vivaces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Independientemente de eso, Sr. Yogue, le rogamos que no salga por ahí por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "¿Qué? ¿Y qué hay de mi máquina? Todavía le faltan... Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "Uno, dos, tres... dieciocho, ¡diecinueve componentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Contamos con aventureros que los están buscando ahora mismo. Solo espere aquí en la ciudad, es más seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "Pero sin esos componentes... ¿Qué haré si tengo un rayo de inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "Mi inspiración va y viene, como... ¡Como un eructo después de una buena bebida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Humm... Sí, no es una mala analogía, la anotaré. Estoy seguro de que a Xavier le encantará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "#¿Eh? ¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¡Espléndido! ¡Justo la persona a la que buscaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Permítanme presentarlos. Esta persona de aquí es de la Corte de Fontaine y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "¡Lo que soy es un soñador! ¡Un soñador! ¡Así es como nos hacemos llamar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "#Sr. Yogue, est{F#a}{M#e} es {F#la Caballera Honoraria}{M#el Caballero Honorario}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "#¡Ajá! Yo soy Yogue, Félix Yogue. ¡Saludos, Caballer{F#a}{M#o} Honorari{F#a}{M#o}! He oído hablar de sus hazañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "¿Me conoces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "¡Por supuesto! ¿Quién no ha oído hablar de usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "¡Su batalla contra Stormterror en Mondstadt ocupó los titulares de «El Pájaro de Vapor» durante tres semanas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Jajaja, si esos reporteros supieran que estoy hablando con usted, ¡se morirían de envidia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "¿Qué es «El Pájaro de Vapor»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "¿En serio no lo conoce? Es... ehmm... digamos que es un periódico muy popular en la Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "Quiero que sepa que usted logró que fueran récords en ventas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "¿Titulares?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "¡Así es! ¡Y las ventas subieron meteóricamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Primeras páginas a todo color, entrevistas con expertos ¡y las mejores ilustraciones que se pueden comprar con Moras! Usted hizo a mucha gente millonaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "#Está bien. Viajer{F#a}{M#o}, Sr. Yogue, dejaré que hablen a solas. Tengo otras cosas de las que encargarme, así que debo irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Swan se marcha con prisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Ah, es tal y como me dijeron. Los Caballeros de Favonius tienen una larga lista de tareas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Entonces, ¿qué te trae por Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "¿A mí? Tengo planeado recorrer todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "En cuanto a mi trabajo, me dedico a promocionar mi creación: los núcleos kinésicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "En pocas palabras, un núcleo kinésico es una especie de dispositivo de relojería. Siempre y cuando se le dé cuerda, el núcleo puede generar energía motriz por un largo periodo de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Para exhibir su capacidad, incluso creé una especie de juguete con movimiento perpetuo potenciado por un núcleo kinésico. Lo llamo “Mecanopuzle de moción perpetua”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Me encantaría mostrárselo, pero lamentablemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "... Es demasiado llamativo, incluso para los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "A estas alturas, deben de haber hecho añicos mi dispositivo sin consideración alguna y estarán jugueteando con sus componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Por supuesto, le pedí ayuda al Gremio de Aventureros, pero no he recibido noticias de ellos hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, si no es mucha molestia, ¿podría ayudarme usted también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "#Créame, ¡ni el dispositivo ni la paga l{F#a}{M#o} decepcionarán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Maravilloso. Después de todo, usted es {F#una aventurera}{M#un aventurero} formidable, ¡y muy considerad{F#a}{M#o}! ¡Tal y como dicen los periódicos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "#Ah, es una pena que estemos en Mondstadt. Si estuviéramos en la Corte de Fontaine, traería a algunos reporteros de «El Pájaro de Vapor» para que l{F#a}{M#e} entrevistaran en exclusiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "Estoy seguro de que se ganaría su admiración y aparecería en los titulares durante tres semanas más. ¡Y ni qué decir de las regalías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Primeras páginas a todo color, entrevistas con expertos ¡y las mejores ilustraciones que se pueden comprar con Moras! Usted hizo a mucha gente millonaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
