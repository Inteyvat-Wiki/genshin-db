					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "#Ah, ha vuelto, Caballer{F#a}{M#o} Honorari{F#a}{M#o}. ¿Alguna noticia de los componentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140302,
					"content": "¿Te refieres a estos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "¡Precisamente! ¡Qué maravilla! ¡Gracias a los Arcontes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140402,
					"content": "Bien, ya que tenemos todos los componentes, solo nos queda ensamblarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140403,
					"content": "#Si está interesad{F#a}{M#o}, puede intentar armarlo usted mism{F#a}{M#o}, Caballer{F#a}{M#o} Honorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140404,
					"content": "Confíe en mí, ¡será una experiencia interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				}
			]
		},
