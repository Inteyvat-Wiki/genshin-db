			"dialogs": [
				{
					"id": 20131101,
					"content": "¡Alto! Esta es la oficina de la Comisión Kanjou. ¡No se puede entrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131102
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131102,
					"content": "Estamos aquí para ver... ya sabes... ¡al Comisionado Kanjou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "El Comisionado Kanjou no suele recibir a forasteros. Váyanse, ahora, o nos veremos obligados a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah... Espera, espera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "¡Oh! ¡Comisionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "#Est{F#as}{M#os} dos son invitad{F#as}{M#os} de honor que vienen de lejos, no hace falta darles el trato habitual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "Entren, vamos a ver qué podemos hacer por ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "¡Eh! ¡¿Lo escuchó todo, señor?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131109,
					"content": "M-mis más sinceras disculpas.",
