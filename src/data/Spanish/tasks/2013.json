						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "Deténganse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130402,
					"content": "Tal y como esperaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "¿Eh? ¿Qué hicimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130405,
					"content": "La Srta. Hiiragi tiene una carta para usted. Insistió en que la lea de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130406,
					"content": "¿Una carta? Rápido, ¡muéstrasela a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130407,
					"content": "#Que estas palabras hablen por mí en mi ausencia: Lamento darle esta carta de forma tan abrupta. Espero que no le moleste. Es la primera vez que invito a {F#una forastera}{M#un forastero} de tierras lejanas a través de una misiva. Sin embargo, creo que nuestro encuentro no fue una coincidencia. Por tanto... Aprovechando que habrá una luna espléndida, espero que podamos encontrarnos. No se preocupe por mis custodios. Tengo un medio para escabullirme. Espero con ansias su llegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130408,
					"content": "Entonces... ¿quiere que te reúnas con ella en secreto por la noche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130409,
					"content": "#Pero no te veías sorprendid{F#a}{M#o} en absoluto... ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130410,
					"content": "Nuestras miradas se cruzaron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "¿Eh? ¿Has estado tramando algo a espaldas de Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130414,
					"content": "Humm... Vamos a preguntarle esta noche, a ver qué tiene que decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130412,
					"content": "Shinsuke no tiene la intención de dejarnos ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "¡Paimon sabía que había algo sospechoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130403,
					"content": "Ya lo veía venir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
			"completionStepIds": [
				201307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201307",
							"2"
						],
						"stepId": 201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, por fin llegaron... P-permítanme presentarme, soy Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "#Esta es... técnicamente la segunda vez que nos encontramos. Es un placer volver a verl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Vaya, sí que es la heredera del clan Hiiragi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "El placer es mío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "N-No hace falta ser tan formal, hace tiempo que admiro sus hazañas. Por fin tenemos la oportunidad de conocernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "¿Es imaginación de Paimon o el ambiente está un poco extraño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "La razón por la que quería reunirme con usted aquí en secreto es que... temía no tener otra oportunidad de contarle esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "*Ejem*... Me gustaría pedirle que me ayude... a entregar una carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Uff, ¡de tal palo, tal astilla! ¿No puedes ser más original?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "¡N-No! Es un malentendido. Por favor... permítame explicarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "Quisiera que entregara una carta en la Isla Narukami por mí. El destinatario es Kujou Kamaji, de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Mi padre siempre me ha prohibido comunicarme con él. Hay otros candidatos para mi matrimonio que le servirían mejor políticamente. Pero mi corazón le pertenece a Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "#No hay nadie que se atreva a desafiar la voluntad de mi padre en Ritou, pero ustedes son foraster{F#as}{M#os} que buscan llegar a la Isla Narukami. Sería una pena dejar pasar una oportunidad así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, ahora lo entiende todo Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "Por supuesto, si aceptan, haré todo lo que esté en mi poder para ayudarles a salir de Ritou. Lo prometo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Parece un trato razonable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "#Para ser sincera... mientras permanezcan en Inazuma, mi padre no tendrá la intención de dejarl{F#as}{M#os} salir de Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Sí, nos lo imaginamos. Era bastante obvio que solo intentaba retenernos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "Hace unos días escuché en secreto una conversación entre mi padre y una mujer que sonaba muy arrogante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "#Parecían estar discutiendo cómo mantenerl{F#as}{M#os} aquí en Ritou. De hecho, fue la primera vez que oía a mi padre hablar con tanto respeto a alguien que no fuera la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Una mujer que sonaba arrogante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "#No tenemos mucho tiempo. Les contaré mis planes para ayudarl{F#as}{M#os} a salir de la isla. Resulta que un cargamento de mercancías está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "(Hiiragi Chisato te cuenta sus planes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "#Muy bien, l{F#as}{M#os} espero en la frontera. Cuento con ustedes para entregar mi carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "Tenemos que salir de Ritou lo antes posible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Considerando que no tenemos otras opciones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Me voy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "Es un gusto volver a verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
			"completionStepIds": [
				201308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201308",
							"2"
						],
						"stepId": 201308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Un momento... Estas mercancías se envían a... ¿la Isla Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "¡Señorita! Qué honor tan inesperado. Tiene razón, el Comisionado Kanjou solicitó estas mercancías en varias ocasiones. Debemos asegurarnos de que lleguen intactas a la Isla Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "¿Ocurre algo, Srta. Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "No, para nada. Mi padre simplemente está preocupado por la seguridad del cargamento, y ha ordenado que se nos envíe a mí y a un escolta cualificado adicional para garantizar el transporte seguro de la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Señorita, ¿está diciendo que pretende escoltar el cargamento personalmente? No hace falta que se moleste con ese asunto, y en cuanto a ese “escolta cualificado”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Espero con ansias trabajar contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "No nos retrasen más. Si la memoria no me falla, mi padre insistió en que este envío debe llegar a tiempo. Estoy segura de que habrá un castigo en caso contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Sí, por supuesto, señorita. Es solo que... No sabemos quién es esta persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "¿Acaso necesito recordarles el castigo si algo me ocurre en el camino? Estoy segura de que todos conocen el temperamento de mi padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "¿Estás diciendo que puedes garantizar mi plena seguridad por ti solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Vaya, Chisato sí que sabe hablar, no tienen ninguna posibilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "C-como usted diga, señorita. Muy bien entonces... es un honor que nos acompañe. Su seguridad será nuestra máxima prioridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "¡Shinnojou! ¿Cómo puedes estar de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "La petición es de la propia Srta. Hiiragi. Es nuestro deber servirle en lo que podamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Sí, pero... ese no es el problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Bien, si eso es todo, sugiero que nos pongamos en marcha de inmediato. Si perdemos más tiempo, más tiempo tendrán los ladrones para prepararse, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "S-sí, señorita. Ya la oyeron, ¡no hay tiempo que perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "¿Cuestionas mi capacidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
			"id": 201310,
			"completionStepIds": [
				201310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201310",
							"2"
						],
						"stepId": 201310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Uff, podemos detenernos a descansar en la aldea que hay más adelante. ¿Cómo está, señorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Estoy perfectamente bien. Pueden parar aquí. El camino a la Isla Narukami está por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "En mi carta, solicité a Kamaji que les conceda un salvoconducto especial de la Comisión Tenryou. Considérenlo una muestra de mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "Gracias, Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "¿Señorita...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "¿Eh? Ya veo. Tenía la sensación de que algo andaba mal, pero tú, Shinnojou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "No, la Srta. Hiiragi nunca tendría malas intenciones, lo sé con certeza. Pero ¿quién es ese “Kamaji” del que habla, señorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "No tengo miedo de decirlo... es a quien amo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "¿A quien... ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou... ¿De verdad creías que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "¡¿Qué?! N-no, yo eh... *Ejem*, solo quería aclararlo, eso es todo. Ni en mis sueños más osados, eh... *Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "No tienes que preocuparte. Solo finjan que esto nunca ocurrió. Si mi padre se entera, solo yo seré responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Sí, por supuesto. Como usted diga, señorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "¿Pero qué pasará si alguna vez descubren tus acciones, Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "No te preocupes, mi padre siempre me ha mimado. Lo peor que haría es condenarme a pasar medio día sin comer, o algo parecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Humm, Paimon nunca imaginó que un tipo como él pudiera ser tan sentimental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Les deseo un buen viaje. Estoy segura de que nos volveremos a encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "¡Adiós, Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "¡Oye, vamos! ¿Qué haces ahí parado? ¡En marcha! Tenemos mercancía que transportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "*Solloza*, b-bueno... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Ten cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
