			"trigger": {
				"objectNames": [
					"Kobayashi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "¡Alto ahí! ¡Muéstrenme sus permisos de viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Lo siento, pero tenemos que ir a la Isla Narukami, es algo urgente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Si no tienen un salvoconducto, solo pueden llegar hasta aquí. Las reglas son las reglas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Ay... Como era de esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "#{NICKNAME}, tienes que pensar en algo. ¿Cómo salimos de Ritou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "#Si la Comisión Yashiro ha oído hablar de nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "¿Estás diciendo que... deberíamos reunirnos con el Comisionado Kanjou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "Supongo que no perdemos nada al intentarlo. Aunque Paimon tenga un par de cosas que decirle de sus subordinados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "¿Quién sabe? ¡Quizá sea nuestro admirador número uno! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "#Seguro que la Comisión Kanjou ha oído hablar de nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201302",
							"2"
						],
						"stepId": 201302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Shinsuke",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "#Soy Hiiragi Shinsuke, el Comisionado Kanjou y jefe del clan Hiiragi. Es un honor conocerl{F#as}{M#os} a amb{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130202,
					"content": "Para mí también es un honor conocerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "¡Paimon está encantada de conocerlo, señor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130205,
					"content": "Bien, la razón por la que queríamos venir a verlo era porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130206,
					"content": "#Bien, bien, todo a su tiempo. Dos viajer{F#as}{M#os} de renombre han venido a verme y me gustaría saber más de ustedes. No hace falta ir directamente al grano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130207,
					"content": "#Jeje, ¿está diciendo que somos famos{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130208,
					"content": "Por supuesto. ¿Cuántas otras personas en el mundo son capaces de someter a Stormterror y enviar al Señor del Vórtice de vuelta a las profundidades del mar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130209,
					"content": "¡Exacto! Paimon cree que tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130210,
					"content": "Además... he oído que también han frustrado una conspiración de los Fatui en Liyue, e incluso han vencido a uno de Los Once en un duelo. ¿Es cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130211,
					"content": "¡Guau! ¿También oíste eso? ¡Sí, es cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130212,
					"content": "Humm... Como pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130213,
					"content": "¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130214,
					"content": "Jeje, no, para nada. Estoy realmente sorprendido, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130215,
					"content": "Eres muy amable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "... Ritou está muy honrado con su visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130218,
					"content": "Otra cosa que he oído sobre ustedes es su gran entusiasmo por ayudar a otras personas. Así que, me pregunto... ¿Serían tan amables de prestar su ayuda a la Comisión Kanjou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130219,
					"content": "#¡Claro, no hay problema! Lo que necesites, ¿cierto, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130220,
					"content": "¿Hora de volver a hacer algunos recados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "Jejeje, excelente. Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130223,
					"content": "Debes conocer la flor chingxin, ¿cierto? Es una flor que crece en las cimas de las montañas de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130224,
					"content": "Sí, ya hemos recolectado algunas antes. Entonces... ¿quieres que volvamos a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130225,
					"content": "Sí. Reúne 300 flores chingxin frescas, por favor. Recién recolectadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130226,
					"content": "Ehmm... ¿Paimon oyó bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130227,
					"content": "¿Está seguro de que no agregó unos ceros de más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "¿Oh? ¿Es mucho pedir? Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130230,
					"content": "Entonces, ¿qué les parece esto? Tenemos algunas correspondencias que entregar, ¿podrían ayudarnos con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130231,
					"content": "Bien, así está mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130232,
					"content": "709 cartas, para ser exactos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130233,
					"content": "¡Oye! ¿Es que no tienes suficiente personal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130234,
					"content": "Jeje, lo siento mucho, es que últimamente estamos un poco escasos de gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130235,
					"content": "¡A otro perro con ese hueso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130236,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "#{NICKNAME}, ¿qué hacemos? ¿De verdad tenemos que ayudar a este tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130238,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "Es comprensible, pero no me hagan esperar demasiado, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130239,
					"content": "Tendré que investigar más sobre el tema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "Para cuando termine, ya no estarán frescas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "#No es por presumir, pero soy buen{F#a}{M#o} en esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "Pero al final se salieron con la suya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "¿Qué tal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
		{
			"id": 201304,
