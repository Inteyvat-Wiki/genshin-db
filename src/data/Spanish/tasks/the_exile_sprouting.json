			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "¿Es que tienes una Visión Dendro o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930902,
					"content": "Hace mucho que no veo a nadie como tú. Me trae muchos recuerdos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930903,
					"content": "¿Qué te parece así, Sabah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Perfecto, debería absorber el elemento Dendro y florecer muy pronto. Solo hay que esperar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930905,
					"content": "Poco a poco, las semillas comienzan a germinar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Tras brotar un par de hojas, dejan de crecer.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#¡Han brotado! ¡Paimon sabía que podrías, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Tal y como pensaba, los resultados han sido inmediatos. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930909,
					"content": "Es una pena que no hayan florecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "No te preocupes, es completamente normal. Hay que tener paciencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930911,
					"content": "Las plantas deben completar todo un complejo proceso de crecimiento antes de poder florecer. Por eso son tan hermosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930912,
					"content": "Con un poco más de tiempo y cariño, las rosas florecerán. Ya lo verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930913,
					"content": "#Les estoy muy agradecida tal y como están ahora. No me gustaría molestarl{F#a}{M#o}s más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930914,
					"content": "Deberían pasarse por aquí cuando hayan florecido. Significaría mucho para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		}
	]
