				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "¡Eh! ¿Han visto eso? No sé qué acaba de pasar, pero me he distraído un rato, ¡y esa roca tan grande ha salido volando de repente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Le cuentan a Pekkani lo ocurrido anteriormente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "#¡Guau! Aunque no he entendido nada, si son capaces de realizar tal milagro, ¡deben haber sido elegid{F#a}{M#o}s por la Doncella{RUBY#[D]Kuutar} Lunar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "¡Nuestra señora la Diosa Lunar nos ha bendecido! ¡Ahora podré pescar como la Diosa manda! Mientras ese odioso bardo no vuelva a traer a su mascota para cantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "¡Tomen, esta es la recompensa que les prometí! Aunque últimamente no he pescado ningún pez, he encontrado un montón de pequeños artilugios. Algunos deberían ser de valor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Pero como en la Isla Hiisi el Mora no sirve de mucho, se los regalo todos a ustedes. Gracias por su ayuda, ¡y ahora dejen que pesque en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
}