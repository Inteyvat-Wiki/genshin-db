					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "Ataque al enemigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "¡Muy bien! Ya tenía ganas de poner en práctica las nuevas técnicas que he aprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Espero que puedas ver mis movimientos con claridad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "#¿T-tan diestr{F#a}{M#o} eres? Jajaja, entonces intenta tomártelo con calma, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Veamos... Hay un campamento de monstruos ahí delante. Pasemos por ahí primero, ¿te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
			],
			"beginWay": "TALK_BEGIN_NONE",
