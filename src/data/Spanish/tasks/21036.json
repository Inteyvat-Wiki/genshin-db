					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360806,
					"content": "Uff, ya puedo respirar de nuevo. No esperaba que fuera tan cansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360807,
					"content": "#Gracias por la demostración, viajer{F#a}{M#o}. Aquí tienes la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360804,
					"content": "Tienes que entrenar más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "Tienes... razón...",
