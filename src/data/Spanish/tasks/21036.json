				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "Entrenamiento de campo a través.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "¡Genial! Le pedí a aquella aventurera que me ayudara a marcar un circuito de entrenamiento. Incluso me ayudó a colarme para que pudiera entrenar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Me dijo que lo único que tenía que hacer era llegar a la meta en el menor tiempo posible, pero nunca soy lo suficientemente rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Por eso quería pedirte que me hicieras una demostración. Intentaré no quedarme atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Me parece bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Bueno, vayamos a la línea de salida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Espero que no te moleste el polvo que levanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "¡Ah! Haré todo lo que pueda, aunque te advierto que no tengo madera de atleta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103604,
			"completionStepIds": [
				2103604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
