					"content": "Entrenamiento de campo a través",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "¡Genial! Entonces sigamos el camino que me ayudó a marcar la aventurera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "Me dijo que lo único que tenía que hacer es llegar a la meta en el menor tiempo posible, pero siempre soy muy lento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Por eso quería pedirte que me hicieras una demostración. Intentaré no quedarme atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Bueno, vayamos a la línea de salida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Espero que no te moleste el polvo que levanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "¡Ah! Haré todo lo que pueda, aunque te advierto que no tengo madera de atleta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
