					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "#Volvemos a vernos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "¿Sigues entrenando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Así es, aunque... es más duro de lo que imaginaba. No sé si es porque no soy lo suficientemente fuerte o porque no lo estoy haciendo como se debe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Bueno, dejemos eso de lado. La última vez que luchamos juntos, tu técnica fue muy inspiradora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "¿Te importaría venir a entrenar conmigo otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "Como la última vez, ¿qué prefieres? ¿Ataque al enemigo o entrenamiento de campo a través? Tú eliges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "¿Sigue Chue'er enfadada contigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Humm, lo cierto es que dijo que iría a la ciudad a hacer algunos recados y todavía no ha vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "He ido a verla varias veces, pero siempre es Zhiruo la que sale a recibirme porque Chue'er se niega a verme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*Suspira*, no sé qué hacer con ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
