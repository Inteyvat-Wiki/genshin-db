				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "*Jadea*, no ha... sido fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Siento que me hayas visto así. Supongo que no he progresado mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "#Tengo que seguir entrenando. Gracias, viajer{F#a}{M#o}. Acepta esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "¿Vas a dejar Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Bueno, esa es la idea. Tengo pensado tomar un bote mercader y viajar por vía acuática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "La primera parada será Fontaine. Supongo que me quedaré allí algún tiempo mientras planeo qué hacer después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*Suspira*, no sé si podré convencer a Chue'er para que venga conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
