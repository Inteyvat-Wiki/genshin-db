			"dialogs": [
				{
					"id": 760310201,
					"content": "Sí. Le diré a Kunegunda que traiga algo de fruta. Tendrá que permanecer en reposo durante los próximos dos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Parece que Lauma está ocupada. Esperemos un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Hace tiempo, me di cuenta de que la figura de la Cantalunas es de gran importancia para los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310204,
					"content": "A veces pienso que su trabajo es incluso más difícil que el de los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310205,
					"content": "Miren, ya terminó. Aprovechemos para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Srta. Lauma, hay algunos asuntos relacionados con la defensa para los que necesitamos su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "De acuerdo, ya voy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "¡Otra vez le pidieron ayuda! ¡No tiene ni un segundo de descanso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Sigámosla con discreción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
