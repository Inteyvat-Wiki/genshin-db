			"dialogs": [
				{
					"id": 760310301,
					"content": "Así está bien. Buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "Que la luz de la luna nos una tanto en el día como en la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "¿Eh? Esa frase ha cambiado desde la última vez que la escuché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310304,
					"content": "¡Miren, ya se fue! ¡Ahora sí, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "¡Srta. Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "¡Esto no tiene fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "Buen trabajo. Perdón, tengo que irme un momento, ahora vuelvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "No hay nadie alrededor, pueden salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "¡Así que ya sabías que estábamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "Claro, ¿cómo no voy a sentir el kuuvahki que emana de Kuu{RUBY#[S]Doncella Lunar}tar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "¿Por qué no dejan de seguirme? Parece como si estuvieran vigilándome mientras trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "A-ah, lo sentimos... Es que queríamos pedirte ayuda con una cosa, pero no encontrábamos el momento. Paimon espera no haberte agobiado demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Oh, ya veo... Entendido, yo me encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "A decir verdad, a Paimon le da un poco de vergüenza darte aún más trabajo después de ver todo lo que haces en un día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "No pasa nada, es mi deber como Cantalunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310319,
					"content": "¿Mhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310320
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310320,
					"content": "¿Qué piensa de los Descendientes Lunaescarcha después de haber visto todo esto, Kuu{RUBY#[S]Doncella Lunar}tar?",
