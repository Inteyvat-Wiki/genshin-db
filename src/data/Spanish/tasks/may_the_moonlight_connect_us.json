			"dialogs": [
				{
					"id": 760310101,
					"content": "¿Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "*Zzz*... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310103,
					"content": "#Vaya, parece que está durmiendo la siesta. {NICKNAME}, ¿volvemos más tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Tejón mantomelena"
				},
				{
					"id": 760310105,
					"content": "¡Oye, no vayas por ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310107,
					"content": "Auch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Tejón mantomelena"
				},
				{
					"id": 760310109,
					"content": "¿Te resbalaste? Ah, no te preocupes, no me has hecho daño. Oh, ¿han venido ustedes también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310110,
					"content": "Así que una Diosa Lunar también puede sentir dolor cuando un animal se choca contra ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Mientras el kuuvahki que emane de un animal no sea malintencionado, no hay ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310112,
					"content": "¿Qué pasa? ¿Por qué estás tan asustado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Tejón mantomelena"
				},
				{
					"id": 760310114,
					"content": "Mhm, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310115,
					"content": "¿Tú también entiendes a los animales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "Nod Krai es un lugar donde la luna brilla intensamente. Cualquier animal que haya crecido bajo la luz del kuuvahki puede considerarse familiar de la Diosa Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310117,
					"content": "¿Y qué dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "En el lugar donde vive han aparecido unos monstruos. Quería pedirle ayuda a Lauma, pero los monstruos lo persiguieron hasta las inmediaciones de este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310119,
					"content": "Aaaah, normal que esté tan asustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "¿Deberíamos acompañarlo de vuelta a su casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Bueno, basta con llevárselo a Lauma. Ella se encargará de lo demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760310122,
					"content": "Vaya, parece que tendremos que salir otra vez. Eso sí, esta vez vamos donde los Descendientes Lunaescarcha, ¡así que escóndete bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
