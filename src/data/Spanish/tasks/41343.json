				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "Gracias. Aunque no hace mucho tiempo que dejamos Mondstadt, siento mucha nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Me pregunto cómo estarán todos en casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Humm... Bien, no dejemos pasar esta oportunidad... Hermana, ¿tienes algún deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "¿Yo? Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "#Con eso debe ser suficiente. Viajer{F#a}{M#o}, hay algo más que quisiera pedirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "Las semillas de diente de león deben liberarse desde un lugar alto, o no funcionará. Pero la arquitectura de Liyue es muy diferentes a la de Mondstadt. Ni Geri ni yo sabemos cómo llegar a un punto alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "¿Podrías ayudarnos a esparcir estas semillas desde un punto alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430508,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
