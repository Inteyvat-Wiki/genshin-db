			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Gracias. Ahora deberíamos liberarla, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Ah, ya veo... Déjame pensar... ¿qué debo escribir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Con eso bastará. Ahora que lo pienso, la linterna se lleva nuestro deseo al cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "Cuando estábamos en Mondstadt, también le susurrábamos a los dientes de león nuestros deseos y los liberábamos para que se los llevara el viento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "Hablar de Mondstadt me hace extrañarla. Hace mucho que no veo dientes de león...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "#Viajer{F#a}{M#o}, ¿te puedo pedir que me traigas unas cuantas semillas de diente de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Muchas gracias. Cuando las tengas, ven directamente con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
