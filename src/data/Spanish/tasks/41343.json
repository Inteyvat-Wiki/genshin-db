			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "¿Pero cómo demonios se hacen las linternas celestes? Hermanita, ¿tú sabes cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "Me preguntaba si podríamos pedirle a alguien que nos ayude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "¿Ustedes también quieren liberar linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "#Ah, eres tú, viajer{F#a}{M#o}. Sí, suena muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "Pensábamos ir al Rito de la Linterna a probar sus especialidades, pero Geri dice que primero quiere liberar una linterna celeste para vivir la experiencia del Rito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "¿Qué te parece esto? Primero nos impregnamos del ambiente del festival, y luego probamos las especialidades culinarias. Así podremos experimentarlo al máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "Además, escuché que hay que pedir un deseo al liberar la linterna. Es solo que... no sabemos cómo hacerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarnos a hacer una linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "¡Déjenmelo a mí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Bien, lo dejamos en tus manos. Estaremos aquí esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
