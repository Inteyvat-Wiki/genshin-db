				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "#Hola, viajer{F#a}{M#o}. ¿Ya dispersaste las semillas de diente de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430702,
					"content": "¡Tal como me pediste!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Excelente. Espero que el viento las lleve a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430704,
					"content": "Dices que quieres integrarte en Liyue, pero no puedes olvidar las tradiciones de Mondstadt. ¿Por qué no buscamos algún sitio con comida de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430709,
					"content": "No podemos hacer eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430710,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430705,
					"content": "Una cosa es mantener nuestras tradiciones de Mondstadt, y otra es unirse al ambiente de Liyue. Hay que liberar las linternas celestes, ¡deprisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430706,
					"content": "¿Ya escribiste tu deseo? Después de liberar la linterna celeste, ¡vayamos a probar la comida típica del Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430707,
					"content": "Ya lo escribí, pero... ¿todavía quieres comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430708,
					"content": "Jeje, ¡por supuesto! ¡No podemos perder la oportunidad de probar la comida del Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		}
	]
}