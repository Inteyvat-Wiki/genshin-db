					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Estaba bromeando. Sé que mis libros son demasiado complicados para ti. No tengo ninguna intención de prestártelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 30230207,
					"content": "¡Ah! ¡Qué molesto eres!",
