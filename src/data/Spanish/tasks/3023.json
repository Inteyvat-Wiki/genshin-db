			"dialogs": [
				{
					"id": 30230401,
					"content": "Los últimos días de trabajo han sido unos de los más duros que he tenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "Y ninguno hará que gane ni siquiera un Mora... No puedo creerlo...",
