					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "¡Tienes que ser más positiva, Dehya! Tal vez consigamos una enooorme recompensa cuando todo esto haya acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Humm, supongo que tienes razón. Oye, ¿qué harías si mañana fueras rica de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "¡Paimon compraría un montón de cosas deliciosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "¿Eso es todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Humm... y tal vez algo delicioso para beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Jajaja, qué adorable.",
