			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee me contó que descubrieron unas vías misteriosas por las que se puede viajar en un “Chitty-Chitty Volador superdivertido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, a mí también me lo dijo. Por lo que parece, es una vagoneta que viaja por una vía “superemocionante” a una velocidad “supersónica”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Sí, debe de ser lo mismo. Dice que, a veces, la vagoneta se inclina hacia delante tanto que sientes que el cuerpo te flota, como si no pesara nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "¿De verdad? Pues yo además me enteré de que la mochila de Klee casi sale volando en medio del trayecto, y que si no fuera porque Kaeya reaccionó rápidamente, habrían saltado decenas de Bombas saltarinas por doquier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "¡¿Eh?! Suena a algo muy peligroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*Suspira*... Si quieres probarlo y tengo un rato, podría acompañarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "¿Cómo? Eula, ¿cómo sabías que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Es que eres muy transparente... Pero primero tengo que dejarte claro que no estoy dispuesta a ayudarte a recoger las cosas que salgan volando de la vagoneta, así que asegúrate de no llevar tus pertenencias encima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "¡Sí! ¡Claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
