			"dialogs": [
				{
					"id": 401171501,
					"content": "Quién habría imaginado que, después de hacerle aquella promesa a Alice, acabaría metida en este lío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idía"
				},
				{
					"id": 401171502,
					"content": "Aun así, como dijo nuestra Gran Estratega, si pudiésemos restaurar el Espejismo, entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idía"
				}
			]
		},
