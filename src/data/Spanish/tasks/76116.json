			},
			"dialogs": [
				{
					"id": 761160101,
					"content": "#¡Vaya, pero si son {F#las amigas}{M#los amigos} hasta la muerte de Bobik y de nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "¿Qué harán ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Nos quedaremos aquí por un tiempo. Después de todo, dañamos la puerta del laboratorio de Drzislav. Debemos vigilar los alrededores para evitar que esos villanos aprovechen la oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Cuando arreglemos la puerta, o cuando Desla regrese a casa, ¡probablemente hagamos como ustedes y salgamos de viaje con Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "¿Qué hay de Drzislav?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "No tenemos ni idea de dónde podría estar... ¡Si lo encuentran durante su viaje, por favor, salúdenlo de nuestra parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "¡Me encantaría pasar otra noche bebiendo con él en el Buque Insignia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "¿Qué hay de Bobik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "¿Lo echas de menos? ¡Puedes venir a jugar con él cuando quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Nos vemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Claro, seguro que nos volveremos a ver. Después de todo, ¡somos amigos hasta la muerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
}