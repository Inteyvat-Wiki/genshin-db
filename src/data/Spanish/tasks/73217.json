			"dialogs": [
				{
					"id": 732171901,
					"content": "“Hemos reabierto nuestras rutas a Ritou. Estimados comerciantes, sean bienvenidos a unirse a nuestra Cámara de Comercio”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171902,
					"content": "“Hemos recibido la aprobación del gerente del puerto para comercializar champiñones silvestres entre Sumeru e Inazuma. Todos los comerciantes de hongos que estén interesados son invitados para negociar una posible cooperación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171903,
					"content": "“También pueden contactarnos si encuentran algún problema o dificultad en su viaje a Inazuma”.",
					"roleType": "TALK_ROLE_NPC",
