					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170802,
					"content": "Tenemos un descuento especial para estudiantes registrados de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
