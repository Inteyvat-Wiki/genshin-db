			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "“El Hotel Shapur tiene un servicio bastante bueno, pero se escucha todo lo que pasa en la habitación de al lado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170902,
					"content": "“Me quedé aquí a prepararme para el examen porque los precios en Puerto Ormos son bajos. Pero parece que tendré que mudarme a la Ciudad de Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170903,
					"content": "“Volver a mi pueblo a cultivar el campo sería la única opción que me quedaría si vuelvo a reprobar el examen este año. No sé si podré llevarme algo de Bendición de Anahita en tal caso”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "“Los oficiales de la Academia que envían son cada vez más inútiles. No pueden ni siquiera responder a una simple pregunta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171002,
					"content": "“Y ahora que tenemos acceso al Akasha, estos oficiales aficionados no me llegan ni a los talones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171003,
					"content": "“La única excepción es ese escriba que se deja ver poco y que nos ayudó la última vez a esclarecer la tabla de asignación de horarios para los barcos. Resulta que no todos los académicos tienen el seso reblandecido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "“Aunque ahora tengo más carga de trabajo desde que Cyno asumió el puesto de Gran Juez, es un alivio no tener que aguantar más ese tedioso sectarismo entre Escuelas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171102,
					"content": "“Si no, no podría aprovechar que está de viaje de investigación para pasear relajadamente por aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171103,
					"content": "“No sé dónde ha estado Cyno últimamente. Supongo que no leerá los mensajes que deje aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171104,
					"content": "“Pues sí los he leído. Preséntate ante mí mañana antes del mediodía para recibir tu castigo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171105,
					"content": "“No me hagas perder el tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Nuestro gremio se especializa en el comercio de gemas y minerales valiosos procedentes de Liyue. Tenemos numerosos canales de suministro estable y cooperamos desde hace mucho tiempo con diversas flotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171202,
					"content": "También tenemos a la venta un poco de seda. ¡Queda poca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171203,
					"content": "Contacte con nosotros si tiene un buen canal de suministro para productos típicos de Sumeru como alfombras, hierbas medicinales, adornos de gemas o brocados. ¡Amigos comerciantes, hagamos negocios juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "“El mes pasado viajé por mar hasta una nación cuyo gobernante nunca había visto un caballo. ¿Pueden creerlo?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171302,
					"content": "“Así que decidí llevar un montón de animales de carga para vendérselos como si fueran caballos, jaja. Si eso funciona, ¡podría convertirme en un malik o algo así!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171303,
					"content": "“¿Qué es un malik?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171304,
					"content": "“Como un oficial portuario o un visir, pero con mucho, mucho, mucho más poder que cualquiera de ellos. Más o menos como lo que eran los Veintinueve Deys. Vaya, qué difícil es explicarlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171305,
					"content": "“A mí me parece que te lo estás inventando todo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "“¡Cuán gris es el discurso de los sabios! ¡Mejor escanciar el embriagador licor y embarcarse en una odisea por la conquista de los mares!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "Aquí se publican las normas portuarias para marineros, comerciantes itinerantes y ciudadanos locales y extranjeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171502,
					"content": "En caso de disputa, avise inmediatamente al alguacil Shyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "“En lugar de visitar el Gran Bazar de la Ciudad de Sumeru, ¿por qué no vienen a visitar la antigua calle comercial de Puerto Ormos?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171602,
					"content": "“El Gran Bazar es un caos por culpa de los oficiales de la Academia. En cambio, aquí conservamos muchas de las tradiciones de Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171603,
					"content": "“Si, además, quieren ver un espectáculo de danza, deben visitar el Teatro Zubayr”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171604,
					"content": "“No hagan caso a ese pueblerino. La Ciudad de Sumeru fue planificada con mucho esmero por eruditos, y cada zona se construyó basándose en fundamentos científicos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171605,
					"content": "“Algunas personas se quejan sin saber y piensan que las caóticas calles de Puerto Ormos son una verdadera obra arquitectónica”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171606,
					"content": "“¡Vuelvan al hueco del árbol del que salieron!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "“Realmente es un poco vergonzoso decirlo, pero éramos los trabajadores que nos dedicamos a mantener los barcos mercantes durante años. Nos ganábamos el pan con las técnicas aprendidas de generación en generación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171702,
					"content": "“Pero nadie necesita de nuestra experiencia desde que se inventó el conmutador Akasha y otras tecnologías. Los jóvenes pueden aprender cosas nuevas a través del conmutador, pero la gente mayor como nosotros no tenemos más remedio que cambiar de trabajo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171703,
					"content": "“El escriba dijo que probáramos suerte en el mar, pero todavía necesitamos un tiempo para reunir dinero porque no tenemos fondos. Estamos disponibles para cualquier trabajo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171704,
					"content": "“No escuchen al escriba. Conozco a alguien que necesita artesanos. Se los presentaré. Tomen este dinero y olvídense de aventurarse en el mar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171705,
					"content": "“Realmente espero que dejes de hacer cosas sin sentido. Algunas personas tienen éxito y otras no, así es como funciona el mundo. ¿Por qué insistes en interferir en el flujo natural de las cosas solo para sentirte bien?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171706,
					"content": "“Y aquí viene otra vez el escriba a dar clase sobre misticismo. ¿Por qué? ¡Porque me encanta!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171707,
					"content": "“No olviden que la cooperación mutua, la paz y la defensa de la justicia también son principios con los que funciona el mundo, ¡no esas tonterías de ‘la supervivencia del más fuerte’!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171708,
					"content": "“A ver si me explico, no niego lo que dices, pero no comprendes lo que estoy intentando decirte. Así que me niego a continuar con esta conversación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171709,
					"content": "“Es un dolor de cabeza discutir con gente como tú. Bueno, ¿a dónde fueron tus fondos? No me digas que te gastaste todo el subsidio de la Academia en estas tonterías”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171710,
					"content": "“‘Los pobres sufren la riqueza de los ricos. Así que los ricos deberían compartir su riqueza’, así lo dijo el sabio Zolfikar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171711,
					"content": "“Nunca dijo eso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171712,
					"content": "“Sí que lo dijo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171713,
					"content": "“No, nunca dijo eso. Y tú pagarás tus bebidas este mes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171714,
					"content": "“No voy a discutir contigo por eso. Pero dame un mes y te demostraré que así lo dijo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "“Nuestra empresa ha abierto una ruta marítima hacia el Puerto Dornman. Buscamos personas que quieran invertir en el comercio de frutas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171802,
					"content": "“Un momento. ¿Es posible importar fruta desde Mondstadt a pesar de ser un viaje tan largo? Podría estar interesado si se tratara de bebidas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171803,
					"content": "“Todo el mundo sabe que es rentable importar vino de Mondstadt, pero el único que importa fruta soy yo. ¡Por eso es una buena oportunidad de negocio!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732171804,
					"content": "“Y además, no necesariamente hay que importarlas desde Mondstadt”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
