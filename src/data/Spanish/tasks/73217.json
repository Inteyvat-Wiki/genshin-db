			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Todos los barcos que entren en el puerto deben registrar los datos del propietario y el motivo de la entrada ante la autoridad portuaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170502,
					"content": "En el caso de los barcos mercantes, también se requiere información detallada sobre las mercancías transportadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170503,
					"content": "Los barcos mercantes que no se hayan registrado no podrán descargar ni realizar actividades comerciales. Se impondrán graves sanciones si se descubre cualquier infracción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
