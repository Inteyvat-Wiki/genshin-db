			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "Este tablón de anuncios fue creado por el gerente del puerto de Puerto Ormos para informar sobre asuntos importantes que ocurran en Puerto Ormos y sus alrededores. Si tiene alguna duda sobre cualquier anuncio, puede publicarla aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "“¿Dudas sobre qué formato debería seguir tu artículo? ¿Sigues buscando ideas? ¡Es hora de que intentes un nuevo método!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170202,
					"content": "“Me gradué en la Escuela de Semiótica y tengo probados conocimientos de Elementalismo y Tecnología. Proporciono asesoramiento sobre redacción de tesis”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170203,
					"content": "“Deja de sufrir y busca al Sr. Amandip en la posada. El precio es negociable”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170204,
					"content": "“¿Puedes escribir mi tesis por mí?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170205,
					"content": "“No, la inspectora nunca permitiría algo así”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170206,
					"content": "“Será mejor que te concentres en tus estudios y no lo dejes a la suerte”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "¿Alguna vez has oído hablar de la levitación? ¿O has visto a un trapecista? ¿Quieres conocer cuál es el secreto del animal de carga volador? ¡Ven a la primera actuación del Circo Volador de Fontaine en Sumeru y descúbrelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170302,
					"content": "¡Sean bienvenidos y no se pierdan esta oportunidad! El espectáculo les espera por solo cinco Moras de entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170303,
					"content": "“Fue un espectáculo maravilloso. ¡Nunca había visto nada igual, ni siquiera en Fontaine!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
