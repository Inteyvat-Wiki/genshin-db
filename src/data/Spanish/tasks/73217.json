			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Este puerto está investigando minuciosamente actividades de contrabando. Todas las mercancías que entren y salgan del puerto deben ser registradas e inspeccionadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170602,
					"content": "Se confiscarán las mercancías no registradas o los artículos ilegales cuya importación o exportación esté prohibida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170603,
					"content": "El propietario del cargamento asumirá todas las consecuencias legales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
