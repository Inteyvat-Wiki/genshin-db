			"dialogs": [
				{
					"id": 732170701,
					"content": "¡Cuidado con las bestias marinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170702,
					"content": "Recientemente ha habido más actividad de bestias marinas. Se aconseja a las embarcaciones que abandonen el puerto prestar atención a los anuncios publicados por el Faro de Pharos u obtener previsiones del estado del mar a través del conmutador Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170703,
					"content": "El guardián del faro responderá a cualquier duda que tengan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
