					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Recordatorio especial: Los Eremitas son la única organización de mercenarios autorizada en Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170402,
					"content": "No confíe en otras personas a la ligera y evite ser estafado por impostores de origen incierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732170403,
					"content": "Si necesita contratar un guardaespaldas, un guarda o tiene algún otro requerimiento, póngase en contacto con el Capitán Firuz del “Regimiento de los Treinta” en Puerto Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
