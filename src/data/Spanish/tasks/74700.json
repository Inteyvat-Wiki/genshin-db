			"dialogs": [
				{
					"id": 747000101,
					"content": "¡Jeje, Paimon se está divirtiendo mucho llenando este acuario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Ya que a Sandrone no le importa, ¡deberíamos atrapar más pececitos y hacer este lugar aún más bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Eh, ustedes dos. Vengan aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000104,
					"content": "¿Eh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Tomen, esto es para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000106,
					"content": "¿Qué es?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Es el dispositivo de movilidad subacuática en el que he estado trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000108,
					"content": "¡¿Eh?! ¿De verdad? ¡Gracias, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "#No es más que un simple dispositivo. Vi cómo pescaban y... ¿cómo decirlo? Parecía un método un tanto... primitivo. Siendo honesta, hasta me costó observarl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000110,
					"content": "¿T-tan malo es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Es ineficiente, torpe y completamente carente de elegancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000112,
					"content": "Siento que hayas tenido que presenciar algo así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "No hay necesidad de disculparse. Cada uno tiene su propia manera de hacer las cosas. Pero si planean seguir añadiendo más peces al acuario, quizás sería mejor que usaran este dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000114,
					"content": "En las aguas de Fontaine no solo habitan peces inofensivos y bonitos. Hay muchos depredadores que podrían hacerles daño de verdad. Este dispositivo no solo les ayudará a pescar, sino que también les ayudará a escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000115,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Muy bien. Si van a ir a nadar, háganlo ahora. Y no olviden contarme su opinión del dispositivo. Siempre puedo ajustarlo si tienen algún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000116,
					"content": "Me aseguraré de usarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
