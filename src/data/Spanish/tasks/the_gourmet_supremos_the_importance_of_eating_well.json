	"talks": [
		{
			"id": 2201602,
			"completionStepIds": [
				2201603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201603",
							"2"
						],
						"stepId": 2201603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "#Parvaneh... Y {F#la viajera}{M#el viajero}, ¿qué haces tú aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Vine para ayudarles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "¿Sí? Muchas gracias. Parece que Julie se adentró aún más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Allí hay muchos monstruos. Si estuviéramos nosotros solos nos costaría mucho deshacernos de ellos, pero con tu ayuda lo lograremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Partamos ya. Julie debe estar dentro del bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Vine por el banquete que me debes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "No hay problema. Pero yo solo no podré prepararlo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "#Viajer{F#a}{M#o}, por favor, primero ven con nosotros a buscar a Julie, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Julie debe haberse adentrado mucho y allí hay muchos monstruos. Si estuviéramos nosotros solos, nos costaría mucho deshacernos de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Cuando traigamos de regreso a Julie te prepararé ese banquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "¡Ten cuidado! ¿Cómo haremos la comida si rompes la olla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "¡No subestimes las técnicas de forjado de ollas de Liyue! Esta olla es de hierro fundido y se fabricó especialmente para blandirla. ¡No se romperá tan fácilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Por otra parte, solo son unos cuantos monstruos. Si ni siquiera pudiera acabar con ellos, ¿qué clase de olla de hierro fundido sería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Tienes demasiadas esperanzas puestas en esta olla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong se ve imponente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "¡Por supuesto! Esta es una materia obligada para todo cocinero que se precie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "¡Yo nunca había oído eso! ¿Por qué tienen que aprender los cocineros a aporrear monstruos con ollas de hierro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Bien, Julie, salgamos de aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "¡Esperen! ¡Tenemos que ir a ayudar a ese hombre! ¡Fue él solo al bosque a pelear contra los Samuráis Kairagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "¿Los Samuráis Kairagi? ¿Por qué ha ido a buscar problemas con ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "Después te lo explicaré... ¡Rápido, vayamos a ayudarle! Está él solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "#Está bien. Viajer{F#a}{M#o}, acompáñanos una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "¡Salgamos ya! ¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "¿Quieres pelear contra los Samurái Kairagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "¡Por supuesto! ¡Mi olla está deseando enfrentarse a ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Además, no es propio de un chef salir huyendo con el rabo entre las patas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "¡Ya lo he dicho, no se pueden poner tantas esperanzas en los cocineros y las ollas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "¿Dónde se compran estas ollas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Jajaja, buena pregunta. Yo se las encargo al señor de Los Ferreteros de Hanfeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "En teoría, este hierro está reforzado con minerales extraídos de la Sima. Si quieres una, busca a ese hombre directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "No obstante, oí que la Sima se cerró hace mucho tiempo, así que quizás ya no se puedan hacer ollas como esta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Parvaneh también se ve formidable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "¿Eh? Oh, humm... ¡Jajaja! Lo único que hice fue lanzar unos libros a la cabeza de esos monstruos, pero la mayoría del trabajo lo hiciste tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Un momento, ¿dónde está el sexto tomo de «Caminando con los dioses»? ¿Lo habré lanzado también? ¡No había terminado de leerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
