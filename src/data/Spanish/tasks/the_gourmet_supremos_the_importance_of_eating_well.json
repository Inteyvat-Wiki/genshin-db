			"dialogs": [
				{
					"id": 220160601,
					"content": "Jeje, está delicioso, quiero un poco más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160602,
					"content": "¿Por qué quieres llevarle comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Bueno, no quiero que pase hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160604,
					"content": "Además, cuando lo vimos la vez anterior, parecía estar pasándolo mal. Creo que es porque no había comido lo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160605,
					"content": "Por eso quiero llevarle algo de comer. Si tiene la barriga llena, no lo pasará tan mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160606,
					"content": "¿Por qué confías en él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "Digamos que es mi intuición de aventurera. Enseguida distingo si una persona es buena o mala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160608,
					"content": "Además, una persona que tiene hambre pero da su comida a los demás solo puede ser buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160609,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Adiós. En adelante no olvidaré comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
			"id": 2201607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
