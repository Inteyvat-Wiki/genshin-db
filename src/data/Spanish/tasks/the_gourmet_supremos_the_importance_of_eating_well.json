			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "Estos dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Parece que no confías mucho en él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "¿Te refieres a Kamei Munehisa? Por supuesto... No lo hemos visto más que unas pocas veces. ¡No se puede confiar tan fácilmente en la gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "No obstante, aunque no confío en Kamei Munehisa, confío en el juicio de Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "¿Eres de la Academia de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Podría decirse que sí. Salí en un viaje de investigación y conocí a Xudong en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Él quiere viajar por todo el mundo aprendiendo recetas y mi objeto de estudio también tiene que ver con la comida. Después de debatir unas cuantas veces, salimos a viajar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "Primero fuimos a Mondstadt, donde nos rodearon unos monstruos. Por fortuna, Julie vino a ayudarnos y los ahuyentó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Cuando escuchó que íbamos a viajar por todas partes para buscar platos deliciosos, decidió venir con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Ella decía que su objetivo era viajar para buscar aventuras, pero yo creo que lo único que quiere es comer cosas ricas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "Nuestra próxima parada debería ser Sumeru. Ya casi he acabado con mi investigación y tengo que volver a la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Cuando lleguemos a Sumeru, les daré a probar todas las comidas deliciosas que hay allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Hasta luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
