					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"2"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Julie",
					"Xudong",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "*Ejem*, esos villanos me han dejado así... No se burlen de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Solo un par de movimientos fallidos, no hay ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Julie, ¡ahora tienes que contarnos todos los detalles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Con pelos y señales, de lo contrario habré tirado esos libros en vano... Ah, se han arrugado todas las páginas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "Es muy sencillo... Solo quería traerle algo de comer a este señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "¡Pero si solo lo habías visto una vez! ¿Por qué confiabas en él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "¡Estoy segura de que es una buena persona! En aquel momento se notaba que tenía mucha hambre, pero aun así nos dio sus provisiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "¡Alguien que accede a darnos sus provisiones cuando él mismo tiene hambre tiene que ser una buena persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "Este concepto del bien y el mal es demasiado ingenuo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "¿Es que no vives en Teyvat, sino en un reino de fantasía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Jajaja, yo creo que Julie tiene razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "En mi opinión, alguien que puede mantener la compostura con la barriga vacía no puede ser una mala persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Qué lógica tan sencilla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Continúa con tu relato, Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "Preparé unas brochetas de champiñones y pollo y me dirigí al lugar donde lo encontramos por primera vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "Al llegar, ¡de veras estaba allí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Pero cuando me disponía a saludarlo, vi que estaba frente a unos Samuráis Kairagi. Parecían estar diciendo algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Quise alejarme, pero me descubrieron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Deje que siga este servidor desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Entre esas... personas hay algunos antiguos amigos míos. Servíamos juntos en el shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Tras los cambios repentinos en Inazuma, abandonamos el shogunato y salimos a buscarnos la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "¿Ahora mismo se estaban buscando la vida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "Así es... No sabemos hacer mucho más, aparte de manejar la espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "En ese momento fue cuando ellos se convirtieron en “Samuráis Kairagi” y se dedicaron a robar para sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Este servidor no quiso unirse a ellos. Desde entonces he vagado por todas partes buscando encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Pero cuando la gente se entera de que soy uno de los guerreros que abandonó el shogunato, no se atreven a contratarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "Así que no me quedó más remedio que irme al campo y buscar comida para sobrevivir, como vieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Parece que, últimamente, mis antiguos colegas necesitan más miembros, así que cada día vienen a pedirme que me una a ellos. Y cada día los rechazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Hoy, cuando llegó la señorita Julie, pensaron que me había unido a alguno de los clanes y que iba a luchar contra ellos. Por eso me atacaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "No tiene ningún sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "Nada de lo que ellos hacen tiene sentido. Pero, en sus circunstancias, tampoco es de extrañar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "Después, este señor fue a enfrentarse a esos villanos y yo me quedé esperando a que regresara. Pero apareció un grupo de monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Tú podías contra ellos, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Normalmente sí puedo. Pero esta mañana no he desayunado antes de salir, así que no tenía fuerzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "Además, cuando me descubrieron los Samuráis Kairagi se me cayeron las brochetas de champiñones y pollo... Menos mal que este señor me protegió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "Hay que desayunar todos los días.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Pero en Inazuma hay muchos más de esos Samuráis Kairagi que no atienden a razones y aún tenemos que quedarnos un tiempo por aquí... Será muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "Nosotros podemos vencer fácilmente a unos cuantos monstruos débiles, pero no podemos enfrentarnos a expertos en artes marciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "Sí... Disculpa, acabas de decir que buscas trabajo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "¿Quieres unirte a nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "¿Pero no es un desertor del shogunato? Seguramente nos traerá problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "Es cierto, la identidad de este servidor es algo especial. Si los acompaño, podría causarles problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Jajaja, yo creo que no hay de que preocuparse. A fin de cuentas, lo único que hacemos es deambular por todas partes para recoger ingredientes y cocinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "Como no tiene ninguna relación con el shogunato y los guerreros de allí, este trabajo será perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Si trabajaras como guardaespaldas o protegiendo propiedades, llamarías demasiado la atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "Además, no tiene ningún sentido que una buena persona se vea obligada a pasar hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "Como cocinero, no puedo permitir eso. Hay muchos asuntos que no puedo resolver por mí mismo, pero al menos me ocuparé de que tengas el estómago lleno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Es muy amable, yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Jeje, ¿qué dices? ¿Quieres unirte a nosotros? No podemos pagarte mucho, pero te daremos bien de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "¡Estoy a sus órdenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "¡Bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "Supongo que es algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "¡Perfecto! Seguro que deben tener hambre, después de todo el día. No será fácil encender un fuego aquí, pero pensaré cómo preparar algo para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "#Viajer{F#a}{M#o}, quédate aquí descansando y yo haré la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "¡Manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Así está bien... Jeje, aproveché el arroz que quedaba de antes para hacer onigiri. No es algo elaborado, pero servirá para llenarnos la barriga. ¡A comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "#Ah, viajer{F#a}{M#o}, muchas gracias por todo. ¡Toma esta receta! Me la acaba de dar Munehisa y he hecho una copia para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "Dice que es una receta que aprendió en sus tiempos en el shogunato. Es bastante especial, si quieres puedes intentar hacerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Bueno, ya basta de palabrería. ¡Que aproveche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "La próxima vez no olvides desayunar antes de salir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Qué sensibles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "En sus circunstancias, es normal que sean sensibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Pero creo que solo estaban buscando una excusa para acabar conmigo, el “desobediente”, y demostrar su autoridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Al fin y al cabo, los he rechazado muchas veces, así que deben estar enojados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Entonces, ¿todos esos Samuráis Kairagi son...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Tampoco es eso. Pero, en resumidas cuentas, solo un cobarde desenvaina su espada frente a un débil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "¿Por qué abandonaste el shogunato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Simplemente... Porque no estaba de acuerdo con algunas de sus políticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Yo no soy más que un guerrero y no entiendo si esas políticas son beneficiosas o no para la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Lo único que sé es que eran contrarias a mis principios, así que decidí irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Jeje, tal vez sea demasiado chapado a la antigua e incapaz de cambiar... No se rían de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"3"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "Pues ya hemos comido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160502,
					"content": "¿Por qué quieres ayudarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "¿Te refieres a Munehisa? Es por la ética profesional de los chefs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160504,
					"content": "¡Es broma! Pero realmente no deseo ver a una buena persona como él pasando hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160505,
					"content": "O, mejor dicho... No deseo ver a nadie pasando hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160506,
					"content": "El hambre es una sensación muy desagradable. Tengo... experiencia en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160507,
					"content": "Bajo la influencia del hambre, las personas pueden hacer muchas cosas que en otras condiciones no harían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160508,
					"content": "Creo que, si nadie en el mundo pasara hambre, se evitaría que sucedieran muchas cosas malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160509,
					"content": "Aunque no es algo que pueda lograr por mí mismo, como chef al menos puedo hacer que las personas que están a mi alrededor coman bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160510,
					"content": "Jajaja, para ser sinceros, yo lo único que quiero es que todos se llenen la barriga. Qué poco interesante, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160511,
					"content": "Es una gran idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "Jeje, muchas gracias. Bueno, come un poco más. ¡Que no sobre nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160513,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "¿Te vas? ¿No quieres comer un poco más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201606,
			"completionStepIds": [],
