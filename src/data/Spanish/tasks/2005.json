			},
			"dialogs": [
				{
					"id": 20050801,
					"content": "¡Esta vez ganamos la lotería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050802
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "Todas esas casas samuráis repletas de mercancías... ¡Jaja! Obtuvimos el premio gordo. Bueno, a excepción de esa casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Y eso no es nada, ¡este es el primer paso en el camino a la fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Hoy es solo el comienzo. ¡Los guiaré en una travesía de robos y saqueos que pasará a la historia de los Ladrones de Tesoros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "¡Ese es mi jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "Parece que son los Ladrones de Tesoros que buscamos. ¡Démosles una lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
