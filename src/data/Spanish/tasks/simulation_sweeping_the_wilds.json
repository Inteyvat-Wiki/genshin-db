			"dialogs": [
				{
					"id": 745040101,
					"content": "#¿Tan ansios{F#a}{M#o}s están por empezar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040102,
					"content": "Entre nosotros, les diré que en realidad creo que este plan no tiene futuro. Es mejor que vayan a la Relojería Lepaute a divertirse un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040103,
					"content": "¡Guau! ¿En serio? ¿Y lo dices así como si nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745040104,
					"content": "¡Shhh! Baja el volumen. Alguien podría oírnos y tomarme por espía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040105,
					"content": "*Suspira*, mejor dejemos aquí el tema. Al fin y al cabo, estoy trabajando, así que hablemos de trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040106,
					"content": "Permítanme explicarles que el plan de recolección de información se divide en dos partes. De una de ellas se encarga Arbon, y de la otra yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040107,
					"content": "Mi parte está orientada a simular la fuerza de combate del verdugo del justiciazgo, por lo que necesitaremos que completen algunas pruebas de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040108,
					"content": "Hemos encontrado algunos puntos en los que se concentran los monstruos y hemos instalado dispositivos de recolección de datos en las inmediaciones, por lo que solo tienen que ir y encargarse de los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040109,
					"content": "He marcado la ubicación exacta en el mapa. En cuanto al resto de los detalles, están escritos en este manual. Pueden echarle un vistazo cuando lo deseen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040110,
					"content": "¿Y bien? ¿Alguna pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040111,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "En ese caso, espero que todo vaya bien con la recolección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alberre"
				}
			]
		}
	]
}