			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Sr. García",
					"Kaia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
