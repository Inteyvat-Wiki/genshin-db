							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Hay que decir que la Ópera es magnífica. Seguro que ganan un buen pellizco aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "La Ópera... *Suspira*, centrémonos en el trabajo cuanto antes. Regresaremos de vuelta a Petricor en cuanto lo hayamos terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180203,
					"content": "Entonces, cuando lleguemos a la aldea, abriré una panadería allí, y no volveré a poner las manos sobre una máquina contable nunca más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180204,
					"content": "Eh... Señor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "Lutong, ¿qué te pasa? ¡Ni que hubieras visto un fantasma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180206,
					"content": "D-de verdad has visto... un fantasma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180207,
					"content": "¿Sr. García?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "¡¿Srta. Kaia?! ¿Qué estará haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Demasiada coincidencia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Señor, no está bien decir esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Agh, ¡a callar, Lutong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180212,
					"content": "#Sr. García, es un placer volver a verlo. Y a ti también, {NICKNAME}. ¿Ha venido a ayudar a la Ópera con los asuntos de contabilidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "¿Acaso el Sr. García se va a ocupar de la contabilidad de...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "No, no debe de ser eso. Nuestra compañía nunca ha actuado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Pero, según lo que yo sé, el Sr. García nunca ha sido una persona a la que le guste ver espectáculos en sus ratos libres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "Entonces, el único motivo que le puede haber traído a la Ópera debe de ser que... le han llamado para trabajar aquí, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Algo me dice que usted es más apropiada que yo para acompañar al señor, Srta. Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Ninguno de nosotros es sustituible, querido Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Yo... Eh... Kaia, qué alegría verla, y-yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180220,
					"content": "Pues no parece muy contento. ¿Acaso no le va bien con la investigación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "¿Cómo lo has sabido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Hum, al menos no se ha llevado un disgusto al verme. A mí tampoco me molesta encontrarme con usted o con Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "De hecho, lo único que podría sacarle de sus casillas es esa máquina contable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "¿Cómo es posible que la Srta. Kaia conozca tan bien al Sr. García? Está claro que hace mucho que no se ven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Quizá tenga un sexto sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "¿No creen que deberíamos buscar un lugar donde tomar un café? Todo esto va para largo y tendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Y-yo todavía... Hum, saben que me alegro mucho de... Pero nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 741180229,
					"content": "Tranquilo, señor. Yo me encargaré de esas cuentas tan fáciles que hasta un bebé podría hacerlas con los ojos cerrados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "Al fin y al cabo, no puede permitir que la Srta. Kaia se quede aquí esperándolo a que termine, ¿no cree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Gracias por ser tan amable, Lutong. Te traeremos una taza de café cuando regresemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Gracias, señorita. Que disfruten del café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "La Srta. Kaia y el Sr. García se marchan juntos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "¿Y se van a tomar un café así como así? Paimon empieza a pensar que en realidad no nos necesitaban para nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "#Nosotr{F#a}{M#o}s no pintamos nada aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#No, {NICKNAME}. Tu misión comienza aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "¿Tengo que ir a recoger ingredientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Me gusta tu sentido del humor, pero lo último que pretendía era hacerte perder el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "La verdad es que... el Sr. García y yo estamos en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "¡¿Que qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Hablémoslo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "No me digas que hay que buscar unos componentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "¿Necesitan que capture unas cuantas imágenes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "¿Para qué hemos venido entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "También es probable que el Sr. García la conozca muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
