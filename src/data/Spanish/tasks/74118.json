					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3508.936,
							459.464,
							3665.876
						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "Aquí podemos hablar de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Permítanme que empiece por el principio. Desde la vez que nos ayudaron con la máquina contable en Sumeru, esta ha experimentado un cambio radical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "El Sr. García estaba muy emocionado al respecto, pues él quería continuar mejorándola. No obstante, tal y como mencionó, la estructura de los mecanismos tradicionales es limitada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Ya que era imposible realizar nuevas mejoras en la máquina contable, decidimos regresar a Fontaine en busca de otros objetos de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Pero cuando regresamos a Fontaine, el Sr. García se encontró con un extraño por sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Aseguraba que podía ayudarnos a conseguir fondos de investigación, y hasta se ofreció ser el socio del Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Su única condición era que el Sr. García le revelase toda la información acumulada sobre sus investigaciones de la máquina contable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Y claro, el Sr. García jamás aceptaría algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "¡Eso! ¡¿Quién se atrevería a pedir que le revelasen todos los datos de una investigación por su cara bonita?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Exacto, por eso el Sr. García rechazó la propuesta de aquel tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Pero después de eso, comenzamos a tener la sensación de que alguien estaba pisándonos los talones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Además, alguien aprovechó que no estábamos para irrumpir en nuestra habitación y hurgar entre nuestras cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Lo dejaron todo como estaba, pero el Sr. García encontró rastros de lo que habían hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "Qu-qué miedo... O sea, que si no le dan lo que quiere, ¡¿se lo llevará él mismo por la fuerza?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "Después de haber descubierto que alguien había entrado en nuestra habitación, decidimos reunir dinero para marcharnos de aquí y regresar a Petricor lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Cuando hayamos llegado, nos pondremos en contacto con ciertos caballeros del Club de los Soñadores para buscar juntos una solución a este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Además, podría decirse que Petricor es el hábitat natural del Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Para él, no existe un lugar más seguro que Petricor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "En un principio, teníamos pensado partir hoy hacia Petricor, por eso les pedimos que nos acompañaran como escolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Lo que nunca hubiera imaginado es que nos encontraríamos a la Srta. Kaia aquí... Por el bien de su seguridad, lo mejor es que el Sr. García la acompañe de regreso a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "¿Y qué puedo hacer yo ahora por ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "No tenemos más remedio que retrasar nuestra partida. Ayúdenme a encontrar al Sr. García cuanto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "Si una leyenda andante como tú nos acompañase, seguro que nos ahorraríamos muchos imprevistos por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Ahora mismo vamos para allá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "El Sr. García le contará todo lo sucedido a la Srta. Kaia. En cuanto a qué sucederá después... eso dependerá de lo que decida ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "En fin, será mejor que vayamos a la ciudad lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "¿Acaso corren peligro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "No, seguramente no. El Sr. García todavía está en la Corte de Fontaine. Allí hay montones de Mecagendarmes cuidando de su seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Si alguien intentara atacarlos, podemos confiar en que la Oficina Judicial los defendería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "¿En qué podríamos ayudar entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Yo no me fiaría de ese tipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
		{
