			"dialogs": [
				{
					"id": 741180401,
					"content": "Justo como me imaginaba. Esos tipos siguen con los ojos puestos en el Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180402,
					"content": "¿Ven al hombre que hay en la mesa de al lado del mostrador con un sombrero enfrente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "Estoy convencido de que él es quien nos ha estado siguiendo estos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180404,
					"content": "Llamaré a los guardias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Supongo que esa es la elección más sensata... De hecho, da la casualidad de que hay uno cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Ya hemos informado antes a la oficial Menthe de este asunto, así que ella ya sabe de sobra nuestra situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Confío en que ella estará dispuesta a ayudarnos. Además, tenemos a un guardia aquí con nosotros, así que dudo mucho que esos tipos se atrevan a hacer cualquier movimiento drástico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, ¿podrías hablar con la oficial Menthe? Yo iré a buscar al Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "Bien, en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180405,
					"content": "Deberías avisar a los guardias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
		},
