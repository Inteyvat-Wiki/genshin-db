			"dialogs": [
				{
					"id": 741180501,
					"content": "#Hola, ¿puedo ayudarl{F#a}{M#o}s con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180502,
					"content": "Esto es lo que ha pasado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Le cuentas a la oficial Menthe todo lo ocurrido.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Ah, se trata del asunto del Sr. García. Entiendo, vayamos con ellos entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180505,
					"content": "Lo primero que deberíamos hacer es espantar a ese sospechoso del que me hablan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menthe"
				}
			]
