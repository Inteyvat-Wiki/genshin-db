				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Ahora solo necesitamos que Nicole le dé los retoques finales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "¿Ya han eliminado todo el material sobrante? Dejen que eche un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Jeje, ¡ya está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "¡Guau, es la cabaña de la bruja! ¿Cuándo ha aparecido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "¿Así funciona el poder de una bruja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "#“¿Así funciona el poder de una bruja?”, dijo {F#la}{M#el} visitante con voz maravillada. “Es verdaderamente increíble”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "¡Ajá! ¡Por fin continúa la historia! ¿Qué pasó con la bruja y su joven visitante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "Vivieron felices y comieron perdices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "... Fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "¡¿Y qué pasó entremedias?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "*Suspira*. Son un público difícil, ¿eh? Bueno, si tanto desean escucharlo, supongo que empezaré desde el principio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#“Todo lo que mi corazón desea es hacer que tus deseos sean mis deseos”, dijo {F#la}{M#el} joven. Tales palabras lograron atraer la atención de la gran bruja, Nicola Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "Pero justo cuando empezaban a entenderse mejor, ¡un grupo de visitantes no deseados irrumpió en el lugar, tomó a la bruja y se la llevaron consigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "#Mientras {F#la}{M#el} joven seguía paralizad{F#a}{M#o} por la sorpresa, una nueva bruja llamada Alynas hizo acto de presencia. Esta firmó un contrato con {F#la}{M#el} muchach{F#a}{M#o}, concediéndole el poder de la magia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "Pero, después de un duro entrenamiento, ¡descubrieron una conspiración más que movía los hilos desde las sombras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "Resultaba que la gran bruja Nicola Coco era en realidad una entidad alienígena. Su verdadera identidad era la de la hija mayor del rey Miautres III del Planeta Felino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "¡Se había disfrazado de bruja como parte de un complot secreto para engañar al mundo entero y hacer que veneraran al Planeta Felino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "#“Oh, gran bruja... ¿Has estado mintiéndome todo este tiempo?”, dijo {F#la}{M#el} joven con voz temblorosa mientras sentía cómo se le rompía el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "#“Vete. La guerra entre nuestros planetas es inevitable. Hemos sido enemig{F#a}{M#o}s desde el principio”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "La bruja se dio la vuelta, resuelta a que nadie viera las lágrimas que afloraban en sus ojos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "#Pero {F#la}{M#el} joven extendió la mano valientemente y la tomó del brazo, jurando que no la dejaría jamás. Conmovida por tal pasión, la bruja decidió rebelarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "#Pero en ese momento, Alynas, quien una vez había ayudado a{F# la}{M#l} joven, se puso del lado del rey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "#Resulta que Alynas era la segunda hija de Miautres III. Solo había ayudado a{F# la}{M#l} joven con la esperanza de que su hermana se decidiera por la traición, para así tener la oportunidad de usurpar el lugar de Nicola en la línea de sucesión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "#Nicole continúa dispersamente con la larga historia. Tras varios giros de lo más extraño en la trama, incluso {F#la}{M#el} protagonista deja de ser human{F#a}{M#o}...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "#Bueno, más o menos eso fue lo que ocurrió. Al final, {F#la}{M#el} joven, que ahora era un gato, trabajó junto a la bruja para detener los planes del rey. Después, regresaron a la cabaña de la bruja junt{F#a}{M#o}s y vivieron felices y comieron perdices en un lugar rebosante de paz y calma. Fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "*Solloza*, ha sido increíble... ¡Esa historia lo tiene todo! Amor verdadero, rebelión contra la injusticia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "Parece que empezó siendo una historia y acabó siendo otra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Eso es inevitable. Todas las creaciones acaban escapándose al control de su creador en algún momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Los ángeles somos un claro ejemplo de ello. En el pasado, se nos encomendó guiar a los humanos, pero debido a que algunos eligieron un camino diferente, toda nuestra raza fue castigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Si ni siquiera el Orden Celestial es capaz de controlar sus propias creaciones... ¿Qué podría hacer yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "El destino es siempre inefable, pero... aún tengo la esperanza de poder guiar a aquellos que encuentro hacia el final feliz de sus historias. Y eso incluye a los personajes de mis cuentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "En fin, la historia ya ha terminado y me estoy quedando sin energía. La próxima vez que tenga una buena que contar, la compartiré con ustedes, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Resultaba que ella era la segunda hija de Miautres III.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "#Solo había ayudado a{F# la}{M#l} joven con la esperanza de que su hermana se decidiera por la traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "Así tendría la oportunidad de usurpar el trono y seguir con la línea de sucesión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "¡Te has saltado toda la parte central de la historia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
