				{
					"id": 766730903,
					"content": "Ah, no es nada. Pero, eh... ¿cómo te entregaremos las imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Pueden guardarlas por ahora. Llegaré en un par de días y entonces podremos hablar más sobre las estatuas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730905,
					"content": "¡Está bien! ¡Nos vemos pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667310,
