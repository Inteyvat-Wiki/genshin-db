	"talks": [
		{
			"id": 7667301,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#A medida que {F#la}{M#el} joven iba avanzando, se fijó en las múltiples estatuas exquisitas que decoraban el territorio de la bruja. “¿Qué son?”, preguntó, confundid{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730102,
					"content": "“Son quienes se opusieron a mí. Subestimaron el poder de una bruja, y por eso acabaron convertidos en piedra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730103,
					"content": "Humm, me gusta. Es una adición de último momento, pero diría que una muy buena. Una bruja debe ser una figura poderosa y peligrosa... El peligro dota de cierto misterio, y sin este, el mundo sería demasiado gris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730104,
					"content": "(Pero convertir a la gente en piedra así porque sí... ¿no es demasiado extremo? Nadie querría estar cerca de alguien tan caprichoso... Bueno, creo que lo suavizaré un poco y lo convertiré en una advertencia más vaga.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730105,
					"content": "#Al oír esto, a{F# la}{M#l} joven empezó a entrarle un sudor frío. Entonces, la carcajada de la bruja rompió el silencio: “Jaja... ¿Te lo has creído? Solo estaba de broma. Su finalidad es solo la de inmortalizar cierto momento en el tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730106,
					"content": "“Bueno, las estatuas... Justo para eso necesitaba tu ayuda. La cabaña de la bruja parece un tanto vacía, y me gustaría rellenar el espacio con más compañeros adorables”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observar"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667302",
							"2"
						],
						"stepId": 7667302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#{F#La}{M#El} joven se había quedado impresionad{F#a}{M#o} ante la magnificiencia y la belleza de la bruja. Tras un largo silencio, dijo solemnemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730202,
					"content": "“Gran bruja de tierras lejanas, ¡qué hermosa y sabia eres! En cuanto mis ojos recayeron en ti, mi corazón comenzó a revolotear. Todo lo que me pide ahora es hacer que tus deseos sean los míos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730203,
					"content": "La sonrisa más sutil apareció en las comisuras de los labios de la bruja, quien respondió: “Muy bien. Te encomendaré entonces ciertas tareas que deberás cumplir por mí. No te preocupes, todas ellas estarán dentro de tus posibilidades. Aquí tienes tu guía, y la recompensa te espera en un futuro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730204,
					"content": "¿Una guía?... ¿Te refieres a este orbe de luz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "#“Cabaña secreta...”, dijo {F#la}{M#el} joven con la confusión pintada en el rostro. “¿Dónde está esa ‘cabaña secreta’ de la que hablas?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730302,
					"content": "Al escuchar aquella pregunta, la voz de la bruja sonó un tanto nerviosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730303,
					"content": "(Un momento, ¿tiene sentido que sea un personaje tímido? Bueno, da igual, lo dejo así por ahora y ya verá el Sr. Noveno cómo lo refina después.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730304,
					"content": "#“*Ejem*, no es de buena educación preguntarle esa clase de cosas a una bruja, jovencit{F#a}{M#o}. La cabaña de la bruja está siendo renovada. Muy pronto, su grandiosidad te dejará sin habla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730305,
					"content": "“Esta será tu prueba. Ofrece tu fuerza y ayuda a esta gran bruja a construir su territorio”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observar"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "#“Bueno, jovencit{F#a}{M#o}, parece que ya conoces los problemas a los que se enfrenta esta bruja... Nicola Coco requiere tu ayuda para construir su territorio sagrado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730402,
					"content": "La bruja le sirvió una taza de té a su visitante. “¿Qué opinas?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730403,
					"content": "¡Servirte será todo un honor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "¡Un momento! ¿No deberíamos pensarlo bien antes de lanzarnos así a la piscina? No sabemos nada sobre esta persona, y parece bastante rara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730406,
					"content": "Eh... Aunque, ahora que Paimon lo piensa, esta taza de té le resulta familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730407,
					"content": "¿Te has dado cuenta por fin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Nicola Coco... ¡Ah! Es... ¿la bruja N? ¿Nicole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730410,
					"content": "Correcto. ¿Qué opinan de mi historia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730411,
					"content": "Humm... Es difícil de decir. No ha terminado todavía, ¿no? ¿Qué les pasa a los personajes al final?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730412,
					"content": "Aún no lo he decidido. Primero necesito renovar mi cabaña. Tal vez después de eso me llegue un destello de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730413,
					"content": "De todas formas, si pueden oír mi voz, supongo que están en Nod Krai. En ese caso, ¿podrían hacerme el favor de conseguirme algunas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730414,
					"content": "¿Qué cosas exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Bueno, me gustaría construir algunas estatuas más para decorar la cabaña, pero me falta inspiración en este momento. He pensado que podrían tomar algunas imágenes para darme ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730418,
					"content": "¿En serio?... Está bien, déjalo en nuestras manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730419,
					"content": "Espera aquí, iremos a ver qué podemos encontrar. ¡Pero recuerda terminar la historia cuando hayamos acabado con las estatuas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730416,
					"content": "¿Tiene algo que ver con las estatuas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Bueno, me gustaría construir algunas estatuas más para decorar la cabaña, pero me falta inspiración en este momento. ¿Podrían tomar algunas imágenes para darme ideas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730408,
					"content": "Se trata de alguien a quien conocemos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "¡Estoy a tus órdenes, gran bruja Nicola Coco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
