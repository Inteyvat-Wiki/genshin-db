			"dialogs": [
				{
					"id": 766730801,
					"content": "#Hace mucho, mucho tiempo, había un{F#a} joven que huyó de casa. Tras gastar el último Mora que tenía, no tuvo más remedio que caminar acompañad{F#a}{M#o} del frío invernal, tiritando con la poca ropa que llevaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730802,
					"content": "#De repente, {F#la}{M#el} joven se encontró caminando sobre el aire, y luego cayó a través de un extraño lugar. Pero antes de que pudiera reaccionar, una voz resonó desde algún lugar en la distancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730803,
					"content": "#“Esta es la cabaña secreta de Nicola Coco, la Gran y Eterna Bruja. Oh, desamparad{F#a}{M#o}, cuéntame cuál es tu mayor deseo, y con mi ayuda, podrás conseguirlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730804,
					"content": "Vaya... Qué voz tan extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "“Nicola Coco”... ¿Quién será? ¿La conocemos?",
