			"dialogs": [
				{
					"id": 740660301,
					"content": "Recepción... ¡aquí es! ¡Vayamos a probar suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "¡Buenas, Srta. Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(*Solloza*, tiene cara de pocos amigos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(¿Y si probamos con “El arte de negociar”?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(¡Cierto! ¡El libro! Paimon no se esperaba que nos podría servir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Deja que lea... ¡Paimon lo tiene! “Si muestras tu poder y te enfrentas a tu oponente de forma imponente...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "¡Eso es! ¡Hay que imponerse! Paimon ya sabe, solo tiene que levantar la voz, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "¡¡OYE!! ¡¡Hola, Srta. Monglane!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "... No estoy sorda. ¿En qué les puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "¡Ha funcionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "Jeje, Srta. Monglane, venimos a rellenar la encuesta de satisfacción. Ah, no, no, Paimon solo viene de compañía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(No te preocupes, {NICKNAME}. Paimon puede hojear este libro mientras hablan. Simplemente escucha las indicaciones de Paimon.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "#Otr{F#a}{M#o} que viene por la nota del libro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "¡Sí! ¡Así es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "¡Pero cuántas notas han puesto! En realidad, *suspira*, da igual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "*Ejem*, esperen un momento. Voy a explicarles primero las reglas. La encuesta consta de cinco preguntas. Respondan rápidamente según su intuición. Acuérdense, contesten con rapidez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "#¿Entendido? Cuando estén preparad{F#a}{M#o}s, empezamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
