				]
			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(¡Paimon está preparada! ¡Adelante!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Primera pregunta: ¿crees que mantener los precios bajos en el Comedor Crediticio es razonable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Eh... ¿Cómo hay que responder? Deja que Paimon busque... ¡aquí está! Utilicemos esta fórmula universal.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(En el libro pone que con decir la frase “estoy de acuerdo contigo, pero...” es adaptable a cualquier situación, hasta un Mago del Abismo se sentaría enfrente tuyo para escucharte. Parece que funciona.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Sí, es razonable. A Paimon le encanta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "¿Qué? Esa comida está asquerosa, Paimon no se la quiere comer ni aunque se la den gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "Qué pasa si nos quedamos sin cupones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Ay, cierto... Tienes razón... Espera, ¡no, no, no! ¡Paimon prefiere mil veces pasar hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "*Ejem*, perdonen que les interrumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Según las reglas, tienen que responder rápidamente. Continuemos con la siguiente pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "E-está bien... Si así son las reglas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Segunda pregunta: ¿crees que la comida que ofrecen en el Comedor Crediticio durante la hora de comer es suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "Sí, ¡pero sabe demasiado mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Sí, más que menta por todo Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Paimon prefiere comer menta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "¿De verdad? ¿Qué tal si hoy de comida comemos ensalada de menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "¡Paimon no quiere! ¡Ninguna de las dos! *Solloza*, Paimon extraña el pollo asado con miel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Volvamos a la encuesta. Doy por hecho que es un “sí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "*Suspira*. Qué cansancio, sigamos con la siguiente pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Antes de que se las haga, debo advertirles que deben responder con rapidez a esta encuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Bien, la tercera pregunta: ¿crees que el sistema de comida al azar es divertido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "¡Concéntrense más en el sabor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Estoy de acuerdo, pero ¿no crees que el sistema de comida al azar es como una caja de sorpresas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "Cierto... Ahora que lo dices, ¡parece más interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "¿Qué pasa? La Srta. Monglane tiene razón, es difícil no estar de acuerdo con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "*Ejem*, respondan de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "Sí, y los papelitos de la suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "¡Es verdad! Siempre hay alguna frase escrita y te tocan por suerte. ¡Está muy bien la idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "“¡Con trabajo y esfuerzo, el éxito estará a tu alcance!”. ¡A Paimon le gusta esa frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Qué duro es el trabajo de una guía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Cuarta pregunta: ¿crees que la venta de productos selectos en el Comedor Crediticio es razonable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(¿Eh? ¿Por qué está hablando cada vez más rápido?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(¿Imponerse ante la persona? ¿Entrar en el tema? ¡No! Ninguno de estos parece correcto. Tal vez... Deberíamos volver a la fórmula universal...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(Espera, estas preguntas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "*Ejem*, no reflexionen demasiado y no entren en detalles. Como habíamos dicho antes, respondan con rapidez según su intuición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "Sí, es razonable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Muy bien, gracias por su respuesta. Vamos con la última pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "#¿Ha pasado de nosotr{F#as}{M#os}? ¿Nuestra opinión no es importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "#Según las respuestas de las preguntas anteriores, en general, ¿estás satisfech{F#a}{M#o} con el Comedor Crediticio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "¿Cuáles eran las preguntas anteriores? Paimon ya no se acuerda muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "#No hay problema, lo consideraré como un ‟satisfech{F#a}{M#o}”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Pues bueno. A Paimon le da la sensación de que aquí hay algo extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "Por cierto, si su respuesta es un “no”, no tendrán Cupones crediticios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "¡Cómo puede ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#¿Cuál es tu opinión, {F#señorita}{M#señor}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "¡No ignores a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "#Sí, estoy muy satisfech{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Muy bien. Gracias por su cooperación, su apoyo es lo que nos motiva a mejorar. Firmen aquí y recojan los Cupones crediticios. El mecabot volador inteligente que tiene a su lado también puede reclamar su recompensa con una firma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "¿Eh? ¿Paimon también tiene? Aún no ha participado en la encuesta, ¿de verdad que se puede? Espera, Paimon es Paimon, ¡no es ningún tipo de mecabot volador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Muy bien. Nuestro principio es respetar todas las sugerencias y dar recompensa a todas las personas... y mecabots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "¡Ya te dijo Paimon que no es un mecabot! ¡No la ignores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "De acuerdo. Para que te ahorres el tiempo de rellenarla, puedo completar la encuesta por ti. No te preocupes, el número de Cupones Crediticios no varía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Supongo que todas tus respuestas serían un “sí”, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "¡Sí! ¡Quiero los cupones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "En ese caso, firma aquí y yo me encargaré del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "¡Bieen! Nos ahorramos las molestias y encima nos dan cupones. Muchas gracias, Srta. Monglane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Gracias por su apoyo, tomen los Cupones crediticios. Nos vemos en la próxima encuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Después de recoger los Cupones crediticios, tú y Paimon se despiden de la Srta. Monglane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}, ahora que lo piensa Paimon, a la Srta. Monglane no le importa en absoluto nuestra opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Supongo que así están diseñadas las preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Ah, claro. Qué encuesta más rara. Además, a la Srta. Monglane se la notaba muy cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "“El arte de negociar” ha fracasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "Qué arte, ni qué comunicación. Tal y como pensaba Paimon, ¡estos libros no sirven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "El libro tiene la culpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "¿A que sí? Tú también lo crees, ¿verdad? Bueno, ya que nos dieron cupones, lo dejaremos pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Paimon tiene la culpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "¿Eh? Pero Paimon ha seguido las instrucciones del libro. Mira, aquí pone que hables en voz alta. ¡Es culpa del libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Estoy de acuerdo contigo, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Oye, ¡no le tomes el pelo a Paimon! ¡Ya decía Paimon que los libros como “El arte de negociar” eran inútiles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "#No, estoy totalmente insatisfech{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "#No, no, no. Di que estás satisfech{F#a}{M#o}. Hazlo por los cupones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "#Satisfech{F#a}{M#o}, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "Sí, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "No, no es razonable, debería...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Estoy de acuerdo contigo, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(¿Entrar en el tema? ¿Qué tema?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "No, porque nunca llego a comer lo que quiero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "Todo sabe fatal. Qué cajas de sorpresas, ¡Paimon diría que son cajas de traumas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Estoy de acuerdo contigo, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Si por cada dieciocho raciones de comida regalan una comida deliciosa, ¡estaría genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "¿Y por qué dieciocho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "Paimon lo aprendió por ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "Decían que... Emm... Que tomamos tres comidas al día y hasta que llegue el domingo, han pasado seis días, es decir, hemos tomado ya dieciocho comidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "Y cuando llegue el domingo, ¡podrás comer una delicia para terminar bien la semana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "No, Wolsey no llega a comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "No quiere comer dirás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "Entiendo, es decir, no es suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "Estoy de acuerdo contigo, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
