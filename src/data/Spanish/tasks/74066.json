			"dialogs": [
				{
					"id": 740660201,
					"content": "¿“El arte de negociar”...? Hum, con solo ver la portada a Paimon ya no le interesa, ¡qué aburrido!... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Hay una nota dentro. Humm... “Participa en la encuesta de satisfacción del Comedor Crediticio en recepción y gana Cupones crediticios...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "¡Cupones crediticios! ¡Guau! Dan cupones gratis, Paimon no se lo esperaba. ¡Vamos, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
