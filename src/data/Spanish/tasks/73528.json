				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Basima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "#¡Oh, viajer{F#as}{M#os} que están de paso! Me llamo Basima, y soy una humilde erudita de la Escuela de Biología. Les ruego que se detengan por un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280102,
					"content": "Por favor, relájense y despejen su mente, pues tengo una noticia de lo más importante que contarles:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280103,
					"content": "¡Los pinzones son de lo más adorable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280104,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280105,
					"content": "¿...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "Es verdad que los pinzones son muy lindos. Pero eres una erudita, ¿verdad? No puedes ir por ahí haciendo afirmaciones sin ton ni son, o te meterás en discusiones acaloradas con la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280107,
					"content": "Paimon tiene la impresión de que los eruditos siempre miden sus palabras. ¡Si Paimon fuera una erudita, no se atrevería a decir algo tan atrevido como “las albóndigas de camarón dorado son lo más delicioso del mundo”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280108,
					"content": "Más bien, Paimon sería más concisa y diría algo así como “este es el plato de Liyue que Paimon más desea probar en tiempos recientes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280109,
					"content": "Pues si tú no lo dices, yo lo haré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "¿Por qué dices eso de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280113,
					"content": "Está bien que lo digas de broma, ¿pero no pudiste decirlo en voz baja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280114,
					"content": "¡Jajaja! ¡Esa es la actitud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280115,
					"content": "No quiero hacer de mi vida un concurso de debate, teniendo que medir mis palabras cada vez que abro la boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280116,
					"content": "Después de todo, no es como si alguien estuviera vigilando cada cosa que digo y hago para castigarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280117,
					"content": "Lo más importante es gritar lo que piensas sin miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280118,
					"content": "Ustedes también gritarán “los pinzones son de lo más adorable” después de haber jugado a Gordibolitas pam-pam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280119,
					"content": "¿Gordi... qué? ¿Te refieres a esa cosa sobre la mesa detrás de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280120,
					"content": "Exacto. En cuanto aprendan a cómo jugarlo, se darán cuenta de lo adorables que son los pinzones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280121,
					"content": "Además, como es una de las atracciones oficiales del Espejismo Veluriyam, si obtienen un puntaje alto en el juego, ¡podrán recibir recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280122,
					"content": "Dicho de esa forma, ahora Paimon siente curiosidad. Además, ¡podemos obtener recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280123,
					"content": "#¿Qué opinas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280124,
					"content": "¡Vamos a intentarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "#¡Jaja, direct{F#a}{M#o} al grano! ¡Que disfruten el juego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280125,
					"content": "¡Veamos si esos pinzones son tan adorables como dice!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "¡Paimon es la más adorable!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "¡Le pese a quien le pese!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}