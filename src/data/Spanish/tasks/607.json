			"dialogs": [
				{
					"id": 6070201,
					"content": "No temas. Los viles monstruos ya han sucumbido al vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "La señorita quiere decir que debería quedarse en un lugar seguro de momento. Nosotros seguiremos protegiendo esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "¡Gracias! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Sr. Perejil"
				},
				{
					"id": 6070204,
					"content": "Un momento... ¿Un pájaro que habla? Ay, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Sr. Perejil"
				},
				{
					"id": 6070205,
					"content": "No se preocupe, no soy un monstruo, sino un humilde súbdito de la señorita. No supongo ninguna amenaza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "No te preocupes, son de los nuestros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Ah, claro, claro, ¡no quise decir eso! Lo siento, hablé sin pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Sr. Perejil"
				},
				{
					"id": 6070208,
					"content": "¡Hum! No importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "#¿Aún tienes asuntos que atender, súbdit{F#a}{M#o}? En tal caso, adelante, aplasta a las viles bestias y deja que la magnificencia de la Princesa bendiga tu camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
