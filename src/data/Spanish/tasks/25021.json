			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Houra se relaja poco a poco. Se estira y extiende todas y cada una de sus garras. Parece que es el momento perfecto para cortarle las uñas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250212610,
					"content": "Sigues las instrucciones de Cazcal y le cortas meticulosamente las uñas a Houra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Jajaja, ¡no sabía que se te daría tan bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Gruuu, gruuu, gru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250212603,
					"content": "Houra también te lo agradece. Le has cortado las uñas con gran precisión, por lo que ahora podrá excavar con mayor velocidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Toma esto como regalo de agradecimiento. Eh... Por cierto, tengo que recordarte algo: si en algún momento decides cuidar a otras crías de saurio, no deberás usar el mismo método de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "El carácter de cada uno es diferente, al igual que lo son los métodos de cuidado requeridos. He tardado hasta ahora en comprender tan solo cómo cuidar de Houra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Sin embargo, eso es suficiente para mí. Al fin y al cabo, los dos seguiremos juntos durante mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "¿Eh? ¿A dónde ha ido Houra? ¡N-no habrá vuelto a salir corriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "¡Eh! Houra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
