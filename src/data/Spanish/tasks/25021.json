			"dialogs": [
				{
					"id": 250213701,
					"content": "(Houra ladea la cabeza y se rasca la barriga, mirándote con expresión confundida.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250213702,
					"content": "No puedes estar viniendo cada dos por tres a visitarlo. Hay que encargarse de lo que verdaderamente importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213703,
					"content": "¡*Ejem*! Déjamelo a mí, anda. Te enseñaré cómo se hace de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213704,
					"content": "(Cazcal retoma el trabajo por donde lo has dejado rápidamente. Bajo sus meticulosos cuidados, logra cortarle las uñas a Houra...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250213705,
					"content": "No puedes concentrarte solo en jugar con Houra. Es mejor ocuparse primero de lo que hay que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213706,
					"content": "¡Gruuu! ¡Gruuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250213707,
					"content": "Jajajaja, parece que a Houra le encanta jugar contigo. No me extraña que esta vez se haya portado tan bien mientras se bañaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213708,
					"content": "Bueno, sea como sea, muchas gracias por todo. Esto es tuyo, tómalo como regalo de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213709,
					"content": "Humm, puede que lo intente yo también más tarde. Primero jugar con él un rato y luego darle un baño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213710,
					"content": "¿Qué te parece, Houra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213711,
					"content": "¿Eh? ¿A dónde ha ido Houra? ¡N-no habrá vuelto a salir corriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
