			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Houra está muy tenso y te observa con confusión.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal retoma el trabajo por donde lo has dejado rápidamente. Bajo sus meticulosos cuidados, logra cortarle las uñas a Houra...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#No pasa nada, a veces a mí también me cuesta saber lo que quiere decirme. Pero seguro que sabe que eres {F#una buena amiga}{M#un buen amigo}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250212703,
					"content": "Jajaja. ¿Ves? ¿Qué te había dicho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Muchas gracias por todo. Esto es tuyo, tómalo como regalo de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "No es fácil entender las necesidades de una cría de saurio. Yo solo he logrado comprender a Houra tras pasar un largo tiempo junto a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Eso es suficiente para mí. Al fin y al cabo, los dos vamos a seguir juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "¿Eh? ¿A dónde ha ido Houra? ¡N-no habrá vuelto a salir corriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "¡Eh! Houra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
