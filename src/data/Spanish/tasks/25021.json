			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Esta vez no puedes salir corriendo, Houra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250210103,
					"content": "Hoy Houra está muy obediente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Sí. Todo gracias a la flotibola que me ayudaste a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Con esa pelota, puedo indicarle a Houra que haga cualquier cosa. Bañarlo, alimentarlo, hacer que se duerma o entrenarlo... ¡Todo es mucho más fácil ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "¡Sobre todo cuando llega el momento de cortarle las uñas! Antes hubiera tenido que perseguirlo por todas partes hasta la extenuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Ahora, con solo ponerle la pelota enfrente, se sienta y me deja hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250210109,
					"content": "#Houra, ¿te acuerdas de {F#ella}{M#él}? {F#Ella}{M#Él} fue quien ayudó a hacer tu juguete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250210111,
					"content": "¡Buen chico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "¡Oh! Houra se acuerda de ti. ¡Y se ha puesto muy contento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "¿Quieres intentar cortarle las uñas? Y ya que estás, podrías limpiarle el cuerno también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "Es algo muy importante para las crías de Tepetlisaurio. Al fin y al cabo tienen que excavar la tierra, por lo debemos limar sus garras frecuentemente y cortar aquellas uñas que crezcan torcidas o estén rotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "Solo así, podremos asegurarnos de que cuando crezca el Tepetlisaurio, sus garras queden perfectas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "¡Ven, toma eso! ¡Aprovechemos que vamos a cortarle las uñas para limpiarlo bien entero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Cuánto detalle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250210121,
					"content": "*Ejem*... Qué raro es verlo tan obediente. Me colma de felicidad pensar que no tendré que perseguirlo hoy por toda la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "... Debe de ser un trabajo muy duro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "¡No es nada! Comencemos, entonces. Yo estaré a tu lado para guiarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Para que Houra se tranquilice, deberías frotarle la espalda suavemente con el cepillo grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Luego puedes usar un cepillo fino para limpiarle el cuerno. Tendrás que emplear un poco de fuerza, o quedará suciedad entre las grietas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Después, toma una toalla para limpiarle todo el cuerpo... Así se relajará poco a poco y extenderá las garras. En ese momento, podrás cortarle las uñas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "Qué explicación tan detallada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Pues claro. Yo mismo crie a Houra. Nadie en la tribu... No, nadie en toda Natlan lo entiende mejor que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "Está bien, córtale las uñas a Houra tal y como te he explicado. Yo estaré a tu lado. Si tienes alguna duda, puedes preguntarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Qué bien entiendes a Houra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "¿Por qué estás tan emocionado de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Acaricias a Houra.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
