					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "¿Por qué la Srta. Moriko siempre me da encargos tan raros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "¿Sigues pintando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "¿Has recuperado la inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "#¡Ah! ¡Viajer{F#a}{M#o}, cuánto tiempo sin verte! Ya pensaba que te habrías ido a algún lugar de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "*Suspira*, si no tuviera tan mala salud, me gustaría acompañarte en tus viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "Así no tendría que aguantar a la Srta. Moriko metiéndome prisa con las entregas cada día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "Las ilustraciones de la última vez recibieron muy buenas críticas. Más y más autores quieren contratar mis servicios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "La Srta. Moriko ha pospuesto muchas de las fechas, pero todavía hay algunas urgentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "Además, los temas de las novelas ligeras de la Editorial Yae son cada vez más... disparatados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "Al principio pensé que solo escribirían sobre Inazuma y tal vez Mondstadt o Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Pero resulta que ahora también escriben sobre Sumeru, y ya tienen la vista puesta en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "#Bueno, olvidémonos de eso ahora. Viajer{F#a}{M#o}, tu Daguerrotipo todavía sigue operativo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "Sip, está como nuevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "¿Vas a pedirme otra vez que capture imágenes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Bueno, la última vez el pago fue justo, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "#Viajer{F#a}{M#o}, por favor, tráeme imágenes de todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "Bien, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Puedes dejar un encargo en el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "¡No hay persona mejor que tú! Jeje, de hecho ya tengo preparadas las notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "Si no nos hubiéramos encontrado, habría mandado a la Srta. Moriko a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "¡Ah! ¡No digas eso! ¡Por favor te lo pido! Ya he colgado encargos en el Gremio antes y no encuentro a nadie que tenga experiencia con un Daguerrotipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "#Por favor, viajer{F#a}{M#o}, hazme el favor. Si no entrego las ilustraciones, ¡la Srta. Moriko vendrá a vivir conmigo otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "¡No soporto el arroz caldoso de cerezo que hace! ¡Mi vida está en tus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Bueno, está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "*Suspira*, menos mal. Espera que voy a por mi cuaderno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}