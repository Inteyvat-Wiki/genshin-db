			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "¡Miren! Estuve hojeando el cuaderno de bitácora de mi padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620102,
					"content": "En él hay un apéndice que menciona una receta especial para hacer cebo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620103,
					"content": "Utilizaron una mezcla de alga y mineral de cristal mágico para atraerlo. Así fue como dieron con el leviatán lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620104,
					"content": "#Si nosotr{F#as}{M#os} lo hacemos, quizás podamos atraerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620105,
					"content": "Si hay algo que tengo de sobra son algas. En cuanto al mineral de cristal mágico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620106,
					"content": "No te preocupes, aquí lo tengo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "¿Eh? ¿En serio? ¿Lo recogiste en Araumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620108,
					"content": "Mi padre menciona en su bitácora que el mineral de cristal mágico debe recolectarse de las ruinas de Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620109,
					"content": "#No entiendo qué diferencia tiene con el mineral de cristal mágico común y corriente, pero ya que decidimos llegar hasta el fondo, hay que ser cuidados{F#as}{M#os} y seguir los apuntes al pie de la letra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620110,
					"content": "Hablando de eso, es un lugar muy peligroso lleno de monstruos. Es mejor que vayamos al Gremio de Aventureros a solicitar un encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620111,
					"content": "No hace falta, yo puedo hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "#Oh... Es verdad. ¡Olvidé que eres {F#una gran aventurera}{M#un gran aventurero}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620113,
					"content": "¡Qué suerte contar con tu ayuda! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620114,
					"content": "Iré por unas herramientas para preparar el cebo. Nos vemos más tarde en la costa oeste de Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266204",
							"2"
						],
						"stepId": 7266204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "#¿Lo encontraron tan rápido? ¡Como era de esperar de {F#una gran aventurera}{M#un gran aventurero}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620202,
					"content": "¿Con esto es suficiente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Sí. Y ahora, presten atención. Hay que hacer esto... y esto... y después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620204,
					"content": "Listo. Con esto basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620205,
					"content": "Y ahora solo tenemos que dispersar el cebo y esperar a que aparezca el leviatán lunar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620206,
					"content": "Humm... Escogí este lugar porque, en aquel entonces, regresamos a esta costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620207,
					"content": "Además, el leviatán lunar que guio nuestro barco también desapareció aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620208,
					"content": "#Bien, ¿están list{F#as}{M#os}? No lo olviden, si ven al leviatán lunar, ¡deben pedir un deseo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620209,
					"content": "¿Y si no aparece?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620211,
					"content": "#¡No seas {F#una}{M#un} aguafiestas! El leviatán lunar vendrá, estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620212,
					"content": "¡Así es, funcionará! ¡Pececito, ven, pececito! ¡Sé un buen pez y muerde el anzuelo, hazlo por Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620213,
					"content": "¡Miren! ¡Algo brilla bajo el agua! ¡Y viene para acá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620214,
					"content": "¿En serio? ¿De verdad es el leviatán lunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620215,
					"content": "¡Ay! ¡Un Guardián de las Ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620216,
					"content": "¡¿Cómo llegó aquí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
