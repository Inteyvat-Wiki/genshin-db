				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "¡Hola, Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "#¡Viajer{F#a}{M#o}! Oh, disculpa. Tengo que dirigirme a ti como {F#Caballera Honoraria}{M#Caballero Honorario}, dadas las circunstancias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "Creo que ya lo sabes, ¿verdad? Eres la Estrella Floral de este año. Harás una ofrenda de flores de viento a Barbatos, el Arconte Anemo, de parte de todos los habitantes de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "Pero... las cosas serán un poco distintas esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "#¡Sí! Con nosotr{F#a}{M#o}s y el bardo de pacotilla aquí, ¡el Festival de las Flores de Viento de este año será el mejor que nunca se haya visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "Cierto. Gracias por vivir en Mondstadt. Espero que sigan disfrutando de su vida aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "La ceremonia floral está a punto de comenzar. Estrella Floral, ¿elegiste ya tu flor de viento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "Entonces tenemos que elegir un tipo de flor y ofrecérsela al Arconte Anemo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Exactamente. Elige con cuidado. No olvides que representas a todo el pueblo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, ¿qué flor te gusta más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "#¿Eh? Qué astut{F#a}{M#o}, ¿estás intentando hacer trampa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "¡Eh! ¡Secretitos en reunión son de mala educación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "¡Ups, nos pillaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "No te preocupes, elige lo que te guste. Confío en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "#Entonces, {F#Caballera Honoraria}{M#Caballero Honorario}, ¿qué eliges?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Diente de león",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "¡Ajá! ¡Apostando por una de las flores favoritas de la gente! ¡Las flores de viento deben ser dientes de león, después de todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "En nombre del pueblo de Mondstadt, ofrece tu flor de viento a la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Margarita voladora",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "¡Ajá! ¡Apostando por una de las flores favoritas de la gente! ¡Las flores de viento deben ser margaritas voladoras, después de todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Cecilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "¡Oh! ¡Así que piensas igual que Beatrix! ¡Cecilias como flores de viento! No es muy común, pero tendrá sus simpatizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Lucetta",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "¡Oh! ¡Así que piensas igual que Nimrod! ¡Lucettas como flores de viento! ¡Una flor que ilumina la oscuridad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Flor dulce",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "¡Oh! ¡Así que piensas igual que Sacarosa! ¡Flores dulces como flores de viento! ¡Una flor que ha perdurado desde la antigüedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Gancho de lobo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "¡Oh! ¡Así que piensas igual que Razor! ¡Ganchos de lobo como flores de viento! ¡Espinosos y punzantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
