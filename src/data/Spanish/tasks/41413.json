				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "Gracias, Estrella Floral, por tu ofrenda sincera a Barbatos, el Arconte Anemo. Que el viento proteja Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Buena elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "¿Te gusta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Jeje, adivina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "¡Típico del bardo de pacotilla! ¡Deja de pedir siempre que adivinemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "¡Jajaja! Está bien, está bien, responderé. Pero no aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "No es una buena idea con tanta gente en la plaza. Necesitamos un cambio de escenario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "¿A dónde podemos ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "Quiero que vengan conmigo a la Guarida de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141307",
							"2"
						],
						"stepId": 4141307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah, qué vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "¡Qué paisaje tan bonito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "¿Verdad? Me gusta este lugar. A veces, cuando no tengo nada que hacer, vengo aquí para sentarme y disfrutar de las vistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "¿Te refieres a sentarte y holgazanear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "¡Jajaja, me descubriste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "Es tan hermoso... Ay, si tuviéramos una botella de sidra a mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "#Entonces, viajer{F#a}{M#o}, ¿te gustó el Festival de las Flores de Viento de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "Rebosa amor y alegría.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Y, aun así, todavía hay algo que quieres preguntar, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Sé lo que quieres preguntar. ¿Qué son las flores de viento exactamente? ¿Y qué significan las flores de viento y el festival para Barbatos, el Arconte Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Como viste, la gente de Mondstadt hace su propia elección. De los millones de flores que existen, algunos eligen el diente de león y otros, la margarita voladora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "Parece que “flor de viento” significa algo único para cada persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Correcto, y que siga así por mucho tiempo. No hay una sola respuesta ni una flor de viento que exista de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Así que las flores de viento... ¿no existen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "El concepto de flores de viento procede de la antigua Mondstadt. Era un código que la gente utilizaba para mantenerse en contacto y organizar la resistencia en secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "En esa época, se solía decir que, cuanto más fuerte soplara el viento, más firmes crecían las raíces de las flores de viento, y más hermosas eran las flores que florecían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Si quieres saber mi opinión, las flores de viento no existen, pero están por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Son el espíritu que ansía la libertad, el coraje de seguir al viento donde quiera que vaya. Todos los objetos que son hermosos y dignos de admiración pueden ser flores de viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "No puedes verlos, pero notas su presencia en todas partes... ¡igual que el viento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Jaja, bien dicho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Entonces, ¿qué son las flores de viento? Algo que Barbatos, el Arconte Anemo, no va a definir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Flores de bendiciones, flores de respeto, flores de amor... Cada persona tiene su propia flor de viento y cada persona tiene el derecho de definirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Supongo que no es de sorprender que la flor que le da la Capital de la Libertad a su Arconte sea en sí misma una expresión de libertad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "A mí también me gusta la sensación de libertad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "Es la voluntad compartida la que trae a las personas al mismo camino. Y, ciertamente, el viento de la libertad fue lo que hizo que nos encontráramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "Sopla desde el final del camino, desde el fin del mundo, desde las profundidades de nuestros corazones, y nunca se detiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "“¿Quién acarició tu rostro herido pero determinado\\nal lado de los riachuelos\\nal lado de las grandes rocas?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "“¿Quién abrazó tu alma noble y cansada\\nen los más profundos sueños\\nen lo alto de los cielos?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "#“{F#Querida amiga}{M#Querido amigo}:\\nte llevo de la mano\\nhacia la noche en la que brillan las linternas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "“Para contarte una historia de sueños y libertad\\nla historia de cómo comenzó este festival”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "Es genial ver a todo el mundo reunido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "¡Qué atmósfera tan agradable!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
