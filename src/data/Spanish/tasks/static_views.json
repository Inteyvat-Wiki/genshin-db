			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "¡Paimon quiere ver! ¿Eh? ¿Esto que había dentro es la pintura de algún aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "No está bien hurgar en las cosas de los demás...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "¡Mira quién habla! Quién sabe en cuántos campamentos de aventureros y cofres del tesoro hemos hurgado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "#Digamos que no vimos a ningún aranara cerca de la casa y estábamos muy preocupad{F#as}{M#os}, así que decidimos ver si había alguna pista. ¡Tal vez incluso ayudemos a un aranara en peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Tienes razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "¡Ja! ¡Por supuesto! De todas formas, esta pintura es un paisaje de los alrededores, ¿no? Oh, ¡tal vez sea el mapa de algún tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, ¡vayamos a mirar el sitio que muestra la pintura! ¡Tal vez haya un tesoro de los aranara escondido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "¡Esa es una gran verdad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
