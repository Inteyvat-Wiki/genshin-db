			"dialogs": [
				{
					"id": 750470401,
					"content": "Humm, ya tengo mi peso bajo control, pero... ¿Eh? ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Disculpa, ¿quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Oh, soy la centinela de este puesto de avanzada, aunque ahora mismo estoy de vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Si necesitas algo, habla con Yukom, del puesto de al lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "¿Qué te preocupa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Puff, pues lo cierto es que, como he engordado un poco, últimamente le estoy añadiendo verduras saludables al mahís que como.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "La cosa es que, no sé cómo, mi compañero Ur ha empezado a imitarme y también está comiendo mucha verdura. Los saurios son omnívoros, pero si comen demasiadas verduras, no estarán ingiriendo todos los nutrientes que necesitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Creo que debería encontrar un momento para hablarlo con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "No es nada, adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "#Oh, de acuerdo. Pues que tengas un buen viaje, foraster{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
