			"dialogs": [
				{
					"id": 751340401,
					"content": "¡Por fin están de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340402,
					"content": "¿Y bien? ¿Qué encontraron ahí abajo? ¡Vamos, cuéntenmelo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340403
					],
					"speakerTitle": "Bona"
				},
				{
