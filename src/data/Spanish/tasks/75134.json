			"dialogs": [
				{
					"id": 751340301,
					"content": "*Fiu*, por fin terminamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340302,
					"content": "Y también, por fin se tranquilizaron los Autómatas Fuentenigma que lo protegían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340303,
					"content": "Genial, ¡pues vamos a ver qué hay aquí dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340304,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "Sea lo que sea, más vale que no defraude a Paimon... ¿Eh? Es otra pirofosforita. Entonces, ¿había más de una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340306,
					"content": "Humm, mira, ¿no te suena de algo el pergamino en el que está envuelta? Se parece mucho a esas notas que leímos en la torre que había fuera de las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340307,
					"content": "Grrr... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#Es muy extraño, ¿verdad, {REALNAME[ID(2)|SHOWHOST(true)]}? {NICKNAME}, mira a ver qué pone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340309,
					"content": "Guau, pues sí que son notas escritas por esa aventurera. O sea, que el Corazón de Chu'ulel es esto de aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340310,
					"content": "Podría haber más posibilidades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "Sí... Además, si hemos encontrado otra pirofosforita aquí, quién dice que no vaya a haber más en otros sitios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340312,
					"content": "Hay demasiadas cosas que aún no entendemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "Sí... Además, si Coco ha querido traernos hasta aquí, ¿es porque ya sabía que encontraríamos otra pirofosforita? Puff, Paimon no entiende nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340314,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "Será mejor que regresemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "Sí, seguramente Coco sepa algo al respecto. Además, le prometimos a Bona que volveríamos con lo que hubiéramos encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340317,
					"content": "Deberíamos llevársela a Bona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "Sí. A lo mejor Bona descubre algo si la ve. Además, le prometimos a Bona que volveríamos con lo que hubiéramos encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340319,
					"content": "Será mejor que nos vayamos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
