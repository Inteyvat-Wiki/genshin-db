			"dialogs": [
				{
					"id": 751340401,
					"content": "¡Por fin están de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340402,
					"content": "¿Y bien? ¿Qué encontraron ahí abajo? ¡Vamos, cuéntenmelo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340403
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340403,
					"content": "Pues, verás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340404,
					"content": "Le cuentan a Bona lo que vieron y descubrieron...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "¡¿Cómo?! ¡¿Que encontraron una pirofosforita ahí abajo?! Guau, pensé que la mía era la única en el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340406
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340406,
					"content": "Un momento, ¿y si la mía es, en realidad, una falsificación? Humm, eso explicaría por qué no he descubierto nada especial sobre ella en todos estos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340407
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340407,
					"content": "No creo que ese sea el caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340408
					]
				},
				{
					"id": 751340408,
					"content": "Sí, la que encontramos es igual que esta. No tiene nada de especial a excepción de unos patrones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340409,
					"content": "También descubrimos algo más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340410
					]
				},
				{
					"id": 751340410,
					"content": "Ah, sí, encontramos unas notas muy extrañas que parecían haber sido escritas por una aventurera que había venido antes aquí. ¿Quieres leerlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340411,
					"content": "¿Las notas de una aventurera? Cualquier aventurero que haya venido a esta ciudad maldita solo puede haberlo hecho para buscar el Jade del Retorno, así que... no, prefiero no leerlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340412
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340412,
					"content": "¿Eh? Pero hablan de la pirofosforita y del altar, a lo mejor son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340413,
					"content": "Sí, sí, lo entiendo, pero precisamente por eso, no quiero leerlas hasta que encuentre el Jade del Retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340414
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340414,
					"content": "Pero ¿por qué? Paimon no lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340415,
					"content": "A lo largo de los años, incontables aventureros emprendieron un viaje para buscar el Tonatiuh y el Jade del Retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340416
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340416,
					"content": "Pero todos y cada uno de ellos fracasaron sin excepción, por lo que nadie ha podido demostrar que ese barco celestial existe de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340417
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340417,
					"content": "Por eso, mucha gente cree que no es más que un sueño irreal, una ilusión que tienen que sirve de consuelo para aquellos que han sufrido por culpa del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340418
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340418,
					"content": "Así que ningún cuentacuentos documentará sus aventuras, y nadie alabará sus hazañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340419
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340419,
					"content": "Si no encontramos el Tonatiuh y no conseguimos el Jade del Retorno, ¡todo lo que hicieron habrá sido en vano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340420
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340420,
					"content": "El viaje en sí es lo que tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340421
					]
				},
				{
					"id": 751340421,
					"content": "¿Eso piensas? En Natlan no hay muchos aventureros que consideren que lo más importante es la experiencia en sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340422
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340422,
					"content": "Hay algunos que no han conseguido nunca nada, pero la mayoría necesitan algo material para demostrar su valía, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340423
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340423,
					"content": "La experiencia también es importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340424
					]
				},
				{
					"id": 751340424,
					"content": "Claro, pero eso lo dices partiendo de la base de que el Tonatiuh existe. Sin embargo, ¿qué pasaría si ese no fuera el caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340425
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340425,
					"content": "Por eso, no hay otra opción: debo encontrar el Tonatiuh, ya sea por mi padre o por todos los aventureros que dieron su vida para conseguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340426
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340426,
					"content": "Da igual de quién sean esas notas que encontraron. Para mí, no significan nada hasta que hayamos llegado al Tonatiuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340427
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340427,
					"content": "#Así que, {NICKNAME}, Paimon, una vez que lo hayamos encontrado y hayamos regresado a salvo, ¡vayan a contarle nuestra gran hazaña a todo el Gremio de Aventureros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340428
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340428,
					"content": "Paimon puede hacerlo, se le dan muy bien ese tipo de cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340429
					]
				},
				{
					"id": 751340429,
					"content": "Oye, ¿qué quieres decir con eso? ¿Que Paimon alardea demasiado? Si encontramos ese barco legendario, ¡con decírselo a Katheryne será suficiente para que se extienda por todo Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340430,
					"content": "Yo puedo hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340431
					]
				},
				{
					"id": 751340431,
					"content": "#Sí, como somos {F#unas aventureras legendarias}{M#unos aventureros legendarios}, si se lo decimos a algún reportero, ¡seguro que apareceremos en los titulares de los periódicos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340432,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} puede hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340433
					]
				},
				{
					"id": 751340433,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340434
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340434,
					"content": "Seguro que estaría encantado de hacerlo, pero aunque quisiera, solo podría decírselo a algún “sauriaventurero”... Espera, ¿hay saurios aventureros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340435,
					"content": "Jaja, muy bien. Bueno, llevamos un buen rato hablando, ¡pero aún no me han enseñado esa pirofosforita que encontraron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340436
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340436,
					"content": "#Ah, cierto. {NICKNAME}, muéstrasela, a lo mejor a Coco se le ocurre algo cuando la vea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340437,
					"content": "Gluuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340438
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751340438,
					"content": "Gruuu, grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340439
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340439,
					"content": "¿Qu-qué está pasando? ¡Una luz! ¡Está cegando a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340440,
					"content": "¡Ñiii! ¡Gluuu, ñiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340441
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751340441,
					"content": "Vaya, ¡parece que Coco recuperó sus fuerzas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340442,
					"content": "Ya puede usar el Rayo lumínico superpoderoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340443
					]
				},
				{
					"id": 751340443,
					"content": "#{NICKNAME}, ¿cómo puedes acordarte de ese nombre tan largo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340444,
					"content": "Pero, sí, tienes razón. Tal vez, al igual que esos fragmentos de energía que encontramos antes, la pirofosforita sirva para almacenar este tipo de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340445,
					"content": "Puede que la pirofosforita contenga esa clase de energía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340446
					]
				},
				{
					"id": 751340446,
					"content": "Sí, tal vez, al igual que esos fragmentos de energía que encontramos antes, la pirofosforita sirva para almacenar este tipo de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340447,
					"content": "Y probablemente Coco pueda hacer frente al Abismo gracias a ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340448,
					"content": "¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340449
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340449,
					"content": "#{NICKNAME}, Paimon, miren esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340450
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340450,
					"content": "¿Qué pasa? ¡Guau! ¡El mural cambió por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340451,
					"content": "Resulta que el mural que vimos antes tapaba a este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340452
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340452,
					"content": "Vimos esto en otro mural hace tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340453
					]
				},
				{
					"id": 751340453,
					"content": "Cierto, ¿no es este el mismo gran dragón negro que vimos en el mural de las ruinas en las que encontramos el primer Disco Dorado de la Diplomacia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340454,
					"content": "A juzgar por esta pintura, ese dragón tiene pinta de ser el dueño de este sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340455,
					"content": "El dragón toma la ciudad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340456
					]
				},
				{
					"id": 751340456,
					"content": "A juzgar por esta pintura, ese dragón malvado tiene pinta de ser el dueño de este sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340457,
					"content": "Ñiii... ¡Gluuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340458
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751340458,
					"content": "Coco, ¿sabes algo sobre este mural?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340459,
					"content": "¡Yiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340460
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751340460,
					"content": "Oh, esta vez la luz apunta hacia el cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340461
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340461,
					"content": "¡Gluuu, gluuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340462
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751340462,
					"content": "Sí, esta vez no nos equivocaremos. ¡Seguro que el Altar del Fuego Primigenio está en el punto más alto de esta antigua ciudad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340463
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340463,
					"content": "¿Estás segura? Paimon empieza a preocuparse cada vez que dices algo con tanta confianza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340464,
					"content": "¡Vamos, confía en mí una vez más! Tengo el presentimiento de que esta vez no nos equivocaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340465
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340465,
					"content": "¿Ahora te basas en presentimientos?... Bueno, está bien, tampoco es que tengamos otra alternativa. Subamos, pues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}