						223070804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070804,
					"content": "Si no tienes inconvenientes, dímelo y te marcaré el lugar de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070805,
					"content": "Pero tiene un costo, jeje. Déjame pensar... <color=#00E1FFFF>100 Moras</color>, ¿qué te parece?",
