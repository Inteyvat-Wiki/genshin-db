			"dialogs": [
				{
					"id": 223070301,
					"content": "Sí, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070302
					]
				},
				{
					"id": 223070302,
					"content": "Bien, te marcaré los lugares ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070303,
					"content": "Después de que encuentres los tesoros, no olvides regresar para repartirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
