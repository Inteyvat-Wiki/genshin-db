						223070802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070802,
					"content": "Debo admitir que, cuando los recibí, le pedí a unas cuantas personas que le echaran un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070803,
					"content": "Tengo una idea general de dónde pueden estar los tesoros, pero me dijeron que si me llevaban, tendría que pagar una tarifa adicional, así que decidí mejor quedarme aquí.",
					"roleType": "TALK_ROLE_NPC",
