			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "#Hola, amig{F#a}{M#o}, ¿quiere comprar algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070202,
					"content": "Quiero los mapas del tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "¿Mapas del tesoro? Te refieres a los que empeñó Zhangshun, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070204,
					"content": "¿De verdad quieres ir a buscar el tesoro escondido? Para mí, lo que esconde no son más que cacharros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070205,
					"content": "#Puedo ver que eres {F#una gran aventurera}{M#un gran aventurero}. Con solo escuchar la palabra “tesoro”, te brillan los ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070206,
					"content": "Pero bueno, a mí no me sirven estos mapas, así que no tengo problema con dártelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070207,
					"content": "Aunque si realmente encuentras el tesoro, lo repartiremos en partes iguales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070208,
					"content": "Después de todo, he guardado estos mapas por mucho tiempo, y alguien tiene que pagar por su costo de almacenamiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 2230703,
