			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "¿Qué debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "Era marinero de la Flota Crux Meridianam, pero tuve un accidente y me lastimé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070104,
					"content": "Después de abandonar la flota, y para ganarme unos Moras, empeñé unos cuantos mapas de tesoros a un hombre de negocios llamado Bolai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070105,
					"content": "Si de verdad están esos tesoros ahí, acordamos que nos lo repartiríamos en partes iguales, pero no he oído noticias de él, así que sospecho que ni siquiera ha ido a buscarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070106,
					"content": "#De seguir así, no llegaremos a ningún lado. ¿Estarías dispuest{F#a}{M#o} a ayudarme a buscar el tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070107,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "Perfecto, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070120,
					"content": "Primero ve con <color=#00E1FFFF>Bolai</color> y toma los <color=#00E1FFFF>mapas del tesoro</color>. Cuando hayas encontrado el <color=#00E1FFFF>tesoro</color>, ve y dáselo a <color=#00E1FFFF>Bolai</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070121,
					"content": "Hablé con él para que cuidara mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070109,
					"content": "¿Por qué dejaste la flota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "Conozco bien mi estado de salud, y mi vieja lesión podría reaparecer en cualquier momento. No quiero ser una carga para la flota, así que renuncié.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070111,
					"content": "Después monté un pequeño negocio de venta de chatarra para ganarme la vida, pero no es fácil, y ya casi me quedo sin productos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070112,
					"content": "Antes tenía mapas de tesoros. Eran parte del botín que conseguí en mis días como miembro de la flota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070113,
					"content": "Pero en estas condiciones me cuesta mucho caminar, ¿cómo podría ir a explorar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070114,
					"content": "Así que empeñé algunos mapas de tesoro a un sujeto llamado Bolai a cambio de unos cuantos Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070115,
					"content": "Pero él tampoco puede ir a buscarlos. Después de todo, es un simple comerciante. Por eso te pido que vayas a buscarlos tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070116,
					"content": "¿De verdad hay un gran tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "¡Jaja! No lo creo, estos mapas también se los reparten en la flota como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070118,
					"content": "Si hubiera un tesoro grande, la flota ya estaría tras la pista, o ya lo habría tomado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070119,
					"content": "Pero aunque no sea un tesoro grande, debe valer algo de dinero. Al menos lo suficiente para tres personas. Así que te pido que lo busques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
