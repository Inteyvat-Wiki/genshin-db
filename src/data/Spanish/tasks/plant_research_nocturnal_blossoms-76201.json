			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "... Metta, eres una aguafiestas. Solo quería que te divirtieras durante la aventura. ¿Por qué tienes que decir esas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Si no corriges esa manía tuya de actuar impulsivamente, los demás tampoco te van a aguantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "¡Eso no es actuar impulsivamente! Yo... yo también tengo mis propios planes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Planes, ¿eh? Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "¡Ya me estás desestimando otra vez! ¡No pienso volver a hablarte nunca más! Y cuando te arrepientas, ¡ya será demasiado tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "... ¡Ah, Linnéa! Oye, Metta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Tras escuchar el relato entrecortado de Vesa sobre lo ocurrido, parece que solo se trataba de una pequeña disputa típica de niños...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Piensa lo que quieras, pero yo no soy la que tiene la culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "¡P-pues yo tampoco hice nada malo! Linnéa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Humm... A veces pasan estas cosas, ¿saben? Nadie hace nada mal, pero aun así el resultado no es el que esperábamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010211,
					"content": "Ah, como la historia de las hermanas Descendientes Lunaescarcha, representadas por la flor sombranocturna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010212,
					"content": "¿La historia de las hermanas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Pues sí. Cuenta la leyenda que había dos hermanas Descendientes Lunaescarcha. Sus personalidades eran completamente opuestas, como el rosa y el azul de las flores sombranocturnas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010214,
					"content": "Ambas hermanas hicieron lo que creyeron correcto, pero precisamente por eso terminaron separándose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010215,
					"content": "Dicen que la hermana menor nunca perdonó a la mayor por haberla abandonado, a pesar de que esta salvó muchas vidas al hacerlo... Pero al final, ambas murieron sin volver a verse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010216,
					"content": "Los Descendientes Lunaescarcha tienen una historia así... Nunca la había oído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Yo tampoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Yo la escuché de un bardo, así que puede que haya algo de fantasía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010219,
					"content": "Oh, así que es una historia inventada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "¡Ay, bueno! Aunque la historia pueda ser inventada, la moraleja sigue siendo válida, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010221,
					"content": "Ninguna de las dos creía estar equivocada. Ambas estaban convencidas de que su elección era la correcta, pero esas mismas elecciones las separaron para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010222,
					"content": "Si para demostrar que tienen razón tuvieran que perder a un amigo... ¿qué elegirían ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Bueno, la verdad es que no está tan mal tener pequeños imprevistos de vez en cuando durante las aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "... ¡Sí! Ahora que lo pienso, el tiempo que Metta ha pasado conmigo de aventuras es muy valioso. Si cambiara de opinión a cada rato, no podría disfrutar de nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "La próxima vez... ¡La próxima vez lo planificaré mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Jeje, me alegra mucho que se hayan reconciliado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762010229,
					"content": "Si encontramos alguna piedra poco común cuando vayamos de aventura con Vesa, la llevaremos al Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "¡Genial! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnéa"
				}
			]
		},
