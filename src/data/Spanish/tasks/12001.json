				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Robusto Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "¿Quién está ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010302,
					"content": "#{F#Una}{M#Un} comerciante de Mondstadt que viene a una reunión con el Burgués Maotsai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Ah, ¿sí? No mencionó nada sobre una reunión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010306,
					"content": "El maestro tiene algunos asuntos urgentes el día de hoy. Todas las citas anteriores han sido canceladas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010307,
					"content": "¿Asuntos urgentes? ¿De qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "El maestro ha estado trabajando en un negocio muy importante. Se fue temprano esta mañana para verse con su cliente vip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010309,
					"content": "Entonces, ¿dónde está ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Lo siento, el maestro fue muy claro al decir que no debemos revelar esa información a cualquier visitante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010311,
					"content": "#¿“Cualquier visitante”? ¿Estás diciendo que no somos client{F#as}{M#es} vip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "#¡N-no! Quiero decir, ¡sí que lo son! No quise ofenderl{F#as}{M#os}, por favor, créanme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010313,
					"content": "¡Llévame con el Burgués Maotsai o sufre las consecuencias!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "¡Lo siento, lo siento! ¡El maestro se encuentra en un asunto de negocios en el Quiosco Xinyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010316,
					"content": "¡Le ruego piedad! Por favor, el Maestro no será tan bondadoso si se entera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010317,
					"content": "#Bueno, mi Maestr{F#a}{M#o} tiene cosas mucho más importantes que hacer que hablar con guardias groseros como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Por suerte para ti, ¡tu mala actitud será lo último en su mente cuando esté ocupad{F#a}{M#o} haciendo negocios con tu jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "¡Gracias, gracias! ¡Que su negocio sea bendecido para siempre por el Rey Geo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "El Robusto Wu"
				},
				{
					"id": 120010320,
					"content": "#¡Guau, {NICKNAME}! ¡No imaginé que tendrías esta habilidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Lo improvisé sobre la marcha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "¿En serio? Lo tendré en cuenta en el futuro para no dejarme engañar por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Según lo que dijeron los guardias, parece que los invitados de honor son Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Yo también creo lo mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Entonces, ¡vamos al Quiosco Xinyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Podríamos usarlo a nuestro favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "¡Tú tampoco lo hiciste nada mal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Jeje, como muestra de agradecimiento, ¡te invitaré a comer en otra ocasión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Tu maestro tendrá que pagar por la falta que has cometido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#¡Soy {NICKNAME}, client{F#a}{M#e} vip de tu jefe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Qué extraño, no estás en la lista de invitados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "El Robusto Wu"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Burgués Maotsai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Entendido. Así lo haré. No se preocupe, tiene mi palabra de que el pedido se completará según lo prometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 120010702,
					"content": "Humm... El subordinado que envié no tenía una opinión tan optimista... ¿Acaso alguien no está cooperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Recaudador"
				},
				{
					"id": 120010703,
					"content": "Ah... Acabamos de encontrarnos con un pequeño problema, eso es todo. Aún no logramos comprar el cor lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 120010704,
					"content": "Pero no es nada de lo que deba preocuparse. Si Chang el Noveno no lo vende, puedo comprárselo a otra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 120010705,
					"content": "Eso sería ideal. Te recuerdo que a los Fatui solo nos importan los resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Recaudador"
				},
				{
					"id": 120010706,
					"content": "Los Fatui podemos apoyarte para completar el pedido, pero si no lo terminas a tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Recaudador"
				},
				{
					"id": 120010707,
					"content": "Te darás cuenta que nuestra buena voluntad tiene un precio que no puedes pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Recaudador"
				},
				{
					"id": 120010708,
					"content": "Entendido... estoy en deuda con usted por su protección. Sabe que no me atrevería a decepcionarle, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 120010709,
					"content": "Lo veremos cuando llegue el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Recaudador"
				},
				{
					"id": 120010710,
					"content": "Uf... ¡Maldita sea, ese viejo Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Burgués Maotsai"
				},
				{
					"id": 610045701,
					"content": "¡Así que el bribón del Burgués Maotsai trabaja para los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "No sé si el nerd de Guhua habrá hecho algo. Vamos a contárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingchiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "¡Hum! Señor misterioso, dijiste que tenías que investigar otras cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Y resulta que solo cambiaste de lugar para seguir leyendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Ya sabemos cuál es el negocio del Burgués Maotsai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Ya veo. Es tal y como supuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010805,
					"content": "¿Realmente lo supiste o solamente lo dices para sonar inteligente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "El curso de acción que debemos tomar está claro. Primero, entrega esta carta al Gremio de Comerciantes de Feiyun. Ellos sabrán qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010807,
					"content": "Por razones que no puedo decir, no podré unirme a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010808,
					"content": "No es necesario que lean el contenido de la carta. Cuando llegue el momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010809,
					"content": "Uf, ¡estos garabatos lastiman los ojos de Paimon! ¡No le veo ni pies ni cabeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "¿Está en una escritura antigua, tal vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010813,
					"content": "Por eso dije que no era necesario que lo leyeran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010814,
					"content": "En el Gremio de Comerciantes de Feiyun habrá alguien que pueda leerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010815,
					"content": "Pero ¿por qué quieres involucrarlos? Son uno de los gremios de comerciantes más grandes de Liyue. ¿Por qué querrían ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "¿Qué es el Gremio de Comerciantes de Feiyun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Desde que llegamos a Liyue, todo el mundo no deja de hablar de ellos. Parece que supervisan gran parte de los negocios de por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Sería genial que una institución tan grande nos respaldara, pero ¿estás seguro de que querrán ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "No se preocupen. Por lo que sé, comparten mi sentido del honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010820,
					"content": "Cuando lean el caso que expongo cuidadosamente en esta carta, no dudarán en actuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010821,
					"content": "¿De verdad funcionará?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Si quieren darle una lección al Burgués Maotsai, no basta con nosotros solamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010824,
					"content": "Además, no quiero que la gente sepa que yo estoy detrás de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010825,
					"content": "¿Por qué? ¿Solo lo estás haciendo para ayudar a Chang el Noveno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "“No ser alabado, no ser culpado. Eso desea un caballero consumado”. Ese es el espíritu de un caballero de verdad. Saber que se ha hecho justicia es la mejor recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010827,
					"content": "Por cada gota de amabilidad que recibo, me corresponde pagar con un manantial de gratitud. No busco alabanzas ni recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010828,
					"content": "Esa es una forma elegante de decir que quieres seguir sentado leyendo libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Les agradezco de antemano que entreguen esta misiva al asistente del Gremio de Comerciantes de Feiyun. Alguien del gremio debe estar en los alrededores del Pabellón Liuli en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120010830,
					"content": "¡No me ignores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "¿Por qué tenemos que buscarlos a ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "¿Tal vez sea una especie de código?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}