			"dialogs": [
				{
					"id": 761910301,
					"content": "Es un acuibara plateado de verdad, no está teñido ni estoy viendo mal. Es rarísimo, increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910302,
					"content": "Antes nos esforzamos un montón buscándolo en Natlan y no lo encontramos, ¡y resulta que lo habían capturado unos contrabandistas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910303,
					"content": "Aunque parece que no está herido... Jeje, un acuibara plateado. Nunca pensé que vería uno con mis propios ojos. Lo tocaré a ver si hay alguna diferencia entre uno plateado y uno normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910304,
					"content": "¡Cómo quema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910305,
					"content": "¿?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 761910306,
					"content": "¡Casi se me olvida que sigues en la olla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910307,
					"content": "¿Será que ya te has acostumbrado al flogisto líquido de Natlan y por eso esta temperatura no te afecta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910308,
					"content": "En fin, ¡vuelve conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910309,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acuibara"
				}
			]
		},
