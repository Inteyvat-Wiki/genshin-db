			"dialogs": [
				{
					"id": 761910201,
					"content": "Te lo he dicho mil veces: mantén los ojos bien abiertos. Esta mercancía de primera la pidió expresamente un cliente habitual de Snezhnogrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Genial, ¿y ahora qué? ¿Desde que trabajas para mí te has vuelto vegetariano o qué? ¿De repente te ha dado un ataque de bondad y la has dejado escapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Deja que te lo explique. De verdad que no fue mi culpa, fue ese Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "¿Hilichurls? ¡Cómo te atreves a decir eso! ¡Vas a arruinar la reputación de los Ladrones de Tesoros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "¡Es que no puedo con ellos, de verdad que no puedo! Esos dos, el azul y el verde, pegan más fuerte que los Recaudadores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Estos dos tipos tienen toda la pinta de ser contrabandistas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910207,
					"content": "... ¡¿Quién anda ahí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "¡Ay, Lumi! ¡Todavía no es momento de que aparezcas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910209,
					"content": "¿Qué es eso?... Parece bastante inusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Podrás encargarte de esa niñita, ¿no? Esa cosa parece bastante especial, así que podremos usarla para reemplazar al animal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "¡Y encima quieren hacerle cosas malas a Lumi! Es por gente como ustedes que los Ladrones de Tesoros tienen tan mala reputación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761910213,
					"content": "Eh... ¿Qué reputación tienen los Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "¡Deja de parlotear con ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
