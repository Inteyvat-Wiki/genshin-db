				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*Solloza*... Mis queridas flores están fatal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Es una pena... ¿Resulta que las flores no podían crecer por el Protofisurador que rondaba por la zona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "... A partir de ahora, ¡no me separaré ni un milímetro de mis flores! ¡Estaré vigilándolas en todo momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Tranquilízate, Cosanzeana. ¡Algún remedio se nos ocurrirá! A Paimon le encantaría saber por qué ese Protofisurador la tomó con unas florecillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "¿Es la primera vez que te sucede esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "¡Esto nunca ha pasado antes! Hum, ¡maldito! ¡Solo se atreve a hacer sus fechorías cuando yo no estoy presente! No estoy enfadada, ¡estoy enfadadísima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Guau... Paimon nunca habría podido imaginar a Cosanzeana tan furiosa... Por lo visto, ella le tenía mucho aprecio a esas flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Pero ahora que Paimon lo recuerda, ese Protofisurador no huyó cuando Cosanzeana se acercó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Quizá las flores no fueron lo que lo atrajeron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Sí, es posible. ¿Qué te parece si investigamos los alrededores del jardín para averiguarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "¿Acaso le molestaban tus flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
