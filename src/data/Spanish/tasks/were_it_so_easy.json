			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#¡Son {NICKNAME} y Paimon, l{F#a}{M#o}s de las flores exóticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Hola, Cosanzeana. ¿Han crecido mucho las flores que te trajimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Ah, las flores... La verdad es que hoy no les he echado un vistazo en todo el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "*Suspira*, ¿no dijiste que te encantaban nuestras flores? ¿Por qué no has ido a verlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Con lo difícil que es conseguir unas flores tan exóticas como esas, por supuesto que estoy deseando ir a cuidarlas. Pero solo con pensar que quizá se marchiten frente a mis ojos... me da miedo ir a verlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "#Oh, vaya, ¿te afecta hasta ese punto?... ¡Entonces vayamos tod{F#a}{M#o}s junt{F#a}{M#o}s a verlas! Ante cualquier problema, ¡nosotr{F#a}{M#o}s estaremos a tu lado para ayudarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Tener miedo no es la mejor solución.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#¡Tienen razón! ¡Vayamos tod{F#a}{M#o}s junt{F#a}{M#o}s! ¡Ya no hay nada que temer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
