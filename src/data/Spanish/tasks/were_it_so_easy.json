						"stepId": 7404908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#¡Bravo, {NICKNAME}! Con un solo “¡pum!” convertiste a esa máquina fea en un hermoso componente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Así nada más volverá a perturbar tu jardín.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Puede que algunas flores ya no tengan salvación, pero al menos las que quedan están en perfecto estado. A partir de ahora, esos tipos no volverán a pisar tu jardín, ¡así que tus flores podrán crecer fuertes y sanas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Eso es genial... Pero a mí también me han dado una lección, y es que tengo que cuidar muy bien de las flores. Les pondré más cariño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "Ustedes dos me regalaron flores exóticas, y además me ayudaron a proteger mi jardín. No sé cómo podría devolverles el favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "No fue nada, pequeña melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "¡Oh, sí! Podría regalarles mis flores más valiosas: ¡las flores que planté yo misma! ¡Estas flores son para ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#¡Oh! Si tan valiosas son estas flores, {NICKNAME} debería plantar más en su propio jardín...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Por cierto, ¿esto no son marealgas? ¿Las marealgas también son flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Las marealgas son plantas, y como son tan bonitas, también son flores. Esto es lo que los humanos llaman “biología”, la cual he estudiado un poco para poder ser una buena floricultora, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Paimon siente que hay algo mal en ese argumento, pero Paimon tampoco es una experta en botánica, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Continuaré esforzándome por ser la mejor floricultora. He escuchado a los humanos decir que los mejores floricultores son capaces de germinar nuevas especies de flores, así que me he propuesto asistir a convenciones de floricultura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "¡Yo también quiero cultivar nuevos tipos de flores y ganar un premio en alguna convención de floricultura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Es estupendo que te veas tan entusiasmada, Cosanzeana... Pero Paimon siente que todavía hay algunos malentendidos difíciles de explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "El motivo por el que quieres participar en una convención sobre floricultura es porque quieres que los humanos contemplen los nuevos tipos de flores que has cultivado, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Sin embargo, tu sentido de la belleza y la estética es diferente del de los humanos... ¿No crees que a ellos les parecerán raras las flores que plantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Estás poniendo mucho interés en su carrera como floricultora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "¡Pues claro! Paimon es su profesora de floricultura. Si Cosanzeana gana un premio, ¡Paimon también ganará renombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Lo importante no es el premio, sino que disfrute cultivando flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "¡También es verdad! ¡Mientras ella considere que sus flores son hermosas, lo serán! La opinión de los demás tampoco es tan importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "No olvides que tienes que cuidar de tu jardín, ¡así te pondrás contenta todos los días al admirar tus hermosas flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "¡Sí! ¡Me aseguraré de que crezcan sanas y fuertes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Ya hemos dado el primer paso hacia el éxito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "Sí, es probable que las nuevas especies de flores que cultive nos resulten un tanto extrañas, ¡pero hay a quienes les atrae lo particular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "¡Cosanzeana! ¡No olvides avisar a Paimon en cuanto hayas cultivado tu primera nueva especie de flor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "¡Por supuesto! ¡Gracias por haberme ayudado tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
