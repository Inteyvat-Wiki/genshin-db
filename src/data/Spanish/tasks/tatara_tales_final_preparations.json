			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "¡Magnífico! Las pruebas anteriores salieron muy bien. ¡Los escaradiablos se purificaron por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "¿Y ahora qué hacemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Solo tenemos que confirmar nuestra ruta de entrada, y podremos comenzar de inmediato. Sin embargo, debemos evitar a esos Fatui... Al parecer tendremos que tomar el camino largo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "La máquina es bastante grande, por lo que deberíamos asegurarnos de ir por un camino seguro para llevarla hasta adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Por ello, me gustaría que volvieras a entrar en la Fragua Mikage para investigar. Si encuentras algún camino roto, por favor, arréglalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Todavía tengo que definir nuestra ruta, pero tener diferentes opciones no nos vendría mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "No sé arreglar caminos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "No hace falta arreglarlo para que sea seguro. Basta con unos tablones para que podamos llevar el dispositivo al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, puedes usar las tablas de madera que hay cerca de aquí. Yo me quedaré para hacer que la máquina sea lo más fiable posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
