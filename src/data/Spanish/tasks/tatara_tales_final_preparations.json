				"points": []
			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "Esperemos que todo vaya bien. Cuanto antes resolvamos este asunto, mejor. Quién sabe lo que pasará si nos retrasamos más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212009",
							"2"
						],
						"stepId": 7212009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Muy bien. ¿Reparaste los caminos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Ya son seguros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Bien. E-entonces, en un momento nos pondremos en marcha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "¿Pasa algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "Estoy... ¡Estoy pensando! Estoy pensando en todas las cosas que podrían pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Por ejemplo, qué haremos si esos lunáticos enmascarados ya extrajeron el núcleo cuando entremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Y entonces podrían empujar la máquina contra algún Guardián de las Ruinas, haciendo que se vuelva loco y nos mande a todos a volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "O tal vez, algún tipo de criatura elemental podría surgir mientras estamos purificando la Fragua Mikage y podría devorar el núcleo de un solo bocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "Y en el peor de los casos, esa serpiente legendaria podría aprovechar esta oportunidad para resucitar. ¡Entonces estaríamos condenados! ¡Se acabó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Tranquilízate, Xavier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "Oh... Lo siento, yo... Mis viejas costumbres están apareciendo de nuevo. Siempre tiendo a ver el peor de los casos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Haré algunos planes y, cuando llegue el momento, iremos a poner fin a esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Que salga todo bien, que salga todo bien, que salga todo bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "No hace falta ser tan dramático...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
