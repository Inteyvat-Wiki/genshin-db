			"dialogs": [
				{
					"id": 730680401,
					"content": "¡Es Aranakula! Está de vuelta en Vanarana, y... ¡viene con un aranara desconocido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680402,
					"content": "#¡Nara {NICKNAME} y Paimon! Máquina divina de Váruna ha sido reparada. Ahora Aranakula puede cuidar de jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680403
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680403,
					"content": "Este es Arakara. Aranakula y Arakara cuidan juntos jardín de Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680404
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680404,
					"content": "Así que este es el jardín del que siempre hablas, Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680405,
					"content": "Sí. Tierra de aquí es perfecta para cultivo de viparyas felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680406
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680406,
					"content": "¿Hay viparyas infelices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680407,
					"content": "No es que sean infelices, solo no están felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680408
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680408,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680409,
					"content": "Es así, hay tierra adecuada para crecer, no falta lluvia ni sol, no hay ningún obstáculo que impida crecer... No hay ninguna razón para no ser feliz, y sin embargo no son tan felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680410
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680410,
					"content": "Humm... Parecen totalmente normales. ¿Acaso este lugar es especial o algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680411,
					"content": "Tierra en Vanarana es muy buena, pero aquí es extraordinaria. Y no solo eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680412
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680412,
					"content": "Arakara y Aranakula se encargan de cuidar de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680413
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680413,
					"content": "¿Cuidarlas? ¿Qué significa eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680414,
					"content": "Tocan música para ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680415
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680415,
					"content": "Y elogian su belleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680416
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680416,
					"content": "¿Esa es la diferencia entre una viparyas domesticada y una salvaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680417
					]
				},
				{
					"id": 730680417,
					"content": "Paimon cree entenderlo. ¡Es difícil no ser feliz cuando escuchas buena música y te elogian todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680418,
					"content": "#Claro, como Paimon. Antes de encontrar a {NICKNAME}, Paimon no era infeliz, pero tampoco era tan feliz que digamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680419,
					"content": "#Cuando Paimon viaja con {NICKNAME}, aunque a veces encontramos obstáculos en el camino, ¡Paimon siempre está el doble de feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680420
					],
					"speakerTitle": "Paimon"
				},
