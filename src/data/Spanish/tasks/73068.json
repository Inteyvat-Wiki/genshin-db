			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "¡Hola! El terreno de aquí no se parece al de otros lugares. ¿Tiene algún propósito en especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680103,
					"content": "¿Eh? ¿Por qué no reacciona? ¿No me escuchó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680104,
					"content": "¡Holaaa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "¿Eh? ¿N-nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680108,
					"content": "¿C-cómo? ¿Cómo puede haber nara en Vanarana? ¿Vinieron para atrapar y comer a Arakara? Arakara no sabe tan rico como champiñones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680109,
					"content": "#¿Cómo podríamos hacer algo tan terrible? ¡A nosotr{F#as}{M#os} nos conocen como “{F#las encantadoras amigas}{M#los encantadores amigos} de los aranara”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680110,
					"content": "Nunca he oído a nadie llamarnos así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Ay, aunque no lo hayas oído, es lo que todos piensan. ¡Paimon lo sabe sin necesidad de preguntar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680114,
					"content": "#Bueno, Paimon es Paimon, y {F#esta chica rubia}{M#este chico rubio} es {NICKNAME}, su {F#hermano}{M#hermana} es {F#un buen}{M#una buena} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680115,
					"content": "Tú eres Arakara, ¿cierto? ¿Qué hace un aranara andando solo por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680116,
					"content": "¿Por qué Paimon pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680117,
					"content": "Oh, ¡Paimon solo tiene curiosidad! Se ha convertido en un instinto para Paimon, como cuando ves mariposas o lagartijas, solo quieres atraparlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680118,
					"content": "¿Paimon es un gato volador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680119,
					"content": "¡No!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680120,
					"content": "#Hum, si es algún secreto de los aranara que no se debe contar, entonces no tienes que respondernos. No somos tan desconsiderad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680121,
					"content": "Aunque siento mucha curiosidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Paimon también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680123,
					"content": "¿“Secreto”? Arakara no tiene secretos. Arakara no está haciendo nada, solo está esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680124,
					"content": "¿Esperando? ¿Te refieres a los demás aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680125,
					"content": "Aranakula se fue con Arapandu a Ashaván. Aranakula no sabe cuándo volverán. Máquina divina de Váruna no es buena, no es momento de cuidar jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680126,
					"content": "#¿A nara {NICKNAME} gusta trabajar en campo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680127,
					"content": "Trabajar en el campo es muy complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Solo es complicado en valuka. En bosque, no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680131,
					"content": "¿Por qué nadie le pregunta a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680132,
					"content": "Paimon atrapa mariposas, y lagartijas. Además, parece que no le gusta trabajar en campo. No tendría sentido preguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680133,
					"content": "Paimon podría discutir contigo pero... a Paimon le interesa más el resultado que el proceso. ¿Qué cultivan en el jardín? ¿Es algo delicioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680134,
					"content": "Muy delicioso, pero también es útil para otros fines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680135,
					"content": "Ahora, si Paimon tiene hambre, no vengan a jardín. Vayan a comer champiñones, hay demasiados en bosque. Sería bueno que se coman algunos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680136,
					"content": "Bueno, Aranakula no ha regresado todavía, no podemos empezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680137,
					"content": "#Bien, parece que tendremos que esperar a Aranakula... Vamos, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680129,
					"content": "¡Me encanta trabajar en el campo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "¡Bien! ¡A Arakara también le gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680112,
					"content": "¡Paimon tiene razón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680106,
					"content": "¡A comer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "¡Champiñones deliciosos! ¿Nara también deliciosos? No, no poder comer nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
