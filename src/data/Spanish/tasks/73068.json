					"id": 730680420,
					"content": "Paimon tiene razón. Arakara hará hermosas lámparas con viparyas felices para Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680421
					],
					"speakerTitle": "Arakara"
				},
