			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680201,
					"content": "#¿Nara {NICKNAME} y Paimon? Aranakula y Arapandu se fueron a Ashaván pero aún no regresan. Todavía no podemos comer champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "¡Es Aranakula! ¡Está de vuelta en Vanarana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680302,
					"content": "#¡Nara {NICKNAME} y Paimon! Máquina divina de Váruna ha sido reparada. Ahora Aranakula puede cuidar de jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680303,
					"content": "Así que este es el jardín del que siempre hablas, Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680304,
					"content": "Sí, Aranakula y Arakara cuidan juntos este jardín. Tierra de aquí es perfecta para cultivo de viparyas felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680305,
					"content": "¿Hay viparyas infelices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680306,
					"content": "No es que sean infelices, solo no están felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680307,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680308,
					"content": "Es así, hay tierra adecuada para crecer, no falta lluvia ni sol, no hay ningún obstáculo que impida crecer... No hay ninguna razón para no ser feliz, y sin embargo no son tan felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680309,
					"content": "Humm... Parecen totalmente normales. ¿Acaso este lugar es especial o algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680310,
					"content": "Tierra en Vanarana es muy buena, pero aquí es extraordinaria. Y no solo eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680311,
					"content": "Arakara y Aranakula se encargan de cuidar de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680312,
					"content": "¿Cuidarlas? ¿Qué significa eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680313,
					"content": "Tocan música para ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680314,
					"content": "Y elogian su belleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680315,
					"content": "¿Esa es la diferencia entre una viparyas domesticada y una salvaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "Paimon cree entenderlo. ¡Es difícil no ser feliz cuando escuchas buena música y te elogian todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680317,
					"content": "#Claro, como Paimon. Antes de encontrar a {NICKNAME}, Paimon no era infeliz, pero tampoco era tan feliz que digamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680318,
					"content": "#Cuando Paimon viaja con {NICKNAME}, aunque a veces encontramos obstáculos en el camino, ¡Paimon siempre está el doble de feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680319,
					"content": "Paimon tiene razón. Arakara hará hermosas lámparas con viparyas felices para Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680320,
					"content": "Jeje, como Aranakula ya está de vuelta, ¡entonces comencemos! Semillas de viparyas... ¿Las viparyas también tienen semillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680321,
					"content": "Viparyas son sueño de tierra, son cosas que tierra recuerda en sus sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680322,
					"content": "Entonces las semillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680323,
					"content": "Viparyas no tienen semillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680324,
					"content": "¿Eh? ¿Cómo puede haber un jardín sin semillas? ¡Oh! ¿Acaso Aranakula tiene ararakalari y puede hacer crecer las viparyas de la nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680325,
					"content": "No, Paimon está equivocada... Para cultivar viparyas en jardín, se necesita Vasmrti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680326,
					"content": "Vas... ¿Vas... qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680327,
					"content": "“Vasmrti”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "Bosque recordará todo. Si hay vasmrti, tierra recordará de nuevo en sus sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680329,
					"content": "Jardín también dará vida a viparyas felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680330,
					"content": "#Oh, ¿solo los aranara pueden conseguir las vasmrti? ¿Eso significa que {NICKNAME} y yo no podremos cultivar en el jardín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680331,
					"content": "#Nara rubi{F#a}{M#o} ayudó a Aranakula y a otros aranara. Es amig{F#a}{M#o} de aranara, así que Aranakula y nara {NICKNAME} cultivarán viparyas junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680332,
					"content": "#Deja que vasmrti se hunda en tierra, y nacerá viparyas. Inténtalo, nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680333,
					"content": "Sigues las indicaciones de Aranakula y plantas la vasmrti.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "¿Será suficiente con eso? ¡No parece ser muy diferente de cultivar cualquier otra planta! Solo hay que enterrar las semillas y esperar a que germinen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680335,
					"content": "Vasmrti no es semilla. Así como Paimon no es gato volador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680336,
					"content": "Oh... E-está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680337,
					"content": "Hablando de eso, aún quedan muchas parcelas vacías en el jardín. Una, dos, tres... Guau, hay doce parcelas que podrían usarse para cultivar viparyas. Aranakula, ¿tienes más vasmrti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680338,
					"content": "Tenía, pero ya no. Hay que recolectar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680339,
					"content": "Fuera de mundo de sueños hay doce jardines donde vasmrti pueden condensarse. Con ellas, bosque de Vanarana se llenará de viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680340,
					"content": "#Festival Utsava necesita muchas viparyas. Vanarana ya tiene muchas. Pero si hubiera más viparyas felices, aranara estarían felices. Nara {NICKNAME} y Paimon también estarían felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680341,
					"content": "En ese caso, ¡ayudemos a recolectar las vasmrti! Pero ¿cómo recolectamos esas cosas? Arakara dijo que se encuentran en jardines que están fuera del mundo de los sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680342,
					"content": "#Nara rubi{F#a}{M#o}, tienes que pasar por encima de tierra de jardín. Pero solo una vez, no demasiadas veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680343,
					"content": "Si solo pasas una vez, en tierra de jardín se condensará una vasmrti, como lluvia de noche anterior que se convierte en rocío sobre hojas después de amanecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680344,
					"content": "¿Eh? ¡Paimon no entendió nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680345,
					"content": "Pero conociendo a los aranara... Cuando encontremos los jardines fuera del mundo de los sueños, deberíamos ser capaces de entender lo que dice Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680346,
					"content": "Bueno, ¡ya nos enteraremos cuando encontremos un jardín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
