			"dialogs": [
				{
					"id": 705400101,
					"content": "*Bufa*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Sir Narancelot"
				},
				{
					"id": 705400102,
					"content": "*Solloza*... Srta. Rosaria, el gato no deja de bufarme, ¡estoy aterrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Retrocede unos pasos y déjale su espacio, así evitarás que te arañe en la cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "¿Qué está pasando aquí? ¿El gato te está dando problemas, Valerina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "¿El refugio tiene un pequeño invasor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "#¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}, encantadora de gatos! Heladina salió a dar su paseo y ese gato enorme no le quitaba los ojos de encima, hasta la persiguió hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Tranquilo, tranquilo. Aquí nadie te hará daño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Aquí estás a salvo de todas las crueles experiencias que te han hecho vivir y de todos esos tipos horribles que te obligaron a ser un gato malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Ahora estás rodeado de gente buena. Puede que a veces resulten ser un poco pesados, pero ellos siempre querrán lo mejor para ti. Relájate, disfrutar de una vida tranquila te hará bien, y es lo más normal del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*Bufa*... *Lloriquea*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Sir Narancelot"
				},
				{
					"id": 705400112,
					"content": "¿E-el gato ha entendido todo lo que le has dicho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Tiene pinta de que sí. Jaja, qué gato tan listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Guau, este gato es mucho más grande que los otros. ¡Tiene el color de un jugo de burburanja! Oh, y también lleva un pañuelo puesto, ¡con la insignia de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Deberíamos ponerle un nombre... ¡¿Qué les parece Sir Narancelot?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Sir Narancelot"
				},
				{
					"id": 705400117,
					"content": "Se te dan muy bien los gatos, mira qué tranquilo está ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Paimon cree que, solo con unas palabras de Rosaria, Sir Narancelot ha pasado a ser un gato mucho más amable que antes. ¡Rosaria ha hecho de esta fierecilla un angelito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "¡Es a ti a quien se le dan genial los felinos, Rosaria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "No ha sido nada, no me molesta ocuparme de molestias adorables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "Ahora, continuaremos con nuestra siguiente lección de magia felina. Te mostraremos cómo hacer que Sir Narancelot se sienta tranquilo y contento, incluso si desconocemos el motivo por el que se enrabietó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "¿Estás segura de que no te encanta tu nuevo trabajo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Un caballero gatuno que actúa en solitario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}