							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Sí, el <color=#FFCC33FF>mundo exterior</color> está lleno de cosas por descubrir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Sí, fuera hay una gran variedad de comida deliciosa y lugares para divertirse. Además, puedes vivir muchas aventuras interesantes y conocer a personas increíbles. Por ejemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Personas que se centran en la belleza de las cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "¿De verdad? Ay, creía que el mundo exterior estaba lleno de “valor”, y que todos eran personas que quieren ponerse sombreros pero no se atreven a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Eh... pues... es como los pasteles de chocolate: cada uno tiene un sabor único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Si todos los chocolates fueran iguales, todos los pasteles tendrían el mismo sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Buena comparación, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Paimon ha escuchado tantas cosas que al final ha aprendido algo, pero ¿a que Paimon tiene razón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "¿En serio es así? Vaya... entonces tendré que pensármelo mejor... Quizás no estaría tan mal salir de viaje por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "No hay prisa, Esnoir, queda mucho para el siguiente viaje. Aún podemos pensárnoslo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Te has integrado a la perfección en este sitio, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Espléndidos ideales que nunca se desvanecen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Gente que trabaja duro por sus sueños.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
