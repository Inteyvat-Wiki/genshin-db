			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "Lo siento, Rozel. Creo que... es mejor que no vaya contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Me contento con quedarme aquí esperándote. Así, cuando regreses, tendrás a alguien que te reciba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
