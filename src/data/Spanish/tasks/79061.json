					}
				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, por más veces que lo digas, no voy a viajar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Siempre seremos amigos, eso nunca cambiará. Y no es que me caigas mal, es solo que... no me gusta viajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, no es tan terrible como te imaginas. Solo es un viaje, nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "En el mundo exterior hay muchas flores y gente que no encontrarás nunca en el pueblo. Hasta la forma de las nubes es diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "¿Recuerdas las semillas que te traje de fuera? Te aseguro que nunca has visto una flor con una forma y color parecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Aún son semillas. Tengo que plantarlas primero y, cuando florezcan, sabré si es verdad o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Si estás dispuesto a viajar conmigo, quizás podríamos encontrar directamente las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Lo siento, pero no tengo interés en viajar ni en convertirme en uno de esos aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Solo les importa el valor de las alfombras y les dan igual los hermosos sombreros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Así es como te cambian esos viajes... y me da miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Eso es cierto, pero ¿te has fijado en los mapas, las muestras de plantas y los cuadernos de viaje que llevaban en su equipaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Somos como una ráfaga de viento que atraviesa arbustos diferentes, un río que fluye cruzando un lago... Conocemos cosas nuevas y dejamos de ser los mismos de antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "Es un cambio que nos aportan los viajes. Me da miedo, igual que a ti, pero también lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Es como una rebanada de pan con mantequilla por ambos lados: por mucho cuidado que pongas al sujetarla, siempre habrá un lado que terminará hecho un desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Pues yo no untaría las dos caras con mantequilla, lo haría con dos rebanadas y untaría cosas distintas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Es buena idea, seguro que no te quedarías con hambre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "¡Por fin has vuelto! Rozel no para de decirme que el mundo exterior es hermoso y que vaya con él de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "¿Tú conoces el mundo exterior? ¿Realmente es como lo describe Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Es buena idea, así no te mancharías las manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
