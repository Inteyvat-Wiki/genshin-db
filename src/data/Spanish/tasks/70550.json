					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Aquí tienes tu “Buen tiempo”, Klee. ¡Adelante, pruébalo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Guaaaau... Así que este es el color del “Buen tiempo”... Un cielo morado... ¿Es como un cielo estrellado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Más bien es como un atardecer despejado tras la puesta de sol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Voy a beber un poquito primero y a pensarlo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Aaaah, ya está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "¡Qué rico! ¡Es ácido y dulce al mismo tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Si bebiera esto mientras como pescado a la parrilla, seguro que podría comer dos, tres, cuatro... ¡o incluso cinco raciones más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "¡Un vasito me ha sabido a poco! Ahora quiero otro vaso de... ¡una bebida que parezca un pastel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Entendido, ¡marchando un vaso de “Postre líquido”!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Mmm... Yo tampoco sé qué ingredientes poner... ¡Pensémoslo junt{F#a}{M#o}s, Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "¡Esos caramelos que trajiste son muy especiales, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "¿Estos? Jeje... ¡Mamá me enseñó a hacerlos en una mesa de fabricación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Tienen mucho, mucho azúcar, flores que trajo la amiga de Fontaine de mamá, miel de estrellas de la tía Barbie y la mermelada mágica que la tía Tavia le regaló a mamá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Pones los materiales en la mesa de fabricación, pides un deseo con una forma en mente, repites el hechizo con mamá y... ¡pum! ¡Aparece un caramelo con forma de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "Unos ingredientes y un proceso impresionantes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "¡Toma varios caramelos de Dodoco para ti! Si te gustan estos dulces, ¡puedo enseñarte el hechizo de mamá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "¡Así, podrás hacer los caramelos que quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "¡Gracias por compartir tu increíble receta, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Jeje, si hay algo que no entiendas, ¡puedes venir a preguntarme! ¡Soy una gran experta en caramelos mágicos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "¿Hay algo más que quieras hacer hoy, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "¡Sí! Hace poco, mamá me dio un libro supergenial. Tengo que leer un capítulo todas las noches para aprender muchas cosas nuevas, y luego me voy temprano a dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "Gracias a ese libro, aprendí a hacer un “propelente” para que mis Bombas saltarinas lleguen aún más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "¿D-de verdad eso lo pueden aprender los niños?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "No es tan complicado... Se parece mucho a las bombas, solo hay que tener cuidado al tallarlo, ¡como si fuera un lápiz de color!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "El tiempo antes de dormir también es muy importante, porque mamá se sienta a mi lado y me cuenta todo tipo de historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Mamá suele sacar una... una... una lámpara hecha de gemas y ¡“cling”! La enciende para que su luz se refleje en el techo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Entonces, ¿el techo se convirtió en el escenario de los cuentos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "¡Sí, así es! Las lucecitas del techo forman dibujos muy bonitos dependiendo de lo que esté contando mamá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "A veces, mamá se queda dormida mientras me cuenta el cuento, así que Klee va y la tapa con una mantita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#Cuando aprenda a usar esa lámpara, ¡te contaré alguna historia a ti también, Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "¡Perfecto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Jeje. Ahora que me sé un montón de historias, ¡puedo hacer feliz a la gente con cosas nuevas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "¿Vas a comer algo esta noche, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "¡Sí! Cuando llegue a casa, voy a leer mientras como... ¡frutos secos con un poquito de sal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Antes, siempre comía pastel después de cenar, pero la Maestra Jean dice que los pasteles tienen demasiado azúcar, y que comerlos antes de dormir es muy malo porque engordan y dan dolor de muelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "Así que, siguiendo el consejo de la tía Barbie, mamá empezó a darme frutos secos. Dice que son buenos para la memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Tienen un sabor bastante suave, como si rumiaras hierba, pero con un poco de sal no están tan mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "Esa es una buena solución. ¡La nutrición y la salud son muy importantes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "¿Y si pensamos en ingredientes que sean dulces pero saludables?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "¡Sí! Pero, aun así, yo quiero comer algo dulce... Podríamos ponerle al pastel una capa de crema batida más fina o un poco más de fruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Ah, ahora que lo pienso, la amiga de mamá que lleva lentes le regaló una bolsa de frutas de Fontaine redonditas que se llaman burburanjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Comí varias seguidas y estaban muy dulces. Hasta a la Maestra Jean le pareció bien porque, según ella, “¡el dulce de la fruta no es igual que el del azúcar!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Así que, si tengo comer frutos secos, ¿podrías remojarlos primero en jugo de frutas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Una pregunta, Klee, ¿tú cómo te organizas tus tres comidas del día?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "¿Tres comidas? Jeje, a veces como cinco veces al día, ¡y otras hasta siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "¡¿Tantas?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Es que ir de aventuras gasta mucha energía, así que, si comes demasiado de una vez, luego te pesa mucho el estómago... ¡Es mejor comer poquito con cada comida, pero hacerlo unas cuantas veces al día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Antes era Albedo quien se encargaba de mi comida. Siempre la decoraba de forma muy bonita, ¡como si fuera un cuadro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Siendo Albedo, me lo puedo imaginar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Si él está ocupado en Espinadragón, voy a comer al campamento con los demás Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "La tienda de Kaeya siempre es la más ordenada; la de Amber me parece superdivertida, ¡porque a veces está en un árbol! ¡Y la Sra. Hertha es la que prepara mejores comidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "¡Hay muchas más comidas deliciosas e interesantes desde que mamá volvió! Como ese plato que hace con muchos tipos de pescado y caldo de pescado, todo en forma de cubitos como si fuera pudín. ¡Se llama “gelatina de pescado multicolor”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Se me está haciendo la boca agua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "¡Las galletas crujientes de chocolate también están muy buenas! ¡Son un nuevo invento que mamá hizo con chocolate y galletas! Son un poco amargas, pero también crujientes y aromáticas. ¡Después del amargor, viene un dulzor superintenso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Después de comerlas, me siento llena de energía. ¡La próxima vez que nos veamos, te traeré algunas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Bien, ¡ya sé cómo mejorarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "¡Te prepararé otra bebida deliciosa, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "¿Tan rápido? ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "¡Tengo mucha curiosidad por saber lo rica que estará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "¡No se podía esperar menos de una gran aventurera como Alice!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Yo también quiero probar la comida de Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "¡Lo estaré esperando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "¿E-eso no es un poco difícil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "¡Aprenderé la receta y haré unos caramelos deliciosos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "¡Qué postre tan increíble!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Muy bien, ¡marchando otra bebida increíble para Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "¡Te prepararé el sabor que quieras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "Quizá el nombre no sea el más apropiado, ¡déjame cambiarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
			"id": 7055003,
