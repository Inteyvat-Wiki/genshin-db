					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#¿Eeeeeh? ¿Caballer{F#a}{M#o} Honorari{F#a}{M#o}? ¡Yujuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "¡Yujuuu! ¡Hola, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "#Jaja, Eula me dijo que la Sra. Hertha había encontrado a {F#una}{M#un} ayudante muy buen{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "Al verte a ti, ¡enseguida supe que esta era la mejor tienda de bebidas del mundo mundial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "¡Gracias, Klee! ¡Haré que esta sea la mejor tienda de bebidas de Teyvat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "Pero... ¿eso no es ya así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Entonces... de todas las tiendas de bebidas a las que ha ido Klee, ¡la mejor es la {F#de la}{M#del} Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "Porque hagas la bebida que hagas, ¡estoy segura de que me encantará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "¡Esta vez necesito que te pongas en modo estricto, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "O-oh... ¿En serio? Pero... es que no me sale ser mala contigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Deja que piense... ¡Ya sé! ¡Puedo imitar a Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Albedo se pone muy serio cuando corrige el trabajo de Timaeus en persona. ¡Puedo oír todo lo que le dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Genial, ¡pues tú serás la profesora, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Je... ¡Ya verás lo bien que se me da pedir bebidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "Dentro de poco, voy a ir de pesca explosiva con mamá, ¡pero no se lo cuentes a la Maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Hoy fui de pesca explosiva con mamá y pescamos un montón de peces, ¡pero no se lo cuentes a la Maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "Estos días he podido pasar mucho tiempo con mi mamá, ¡así que estoy tan contenta que me da igual que me encierren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Por eso, quiero pedir un “Buen tiempo”. ¡Los días cálidos y soleados me ponen de muy buen humor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "De acuerdo, profesora Klee. ¡Me pongo manos a la obra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Jeje, ¿a qué sabrá?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Entendido, maestra Klee. ¡Me pongo manos a la obra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "¡Klee, la gran alquimista!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Si algo no te gusta, ¡puedes decírmelo sin problema, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "#¡Gracias, Klee! ¡Me esforzaré para ser {F#la}{M#el} mejor cocteler{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "¡Yujuuu! ¡Klee, eres mi nueva clienta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
