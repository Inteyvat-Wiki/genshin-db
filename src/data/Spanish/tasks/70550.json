							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500301,
					"content": "¡Tachááán! ¡Listo! ¡Seguro que te encanta esta nueva bebida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "¡Guaaaau! ¡Hay un caramelo de Dodoco en la bebida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "Hay mucho color naranja en el vaso y Dodoco parece estar recostado sobre una nube blanca... ¡Este “buen tiempo” es mejor aún!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "¿Quieres probarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "¡Mmm! ¡Qué rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Pero tengo que beber despacio. Si lo hago de un solo trago, no disfrutaré del sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#Es increíble... Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¿cómo hiciste para meter la luz del sol en un jugo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "¡Ya no estoy nada cansada! Siento mucha calidez, pero también... tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#Guaaaau... ¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}, eres {F#la}{M#el} mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "¿Qué tal si le pones un nombre a esta bebida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "¿De verdad me dejarías hacerlo? A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Hace buen tiempo y estoy de buen humor, así que seguro que a Dodoco le apetece cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "Si Dodoco canta, yo también canto con él como si fuéramos un coro, así que la bebida se llamará... ¡“Dodocoro soleado”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "¡Buen nombre, me gusta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "#Jeje, ¡gracias por hacer una bebida tan rica para Klee, Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500318,
					"content": "¡Voy a contarle a mamá que la mejor bebida de Mondstadt es el Dodocoro soleado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500319,
					"content": "¡Si tú estás contenta, yo también lo estoy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#Voy a escribir en un papelito el hechizo de mamá y te lo doy, Caballer{F#a}{M#o} Honorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500322,
					"content": "Así, ¡puedes aprender a usar magia y hacer los caramelos que tú quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500323,
					"content": "¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500320,
					"content": "Menos mal, ¡pasé la prueba de la profesora Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "¡Eres la mejor poniendo nombres, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "¿Qué tal si le pones un nombre genial, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
	]
