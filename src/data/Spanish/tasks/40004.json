	"talks": [
		{
			"id": 4000402,
			"completionStepIds": [
				4000402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
