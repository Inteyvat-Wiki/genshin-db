			},
			"dialogs": [
				{
					"id": 400040901,
					"content": "Amigo, estás en el lugar equivocado. No se a dónde vayas, pero te aseguro que no es por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040902
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040902,
					"content": "¿No queda por allá Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Por supuesto que es por allá, por aquí no hay nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040904,
					"content": "¿Buscan comida y techo? Entonces, les recomiendo ir a la Posada Wangshu. El precio es justo, el trato es de primera clase y el paisaje es excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040905,
					"content": "Queremos ver esa carta anónima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "¿Cómo saben sobre la carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040907,
					"content": "¡Un Adeptus de Liyue nos lo dijo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "¿Lo saben los Adeptus? Lo dudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040909,
					"content": "#No deberían dudar de ell{F#as}{M#os}. Fui yo quien les mandó a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Si tienen más preguntas, háganmelas a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "¿E-es usted el Guardián Yaksha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040912,
					"content": "¡Oye, cuidado con lo que dices! ¿Quieres meterte con un Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "No es que no creamos que usted es Adeptus, es solo que... hay que considerar el contexto general de la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040914,
					"content": "Como sabrá, los Ladrones de Tesoros no somos una gran amenaza. Solo somos unos criminales insignificantes, es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040915,
					"content": "Si de verdad es usted un Adeptus, ¡le rogamos misericordia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040916,
					"content": "Pero si no es un Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040917,
					"content": "¡tendrá que disculpar a nuestras armas por tratar a todos por igual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Astuto"
				}
			]
		}
	]
