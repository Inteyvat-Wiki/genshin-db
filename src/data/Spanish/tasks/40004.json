			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bei'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "¡Oh, gran héroe! ¡Venerable Adepti! ¡Tenga misericordia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040802,
					"content": "La carta anónima solo dice tonterías, ¡no es necesario recurrir a la violencia! ¡Toda suya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040803,
					"content": "¿Qué les parece? ¡Paimon lo sospechaba desde un principio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME}, ven a ver la carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040805,
					"content": "#Ya veo... Entonces, dejemos que {F#ellas}{M#ellos} dos vayan a la reunión en lugar de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040806,
					"content": "Quien haya escrito esta carta tiene unos planes diabólicos para el Rito de la Linterna. Al parecer, quiere ver la ciudad arder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040807,
					"content": "Genial, todos felices. Ustedes están bien, y nosotros estamos bien. Sin embargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040808,
					"content": "... el problema es que ustedes y nosotros no nos parecemos en nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040809,
					"content": "No te preocupes, nadie nos reconocerá cuando nos disfracemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040810,
					"content": "A mí me parece poco probable, pero si tenemos el respaldo de un Adeptus, no hay de qué preocuparse, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040811,
					"content": "Entonces, la paz y la tranquilidad de Liyue dependen de ustedes. Buena suerte. Los Ladrones de Tesoros tampoco queremos que la ciudad arda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040812,
					"content": "En ese caso, está decidido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040813,
					"content": "Un momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040815,
					"content": "Cuando nos veamos de nuevo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040817,
					"content": "... que sea en un lugar desde el que se pueda ver la linterna mingxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "... No me gustan los lugares concurridos, especialmente durante estas fechas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040819,
					"content": "¿Realmente tengo que ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040820,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "... Entendido. Estaré a la espera de tus noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
