			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Vamos a echarle un vistazo a tu mano derecha... Parece estar bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010102,
					"content": "Pero recuerda que aún debes tener cuidado, ¿entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010103,
					"content": "Sí, lo tendré, maestro. Por cierto, todavía no he recibido mi ruta de patrulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Hoy nos espera un gran recorrido, así que no puedes acompañarme esta vez. Además, podríamos tener algún que otro encuentro con... Bueno, tú sabes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010105,
					"content": "¡Yo también tengo una Visión! ¿Por qué nunca puedo ayudar a nadie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "No digas eso. No deberías preocuparte por esas cosas ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010107,
					"content": "Ahí están. ¿Se sienten mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010108,
					"content": "¿Podemos ayudar en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Sí, ya que vamos a quedarnos un tiempo aquí, no estaría de más echarles una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "#Ustedes no parecen de {F#las}{M#los} que se pasan el día holgazaneando, ¿eh? Quizás Collei podría llevarl{F#as}{M#os} a patrullar el sur de la Villa Gandharva por hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010111,
					"content": "Y si aún tienen ganas, podrían limpiar la Estatua de Los Siete que hay por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010112,
					"content": "Tignari, ¡ya estamos listos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "#De acuerdo, denme un segundo. Bien, nosotros nos adentraremos en el bosque. L{F#as}{M#os} dejo en manos de Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 30010114,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei, ¿qué haremos el día de hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Tignari dijo que limpiemos la Estatua de Los Siete, pero Paimon no sabía que eso formara parte del trabajo de un guardabosques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Las responsabilidades de los guardabosques son de lo más diversas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Hacemos un poco de todo, desde comprobar el estado de los caminos, mantener las instalaciones del bosque, asegurarnos de que se cumplan las medidas antiincendios y ayudar a los viajeros y la población local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "El maestro también se encarga de algunas tareas en las zonas más peligrosas del bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Antes de ir a la Estatua de Los Siete, podemos hacer una inspección rutinaria de las lámparas en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "La estatua está justo encima de esa enorme roca de ahí. Seguro que la vieron cuando venían de paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "Está bastante alto, ¿verdad? No se preocupen, no creo que al maestro le importe si no limpian la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "#No te preocupes, soy {F#una experta trepadora}{M#un experto trepador}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "¿De verdad? Bueno, pues entonces se lo dejo a ustedes. No hay mucho espacio ahí arriba, así que tengan cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, Paimon flotará hasta arriba contigo y te ayudará a limpiar la parte más alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Por cierto, Collei, ¿qué sabes de la Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Depende, ¿te refieres a la Reina Mayor Rukkhadevata o a la Reina Menor Kusanali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "¿Eh? ¿La Reina Mayor Rukkhadevata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "¿Ese es el nombre de la antigua Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Así es. La Reina Mayor Rukkhadevata era la Arconte original de Sumeru. Fue ella quien creó los bosques y el Muro de Samiel en los confines del desierto. Es por ella que tenemos una vida apacible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Para la gente de Sumeru, ella es la encarnación de la sabiduría, el poder y la bondad. Por desgracia, desapareció durante la gran catástrofe que tuvo lugar hace ya cientos de años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Igual que Raiden Makoto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "El maestro me contó que más tarde los sabios encontraron a la recién nacida Arconte Dendro y la trajeron de vuelta a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Para conmemorar el regreso de la Arconte, los sabios la nombraron “Reina Menor Kusanali” y dejaron que residiera en el Santuario Surasthana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Oh... ¿Y qué pasó después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Pues... Francamente, yo tampoco lo tengo muy claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "¿Eh? ¿No lo sabes? ¿Pero tú no eres de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Sí lo soy, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "#¿Te cuesta hablar de ello porque somos foraster{F#as}{M#os}? Si es así, no te preocupes. Nosotr{F#as}{M#os} lo entenderemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "#No, no es eso. No intento ocultar nada. Además, yo no l{F#as}{M#os} considero desconocid{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Ustedes... conocen a Amber, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "¿Amber? ¿Te refieres a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "¿La Caballera Exploradora de los Caballeros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "¡Precisamente! Viví un tiempo en Mondstadt. Amber me ayudó mucho en aquel entonces. Me atrevo a decir que me ayudó a ser una persona nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "¡Amber es increíble! Vive la vida al máximo y tiene un fuerte sentido de la justicia. Siempre está lista para la acción y es muy bondadosa. Es como una chispa que enciende la llama en el corazón de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Es el más puro ejemplo de lo que debería ser una Caballera Exploradora. Es la primera persona que conocen los que visitan Mondstadt. Su entusiasmo y su carisma son tan contagiosos que no puedes evitar enamorarte de Mondstadt y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Humm... El trabajo de la Caballera Exploradora es muy distinto en la cabeza de Paimon, pero se ve que admiras a Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "*Ejem*, l-lo siento, me dejé llevar. Deben pensar que soy rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Jeje, no te preocupes. Paimon se siente mucho más cercana a ti ahora que sabe que eres amiga de Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "¿Cómo sabes que la conocimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Verán, después de volver a Sumeru, Amber y yo hemos seguido en contacto escribiéndonos cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "#En una de sus cartas me contó que un enorme dragón había atacado Mondstadt, pero que {F#una misteriosa viajera rubia}{M#un misterioso viajero rubio} y su compañera flotante salvaron la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "#L{F#as}{M#os} reconocí en cuanto l{F#as}{M#os} vi. Pero, teniendo en cuenta todo por lo que habían pasado, no me pareció el momento adecuado para sacarlo a colación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "¡Así que por eso lo sabías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "¡Así es! Así que créanme cuando les digo que confío plenamente en ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Me gustaría contarles más sobre la Arconte Dendro, pero he pasado mucho tiempo fuera de Sumeru, y no tengo muchos estudios sobre el tema. Lo siento mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "¡No te preocupes! Ya nos has sido de mucha ayuda. Ni siquiera habíamos oído hablar de la Reina Mayor Rukkhadevata o del Santuario Surasthana hasta que tú los mencionaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "#Me alegra poder ayudar, aunque sea solo un poco. Me gustaría preguntarles, ¿por qué están tan interesad{F#a}{M#o}s en la Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Le explicas el propósito de tu viaje a Collei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Ya veo. Gracias por confiarme su historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "#¡No es nada! Somos amig{F#as}{M#os}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "#Paimon tiene razón, somos amig{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Bueno, de vuelta al trabajo. Aún tenemos que limpiar la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "¡Muchas gracias por la ayuda! Mientras ustedes limpian, yo iré a echar un vistazo por el bosque. Nos vemos aquí en un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "De repente eres una persona totalmente distinta, Collei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "¿La campeona de vuelo de Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(¿Coincidió con Khaenri'ah?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Será pan comido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
