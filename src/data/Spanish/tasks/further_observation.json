					"id": 30010601,
					"content": "Ahora que Paimon se fija, la Arconte que hay tallada en la estatua parece muy pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010602,
					"content": "Humm... ¿Crees que es la Reina Mayor Rukkhadevata o la Reina Menor Kusanali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010603,
						30010605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010603,
					"content": "¿La Reina Mayor Rukkhadevata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010604
					]
				},
				{
					"id": 30010604,
					"content": "Sí, tienes razón. La estatua parece tener unos cuantos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010607,
					"content": "Bueno, ya lo averiguaremos. Por el momento, concentrémonos en limpiar la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010608,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010609
					],
					"speakerTitle": "Aranara A"
				},
				{
					"id": 30010609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "¿Eh? ¿Es imaginación de Paimon o algo se movió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010611,
					"content": "¿Tú también lo viste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "¡Claro que sí! Era pequeño y redondo, como un vegetal o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010615,
					"content": "¡Qué susto le ha dado a Paimon! Sea lo que sea esa cosa, deberíamos seguirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010616,
					"content": "Aunque, pensándolo bien, primero deberíamos terminar de limpiar. Vamos, Paimon se encarga de la parte de arriba y tú de la de abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010617,
					"content": "Con la ayuda de Paimon, dejas la estatua impecable.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "¿Un repollo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "¡Sí, eso es! Pequeño y redondo como un repollo. ¡Pero se movía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010605,
					"content": "¿La Reina Menor Kusanali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "Parece que el nombre le va bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
