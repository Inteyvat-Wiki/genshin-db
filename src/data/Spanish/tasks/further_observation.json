			"dialogs": [
				{
					"id": 30011101,
					"content": "#Ah, viajer{F#a}{M#o}, han vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011102,
					"content": "Hola, ¿has visto a Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011103,
					"content": "Sí, la vi meterse en su habitación hace un instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011104,
					"content": "Está bien, ya hablaremos mañana con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
