					"nextDialogs": [
						30010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010802,
					"content": "#¡Buen trabajo, chic{F#a}{M#o}s! Deben estar cansad{F#as}{M#os} después de trepar tanto. Vamos a descansar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010803
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010803,
					"content": "Oye, Collei, ¿has visto una cosa pequeña y redonda con aspecto de verdura dando vueltas por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010804,
					"content": "¿Con forma de verdura? Humm... Si el maestro estuviera aquí diría algo como: “Las verduras también son plantas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010805
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010805,
					"content": "Le cuentas a Collei lo que han visto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010806
					]
				},
				{
					"id": 30010806,
					"content": "¡Guau! Suena como esas criaturas imaginarias de las que los niños no dejan de hablar. ¡Estaré atento a ver si yo también la veo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010807
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010807,
					"content": "Por cierto, ¿tienen hambre? Traje algo de comida y agua para el viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
