			},
			"dialogs": [
				{
					"id": 30011001,
					"content": "¡Qué bien! ¿Qué vamos a comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011002,
					"content": "Paimon, contrólate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011003
					]
				},
				{
					"id": 30011003,
					"content": "¡Eh, no seas aguafiestas! Collei es nuestra amiga. Además, ¡el mejor cumplido para un cocinero es demostrar tu pasión por su comida! Xiangling le enseñó eso a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011004,
					"content": "He preparado comida fácil de llevar para guardabosques. Se llama döner kebab. Espero que les guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011005,
					"content": "¡Ah! ¡Ups!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011006,
					"content": "¡Oh, no! ¡Se te cayó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011007,
					"content": "¡Tranquila, Paimon! Lo envolví con varias hojas de papel engrasado, no creo que se haya ensuciado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011008,
					"content": "Uff, menos mal. Paimon casi sufre un ataque al corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011009,
					"content": "Comparten la comida con Collei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "¡Estos kebabs están deliciosos! Eres toda una chef, Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011011,
					"content": "Gracias a Los Siete que los envolviste, o de lo contrario Paimon no podría dormir por la noche pensando en el desperdicio de algo tan delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011012,
					"content": "Jaja, sí que sabes halagar a un chef, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011013,
					"content": "Si te gusta tanto, me aseguraré de darles la receta la próxima vez. Incluso les anotaré un par de consejos, así podrán prepararlos siempre que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011014,
					"content": "¡Collei, eres la mejor! Es difícil pensar que una persona tan diligente puede tener momentos de descuido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011015,
					"content": "Jeje, me pasa de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011016,
					"content": "Oye, Collei, ¿no crees que Tignari es demasiado estricto contigo? Nunca te deja tocar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011017,
					"content": "#Paimon tira cosas a veces cuando flota alrededor de {NICKNAME}, pero {F#ella}{M#él} nunca se queja. Le pasa a todo el mundo, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011018,
					"content": "Oh, no, no tengan una idea equivocada de mi maestro. Puede que parezca estricto, pero con un poco de tiempo más, verán que en realidad tiene un gran corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011019,
					"content": "Los guardabosques más veteranos dicen que el maestro proviene de una antigua y misteriosa raza. Por lo visto eran conocidos por su sorprendente ingenio y su carácter huraño. Pero el maestro es muy bueno, de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011020,
					"content": "A todo esto, han oído hablar de la Academia de Sumeru, ¿verdad? Por lo visto hay una escuela que se llama Am... Amu... algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011021,
					"content": "El caso es que algunos sabios de la Academia se han puesto en contacto con él por sus estudios de botánica. Incluso le han ofrecido un puesto oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011022,
					"content": "Pero el maestro ha rechazado todas las ofertas. Siempre dice: “El ambiente en la ciudad es demasiado ruidoso, es malo para mis oídos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011023,
					"content": "Suena a algo que diría Tignari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "Jaja, pues sí. El caso es que los sabios no están muy contentos con su rechazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011025,
					"content": "El maestro podría tener un gran porvenir en la Academia de Sumeru, pero insiste en ser guarda forestal. Se dedica a ayudar a los lugareños y a compartir sus conocimientos con los novatos como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011029,
					"content": "De hecho, fue él quien me enseñó a hacer döner kebab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011030,
					"content": "¿En serio? Paimon nunca lo habría pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011031,
					"content": "Por cierto, fue Tignari quien cuidó de ti cuando te desmayaste ayer. Incluso cargó contigo todo el camino hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011032,
					"content": "¡Pero Paimon está molesta! No dejó de regañar a Paimon durante todo el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011033,
					"content": "¿Qué hiciste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "Lo siento, creo que el maestro exageró un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011035,
					"content": "Pero es que Paimon no dejaba de gritar: “¿Qué hago, qué hago? ¿Se va a morir?”. Supongo que el maestro acabó por perder los estribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011036,
					"content": "¡Oye, tú! ¿De qué te ríes? Paimon estaba realmente preocupada por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011037,
					"content": "Jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011038,
					"content": "¡¿Tú también, Collei?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011039,
					"content": "¡Aaah! ¡Se acabó, Paimon no lo dejará pasar! ¡Prepárense para sufrir la furia de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011040,
					"content": "¡No! ¡No me toques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011041,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "Ay, perdona, Collei. Paimon no quería asustarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011044,
					"content": "¿Eh? No, no es eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011045,
					"content": "Collei, ¿estás bien? ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011046,
					"content": "#Ah, sí, no... No pasa nada. Siento haberl{F#a}{M#o}s asustado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011047,
					"content": "Bueno, se está haciendo tarde. Volvamos a la Villa Gandharva. El maestro ya debe haber vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011048,
					"content": "Oye, ¿qué le ocurrió a Collei? ¿Y a qué viene tanta prisa de repente? Se fue corriendo tan rápido que Paimon ya no alcanza a verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011042,
					"content": "¿Ocurre algo, Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "Hablando de sus orejas, ¡me gustaría acariciarlas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "Jejeje, lo sé. A mí también me gustaría tocarlas... *Ejem*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011028,
					"content": "El caso es que el maestro podría tener un gran porvenir en la Academia de Sumeru, pero insiste en ser guarda forestal. Se dedica a ayudar a los lugareños y a compartir sus conocimientos con los novatos como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				}
			]
		},
