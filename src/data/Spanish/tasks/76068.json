			"dialogs": [
				{
					"id": 760680101,
					"content": "Ah, Aria. Veo que tú también elegiste tu propia forma “humana”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Jeje, y tú te ves tal y como te imaginaba, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Lo que no esperaba era que tú también crearas una forma así para esas pequeñas vidas tan adorables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "Es lo natural, Aria. Esas vidas frágiles confían en mí y me llaman. Por eso respondo a sus voces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Nacimos para sostener el funcionamiento del mundo. Si esas vidas llamadas “humanos” quieren asentarse en él, escuchar sus súplicas también forma parte de la misión que el rey nos confió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Sí. Después de todo, el rey dijo que toda vida del mar de estrellas es nuestra aliada contra la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Pero no me refería a eso. Lo que quería decir es que no esperaba que la Luna Escarchada también mostrara un lado tan sentimental. Es adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "... Puedo notar que tu forma de hablar ya empezó a verse influenciada por esos pequeños humanos, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Sus palabras siempre son tan ambiguas. No las uses. No entiendo en absoluto qué quieres decir con “adorable”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "¡Oh, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Aria, Canon, ahora que ya tenemos nuestra forma humana, lo primero que deberíamos hacer es escaparnos para jugar con la gente de la tierra, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Si no, ¿para qué nos tomamos la molestia? ¡Vamos, vamos! Antes de que alguien se dé cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Jeje, parece que nuestra querida hermanita ya no puede esperar más, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Cuando ellos apenas empezaban a levantar civilizaciones en la tierra, tú decías que “ese forastero no trae nada bueno, y sus creaciones tampoco”, y ni siquiera querías mirarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "¡E-eso es distinto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Sigo pensando que no deberían haber dejado entrar a ese forastero, pero la gente que vive en la tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "*Suspira*, mientras te diviertas, está bien. Ve, y no te separes de Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "¿Eh? ¿No vienes con nosotras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "La servidora de ese Descendido dijo que quería hablar conmigo. Algo sobre el potencial gravitatorio de este mundo y el tensor{RUBY#[D]reglas del tiempo} métrico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "¿Astaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Creo que ese era su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Hay que recordar bien los nombres de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "Y aunque quizá sea solo una impresión mía, siento que para ella, el Descendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "No sacaré conclusiones precipitadas, Aria. Pero estaré atenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Me alegra oírlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "¿?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Jeje, nada. Entonces nosotras nos vamos yendo, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "No te preocupes. Sonnet y yo te traeremos un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "... No necesito regalos. Basta con que tengan cuidado y no dejen que las reconozcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}