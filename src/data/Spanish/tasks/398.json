			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "¡Vengan, vengan! ¡Será divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "¡Desastres, peligro, la emoción por la aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "¡Por fin, el Gremio de Aventureros no va a recibir más encargos triviales de rescatar gatitos y cachorros! ¡Se avecina una nueva era de aventuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "¡Jóvenes! ¡Únanse al Gremio de Aventureros el día de hoy! ¡En estos momentos tumultuosos, debemos unirnos, enfrentar al dragón y salvar nuestra gran ciudad de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Pues...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "¿Qué? ¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "¿Pusieron fin a la amenaza de Stormterror? ¿Me perdí del discurso de la Gran Maestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "¿No pudo Stormterror aguantar un poco más? ¡Estábamos en camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39807",
							"2"
						],
						"stepId": 39807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "¿Qué van a pedir hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "#*Suspira*, ¡qué frí{F#a}{M#o} eres! Pensé que éramos amigos íntimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Lo siento, ¿te conozco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "#¡Jaja! Parece que después de la gran batalla no solo puliste tus habilidades de combate, sino también tu astucia. {F#Una caballera}{M#Un caballero} de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "#{F#La gran heroína}{M#El gran héroe} de Mondstadt está justo frente a mí. Como Caballero, me siento honrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "El viejo Capitán Kaeya con sus halagos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "¡Jaja, para nada! Mis palabras son sinceras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Solo buscaba un lugar tranquilo para pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Mientras los demás caballeros se esfuerzan en despejar el campo de batalla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Pensar también es un trabajo duro. Créeme que preferiría estar allá afuera recogiendo escombros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "¿Y en qué estás pensando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "En la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "Un dragón causa estragos en Mondstadt y la Gran Maestra Intendente abandona la ciudad para combatir la amenaza. Estratégicamente, es el momento perfecto para que la Orden del Abismo actúe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "Si fueras de la Orden del Abismo, ¿aprovecharías esta oportunidad de oro solo para mandar un puñado de Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Tienes razón, es raro que solo hayan atacado Hilichurls...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "Para descubrir la verdad, decidí esperar para observar su siguiente movimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Luego llegó el día en que hiciste que todo el infierno se desatara en la guarida de Stormterror, justo cuando los aullidos de los Hilichurls sonaban ante las puertas de la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "Ese mismo día, descubrí unas figuras siniestras merodeando dentro de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "¡¿Dentro de la ciudad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Todos los demás caballeros estaban afuera, luchando contra el enemigo. Como podrán imaginar, eso dejó el interior de la ciudad completamente desprotegido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Excepto por mí, por supuesto. Yo me infiltré en las filas de los invasores... digamos que para fraternizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Después de unas pequeñas maniobras, pude obtener algo de información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "Esto fue lo que conseguí: detrás de la Orden del Abismo hay alguien que los lidera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "¿La Orden del Abismo tiene... líder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Sí, y el plan de usar a Dvalin como un arma también fue idea suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "¿Qué clase de “pequeñas maniobras” hiciste para obtener este tipo de información?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Jeje... Digamos que tengo un talento natural con las palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#Pero eso no es todo. La Orden del Abismo se refiere a su dirigente como {F#“El Príncipe”}{M#“La Princesa”}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#{F#“El Príncipe”}{M#“La Princesa”}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Bueno, siento tener que terminar con esta sesión informativa, pero al parecer Amber viene en esta dirección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Creo que todavía está enojada conmigo por mi ausencia en la defensa durante el ataque... Será mejor que escape antes de que ella me vea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "En un instante veo a Kaeya, y al siguiente huye... Es una clara señal de que no tiene la conciencia tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "De hecho, él también contribuyó detrás de escena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "#¿Estás segur{F#a}{M#o}? Porque eso es exactamente lo que él diría para salirse con la suya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Pero olvidémonos de él. Trabajé muy duro hoy y mi estómago está rugiendo. ¡Pidamos algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "¡Hola, Sara! ¡Quisiera un plato de asado a la miel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "Ciertamente, ¡es un patán!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Estoy de acuerdo. Para ser Capitán de Caballería, da muy mal ejemplo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "Entonces, en realidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "¡Dinos qué estás tramando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "¿Yo? Nada, al contrario, sospecho que alguien más está tramando algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Solo buscaba un lugar tranquilo para pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "¡Kaeya, mi viejo amigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Vaya, así que sientes algo por mí. Y la gente dice que no tengo carisma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
