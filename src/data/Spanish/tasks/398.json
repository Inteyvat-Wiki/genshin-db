			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "#¡Vaya, son ustedes dos! ¡{F#La Caballera Honoraria}{M#El Caballero Honorario} vuelve triunfante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Jeje, {NICKNAME} le ha enseñado a ese Dvalin su merecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "¿Regresaron ayer? Jean volvió a Mondstadt antes que ustedes y le contó a todo el mundo sus hazañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*Suspira*... ¿Cuándo llegará mi momento de brillar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Todo fue gracias a que me recomendaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "De ninguna forma, ustedes merecen todo el crédito por haber resuelto la crisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "#Yo solo l{F#as}{M#os} traje a Mondstadt como parte de mi deber como Caballera Exploradora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "No fue nada. Por cierto, ¿nos estabas esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "¡Claro que no! Que no luchara con ustedes no quiere decir que no tenga trabajo que hacer... De hecho, estoy lidiando con las repercusiones de la crisis en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "¿Repercusiones? ¿Qué ocurrió en Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Pues... con Jean afuera, los monstruos de los alrededores hicieron un ataque coordinado sobre la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Por suerte, no nos tomaron por sorpresa. Descubrí que los Hilichurls se acercaban a la ciudad desde hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Oh, Paimon lo recuerda. Fue la primera vez que nos vimos, estabas despejando un campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Así es. Si no nos hubiéramos preparado con antelación, Mondstadt estaría en grave peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Siempre y cuando los hayan repelido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Solo que tengo la sospecha de que esto no ha acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Los Hilichurls no tienen la capacidad de organizarse para un ataque coordinado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Así que creemos que la Orden del Abismo está detrás de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "¿Crees que ellos manipularon a los Hilichurls? Humm... Por suerte rescatamos a Dvalin, o si no a él también lo habrían manipulado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Así es. De ahora en adelante, como Caballera Exploradora, tendré que echarle el ojo a esos sujetos del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Oh, lo siento. Deberían estar celebrando su victoria y aquí me tienen hablando de cosas tan preocupantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "#Hummm... Prometí llevarl{F#as}{M#os} a comer asado a la miel, ¿cierto? Fue antes de ocuparnos de la crisis de Stormterror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "¡No hay mejor momento que ahora! ¿Tienen hambre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "¡Yuju! Aunque lo hubieras olvidado, ¡Paimon no ha dejado de pensar en eso todo este tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "¡Genial, vamos! Ha pasado mucho tiempo desde la última vez que comí asado a la miel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Espérenme en <color=#00E1FFFF>El Buen Cazador</color>. Estaré ahí en cuanto termine de despejar este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "¿Cómo es que los Hilichurls...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Lo sé, es muy extraño. Los Hilichurls no tienen la capacidad para coordinarse de esta forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Espero que no haya muchos “momentos” así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Tienes razón. A fin de cuentas, hay que apreciar los momentos de paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "En esta ocasión, es contigo con quien todos debemos estar agradecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
