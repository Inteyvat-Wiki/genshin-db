			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Así que la verdadera identidad de Stormterror era Dvalin, ¡uno de los Cuatro Vientos! Nunca debimos olvidar su sacrificio por Mondstadt en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Pero cada crisis tiene un rayo de esperanza. Por suerte, nuestra relación con él no llegó a un punto de no retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Todo gracias a ti y a la inquebrantable devoción de Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Siempre que contemos con los Caballeros de Favonius, la paz y la libertad prevalecerán en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
