					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "¡Larga vida a los héroes! Gracias, por fin acabó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Debido al incidente de Stormterror, muchas rutas comerciales fueron canceladas. Podemos arreglárnoslas sin fruta y vegetales frescos, pero sin suministro de vino, ¡estaríamos condenados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "No puedo imaginarme un mundo sin vino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "Espero que las rutas comerciales vuelvan pronto a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
