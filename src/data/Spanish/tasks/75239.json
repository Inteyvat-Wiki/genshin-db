					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "¿Qué muñecos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "Son unos juguetes con forma de Koholasaurio. Yo soy el que los pinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Pero mi aprendiz, Zhaka, no ha venido a trabajar últimamente. Tiene tres muñecos a medio colorear, y no sé dónde los puso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "¿Podrías ayudarme a buscarlos? Deberían estar por aquí cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanei"
