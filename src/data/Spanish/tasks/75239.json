			"dialogs": [
				{
					"id": 752390101,
					"content": "Ese Zhaka, ausentándose del trabajo antes de terminarlo... ¿Dónde habrá puesto esos muñecos? ¡Tendré que denunciarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
