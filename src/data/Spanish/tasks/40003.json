			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "#Ustedes son... oh, cierto, son {F#las}{M#los} que vinieron ayer a reportar una situación peligrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "Por desgracia, durante el Rito de la Linterna, el Ministerio de Asuntos Civiles está hasta el cuello de tareas. De momento no tenemos personal disponible para la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "¿Eh? ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "Lo siento, es muy raro que alguien esté tan entusiasmado por dar un informe... Déjame pensar... tal vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Quizás tengamos un equipo que pueda ayudar. Solo les queda una tarea para el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Están regresando de una operación de limpieza en la Llanura Guili. Si pudieran encontrar la manera de contactar con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
