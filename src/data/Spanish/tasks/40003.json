			"dialogs": [
				{
					"id": 400030701,
					"content": "¡Ajá! ¡Paimon lo sabía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030702,
					"content": "¿Lo seguimos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				},
				{
					"id": 400030704,
					"content": "Espera un segundo, parece que hay alguien más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030703,
					"content": "Vamos tras él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				}
			]
		},
		{
