			"dialogs": [
				{
					"id": 400030901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030902,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}, ¿qué hacemos? Esta persona no parece muy habladora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "¡Ay! No parece ser una buena persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "No puedes juzgar y decir que las personas son buenas o malas así porque sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Sin embargo, supones correctamente. Soy un espíritu malévolo. Un guardián Yaksha, asesino de monstruos y vencedor de demonios. Puedes llamarme Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Creo haber oído ese término hace unos días.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "¿Paimon, sabes qué es un “Yaksha”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "¿Guardián Yaksha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Sí... Alguien de Liyue dijo que los guardianes Yaksha también son una especie de Adeptus, seres sobrenaturales que protegen a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Vigilan el mundo humano en secreto, protegiéndolo de monstruos y demonios. Pero la mayoría de las personas ni siquiera saben de su existencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "En un sentido general, ¡es una buena persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "No... La protección de Yaksha va más allá del entendimiento humano del “bien”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Pero el Rito de la Linterna es para conmemorar a un héroe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "Entre los protectores que asistieron al héroe de Liyue, hay uno que vive hasta hoy día, pero no se le conmemora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "¿Señor Xiao...? ¿Adeptus Xiao...? ¿Por qué no detuvo a esa persona sospechosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Percibí una sensación maligna por aquí, así que vine a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Cuando un eslabón se rompe en el reino de las deidades o los demonios, asumo toda la responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "#Pero esta vez, la amenaza proviene del mundo humano, tu mundo, así que esta es tu responsabilidad, viajer{F#a}{M#o} mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "Cuando llegue el momento, espero que actúes con decisión y firmeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "No me gustaría que la borla del asta que ha matado a innumerables demonios se manche con sangre mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "¿Paimon, lo reconoces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
