			"dialogs": [
				{
					"id": 701140101,
					"content": "No es muy habitual que encuentres tiempo para visitar Mondstadt, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Me brindaste una ayuda invaluable cuando estaba investigando la matriz aritmética. Quería darte las gracias en persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140103,
					"content": "Muy amable de tu parte. Pero esas cosas están muy lejos de mi ámbito de especialización. El mérito de haberlo terminado te pertenece por completo a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Fue un trabajo en equipo. Humm... Ahora que lo pienso, ¿dónde está Durin? Teniendo en cuenta que eres prácticamente su tutor, pensaba que no se alejaría mucho de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140105,
					"content": "No estás del todo equivocada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Como últimamente ha mejorado mucho en sus habilidades sociales, así que he estado animándolo a que sea un poco más independiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "¿No estás preocupado por él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140108,
					"content": "Un poco. Antes, si estaba solo e interactuaba con alguien cuya personalidad era... digamos fuerte, solía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "¿Aprender cosas raras? ¿Imitar muletillas extrañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140110,
					"content": "Exactamente. ¿Entiendo que tú también has vivido algo parecido, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hum, ¿no es evidente? Soy prácticamente una experta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140112,
					"content": "Normalmente, después de reunirme con el Gran Maestro Varka, me llevo a Durin a visitar a Sacarosa para ayudarla con su investigación. Eso le permite concentrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Pero si pasa demasiado tiempo con la Maestra Jean, lo llevo a ver a Klee para que aprenda a relajarse de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Suena a que es mucho trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140115,
					"content": "Solo cuido a mi familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "¿Y cómo lidias tú con este tipo de cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "¿Yo? No tengo energía para ese tipo de complicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140118,
					"content": "Pero me parece que, si alguien es bueno por naturaleza, por muchas influencias que reciba, siempre volverá a ser quien realmente es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140119,
					"content": "Humm... Una observación excelente. Quizá pueda adoptar esta forma de pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
