			"dialogs": [
				{
					"id": 701140201,
					"content": "Muchas gracias por tu hospitalidad, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140202,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "Muy bien. Hasta la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140203,
					"content": "Creo que ya es hora de que me vaya retirando.",
