			"dialogs": [
				{
					"id": 761860201,
					"content": "Una infusión realmente deliciosa, Srta. Sandrone. Es como si pudiera saborear su sinceridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860204,
					"content": "De acuerdo. La próxima vez, yo la invitaré a tomar té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
