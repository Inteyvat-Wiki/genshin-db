			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860103,
					"content": "¿Qué tal les ha ido últimamente a los Descendientes Lunaescarcha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860104,
					"content": "Bastante bien. El regreso de la Diosa Lunar ha reforzado nuestra determinación de seguir el camino que se nos asignó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "¿En serio? Qué bueno saberlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Ja... Supongo que realmente no tenemos nada de que hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860109,
					"content": "Me temo que... eso se debe a que hay demasiada historia entre los Descendientes Lunaescarcha y los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Hablando solo por mí, le agradezco sus esfuerzos por proteger Nod Krai y dar la bienvenida de vuelta a la Diosa Lunar, Srta. Sandrone. Pero en cuanto a sus socios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Lo entiendo. Por diversas razones, no logramos establecer relaciones amistosas, ni siquiera relaciones mutuamente beneficiosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860112,
					"content": "Pero los Fatui ya no pretenden quitarles nada a los Descendientes Lunaescarcha, y les he recordado a mis subordinados que no les compliquen las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860113,
					"content": "Desde mi punto de vista, y dado que somos vecinos, aunque no podamos convivir en perfecta armonía, estaría bien que al menos nos tratáramos con respeto mutuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860114,
					"content": "Me temo que eso llevará tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Sin duda. Pero podemos ir poco a poco. ¿Te apetece probar esta infusión que preparé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860116,
					"content": "¿Eh? ¿Una infusión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Humm... Qué sabor tan intenso. ¿Lo preparó al estilo de los Descendientes Lunaescarcha? A la mayoría de los forasteros que he conocido no les gusta nuestro té. ¿Cómo ha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Aprendizaje. Y respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860119,
					"content": "Ja... No está mal como primer paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Espero que sea de tu agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860121,
					"content": "Me gusta mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Las conversaciones amistosas alrededor de una taza de té caliente siempre han sido una forma estupenda de entablar relaciones cordiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Tengo la sensación de que esta vez no será una excepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
