			"trigger": {
				"objectNames": [
					"Lanyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Hola, ¿hay algo en lo que pueda ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Vengo a recoger la ropa de Ninguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ah, sí, lo recuerdo. Un momento, iré por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Tras una larga espera, Lanyang regresa al fin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Aquí esta. ¿Podrías dársela a la Srta. Ninguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Te tomaste tu tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Sí, esta sala está llena de los objetos personales de la Srta. Ninguang. No solo hay ropa, sino también toda clase de joyas y adornos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "La Srta. Ninguang nos encargó ordenar esta sala hace poco y todavía estamos en ello, así que todo está bastante desordenado. Por eso me tomó algo de tiempo encontrar la ropa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Parece que Ninguang tiene una colección personal enorme...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Bueno, ya puedes llevártela. Gracias por hacerte cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Problemas de gente rica...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
