					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Somos responsables de acordonar esta zona y no dejar que los mineros... No, no dejar que nadie baje aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "Esto debe parecerse a vivir debajo de un puente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
