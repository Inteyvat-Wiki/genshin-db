						710702002
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702002,
					"content": "Algo anda mal con Zhichiong. Sospecho que es esa... cosa negra contaminada lo que está afectando su mente y su cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702003
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702003,
					"content": "Sea lo que sea, es bastante similar a la descripción de la calamidad oscura que los habitantes de aquí vivieron hace quinientos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702004
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702004,
					"content": "Pero hoy, los Yaksha han desaparecido y Rex Lapis también se ha ido... Debo admitir que esta es la primera vez que me preocupa tanto la seguridad de nosotros, los mortales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702005
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702005,
					"content": "Perdón... Te retuve solo para decirte todas estas tonterías. Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702006
					],
					"speakerTitle": "Jinwu"
				},
