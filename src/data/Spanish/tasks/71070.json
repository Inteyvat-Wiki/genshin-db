					"id": 710702704,
					"content": "Sea lo que sea, gracias por recordarme las limitaciones de un ser humano normal y... Gracias por ayudarme a comprender cómo perseguir mis propósitos desde de esas limitaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710702705,
					"content": "Hum. ¡Mira quién habla cual filósofa de repente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "La verdad es que yo no le di tantas vueltas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "Es solo que, me ayudaron tanto... Y en realidad, solo debería haber necesitado su ayuda para dibujar unos mapas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710702708,
					"content": "Y siempre soy una carga para ustedes en los momentos críticos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710702709,
					"content": "A mí solo me importa tu seguridad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Sí... No me rendiré. Volveré a salir en cuanto haya descansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710702710,
					"content": "No te preocupes. Espero que puedas terminar el mapa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
