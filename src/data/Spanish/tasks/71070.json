						710701902,
						710701907
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701902,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "Me considero un bardo de la vieja escuela, así que estoy aquí en busca de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701904,
					"content": "Vaya... Te veías tan bien hace un momento, ¡y ahora parece que en cualquier momento te vas a desmayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710701905,
					"content": "Nunca había estado en una mina... Y estaba tan apurado por llegar que terminé... lastimándome un músculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701906,
					"content": "¡Ay! ¡Cómo duele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701907,
					"content": "Ya no te molesto más...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Ay... Este aceite medicinal no me está ayudando... Bueno, nos vemos. ¡Avísame si tienes nuevas historias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
