					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "#¡Jajajajaja! ¡Vaya! ¡Cómo habla {F#la viajera}{M#el viajero}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Gracias por tu ayuda, ahora las cosas ya se calmaron en el campamento. Siento mucho si te pareció que estaba siendo demasiado estricta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "El asunto más importante ya se resolvió. Ahora, nuestra misión a largo plazo será... permanecer en tierra subterránea para supervisar cualquier anomalía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "Por un tiempo, muchas minas van a poder abrirse parcialmente, pero sigue estando prohibido llegar tan lejos bajo tierra.",
