	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "#Oh, estás aquí. Gracias por ayudarnos a despejar el camino. Zhichiong también nos ha ayudado mucho haciendo de guía. Muchas gracias a l{F#as}{M#os} dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Sobre el campamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "¿Qué te parece? No está mal, ¿no? Se me da bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Mi padre empezó a enseñarme a hacer todo esto cuando tenía unos diez años... Ya sabes, a montar campamentos, hacer lámparas minerales, manejar el equipo de minería y eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Y mientras yo aprendía, mi padre se hizo mayor... Al final, la vista empezó a fallarle y yo tuve que hacerme cargo del mantenimiento del equipo de seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Y luego... Bueno, yo ya no soy ninguna jovencita. El resto de la historia no es nada interesante. Encontré a un hombre y lo perdí. Tuve una hija y se fue a estudiar a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "A veces, los mineros se marchan demasiado pronto y yo me hago cargo de sus hijos... Por eso siempre llevo algunos caramelos encima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Por eso... Esa es la imagen que se me viene a la cabeza cuando pienso en un niño. Sentado en el suelo, mirándome con esos ojitos, esperando que le dé algún caramelo o alguna priedra de color para jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "¡Guau! Así que... ¿Ahora también llevas caramelos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "¿Caramelos? Pues sí... No están tan ricos como los de la ciudad, pero son caramelos al fin y al cabo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Así que te referías a este tipo de caramelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "La gente viene y va, así que solo me queda aferrarme a mis recuerdos. Jaja, bueno, eso y aventureros como tú, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Sobre Zhichiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhichiong es miembro del nuevo grupo de mineros. Nació en Pueblo Mingyun. Lo cierto es que todos los mineros con experiencia de la mina vienen de Pueblo Mingyun... Es solo que nació en el momento equivocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Ah, no me malinterpretes, no digo que las cosas sean difíciles ahora. Lo que quiero decir es que los minerales de las minas de Pueblo Mingyun se acabaron hace tiempo, así que la minería también se detuvo en la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Poco después de que Zhichiong viniera a la Sima, tuvo lugar aquel incidente y se detuvo toda actividad aquí también. Supongo que el destino no quiere que se dedique a la minería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Pues...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Cada uno se fue a hacer sus cosas después de aquello. Yo me quedé porque alguien necesita cuidar del instrumental, pero ella se hizo aventurera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "No ha madurado ni un poquito y sigue teniendo muy poco aprecio por su propia vida. Tal vez le vendría bien pasar más tiempo en las minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "A lo mejor si se acostumbra a la precaria vida en las minas y tiene que salvar a algún que otro compañero de una muerte segura, aprenda por fin a valorar lo que tiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "No sé si tengo derecho a pedírtelo, pero... ¿podrías cuidar de ella? No quiero que le pase nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Muy bien, ¡ten cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitofo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "¡Hola! ¿Cómo va tu aventura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710701702,
					"content": "Bien, ¿qué tal estás tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Gracias por darme esta oportunidad. Desde que conseguiste crear un detonador de bolas de cañón, todos parecen dispuestos a dejar que me quede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710701704,
					"content": "Aunque, jaja... ¡Todavía no tengo claro qué voy a hacer cuando vuelva a la superficie! ¡Aunque supongo que no volveré a los Ladrones de Tesoros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710701705,
					"content": "¿“Supones”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "¡D-definitivamente no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710701708,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "¡Que te vaya bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710701706,
					"content": "¿De verdad...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "*Suspira* ¿Eh? Ah, hola. Lo siento, me has interrumpido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "¿Entonces estamos en paz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Bueno, ya vale con las tonterías. No estamos pasando por un buen momento, ¿sabes? Nada bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Supongo que ya has visto ese fragmento de cristal que brilla. Si no me equivoco, debería haber otro fragmento aún más grande más abajo... Aunque supongo que eso ya lo sabías, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "En teoría, nuestros niveles de energía deberían haberse estabilizado cuando el fragmento superior “volvió” a su ubicación original. Y eso fue lo que ocurrió... pero la forma de la onda estaba mal... completamente mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "¿De qué hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "No fuiste a la escuela, ¿verdad? Bueno... Lo diré de forma sencilla. Ahora somos como unos frijolitos sobre un molino de piedra, al borde de un enfrentamiento entre dos grandes fuerzas. ¿Entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "A largo plazo, estamos siendo aplastados por estas dos fuerzas, una por arriba y otra por abajo, y pronto nos convertirán en puré de frijoles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Si no me crees, espera y verás. Esa aventurera, Zhichiong... Bueno, pude ver lo que le pasa a quienes se acercan demasiado a esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Hoy puede estar tosiendo sangre y mañana podría toser sus pulmones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "¿Puedo hacer algo para ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "¿Tú? Pues... Déjame pensar... Dame un momento, debe haber una solución...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Bueno, lo más importante ahora es que sigas explorando hasta que descubras lo que ocurre ahí abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "No te preocupes, no me quedaré de brazos cruzados en esta situación... Soy responsable de la seguridad del equipo de espeleología, no quiero que mi dinero se desperdicie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "¿También serás responsable de mi seguridad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Hummm, bueno... Tengo que admitir que tus habilidades han superado completamente mis expectativas. Así que... creo que eres capaz de hacerte responsable de ti mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Ay, olvídalo, qué estoy diciendo... Si te pasa algo, yo te lo compensaré, ¿está bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Usa palabras fáciles, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
