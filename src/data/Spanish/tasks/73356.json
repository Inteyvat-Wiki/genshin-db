			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Don Sombrero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Cada uno tiene su propio camino que recorrer. No hace falta decir nada más. Por cierto, este té está bastante bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Don Sombrero"
				},
				{
					"id": 733560202,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560204,
					"content": "Está bien, adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Don Sombrero"
				},
				{
					"id": 733560203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}