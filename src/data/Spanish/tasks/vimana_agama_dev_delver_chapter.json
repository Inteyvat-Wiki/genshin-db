			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "¡Pero si es Ararycan! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Ararycan esperaba a ustedes desde que acabó de plantar flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Ararycan no sabe por qué, pero, de repente, algo cayó de gran montaña de hierro. ¡Casi aplasta a Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "¡Oh, no! Paimon lo siente, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Paimon no debe disculparse, Ararycan está perfecto. Ararycan corre a velocidad de viento, se libró de ser aplastado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Me alegro de que no te lastimaras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "El brazo que cayó del robot parece haber abierto la entrada a las ruinas subterráneas. Después de todo, sirvió de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Vayamos a echar un vistazo. Puede que nos aguarde algo malo allá abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "¡Ararycan quiere ir con ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
