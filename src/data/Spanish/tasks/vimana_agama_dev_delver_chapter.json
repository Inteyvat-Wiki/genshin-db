			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "Esa cosa resplandeciente debe ser la Caldera del caos de ese gigantón del que habló Jazari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Está cubierta de ramas y enredaderas, pero parece que hay algo que fluye de su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Oh, es cosa sucia... Ararycan puede sentir. Eso enfermó a bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Ah, parece que hay Magos del Abismo tramando algo al lado de las ramas de esos árboles enormes. Paimon tiene un mal presentimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Paimon recuerda haber escuchado a Jazari decir que el sello de la caldera se había roto. Quizás esos Magos del Abismo tienen algo que ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "#Ararycan, ve y busca un lugar donde esconderte. ¡Nosotr{F#as}{M#os} los detendremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
