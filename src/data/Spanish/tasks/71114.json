			"dialogs": [
				{
					"id": 711149940,
					"content": "Después de encargarte de los Ladrones de Tesoros, llevas al grupo a descansar cerca...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Gracias, no puedo expresar mi agradecimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140802,
					"content": "Eres... ¿la directora Chiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#¡Oh! ¡{NICKNAME}! ¿Qué haces aquí? Vaya... ¡Vuelvo a estar en deuda contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140804,
					"content": "¿No estaban estudiando kinografía en Fontaine? ¿Cómo es que volvieron tan pronto a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "¿Ya terminaron sus estudios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Más que terminar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Podríamos decir que nos hemos visto obligados a ganarnos primero la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Ustedes dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140809,
					"content": "El señor Geisert es todo un experto en kinografía y sus enseñanzas nos han sido de gran ayuda. Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "El tipo de kinografía que nos enseñaba se centraba particularmente en las ideas y su significado, un tipo de obra más bien conceptual. Sin embargo, aspectos como la trama y ese otro tipo de detalles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "En palabras del señor Geisert, fueron dejados “en un segundo plano”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Pero nuestro objetivo desde un principio era el de filmar una kinografía para promocionar el té de la Aldea Chiaoying. De seguir con el señor Geisert, me temo que no hubiese sido posible. Así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Así que tomé la decisión de pausar nuestros estudios por ahora, y regresar a la aldea para realizar una kinografía y poner en práctica todo lo que hemos aprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140814,
					"content": "Bueno, por eso... y también porque no nos quedaba mucho dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "¿N-no escucharon mi plan? Si terminamos esta kinografía y resulta ser un éxito, podremos recuperar todo lo invertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140816,
					"content": "#Y entonces unos Ladrones de Tesoros nos tendieron una emboscada mientras cruzábamos el puente... Por suerte {NICKNAME} vino a salvarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "¿Qué hacen por esta zona tan lejos de la Aldea Chiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "¿Por qué han venido aquí si la kinografía es de la Aldea Chiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "*Suspira*, queríamos tomar algunas imágenes de los hermosos paisajes del valle para mejorar nuestra obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140820,
					"content": "Pero estábamos tan concentrados en nuestro trabajo que no nos dimos cuenta de que había Ladrones de Tesoros cerca. Tratamos de huir, pero nos acorralaron aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140821,
					"content": "Un momento, entonces ese equipo de profesionales que mencionó antes Woliu eran en realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Exacto, eran ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "¡Woliu! ¿Cuándo llegaste? ¡No te había visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140824,
					"content": "Es que estaba escondida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Conque ya se conocen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Woliu es una hidróloga espectacular, toda una profesional en su campo, y conoce muy bien este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140827,
					"content": "A menudo recurrimos a ella para preguntarle cuáles son los mejores lugares para tomar imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140828,
					"content": "¡Incluso la invitamos a unirse a nuestro equipo de kinografía! Pero dijo que ahora está demasiado ocupada con sus investigaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140829,
					"content": "Directora, ahora que lo pienso... Creo que cuando escapamos, dejamos atrás las grabaciones y nuestro equipo de kinografía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Creo que... contenía algunas partes de la kinografía que ya estaban terminadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140832,
					"content": "#¡Woliu, {NICKNAME} y Paimon, muchas gracias por todo! ¡Vengan a visitarme a la Aldea Chiaoying cuando tengan tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140833,
					"content": "Después de todo, tengo que agradecerles de algún modo por habernos salvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140834,
					"content": "Pero ahora, ¡tenemos que irnos! ¡Rápido! ¿Dónde pusimos esa caja? Tenemos que ir a buscarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140835,
					"content": "La directora Chiu y su equipo se marchan con mucha prisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Parece que esa caja... Ha pasado por muchas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Como dice el refrán, el que algo quiere algo le cuesta. Estoy segura de que su kinografía será todo un éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "Bueno, primero les entregaré su recompensa y después iré a instalar el último instrumento. Después, me gustaría hablar con la directora Chiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Me preocupa que acaben rodando kinografías quién sabe dónde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Humm... Dijeron que irían la Aldea Chiaoying. Iré a buscarlos allá después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
