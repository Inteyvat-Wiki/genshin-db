			"dialogs": [
				{
					"id": 711140901,
					"content": "*Suspira*, creo que primero tomaremos algunas grabaciones de la Aldea Chiaoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140902,
					"content": "¿Todo bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#¡{NICKNAME}, Paimon! Sí, lo tenemos todo. Tanto las kinografías como el equipo están a salvo gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140905,
					"content": "La próxima vez que vayamos a grabar en esa zona contrataremos a algunos aventureros para que nos acompañen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140906,
					"content": "¿Y cómo va la kinografía del té?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Ah... La kinografía... Ya tenemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140908,
					"content": "Una buena escena al comienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Y un buen sentido artístico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Entonces... ¡¿Es que acaban de empezar?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "Bueno, verán... Estamos un poco cortos de Moras. El valor de las clases del señor Geisert es tan elevado como su conocimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140912,
					"content": "Aunque ya hemos hecho algunas kinografías cortas, y conseguimos unos cuantos Moras con ellas, una obra tan extensa como esta conlleva unos gastos mucho más altos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140913,
					"content": "Especialmente ahora que la directora rechazó la ayuda de unos patrocinadores que se interesaron en el proyecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Y tampoco aceptó un montón de ofertas de gente que quería colaborar con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "¡Ustedes no lo entienden! Todo eso fue para que podamos hacer esta kinografía con total libertad artística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140916,
					"content": "Pero, directora, ¿no se supone que empezamos todo esto con la intención de ganar dinero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Eh... A ver... ¡Dejen de preocuparse por estas cosas y vayan a preparar el equipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, esto es por todo lo que me has ayudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140919,
					"content": "Te invitaré a ver la kinografía en cuanto esté terminada, y después iremos a tomarnos un buen té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, asegúrense de encontrar un ángulo con buena iluminación. ¡Esta vez quiero que salga bien a la primera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140921,
					"content": "Directora, estamos grabando un paisaje, no hay actores a los que iluminar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Que la toma salga bien depende más de la suerte que otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "Eh... A ver, ¡instalen el equipo de una vez y avísenme cuando esté todo listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 711140903,
					"content": "Parece que tienen todas sus cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
