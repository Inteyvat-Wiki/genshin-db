						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "Así estaría bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "¡Ya están de vuelta! ¿Pudieron colocar los instrumentos? ¡Muchas gracias, de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Déjenme terminar de colocar este otro instrumento y en seguida les daré su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "¿Eh? Podríamos haberlo colocado junto con los otros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Muchas gracias, pero este instrumento es un tanto especial. Requiere de unos ajustes y de una calibración muy precisa y no quería darles tantos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Vamos a colocarlo en ese acantilado y después podré darles su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Parece ser un trabajo difícil... ¿Siempre te has encargado de este tipo de tareas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Bueno, al menos ahora solo tengo que colocar estos instrumentos en la tierra... En una ocasión tuve que apañármelas para colocar un instrumento de medición en medio de un río enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "¿Fuiste en bote hasta ahí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Bueno, si solo fuera tirarlo en el río, podría haber ido en bote, lanzarlo al agua y volver a la orilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Pero aquella vez estaba investigando la velocidad de la corriente, por lo que era necesario que el instrumento quedara suspendido bajo el agua, pero sin llegar a tocar el fondo ni tampoco salir a la superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Por suerte sobre ese río había un puente colgante. Si no hubiera sido por eso, habría necesitado que alguien pusiera una cuerda de una orilla a otra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Y que luego colgara el instrumento a la cuerda, lo deslizara hasta el centro del río y lo sumergiera debajo del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Bueno, no hablemos más de eso. Por suerte, en esta ocasión no tendremos que preocuparnos por algo así, aunque sí que tendremos que pasar por un puente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Vengan por aquí. El puente no está muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
