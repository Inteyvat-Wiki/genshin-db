			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Debe tener batallas sangrientas llenas de tensión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Batallas sangrientas... Tienes un poco de razón. Las batallas atraen la atención del lector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160303,
					"content": "Pero olvídate de “batallas sangrientas”, aquí en la Aldea Chingtsé no ocurre ni una riña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160304,
					"content": "Creo que debo salir a reunir materiales. ¡Eso es! Escuché que hay muchos aventureros en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160305,
					"content": "Van a donde sea en busca de tesoros, y a menudo se enfrentan a monstruos ahí afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160306,
					"content": "Casualmente conozco un lugar con muchos monstruos, no está nada mal. ¡Vamos ahí y esperemos a que los aventureros lleguen y peleen con los monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160307,
					"content": "Jeje... y entonces tendré material a manos llenas. Pero bueno, ese lugar queda lejos, así que me adelantaré. ¡Alcánzame allá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "¡Vaya! Esta vez yo mismo fui parte de una batalla sangrienta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160502,
					"content": "¿No querías ser solamente un espectador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Así es... al principio pensé hacer eso, pero ¿quién diría que no vendría ningún aventurero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160504,
					"content": "Los monstruos estaban a punto de irse, así que pensé, “si de verdad se van, mi espera habrá sido en vano”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160505,
					"content": "Así que arrojé una piedra, ya saben, como en las novelas, para atraer su atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160506,
					"content": "¿Quién hubiera pensado que la piedra aterrizaría en la cabeza de ese monstruo? Y ya saben el resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160507,
					"content": "¡Ay! Está bien, está bien. Sufrí un poco en carne propia, pero obtuve suficiente material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160508,
					"content": "¡Ahora las ideas fluyen en mi cabeza a raudales! Por cierto, esto es para ustedes. Afortunadamente estaban aquí para rescatarme, así que tomen esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160509,
					"content": "¡En cuanto regrese tomaré la pluma y me pondré a escribir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
