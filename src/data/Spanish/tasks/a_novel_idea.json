			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi, volviste. Acabo de aprender un nuevo plato, ¿quieres probarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Sisi, acabo de regresar, estoy exhausto, prefiero descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Tienes razón. Trabajas muy duro, así que debes estar agotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Después de descansar... ¿podemos hablar? Hay que fijar una fecha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Lo sé, no lo olvidé, pero aún no lo he pensado. No es que sea irresponsable, pero tampoco quiero decepcionarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "*Suspira*, el destino de los marineros está en el mar. Sisi, mereces una persona mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Chaoxi, no digas eso, yo lo entiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
