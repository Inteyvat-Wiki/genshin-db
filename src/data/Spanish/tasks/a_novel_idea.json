				"points": []
			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "¿Por dónde empezar a escribir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Oh, eres tú. Me estoy preparando para escribir una nueva novela, pero no sé cómo empezar. Siento que me falta algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160104,
					"content": "Le he dado vueltas por mucho tiempo, pero ni siquiera tengo un bosquejo. De seguir así, no sé cuándo empezaré a escribir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160105,
					"content": "¡Lo tengo! Tú pareces ser una persona de mundo. ¿Cuál crees que es la clave para una novela exitosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
