			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "En otros asuntos, ¿alguna vez has visto a una chica llamada Sisi? Al parecer espera por un marinero de nombre Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160802,
					"content": "Al parecer, ella espera por él a ratos... ¿Qué historia habrá entre ellos dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160803,
					"content": "Ayúdame a averiguar, si escuchas una buena historia, escríbela rápidamente y tráemela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 2211609,
