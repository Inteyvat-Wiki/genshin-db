					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Hoy no es un día adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Chiming"
				},
				{
					"id": 221161003,
					"content": "¿Eh? Si todavía no he dicho nada...",
