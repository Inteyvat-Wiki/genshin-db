						221161305
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221161305,
					"content": "¿Perfecto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "¿Acaso no lo viste? ¿No te das cuenta? Presta atención, ¿esta vaguedad no es suficiente para la comprensión tácita de los espectadores de fuera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
