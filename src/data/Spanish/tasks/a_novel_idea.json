			"dialogs": [
				{
					"id": 221161201,
					"content": "Oye, Lulu, esta vez le toca a Fei ser el capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 221161202,
					"content": "Sí, ya lo dije varias veces, y siempre termino siendo el marinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 221161203,
					"content": "Pero yo creo que es más divertido cuando Meng es capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 221161204,
					"content": "Pero Fei también hace un buen papel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 221161205,
					"content": "Sí, cuando tú eres capitán, yo soy la comerciante y Fei es el marinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 221161206,
					"content": "Así nos divertimos mucho, ¿verdad, Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 221161208,
					"content": "Bueno, si Lulu lo dice... está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 221161209,
					"content": "Fei, ¿tú también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 221161210,
					"content": "Está bien, no es nada. Si Lulu está feliz, sigamos jugando así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 221161211,
					"content": "Es solo un tonto capitán, no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 221161212,
					"content": "Ustedes dos... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				}
			]
