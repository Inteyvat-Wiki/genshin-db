					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "La última vez que fui a la ciudad, vi a un hombre y lo que parecía ser una adivina discutiendo sin parar, pero no alcancé a escuchar los detalles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221160702,
					"content": "Más tarde pregunté por ellos, y supe que el hombre era Zhihua y la mujer era Chiming. ¿Puedes ayudarme a preguntar de nuevo? Si oyes de alguna buena historia, date prisa y cuéntamela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
