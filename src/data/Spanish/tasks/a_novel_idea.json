					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 221161204,
					"content": "Pero Fei también hace un buen papel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 221161205,
					"content": "Sí, cuando tú eres capitán, yo soy la comerciante y Fei es el marinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 221161206,
					"content": "Así nos divertimos mucho, ¿verdad, Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
