				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "Sobre este extraño objeto en el agua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "¿Oh? ¿Lo pusiste en el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "¿Y qué tal? ¿Se produjo algún tipo de reacción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "Apareció un Dragarto Geo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "¿Un Dragarto Geo? ¿Se convirtió en un Dragarto Geo al ponerlo en agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "¿Eh? No es que se convirtiera en un Dragarto Geo, sino que el Dragarto salió del agua cuando vio el objeto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Casi me muero del susto. Si esto pudiera convertirse en un Dragarto Geo al entrar en contacto con el agua, los cimientos de mis creencias se vendrían abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "¿Qué se supone que es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "¿Cómo podría explicártelo? ¡Ya sé! Deja que te haga una pregunta primero. ¿Aquel Dragarto Geo no tenía nada de especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "¿Como un atributo Hydro o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Parecía que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Bingo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "Ese Dragarto Geo probablemente era capaz de utilizar el elemento Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "El agua subterránea de la Sima contiene una gran cantidad de energía Hydro. Algunos puntos con gran concentración de energía se han convertido en un lecho natural para la aparición de algas como las que te encontraste mientras pescabas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "El Dragarto Geo es una criatura de la Sima que tiene predilección por el agua. Su poder aumenta cuando se nutre de la densidad de energía Hydro de esas algas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "¡Así que esa cosa en realidad son algas cargadas de energía Hydro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "¿Solo son unas algas...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Pues sí, son algas, pero unas algas ricas en energía Hydro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "No se encuentran en un entorno normal y corriente. A no ser que una fuente de gran poder y pureza haya alterado el agua... Olvídalo. En cuanto a esas algas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "No puedo descartar que un día de estos se conviertan en organismos elementales más desarrollados. Es digno de estudio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "No vi nada de eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#¿Te encargaste de él tan rápido que ni te diste cuenta...? ¡Como era de esperar {F#de la legendaria}{M#del legendario} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Pero según mi hipótesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
}