			"dialogs": [
				{
					"id": 710500501,
					"content": "Sobre este extraño objeto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "¿Eh? ¿Has encontrado esto pescando? Ahora que lo mencionas... Esto se parece al cebo que utilizamos para pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "¿Es normal que la gente encuentre este tipo de cosas cuando pesca...? Anisa también se pasa el día pescando en la Isla Watatsumi, pero que yo sepa nunca se ha encontrado algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "¡Solo tú podrías encontrar algo como esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "A ver... Este objeto contiene una cantidad desmesurada de energía Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "La verdad es que el agua subterránea de la Sima contiene una cantidad particularmente elevada de energía elemental... A lo mejor es porque hay cosas como esta creciendo bajo el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Pero desde que la sacaste del agua, ha estado perdiendo energía. Puede que necesite estar en el agua para poder acumular energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "¿En el agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Ya sabes, ponerla en agua y activarla con el elemento Hydro. Así podremos descubrir qué secretos oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "¿Por qué no la activas tú? Al fin y al cabo, la pescaste tú. Vuelve cuando lo hagas para contarme lo que pasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Te pagaré si tus descubrimientos resultan ser útiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105008,
