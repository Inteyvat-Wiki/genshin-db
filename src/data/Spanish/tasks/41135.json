			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "¿Dónde estará el Gran Maestro?... Me pregunto si estará al corriente de esta situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "*Suspira*, pero aunque recibiera noticias al respecto, tampoco podría regresar pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
