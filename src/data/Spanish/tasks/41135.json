			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "Espero que Godwin esté bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Hola. Godwin me dijo que viniera a ver qué tal estabas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "¿Godwin? ¿S-sabes dónde está? No he sabido nada de él en mucho tiempo y estaba preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "Está en una misión en un lugar lejano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Oh... Ya veo, está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "Si no fuera por esos meteoritos, se lo habría preguntado a los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "He estado en la ciudad todo el tiempo, así que he estado a salvo hasta ahora. Pero probablemente él todavía esté haciendo su misión. Si esto está ocurriendo en todo el mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "*Suspira*, espero que esté bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "Seguro que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Gracias. Eso sería maravilloso. Ah, por cierto, ¿podrías ayudarme con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "Le compré a Flora un lote de semillas de diente de león y estaba buscando a alguien que me ayudara a esparcirlas desde un lugar elevado... para que el viento las lleve hasta Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "Pero con esta situación, no sé si encontraré a alguien que pueda ayudarme en este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Ya que estás aquí, ¿podrías ayudarme a llevar estas semillas de diente de león a Godwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Gracias. Debe de estar en un lugar muy lejano en este momento. Después de todo, está en una expedición con el Gran Maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350416,
					"content": "Por favor, llévale estas semillas de diente de león y dile que estoy bien. Y luego... dile que él también se cuide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 4113505,
			"completionStepIds": [
				4113507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113507",
							"2"
						],
						"stepId": 4113507,
