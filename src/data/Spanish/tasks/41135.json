				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350501,
					"content": "#Viajer{F#a}{M#o}, ¿fuiste a ver a Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350502,
					"content": "¿Qué tal está? ¿Está bien? ¿No está herida, o sí? Sí, sé que ha estado en la ciudad todo este tiempo, pero, aun así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350503,
					"content": "Me dijo que te trajera estas semillas de diente de león.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "¿Eh? ¿Semillas de diente de león? Vaya, eso es muy de su estilo. *Suspira*, mi Glory... Espero que no esté enojada conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350505,
					"content": "Gracias por ayudarme con todo esto. Por favor, acepta esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350506,
					"content": "*Suspira*, si el Gran Maestro pudiera regresar, este problema se resolvería en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
