					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110502,
					"content": "Sobre el pedido de Viktor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110503
					]
				},
				{
					"id": 230110503,
					"content": "Esta madera... ¿Lograste derrotar a todos los monstruos? Parece que no se te da nada mal luchar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110504
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110504,
					"content": "Muchas gracias. Voy a buscar a alguien que vaya conmigo al lugar para poder recuperar las maderas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110505
					],
					"speakerTitle": "Hamawi"
