			"dialogs": [
				{
					"id": 230110601,
					"content": "¿Y bien? ¿Ya tienen la madera que compré?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Le cuentas a Viktor lo ocurrido...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "¿Otro ataque? Parece que todos los porteadores de este mundo son un objetivo fácil para los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Pero bueno, lo importante es que me traerán la madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Toma, aquí está la recompensa que acordamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "Y otra cosa, ¿cómo está Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "No me despedí de ella en persona cuando me fui. No se habrá enojado, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "¡Ejem! No me mires así, es solo que estoy preocupado por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "#Bueno, cuenta la recompensa, viajer{F#a}{M#o}. Verás que te pagué hasta el último Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Si tanto te preocupa, vuelve y compruébalo tú mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "No, no puede ser. El Sr. Vsévolod me daría una buena tunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "Y no me atrevo a enviarle una carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110613,
					"content": "Parece ser que recibir una carta de un Fatui no es nada bueno, jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				}
			]
