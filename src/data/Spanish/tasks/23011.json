			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hamawi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110301,
					"content": "Qué mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "Sobre el pedido de Viktor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "¿Te refieres a la madera que me encargó ese Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "Bah, ni me hables del tema. Ya sabía yo que hacer negocios con los Fatui no me traería nada bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Unos monstruos atacaron a los porteadores por el camino. Al final consiguieron volver todos, pero rompieron el carro y las maderas siguen tiradas por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "*Suspira*, yo no me atrevo a ir y tampoco encuentro a nadie que quiera enfrentarse a los monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Yo no estoy con los Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "#¿No eres {F#una}{M#un} Fatui? Entonces, ¿qué haces trabajando para él? Qué raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "No hay nada que hacer, no puedo traer de vuelta la mercancía. Tendré que esperar hasta encontrar a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Si tanta prisa tienen, les marcaré en el mapa aproximadamente dónde se perdió el carro. Así podrán ir a buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110312,
					"content": "*Suspira*, siempre que hay algún Fatui de por medio, surge algún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hamawi"
				}
			]
		},
