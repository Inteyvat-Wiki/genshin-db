					"nextDialogs": [
						737140103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140103,
					"content": "Paimon se ha dado cuenta de que el desierto, los bosques y los valles de Sumeru son muy diferentes... Pero parece que casi nunca los hemos visto todos en un solo viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140104,
					"content": "Pero como tenemos todo el tiempo del mundo, a Paimon le parece que deberíamos tomárnoslo con calma y disfrutar del momento.",
