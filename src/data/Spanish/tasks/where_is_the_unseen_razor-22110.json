					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Esto no tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "No sé si es porque eres muy fuerte, o porque eres muy débil, pero parece que tienes mucho tiempo libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Supongo que lo primero, porque has completado todos mis encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Si no tienes mucho que hacer, tengo una solicitud más para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Pero esta vez el objetivo es un poco peligroso. Es un Cazador de las Ruinas. ¿Qué dices? ¿Aceptas mi solicitud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Considéralo hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "#¡Qué aventurer{F#a}{M#o} tan segur{F#a}{M#o} de sí mism{F#a}{M#o}! ¡Igual que mi hermano! Tal vez llegues lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "#Bien, basta de charla. Es en la Llanura Guili. Cuando estés preparad{F#a}{M#o}, ve por el Cazador de las Ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Cuando termines, no olvides traerme algo relacionado con una espada, si es que lo encuentras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "De lo contrario, ven directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Esta es mi solicitud para ti... Solo espero que esta vez puedas encontrar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "¿Tengo que buscar la espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Por cierto, después de acabar con el Cazador de las Ruinas, recuerda buscar un objeto relacionado con la espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Pero te advierto, el Cazador de las ruinas no es fácil de vencer, deberás concentrarte en sus movimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "En cuanto al objeto relacionado con la espada, lo ideal sería que lo encontraras. De lo contrario, no pasa nada. Vence al Cazador de las Ruinas y te daré la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
