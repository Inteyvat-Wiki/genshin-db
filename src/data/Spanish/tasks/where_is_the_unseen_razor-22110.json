			"dialogs": [
				{
					"id": 221100301,
					"content": "¿Y bien? ¿Lo derrotaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Sí, lo he derrotado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Ni siquiera el Cazador de las Ruinas fue rival para ti... Eres lo suficientemente fuerte en todos los sentidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "¿No encontraste nada relacionado con una espada? Como pensaba... Estoy harta de preguntar por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "No importa, hiciste un buen trabajo con todos mis encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "¿Dónde estará la Cuchilla Oculta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Estoy seguro que aparecerá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "¿Tratas de consolarme? ¡Ja! Es solo un pequeño contratiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Sea cuando sea o donde sea, definitivamente encontraré esa espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Seguiré ampliando mi área de búsqueda. Tal vez vuelva a necesitar tu ayuda, pero relájate, también tendré una recompensa para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Bien, aquí tienes tu recompensa. Seleccionaré la siguiente lista de encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "Cuchilla Oculta... algún día te encontraré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Estos encargos no están relacionados con una espada, para nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Ya acepté todos los encargos que tenían que ver con una espada... pero sigo con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Aun así, estoy segura de que mi hermano solo pudo haber perdido la espada frente a un gran peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Así que comencé a aceptar otros encargos en lugares peligrosos para poder encontrar la Cuchilla Oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Pero como hay tantos encargos peligrosos, no puedo hacerlos yo sola, así que solo me queda confiar en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
