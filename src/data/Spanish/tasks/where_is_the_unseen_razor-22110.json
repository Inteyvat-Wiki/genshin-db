			"dialogs": [
				{
					"id": 221100201,
					"content": "¿Y bien? ¿Lo derrotaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "No te preocupes, el Cazador de las Ruinas es un enemigo formidable. Necesitarás mucho cuidado y preparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
