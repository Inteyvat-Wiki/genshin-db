			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Siento tener que molestarte en un día festivo, pero todos los años, la Farmacia Bubu recibe a muchos pacientes durante el Rito de la Linterna y estamos hasta el cuello de trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400102,
					"content": "¿Cómo es posible?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Durante el Rito de la Linterna, todo el mundo descansa para ir a visitar a sus familiares, y, por supuesto, comen todo tipo de excentricidades y beben todo tipo de mejunjes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400104,
					"content": "No es de sorprender que con esa ingesta se enfermen, o que les aquejen toda clase de malestares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400105,
					"content": "Aunque siempre intento convencerlos de que no coman ni beban en exceso, mis palabras no tienen efecto cuando de comer se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400106,
					"content": "Algunas familias contactaron conmigo para que les enviara medicamentos para la indigestión y el dolor de estómago, pero no puedo desatender la Farmacia Bubu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400107,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ayudarme a enviar estos medicamentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				}
			]
		},
		{
			"id": 4134002,
