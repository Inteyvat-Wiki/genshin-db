			"dialogs": [
				{
					"id": 413400601,
					"content": "Vaya, qué buen aspecto y qué resistente es esta linterna. Jeje, mis habilidades son nulas comparadas con las tuyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
