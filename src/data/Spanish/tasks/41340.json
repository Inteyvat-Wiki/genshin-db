			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Buen trabajo. ¿Ya entregaste todos los medicamentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400402,
					"content": "Creo que van a volver a enfermarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Bueno, no hay mucho más que podamos hacer. Si no prestan atención a su estilo de vida, siempre tendrán problemas de dolor de estómago. Lo único que puedo hacer es darles paliativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400405,
					"content": "Pero, de momento, al fin puedo tener un respiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400406,
					"content": "Sobre las linternas celestes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "¿Las linternas? Normalmente no las liberamos. ¿Qué deseo podríamos pedir en la Farmacia Bubu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400408,
					"content": "Los demás establecimientos piden un negocio próspero, pero una farmacia que atiende enfermos no puede desear algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400409,
					"content": "Eres muy buena persona, Gui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "En cambio, personalmente, sí me gustaría liberar una. Después de todo, estamos de fiesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400412,
					"content": "He estado intentando hacer una linterna celeste, pero como estoy muy ocupado, apenas he comenzado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400413,
					"content": "Ni siquiera ahora que tengo un poco de tiempo libre podría trabajar mucho en ella. Cuando la termine, me temo que el Rito de la Linterna ya habrá acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400414,
					"content": "Yo te ayudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "¿E-en serio? ¡Te estaría muy agradecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400410,
					"content": "Eres muy sincero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "Solo estarán bien por un tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
