			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanhai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Ay, ay, ay... No aguanto más... Oh, ¿puedo ayudarte en algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400302,
					"content": "El Herborista Gui te envía estos medicamentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "Ay, ay... G-gracias. Los pedí yo. Llegas justo a tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400304,
					"content": "¡Uf! Estaré mejor con estos medicamentos. Creo es porque ayer por la noche entró una brisa marina y pesqué un resfriado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400305,
					"content": "¿No es indigestión?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "¡Imposible! Tengo un estómago de hierro. Es más, comí tres pescados enteros de un bocado en mi última comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400307,
					"content": "Incluso ahora, cuando de comer y beber se trata, ¡no tengo rival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400308,
					"content": "Está bien, no hablemos más del tema. Mejor tomaré mi medicina, que todavía me falta una ronda de copas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400309,
					"content": "... Mejórate pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "¡Jajaja! ¿Qué crees que soy, un anciano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400312,
					"content": "Pero gracias por tus buenas intenciones, me cuidaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400310,
					"content": "Cuida tu salud antes de que te arrepientas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
