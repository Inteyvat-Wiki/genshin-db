			},
			"dialogs": [
				{
					"id": 413400701,
					"content": "Ah, ya llegaste. Ya escribí mi deseo en la linterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400702,
					"content": "Justo a tiempo... Pronto liberaré la linterna celeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400801,
					"content": "Mi deseo personal es... que todos los habitantes de Liyue gocen de buena salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400802,
					"content": "¿Qué hay del negocio de la Farmacia Bubu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Jaja, por eso dije que es mi deseo personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400804,
					"content": "Doy recetas a la gente porque no puedo soportar ver sufrir a las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400805,
					"content": "Como dice un viejo proverbio: “Que no haya más enfermedades, aunque eso signifique el fin de nuestro negocio”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400806,
					"content": "Jaja, además, si todo el mundo está sano, no estaría tan ocupado. Eso es bueno, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400807,
					"content": "¡Oh, no! Acabo de recordarlo, ¡falta por enviar un medicamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400808,
					"content": "Lo siento, ¡tengo que irme! ¡Que tengas un feliz Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				}
			]
		},
