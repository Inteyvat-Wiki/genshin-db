			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#Has venido, aventurer{F#a}{M#o}. Estábamos pensando en empezar con las instalaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Si todo va bien, ¡ese monstruo hoy se llevará un buen escarmiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Durante el proceso formal de recarga, puede que se acerquen monstruos a interrumpir el proceso. Llegado el momento, te ruego que vigiles el dispositivo para que no sufra daños durante la recarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#Muchas gracias, aventurer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "¡Ah, tengo una idea! Con todo lo que nos has ayudado con el cañón gusicida, el honor de probarlo por primera vez... ¡debería ser tuyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "¿No prefieres encargarte tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Solo verlo instalado me va a saber a gloria. Además, es mejor ver cómo lo usa otra persona para poder apreciarlo en todo su esplendor. ¡Ah, qué maravilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Todo lo que hay que hacer es proteger los dispositivos de recarga de los monstruos hasta que esté completo, esperar a que el gusano de arena revele su punto débil y entonces, ¡dispararle con todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "¡Los mecanismos de ignición y corrección automática se encargarán del resto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#¡Suena a algo superincreíble, {NICKNAME}! ¡Paimon también quiere ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Está bien, creo que podré ingeniármelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Jeje, ¡manos a la obra! Deja que te explique cómo funciona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "No sé cómo manejarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "¡No hay problema! Lo he diseñado específicamente para que cumpla con el principio de interfaz intuitiva del usuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}