				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "Humm... Necesito preparar otro lote de cofres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "¿A qué cofres te refieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "#¡Oh! ¿Eres {F#una}{M#un} viajer{F#a}{M#o}? ¿También vienes a participar en el Festival de la Luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Sí, algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "Bueno, llegas justo a tiempo. Nuestro Gremio de Aventureros está organizando un evento por el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "¿Quieres que te cuente de qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "¿Qué tipo de evento es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Por el Festival de la Luna, el Gremio de Aventureros colocó unos objetos llamados “Talismanes lunares” en varios lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Quienes los encuentren pueden llevarlos al gremio y canjearlos por varias recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Además, el gremio ha enviado a un grupo de aventureros para que coloquen un gran número de cofres especiales en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "Esos cofres especiales están llenos de tesoros de todo tipo preparados por el gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Además de estos dos eventos, el gremio ha preparado una serie de retos exigentes para aquellos aventureros de élite que quieran desafiarse a sí mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Específicamente... una serie de campamentos de monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "¿Tiene eso algo que ver con el Festival de la Luna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Ah... Jajaja, ¡vamos, no seas así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "Mientras los monstruos sean derrotados, ¡el gremio pagará la recompensa que corresponda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "¿Cuál es la diferencia entre esto y los encargos habituales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "¡Por favor, te lo ruego! La mayoría de los aventureros se ha ido a celebrar el Festival de la Luna, por eso muchos encargos quedan sin respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "¿Qué dices? Con tus habilidades, ¡seguro que podrás encargarte de esos monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "¿Qué me queda...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "#La recompensa no te decepcionará, ¡tranquil{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Estaré aquí mientras dure el Festival de la Luna, así que si tienes alguna pregunta, ven a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "#Entonces, lo dejo en tus manos, viajer{F#a}{M#o}. ¡Que disfrutes del festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Más vale que prepares una buena recompensa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "¡Eso no tiene nada que ver con el Festival de la Luna!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "No son más recados, ¿verdad?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "¡No! ¡Este evento es toda una aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}