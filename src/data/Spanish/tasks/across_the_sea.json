	"talks": [
		{
			"id": 1101001,
			"completionStepIds": [
				1101001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101001",
							"2"
						],
						"stepId": 1101001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "#No bajes la guardia, viajer{F#a}{M#o}. Ahora no es tiempo de pasear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "¿Oh? ¿Ocurrió algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Sí. Puede sonar extraño, pero muchos testigos han confirmado la presencia de un Guardián de las Ruinas en los alrededores, a pesar de que está lejos de su área de actividad normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "El sargento envió a alguien para averiguar de dónde podían haber venido. Parece que simplemente dejaron sus ruinas y se marcharon de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Entonces, ¿alguien los despertó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Como dije, no sabemos aún el motivo. Tenemos muy poca información por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Además... Las ruinas en cuestión son especialmente espeluznantes. A menudo se escuchan ruidos extraños que vienen de su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Es por eso que no se nos permite investigar hasta que llegue la orden desde la sede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "Tendremos que ir con más cuidado que de costumbre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "En fin, por el momento la estrategia más sensata es aumentar el número de patrulleros. No debemos permitir que civiles inocentes sufran daño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Tienes razón... Los Guardianes de las Ruinas son bastante peligrosos para la gente normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "¿Puedo ayudar en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Pues, eh... Gracias por la oferta, pero... no vale la pena arriesgarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#¡No te preocupes, es pan comido para {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Sé defenderme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Bueno, en ese caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "Vi huellas de Guardián de las Ruinas <color=#00E1FFFF>en la ladera</color>, pero he estado demasiado ocupado avisando a los caminantes como para ir a investigar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Huellas, ¿eh? Interesante... ¡Aceptamos el caso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "#¡Duros como la roca, inamovibles como un peñasco! Gracias en nombre de la Geoarmada, viajer{F#a}{M#o}. Nos veremos cuando haya terminado mi patrullaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "No es por alardear, pero podría vencer a diez de ustedes en una pelea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "¡Jajaja! ¡Qué confiados son los jóvenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "La Geoarmada, siempre tan inepta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "¿Eh? ¿Dijiste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "¿Estás imitando al Sr. Diluc cuando habla de los Caballeros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "¡Mira! ¿No es genial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "¡Qué ropa tan extraña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "¡Nunca había visto uno tan cerca! ¿Tú habías visto uno de estos antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Sí, es un Guardián de las Ruinas sin energía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "¡Te equivocas! ¡Se llama “Sr. Cíclope”! ¿Qué clase de nombre es “Guardián de las Ruinas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "¿“Sr. Cíclope”? ¡Qué nombre tan tierno! ¿Hay gente que los llama así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "¡Sí! Me lo dijo mi hermano. ¡Es el mejor vendedor de juguetes del mundo! ¡Su trabajo es vender este tipo de cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Ahora mismo está en el Instituto de Investigación de Juguetes de Liyue. De ahí es de donde viene el Sr. Cíclope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "Siempre es bueno conocer a gente a la que le gustan los juguetes. Dime, ¿de dónde conseguiste el tuyo? Debe ser un modelo nuevo, ¡nunca había visto uno que pudiera volar y hablar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon no es un juguete, y los Guardianes de las Ruinas tampoco lo son...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "¡Así es, Paimon no es un juguete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Hola, ¿encontraste algo? Eh, ¿quién es este niño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Lo acabamos de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "No deberías estar aquí, pequeño. Hay máquinas asesinas en la zona, es extremadamente peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "¿“Máquinas asesinas”? ¿Quieres decir... como esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Sí, esa también. Ahora no se mueve, pero si se despertara, las consecuencias serían...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "¡Retira lo que dijiste! ¡El Sr. Cíclope no es una máquina asesina! ¡Es de los buenos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Em... ¿“Sr. Cíclope”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "Oye, no deberíamos estar hablando con este tipo. Si está diciendo cosas malas sobre el Sr. Cíclope, definitivamente es una mala persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "Yo... solo trato de ayudar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Ya no te está escuchando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Uf, cuando de niños se trata, soy completamente inútil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "#¿Por qué no vuelves a tu trabajo y nos dejas a nosotr{F#as}{M#os} a cargo del cuidado de los niños?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Parece que no tengo otra opción... Muy bien, seguiré patrullando. Por favor, acompañen al niño a un lugar seguro, este sitio es demasiado peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "¡Jeje, el poderoso Sr. Cíclope ahuyentó a los malos una vez más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "¿Como te llamas, amiguito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "¡Mi nombre es Teucer! Vine de Snezhnaya a buscar a mi hermano en Liyue. Pero estoy solo y no sé dónde encontrarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "¡¿Viniste desde Snezhnaya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Ah, creo que ahora es cuando debería darte esto. ¡Toma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "¿Qué es? Se ve pesado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "¡Cuántos Moras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Mi hermano dijo que debía llevarlo conmigo. Dijo: “encuentra una buena persona a quien regalarle esto, y ella cuidará bien de ti”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Tu hermano tiene razón... Aun así, no me puedo creer que hayas llegado hasta aquí con nada más que una bolsa de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "¡Tu familia debe ser muy rica! Paimon nunca pensó que se podría ganar tanto dinero vendiendo juguetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "¡Con mucho gusto lo tomaré!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#¡Hurra! ¡Gracias, amig{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Muy bien, ¡ahora promételo con el meñique!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "“Si con el meñique prometes, lo mantienes toda la vida. Si la promesa rompieres, al hielo te arrojaría. Tu lengua se congelaría, ¡y nunca más mentirías!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Vaya... Esa canción infantil de Snezhnaya es bastante cruel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "#Bueno, si antes no éramos niñer{F#as}{M#os}, ¡ahora definitivamente lo somos! Pero... ¿dónde encontramos a su hermano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "En algún lugar con conexiones cercanas a Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Veamos... Un lugar con conexiones cercanas a Snezhnaya... ¿Qué hay del <color=#00E1FFFF>Banco del Reino del Norte</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "¡Qué bien! ¡Por fin podré ver a mi hermano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "¿En el <color=#00E1FFFF>Banco del Reino del Norte</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "¡Qué buena idea! Muy bien, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Gracias. (Se lo daré a tu hermano cuando lo encontremos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "¡Son muchísimos Moras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "¿Dónde está tu familia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Yo me haré cargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Es edición limitada. ¿Qué, tienes envidia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "¡Oye! ¡El hecho de que juegues con Paimon todo el tiempo no significa que Paimon sea un juguete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Niño, ten cuidado, estos tipos son muy poderosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "¡Vaya que lo son! ¡El Sr. Cíclope es muy, muy fuerte! Ningún tipo malo puede escapar de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Señor, ¿no le parece un poco inadecuado? ¿Cómo puede...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Relájate, no está mal de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100303,
					"content": "¿Eh? ¿Qué hace él aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "¡Hermano! ¡Te encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Esa voz me es familiar... ¡Vaya, es mi hermanito, Teucer! ¡Por Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100306,
					"content": "Jaja... ¡Qué sorpresa tan agradable, Teucer! Pensé que tendría que regresar a casa para verte de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100307,
					"content": "¿Cómo están los demás, nuestra hermana Tonia y nuestro hermano Anthon? ¿Están todos bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100308,
					"content": "¡Te extrañan mucho! Tonia reza por ti todos los días antes de la cena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "Espera un momento, Teucer, ¿qué haces en Liyue? ¿Por qué no sabía nada de esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100310,
					"content": "Bueno... lo que pasó fue que... vi un barco que parecía estar vendiendo juguetes, y pensé que estabas a bordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "Y luego, cuando me bajé, seguí caminando y caminando... Y luego, ¡encontré un Sr. Cíclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "#El Sr. Cíclope asustó a un chico malo, y luego encontré a mi amig{F#a}{M#o}, que me ayudó a buscarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Entonces, ¡Teucer es un polizón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "Espera... ¡¿Teucer es el hermano de Nobile?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "¡Genial! De repente, ¡Paimon no se siente tan mal por haber aceptado el dinero de Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, lo que hiciste fue extremadamente peligroso... Me alegra mucho verte, pero por favor, prométeme que no lo volverás a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100318,
					"content": "Está bien, lo prometo... Por favor, no te enojes conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "No estoy enojado contigo. Solo me preocupo por tu seguridad, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100320,
					"content": "Si no hubieras conocido a esta buena persona, podrías estar en grave peligro. ¿Ya le diste las gracias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100321,
					"content": "¡Sí! Siempre recuerdo decir “por favor” y “gracias”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Así que sabías que estábamos aquí, solo que nos ignoraste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "¡Jajaja! Lo siento, la familia es lo primero. No es nada personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100324,
					"content": "Sé que hemos tenido diferencias, pero dejando esos detalles a un lado, nos llevamos muy bien, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100325,
					"content": "¿Lo dices en serio o solo para guardar las apariencias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Jeje, vamos, sabes que no soy más que un peón que cumple con su deber. Los que nos mueven a nosotros y cargan con las consecuencias son los ganadores y los perdedores del juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100328,
					"content": "A mí lo que más me interesa es quién gana y quién pierde de nosotros dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100329,
					"content": "#¿Es que quieres que {NICKNAME} te dé una paliza de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "¡Ja! Hay algo que olvidas de mí: yo, Tartaglia, me vuelvo más fuerte con cada segundo que pasa. La próxima vez no te lo pondré fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100331,
					"content": "Yo también he recorrido un largo camino desde entonces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Oigan, oigan, no van a pelear ahora, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Jajaja ... Quizás no ahora mismo. No mientras mi hermano pequeño esté mirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100335,
					"content": "#¿Por qué quieres pelear con {F#mi amiga}{M#mi amigo}? ¿Son enemigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#¡No, para nada! {NICKNAME}, me gustaría expresar mi más sincero agradecimiento por cuidar de mi hermanito. Su seguridad es lo más importante para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100337,
					"content": "Te estaré vigilando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "Ahora que lo mencionas, Paimon tiene una pregunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer dijo que su hermano era vendedor de juguetes... ¿De qué se trata? ¿No se supone que eres uno de Los On...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "*Ejem*, sí, bueno, sobre eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100342,
					"content": "¡Shh! Solo se lo dije para que me admirara. Para un niño, trabajar con juguetes es lo mejor del mundo, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100343,
					"content": "No quiero que mi familia tenga nada que ver con los Fatui... o con el lado oscuro de Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100344,
					"content": "Los más grandes ya saben que trabajo para la Zarina, pero Teucer es muy joven, y esa mirada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100345,
					"content": "*Ejem*, como iba diciendo, ¡soy el mayor vendedor de juguetes de Snezhnaya! ¡Y trabajo en el Instituto de Investigación de Juguetes de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100346,
					"content": "¡Así es! ¡Mi hermano es el mejor! ¡Es el mejor amigo del Sr. Cíclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Por favor, colabora conmigo mientras Teucer esté aquí. ¡Te lo ruego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100348,
					"content": "Ah, sí. Ekaterina, me ocuparé del pago pendiente de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100349,
					"content": "¡Oye! ¡No te escabullas ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Pero, Sr. Nobile, ¿no sería un poco inapropiado pedirle que se ocupe del cobro de deudas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "Una apuesta es una apuesta, ¿no? Y si se pierde una apuesta con un recaudador... En fin, puedo aprovechar y estirar un poco los músculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100352,
					"content": "¿Ya te vas a vender juguetes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "#¡Así es! Me encantaría ponerme al corriente contigo, Teucer, ¡pero el deber me llama! Estoy seguro de que tu {F#nueva amiguita}{M#nuevo amiguito} estará encantad{F#a}{M#o} de hacerte compañía mientras estoy fuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100354,
					"content": "#Entonces, ¿también tenemos que hacer de niñer{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "#¡Está bien! De todos modos, {F#ella}{M#él} me agrada. Además, ¡prometió con el meñique que me cuidaría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "¡Bien! Parece que a Teucer le agradas, y que le prometiste con el meñique que cuidarías de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100357,
					"content": "¡Los dos hermanos me tendieron una emboscada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Estoy en deuda contigo. Toma este dinero, considéralo el “fondo de entretenimiento” de Teucer. Quiero que se divierta mientras está en Liyue, así que llévalo a donde quiera ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100360,
					"content": "Si me necesitan, estaré en el río <color=#00E1FFFF>cerca del Estanque Chingxu</color>. ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110100358,
					"content": "De acuerdo... Lo haré por Teucer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Entiendo que te preocupes por tu familia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "#Estoy list{F#a}{M#o} cuando tú quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Tienes muchas agallas para decir eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "¿Teucer es el hermano de Nobile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
