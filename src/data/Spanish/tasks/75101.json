			"dialogs": [
				{
					"id": 751010101,
					"content": "Claro, eso es lo normal... Esa es la conexión estable con la Estatua de Los Siete que estamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010102,
					"content": "¡Así que es verdad que la anomalía de la Estatua de Los Siete es culpa de ese tipo malo del Reino de la Noche! ¡Hiciste un gran trabajo, Estatua de Los Siete! Seguro que tú también lo has pasado mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010103,
					"content": "Bueno, no es como si fueras tú quien puede conceder el poder de la Consonancia elemental con el elemento Pyro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010104,
					"content": "Sí, eso ocurrió cuando luchamos junto a la Arconte Pyro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751010105
					]
				},
				{
					"id": 751010105,
					"content": "Paimon estaba muy preocupada en aquel momento... ¡Pero la verdad es que fuiste superfuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010106,
					"content": "Después de deshacernos de todos esos monstruos del Abismo, la Estatua de Los Siete volvió a la normalidad. ¡Qué bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
