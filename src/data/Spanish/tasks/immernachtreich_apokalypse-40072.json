			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cuervo Noctívago solemne",
					"Cuervo Noctívago adusto",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "¡Alto ahí! ¿Quiénes son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Cuervo Noctívago solemne"
				},
				{
					"id": 400720202,
					"content": "No parecen ciudadanos del Reino de la Noche Eterna. ¡Hablen! ¿Qué los trae aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Cuervo Noctívago adusto"
				},
				{
					"id": 400720203,
					"content": "¡Este sitio tiene hasta guardias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Vamos a calmarnos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "¿Eh? ¿Qué haces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Somos súbditos de la Princesa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "Atravesamos el mar de estrellas para llegar hasta aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "¿Cómo pueden demostrar que son súbditos de Su Alteza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Cuervo Noctívago solemne"
				},
				{
					"id": 400720209,
					"content": "¡Hum! Esa pregunta tan absurda delata tu ignorancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "“Que mi pueblo sea libre del yugo de los decretos antiguos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "Esa es... ¡Es la contraseña del Reino de la Noche Eterna! ¡De verdad son súbditos de Su Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Cuervo Noctívago adusto"
				},
				{
					"id": 400720212,
					"content": "Por Los Siete... No lo sabíamos. ¡Perdónennos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Cuervo Noctívago solemne"
				},
				{
					"id": 400720213,
					"content": "¡Apártense de inmediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Sí, sí, ya nos vamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Cuervo Noctívago solemne"
				},
				{
					"id": 400720215,
					"content": "Ya se fueron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "#Este es el segundo tomo de «El himno del Reino Sagrado». ¿Tod{F#as}{M#os} list{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "¡Allá vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007204",
							"2"
						],
						"stepId": 4007204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narrador",
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "“Sin embargo, el Reino de la Noche Eterna estaba inmerso en una pesadilla sin fin. El malévolo dragón Tarasca, oculto en las profundidades, cruzó el fondo del océano y emergió sobre la capital”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Narrador"
				},
				{
					"id": 400720402,
					"content": "¿Eh? ¿Un dragón? Parece que lo único que ocurre es que está nublado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Tal vez el dragón es... ¿una especie de metáfora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "¿Eso crees? Su archienemigo, Tarasca, el dragón malvado, es producto de todo lo que se opone a su fantasía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007210",
							"2"
						],
						"stepId": 4007210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"León",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Oh, menos mal... ¿Eh? ¡¿Qué están haciendo aquí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721002,
					"content": "Eso mismo nos preguntamos nosotros. ¿Qué haces tú aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "Estamos de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Me temo que acabamos de ser testigos de la verdadera naturaleza del dragón malvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "*Suspira*, estoy muy familiarizada con este tipo de cosas. Siempre hay gente que cree que nuestra pasión es una pérdida de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "¿Eh? Tú eres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Soy Arnold el “pídeme direcciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Vaya, estás de vuelta, ¿por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Oh, oh... Porque supuse que estarían buscando el tercer tomo de «El himno del Reino Sagrado».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Bueno, supusiste bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Hermosa dama, no tiene que hacer nada por mí. Contemplar su belleza es la mejor recompensa que me puede dar. Les daré la respuesta que buscan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "El tercer tomo de «El himno del Reino Sagrado» se encuentra en lo más alto del castillo real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "¿Está bajo vigilancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Oh, pues claro, señor. ¿Qué clase de pregunta es esa? Ningún reino serio expondría sus libros más valiosos a la intemperie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Entonces habrá una patrulla de Caballeros Cuervo Noctívago allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Vigilar las sagradas escrituras es el honor más supremo de un ciudadano. Pero no se preocupen. Estoy seguro de que una bella dama como usted solo querrá leerlas y no alberga malas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Puedo ver la sabiduría y el encanto en su rostro, y sus acompañantes parecen ser héroes de gran renombre. Estoy seguro de que podrán comprender el verdadero significado de las historias de nuestras sagradas escrituras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "El Sr. Oz, el Gran Escriba, registró las hazañas de Su Alteza, con lo que se convirtieron en un tesoro del Reino de la Noche Eterna. Mientras leo esos libros, no puedo más que desearle a Su Alteza la mayor felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"León",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Lamento que me vean una y otra vez en este estado tan lamentable. No soy digno de hacer el papel de Caballero Cuervo Noctívago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721802,
					"content": "¿“Hacer el papel”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "Me avergüenza tener que confesarlo, pero no soy un caballero de verdad. En realidad soy un actor novato que acaba de encontrar trabajo representando a un caballero en una compañía de teatro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721804,
					"content": "¡Esa no es razón para actuar tan engreído!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "¡Te equivocas! El teatro es un elemento cultural importantísimo en el Reino de la Noche Eterna. La mejor recompensa que podemos ofrecer a Su Alteza es una buena puesta en escena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721806,
					"content": "Oh, ¿es parte de su folclore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "¡Exacto! ¡Por eso estoy muy contento de poder hacer el papel de un caballero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721808,
					"content": "¿Por qué a la Princesa le gusta tanto el teatro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Su Alteza dijo en una ocasión: “Homenajéenme llevando a cabo una puesta en escena al aire libre. Póstrense ante mí y ofrézcanme los sueños más bellos a cambio de la gloria de la Noche Eterna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721810,
					"content": "Creo que es porque Su Alteza es una verdadera conocedora del arte, y es capaz de distinguir las penas y alegrías más profundas de la naturaleza humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721811,
					"content": "El alma del teatro reside en la sublimación de las emociones. Aquellos que saben de teatro tienen un corazón bello y sensible, lleno de emociones desbordantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721812,
					"content": "Así que esa es la razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Muchas gracias por tu respuesta, caballero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "¡Oh! ¡Muchas gracias por llamarme “caballero”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721815,
					"content": "¡Bien! ¡Revestido de gloria, me dirijo a la batalla! ¡Hasta que nos volvamos a encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "León"
				},
				{
					"id": 400721816,
					"content": "Esperemos que no... ¡Ten más cuidado a la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "¡Oh, por cierto! Recuerden la contraseña para abrir la puerta: “Te lo ordeno, ¡despliega tus alas y alza el vuelo!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "León"
				}
			]
		}
	]
}