			"dialogs": [
				{
					"id": 102030101,
					"content": "De hecho, Klee es la “Caballera Chispeante” dentro de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "¿Qué? ¿Klee es Caballera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Entonces, ¿Paimon también puede...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "¡Así es! ¡Paimon cree que es injusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Ahora que lo dices, tiene sentido que algo así sea un tesoro para alguien a quien llaman “Caballera Chispeante”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Así es. Aunque puede ser un dolor de cabeza para los Caballeros, nosotros nos preocupamos por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "En cuanto a su historia, verán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Seguramente la conocerás mejor más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Cuida de ella en el futuro, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "#Suena más poderoso que {F#“Caballera Honoraria”}{M#“Caballero Honorario”}.",
