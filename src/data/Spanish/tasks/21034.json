					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "Encontré esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Humm, parece el fragmento de una espada. Gracias. Me lo llevaré para examinarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "#Siempre se puede contar contigo, viajer{F#a}{M#o}. Aquí tienes la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340609,
