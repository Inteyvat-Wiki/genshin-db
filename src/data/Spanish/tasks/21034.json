				{
					"id": 210340401,
					"content": "¿Y bien? ¿Ya has terminado con tu parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "¿Y-ya los has derrotado a todos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "¿Eh? Pues claro que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Por algo soy la Maestra del Gremio de Aventureros de Liyue. Acabar con horas de monstruos es mi pan de cada día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
