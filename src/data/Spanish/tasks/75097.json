			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "¿O sea que no obtuviste el elemento Pyro al tocar la Estatua de Los Siete? Vaya, nunca nos había pasado algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "¿Habrá algún problema con esta estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "A lo mejor ha dejado de funcionar con los años.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Pero brilló cuando la tocaste, ¡Paimon lo vio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "Estatua de Los Siete, ¿no será que no has hecho tu trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "No tenemos ni una pista por la que empezar a investigar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "Tal vez las estatuas de Natlan sean especiales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Ahora que lo dices, ¿será una consecuencia de la presencia del Abismo en Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
