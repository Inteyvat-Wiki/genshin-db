			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "¿Eh? ¿No son un poco raras las Estatuas de Los Siete de Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Al tocar una estatua por primera vez, la sensación debería ser un poco más intensa, ¿no? Tendría que haber algo así como un “bzzz”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Yo creo que no hay nada raro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Humm, Paimon no sabe, a Paimon le sigue pareciendo un poco raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Humm, es que Paimon tiene la sensación de que, al tocar las estatuas en otras naciones, la conexión que se establece es más fuerte que la de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Es como si simplemente hubieras tocado un interruptor para encender la estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Otras veces, cuando tocas una estatua, puedes sentir el poder del elemento en cuestión, ¿verdad? ¿Y ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "¿Sientes la vitalidad y el fervor del elemento Pyro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Intento sentirlo, pero...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "¿Eh? ¿Nada de nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Esto es muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(No tengo ningún tipo de sensación ardiente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "#En realidad, otras veces fui yo {F#la}{M#el} que hizo ese “bzzz”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Aaaah, o sea que esta vez olvidaste hacerlo. Bueno, entonces a la próxima recuerda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "Espera, ¡no! ¡Ni que añadieras tus propios efectos de sonido cada vez que tocas una Estatua de Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
