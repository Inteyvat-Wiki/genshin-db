					"nextDialogs": [
						706720203
					],
					"speakerTitle": "Gordi"
				},
				{
					"id": 706720203,
					"content": "#¡{NICKNAME}, mira, es un pinzón gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720204,
					"content": "¡Yo no soy ningún pinzón! En todo caso, pinzona, y me llamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720205
					],
					"speakerTitle": "Gordi"
				},
				{
					"id": 706720205,
					"content": "Me llamo... Ay, ni yo misma me acuerdo, pero pueden llamarme Gordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720206
					],
					"speakerTitle": "Gordi"
				},
				{
					"id": 706720206,
					"content": "¿Gordi? A Paimon no le suena haberte visto por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720207,
					"content": "Sí, que esté en Mondstadt es una ocasión especial. En realidad, vengo de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720208
					],
					"speakerTitle": "Gordi"
				},
				{
					"id": 706720208,
					"content": "Oh, Paimon ya entiende... Pero, Gordi, si eres de Liyue, ¿por qué has venido a la taberna Cola de Gato de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720209,
						706720212
