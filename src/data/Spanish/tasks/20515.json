			"dialogs": [
				{
					"id": 205150401,
					"content": "Qué hábil es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150402
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150402,
					"content": "¿Por casualidad no habrás visto a una chica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150403
					]
				},
				{
					"id": 205150403,
					"content": "¿Te refieres a Anna? Sí, la vi pasar por aquí corriendo, pero tomó un desvío y la perdí de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150404
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150404,
					"content": "Pero, recuerdo que Anna estaba enferma todo el tiempo, y que de vez en cuando venía a la Catedral a ser atendida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150405,
					"content": "Con ese aspecto, ¿quién diría que está enferma? Tiene más energía que yo. Me pregunto qué habrá ocurrido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
