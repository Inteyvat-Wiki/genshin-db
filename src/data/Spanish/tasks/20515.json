				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150201,
					"content": "Ay, las hermanas siempre están tan alerta... ¡Casi me descubren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150202,
					"content": "¡Qué hábil eres!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "¿Cómo sabías que estaba aquí? Ni las monjas lograron descubrirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150204,
					"content": "Bueno, ya que me descubriste, tendré que bajar ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150205,
					"content": "No te preocupes. Solo vine a ver el paisaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
