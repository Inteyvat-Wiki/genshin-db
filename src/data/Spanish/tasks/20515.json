			"dialogs": [
				{
					"id": 205150301,
					"content": "¿Encontraste a Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150302,
					"content": "Está en la cima de la Catedral.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150303
					]
				},
				{
					"id": 205150303,
					"content": "¿En la cima? Con tantas monjas que hay por allí, ¿ninguna la vio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150304,
					"content": "No entiendo cómo lo consigue. ¿Será que tiene un talento innato para ser aventurera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150305,
					"content": "Iré yo a decirle que baje. Es mejor no molestar a las monjas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150306,
					"content": "Gracias. Acepta esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
