					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "¿Dónde estará Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "¿No encuentras a Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Busqué por toda la ciudad y no la encontré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "¿Podrías ayudarme? Yo estoy tan cansado que no puedo ni moverme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "Gracias. Confío en ti. Esta chica... Tan pronto como se encuentra mejor, empieza a hacer estas cosas... A este paso, el que se enfermará seré yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "¡Cierto! Anna me dijo que llevaba tiempo queriendo ir a la Catedral a agradecerle a las monjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Podrías ir primero a preguntar allá. Y, después, podrías preguntar a Albert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Suele estar cerca de la Catedral haciendo... Bueno, no sé, paseando o algo. Tal vez sepa algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Puede que incluso ya se haya convertido en una aventurera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "No, no, no. No puede ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "¿Por qué no dices nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051502,
			"completionStepIds": [
				2051502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
