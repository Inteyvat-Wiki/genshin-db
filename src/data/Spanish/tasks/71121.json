			"dialogs": [
				{
					"id": 711210201,
					"content": "¡Mil gracias! ¡Si no fuera por ustedes, habría perdido toda mi mercancía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711210202,
					"content": "Ahora no ando con mucho dinero pero, por favor, acepten esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711210203,
					"content": "¡Guau, no hacía falta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "¡Jaja! ¡Espero que algún día volvamos a vernos!",
