			"dialogs": [
				{
					"id": 711215101,
					"content": "#{F#Heroína}{M#Héroe}, por favor, ¡sálvame! ¡No soy de su banda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711215102,
					"content": "Entonces, ¿quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "¿Y-yo?... Ehm... pues... es una larga historia. Ellos robaron algo y mi amo me pidió que los registrara y los devolviera, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711215104,
					"content": "En fin, como ya ahuyentaste a los ladrones, he terminado con mi trabajo. ¡Yo me voy yendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711215105,
					"content": "¡Un momento...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "¡No te preocupes, ya nos volveremos a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Comerciante extraño"
				}
			]
