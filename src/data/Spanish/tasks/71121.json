			"dialogs": [
				{
					"id": 711210301,
					"content": "¡S-socorro...! ¡¿Eh?! ¡¿Son ustedes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711210302,
					"content": "¡¿Eres tú?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Jeje, qué coincidencia... ¡Bueno, sigan con lo suyo, yo tengo que irme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711210304,
					"content": "Te recomiendo que compruebes si dejaron algo de valor. Oh, no te preocupes por mí, lo añadiré todo al registro... Me encargaré de devolver todo lo que haya que devolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Comerciante extraño"
				},
				{
					"id": 711210305,
					"content": "¡Espera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "¡No te preocupes, ya nos volveremos a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Comerciante extraño"
				}
			]
