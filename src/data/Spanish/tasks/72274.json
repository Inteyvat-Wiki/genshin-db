				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soldado Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Nunca pensé que nuestros planes se filtrarían, ¡qué mala suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740202,
					"content": "¡Sí! Además, escuché que el maestro recibió órdenes de regresar a Snezhnaya, pero que los planes en la Isla Watatsumi debían continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740203,
					"content": "¿No crees que el maestro está actuando como si estuviera solo? No informó de esta operación a la Srta. Arlecchino, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740204,
					"content": "Es cierto. Esta fue su idea. ¿Sabes qué? Tengo un mal presentimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740205,
					"content": "¿Estás diciendo que, si fracasamos, el maestro va a echarnos la culpa a nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldado Fatui"
				}
			]
		}
	]
}