			"trigger": {
				"objectNames": [
					"Paimon",
					"Soldado Fatui",
					"Ronin - Anbu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Parece que este lugar tiene sus secretos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "¡Shh! Escucha, parece que alguien está hablando al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "*Tch*, nunca esperé que los labios de esa mujer estuvieran tan sellados. ¡No soltó ni una sola palabra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740102,
					"content": "No se preocupen, señores. Los interrogatorios son nuestra especialidad. Vayan a tomar un descanso. ¡Nos ocuparemos de esto en un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740103,
					"content": "No tenemos mucho tiempo. El maestro quiere que averigüemos cuánto sabe de nuestros planes, y quiere saberlo ya. ¡De lo contrario, estaremos en problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740104,
					"content": "Ay, qué carácter tan terrible. ¿Qué ha hecho esa mujer para que se enoje tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740105,
					"content": "Los últimos planes del maestro incluyen a una persona llamada Lyudochka como una pieza esencial. ¡Pero esta mujer de Los Ocelos se deshizo de ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740106,
					"content": "Afortunadamente, el fuego no se había extinguido cuando llegamos. El maestro, muy observador, identificó enseguida a Lyudochka por su ropa y se dio cuenta de que nuestros planes podrían estar en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740107,
					"content": "Uf, eso es terrible, pero al menos pudo controlar la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin - Anbu"
				},
				{
					"id": 722740108,
					"content": "Aun así, no sabemos cuánto sabe esta mujer sobre nuestros planes, o si ha informado a alguien más de Los Ocelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740109,
					"content": "Parece que alguien encerró a Momoyo en una celda subterránea. ¡Rápido, rescatémosla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7227402,
			"completionStepIds": [
				7227402
			],
