					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "#Oh, viajer{F#a}{M#o}. Las cosas no se ven bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Los Fatui concentraron sus fuerzas cerca del núcleo. Al parecer, descubrieron algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Espero que no tengan la intención de romper las defensas del núcleo... No, no podemos seguir demorándonos. Debemos avanzar ahora para iniciar las pruebas de funcionalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "¿Pruebas de funcionalidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Me refiero a probar las habilidades de purificación de nuestro amigo mecánico. No tengo intención de llevarlo a la fragua sin antes saber que funciona bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "Por favor, ayúdame a encontrar tres escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Me gustaría colocarlos alrededor de la Fragua Mikage. Lo que sucederá es que se contaminarán con la energía de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Entonces, podremos recuperarlos y usar este dispositivo de purificación para limpiarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Esa es la prueba que tengo en mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "¿Dónde puedo encontrar escaradiablos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Humm, recuerdo que suelen estar en zonas donde abunda el elemento Electro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "También oí que pueden sobrevivir cerca de la Fragua Mikage. Para ser tan pequeños, son muy resistentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "¿No puedo atraparlos directamente en la Fragua Mikage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Bueno, podrías hacerlo, pero en ese  caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Honestamente, no sé si podríamos confiar en mi maquinita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Al fin y al cabo, es mejor hacer las pruebas paso a paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "*Ejem*, bueno, ayúdame a encontrar tres escaradiablos, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Ya veo. ¡Con solo tres está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Podría entrar a la fragua a mirar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "#Bueno... Podrías utilizarte a ti mism{F#a}{M#o} como sujeto de prueba, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Pero como dije antes, la fiabilidad de este dispositivo puede no cumplir las expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Si llegara a ocurrir algún imprevisto durante el proceso de purificación, quizás nos topemos con una situación indeseable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "*Ejem*, limitémonos a usar los escaradiablos por ahora, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "¡Con solo tres bastará! Una vez que los hayas atrapado, tráemelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
