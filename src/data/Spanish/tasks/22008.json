						220080403
					]
				},
				{
					"id": 220080403,
					"content": "¡Tofu de almendras! Pero, ¿de verdad tengo que tomarme la medicina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080404,
					"content": "Hongdou, sé una buena chica, solo mejorarás si tomas tu medicamento. Además ¿eso que tiene no es tofu de almendras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080405,
