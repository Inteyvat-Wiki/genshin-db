				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Hongdou, sé una buena chica, solo mejorarás si tomas tu medicamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "¡No! ¡Sabe muy amargo! ¡No quiero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#¿Son viajer{F#as}{M#os}? Verán, Hongdou siempre está enferma. Le pedí al Dr. Baizhu que le preparara un medicamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Pero Hongdou se queja de que la medicina de la Farmacia Bubu es amarga y se niega a tomarla. *Suspira*, es medicina, se supone que debe ser amarga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Para que aceptara tomarla, le dije que al terminarla le daría tofu de almendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Si tienes tiempo, ¿podrías ayudarme a buscar un poco? Yo tengo que quedarme a lidiar con Hongdou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Muchas gracias, una ración es más que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "¿Qué tiene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*Suspira*, yo tampoco sé, pero el Dr. Baizhu dice que es difícil de curar. Y aunque solo sea para calmar los síntomas, tiene que tomar la medicina todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Quizás tenga que tomar medicamentos toda su vida. Es tan pequeña... Ni quiero pensarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Preferiría ser yo la enferma, pero si puedo hacer que Hongdou sufra un poco menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "#Viajer{F#a}{M#o}, te lo pido, tráeme un poco de tofu de almendras. Una ración será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Hongdou, ¿por qué no tomas tu medicina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "¡Sabe muy amarga! La medicina que toma Lulu no sabe tan mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Hongdou... Lulu y los demás estaban jugando. No estaban tomando medicina, estaban tomando jarabe de tofu de almendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Entonces, ¿si como tofu de almendras me pondré bien? ¿De verdad tengo que tomar medicina amarga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Hongdou, se buena chica, si mejoras, podrás comer todo lo que quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "¿Por qué la medicina no puede ser dulce como el tofu de almendras? De verdad lo odio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "#En serio... *Suspira*, viajer{F#a}{M#o}, perdona las molestias, ¿puedes ayudarme a encontrar tofu de almendras? Con una ración bastará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
