			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Tal y como imaginaba, no era más que otro hombre patético obsesionado con su pasado que no dejó de repetir los mismos errores. Qué decepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150302,
					"content": "Se contuvo de obrar el mal durante tanto tiempo, y al final... ¿O acaso era malvado de forma innata y los malos nunca cambian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "Es más difícil hacer el bien que el mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Siempre tuvo opciones. Incluso ahora pudo optar por admitir sus errores y arrepentirse. Pero volvió a equivocarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150306,
					"content": "Cada movimiento en falso lo llevó a esta partida perdida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150307,
					"content": "#Bueno, dejemos el tema. Al menos hemos terminado otro trabajo. La prueba del objetivo se la puedes entregar tú a Leszek como acordamos, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150308,
					"content": "#¡Con la jefa Néfer y {NICKNAME} en acción, no hay nada que se les resista! Esto ha sido como estar de vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Jaja, ya que tu descanso ha terminado, ¿no crees que es momento de empezar el siguiente trabajo, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150310,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Tomó la decisión equivocada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}