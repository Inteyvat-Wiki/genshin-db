				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "... Yo no tengo nada que ver con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Parece que sabes muy bien por qué estamos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150203,
					"content": "Todo eso quedó en el pasado. Ahora solo quiero vivir en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "¿Cómo? ¿Robando las identidades ajenas? Primero lo intentaste con Juhani y, al no lograrlo, ahora con Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150205,
					"content": "Una pésima actuación acaba siendo descubierta tarde o temprano. Pero ya no habrá más víctimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761150206,
					"content": "¿A Juhani? ¿Estás diciendo que se la robé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "No era suya... ¿Por qué debería serlo? ¿Solo porque era más simpático y elocuente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "¡Éramos iguales!... ¡Lo que él me quitó siempre fue mío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "¿Y el Sr. Derwent y el comerciante ambulante? ¿Qué te hicieron ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "¿Ellos? Hicieron preguntas que no debían, igual que ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Ahora... ¡les ha llegado la hora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
