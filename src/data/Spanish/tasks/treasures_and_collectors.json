			"dialogs": [
				{
					"id": 750090601,
					"content": "¿Cuántas cosas encontraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} encontró esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Déjame ver... Hay muchas reliquias de este tipo, pero esta no es fácil de encontrar. Y está muy bien conservada, las vetas de flogisto son muy claras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "Humm... ¿Me la ofrecerían por diez mil Moras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "¡¿Qué?! ¿Acaso hemos encontrado una reliquia valiosa de las de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#¡Paimon sabía que {REALNAME[ID(2)|SHOWHOST(true)]} era increíble y nos traería suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "Te equivocas, esta cosa no es tan valiosa como crees. En mi opinión, el valor estimado por la Asociación de Arqueología Sáurica sería de unos cinco mil Moras como máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Paimon no se dejará llevar por tus palabras. Si solo vale cinco mil Moras, ¿por qué estarías dispuesta a dar diez mil por ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "Porque me encantan sus vetas únicas. Aunque no es nada valioso a ojos de los demás, yo daría dinero extra por conseguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Se puede decir que es una manía que tengo o que es la naturaleza de un coleccionista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Humm... Si es así, Paimon lo comprende. Además, en comparación con los trescientos Moras que pagamos por la entrada, diez mil Moras son mucho más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "Entonces, ¿vamos a cambiarlo por diez mil Moras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "Gruuu... Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#Parece que {REALNAME[ID(2)|SHOWHOST(true)]} no quiere... ¿Quieres quedártela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "#Al fin y al cabo, la encontró {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#Ya que {REALNAME[ID(2)|SHOWHOST(true)]} no quiere, nos la quedaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#Veo que valoran más la opinión de {REALNAME[ID(2)|SHOWHOST(true)]} que el Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "#Por supuesto, {REALNAME[ID(2)|SHOWHOST(true)]} es nuestro compañero. Pero, si encontramos algo similar en el futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Gracias, pero el entusiasmo de un coleccionista es algo efímero, va y viene. Quizá en el futuro me obsesione con otra cosa, aunque no sabría decirte con qué exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
