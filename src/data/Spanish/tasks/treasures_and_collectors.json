			"dialogs": [
				{
					"id": 750090101,
					"content": "Trescientos Moras por la entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090102,
					"content": "¿Hay algún descuento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "Es el precio establecido por la Asociación de Arqueología Sáurica, y no es negociable. Que yo sepa, este es el lugar de excavación más barato de la zona, ya que es el más antiguo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090106,
					"content": "Sin embargo, a veces también llegan soñadores como ustedes que quieren probar suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090107,
					"content": "Puede que ninguno de los miles de visitantes tuviera buen ojo para los tesoros y que todos ellos pasaran por alto alguna reliquia de los saurios que parecía común, pero que en realidad es valiosísima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090108,
					"content": "Hay mucha gente que gastaría 300 Moras por soñar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090109,
					"content": "#Así que ¿confías en que serás {F#la}{M#el} afortunad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090110,
					"content": "Gruuu... ¡Grrr! ¡Grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Confío en mi suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, ¿quieres probar suerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Parece que estás muy interesado. Bueeeno, Paimon pagará los trescientos Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "¡A Paimon le parece que sale muy rentable poder comprar tres rayos de esperanza por trescientos Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "¡Qué tengan éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090112,
					"content": "Tengo a mi saurín de la suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "Si consigo derribarte será gratis, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "Ey, ¡no funciona así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
