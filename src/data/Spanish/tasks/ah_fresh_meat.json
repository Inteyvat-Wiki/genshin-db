			"dialogs": [
				{
					"id": 701060401,
					"content": "Sobre la carne del Rey Jabalí de las Nieves que querías...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "Ah, te las arreglaste para conseguir algo de carne del Rey Jabalí de las Nieves, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060403
					],
					"speakerTitle": "Harris"
				},
				{
