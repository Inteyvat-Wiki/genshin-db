			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Solo unos ingredientes más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "#Ah, eres tú, viajer{F#a}{M#o}. Solo estoy agregando los toques finales a una receta antigua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "No hace mucho, un equipo de exploradores hizo una expedición a las montañas. Uno de ellos es un amigo mío, un aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "No llegaron muy lejos debido a las malas condiciones climáticas, pero mi amigo me dijo que encontraron unas antiguas ruinas mientras se refugiaban de la tormenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Estaban llenas de libros y otros registros. Incluso... incluso una receta. No sé cómo ha sobrevivido intacta durante tanto tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Mi amigo aventurero me pasó la receta con la esperanza de que yo pudiera revivir el sabor del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "De hecho, nunca he oído hablar de algunos de los ingredientes que se requieren. Incluso algunas de las técnicas de cocina son nuevas para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Entonces, estoy cocinando una versión modificada que solo usa los ingredientes más esenciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "#¿Estarías dispuest{F#a}{M#o} a ayudarme a reunir algunos de los ingredientes inusuales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "¡Yo me hago cargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "#Encantado de ver que estás tan entusiasmad{F#a}{M#o} como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Escuché que algunos jabalíes se perdieron en las montañas y se congelaron... Tengo curiosidad por saber cómo afecta al sabor de la carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Entonces, tal vez podrías traerme diez trozos de carne congelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "¿Carne congelada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Sí, es como llamo a la carne de esos jabalíes congelados. Estar cubiertos de hielo debe mantenerlos bastante frescos, ¿no crees? Cuando alguien me habla de un pobre jabalí helado, yo lo que escucho es “carne congelada”... ¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Gracias por hacer esto por mí. Ven a verme cuando tengas los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "¿Qué ingredientes necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
		{
