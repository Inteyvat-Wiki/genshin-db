			"dialogs": [
				{
					"id": 701060201,
					"content": "Aquí tienes tu carne congelada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Vaya, esta carne congelada se ve muy bien... Ahora solo me queda un ingrediente más por encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "¿Has oído hablar del Rey Jabalí de las Nieves? La gente dice que es una feroz bestia que habita en lo profundo de las montañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Y según la receta, su exquisita carne se adapta muy bien a cualquier método de cocción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme con este encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Es una pregunta osada, pero ¿qué gano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "No te preocupes, tengo algo en reserva para dártelo a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
