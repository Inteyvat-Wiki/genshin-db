			"dialogs": [
				{
					"id": 250270901,
					"content": "Podrías tratar de recopilar más muestras de sonidos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "¿Muestras de sonidos? Humm... ¿Te refieres a que debería incluir sonidos de la naturaleza en mis canciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Humm... No me parece mala idea. ¡Es estupenda! ¿Ves? Yo sabía que tú eras alguien inteligente y perspicaz. ¡Vamos, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Espera, ¿te vas con las manos vacías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Pues claro. ¿Qué esperas? ¿Que aparezca en mitad de la naturaleza con un gramófono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "No te preocupes, solo vamos a comprobar que realmente podemos usar esos sonidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Por ejemplo, el sonido de un pato agitando sus alas, el de un Koholasaurio moviéndose en al agua, el de los pasos de un Tepetlisaurio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Una vez hayamos confirmado cuáles son nuestros objetivos, prepararé todo lo necesario para tomar esas muestras. Pero ese paso viene después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Ahora mismo no tenemos tiempo que perder. ¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
