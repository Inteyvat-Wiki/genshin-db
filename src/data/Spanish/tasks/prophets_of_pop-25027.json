				{
					"id": 250270501,
					"content": "¿Qué tal ha ido? ¿Te han dado alguna retroalimentación que nos pueda servir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "Esto es lo que me han contado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Le cuentas a Milu Nui la opinión de sus oyentes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "A-ah... ¿Eso han dicho? Gracias, aprecio mucho sus comentarios. Parece que tengo que hacer ciertos ajustes en mi música...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Pero, a juzgar por lo que me cuentas, ¡todo el mundo califica mis canciones como música infantil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "No puede ser... Tengo que cambiar muchas cosas... ¿Por dónde podría empezar?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
