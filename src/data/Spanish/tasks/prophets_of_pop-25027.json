				"objectNames": [
					"Mahina Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "¡El Sr. Milu ha lanzando una nueva canción! Humm, ¿qué hago? ¿La compro o no?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "¿Qué te parece la música de Milu Nui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "¿Eh? ¡Pues me parece genial! Haloa y la bebé sauria la adoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Cada vez que se ponen revoltosas y se niegan a mimir, les pongo la canción «Oda a la primavera» del Sr. Milu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "En cuanto la escuchan, se quedan dormidas en un santiamén. Además, duermen como un tronco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "*Suspira*, pero últimamente Haloa me ha estado diciendo que le gustaría escuchar algo más... intenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Si el Sr. Milu creara una canción más alegre, sería estupendo. ¡Seguro que a Haloa le haría mucha ilusión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
