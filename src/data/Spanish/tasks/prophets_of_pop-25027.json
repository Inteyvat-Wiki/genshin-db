			},
			"dialogs": [
				{
					"id": 250270401,
					"content": "¡Mira esas aves de ahí! Su sonido quizá... podría servirnos como material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Pero quedaría incompleto si usáramos el sonido de solo unos cuantos. Necesitaríamos recoger el sonido de una bandada entera para que quedara mejor el resultado final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Un momento, ¿ese animal de ahí delante no es un Koholasaurio? ¿Llegas a oír cómo araña la piedra con sus garras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Es muy asustadizo, será mejor que no nos acerquemos demasiado. Invitaré a algunos especialistas para que me acompañen a recopilar material. Seguro que ellos pueden encargarse de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Parece que esos guerreros de la tribu están compitiendo entre ellos. No está mal, los sonidos de un combate me parecen bonitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "¡EH! ¡¿Quiénes son esos de ahí?! ¡¿Qué están haciendo?! ¡¿Acaso buscan pelea?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Guerrero Tribal irascible"
				},
				{
					"id": 250270407,
					"content": "Estamos... recogiendo material...",
					"roleType": "TALK_ROLE_NPC",
