			"trigger": {
				"objectNames": [
					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "¡Guau, un nuevo vinilo! ¡A los bebés saurio les va a encantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "¿Qué te parece la música de Milu Nui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Me encantan las canciones del tío Milu. ¡Y a nuestra bebé sauria le gustan aún más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Cuando se porta mal, mamá le pone sus canciones, y de un momento a otro, ¡se porta como una angelita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Humm... Pero he de decir que sus canciones se me hacen muy largas. Apenas me acuerdo de las letras, así que no se la puedo cantar a la bebé sauria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Jeje, ojalá pudiera componer algunas canciones con letras más cortas. ¡Así podría cantárselas todos los días a la pequeña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
