				},
				{
					"id": 250270703,
					"content": "Pero siempre tengo la sensación de que se muestran demasiado amables cuando les pregunto por lo que piensan. No creo que los comentarios que me hagan sean totalmente sinceros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270704
					],
					"speakerTitle": "Milu Nui"
				},
				{
