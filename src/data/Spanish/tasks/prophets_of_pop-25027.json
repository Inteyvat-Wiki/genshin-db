			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "*Suspira*, desde luego que es imposible comunicarse con Pakaa... ¡No hay forma de que entienda mis ideales musicales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "¿Qué ha pasado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#¿Eh? ¿Eres {F#una viajera}{M#un viajero}? Hola, soy Milu Nui y me dedico a la música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "Si has visitado alguna vez Vinilos Xochicuicatl, seguramente hayas visto algunos de mis vinilos en la sección de pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Esos vinilos reflejan a la perfección lo que es para mí el pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Es solo que ese tipo de Pakaa no es capaz de comprender mis ideas, y no deja de repetir que mis temas le parecen canciones infantiles más que canciones de pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "Y diga lo que yo diga, ¡él siempre acaba colocando mis vinilos en la sección de música infantil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "Y sí, sé que a los niños les gustan mis canciones, y que algunos padres regalan mis vinilos a sus hijos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "¡P-pero los niños tienen un oído más agudo! Además, hay montones de niños en la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Así que, si mi música es tan popular entre los niños, ¡creo que debería ser parte de la sección de pop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Lo que dices tiene todo el sentido del mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "¡¿A que tengo razón?! *Tch*, ya sabía yo que el ignorante era Pakaa. En cuanto acabe de componer esta canción nueva, ¡no tendrá más remedio que admitir que yo estoy en lo cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "#No me fío nada de su gusto musical... En fin, viajer{F#a}{M#o}, ¿tú tienes conocimientos musicales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Eh... ¿Musicales, dices?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "¿Sabes tocar algún instrumento? También bastaría con que supieras cantar... o tararear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Digamos que puedo hacer un poco de todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "¡Eso es magnífico! ¡Seguro que tú sí entiendes mis ideales sobre la música!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "Eres la persona que necesito para que me ayude a componer mi nueva canción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "No te preocupes, tengo una recompensa preparada para ti a cambio de tus servicios. No permitiría que hicieras nada gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "Está bien. Solo guíate de tu intuición y dime cuál es el primer paso que debería seguir para componer mi nueva obra maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Sinceramente, no tengo ni idea de música.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "¡¿Qué más da?! Estoy convencido de que alguien como tú es capaz de admirar la música de corazón. Seguro que tu criterio sería mucho más imparcial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "Podría considerarse pop infantil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "¿Y cuáles son esos ideales de los que hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
