					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "No, ¡no! Esa no sería la mejor opción para empezar. Deberíamos optar por algo más simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271305,
					"content": "Tampoco es para tanto.",
