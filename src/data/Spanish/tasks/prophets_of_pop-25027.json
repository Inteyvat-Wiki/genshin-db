				},
				{
					"id": 250271302,
					"content": "Por lo que veo, tu especialidad es persuadir a los tipos más irascibles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271303,
						250271305
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271303,
					"content": "Aún no has visto todo lo que soy capaz de hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271304
					]
				},
				{
					"id": 250271304,
					"content": "No me cabe duda. Cualquiera podría percibirlo... en todos los aspectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "El proceso ha sido un tanto engorroso, pero al final he conseguido encontrar muchos sonidos que podrían serme útiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Solo tengo que preparar unas cuantas cosas, y enseguida podré comenzar a grabar los sonidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
