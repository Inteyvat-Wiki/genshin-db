				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Samurái Kairagi",
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "¡Arg! ¡P-por favor, te ruego que me perdones! ¿De dónde sacaste este tipo de ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040207,
					"content": "¡Villano asqueroso! ¡Entrégame el arma en este instante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Así que sigues aferrado a esa arma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040209,
					"content": "Solo vine a recuperarla. Si me dices en dónde está, te dejaré ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040211,
					"content": "No desperdicies tus palabras con él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "¡N-no, por favor! ¡Deténganse! No dije que no diría nada, calmémonos todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040214,
					"content": "E-el arma la tomó nuestro jefe como parte de su colección. ¡Si la quieres, puedes ir por ella al campamento de allá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040215,
					"content": "¡Hum! Al menos entiendes razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "S-se los pido, ya se los dije...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040217,
					"content": "¡Apártate de mi vista!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "¡A la orden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "Samurái Kairagi"
				},
				{
					"id": 728040219,
					"content": "No tiene madera de guerrero, ¡pero sí que sabe correr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Sin mencionar que es un soplón...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Los Kairagi son una banda compuesta de todo tipo de bandidos, donde cada uno busca su beneficio propio. La lealtad o la convicción no tienen cabida aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Están dispuestos a abandonar el barco a la primera señal de peligro. Es muy común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Afortunadamente, contaba contigo. Dudo que se hubiera rendido de otra manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Sin embargo, nuestra próxima parada es su campamento principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Seguiremos con el plan original. Yo someteré al líder, tú hazte cargo de los peces pequeños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "Puedo contra diez de ellos, ¡no te preocupes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Vamos, busquemos a alguien más...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Samurái Kairagi líder"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "¿Tú? Jajaja, eres el mocoso de antes, ¿cierto? ¿Viniste a añadir una pieza más a mi colección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040302,
					"content": "No, ¡vine a reclamar mi arma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "#¡Ja! Admito que tienes agallas. Pero solo trajiste {F#una aliada}{M#un aliado}, ¿es en serio? ¿Me tomas el pelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040304,
					"content": "Te diré una cosa, te daré una oportunidad por tu acto de valentía. ¡Vamos! Ajustemos las cuentas en otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040305,
					"content": "Sin embargo, no sería bueno dejar a mis muchachos aquí sin nada que hacer, ¿no crees? ¡Lo tengo! ¿Por qué no le pides a tu asistente que juegue con ellos de mientras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040306,
					"content": "#Cuando quieran, estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "#Jajaja, ¡tienes labia! Bien, muchachos, ya lo oyeron. ¡A {F#ella}{M#él}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040309,
					"content": "En cuanto a ti, vayamos a otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040310,
					"content": "Lo dejo en tus manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Tienes mi más sincero agradecimiento. Acabaré con él rápido, y vendré a tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Cuánto te gusta hablar. ¡Vamos, inténtalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Samurái Kairagi líder"
				},
				{
					"id": 728040307,
					"content": "Espero que estén a mi nivel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "A juzgar por tu respiración tranquila, asumo que los Kairagi no fueron rival para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Tú también saliste victorioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Así fue. Aunque debo admitir que, para vergüenza mía, dejé que se escapara con solo una estocada de mi espada debido a uno de sus trucos sucios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Sin embargo, la herida fue profunda. No creo que se atreva a dar problemas en el futuro cercano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Y lo más importante es que lo derroté yo mismo y reclamé mi arma. Por lo tanto, he limpiado la mancha de la humillación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Felicidades, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "¡Ciertamente! Te lo agradezco, pero aún no puedo descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "La razón detrás de todo este incidente es mi falta de entrenamiento. Seguiré practicando duro y perfeccionando mis habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Por lo tanto, ¡cuento contigo en el futuro para practicar conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Por cierto, acepta esto como muestra de mi agradecimiento. No es mucho, pero espero que puedas aceptarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "De nuevo, ¡gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}