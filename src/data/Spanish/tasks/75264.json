				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Se equivocaron de persona... Mi maestro es Kanei, y yo soy Zhaka. Deberían ir a buscarlo a él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "No puedo hacer un muñeco de esos que hace mi maestro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "¿Te han raptado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "¿Eh? ¿No están de su lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "¡Claro que no! ¿No lo viste? ¡Les dimos una buena paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "¿De verdad? ¡Qué bien! ¡Por fin soy libre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Claro que sí. Ahora puedes irte a casa. Pero antes de que te vayas, ¿te importaría contarnos qué es lo que está pasando aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "No sé de dónde salieron esos tipos que quieren vender muñecos falsificados en el resort... Pero como no tienen talento para ello, intentaron secuestrar a mi maestro, Kanei, para que los ayudara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Pero algo les salió mal y no sé por qué me raptaron a mí. Solo llevo tres días aprendiendo de mi maestro. Es imposible que cumpla con los estándares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "En fin, ¡muchísimas gracias por salvarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, ¡vamos pa’ casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
	]
