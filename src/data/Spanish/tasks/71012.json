			},
			"dialogs": [
				{
					"id": 710122401,
					"content": "¿De dónde salió esa cosa? ¡No lo entiendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "¿Cómo la invocaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Pues...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "¡Ah! ¡Con “el tiempo y el viento”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Entonces, hay otro reloj de sol idéntico a este en esa isla, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "¿Y el método para resolver su acertijo también es el mismo? Entonces, debe haber algún vínculo entre estos dos relojes de sol y los lugares donde se encuentran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Tengo que encontrar la forma de llegar a esa isla. ¡Y tiene que ser rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "#Gracias, viajer{F#a}{M#o}. Una vez que haya hecho algunos preparativos, te buscaré y visitaremos juntos esa isla deshabitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
