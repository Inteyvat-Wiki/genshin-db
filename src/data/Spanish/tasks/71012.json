			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "El tiempo y el viento... ¿Qué descubriría él aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "¿El tiempo y el viento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Sí, es algo que mencionó mi amigo en una carta que me escribió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Dijo que en “el tiempo y el viento” se esconde un secreto de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Sin embargo, yo nunca antes había oído esa expresión. ¿De dónde se la sacó ese tipo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "¿Estudiaste en Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Sí. Aunque soy de Mondstadt, siempre he estudiado en la Academia de Sumeru. Probablemente he pasado más tiempo allí que en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "¿Quieres saber más sobre la Academia? Bueno, no hay ningún secreto al respecto. Humm, veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Los de la Academia simplemente son... un montón de gente extraña. Espera, eso es muy poco cortés. Son gente que no te dejará indiferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "#Si en un futuro puedes ir, deberías verlo por ti mism{F#a}{M#o}. Pero nada más, ¿de acuerdo? Será mejor que no te quedes mucho tiempo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
