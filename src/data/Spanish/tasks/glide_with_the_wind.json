				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Funciona magníficamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Sigo dejándome llevar y termino volando demasiado alto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#¡Hola, {NICKNAME}! ¡Te he estado buscando por todas partes! ¿Cómo te va con el planeador que te di la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "¡Parece que te está comenzando a gustar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Pero bueno, no tienes una licencia de vuelo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "¿Licencia de vuelo? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "¿No es obvio? Tienes que tener una licencia de vuelo para volar legalmente en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Oh... {NICKNAME} ha estado volando por siglos, ¡esta es la primera vez que escuchamos algo semejante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Sí, has estado volando por todos lados... ¡Todo el mundo te ha visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "¡Jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "#Entonces... ¿Viniste a buscarnos porque quieres darle a {NICKNAME} una licencia de vuelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "¡De ninguna manera! Los Caballeros de Favonius tenemos reglas estrictas para este tipo de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "Necesitas pasar una prueba, y luego los Caballeros emitirán tu licencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#¡Hoy estoy aquí como examinadora para supervisar la prueba de vuelo oficial de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Yo fui quien te dio tu planeador, así que esta es mi responsabilidad. Eso es lo que diría la Gran Maestra Intendente Jean, estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "... ¿Tal vez puedas echarme una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "Está bien. Puedo hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "¡Una prueba! Qué engorroso. Por otra parte, ya que Amber es la examinadora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "¡No con mayúsculas, N-O! ¡No desafíes la autoridad de Amber la Examinadora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#¡Estoy segura de que {NICKNAME} pasará sin problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Es solo una prueba rápida de tu habilidad de volar. Toda la ciudad observó cómo volaste detrás de Stormterror ese día, ¡no tendrás ningún problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Pero necesitamos respetar las reglas y volar adecuadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "#Toma este manual de vuelo. No necesitas memorizarlo, pero sí debes estar familiarizad{F#a}{M#o} con todo lo que contiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Por ejemplo, solo una persona puede usar el planeador a la vez, no puedes llevar nada por encima del límite de peso, no puedes despegar usando un Slime Anemo, y así sucesivamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "En resumen, léelo. Yo también tuve que leer un montón de libros enormes cuando Lisa me enseñaba magia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Guau, ese es un libro viejo y grande... ¡Será mejor que comiences pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Bueno. Ven a buscarme cuando hayas terminado. Estaré en Levantaviento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "El manual de vuelo de los Caballeros de Favonius no parece muy entretenido de leer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Bueno, supongo que es mejor que empiece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Parece un cuento de hadas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "La gente en Mondstadt realmente entiende de romance al aprender a volar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Es una historia genial pero... ¿De verdad el manual de vuelo de los Caballeros está escrito en este estilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "En fin, vamos a buscar a Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}