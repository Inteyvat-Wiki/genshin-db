						],
						"pointId": 322100714
					}
				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Hoy salí al mar y no me di cuenta de que había perdido la red, con lo grande que era... Pero bueno, no importa, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Yo también metí la pata en el trabajo, pero ahora que lo pienso, dejar que unos bandidos huyeran tampoco es ningún drama, jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "¡Oigan, ustedes dos! Murasaki y Shion están enfermas, ¡y es por culpa de sus pesadillas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Vaaaya... Alguien se ha levantado hoy con el pie izquierdo. Qué graciosa, jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Ya te digo, jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "¡Esos dos están actuando de forma muy extraña! Paimon les habló con tono agresivo, pero no se enfadaron ni lo más mínimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "... Disculpen, caballeros. ¿Recuerdan haber ido anoche al Balneario Aisa para una terapia de regulación onírica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "No sé, ¿tú te acuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "A mí me da que no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Humm... ¿Recuerdan haber tenido pesadillas recientemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "No, ¿por qué iba a tenerlas? ¿Qué hay en el mundo tan malo como para darme pesadillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Pues... No, no se me ocurre nada. ¿Cómo puede alguien normal tener pesadillas? Con lo bonita que es la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "¿Qué está pasando? Parece que no recuerdan nada de lo que ocurrió anoche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Aunque dado su estado actual, Paimon se cree lo que dicen. No parecen muy atormentados por sus pesadillas... Entonces, ¿la orientación de ese tal Emura Ichigensai funciona de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#No. Claramente no están en sus cabales... {NICKNAME}, Paimon, no se distraigan. Voy a hacer algo poco ortodoxo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "¿Acaso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "He entrado en sus subconscientes y he descubierto que ambos se han disociado de los mismos. Esto me permite su acceso de forma parecida a como entro en los sueños de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "¡Noooo! ¡Malditos bastardos! ¡No dejaré que se salgan con la suya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida furioso"
				},
				{
					"id": 120460321,
					"content": "El mar está revuelto hoy. Debería quedarme en tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko asustado"
				},
				{
					"id": 120460322,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Como pueden ver, sus preocupaciones no han desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Este tal Susukida debe de ser muy impulsivo e irascible, lo que le haría actuar de forma muy inusual y le afectaría profundamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "En cuanto a este hombre, Umihiko, es posible que haya sobrevivido a una gran catástrofe y no quisiera salir al mar debido al miedo a las olas. Me temo que eso afectó en gran medida a su forma de vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Sus emociones negativas fueron aisladas de su mente y vagaron por su subconsciente. Por eso, lo único que parecen sentir es “felicidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Sin embargo, esas emociones reprimidas continuaban en su subconsciente. Al final, se convirtieron en una pesadilla que Murasaki y Shion no pudieron digerir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "¿Y eso por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "Me temo que el caso de Emura Ichigensai no es tan sencillo como imaginábamos. Tal vez realmente tenga el poder de influir en las emociones de la gente, por eso nadie lo ha visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "¿Notaron algo extraño cuando vinieron ayer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Estos dos se portaron bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Si tuviera que decir algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Recuerdas el extraño sueño de ayer y se lo describes a Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "¿De verdad te ha ocurrido eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "No le di demasiada importancia en el momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "No será que... ¡Tenemos que encontrar a Emura Ichigensai cuanto antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "¿Eh? Mizuki, ¿qué ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "Ahora puedo confirmar que ese tal Emura Ichigensai no es un humano corriente. Aquellos que recibieron su “orientación” han sido sus víctimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Si no lo encontramos y detenemos cuanto antes, sus víctimas podrían sufrir daños mentales irreversibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "¡Por Los Siete! Entonces, solo podemos seguir presionando a estos dos. Disculpen, ¿saben cuándo vendrá Emura Ichigensai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "¿A qué viene tanta prisa de repente? ¿Qué más da cuándo venga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Ya vendrá cuando quiera. No nos estresemos, jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "¡Argg! ¡Qué molesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "Ambos recuerdan lo que pasó anoche, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Es solo que no quieren hablar de ello porque no saben cómo conciliar una pesadilla con la felicidad que sienten ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Cuando piensan en ello, sienten una disociación indescriptible, como si desgarrara su mente. ¿Me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "... No sigas, por favor. Si no pensamos en ello, no pasa nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "Esta es la letra pequeña de la terapia de Emura Ichigensai, pero no se preocupen, no he venido a sacarlos de su engaño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "... Siempre y cuando respondan como es debido a lo que les preguntamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Está bien... pero de verdad que no lo sabemos. Ya le preguntamos, y nos dijo que hoy no iba a venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Sí, parece que la sesión de ayer lo dejó exhausto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "¿Me está intentando evitar de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "¿Es que no pueden decirnos nada útil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "¿Tienen idea de dónde vive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "No. Preguntamos ayer, pero ni la persona que estaba en la puerta lo sabía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "En ese caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "¿Has encontrado lo que buscabas, Mizuki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Sí. Ahora que comprendo la causa de las pesadillas de esos dos, puedo aplicarles el tratamiento adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "No hay tiempo que perder. Yo me ocupo de Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "#Ya han hecho suficiente con traerme aquí. No puedo seguir molestándol{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "No olvides que queremos reservar otra sesión contigo. Cuanto antes resolvamos este asunto, antes podremos volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "Así que ¡no vamos a parar hasta que este asunto quede zanjado y el Balneario Aisa vuelva a la normalidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "... Parece que no voy a tener más remedio que aceptar su ayuda una vez más. Debo asegurarme de que Murasaki y Shion reciban el tratamiento que necesitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Sin embargo, tengo algo que pedirles. Si encuentran a Emura Ichigensai, por favor, no le hagan nada. Tan solo mándenme un mensaje y vigílenlo hasta que llegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "#Ponerl{F#a}{M#o}s en peligro es lo último que quiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Ah, no te preocupes por eso. Tendrías que ver a todos los enemigos a los que nos hemos enfrentado. ¡Este tipo es un chiste en comparación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "¿Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "Está bien. Te avisaremos antes de hacer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Muy bien. Entonces, manos a la obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "Lo hiciste para que Mizuki no tuviera que ocuparse de eso, ¿verdad? Pero... ¿y ahora qué? ¿Qué pasará si no encontramos al tipo ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Porque estos dos... Da igual lo que les preguntemos, ¡no sirven para nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Sí, no tienen ni idea de nada. Quizás Miko sabe algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "¿Miko? Espera, ahora que lo dices, ¡fue ella la que nos dio la pista de este lugar! Seguro que sabe mucho más de lo que nos ha contado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "¡Rápido! ¡Vamos al Gran Santuario Narukami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Sospecho que Miko sabe algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Muy bien, yo me encargaré de encontrar a Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "¿Vas a poder ayudar a Murasaki y Shion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204604",
							"2"
						],
						"stepId": 1204604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "Suele estar por aquí, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "¿Han venido por un palillo de la fortuna o es que están de visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "¡Aaah! ¿Pero de dónde...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Cuánto tiempo, Suma Sacerdotisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "#Tu forma de hablar me recuerda a una vieja amiga... Pero cortesías aparte, ¿qué l{F#a}{M#o}s trae por aquí? Parecen bastante apurad{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Queremos localizar a una persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "Con la pista tan obvia que les di ayer, ¿aún no han sido capaces de dar con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "¡Ajá! ¡Así que lo dijiste a propósito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "... En fin. Ya que vinieron a pedirme ayuda, ¿por qué no me ponen al día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "Bueno. Pues ayer fuimos a la localización que nos dijiste, pero no tuvimos oportunidad de verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Lo siguiente que oímos fue que ya no atendía a pacientes allí. Al parecer, le encanta la paz y la soledad... Así que, obviamente, no tenemos ni idea de por dónde empezar a buscar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*Suspira*... Con lo que me costó encontrar la ubicación que les dije...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Paimon no sabe si esto es de ayuda, pero ayer nos enteramos de más cosas sobre él. Por ejemplo, un tipo que coincidía con la descripción de Emura Ichigensai acudió una vez a terapia con Mizuki, solo que su nombre era “Emura Chuuya”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "¿Cómo? ¿Emura Chuuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "¿Lo conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Una vez pedí a la Editorial Yae que organizara un evento de la columna de cartas de los lectores, con la esperanza de conocer gente y charlar de cosas interesantes, pero aquel señor tenía otra idea en mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "#De todos modos, el tipo que conocí era bastante problemático. ¿Están segur{F#a}{M#o}s de que es el mismo tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Nuestra investigación apunta a que es una posibilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Entiendo. En ese caso... pueden probar a visitar esta dirección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Esta dirección... ¿De verdad es un lugar donde pueda vivir alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "Una vez, pidió varias docenas de novelas de la Editorial Yae y dejó esta dirección de entrega tras decir que solo pagaría contra reembolso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "El almacén pensó que se trataba de una broma y rechazó el pedido. Al final, nos acabó diciendo de todo en una de sus cartas de los lectores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Ahora que lo pienso, solo alguien con esa personalidad podría vivir en un lugar como ese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Razón no te falta... ¡Venir a verte fue la decisión acertada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Me alegro de poder ayudar a una vieja amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Entonces, ¿quieres ayudarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "Sé lo mucho que ha invertido en su negocio. Ahora que el Balneario Aisa está en apuros, como amiga suya que soy, es natural que me preocupe y le quiera echar una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "A juzgar por tu expresión de ayer, Paimon pensó que estabas discutiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Voy a suponer que Mizuki les ha contado que somos rivales, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Ella siempre lo ha visto así, incluso cuando éramos compañeras de clase. Ahora que soy la Suma Sacerdotisa del Gran Santuario Narukami, debe sentir la necesidad de probar su valía con su negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "Me gustaría ser considerada con sus sentimientos, para que no sienta que estoy resolviendo por ella este tipo de problemas empresariales de vida o muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "Es raro verte mostrar tanta consideración por alguien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Me lo tomaré como un cumplido. De todos modos, Mizuki está tan acostumbrada a ser considerada con los demás, que ya va siendo hora de que alguien se preocupe por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Si tanto te supone echarle una mano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "#No se te escapa una. Con lo apurad{F#a}{M#o}s que estaban cuando vinieron, ¿seguro que tienen tiempo de seguir charlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "¡Cierto! ¡Enviémosle un mensaje a Mizuki para contárselo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "Yo la ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "¿Sabes dónde podemos encontrar a Emura Ichigensai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
