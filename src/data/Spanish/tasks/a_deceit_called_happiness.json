			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, hemos venido a pedirte cita para la próxima sesión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460203,
					"content": "Arg... Duele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120460204,
					"content": "¿Eh? ¿Qué les pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "Están así desde que se despertaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "Es un caso grave de indigestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "¿Cómo es posible? ¿Acaso devoraron demasiadas pesadillas anoche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "#Lo dudo... Incluyéndol{F#a}{M#o}s a ustedes, ayer solo tuvimos cuatro clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "Paimon cree que debe ser cosa de los otros dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "Sí. Ha habido algún problema con sus pesadillas... La cantidad de pesadillas no es el único factor que afecta a nuestra digestión. También depende de la intensidad emocional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Una persona normal no debería tener una pesadilla de semejante magnitud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "¡Puaj!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460213,
					"content": "Si no podemos ayudarlas a digerir sus pesadillas lo antes posible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "¿Qué hacemos? ¡Queremos ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "Tenemos que encontrar a los dos clientes de ayer y averiguar el origen de sus pesadillas. Si no sabemos eso, no vamos a poder ayudarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, ustedes hablaron con ellos. ¿Creen que podrán encontrarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "Veamos... Humm, dijeron que iban a buscar a Emura Ichigensai para pedirle orientación una vez más. ¡Puede que los encontremos allí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Vamos. Iré con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
		{
