				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140801,
					"content": "¡¡¡Teppei!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "#Oh... *Cof*, hola, chic{F#as}{M#os}. ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Un momento, dejen que me levante... Uf, qué extraño, no sé a dónde se han ido todas mis fuerzas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei, cuéntanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Ah, claro, no he tenido tiempo de darte todos los detalles. Bueno, he hecho grandes aportes en la guerra últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Luché contra el ejército de la Shogun en el mar, me enfrenté a los samuráis del shogunato yo solo, salvé a mis compañeros de una emboscada... Cosas que ni en sueños podría haber hecho cuando me conociste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "*Cof*, pero ojalá fuera aún más fuerte. Cuanto más fuerte sea, más podré hacer por el ejército de resistencia... Espera un segundo, ¿dónde está mi arma secreta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Háblame de esa arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "#*Cof*, no fue mucho después de que te hicieran capit{F#ana}{M#án} del Escuadrón Pez Espada n.º 2. Conocí a unas personas misteriosas que dijeron que estaban de nuestro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Me la dieron y dijeron que, mientras tenga la voluntad de hacerme más fuerte, esta arma secreta responderá a mi llamado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Jaja... *Cof*, es como una Visión, ¿no? Aunque nunca he usado una Visión, así que no sabría distinguirlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "Esto... es un Engaño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "¿Un Engaño? *Cof*, oh, por Los Siete, eso no suena a algo bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "Entonces... ¿cuál es la diferencia entre un Engaño y una Visión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "Un Engaño drena la fuerza vital de su portador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Por Los Siete... Bueno, supongo que no es sorprendente que un arma misteriosa de origen desconocido tenga sus riesgos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "En los últimos días, me siento cada vez más cansado. Además, tengo una... extraña sensación de temor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "Me di cuenta de que, después de cada batalla, estaba un poco más cansado de lo normal, pero no le presté atención. Sin embargo, al volver hoy, de repente empecé a ver borroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "Qué lástima... Y yo que pensaba que por fin te estaba alcanzando... Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Supongo que no recibí la gracia de los dioses, después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#Oye, {NICKNAME}, ¿podrías hacer algo por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "Cuando nuestros uniformes estén listos, tráeme el mío y pongámosnoslos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "#¿Por qué me miras así? No te preocupes, compañer{F#a}{M#o}. En cuanto haya descansado, estaré fresco como un repollo. Como un repollo... en cuanto haya... descansado...",
					"roleType": "TALK_ROLE_NPC",
