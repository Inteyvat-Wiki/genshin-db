					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Este debería ser el lugar. Pero no parece que haya nada sospechoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#¿Estarán escondidos? {NICKNAME}, veamos qué podemos encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "Estos <color=#00E1FFFF>monumentos Electro</color> parecen un poco sospechosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Uf... Paimon se alegra de que haya terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Para ser un monstruo, fue bastante rudo. ¿Pero qué estaba haciendo aquí un enorme Lawachurl Electroyelmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "No tiene ningún sentido... Además, el ambiente aquí le da escalofríos a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Bueno, es una suerte que ya haya acabado. Deberíamos irnos... ¿Eh? ¿Teppei? ¿Qué estás haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "#*Cof*... Guau, qué sorpresa. No sabía que ustedes eran l{F#as}{M#os} que estaban investigando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Acabo de volver de entregar unos suministros en el frente de batalla. Pensé que podría pasar por aquí para despejar cualquier amenaza en el camino de regreso. *Cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "¿Estás bien? No te ves con muy buen aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Estoy bien, no es nada. Debo haberme resfriado hace un par de días mientras estaba en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Al pasar por aquí, escuché que alguien acababa de llegar a la isla para investigar, así que pensé en venir a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Si hubiera habido algún peligro real, podría haber tenido la oportunidad de ser el héroe... Es una pena que solo fueran ustedes. Supongo que vine aquí para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, ¿no crees que hay algo extraño en este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Humm... ahora que lo mencionas, sí, hay algo raro en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Quizás la energía de los tatarigami es más palpable aquí. No estamos muy lejos de los restos de Orobaxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "¿Orobaxi? ¿Quién es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Un dios. Mira, allí están sus restos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "¡Ah! Es el esqueleto de una serpiente gigante. ¡Se ve aterrador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Orobaxi fue quien trajo a la superficie a nuestros ancestros de Enkanomiya. Ese es el origen de la Isla Watatsumi que ves hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Nuestros antepasados lo consideraban una deidad guardiana, pero durante la Guerra de los Arcontes, Orobaxi invadió la Isla Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "La Shogun Raiden acudió en persona y mató a Orobaxi con el Filo del pensamiento vacío. Con ese mismo tajo, también formó lo que más tarde se conoció como la Garganta Musoujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "¿La Shogun Raiden creó la Garganta Musoujin de un solo tajo? ¡Guau, eso es increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Sí. Pero la Guerra de los Arcontes fue brutal, y la Isla Yashiori quedó completamente destruida durante esa batalla. Dicen que la Shogun también perdió algo muy querido en el transcurso de la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Desde la muerte de Orobaxi, siempre ha habido cierta hostilidad entre la Isla Watatsumi y el shogunato. Pero nuestras diferentes creencias no tienen nada que ver con el motivo por el que se formó el ejército de resistencia. Solo nos levantamos para luchar contra el Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Cuando Orobaxi atacó a la civilización, la Shogun se puso en pie y lo detuvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Pero ahora que la Shogun está despojando a la gente de sus ambiciones con el Decreto de captura de Visiones, es hora de que alguien se levante y la detenga... *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Muy bien, me iré ya. Acabo de luchar contra algunos de los samuráis de élite de la Shogun, así que creo que me voy a tomar un respiro antes de ir a mi próxima misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Debes presentarte ante Su Excelencia Sangonomiya tan pronto como puedas. No te quedes aquí más tiempo del necesario. Estar demasiado tiempo cerca de los tatarigami no le hará ningún bien a tu salud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*Cof, cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Cuídate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Oye, no te preocupes por mí. Mira, estoy en plena forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Teppei ha hecho grandes progresos si ya puede enfrentarse a los samuráis del shogunato. Paimon apenas puede creerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, informemos a <color=#00E1FFFF>Kokomi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Ten mucho cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "Kokomi, ya volvimos... Oh, mira, Gorou está aquí también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140602,
					"content": "¿Qué ha pasado? Se ven muy serios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140603,
					"content": "¿Cuántas personas tienen estos síntomas aproximadamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140604,
					"content": "No he podido hacer un recuento completo aún...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140605,
					"content": "Kokomi, Gorou... ¿qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}, hace poco, algunos de nuestros soldados comenzaron a mostrar síntomas de envejecimiento acelerado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140607,
					"content": "Los llamé para hacerles unas preguntas y descubrí que adquirieron algunas armas secretas de nuestro patrocinador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140608,
					"content": "La mayoría de ellos son tipos muy ambiciosos que se oponen con vehemencia al Decreto de captura de Visiones. Han estado utilizando estas nuevas armas en secreto desde que las obtuvieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140609,
					"content": "Por eso la guerra ha ido inusualmente bien... Pero estas peligrosas armas secretas no son la respuesta. Debemos poner fin a esto inmediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140610,
					"content": "Gorou, ¿conseguiste una de esas armas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140611,
					"content": "La mayoría de los oficiales se negó a entregarlas. Sin embargo, pude conseguir una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140612,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, ¿sabes qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140614,
					"content": "Es un Engaño de los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "¿Eso significa que nuestros patrocinadores secretos son los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140616,
					"content": "¿Pero por qué harían los Fatui algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140617,
					"content": "Olvídenlo, no hay tiempo para eso. Ahora mismo tenemos que informar a todo el ejército para que dejen de usar sus Engaños de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140618,
					"content": "Todos los soldados que hayan mostrado síntomas deben recibir tratamiento. Solo espero que lleguemos a tiempo para salvarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140619,
					"content": "#Espera un segundo... {NICKNAME}, hablando de soldados con síntomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140620,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "No, é-él sería incapaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140622,
					"content": "Oh, ¡vamos a ver cómo está!",
