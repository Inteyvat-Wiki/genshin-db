			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fierro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "“El misterioso Adeptus de los Cielos Elevados”... Qué hermosura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330102,
					"content": "¿Estás viendo constelaciones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Sí... y no. Estamos en el Rito de la Linterna, ¿cierto? Lo más adecuado es disfrutar de una vista así de elegante durante esta época festiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330104,
					"content": "Incluso intenté escribir unos versos. Mis colegas dicen que estos días, a las chicas les gustan ese tipo de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330105,
					"content": "Quizás a Ziwei también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330106,
					"content": "¿Versos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "*Ejem*, escuché a Ziwei mencionar los nombres de muchas constelaciones... Qué hermosos nombres tienen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330109,
					"content": "Así que, ¡me gustaría darle las gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330110,
					"content": "Solo estaba pensando en que, si escribiera un poema en una linterna celeste y fuera con Ziwei a buscar un buen lugar para liberarla, comer y cantar canciones juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330111,
					"content": "Si eso no funciona, ¡nada lo hará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330112,
					"content": "¿Si no funciona... para qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "*Ejem*, es decir... funcionará para hacer el ambiente un poco más festivo. ¡Sí, eso es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330114,
					"content": "En fin, estoy buscando un sitio tranquilo, con una vista espléndida y alejado de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330115,
					"content": "Hasta le he preguntado a otras personas, y encontré dos lugares. Mira, son estos dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330116,
					"content": "Según mis colegas, ellos han liberado linternas celestes aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330117,
					"content": "Pero todavía tengo que escribir el poema... Temo que ir de un lado a otro hará que pierda mi inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330118,
					"content": "Así que, ¿puedes ir a ver esos dos sitios por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330119,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Gracias, ¡cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330107,
					"content": "¿Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133304",
							"2"
						],
						"stepId": 4133304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fierro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "“Fierro y Ziwei, cuando están lado a lado...”. No, no, es demasiado obvio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330202,
					"content": "¿Oh? ¿Cuándo regresaron? ¿Encontraron los dos sitios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330203,
					"content": "Sí, ambos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "¡Qué rápido! Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330205,
					"content": "Bien, veamos... Humm, el paisaje de los alrededores es único, pero el otro paisaje es más pintoresco. Me recuerda a la frase, “el césped es más verde en”... ¿cómo era?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330206,
					"content": "¡Bah! Da igual. Ambos lugares son impresionantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330207,
					"content": "#Humm... ¡Bien! Ya sé cuál escoger. Viajer{F#a}{M#o}, hay algo más que quisiera pedirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330208,
					"content": "Mis colegas dicen que, cuando la vea, debería llevar algo de comer. Dime, ¿qué crees que debería llevar para cuando vea a Ziwei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330209,
					"content": "Pez tigre a la parrilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Pez tigre a la parrilla... ¿No crees que es un poco grasoso? No creo que sea muy adecuado. ¿Qué tal un tofu de almendras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330212,
					"content": "Exacto, ¡un tofu de almendras sería perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330213,
					"content": "#Viajer{F#a}{M#o}, ¿puedo pedirte que me ayudes a hacer un tofu de almendras? Todavía tengo que refinar mi poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330214,
					"content": "“... echan chispas como un bosque incendiado”... ¡Nada mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330211,
					"content": "Tofu de almendras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
		{
