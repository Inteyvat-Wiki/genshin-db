				{
					"id": 413330301,
					"content": "¿Eh? ¿Cuándo regresaron? ¿Ya está listo ese tofu de almendras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330302,
					"content": "Está recién hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Dame un poco más de tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Está bien, yo seguiré pensando en mi poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fierro"
				}
			]
