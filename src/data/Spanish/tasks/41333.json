		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Desde este ángulo... esta constelación... parece un perro. ¿Qué nombre debo ponerle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Ah, eres tú, Fierro. ¿Me buscabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Eh, pues... Es que... estaba caminando por las afueras de Liyue, y de repente encontré un lugar espléndido y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330704,
					"content": "¿Un “lugar espléndido”? ¿Para ver las estrellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "S-sí, para ver estrellas... Tampoco está mal para liberar una linterna celeste que preparé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330706,
					"content": "Mira, hasta escribí un poema en ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330707,
					"content": "“Fierro y Ziwei, cuando están lado a lado, echan chispas como un bosque incendiado”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Humm... No entiendo cuál es tu deseo, aunque este poema es interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Pero no puedes dejar que otros vean tu deseo antes de liberarla o, si no, no se cumplirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "En fin, ¿me buscabas para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Yo... pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330712,
					"content": "Encontró un lugar apropiado para liberar una linterna celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "¿Liberar linternas celestes? Oh, lo siento... En realidad, me gustaría un lugar con menos linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Su brillo no me dejaría ver las estrellas, así que me gustaría un lugar un poco más apartado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Pero aprecio el gesto. Tengo que irme, espero que disfruten del Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "¿Qué?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330718,
					"content": "Se fue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "N-no es nada... Tal vez mi poema es un poco abstracto y por eso no lo entendió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330721,
					"content": "Descuida, no perderé el ánimo. Llegará el día en que... en que ella entenderá mis sentimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330722,
					"content": "#Viajer{F#a}{M#o}, gracias por tu ayuda. Por favor, toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330723,
					"content": "*Suspira*, al menos tengo que liberar esta linterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fierro"
				},
				{
					"id": 413330719,
					"content": "Ánimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "¿Por qué no lo acompañas a liberar una linterna celeste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
