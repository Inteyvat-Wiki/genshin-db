			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "¿A qué jugamos el día de hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000102,
					"content": "¡Hum! No podemos jugar si nadie quiere ser pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000103,
					"content": "Si nadie quiere ser pirata, no hay remedio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000104,
					"content": "¿Qué hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Estamos jugando, pero nos falta alguien que quiera hacer de pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000106,
					"content": "Si nadie quiere ser pirata, no podemos jugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000107,
					"content": "#¡Lo tengo! ¿No quieres ser tú {M#el}{F#la} pirata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000108,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "¡Genial! ¡Todos a sus puestos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000115,
					"content": "#¡Ven cuando estés list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000110,
					"content": "No entiendo qué tengo que hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "No importa, los piratas... son personas malas y toscas que roban a diestra y siniestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000112,
					"content": "Nunca he visto uno, pero he escuchado rumores de Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000113,
					"content": "Sería genial que hicieras de Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000114,
					"content": "Jeje, contamos contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
