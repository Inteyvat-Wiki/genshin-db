			"dialogs": [
				{
					"id": 220000301,
					"content": "¿Terminaste de limpiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000302,
					"content": "Quedó impecable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "¡Buen trabajo! Toma, gracias por jugar con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000304,
					"content": "¡Sé una buena persona de ahora en adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000305,
					"content": "Oye, ¿cuándo me toca ser capitán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000306,
					"content": "La próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000307,
					"content": "¡Hum! Eso dijiste la última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Fei"
				}
			]
