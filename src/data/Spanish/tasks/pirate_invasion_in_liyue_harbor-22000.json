					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Bien, ¡comenzamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000203,
					"content": "¿Cómo empezamos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000204,
					"content": "¡Esto es un motín!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "#¡Ah! ¡{F#Una}{M#Un} pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220000206,
					"content": "¡Lulu! ¡Ven! ¡Yo te protegeré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000207,
					"content": "#Eres {F#una}{M#un} pirata, ¿por qué nos quieres robar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000208,
					"content": "#Porque soy {F#una}{M#un} pirata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "No todos los piratas roban, hay piratas buenos y piratas malos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou es pirata, pero es una persona buena, nos da de comer y todos la quieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000212,
					"content": "#¿Por qué quieres ser {F#una}{M#un} pirata malo? ¿No quieres ser {F#una}{M#un} pirata buen{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000213,
					"content": "¿No dijiste que los piratas eran “personas malas y toscas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Está bien, reconozco mis errores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Beidou dice que es bueno dar vuelta a la página y empezar de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000217,
					"content": "#¡De acuerdo! Entonces ayúdame a limpiar alrededor. Solo haciendo actos buenos podrás ser una buena persona, o {F#una}{M#un} {F#buena}{M#buen} pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000215,
					"content": "Quiero ser una persona buena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Porque los piratas roban...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
