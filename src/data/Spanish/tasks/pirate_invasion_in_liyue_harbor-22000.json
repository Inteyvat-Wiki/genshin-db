			"dialogs": [
				{
					"id": 220000501,
					"content": "¿Terminaste de limpiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000502,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "¡Rápido, es tu oportunidad de redimirte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000504,
					"content": "¿Puede uno volverse bueno haciendo un poco de limpieza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000505,
					"content": "Solo si hay una buena intención detrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000506,
					"content": "Eso es fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000507,
					"content": "Si haces cosas buenas, eres una buena persona. Si haces cosas malas, eres una mala persona. Es así de simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000508,
					"content": "Si es tan simple, ¿por qué sigue habiendo gente mala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000509,
					"content": "Porque es fácil decirlo, pero difícil de hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000510,
					"content": "Y siempre es más fácil hacer cosas malas que buenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220000511,
					"content": "¿Eso también te lo dijo Beidou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220000512,
					"content": "Eso lo leí en un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				}
			]
