			},
			"dialogs": [
				{
					"id": 715000401,
					"content": "Parece que el fuego no se puede controlar muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000402
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000402,
					"content": "No hay problema, hay ingredientes de sobra. Vuelve a intentarlo, sígueme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
