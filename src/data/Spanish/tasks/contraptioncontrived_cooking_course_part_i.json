			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "Hum... Tal vez así sea mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000102,
					"content": "#Viajer{F#a}{M#o}, eres muy oportun{F#a}{M#o}. Acabo de ajustar este aparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000103,
					"content": "¿Esta es la cocinadora mecánica suprema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "Así es. He trabajado en ella durante mucho tiempo y puede hacer muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000107,
					"content": "Tuve que documentarme muy bien para fabricar este aparato de cocina. En el arte de hacer la comida hay varios puntos clave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000108,
					"content": "El primero es encontrar los ingredientes, que son de gran importancia a la hora de cocinar. Durante muchos años, innumerables chefs se han esforzado por encontrar toda clase de ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000109,
					"content": "Mi aparato busca resolver ese problema en primer lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000110,
					"content": "Al activarlo, buscará automáticamente los ingredientes adecuados que haya en las cercanías y marcará su olor para que los chefs puedan llegar hasta su ubicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000111,
					"content": "¿Por qué no va directamente a buscarlos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "¡Ejem! Durante la investigación preliminar estuve considerando este punto, pero no logré resolver el problema de cómo conseguir que la olla ande sola por las montañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000113,
					"content": "El segundo punto es la cocina propiamente dicha. Coloqué muchos componentes intrincados en el interior del aparato para que, solo con poner los ingredientes, se procesen automáticamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000114,
					"content": "¿Cómo sabe qué debe hacer con ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "Bueno, por supuesto debe consultar la receta correspondiente para poder determinar cómo procesar los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000116,
					"content": "Es difícil explicar brevemente cómo funciona. Bastará con saber que resolver este problema me costó bastante trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000117,
					"content": "También pasé mucho tiempo pensando cómo solucionar un asunto que resulta problemático para muchos chefs: la limpieza de los utensilios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000118,
					"content": "Si hubiera que limpiar los restos pegados en la olla, se estropearía el ambiente del festín...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000119,
					"content": "¿Está a la venta este aparato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "Jajaja, dudo que pudieras permitírtelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000121,
					"content": "Además, de momento solo funciona con energía adéptica. Comprarlo no te serviría de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000125,
					"content": "Bueno, ya hemos charlado suficiente. Mientras fabricaba este aparato, también fui estudiando recetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000126,
					"content": "Así que creé varias recetas para que esta cocinadora mecánica suprema pudiera enfrentarse a retos a su altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000127,
					"content": "Te invité aquí para pedirte que me ayudes a recolectar ingredientes y seguir dichas recetas para cocinar algunos platos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000128,
					"content": "El primer plato se llama tofu oncidium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000129,
					"content": "Este plato requiere que el tofu se corte en tiras muy finas, para lo que el aparato debe poner a prueba su habilidad con el cuchillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000130,
					"content": "En cuanto a los ingredientes, se necesita tofu, jamón, brotes de bambú y carne de ave. Ya le pedí a Ganyu que los trajera, y están...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000131,
					"content": "¿Eh? ¿Dónde están los brotes de bambú? Estoy segura de que los puse aquí. ¿Acaso algún bandido aprovechó que estaba despistada para llevárselos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000132,
					"content": "¡Hum! No importa. Esta es una buena ocasión para mostrarte la función de búsqueda de ingredientes de la cocinadora mecánica suprema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000133,
					"content": "Cocinadora mecánica suprema... ¡actívate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000134,
					"content": "#Viajer{F#a}{M#o}, ya he activado la cocinadora. Sigue el olor y ve por los brotes de bambú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000122,
					"content": "¿Por qué se te ocurrió hacer este aparato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "¿El motivo? Para explorar el arte de los mecanismos y la ingeniería, naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000124,
					"content": "Y, por supuesto, hacer la comida será más cómodo para mí a partir de ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000105,
					"content": "¿Para qué sirve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "Enseguida te explicaré qué puede hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
		},
