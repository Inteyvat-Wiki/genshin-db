			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "#Entonces el aparato puede encargarse del resto. No obstante, viajer{F#a}{M#o}, tú debes controlar el fuego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000304,
					"content": "¿No puede controlarlo el aparato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Eh... Intenté varias veces utilizar una llama interna para lograr un control autónomo del fuego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000306,
					"content": "Pero la llama de la cocinadora mecánica suprema no es corriente. Se debería usar la propia llama adéptica para operarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000307,
					"content": "Las llamas adépticas de tal poder deformarían los componentes internos si se pusieran directamente en el interior del aparato. Sacrificarlo por una pequeña ganancia no es una buena idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000308,
					"content": "Por el momento, la mejor solución es aplicar la llama adéptica de forma externa. De esta manera, se requiere un ayudante que la controle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 715000309,
					"content": "#Este asunto tan importante, el control de las llamas, depende de ti, viajer{F#a}{M#o}. Avísame cuando estés list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
				7150007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
