						220230203,
						220230204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230203,
					"content": "Que lo disfrutes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "¿Qué platos me dijiste que hiciera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "Carne de Mora, carne curada con matsutake y carne a la jardinera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220230206,
					"content": "¡Vamos a decidir qué le damos a la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
