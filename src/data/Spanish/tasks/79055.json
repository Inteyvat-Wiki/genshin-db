			"dialogs": [
				{
					"id": 790550101,
					"content": "Este es un escenario abandonado del corto teatral «Sueños de naufragio».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790550102,
					"content": "Originalmente, la historia trataba sobre dos eidolones hidromiméticos que se habían enamorado profundamente a bordo de un naufragio que flotaba en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790550103,
					"content": "Tras confesarse sus sentimientos, se sitúan en la proa del naufragio, donde son alumbrados por el resplandor de la puesta de sol. Una escena extremadamente romántica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790550104,
					"content": "Sin embargo, este escenario se abandonó porque... los dos eidolones hidromiméticos que interpretaban el papel eran demasiado enérgicos y no paraban de moverse en esta escena tan romántica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790550105,
					"content": "*Suspiro*... si alguien pudiera capturar a <color=#00E1FFFF>los dos en la proa del naufragio al mismo tiempo</color>, la escena sería perfecta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790550106,
					"content": "—— El director",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notas del plató"
				}
			]
		},
