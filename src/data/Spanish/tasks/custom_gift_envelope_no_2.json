			"dialogs": [
				{
					"id": 715340101,
					"content": "Humm, tal vez debería comprobar cómo son las felicitaciones de los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#{NICKNAME}, cuánto tiempo sin verte... ¿Y esa cara de sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Nada, solo es que no esperaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "¿No esperabas que una guerrera como yo tuviera el buen gusto de venir al Rito de la Linterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Nunca te había visto tan relajada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "La Comisión Tenryou tiene una gran responsabilidad y, como miembro, no puedo permitirme relajarme en ningún momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Tal vez, a los ojos de la gente, tan solo sea una guerrera que no sabe nada de elegancia y refinamiento... Alguien que no encaja en absoluto con las festividades de Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Sin embargo, si estuviera más relajada en el día a día y dejara que los criminales se aprovechasen de la ocasión, no solo sería una desgracia para mí, sino también para el propio ambiente de Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Como mucho puedo hacer como ahora: salir a dar una vuelta aprovechando el tiempo libre que tenga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Lo siento, no debería sacar temas tan serios durante una celebración como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Estoy tratando de hacer una felicitación, pero no lo consigo. Si quieres, podrías darme algún consejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Claro. Déjame pensar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
