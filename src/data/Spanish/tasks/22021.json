			"dialogs": [
				{
					"id": 220210701,
					"content": "Gracias por querer ayudarme. Aunque hacer las brochetas de tres sabores es muy sencillo, hay que prestar atención a la frescura de los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Ya he preparado todos los ingredientes, pero no sé si los huevos serán suficientes. ¿Puede ir a buscar dos huevos para garantizar que no tengamos problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Yo me encargaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "¿Cómo es que sabes hacer esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Aprendí a hacer estos aperitivos cuando trabajaba en el shogunato, para acompañar las bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Pero ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Bueno, es mejor no hablar del pasado. Tráigame los huevos, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Yo estaré aquí preparando los ingredientes. Cuando consiga los huevos, tráigamelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
