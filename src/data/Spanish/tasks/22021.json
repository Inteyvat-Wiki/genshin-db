			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "¡Este es uno de mis platos estrella! ¡Prepárate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Y esta es una de las especialidades de este servidor. ¡Prepárese usted también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "¿Qué están haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#Ah, hola, viajer{F#a}{M#o}. Verás, Parvaneh y Julie han ido a buscar ingredientes y nosotros pensábamos prepararles la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Pero Munehisa y yo no logramos ponernos de acuerdo sobre qué plato cocinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Así que cada uno vamos a preparar un plato para ver quién es más ducho en el arte culinario, y de paso esta será la comida de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Yo voy a hacer un plato típico de Liyue, el estofado de gemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Un servidor va a preparar su plato especial para la competición: brochetas de tres sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "¿Necesitan ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Oh, si no tienes nada más que hacer, necesitamos que alguien juzgue el sabor de nuestros platos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Pero no tenemos a nadie que nos ayude a preparar la comida, y debemos hacer raciones grandes, así que tal vez no tengamos tiempo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Antes de juzgar el sabor, ¿podrías ayudarnos a cocinar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "#Como tú también eres {F#una sola}{M#uno solo}, decide qué plato quieres ayudar a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, ¿vas a poder con todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "¡No te preocupes por mí! Antes tenía un restaurante en Liyue. Preparar una comida no supone ningún problema para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Lo único es que la comida sale aún mejor si se dispone de un ayudante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Vamos, elige el plato que más te llame la atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Te ayudaré a ti, Xudong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "¡Estupendo! Munehisa, ¡prepárate! ¡Mi plato te dejará sin aliento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "¡Un servidor no aceptará la derrota tan fácilmente! ¡No ganará así como así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Te ayudaré a ti, Munehisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Se lo agradezco. Ándese con cuidado, Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "¡Jaja, atáquenme con todo lo que tengan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Munehisa, ¿vas a poder con todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "No se preocupe, elija el plato que más le interese. Este servidor, cuando trabajaba en el shogunato, a menudo tenía que preparar los aperitivos nocturnos para mucha gente. Ahora solo hay que cocinar para cuatro, así que no habrá ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "#Pero si está dispuest{F#a}{M#o} a ayudarme, seguro que la comida sabrá aún mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "¿Ya tienen un jurado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Jajaja, aún no, pero necesitamos que alguien juzgue el sabor de nuestros platos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "#¡Ya está! Muchas gracias, viajer{F#a}{M#o}. ¡Huele que alimenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Lo probaré yo primero... ¡Mmm! ¡Nada mal! Los ingredientes están en su punto justo de cocción y el sabor es intenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Podría decirse que es un estofado de gemas perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "#¿Qué tal va tu plato, Munehisa? Deja que {F#la viajera}{M#el viajero} lo pruebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Me temo que este servidor ha fracasado. Al empezar a preparar el plato, me di cuenta de que no tenía huevos suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Aunque me apresuré a ir a buscar huevos al bosque cercano, los demás ingredientes ya habían superado su tiempo de procesamiento óptimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Si las brochetas de tres sabores se hacen con ingredientes que no están en su punto óptimo de frescura, ya no se puede decir que sea un buen plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Este servidor se siente muy avergonzado por haber cometido semejante negligencia. Aún tengo mucho que aprender en el campo culinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Este servidor ha perdido la competición. ¡Pero la próxima vez ganaré, señor Xudong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "¡Ánimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Jeje, de todas formas no es fácil vencerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "#Ah, viajer{F#a}{M#o}, esto es para ti. Gracias por acompañarnos hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "¡La próxima vez que tengamos una competición de cocina, volveremos a llamarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Yo creo que sabe muy bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "No, aunque se trate de cocinar, también hay que aspirar a la perfección. No basta con hacer las cosas de cualquier manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "¡Así es como se logra llegar al pináculo de la gastronomía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Eh... ¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Eh... ¡Sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Esta es la vía del guerrero, y también la vía del cocinero, pero sobre todo la vía del ser humano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Ah... ¡Muy bien! Ánimo, Munehisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Ay, yo no sé cómo tratar con personas tan serias... Julie es la que sabe cómo tratar con él, pero ahora no está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "#Estoy anonadad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "#Bueno, gracias por tu ayuda, viajer{F#a}{M#o}. Esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Señor Xudong, este servidor desearía hacerle unas preguntas sobre cocina. ¿Dispone de tiempo ahora mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "¿Eh? ¡Claro que sí! ¡Ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
