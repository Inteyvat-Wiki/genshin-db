			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Sí, esta apariencia y este sabor... Puede decirse que estas son las brochetas de tres sabores definitivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "¿Brochetas definitivas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Jeje, quiero decir que son unas brochetas perfectas. Oh, por la hora que es, el estofado de gemas del señor Xudong ya debe estar listo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "¡Por supuesto! ¡Aquí está mi estofado de gemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Aunque no he calculado bien los tiempos y creo que la sopa ha hervido durante algo más de lo necesario, el sabor debería ser aceptable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Deje que un servidor lo pruebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Sí, tiene un ligero sabor a chamuscado. No puede decirse que estropee el plato completamente, pero no es perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Jajaja, esta vez cociné con demasiada prisa. La próxima vez prepararé los ingredientes con antelación y no tendré este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Perdí por esta vez, pero la próxima vez no cometeré este error.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Has sido descuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Jajaja, sí... Ha sido culpa mía. La próxima vez que compitamos tendré más cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "#Ah, viajer{F#a}{M#o}, esto es para ti. Gracias por acompañarnos hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "¡La próxima vez que tengamos una competición de cocina, volveremos a llamarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Las “brochetas definitivas” están mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "¿“Brochetas definitivas”? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Unas brochetas de tres sabores de calidad perfecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "El ideal de lo definitivo se basa en rechazar hacer las cosas de cualquier manera y aspirar a la búsqueda de la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "También puede aplicarse a la cocina. ¡Solo con la búsqueda de la perfección se puede alcanzar el pináculo de la gastronomía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Eh... ¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Eh... ¡Sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Esta es la vía del guerrero, y también la vía del cocinero, pero sobre todo la vía del ser humano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Señor Xudong, venga aquí. Permítame que le explique la vía de la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "#¿Eh? Espera un momento, por favor. Viajer{F#a}{M#o}, esta recompensa es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Ay, yo no sé cómo tratar con personas tan serias... Julie es la que sabe cómo tratar con él, pero ahora no está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Ve a experimentar la “vía de la perfección”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "¿Señor Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "¡Ya voy, ya voy! ¡Enseguida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
