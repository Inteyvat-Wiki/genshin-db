					"speakerTitle": "Xudong"
				},
				{
					"id": 220210602,
					"content": "Cabeza de loto, tofu... Menos mal que tengo. Pero parece que no me quedan suficientes flores doradas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210603
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210603,
					"content": "#Viajer{F#a}{M#o}, estoy preparando los ingredientes. ¿Puedes ir a buscar tres flores doradas, para asegurar que sean suficientes?",
					"roleType": "TALK_ROLE_NPC",
