			"dialogs": [
				{
					"id": 790740101,
					"content": "Vaya, ¡aquí hay dos valientes más! ¿Vienen a desafiar la “Ráfaga boreal”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Vengan por aquí, ¡espero que vuelen mejor que todos y surquen los cielos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "¡Calma, calma! ¡Con tranquilidad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "#Para volar no es necesario calmarse, amig{F#a}{M#o}. La calma es absolutamente innecesaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Eso solo va a retrasar tu percepción del viento. Solo cuando no se está preparado puede uno liberar su potencial al máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "¡Las ardillas voladoras de hoy en día son demasiado cobardes! Olvidaron por completo las enseñanzas que nos cultivó «El valiente viento boreal».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Solo saben admirar la osadía de las hojas que bailan con las brisas desde un lugar seguro, y no se atreven a lanzarse al viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Si esto continúa, ¿cómo podremos proteger el reino junto con la princesa? ¡Esto es ridículo! ¡Totalmente ridículo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "¡Qué ardilla voladora más enérgica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Parece que le gusta mucho volar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Bueno, encontré algunas ráfagas de aire muy intensas, y monté todo tipo de mecanismos allí dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Solo el más valiente y hábil volando podrá salir de la corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "#Querid{F#as}{M#os} amig{F#as}{M#os}, ¿tienen ese coraje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "¡Me gustaría intentarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "¡Genial! Vengan conmigo, ¡la corriente no está lejos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Humm... Aún tengo algo por hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "#¿Qué pasa? ¿Aún no están preparad{F#a}{M#o}s? Bien, pues l{F#a}{M#o}s esperaré por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Cuando les apetezca desafiar la corriente de aire, solo tienen que venir aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "¡Aún no he aceptado la invitación! Espera un momento y cálmate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}