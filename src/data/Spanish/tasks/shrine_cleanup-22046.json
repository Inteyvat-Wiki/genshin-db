			"dialogs": [
				{
					"id": 220460101,
					"content": "El santuario está desordenado de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460102,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "#Miau, eres tú otra vez. Muy oportun{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460104,
					"content": "Después de un tiempo sin limpiarlos, los alrededores del santuario han empezado a acumular suciedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460105,
					"content": "Neko no puede recibir así a los humanos que vienen al santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460106,
					"content": "¿Podrías ayudar a Neko a limpiar el santuario, como hiciste la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460107,
					"content": "¿Taisuke y Etsuko no están por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Neko... no hablará con esos dos humanos verdes por voluntad propia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460109,
					"content": "El humano alto siempre mira a Neko de forma extraña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460110,
					"content": "Y la otra humana verde nunca parece tener muchas ganas de hacer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460111,
					"content": "Miau miau, no son humanos de confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460115,
					"content": "Sea como sea, Neko solo puede confiar en ti para esta tarea. Usa el palo largo y el agua para limpiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460116,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "En fin, Neko te encomienda esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460119,
					"content": "Neko te esperará aquí, miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460117,
					"content": "Creo que lo entiendo... Más o menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Podrías preguntar al Sr. Ooshima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "El humano de las piedras siempre está ocupado con sus golpecitos. ¿Quién sabe qué estará haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460114,
					"content": "Ya le dio suficientes golpecitos a la piedra, ¿qué tiene que golpear esta vez? Qué molesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				}
			]
		},
