			"dialogs": [
				{
					"id": 413580201,
					"content": "¿Y bien? ¿Cómo va la búsqueda de tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580202,
					"content": "Ya los encontré todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "#¿Todos? Vaya, eres {F#toda una experta}{M#todo un experto} cazando tesoros. Mucha gente se da por vencida en el primer intento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580204,
					"content": "Ya que encontraste todos los tesoros... Toma esto como premio. ¡Feliz Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
