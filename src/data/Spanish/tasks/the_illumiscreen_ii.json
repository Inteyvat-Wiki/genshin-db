			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "#¡Bienvenid{F#a}{M#o}! ¿Quieres intentar el juego de las linternas giratorias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580102,
					"content": "¿Estas linternas son nuevas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ah, eres tú. Viniste en el momento adecuado. He cambiado algunas linternas desde la última vez que viniste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580104,
					"content": "¿Quieres intentarlo? No será tan fácil como la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580105,
					"content": "¿Por qué? ¿La imagen es más compleja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "No, no. La imagen es fácil de formar si giras bien las tres linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580107,
					"content": "En esta ocasión, la dificultad está en la rotación de las linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580112,
					"content": "¡Ah, por cierto! La imagen de ahora es un <color=#00E1FFFF>Mora</color>. Recuérdalo bien. Una vez que formes la imagen, podrás ir a buscar el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580108,
					"content": "¿Es más difícil girar las linternas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Jeje, en esta ocasión, las tres linternas están <color=#00E1FFFF>conectadas entre sí</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580110,
					"content": "En pocas palabras, cuando giras una linterna, es posible que una de las otras dos también gire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413580111,
					"content": "Bien, pruébalo y verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Chian"
				}
			]
		},
