			},
			"dialogs": [
				{
					"id": 412109901,
					"content": "El secreto de Albedo debe ser algo extraordinario. De lo contrario, ¿por qué lo escondería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sacarosa"
				}
			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sacarosa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "¡Ah, es Sacarosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "¿Tú también vienes a explorar la montaña nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "¡Ah! M-me asustaron... ¡Por favor, no me asusten así! Estaba pensando en mi informe de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100204,
					"content": "Pero si estabas ahí parada, mirando al vacío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "¡P-para nada! Solo estaba pensando en el nombre para una nueva subespecie de flor dulce que germiné. Es cuatro veces más grande de lo normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100206,
					"content": "¿Cuatro veces? Suena delicioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "¿Oh? ¿Te interesa? Excelente, ¡en otra ocasión te mostraré los frutos de mi investigación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100209,
					"content": "Es una pena. Si no hubiera venido a la montaña, habría traído unas muestras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100210,
					"content": "Cierto, ¿no estabas investigando en la ciudad? ¿Cómo es que viniste hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Timaeus y yo estamos ayudando a Albedo a organizar los datos de su investigación. De hecho, Timaeus acaba de irse. ¿No lo vieron por casualidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100212,
					"content": "Nop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Dijo que aún le faltaba mucho para manejar los datos tan bien como Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100214,
					"content": "Hay cosas que Albedo comprende de inmediato, pero que a nosotros nos toma una eternidad. Esa debe ser la diferencia entre conocimiento teórico y experiencia práctica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100215,
					"content": "Timaeus estaba un poco decepcionado y dijo que iba a dar un paseo, así que me quedé sola a terminar lo que queda de trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100216,
					"content": "(Más bien parece que se fue a propósito...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "En un principio, pensaba dar un paseo después de terminar el trabajo, ¡pero di con una información muy interesante entre todos los datos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100218,
					"content": "*Suspira*, en fin, supongo que mi investigación de los secretos tendrá que esperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100219,
					"content": "¿Secretos? ¿Qué secretos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "Eh... Ahora que lo dices, ¿tienen tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100221,
					"content": "¡Tiempo es todo lo que tenemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Entonces, ¿puedo pedirles un favor? En realidad, siempre he creído que hay algo que Albedo nos esconde a Timaeus y a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100223,
					"content": "Pero ¿no es tu mentor? ¿Qué ocultaría un mentor a sus discípulos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Tienes razón, pero, aun así, tengo la sensación de que siempre nos ha ocultado algo... ¡Supongo que es un gran secreto relacionado con la alquimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100225,
					"content": "Espera, ¿cómo estás tan segura de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Timaeus y yo somos investigadores apasionados de la alquimia. Si no tuviera que ver con eso, no nos lo ocultaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100227,
					"content": "Humm... Tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "¿Pueden ayudarme a averiguar qué es lo que oculta Albedo? Por favor, ¡muero de curiosidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100229,
					"content": "Humm... ¿Qué piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Si tanto quieres saberlo, te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "¡Guau! ¡Gracias, gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412100233,
					"content": "Está bien, está bien, vamos a dar una vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "¡Yo también tengo curiosidad por saber sus secretos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "¿Se puede comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
			"completionStepIds": [
				4121004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121004",
							"2"
						],
						"stepId": 4121004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "¡Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "#¡Hola, somos nosotr{F#as}{M#os} de nuevo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "¿Eh? ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "¿Se perdieron en el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "¡No!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "Sacarosa nos pidió que averiguáramos tu secreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "¿Un secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "¡Oye! ¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "¡Esta tarea requiere de máxima discreción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "De todos modos, no se lo podemos ocultar a Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Oh... Ahora que lo dices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "#Viajer{F#a}{M#o}, vienes en el momento adecuado. Tengo algo para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "¡Toma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "¿Eh? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "Como puedes ver, es una espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "Entonces, ¿sabes forjar armas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Yo no hice esta espada. Sin embargo, le di un toque alquímico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "¿Quieres probarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "¿Me la das? ¿A mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "Según investigación, esta espada tiene propiedades especiales. Solo tú puedes usarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "Pero necesito recolectar datos sobre ella tan pronto como sea posible. ¿Te importaría usarla en una batalla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "Oye, oye, ¿cómo puede existir una espada que solo pueda usarla una persona en concreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "¿Tiene algún efecto secundario?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "#Eres muy astut{F#a}{M#o}. Esta espada tiene una maldición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "Una persona ordinaria no puede blandirla. En cambio, tú sí puedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "Mejor dicho, solo tú eres inmune a la maldición. Dadas las circunstancias, ¿a quién más le puedo pedir ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "En fin, menos hablar y más hacer. Busquemos algunos monstruos por los alrededores. Después de todo, algunas cosas se descubren solo con la práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "¿Se necesita saber forjar armas para ser alquimista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Sacarosa dice que escondes un gran secreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hombre fiero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "#¡Por aquí! ¡Es es{F#a}{M#e} mocos{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Hombre fiero"
				},
				{
					"id": 412100402,
					"content": "#¡Devuélvela, ladr{F#ona}{M#ón}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Hombre fiero"
				},
				{
					"id": 412100403,
					"content": "¿Ladrones de Tesoros? ¿Hay Ladrones de Tesoros en un lugar tan frío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "¡Basta de charla! ¡Dánosla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Hombre fiero"
				},
				{
					"id": 412100405,
					"content": "¡Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "#Eso sí que es nuevo. ¡Los Ladrones de Tesoros nos llamaron “ladron{F#as}{M#es}”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "No tardaron en llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "Espera, ¿tú eres el ladrón del que estaban hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Por supuesto que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "Al parecer, estaban hablando de esta espada. ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "¿Por qué me miras así? No sería capaz de robar una espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "No hace mucho tiempo que los Caballeros atraparon a una pandilla de Ladrones de Tesoros fuera de la ciudad. También les confiscaron los bienes que estaban robando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "Entre esos bienes estaba esta espada. Creímos que era parte del botín, pero nadie vino a reclamarla, y tampoco pudimos encontrar de dónde vino, así que se quedó ahí en el almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "La descubrí por mera casualidad. A decir verdad, una espada tan antigua no sirve para otros fines que no sean la alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "¿Y la reclamaste como si fuera tuya, así sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "¿Y después? ¿Simplemente te la llevaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "Así es. Al principio, quería hacer unos experimentos con ella, pero descubrí su verdadero origen mientras tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "Esta arma, que parece tan antigua, pasó alguna vez por las manos de un herrero ya fallecido. Es una espada mágica legendaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "¡¿Una espada mágica?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "Se dice que el herrero desapareció justo después de crear el arma, que a la vez desapareció en las arenas del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "Ya que fue confiscada a los ladrones, lo más probable es que ellos la robaran, y que haya estado perdida hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "El herrero que hizo la espada... ¿desapareció? ¡Qué miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "¡Con razón está maldita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "Exacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "Y pensar que un humano pudo hacer una espada así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "¿Conoces la historia de <color=#00E1FFFF>Durin</color> y esta montaña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> es el dragón negro que amenazó a Mondstadt hace siglos, hasta que fue derrotado por <color=#00E1FFFF>Dvalin</color> y el Arconte Anemo, <color=#00E1FFFF>Barbatos</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "Tras una feroz batalla, Durin cayó derrotado aquí, en estas densas nieves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "La nieve que se acumula en esta montaña nunca se derrite. Es un fenómeno muy interesante. Me pregunto si Durin cayó aquí por casualidad o fue algo intencionado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "¿Cómo puede ser intencionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "Quizás escogieron cuidadosamente este lugar como su tumba precisamente para que el poder de la nieve sellara las toxinas corrosivas que emanaban del cuerpo de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "Es posible que Barbatos pensara en ese método.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "¿Eh? ¿Barbatos es tan ingenioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "Bueno, son solo suposiciones mías, no tengo ninguna prueba. Pero lo que es seguro es que esta montaña y Durin están profundamente relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "De hecho, creo que esa espada que tienes en tus manos contiene restos de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "¡¿Restos de dragón?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "Así es. Los ojos, garras y escamas del dragón fallecido fueron reducidos a polvo antes de usarlos para recubrir la hoja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "Así, la corrupción y el veneno de Durin se introdujeron en la espada, y se convirtieron en la fuente de su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "Es una obra artesanal muy avanzada. Imagino que, tras forjarla, el herrero quiso probarla él mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "Pero usar esta espada en batalla habría provocado que la corrupción emanara de la empuñadura y que se filtrara en su cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "Los mortales normales no pueden soportar tal poder. Seguramente el herrero huyó, enloquecido por la maldición, y encontró su muerte en un lugar remoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "¡Ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "Antes, purificaste las lágrimas de Dvalin, que en sí misma es una habilidad poco común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "Esa es la habilidad que te protegió de la corrupción y el veneno. Además, tú puedes eliminar sus efectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "Por eso, solo tú puedes empuñar esta espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "Aun así, esta espada es muy... ¡ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "¿E-está brillando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "En cuanto a mí respecta, aquí es donde comienza el verdadero experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "Ahora mismo, esta espada es muy débil. Sin embargo, es capaz de absorber energía para fortalecerse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "En cierto sentido, se podría decir que tiene vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "#Bien, viajer{F#a}{M#o}, úsala todo lo que quieras. Necesito que la ayudes a crecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "Creo que pronto tendremos todas las pruebas que necesitamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "No les robaste nada, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
}