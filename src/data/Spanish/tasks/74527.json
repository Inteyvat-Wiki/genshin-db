			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Oh, {NICKNAME}, ¿qué tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Escoffier, cuánto tiempo sin verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Hoy no me encargo de cocinar, solo estoy probando la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna quiere lanzar un nuevo plato y me pidió que la ayude a evaluarlo. Pero esta es la quinta vez que lo hace y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "O el tiempo de cocción está desajustado por unos segundos, afectando la textura de los ingredientes; o la proporción de condimentos es muy alta, haciendo que las especias se apoderen del sabor principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Sigues siendo tan estricta como siempre, Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "¡Por supuesto! La cocina es una ciencia, y el sabor no va a cambiar solo porque ella sea mi amiga. De hecho, es precisamente porque quiero responsabilizarme de ella y de mis clientes y por eso debo ser más estricta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Tengo una pequeña petición, ¿podría tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "... ¿Ahora mismo? Si es una imagen para el público, sugiero que lo hagamos en otro momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Necesitamos elegir bien el escenario, ajustar cuidadosamente la luz y el ángulo para lograr el mejor efecto visual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Solo quiero tomar algunas imágenes de recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "... Está bien. De todos modos hay que esperar a que lo haga por sexta vez, así que todavía tengo algo de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Veamos quién se hará lucir más, tu nuevo Daguerrotipo o ese nuevo plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Solo quería probar algunas funciones de mi nuevo Daguerrotipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "¿Me permites tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "¿Estás desarrollando nuevas recetas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
