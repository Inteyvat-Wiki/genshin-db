			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "Casa de Libros Wanwen... esta es la librería de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "¿No quieres preguntar si tienen el volumen de Liyue de la «Guía de viaje de Teyvat»? ¡Es superinteresante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "No duden en echarle un vistazo a mis libros. No hace falta que compren nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "Estamos buscando el volumen de Liyue de la «Guía de viaje de Teyvat». ¿Lo tienes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Lo siento, lo quitamos del catálogo hace mucho tiempo. Simplemente no se estaba vendiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "¡¿De verdad?! Pero el volumen de Mondstadt era tan bueno... ¡Qué pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "El problema es que el autor lo hizo demasiado personal y, en realidad, el resultado no fue una guía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "Apenas vendió unas cuantas copias, y los pocos viajeros que lo compraron presentaron quejas después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "¿Su estilo personal era demasiado marcado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "No sé, pero sigo pensando que es una lástima. El volumen de Mondstadt fue muy bueno, incluso como un diario de aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "El hecho es que no lo tengo entre mis existencias. Si de verdad lo quieren, prueben suerte en casa de Chang el Noveno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "¿Quién es Chang el Noveno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "Un coleccionista de libros descatalogados que vive en la Aldea Chingtsé. Es muy gruñón, pero se sabe comportar si la conversación es sobre libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "Era un cliente habitual cuando vivía en Liyue. Todavía le envío algún que otro libro descatalogado de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "Es difícil llegar al lugar donde vive. Debes dirigirte a la montaña justo detrás de la Aldea Chingtsé, luego seguir el camino de madera hasta arriba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "¿Alguien dijo “libros descatalogados”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000315,
					"content": "¿Hay alguna posibilidad de que el volumen VI de «La leyenda de la alabarda fragmentada» también esté en su colección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000316,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Disculpa, ¿dónde están mis modales? Mi nombre es Xingchiu, un humilde amante de la literatura. Solo pasaba por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000319,
					"content": "Ya que tanto tú como yo estamos buscando libros, ¿qué te parece si viajamos juntos al Monte Chingtsé y visitamos a Chang el Noveno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000320,
					"content": "Tiene sentido. ¡Tú nos guías, y nosotros te seguimos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "#Un placer, ¡compañer{F#a}{M#o} amante de los libros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000322,
					"content": "No sé, parece un camino muy largo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Tómatelo como una oportunidad de tener un respiro del ajetreo y el bullicio de Liyue. A todos nos hace falta de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000317,
					"content": "¡No deberías escuchar las conversaciones ajenas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "¿Quizás el contenido era muy disparatado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "*Suspira*, los Arcontes me están castigando... Esto es un tormento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000502,
					"content": "Disculpe, ¿es usted Chang el Noveno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Tal vez. ¿Qué quieres? ¡Vamos, no tengo tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000504,
					"content": "Hemos oído que tiene muchísimos libros viejos, y queremos tomar prestado el volumen de Liyue de la «Guía de viaje de Teyvat».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "*Grr*, no comiences a hablar de libros, porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000506,
					"content": "Después de que se cerró la Sima, el negocio minero familiar empezó a desplazarse hacia el sur. Entonces, los Fatui comenzaron a planear cómo sabotearme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000507,
					"content": "Para pagar mis deudas, no tuve más remedio que empeñar mi querida colección de libros. ¡Hasta el último de ellos! ¿Tienes idea de lo que eso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000508,
					"content": "¿Está triste porque no tiene nada que leer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "¡Te equivocas! ¡Era mi vida entera de trabajo! Me dediqué a conservarlos, coleccionarlos, cuidarlos... ¡Y ahora ya no están!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000511,
					"content": "... *Suspira*, hacer rabietas no servirá de nada. Lo único que puedo hacer es tratar de ahorrar suficientes Moras para volver a comprarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000512,
					"content": "A menos que tengan otros asuntos por aquí, he terminado de hablar con ustedes. ¡Adiós, fuera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000513,
					"content": "Por favor, dígame que no empeñó el volumen VI de «La leyenda de la alabarda fragmentada».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000514,
					"content": "«La leyenda de la alabarda fragmentada»... Ese es un título que no he escuchado en mucho tiempo. ¡Tienes buen gusto, muchacho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000515,
					"content": "#¿Qué? ¿Y nosotr{F#as}{M#os} no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "Ese trabajo fue una obra maestra que definió su época. Sin embargo, era prácticamente desconocida en el momento en que se publicó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000517,
					"content": "Pero con el tiempo redefinió por completo el género de artes marciales, y dio pie a una gran cantidad de obras de imitación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000518,
					"content": "Apenas existen unas cuantas copias de la primera edición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000519,
					"content": "Y en ediciones posteriores, el sexto volumen quedó inexplicablemente inédito, posiblemente porque fue considerado más una secuela que una parte central de la historia original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000520,
					"content": "¡Exactamente! ¡Así es! El sexto volumen de la edición original de ese libro era tan escaso que, por mucho que necesitase el dinero, nunca me atreví a empeñarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000521,
					"content": "¿Quiere decir... que todavía lo tiene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000522,
					"content": "Sí. Es el único tesoro que me queda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000523,
					"content": "¡Oye! ¡Viejo Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "Tienes agallas para tenernos a mi señor y a mí esperando. Necesito una respuesta, ¿venderás el cor lapis o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "No necesito recordarte que, si te metes con el Burgués Maotsai, ¡te estás metiendo con los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "Oh, tú otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000527,
					"content": "Sabes que no puedo permitirme dar un setenta por ciento de descuento en el precio... Nunca podría volver a comprar mi colección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000528,
					"content": "Eso es asunto tuyo. La pregunta es: ¿quieres tus libros o quieres comida en tu plato? ¿O tal vez te gustaría ir a la tumba con tus libros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "*Grr*... Eres un... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000530,
					"content": "Tranquilo, amigo. Si este caballero no está dispuesto a hacer un trato contigo, no lo hará. No puedes obligarlo a vender contra su voluntad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000531,
					"content": "¿De dónde saliste tú? ¡Ocúpate de tus asuntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "Soy alguien que vino a ayudar a este caballero en apuros: Xingchiu, del Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000533,
					"content": "*Pff*, ¡jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "¡“Clan Guhua”! ¿Escuchaste a este payaso? ¡Cree que es un maestro Guhua! ¡En esta época! ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "Pensé que los últimos viejos de Guhua ya habían estirado la pata. ¡Parece que todavía hay caballeros en este mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "La justicia no tiene nada que ver con el pasado de uno mismo, amigo mío. Solo estoy tratando de hacer lo correcto, pero ¿qué hay de ti? La comadreja que hace los mandados del tigre es más débil que su amo, pero no es menos culpable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000537,
					"content": "¡Tú...! De acuerdo, ¡espera a que te ponga las manos encima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "¡Y tú también, anciano! ¡Quieras o no, me venderás ese mineral!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "*Suspira*, ¡oh, como los lobos que se aprovechan del tigre caído! Mis días están contados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000540,
					"content": "... Como iba diciendo, ¿podría pedir prestado el libro que mencioné antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000541,
					"content": "¡Por Los Siete! ¡Dale un respiro al pobre hombre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Bah, qué importa. No puedo esperar que los demás se preocupen por mí. Pero ya que me defendiste, toma este libro y déjame en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000544,
					"content": "¡Tres largos años he esperado este día! Las palabras no pueden expresar mi gratitud... Yo, Xingchiu, ¡prometo devolver este gran acto de generosidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000545,
					"content": "Muy bien, ¡ahora déjame en paz! Tráelo de vuelta cuando hayas terminado. Lo siento, pero no estoy dispuesto a poner mis esperanzas en alguien que se proclama discípulo de Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 120000546,
					"content": "¡Oye! ¡¿A dónde vas?! ¡Todavía tenemos un trabajo que hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "Tres palabras: lee entre líneas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "¿Está tan aburrido que ha comenzado a leer las cajas de cereales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200006",
							"2"
						],
						"stepId": 1200006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingchiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "Así que te gusta leer, ¿eh? ¿Señor “héroe por cinco segundos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Jojo, increíble... Eso sí que no me lo esperaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000603,
					"content": "¡Tierra a Xingchiu! ¡Tierra a Xingchiu! Xingchiu, ¿me oyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "No es de extrañar que este libro sea tan solicitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000608,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "¿Quién era el tipo que armó tanto escándalo antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "¿Cómo pueden intimidar al pobre Chang de esa manera y obligarlo a vender sus minerales a un precio tan bajo? ¡Es un robo a plena luz del día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "¡Tenemos que encontrar una manera de ayudar a Chang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "No te olvides de mí. Yo también quiero ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000613,
					"content": "¡Oh! ¿Así que ahora puedes escuchar lo que estamos diciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "La razón por la que tomé prestado este libro es porque sería una lástima que Chang el Noveno tuviera que empeñarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000615,
					"content": "Todo lo que le dije a Chang era verdad. Devolveré su acto de bondad conmigo, es lo más justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000616,
					"content": "Seré el guardián de este libro y lo ayudaré a encontrar una manera de recuperar el resto de su colección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000617,
					"content": "Parece que tienes un plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Por supuesto que sí. Un plan inicial... en cuyos detalles aún tengo que trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000620,
					"content": "Necesito reflexionar sobre ello. No creo que me tome mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000621,
					"content": "Todavía tienes el valor de estar por aquí. ¿Crees que hablo de dientes para afuera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "La Escuela de Bobos no tiene ni personas, ni talento, ni mucho menos agallas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "¡Ay, lo siento! ¡Quise decir Escuela Guhua! ¡Pero qué torpe soy! ¡JAJAJA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "Hay un dicho que dice: “El insecto que sacude el roble sobrevalora su habilidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000625,
					"content": "¡Déjate de proverbios, payaso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Por favor, deja este lugar. No toleraré un intento de coaccionar a un comerciante honesto, especialmente cuando a quien amenazas es alguien con quien estoy en deuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000627,
					"content": "Qué noble que pongas las manos en el fuego por Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "¡Pero elegiste el momento equivocado, niñito! Traje a los Fatui para respaldarme. ¡Tu pequeño ejército de Guhua no podrá ayudarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Puedo ser joven, pero el camino que he elegido no me hace ajeno al conflicto. ¿Por qué debería acobardarme ante el mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000630,
					"content": "¡Qué gran discurso! ¡Pero ahora es momento de enseñarte una lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "No tienes un plan en absoluto, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "Entonces, ¿abandonamos la “Operación «Guía de viaje de Teyvat»”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "¿Por qué abandonas tu búsqueda de libros tan fácilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120000606,
					"content": "¿El tipo de antes era el que hace el trabajo sucio del Burgués Maotsai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
			"completionStepIds": [
				1200010
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200010",
							"2"
						],
						"stepId": 1200010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingchiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "Creí que solo era un pendiente de jade, ¡no una Visión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001002,
					"content": "Ganaste esta vez, ¡pero será mejor que tengas cuidado! ¡Esto no ha terminado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001022,
					"content": "*Suspira*, espero que hayan aprendido la lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001003,
					"content": "Entonces, ¡tienes una Visión!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Sí, aunque trato de no usarla. No me gusta la ventaja injusta que me da contra mis oponentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001008,
					"content": "Se han ido por ahora, pero volverán pronto a causar más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "Lo sé. Pero velaré por que aquellos de buen corazón no sufran. Hay una manera justa y otra injusta de hacer negocios, y yo me aseguraré de que este asunto se solucione de la manera justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001010,
					"content": "Los Fatui nunca se pondrán del lado de un comerciante y, a juzgar por el comportamiento de ese chico de los mandados, sus amenazas no eran en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001011,
					"content": "Hay mucho más detrás de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001012,
					"content": "Mencionó al Burgués Maotsai. Conozco ese nombre, tiene una residencia majestuosa en Liyue. Tal vez ustedes podrían ir a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001013,
					"content": "Eso tiene sentido... ¿Y qué piensas hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "¿Yo? Tengo algunas cosas que ver aquí. ¿Qué tal si nos vemos en la Terraza Yujing de Liyue en unos momentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001015,
					"content": "#¿Lo dices en serio? No nos estarás usando como {F#las chicas}{M#los chicos} de los mandados, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Guau... ¡Así que así concluye la historia! Este capítulo es simplemente extraordinario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001017,
					"content": "¡Aj! ¡Qué molesto! ¡Paimon quiere darle un golpe en la cara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "Primero ayudemos a Chang el Noveno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "¡Hum! Vale, pero de acuerdo con la tradición, ¡Paimon elige un apodo feo para todos los que la molestan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "De ahora en adelante será conocido como... ¡el nerd de Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "La venganza de Xingchiu puede ser lenta, pero es segura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "¡Esas técnicas Guhua son más impresionantes de lo que pensaba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "Oh, te equivocas. Todo lo que dijo ese tipo es despreciable, pero después de todo, su valoración sobre el Clan Guhua es acertada. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 120001007,
					"content": "Me encantaría poder restaurar la gloria del Clan, pero no es una tarea fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingchiu"
				}
			]
		},
