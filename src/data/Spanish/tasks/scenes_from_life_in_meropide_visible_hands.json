			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Cuánto has tardado, ya se fueron todos los Engendros Fontamarinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Al fin me toca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "¿Que te toca qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "No hacer nada. Cuando llegas al lugar y tus compañeros ya resolvieron todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "Esto es para ustedes. ¡Muchas gracias de verdad! ¡Esta noche puedo dormir tranquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
}