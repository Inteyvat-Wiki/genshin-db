					}
				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Mira, ¡pero si son {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650102,
					"content": "¿Nos conocemos mucho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Vamos, no seas distante conmigo, que me acuerdo de lo que pasó la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650105,
					"content": "La última vez... ¡Ah! ¡Aún tenemos muchas preguntas que hacerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "¿A-ah, sí? Qué mala memoria tengo, ¿pasó algo entre nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650107,
					"content": "La gente inteligente dice que en lugar de contemplar el pasado, es mejor hablar del futuro. ¿Qué les parece si hablamos de nuestra futura colaboración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650108,
					"content": "Tengo en mis manos unos encargos con buenas recompensas, pero me estaba preocupando no encontrar a alguien interesado en ayudar. ¿Quieren aceptarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650109,
					"content": "Hum, no creas que vamos a caer en la trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "¿De cuánto estamos hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "#Por eso me gusta hacer negocios con gente como {F#la Srta.}{M#el Sr.} {NICKNAME}. ¡Gente que entiende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650113,
					"content": "#Seguro que estarán content{F#as}{M#os} con la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650114,
					"content": "Cien Cupones crediticios, ¿qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650115,
					"content": "¡¿Cien?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Sí, ¿a que soy muy generoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650117,
					"content": "No da ni para una fonta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "¡Eso! ¡Hay que tener cara para decirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "¿Es que no soy lo suficientemente generoso? Ay, los jóvenes de hoy en día, no saben aprovechar las oportunidades que se les regala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650122,
					"content": "Deben tener en cuenta que hay gente pobre que lucha por estos trabajos tan fáciles y lucrativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650123,
					"content": "¡Decembre, ladino! ¡Por fin te tengo! La vez pasada te atrapé cerca de la Sala de Correspondencia y delegaste por un precio bajo en alguien nuevo un encargo del que deberías haberte ocupado tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME} y Paimon, no se habrán creído sus mentiras, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "*Snif*, a mí ya me engañó una vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "*Suspira*, llegué tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "En fin, no crean ni una sola palabra de sus mentiras. Se dedica a engañar a la gente que acaba de llegar o no conoce muy bien el funcionamiento del Fuerte Merópide. Tiene ya muchas víctimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "¿Cómo que me dedico a engañar? Qué mal ha sonado eso. ¿Acaso los celadores no hacen lo mismo? Pagan a la gente con unos míseros cupones para que hagan el trabajo por ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650132,
					"content": "Ya, pero no nos guardamos una parte en el bolsillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "¿Qué estás insinuando? Si no tienes pruebas, será mejor que cierres el pico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650134,
					"content": "¿Quieres pruebas? Vamos al calabozo, es tranquilo y amplio, el lugar perfecto para leer documentos. Es que de verdad, aún tengo trabajo en el túnel de geoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#Por cierto, {NICKNAME} y Paimon, si tienen tiempo, ayúdenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "¡No siempre tenemos tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "Si la recompensa es generosa, yo ayudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Jaja, claro, se lo pagaré según las reglas. Ustedes conocen los precios, no les podría engañar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "La situación es la siguiente: en el túnel de geoda hay unos Engendros Fontamarinos. Si los dejamos ahí, tarde o temprano van a perjudicar las aguas. Tenemos que encargarnos de ellos lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Primero llevaré a este tipo al calabozo y se lo encomendaré a mis compañeros, pero puede que me tome un poco de tiempo. En cuanto termine con los trámites, me reúno con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Está bien, no te demores mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Lo intentaré, pero ya saben que los trámites... no dependen de mí. Cuento con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Esta vez no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "¿Esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Ehmm... Algo pasó entre nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "Te doy cien, tú trabajas y yo obtengo las ganancias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Guau, ¿en serio es lo que tenías pensado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "Tengo un mal presentimiento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
