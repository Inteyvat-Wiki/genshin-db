			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "Vamos, Godwin... ¿Por qué tardas tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Hola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "#Conozco esa voz... ¿Eres {F#la viajera}{M#el viajero} que viene desde muy lejos? Gracias, Arconte Anemo, seguramente fue tu viento el que {F#la}{M#lo} guió hasta este lugar... Resulta que me gustaría pedirte algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Mi... *ejem*... novio, Godwin, es miembro de los Caballeros de Favonius. Dejó la ciudad hace mucho tiempo y todavía no ha regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "No he sabido nada de él desde que se fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Estoy muy preocupada por él. Pobre Godwin, ¿y si se topa con esos desagradables Hilichurls? Me dijo que están en guerra con la Orden del Abismo, ¿y si le pasa algo? Lleva tanto tiempo fuera, ¿y si se enamora de una caballera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Ay, lo siento, me dejé llevar. Mi mamá siempre me dice que los dientes de león pueden llevar los deseos de la gente muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Por eso, ¿podrías recolectar tres semillas de diente de león de Levantaviento para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "¡Muchísimas gracias! Que el Arconte Anemo te proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "#¡Espera! Te lo ruego, por favor, ayúdame. Debería ser pan comido para {F#una viajera}{M#un viajero} experimentad{F#a}{M#o} como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003602,
			"completionStepIds": [
				2003604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
