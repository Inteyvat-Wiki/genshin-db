			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "¡Volviste! ¿Conseguiste mis semillas de diente de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Sí, ya están todas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "¡Gracias! ¿Podrías ponerlas en mi mano? No veo, así que me da miedo perderlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "¿Son suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "¿Podrías ponerlas en mi mano? Es la única forma que tengo de saberlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Es suficiente. Ahora les contaré a las semillas todo lo que quiero decirle a Godwin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "¿Puedes taparte los oídos? ¡Nada de espiar! Son cosas privadas entre novios. Ya sabes... ¡Jiji! Seguro que ya has tenido una experiencia similar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Ya terminé. Ahora, llévalas a la cima de la estatua del Arconte Anemo y arrójalas al viento. El gran Arconte se encargará del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Espero que las guíe a Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003603,
