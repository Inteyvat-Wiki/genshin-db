					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "¿Ya lo hiciste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "Hacía tanto viento allá arriba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Bien, eso es lo que queremos. De esa manera, las semillas de diente de león pueden viajar muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Tal vez realmente lleguen a Godwin después de todo, y le transmitan lo que quiero decirle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Dame tu mano... Llévate estas. Son para darte las gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Hay muchas cosas que quiero decirle a Godwin. Es posible que necesite tu ayuda nuevamente en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		}
	]
