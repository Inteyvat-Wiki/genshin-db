			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "¿Eh? ¿Puedo ayudarte en algo? Estaba a punto de empezar a tocar y cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100502,
					"content": "Acerca del reclutamiento del Gremio de Aventureros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Ah, eso. Vi el anuncio, pero no me interesa. Además, no necesito unirme al Gremio de Aventureros, puedo proteger Mondstadt solo usando mi canto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100504,
					"content": "Aunque me uniera al Gremio de Aventureros, no sería de mucha ayuda para mí. Seguro que la mayor parte del tiempo estaría haciendo trabajos extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100505,
					"content": "Por eso no me interesa el Gremio. Lo siento, pero gracias por venir a preguntarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100506,
					"content": "Este es material sobre el reclutamiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "¿Eh? Es Espinadragón, ¿cierto? Esta Estatua de los Siete en medio de la nieve se ve... bastante artística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100508,
					"content": "Ah, esta montaña es muy alta, ¿no? He escuchado que es altísima. Estoy segura de que mi voz llegaría más lejos si tocara y cantara desde ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100509,
					"content": "Más tarde iré al Gremio de Aventureros a preguntar. Recuerdo que ahí se pueden contratar aventureros de compañía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100510,
					"content": "Aun así, me parece interesante que los aventureros puedan llegar a ese lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Helen"
				}
			]
		},
		{
			"id": 7001006,
			"completionStepIds": [
				7001015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
