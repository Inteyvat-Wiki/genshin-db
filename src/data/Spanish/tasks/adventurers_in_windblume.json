				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "¿Y bien? ¿Les pediste a todos su opinión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Ahora entiendes lo que te decía... En fin, la situación es así y yo ya estoy acostumbrado desde hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "*Suspira*, sea como sea, mientras encontremos un método eficaz, le estaré agradecido a Los Siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "Supongo que regresarás a Espinadragón para informar a Iris sobre el encargo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Entonces, de paso, llévale esta carta de mi parte, por favor. Le gustará saber qué ha estado pasando con el Gremio estos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "*Suspira*, espero que podamos reclutar gente nueva esta vez... pero ¿los que sean reclutados de esta manera podrán convertirse en aventureros confiables?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
