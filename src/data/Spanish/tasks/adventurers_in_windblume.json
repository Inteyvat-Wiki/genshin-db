			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"José Seis Dedos"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#¡Hola, amig{F#a}{M#o}! ¿Quieres escuchar mi nueva pieza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100402,
					"content": "Acerca del reclutamiento del Gremio de Aventureros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "¿Reclutamiento del Gremio de Aventureros? Lo siento, no estoy interesado. Correr por ahí no ayuda a escribir poesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100404,
					"content": "Además, en la ciudad de Mondstadt, si se fuera a escribir una epopeya... ciertamente sería mejor que se basara en los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100405,
					"content": "Lo siento, no estoy interesado en el reclutamiento del Gremio de Aventureros. Ser un aventurero que ayuda a la gente a perseguir gatos no ayuda a escribir poesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100406,
					"content": "Este es material sobre el reclutamiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "¿Estos son paisajes... de Espinadragón? Se ven muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100408,
					"content": "Podría encontrar nueva inspiración recorriendo un lugar como este. Además, no parece demasiado peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100409,
					"content": "Humm... Más tarde iré al Gremio de Aventureros a preguntar... Incluso si no me uno al Gremio, puedo contratar a un aventurero para que me acompañe allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "José Seis Dedos"
				},
				{
					"id": 700100410,
					"content": "Un recorrido por Espinadragón... se debe sentir muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "José Seis Dedos"
				}
			]
		},
		{
			"id": 7001005,
			"completionStepIds": [
				7001012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
