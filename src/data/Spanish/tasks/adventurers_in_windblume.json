			"dialogs": [
				{
					"id": 700100701,
					"content": "Acerca del encargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "Volviste. ¿Por qué tardaste tanto? Ese niño te debe haber pedido algún favor innecesario, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "Ayudé a Cyrus a averiguar unas cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "¿Qué estará tramando ahora ese niño?... ¿Hum? ¿Y esta carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "Contiene los sucesos más recientes del Gremio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Ya veo. Siempre tan considerado. Parece que sí ha estado muy ocupado. Durante el Festival de las Flores de Viento tampoco ha descansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Pero, con tantos esfuerzos, seguro que el Gremio de Aventureros de Mondstadt será capaz de reclutar a mucha gente nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Cuando haya suficiente gente nueva, ese niño podría tomarse un descanso de todas las nimiedades y volver a explorar conmigo... Sí, eso estaría bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "Leeré bien esta carta. Por otro lado, ya que Cyrus te mandó a hacer más cosas innecesarias, debes aceptar que te dé una recompensa extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Aquí tienes. Buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
