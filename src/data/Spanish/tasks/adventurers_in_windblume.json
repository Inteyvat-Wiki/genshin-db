				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Acerca del encargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "¿Viniste tras ver mi encargo? Bien, sí necesito tu ayuda para algunas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "En concreto, necesito que me ayudes yendo a Espinadragón a tomar unas imágenes de dos lugares, cuya ubicación exacta marcaré en tu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "En cuanto a la recompensa, te pagaré, por supuesto, un precio razonable según las reglas del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "¿Por qué necesitas que tome las imágenes de esos dos lugares?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Humm... A decir verdad, tiene que ver con Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "La última vez me pidió que le consiguiera algunos objetos típicos de Espinadragón. Quería usarlos para promocionar el Gremio durante el Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "Ya llegó el Festival de las Flores de Viento y no sé si ese niño está muy ocupado, pero no se ha comunicado conmigo últimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Humm... Pero, ahora que lo pienso, a su edad debe estar ocupado con cosas del Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Hace mucho que él ya pasó esa fase...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "¿Tú crees? No me había dado cuenta. Yo siempre he pensado que... Humm, olvídalo, no nos desviemos del tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "Ya recolecté algunos minerales y organicé algunos mapas topográficos y registros de monstruos. Pero también me gustaría tomar algunas imágenes de los paisajes de Espinadragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "#Viajer{F#a}{M#o}, ¿me ayudarías a tomar algunas imágenes de esos dos lugares de Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "En ese caso, lo dejo en tus manos. Ya marqué los dos lugares en tu mapa. Ve directamente allí y vuelve cuando termines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "¿Tú no regresarás a la ciudad a echar un vistazo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "El ambiente de la ciudad está demasiado animado para mí, prefiero quedarme aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Además, todavía me quedan muchas cosas que hacer por aquí. Por el momento no regresaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "Ya marqué en tu mapa los mejores lugares para capturar los paisajes. Ve directamente allí y, cuando termines, vuelve conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
							"2"
						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "Acerca del encargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "¿Cómo? ¿Ya terminaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Todo listo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Buen trabajo. Yo también, ya envolví lo que le quiero enviar a ese niño. Por favor, para terminar, ayúdame a entregarle estas cosas. Y recuerda volver para darte tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "No sé si será suficiente, pero si se trata de reclutar nuevos integrantes, seguro que los registros de monstruos y los minerales será lo más popular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "Ah, parece que este plan de reclutamiento no sirve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Iris te envía unas cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "¿Me envía unas cosas? Ah, sí... Debe ser lo que le encargué la última vez, lo había olvidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "¿De verdad estás ocupado con el Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "¿Con el festival? No tengo tiempo para eso. El plan de reclutamiento anterior no sirvió para nada y ahora estoy ocupado elaborando uno nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Pero antes de continuar, voy a revisar las cosas que mandó Iris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "¿Minerales? No sirven... Ahora no les interesan a los jóvenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Mapas... Oh, esto será útil para los miembros del Gremio. Pero para reclutar... no creo que nadie les preste atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Registros de investigación de monstruos... Deberíamos hacer copias de estos para todos los aventureros, pero tampoco sirven para reclutar nuevos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "¿Eh? También hay dos imágenes. Salieron bastante bien, y los paisajes se ven agradables y seguros. Seguramente despertarían el interés de algunas personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "¿Por qué eliges esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Me da la sensación de que es lo que más se relaciona con los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Parece que no estás al tanto de la situación actual del Gremio. Los jóvenes han ido perdiendo interés en todo lo relacionado con monstruos, minerales y mapas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "Para poder captar su atención, necesitamos usar cosas más... “realistas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Es el Festival de las Flores de Viento. Seguramente los jóvenes están buscando algo no tan común y, a la vez, no tan peligroso para sacar a relucir sus cualidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Una expedición a Espinadragón es una de esas opciones por las que cualquiera que esté interesado puede acercarse al Gremio y preguntar por ella. Quizás hasta se vuelvan miembros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Humm... Aunque no quisieran unirse al Gremio en esas condiciones, igual... nos llegarían algunos encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Y si te fijas en la ubicación de las dos imágenes, ambas están al lado de un camino principal. De esa forma, con el cuidado debido, uno no suele encontrarse con peligros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "¿Ya te decidiste por eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Esta es la situación actual, si no se me hubiese ocurrido algo como esto, nos hubiéramos quedado sin opciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Bueno, si todavía no me crees, entonces toma estas dos imágenes y ve a preguntar a la gente en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Empieza hablándoles del reclutamiento del Gremio de Aventureros, luego saca estas dos imágenes y di que son “materiales de reclutamiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "Entonces sabrás por qué se me ocurrió esta idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
