			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, me han contado que encontraste a todos los animales que llevaban los microtransmisores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "Ha sido toda una sorpresa. Algunos animales son muy sensibles y se asustan cuando se acerca cualquier extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "Pero no parece que te estén evitando. Es curioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "#Porque soy amig{F#a}{M#o} de los animales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "Jaja, pues te envidio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "Cada vez que el personal me acompañaba a darles de comer, o me mordían o me gruñían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "Ahora tengo varias cicatrices en los brazos... y son bastante dolorosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "Pero bueno, aunque no se acerquen a mí, me conformo con verlos sanos y salvos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "Todos los adoptantes piensan lo mismo. Todos queremos proteger el hábitat de los animales sin perturbarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "Sé que para muchos aventureros la fauna es una importante fuente de alimento. Así que tampoco vamos a prohibir que los miembros del Convoy de las Patitas cacen animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "Sin embargo, defendemos firmemente la oposición a la captura y matanza indiscriminada. Si todo el mundo se ajustara a estos principios, nuestro entorno sería mucho más diverso y hermoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "#{NICKNAME}, como miembro de la asociación, sería fantástico que aceptaras y estuvieras de acuerdo con estos principios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "Estoy de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "¡Sabía que alguien tan razonable como tú nos apoyaría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "Hacer que otros reflexionen en ello ya es un éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "Espero volver a verte en el próximo evento del Convoy de las Patitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "Ojalá no tenga nuevas cicatrices en los brazos para ese entonces, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "Prefiero no opinar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "#No te preocupes. No te obligaremos a que te conviertas en un{F#a}{M#o} de nosotros. Es solo que me gustaría que todo el mundo lo pensara antes de matar a un ser vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "Es un talento que tienen los aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
