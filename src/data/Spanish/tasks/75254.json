				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "#¡Hola, amig{F#a}{M#o}! Bienvenid{F#a}{M#o} a la Tierra Onírica de Paititi: ¡la Isla Tete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Más adelante están las tabernas Rocío para Dos y Gota de Rocío. Mi nombre es Tecuhtli y estoy aquí para recibirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#Querid{F#a}{M#o} amig{F#a}{M#o}, ya que bebiste mi jugo de bienvenida, permíteme darte un consejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "Si eres una persona normal y corriente que solo quiere disfrutar de sus vacaciones, no te acerques a la zona más norte de la Isla Tete. Allí no hay nada que te ayude a relajarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Está bien. ¿Qué te ha pasado en el ojo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Hum, fue un tipo calvo quien me dejó esta marca... También está en esta isla, y me encargaré de darle las “gracias” como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "#Tranquil{F#a}{M#o}, amig{F#a}{M#o}. Sé que estás pensando en vengarte por mí tras escuchar mi historia, ¡pero no hace falta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "En un verano tan hermoso como este, ¡nadie debería estar amargado de la vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Tú disfruta del jugo de bienvenida que he preparado a cada uno de nuestros invitados, y pásatelo bien en este tiempo de relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "El jugo está en aquel estante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
