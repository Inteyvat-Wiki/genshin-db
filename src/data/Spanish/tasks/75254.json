					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "Aún no me has preguntado nada sobre el ojo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
