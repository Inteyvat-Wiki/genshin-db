					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "¿Nos hemos visto alguna vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "#Amig{F#a}{M#o}, esta es una marca que el destino reserva a la gente extraordinaria. Por eso, aunque sea la primera vez que nos veamos, se siente como si ya nos conociéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Al ver mi parche, tan salvaje como un lobo, ya te habrás dado cuenta de lo especial que soy, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
