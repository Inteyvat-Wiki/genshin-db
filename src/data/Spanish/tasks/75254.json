			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "¿Eh? ¿Quieres saber qué me ha pasado en el ojo? Jaja, pues verás, hay tres cosas que todos los hombres deberían hacer en esta vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Primero, debería tener un cupido cuerpo con al menos una cicatriz. De lo contrario, no habría ningún indicio sobre la complicada vida que habría vivido el hombre y, por tanto, carecería de profundidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Segundo, tendría que tapar las cicatrices con la ropa o con algún accesorio para mantener un perfil bajo pero sin ocultarlas por completo. De no ser así, nadie se daría cuenta de lo especial que es este hombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Y tercero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Espera, nadie te ha preguntado por el ojo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "¡Exacto! Has dado en el clavo. Ese es mi tercer punto: si los demás no se han dado cuenta, el hombre tiene que encontrar la manera de sacar el tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
