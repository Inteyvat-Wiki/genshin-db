			"dialogs": [
				{
					"id": 250340501,
					"content": "#Gracias por salvarnos, aventurer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "Este lugar está demasiado lejos de nuestra tribu... Era imposible que Illapa hubiera escuchado nuestros gritos de auxilio antes de que esos tipos se llevaran a Qica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "¿Qué están haciendo aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Tratábamos de entrenar nuestras habilidades escalando. Pero nos entró hambre cuando íbamos por la mitad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "Así que decidimos ir a recoger algo de fruta. Acabamos yéndonos demasiado lejos sin darnos cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "Cuando ya habíamos comido hasta quedarnos satisfechos, nos percatamos de que estábamos muy lejos de la tribu. Seguro que mamá me dará otra reprimenda cuando vuelva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "Gracias otra vez por salvarnos. ¡Estos cacahuatles que acabo de recoger son para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "Tenemos que volver cuanto antes. ¡Vamos, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "¡Gruuu! Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				}
			]
		}
	]
