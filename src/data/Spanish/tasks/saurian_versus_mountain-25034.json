			"dialogs": [
				{
					"id": 250340101,
					"content": "¡No le agradan! ¡Lárguense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Mocoso, ¿conoces a este saurio? ¿Es tu compañero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340103,
					"content": "¡Gruuu... Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Oh, parece que el renacuajo se ha vuelto impaciente. Muy bien, hazte a un lado, nosotros no le pegamos a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340105,
					"content": "Muchachos, traigan la bolsa. Jeje, seguro que podríamos hacer buen dinero con este saurito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340106,
					"content": "¡Ni se les ocurra acercarse más! ¡No me haré responsable si hay algún herido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "Un momento, ¿en serio piensas atacarnos? ¡JAJAJA! Muchachos, ¿han oído eso? ¡Nos va a dar una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340108,
					"content": "Qué miedo tengo... Ya que me hablas así, no tendré más remedio que tratar de defenderme. Pero no me haré responsable de los heridos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340109,
					"content": "¡Gruuu! Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "*Tch*... Qué saurio tan fiero... Mocoso, deberías irte a mimir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340111,
					"content": "Ustedes sí que van a acabar dormidos como un tronco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#¡Aventurer{F#a}{M#o}, están intentando llevarse a Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "¡Gruuu! ¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "#Muchach{F#a}{M#o}, te aconsejo que no te metas en esto. Te daremos una parte de lo que ganemos con el renacuajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340116,
					"content": "A Qica no se le toca ni un pelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Oh, ya veo por dónde vas. En ese caso, supongo que ya conoces las reglas. ¡Muchachos, vayan por ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340119,
					"content": "¡A la carga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bandido ansioso"
				},
				{
					"id": 250340117,
					"content": "¿Quién ha pedido tu simpatía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Yo tampoco me haré responsable de los heridos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
