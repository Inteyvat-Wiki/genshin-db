					"nextDialogs": [
						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Ideal para una reunión con el destino, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Bueno, hay que prepararnos para la pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Pase lo que pase, parece que las cosas han mejorado un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Mondstadt ha sufrido mucho recientemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "#¿Quién hubiera dicho que, al final, la solución a nuestro problema sería simplemente {F#una viajera}{M#un viajero} y una canción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Admito que los Caballeros de Favonius también pusieron de su parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Lo entendemos, Sr. Diluc... En fin, todo el mundo, háganse a un lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Yo, el mejor bardo del mundo terrenal, comenzaré a tocar la Lira Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
