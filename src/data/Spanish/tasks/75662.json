			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "Un mensajero me dijo que la intermediaria de operaciones militares había encontrado a alguien muy fuerte para aprobar las pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620102,
					"content": "Me alegro de saber que eres tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620103,
					"content": "#*Tch*, ¿por qué te asignaron este encargo a ti? Kinich, est{F#a}{M#e} {F#amiga}{M#amigo} {F#tuya}{M#tuyo} es como tú, acepta cualquier encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620104,
					"content": "Oh, la notificación de un nuevo encargo ha llegado: “hacer callar a un dragón entremetido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620105,
					"content": "Sí, lo acabo de publicar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "Tú... ustedes, ¿cómo se atreven a meterse con un dragón sagrado como yo? ¡Van a pagar por esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620109,
					"content": "#Volvamos al grano, {NICKNAME}, dejo en tus manos aprobar estas pruebas. La dificultad y el equilibrio no te decepcionarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620110,
					"content": "¿Dificultad? Pero de qué dificultad hablas, no seas ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620111,
					"content": "¿Y qué considerarías difícil? ¿Elegir al azar a un compañero tonto para descender en cuerda por un acantilado con los ojos vendados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620112,
					"content": "Y que solo hubiera un 10% de probabilidad de que el compañero elegido sea un Yumkasaurio, y que el resto fueran todos Surcamagmas y Slimes Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620113,
					"content": "¡Eso es jugarse la vida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "Je, ¿aún no sabes lo que les gusta jugar a los Retoños Arbóreos? Ya has pasado bastante tiempo con mi pequeño lacayo, deberías saber que mis consejos son muy importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620115,
					"content": "¿Y por qué no nos haces una demostración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620120,
					"content": "... Participar en un desafío tan insignificante como este solo humillaría mi dignidad. Ustedes pueden hacer lo que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620121,
					"content": "#En fin, Irade me hizo una oferta muy buena, solo espero que te diviertas en el desafío y estés content{F#a}{M#o} con la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620122,
					"content": "¡Qué emoción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "¡Mucha suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620123,
					"content": "¡Déjalo en mis manos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "Eso suena divertido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "¿Ves? ¡Es mil veces mejor que tú, en todo! ¡Gustos, perspectiva y forma de pensar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 756620118,
					"content": "Me gustaría que Ahau nos pusiera el ejemplo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "A mí también. Siendo tan pequeño, debe ser mucho más ágil que los desafiantes. Y lo suficientemente fuerte como para no ser lanzado contra el suelo creando un agujero de una sola bofetada, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620107,
					"content": "No te preocupes, ese encargo puede esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "¡Hum! ¡No creas que con decir eso vas a ganarte mi agradecimiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ahau"
				}
			]
		}
	]
}