			"dialogs": [
				{
					"id": 200140201,
					"content": "Guau, los derrotaste a todos, ¡incluso haces que parezca fácil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Es tal y como dice en el «Manual del aventurero»: puedes usar cualquier medio para derrotar a los monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Aun así, he de admitir que me asusto mucho cuando están tan cerca. Menos mal que estabas conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Todavía tienes que entrenar más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Sí, lo sé. El camino para convertirme en una aventurera no es nada fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "#Gracias, viajer{F#a}{M#o}. Volveré a la ciudad, mi hermano debe estar muy angustiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "A partir de ahora, debo entrenar más duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
