				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, piénsalo bien. Creo que este asunto tenemos que pensarlo a largo plazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Oh, no te preocupes por mí, ¡voy a estar bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Anna, ¿te sientes bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#¡Viajer{F#a}{M#o}, justo a tiempo! Necesito tu ayuda, ¡Anna quiere convertirse en aventurera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "¿Por qué no puedo serlo? Tengo buena salud, y Cyrus dice que soy muy inteligente, ¡soy perfecta para ser aventurera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "¿Hace cuánto tiempo te recuperaste? ¿Y si te vas y vuelves a enfermar? Además, mamá y papá no van a estar de acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Ya hablé con ellos, dicen que lo van a permitir siempre y cuando apruebe los exámenes del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "¡¿Qu-qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Tranquilo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Hace unos días, Cyrus me ayudó a preparar un plan de entrenamiento y estoy entrenando desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "El plan incluye explorar, buscar comida de emergencia, sobrevivir en la naturaleza y cosas así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Pero he oído que los aventureros también suelen luchar contra monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Me encantaría aprender a hacerlo, pero no he encontrado a nadie que pueda enseñarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Y, como puedes ver, mi hermano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "¡No lo haré! ¡Esos monstruos son muy peligrosos! Y si lo hicieras, por lo menos tendrías que asegurarte de ir con un veterano curtido en batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Bueno, le pregunté a Jack y aceptó ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Vamos, ¿a quién pretendes engañar? Sé quién es Jack. Si no puede cuidar de sí mismo, mucho menos de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Dudo mucho que encontremos tan fácilmente un aventurero veterano en el gremio, y tampoco tengo el dinero para hacer un encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Yo podría ir contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "¿Eh? ¿Me ayudarías? ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Perfecto. Supongo que puedes estar tranquilo, hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#*Suspira*, de acuerdo, está bien. Sé lo fuerte que es {F#la Caballera Honoraria}{M#el Caballero Honorario}. Con {F#ella}{M#él} a tu lado, creo que puedo dejar de preocuparme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Aun así, deben ir con cuidado allí afuera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "¿Lo recordarás todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Sí, sí, lo recordaré. ¡Ya me lo has dicho mil veces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "#Muy bien. Viajer{F#a}{M#o}, ¡salgamos ya! Le pedí a Jack que le echara un vistazo al campamento al que vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "#Yo soy {F#una aventurera curtida}{M#un aventurero curtido} en batalla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Bueno, ¿y cómo va tu entrenamiento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "¿Qué están haciendo, Anthony?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
