			"dialogs": [
				{
					"id": 60280201,
					"content": "Aquí es donde la gente de Hiperbórea se comunicaba con la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280202,
					"content": "La Luna Eterna, la Luna Escarchada, la Luna Arcoíris... Cuando el poder de las tres converja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "La puerta que conduce hacia las lunas se abrirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280204,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "Las médulas lunares ya están listas. Solo queda el último paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280206,
					"content": "Seguro que la Villa Nasha está más animada que nunca ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280207,
					"content": "Sí... Es una pena que no pudieras estar allí. Pero es ahora o nunca, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "No importa. Me basta con esto... mi última pieza de equipaje, mi único equipaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280210,
					"content": "Ya puedo sentir cómo me llama la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280212,
					"content": "Ese haz de luz te guiará hasta casa, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280213,
					"content": "A partir de ahora, por fin tendremos una razón para rezarle a la auténtica luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Sí, dime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280216,
					"content": "¡No olvides venir a visitarnos cuando puedas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ah... Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280218,
					"content": "Pero si por alguna razón no puedes... recuerda que tienes amigos en este planeta; personas que echarán de menos a “Colombina”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Sí, lo recordaré. Gracias por todo lo que han hecho por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280220,
					"content": "Ustedes también recuerden... que la luz de la luna nos unirá siempre tanto en el día como en la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60280221,
					"content": "#*Fiu*... Bueno... Adiós, amig{F#a}{M#o}s mí{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
