					"id": 401970201,
					"content": "¡Genial! Dibujaré uno <color=#C4D6EAFF>blanco</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "¿Un bigote de crema batida? Tradicional, pero delicioso. ¡Aprobado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Bueno, ya que este mapa de recuerdo es tuyo, {NICKNAME}, puedes pintar tantos bigotes de distintos sabores como quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Jeje, parece un mapa delicioso. ¡Cuidaremos bien de él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "¡Qué bien que les guste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Ya has perfeccionado todos los aspectos del parque temático, ¡así que espero que ahora puedan olvidar el cansancio del trabajo y divertirse a tope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
