			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "#¡Oye, foraster{F#a}{M#o}! ¿Estás interesad{F#a}{M#o} en un combate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "#Soy {F#una guerrera curtida}{M#un guerrero curtido} en mil batallas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "Muy bien, sabía que estaba en lo correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "Pasa que, al parecer, de nuevo hay personas organizando un Club del combate en secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "¿Club del tomate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "No, combate, club del combate. ¿Qué es un club del tomate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "Alguna vez hubo cierta ceremonia tradicional que solía transmitirse entre los miembros de la Secta Tengu, quienes pretendían imitar a los tengu. En pocas palabras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "Cuando los tiempos eran malos, cuando el estado de ánimo estaba bajo, cuando había un acontecimiento feliz que celebrar o cuando simplemente uno estaba aburrido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "Ellos lo daban todo en la pelea para celebrar o para alejar la mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "Parece que se puede organizar en cualquier momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "Parece ser que sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "En fin, hablemos en otro lado. No deberíamos hacerlo aquí. Hay mucha gente en la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "Te escucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "¿Tienes un encargo para mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "No lo llamaría un encargo. En realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "Llegamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "Solo tenemos que atravesar esa puerta que parece sospechosa y entraremos en la arena del Club del combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "¡Qué emoción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Aunque prohibieron a la Secta Tengu hace tiempo por ir en contra del orden público y la integridad moral, todavía hay gente que de vez en cuando organiza en secreto encuentros del Club del combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "Monstruos, aventureros y guerreros sedientos de lucha de todos los rincones siempre se han sentido atraídos por una lucha apasionada en esta arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "Puedes participar en batallas con compañeros que tengan intereses similares. Al fin y al cabo, cuantos más sean, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "Te ves como alguien que ha recorrido el mundo, así que seguro que tienes amigos que quieran acompañarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "¿Tú no participas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "¿Yo? Participaré como espectador y te animaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "En realidad, mi objetivo es escribir la novela de lucha más emocionante y ganar el premio del concurso “¡Esta novela es genial!”, de la Editorial Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "Además, mi instinto me dice que vas a ser la estrella más brillante en la arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "¡Venceré a quien se interponga con un solo dedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "#Ya he pensado en un nombre para la novela, se llamará «El Club del combate: El encuentro de artes marciales más grandioso». Si algún día encuentras el libro en la Editorial Yae, seguro que aparecerá en él {F#una forastera}{M#un forastero} formidable de cabello rubio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "Muéstrame lo que tienes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "Odio perder más que nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "Ciertamente, se ve muy sospechosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}