			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Muchas gracias. Pensé que era mi fin... Un grupo de Ladrones de Tesoros me ha estado siguiendo todo este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Justo cuando logré avanzar un poco en mi investigación y estaba pensando en llevarme el tesoro que hay por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "los Ladrones de Tesoros invadieron mi campamento, me atraparon y me trajeron aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Me interrogaron sobre la ubicación del tesoro y me amenazaron con quitarme la vida si me negaba a decírselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Pero si se lo hubiera dicho, seguramente habría sido mi fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*Suspira*, debería haber escuchado a Soraya. Ella siempre insiste en que los arqueólogos deben centrarse en los resultados académicos en lugar de los tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Pero es que no tengo tanto dinero. Unos pocos ensayos no serán suficientes para cubrir mis gastos de viaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "No sé cómo es que Soraya logró quedarse sola en Liyue durante todo este tiempo. Con solo mirar su montón de manuscritos rechazados me siento exhausta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "¿Qué planeas hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "No sé, ya terminé de recopilar mi material de investigación. En cuanto al tesoro... es de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "No les repetiré el proceso por el que acabé aquí. Lo único que deben saber es que el tesoro está enterrado <color=#00E1FFFF>debajo de ese árbol dorado gigante</color> en medio del Paso Lingju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Ve por él si lo quieres. Te escribiré su ubicación para que no lo olvides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Yo descansaré un rato y luego regresaré a mi campamento para recoger mis cosas. Tengo que salir de aquí lo antes posible para que no vengan más Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "No tengo idea de cuánto tiempo tomará llegar a la Posada Wangshu desde aquí. Solo espero que Soraya no se haya ido para cuando llegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*Suspira*, ojalá ella pueda ser mi tutora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
