						751030210,
						751030211
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030210,
					"content": "Ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030215
					]
				},
				{
					"id": 751030215,
					"content": "Quizá no lo hayan visto porque estábamos demasiado lejos. Pero en cuanto las empujen hacia la orilla, ¡vendrán a por el pescado al instante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030216
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030216,
					"content": "¿Así que podrían repetir lo de la otra vez y atraer a esas aves fluyecorriente hacia la orilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030217
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030217,
					"content": "#Claro, no hay problema. ¡Nosotr{F#as}{M#os} nos encargamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030211,
