			"dialogs": [
				{
					"id": 751030801,
					"content": "Guau, ¡cuánto pescado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "Un momento, no lo toquen. ¡Está para atraer a las aves fluyecorriente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "¿Eh? ¿Y eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Sí, es que estoy aquí con Iwai esperando a que suban a la orilla. Nos aburríamos y no sabíamos qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Vamos, Iwai es un buen chico. Hay que tener paciencia, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "La idea era venir aquí a jugar, ya que, aparte de Rongo, pocos pisan este lugar. Es nuestra base secreta... o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Pero no esperábamos que hoy se nos fueran a adelantar estas aves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Por eso preparé todo este pescado como cebo. ¡No sabes cuánto les gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Pero aquí no veo ningún ave fluyecorriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Ya, quizá es porque estamos demasiado lejos y no les ha llegado el olor. Si hubiera otra forma de que se acercaran a la orilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "*Suspira*, si Rongo estuviera aquí, seguro que propondría <color=#00E1FFFF>empujarlas hacia la orilla</color>... Pero Iwai y yo no tenemos mucha fuerza. Lo más probable es que salgamos volando nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Humm... {NICKNAME}, ¿lo intentamos nosotr{F#as}{M#os}? ¡Quizá si las guiamos hacia la orilla, pongan sus ojos en el pescado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Ya veo. En realidad, Paimon es el ave que estaban esperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Es redondita, le atrae el pescado... Pues sí, sí que se parece a un ave fluyecorriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "¡Mmm! ¡Mmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "¡Pero bueno! De todos modos, aquí no hay ningún ave fluyecorriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
