			"dialogs": [
				{
					"id": 751030101,
					"content": "¡Guau, cuánto pescado! ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#¿Hmm? Oh, hola, amig{F#a}{M#o} de pelo rubio y... ¿amiguita de pelo blanco? Supongo que eres más pequeña que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Estoy aquí con Iwai esperando a que las aves fluyecorriente suban a la orilla. Nos aburríamos y no sabíamos qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "¿Para qué quieren que suban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Vamos, Iwai es un buen chico. Hay que tener paciencia, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Solimos venir aquí a jugar. Aparte de Rongo, no suele haber nadie en este lugar, ¡así que es como nuestra base secreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Pero no esperábamos que hoy se nos fueran a adelantar estas aves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Por eso preparé todo este pescado como cebo. ¡No sabes cuánto les gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Pero aquí no veo ningún ave fluyecorriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Ya, quizá es porque estamos demasiado lejos y no les ha llegado el olor. Si hubiera otra forma de que se acercaran a la orilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "*Suspira*, si Rongo estuviera aquí, seguro que propondría <color=#00E1FFFF>empujarlas hacia la orilla</color>... Pero Iwai y yo no tenemos mucha fuerza. Lo más probable es que salgamos volando nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Humm... {NICKNAME}, ¿lo intentamos nosotr{F#as}{M#os}? ¡Quizá si las guiamos hacia la orilla, pongan sus ojos en el pescado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Ya veo. En realidad, Paimon es el ave que estaban esperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Es redondita, le atrae el pescado... Pues sí, sí que se parece a un ave fluyecorriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "¡Mmm! ¡Mmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "¡Pero bueno! De todos modos, aquí no hay ningún ave fluyecorriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
