					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530701,
					"content": "Esta huella de garras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530702,
					"content": "A partir de ellas podemos saber la cantidad y el tamaño de los lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530703,
					"content": "Esta vez había al menos dos lobos, y... y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530704,
					"content": "¿Y qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Sí, sí... ¡Deben medir al menos... dos metros de altura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "... Paimon, sabes lo que es un lobo, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "¡Oye! Los lobos son criaturas misteriosas. ¡Ni que se vieran todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45308,
