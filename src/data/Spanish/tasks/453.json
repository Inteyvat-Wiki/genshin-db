			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530801,
					"content": "Este es un diente de lobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "Se le debió caer cuando se abalanzó contra la puerta y se estrelló.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Yo creo que simplemente le faltaba calcio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "Por suerte, nadie en el pueblo resultó gravemente herido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
