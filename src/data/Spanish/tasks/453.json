				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "¡Por Los Siete! Esto es horrible. Pobre, ni siquiera puede ponerse de pie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530102,
					"content": "¡Qué terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530103,
					"content": "Un momento... No está herido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530104,
					"content": "Exacto. Es terrible... Los lobos lo asustaron tanto que está paralizado del miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530105,
					"content": "Eso es... realmente horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530106,
					"content": "¿Recuerdas algún detalle de lo que viste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530107,
					"content": "Nunca había visto un lobo en mi vida hasta hoy. Fue aterrador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530108,
					"content": "... Sin detalles, entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530109,
					"content": "Investiguemos el área de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
						],
						"stepId": 45305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Pelaje de lobo... Escuché que en Liyue hacen pinceles de caligrafía con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "El color no se parece en nada al pelaje de los lobos de Mondstadt, según lo que dicen los libros. ¿Serán lobos de fuera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "Los lobos tienen varios tipos de pelo dependiendo de la parte del cuerpo y, además, son de tonalidades diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Cierto, pero mira esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "Otro pelo. Pero este tiene algo pegado a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Una semilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "Es una semilla de gancho de lobo. Mira, tiene pequeños ganchos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Los únicos lugares de Mondstadt donde crecen son en el Reino de los Lobos y el Cañón Coronabrillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Entonces, ¿son lobos del Reino de los Lobos, después de todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Sí, son de esa zona. Pero puede que otras manadas de lobos estén invadiendo su territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "No podemos llegar a ninguna conclusión, pero al menos tenemos una pista importante. Es suficiente para comenzar a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Iré a ver a los aldeanos antes de partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "¿Tiene algo de especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
			"id": 45306,
			"completionStepIds": [
				45306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45306",
							"2"
						],
						"stepId": 45306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Maravilloso Hopkins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "¿Cómo va su investigación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530602,
					"content": "¿Qué? ¡Estás de pie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Ya estoy bien. Por suerte, conseguí recuperarme por mí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530604,
					"content": "Entonces, Caballeros de Favonius, ¿qué han descubierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530605,
					"content": "Al inspeccionar el pelaje, podemos confirmar que los lobos vienen del Reino de los Lobos. Aparte de eso, no sabemos nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Pero, por favor, mantenga la calma. Me dirigiré al Reino de los Lobos lo antes posible y llegaré al fondo de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Los Caballeros de Favonius no permitirán que este peligro continúe durante más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Bueno. Supongo que más vale tarde que nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530609,
					"content": "¡Qué grosero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Mientras tanto, solo nos queda hacernos cargo de esto por nuestra cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530611,
					"content": "Por favor, no haga ninguna tontería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "¡Ja! Por aquí las cosas se hacen de otra manera. Es probable que muchos de ustedes, los incompetentes de Favonius, no estén acostumbrados. ¡Esos lobos pagarán por lo que han hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530613,
					"content": "¡Adiós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4530614,
					"content": "Es terrible, realmente terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "¿De qué hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Me refiero al futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Estoy de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Los jóvenes pueden ser muy impulsivos a veces. Si no es mucho pedir, espero que puedan vigilarlos y evitar que se metan en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "No hay problema, para eso estamos aquí. Aunque realmente no es que ese tipo sea muy encantador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "#Déjanoslo a nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "¡Al Reino de los Lobos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45307,
