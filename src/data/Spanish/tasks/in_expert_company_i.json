			"dialogs": [
				{
					"id": 740510301,
					"content": "¡Genial! ¡El kinetoscopio y la kinografía están en perfecto estado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510328,
					"content": "¡Gracias a los Arcontes! Por un momento pensé que tendríamos que grabarlo todo de nuevo desde el comienzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510302,
					"content": "¿Por qué han elegido este sitio para su rodaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "No tienen pinta de ser de Fontaine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510304,
					"content": "Le haré un resumen. Nosotros tres venimos de la Aldea Chiaoying de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510305,
					"content": "La mayoría de la gente en la aldea se dedica al comercio de té, pero a nosotros... las hojas de té nos parecen la cosa más tediosa de todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510306,
					"content": "Es por eso que decidimos cambiarnos de profesión y ayudar a los comerciantes de té de la aldea a grabar kinografías publicitarias de sus productos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510307,
					"content": "Lo que sucedió realmente es que hay tantas personas que se dedican al comercio de té en la aldea que no podíamos competir contra ellos con el negocio que teníamos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Los expertos de nuestra tienda acabaron marchándose uno tras otro para unirse a los negocios de la competencia... Si seguíamos dedicándonos al negocio del té, acabaríamos sin comida que llevarnos a la boca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "¡Ustedes dos nunca dicen nada bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510310,
					"content": "Hemos ganado una buena suma grabando kinografías publicitarias en la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510311,
					"content": "Pero ahora volvemos a tener competencia, y ahora en la aldea hay otras personas que han comenzado a dedicarse a grabar kinografías publicitarias también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Algunos hasta incluyen a artistas de ópera en sus anuncios, tienen un estilo impresionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "Y por eso mismo hemos venido a Fontaine, ¡para encontrar a un experto en kinografías que nos aconseje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510314,
					"content": "Entonces, ustedes han venido a Fontaine para aprender el arte de grabar kinografías.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Exacto. Hemos encontrado a un experto en kinografías que se hace llamar Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510316,
					"content": "Su especialidad es jugar con las luces y las sombras en... ¿En qué las utilizaba?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510317,
					"content": "... En sus narrativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "¡Eso! Queremos aprender a utilizar las luces y las sombras en nuestras narrativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510319,
					"content": "Con los consejos del señor Geisert, ¡grabaremos la mejor kinografía que jamás se haya visto en la Aldea Chiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510320,
					"content": "Jefa, el mes pasado dijo que grabaríamos la mejor kinografía de toda Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "En los negocios, lo mejor es ajustar nuestras expectativas al nivel más cercano posible a la realidad... ¿Entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510322,
					"content": "#Le estamos realmente agradecidos, viajer{F#a}{M#o}. Esta recompensa es para usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, ¡vamos! ¡Ya están tardando en recogerlo todo! Hoy tenemos que terminar de grabar la kinografía de muestra sí o sí, así podremos mostrársela al señor Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510324,
					"content": "¡Presten atención a las luces! La escena debe estar... enfocada hacia el lugar del que provenga la luz. Así tenemos como resultado... ¡una iluminación extremadamente realista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510325,
					"content": "Se leyeron el libro, ¿verdad? La luz debe ser realista, ¿comprenden lo que significa el realismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Directora Chiu"
				},
				{
					"id": 740510326,
					"content": "Jefa, le aseguramos que nos hemos leído el libro de ese tal Geisert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Pero por más que repitamos mil veces esta escena, la luz que aparece en la kinografía sigue sin ser... extremadamente realista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
