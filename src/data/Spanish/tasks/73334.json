			"dialogs": [
				{
					"id": 733340201,
					"content": "Así que este es el aspecto que tienen... Es verdaderamente lamentable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340202,
					"content": "¿Eh? ¿De qué hablas, Sorush?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340203,
					"content": "No es nada. Simplemente, acabo de presenciar el lamentable final de algunas miembros de mi estirpe. Nada del otro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340204,
					"content": "¡Si lo dices así, suena bastante preocupante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340205,
					"content": "¡Deja que Paimon lo vea! ¿Eh? Vaya árbol más raro, ¿no? Tiene forma como de puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340206,
						733340207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340206,
					"content": "¿Y si lo atravesamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733340208
					]
				},
				{
					"id": 733340208,
					"content": "¡Jeje, suena divertido! ¡Paimon, prímer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340209,
					"content": "Los árboles fravashi no son puertas. No puedes entrar sin más, molestarías a las pari que moran en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340210,
					"content": "Así que esto es un árbol fravashi... ¿Y dónde están esas pari? Paimon no las ve por ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340211,
					"content": "Pues claro que no puedes verlas, paliducha flotante. Después de todo, están atrapadas en sus obsesiones del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340212,
					"content": "Puede que no sea lo que ellas deseen, pero verlas aferrarse a la vida de esta manera es... realmente desalentador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340213,
					"content": "Pues a Paimon le parece un árbol muy frondoso, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340214,
					"content": "¡Bah! ¿Y qué sabrás tú, paliducha flotante? Tanto los árboles fravashi como las pari que moran en su interior lucharon por resistir la ponzoña que los consume. Han agotado sus últimas fuerzas en el intento y por eso tienen este aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340215,
					"content": "Se han consumido hasta tal punto que ya no son capaces de mantener su forma original. Han sido rechazadas en el Piélago Floral por la inmundicia que acarrean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340216,
					"content": "Según las leyendas, antiguamente, la Orden de los Escépticos celebraba un ritual de purificación para poder llevar sus almas de vuelta al Piélago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340217,
					"content": "Por desgracia, no queda ningún miembro de la Orden capaz de llevar a cabo el ritual. Ahora, lo único que se puede hacer es mantener los árboles con vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340218,
					"content": "Aunque por su aspecto diría que solo están prolongando su sufrimiento. No creo que les queden más que tormentosos recuerdos de su vida pasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340219,
						733340220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340219,
					"content": "Deberíamos ayudarlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733340221
					]
				},
				{
					"id": 733340221,
					"content": "¡Eso! ¡No podemos dejar que sigan sufriendo! ¡Le parte el corazón a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340222,
					"content": "Aunque comparto el sentimiento, este es precisamente nuestro destino. Tal vez aún desean permanecer aquí, custodiando el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340223,
					"content": "¡¿Eh?! ¡Eso es lo que tú crees, pero tal vez ellas ya no quieran seguir aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340224,
					"content": "Si Paimon estuviera ahí dentro, atrapada y sufriendo, seguro que estaría deseando volver a casa con sus seres queridos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340225,
					"content": "¡No subestimes nuestra tenacidad, paliducha flotante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340226,
					"content": "Bah, está bien. Las despertaré para que puedan escuchar su voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340220,
					"content": "Entonces, hay una forma de salvarlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733340221
					]
				},
				{
					"id": 733340207,
					"content": "Tal vez conduzca a algún lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733340208
					]
				}
			]
		},
