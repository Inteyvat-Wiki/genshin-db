					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340313,
					"content": "Bueno, puede que sean un poco raras, ¡pero no son patéticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340314,
					"content": "Paimon pensaba que te sentirías como en casa viendo todas las plantitas que hay por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733340315,
					"content": "¡Bah! ¡Yo solo me siento en casa en el campo de batalla! ¡Solo aquella batalla que se prolonga hasta el fin de los días puede considerarse la verdadera eternidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733340316
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733340316,
					"content": "Ahora que yo soy la que manda, más te valdría aprendértelo lo antes posible, paliducha flotante.",
					"roleType": "TALK_ROLE_NPC",
