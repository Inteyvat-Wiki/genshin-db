			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "La Cordillera Tianheng... Guía de los Cielos... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "¿En qué estás pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, justamente estaba investigando sobre las historias y leyendas en torno al Rito de la Linterna de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "Escuché que, en esta ocasión, la linterna mingxiao tendrá la forma del Adeptus Guía de los Cielos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Según las leyendas que he recopilado, en algún momento ese Adeptus acompañó a Rex Lapis en una expedición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Los detalles sobre la época y los enemigos a los que se enfrentaron varían de una fuente a otra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "... pero todos los registros y rumores concuerdan en que este Adeptus se sacrificó. Además, dicen que utilizó sus astas como punto de apoyo de la Cordillera Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "Por eso vine a hacer una investigación de campo. Pensé que, con algo de suerte, quizás podría encontrar algo de valor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Pero en la Cordillera Tianheng hay muchos monstruos. No me di cuenta de que están por todas partes hasta que delimité el lugar de mi investigación. Básicamente, es imposible acceder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a inspeccionar el lugar y traerme unas muestras geológicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Muestras geo... ¿qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Ah, es un término de la Academia de Sumeru. Es solo un poco de tierra de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Después de todo, según las leyendas de Liyue, Guía de los Cielos usó sus propias astas para sostener la Cordillera Tianheng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "Desde un punto de vista académico, tiene sentido que la tierra de este lugar tenga componentes inusuales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Así que ¿podrías recoger un poco de tierra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
