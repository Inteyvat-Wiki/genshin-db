		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "¿Trajiste la muestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220302,
					"content": "Aquí la tengo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Buen trabajo. Déjame ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220304,
					"content": "... Humm. Todo indica que esta tierra no tiene nada de particular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220305,
					"content": "¿Qué querías descubrir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "De acuerdo con las leyendas, Guía de los Cielos utilizó sus resistentes astas para sostener la Cordillera Tianheng, que estaba al borde del colapso, y así proteger Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220307,
					"content": "Pensé que al menos descubriría un fragmento de las astas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220308,
					"content": "Bueno, son solo leyendas... ¿O quizás esa guerra ocurrió hace tanto tiempo que ya no quedan restos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220309,
					"content": "En fin, hiciste un gran trabajo en ir hasta allí para traer una muestra de tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220310,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ayudarme con una última excursión? Quisiera subir un poco más. Prometo que no será muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220311,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "Ahora... quiero que vayas a un punto alto desde el cual puedas ver la Cordillera Tianheng para que hagas un reconocimiento topográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220314,
					"content": "Según las leyendas, Rex Lapis y otros muchos Adeptus participaron en aquella guerra, y por poco hicieron que la Cordillera Tianheng colapsara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220315,
					"content": "Si fue una batalla tan violenta, quizás pueda encontrar algunos indicios en la topografía del lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220312,
					"content": "¿Qué quieres buscar ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "Este camino es muy escabroso y está repleto de monstruos, pero al fin llegamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220602,
					"content": "La geografía de este lugar... Parece que tampoco tiene nada de especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220603,
					"content": "¿Eh? ¿Qué es eso que está colgado del árbol? ¿Una... linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220604,
					"content": "¿Cómo es posible? ¿Tal vez alguien vino a dejarle una ofrenda a ese Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220605,
					"content": "Veamos qué tiene escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220606,
					"content": "“Que la paz reine durante mil generaciones, y que todo bajo el cielo prospere”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220607,
					"content": "Es un deseo muy noble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "Ciertamente. Pero... este deseo... ¿Cómo explicarlo? Es demasiado ambicioso. No parece que sea un deseo, ni mucho menos una plegaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220610,
					"content": "Más bien suena a uno de esos deseos que se solían pedir a los Adeptus en las leyendas de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220611,
					"content": "¿Quién escribiría un deseo así en una linterna celeste? Qué extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220612,
					"content": "Humm... En fin, no importa. Al menos hay gente que todavía se acuerda de venir aquí a liberar linternas. Ese Adeptus debe estar muy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220613,
					"content": "Gracias por acompañarme hasta aquí. Quisiera quedarme a investigar un poco más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220614,
					"content": "Ah, por cierto, toma esto. Considéralo como tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220615,
					"content": "*Suspira*, hay tantas leyendas en Liyue, pero no he logrado progresar para nada en mi investigación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220608,
					"content": "Parece que no vino a rezar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}