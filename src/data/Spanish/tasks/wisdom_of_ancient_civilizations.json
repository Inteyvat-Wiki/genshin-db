			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "#¡Saludos! Soy Timaeus, investigador de alquimia. ¡Bienvenid{F#a}{M#o} a la ciudad de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "¿Alquimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "La alquimia es un oficio que se ha transmitido desde la antigüedad, pero apenas se entiende en el presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Sus mecanismos son mágicos y misteriosos, completamente diferentes a los principios que dan forma a nuestra comprensión del mundo físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Si logramos dominar la alquimia, ¡podremos crear cosas geniales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "Esta debe ser tu mesa de trabajo de alquimista, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Efectivamente. ¿Por qué no la pruebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "No sé, suena complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "No es para tanto. El procedimiento es muy sencillo. Si te interesa, te puedo enseñar lo básico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Sintetizar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Me da miedo explotar algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050602",
							"2"
						],
						"stepId": 2050602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060202,
					"content": "Realmente, lo único que estamos haciendo es seguir los métodos de los antiguos lo mejor que podemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060203,
					"content": "Es como alguien que usa planeador: no necesita entender cómo se construyeron para volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060204,
					"content": "La diferencia con la alquimia es que, cada vez que creo entender su funcionamiento, sucede algo totalmente inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060205,
					"content": "¿Qué otros usos tiene la alquimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "Sinceramente, no lo sé. Pero es justo eso lo que la hace tan interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060210,
					"content": "Hay muchas otras recetas misteriosas que tengo que investigar primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060211,
					"content": "En el transcurso de tus aventuras, seguramente encontrarás algunas notas de alquimistas de civilizaciones antiguas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060212,
					"content": "Y, a medida que aumente tu Rango de Aventura, habrá más recetas disponibles para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060213,
					"content": "Gracias por la explicación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "De nada. ¡Espero escuchar más sobre tus hazañas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060218,
					"content": "Bueno, hasta la próxima. Que el viento te traiga buena suerte en tu camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060215,
					"content": "#La próxima vez que nos veamos, seré {F#una maga}{M#un mago} conjura-Paimonas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "#¿Por qué estás tan obsesionad{F#a}{M#o} con otras Paimonas? ¿Es que no estás content{F#a}{M#o} conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060217,
					"content": "Jaja... Ustedes dos son una pareja fascinante, debo decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060207,
					"content": "¿Puedes conjurar una nueva Paimon usando alquimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "¡Oye! ¡Una Paimon es más que suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060209,
					"content": "¡Jajaja! Lamentablemente, mis habilidades no son tan avanzadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}