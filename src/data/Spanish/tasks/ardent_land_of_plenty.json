			"dialogs": [
				{
					"id": 150180201,
					"content": "Así que tú eres Varesa. ¡Ya habíamos oído ese nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Est{F#a}{M#e} es {NICKNAME}, y Paimon es Paimon, la mejor compañera de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#Está bien, Paimon y {NICKNAME}. Son buenos nombres, los recordaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "¡Pues en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
