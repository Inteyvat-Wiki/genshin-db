					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "¡Por fin hemos llegado! Este es el asentamiento de la Comunidad de la Feracidad, o lo que es lo mismo, mi hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "¡Vaya, esa plataforma con forma de cabeza de toro es espectacular! ¡A Paimon le encanta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Jeje, esa es la Arena Reverberante, donde organizamos todo tipo de competiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Gracias por traernos hasta aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "De nada, de nada. ¡Ni lo menciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "#Me gustaría poder acompañarl{F#a}{M#o}s a dar una vuelta por la zona, pero tengo que volver a casa antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "¿Te has acordado de algo importante? Antes, cuando aparecieron los Hilichurls, parecías tener mucha prisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Espero que no hayamos retrasado tus planes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "¡No, para nada, hemos llegado justo a tiempo! Aunque sí que se trata de un asunto de gran magnitud. Lo más importante después de entrenar es... ¡comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "#Si tienen hambre, se quedarán sin fuerzas, se sentirán maread{F#a}{M#o}s, desorientad{F#a}{M#o}s y la mente se les llenará de sinsentidos. Son muchos contras, así que tienen que estar alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Lo siento mucho, pero ¡debo comer sin falta ya, ahora, inmediatamente! Ustedes también deberían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Podemos reencontrarnos después en la Arena Reverberante. ¡Hasta luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Varesa se ha marchado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Humm, qué chica tan asombrosa. A veces actúa con mucha calma, y de un momento a otro, le da un arrebato y se va a la carrera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "Eso es lo que se conoce como “juventud”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "#“Eso es lo que se conoce como ‘juventud’”... ¿Qué haces hablando como si fueras un{F#a} abuel{F#a}{M#o}? ¡Aún somos jóvenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Bueno, ya que se ha marchado a casa, ¿por qué no nos damos una vuelta primero? Luego podemos ir a la Arena Reverberante a esperarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "Con lo elevada que está, ¡las vistas deben ser alucinantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}