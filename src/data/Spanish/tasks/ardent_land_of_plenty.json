			"dialogs": [
				{
					"id": 150180301,
					"content": "Hola, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "¿Sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "¿Se han perdido? ¿Necesitan ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "No, no, tan solo pasábamos por aquí. Queremos ir a la Comunidad de la Feracidad... ¿Vamos por la dirección correcta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "#Así es. Yo vivo allí, así que si lo necesitan, puedo llevarl{F#a}{M#o}s ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#¡Genial! {NICKNAME}, ¡hemos vuelto a encontrar a una guía local!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "Dijo la guía que nunca hace su trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Una guía... Supongo que puedo hacerlo. Jeje, de acuerdo, seré su guía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "El camino está repleto de paisajes especiales, así que podré mostrárselos. Casi todos los visitantes que llegan aquí suelen quedarse en plan “Guaaau”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Gracias, es muy amable de tu parte, pero un momento... Has aceptado muy rápido, y Paimon se siente algo culpable... Eh, ¿seguro que no hay problema? ¿No estamos interrumpiendo lo que estabas haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "No es nada, ¡de verdad! Había venido aquí a entrenar, y justo me estaba preparando para recoger mis cosas y volver a casa, así que no es ningún inconveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "#Además, si les hago de guía, podrán entender mejor nuestras costumbres, aprenderán mucho y quedarán muy content{F#a}{M#o}s, ¿a que sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "#Y si están content{F#a}{M#o}s, yo también lo estaré. El Sr. Acatl dice que así es como se trata a los invitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "E-está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Parece una chica muy amigable y hospitalaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Hemos tenido mucha suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Sí, Paimon también lo piensa. ¡A Paimon le gusta mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "#¿Qué tal? Si ya están list{F#a}{M#o}s, podemos partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Por cierto, aún no sabemos cómo te llamas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Oh, sí, soy Varesa. ¡Mucho gusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
