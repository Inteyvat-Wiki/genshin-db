			},
			"dialogs": [
				{
					"id": 150180501,
					"content": "#Est{F#a}{M#e} es {NICKNAME}, y Paimon es Paimon, la mejor compañera de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180502,
					"content": "#Está bien, Paimon y {NICKNAME}. Son buenos nombres, los recordaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180503,
					"content": "¡Pues en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
