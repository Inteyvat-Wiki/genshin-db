			"dialogs": [
				{
					"id": 726770701,
					"content": "#¡Qué impresionante, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770702,
					"content": "No estuvo tan mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "¿Ustedes luchan mucho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770705,
					"content": "Humm... Pensándolo bien, aunque el objetivo de nuestros viajes es encontrar a un familiar perdido, siempre nos encontramos con batallas en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "Pero no pasa nada. Disfruto las batallas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Humm... Si bien es bueno tener espíritu de lucha, es mejor no hacer de ello un pasatiempo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#Cuando yo convierta en gran tanuki, quiero ser impresionante como {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770711,
					"content": "¡No tendrás problemas, Kichiboushi! Pero tienes que prometerle algo a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770713,
					"content": "Humm... *Ejem*, no debes intimidar a los débiles aunque acabes convirtiéndote en un rey tanuki más poderoso que Ioroi. Además, tampoco te dediques a buscar pelea por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#No puedes ser como esa flor llameante que aparece y se retuerce escupiendo fuego cuando ve a {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Entonces, ¿cuándo puedo luchar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770716,
					"content": "Cuando tengas que protegerte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Oh... No entender realmente, pero lo prometo, Paimon. No intimidar a los débiles, no buscar pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770720,
					"content": "Eres bueno, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "El próximo... es el último de los ocho lugares que Ioroi nos pidió visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770717,
					"content": "Cuando tengas que proteger a otros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Cuando tengas que defender lo correcto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Luchar es un dolor de cabeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Sí, pero hay momentos en los que es necesario tomar las armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770703,
					"content": "He luchado contra este tipo de cosas muchas veces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
		},
