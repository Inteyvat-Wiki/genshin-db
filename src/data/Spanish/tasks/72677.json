					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770403,
					"content": "¿Ooh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770404,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "Si fuera una pintura, tomaría más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770406,
					"content": "Así que elegir capturar imágenes en lugar de pintar no es por falta de sentimiento, sino por consideración. ¡Es consideración por los demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770407,
					"content": "¡Se hace con esa intención!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "Entiendo. Imagen, sí. Mucho calor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770411,
					"content": "Tenemos que deshacernos de la fuente de calor lo antes posible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "Ayayay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770408,
					"content": "¡Eso no tiene sentido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "Tiene sentido, pero hace mucho calor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
