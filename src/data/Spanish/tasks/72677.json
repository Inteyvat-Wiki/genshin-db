			"dialogs": [
				{
					"id": 726771001,
					"content": "La vista desde aquí es especial, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771002,
					"content": "Mucha agua y colores especiales, ¡sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771003,
					"content": "El vocabulario de Paimon es tan escaso como el de Kichiboushi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#¡Pero es realmente especial! ¿Tú cómo describirías este color, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Un color que converge con el elemento Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "¿Qué rayos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "Pero, sí, la vista es realmente especial. Hace que Paimon la quiera pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "¿Paimon, sabes pintar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "¡¿Acaso no se puede aprender?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Pintar... pero es difícil pintar. Hace tiempo, a Utamarou le tomaba una eternidad hacer una pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771017,
					"content": "¿Por qué la gente quiere pintar si puede capturar imágenes en vez de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771018,
					"content": "#Humm... Cierto, {NICKNAME}, ¿por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Porque quieres crear algo que sea solo para ti, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "A Paimon le suena razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Además, hay mucho sentimiento en lo que pinta uno mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Sí, debe ser un trabajo duro plasmar lo que tienes en mente trazo por trazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Humm... Entonces, ¿tomar fotos de Kichiboushi es fácil y sin sentimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771027,
					"content": "Oh, no es así. Lo que pasa es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Se necesita tiempo para pintar algo, así que es muy cansado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "¡Exacto! Lleva mucho tiempo pintar, y te cansarías si mantuvieras una sola pose todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "Cuando estar sellado y convertido en piedra, siempre la pasaba de pie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726771031,
					"content": "Así que, después de romper sello, mis pies doloridos por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
