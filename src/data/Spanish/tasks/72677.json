			"dialogs": [
				{
					"id": 726770101,
					"content": "La vista desde aquí es especial, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Mucha agua y colores especiales, ¡sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770103,
					"content": "El vocabulario de Paimon es tan escaso como el de Kichiboushi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#¡Pero es realmente especial! ¿Tú cómo describirías este color, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Un color que converge con el elemento Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "¿Qué rayos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Pero, sí, la vista es realmente especial aquí. {NICKNAME}, ¿recuerdas a aquel artista de hace tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "¿Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "¡Correcto! ¡Ese es! ¿No es al que ayudamos a colocar esas perlas brillantes en las estatuas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "¡Y nos regaló un cuadro al final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "¿Esto es lo que buscabas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "¡Sí, eso es! ¡Mira, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "¡Ah! ¿Es una imagen capturada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770122,
					"content": "No, fue pintada por alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "¿Eh? Pero... ¿Por qué pintar una imagen si se puede capturar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770124,
					"content": "#Humm... Cierto, {NICKNAME}, ¿por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Porque quieres crear algo que sea solo para ti, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "A Paimon le suena razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Además, hay mucho sentimiento en lo que pinta uno mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Sí, debe ser un trabajo duro plasmar lo que tienes en mente trazo por trazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Humm... Entonces, ¿tomar fotos de Kichiboushi es fácil y sin sentimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770133,
					"content": "Oh, no es así. Lo que pasa es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Se necesita tiempo para pintar algo, así que es muy cansado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "¡Exacto! Lleva mucho tiempo pintar, y te cansarías si mantuvieras una sola pose todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Cuando estar sellado y convertido en piedra, siempre la pasaba de pie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770137,
					"content": "Así que, después de romper sello, mis pies doloridos por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770138,
					"content": "¡Guau! ¡Eso debe haber sido muy duro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Pero Paimon volar. Nunca tiene pies cansados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770140,
					"content": "*Ejem*, aunque no lo creas, volar cansa todo el cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "¡Oh! ¡Una flor en llamas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770142,
					"content": "Presta más atención cuando te hablamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "¿Es una flor llameante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Oh, sí. Paimon no cree haber visto muchas flores llameantes en el Bosque Chinju...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "¿Quieres una, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "¡Sí! Parece muy cálida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770147,
					"content": "#¡Que {NICKNAME} consiga algunas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, Kichiboushi quiere. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770149,
					"content": "¿Así hablan los tanuki...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Porque un Daguerrotipo es muy caro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "¡Oh! ¿Es muy caro? Entonces, ¿no nos estamos arriesgando a que se rompa al luchar, nadar, escalar, y hasta caernos de las montañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Oh, vaya, hay que tener cuidado a partir de ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "¿Quién?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "¡Es Vermeer! ¿No recuerdas esa vez cuando le ayudamos a colocar esas perlas brillantes en las estatuas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "¿Un color que converge con el elemento Anemo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "El vocabulario de Paimon es tan rico como el de Kichiboushi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "¡Tan bueno como el de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770110,
					"content": "#Humm... Puede que {NICKNAME} no haya querido decir eso, pero de todos modos... ¡Kichiboushi es simplemente brillante! ¡Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "¡Es realmente especial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#¿Eh? No me digas que tu vocabulario se ha vuelto igual de escaso, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
