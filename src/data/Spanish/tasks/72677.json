			},
			"dialogs": [
				{
					"id": 726770301,
					"content": "¡Tan grande! ¡Tan caliente! ¡Sorprendente, una flor tan grande en llamas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770302,
					"content": "¿Cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Un momento, Kichiboushi, ¡capturaremos tu imagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "¿En un lugar en el que hace tanto calor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "¡Por eso mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770306,
					"content": "Ayayay... Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
