				{
					"id": 726770806,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770807
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726770807,
					"content": "Podemos llevar a Kichiboushi a ver una flor llameante muy grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770808
					]
				},
				{
					"id": 726770808,
					"content": "Oh, te refieres a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770809,
						726770810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770809,
					"content": "Cerca de aquí hay una Regisvid Pyro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				},
				{
					"id": 726770811,
					"content": "¡Sí! ¡Consideremos que esto es el entrenamiento de hoy de Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770810,
