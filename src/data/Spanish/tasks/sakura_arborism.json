			"dialogs": [
				{
					"id": 721230801,
					"content": "El daño causado a los Cerezos del Trueno son una deshonra para el santuario. Necesitamos llegar al fondo de esto, y rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
