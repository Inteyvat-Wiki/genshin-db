				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "Por cierto, ¿sabes dónde están los Cerezos del Trueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "#A juzgar por tu reacción, parece que no sabes dónde están los Cerezos del Trueno. Bueno, es normal, al fin y al cabo eres foraster{F#a}{M#o}. Es culpa mía por darlo por sentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "Los cinco Cerezos del Trueno son fáciles de encontrar. Solo tienes que seguir <color=#00E1FFFF>la costa oeste</color> a partir <color=#00E1FFFF>del punto más septentrional</color> de la isla, donde está el Cuartel Kujou, y caminar <color=#00E1FFFF>al punto más septentrional de Tatarasuna</color>. Con eso habrás encontrado tres de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Los dos Cerezos del Trueno restantes están en Tatarasuna, uno en la <color=#00E1FFFF>montaña del noroeste</color> y el otro en la <color=#00E1FFFF>montaña del suroeste</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "Ahora que tienes la direcciones, no debería ser muy difícil. Dejo en tus manos el asunto de los Cerezos del Trueno. ¡Ten mucho cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
	]
}