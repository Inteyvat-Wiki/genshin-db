	"talks": [
		{
			"id": 7212302,
			"completionStepIds": [
				7212305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "¡P-por favor, no me mates! No he tenido nada que ver con los Cerezos del Trueno, ¡lo juro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "¿Y cómo sabías que estábamos aquí por los Cerezos del Trueno? Claramente, ¡te sientes culpable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon apuesta a que conseguiste esa cosa que se parece al Hipóstasis Electro en algún trato sucio, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "¿Y por qué quieren saberlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Forma parte de mi trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "¡Así es! ¡Nos pidieron que hiciéramos justicia! Haremos que nos digas lo que los Ladrones de Tesoros pretenden hacer con los Cerezos del Trueno, y de dónde has sacado esta cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "#Y si no hablas... Jeje, ¡probarás la espada de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "¡Está bien, hablaré! De todas formas, no es que a alguien le importen esos árboles... ¿No pueden un hombre y sus compañeros ganar algo de dinero a costa de su poder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Tuvimos un comprador importante que se interesó por estos árboles, e incluso nos proporcionó los medios y las herramientas para extraer su energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Siempre que hiciéramos lo que decían y abriéramos un hueco en esos árboles, podríamos utilizar unas herramientas para recoger el poder de los Cerezos del Trueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Entonces, lo único que tendríamos que hacer es dirigir ese poder hacia este cristal y listo, ¡tendríamos algo que valdría igual que tres mansiones de la Comisión Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "¡También nos dieron una gran suma de dinero! Tanto que alguien como ustedes no podría gastárselo en la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Si dejan que me vaya, les daré una parte de la recompensa. El diez por ciento para ustedes y el noventa para nosotros. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Demasiado poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "¿Qué? ¿Sabes qué? No voy a dejar que te salgas con la tuya. Cuando llegue nuestro comprador, ¡serás tú quien me pida clemencia a mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Paimon cree que hablas demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Escúchame, cosa flotante, mis compañeros vendrán a rescatarme en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "#No importa a quién llames ni a cuántos. No tocarás ni un pelo de la cabeza de Paimon antes de que {NICKNAME} los mande a todos a correr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Yamada, ¿escuchaste eso? ¡Esta cosa flotante dijo que no puedes hacerle daño! ¿Vas a quedarte de brazos cruzados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "#¿Yamada? ¿Quién es? {NICKNAME}, ¡rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "¿Eh? No hay nadie allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Sigue soñando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "¿Descubriste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "Sobre Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Así que esa es la situación... Pero los Ladrones de Tesoros no son más que ladrones de poca monta. ¿Realmente son capaces de causar tanto alboroto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Sospecho que debe haber otros motivos por los que los Cerezos del Trueno se están marchitando... Tengo mis sospechas, pero no puedo asegurarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Estamos en Kannazuka, donde ni la fe de Inazuma ni la de Sangonomiya tienen ninguna influencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Desde que se promulgó el Decreto de captura de Visiones, aquí suelen estallar conflictos entre el Ejército de la Shogun y los rebeldes. No creo que a ninguno de los dos bandos les importe que los Cerezos del Trueno sufran daños colaterales por su guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Para citar a la Srta. Yae Miko: “Los honores y los elogios son lo único que les importa a los militares”. No atienden a la razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "Estábamos bien preparados para esto, pero no esperábamos que los Cerezos del Trueno estuvieran en un estado tan preocupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "#En fin, en este momento, lo más urgente es expulsar a esos Ladrones de Tesoros. Viajer{F#a}{M#o}, ¿puedo confiarte esta tarea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Por favor, no te descuides. El debilitamiento de los Cerezos del Trueno hace que la situación sea muy peligrosa. Después de todo, estos árboles sirven para contener a aquel que yace bajo tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Ah, estoy hablando de más... P-por favor, olvida que dije eso. En resumen, te ruego que procedas con extrema preocupación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "También necesito algo de tiempo para trabajar en mis descubrimientos. Una de las principales preguntas pendientes es: ¿quién mueve las cuerdas de los Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Este caso se pone cada vez más complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Suena bastante sencillo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Me temo que no será tan sencillo como supones. El debilitamiento de los Cerezos del Trueno hace que la situación sea muy peligrosa. Después de todo, estos árboles sirven para contener a aquel que yace bajo tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212314",
							"2"
						],
						"stepId": 7212314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "¿Cómo están los Cerezos del Trueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "Ya me encargué de esos objetos extraños.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Maravilloso. Eso al menos estabilizará a los Cerezos del Trueno. Estoy segura de que la Srta. Yae Miko también se sentirá aliviada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "¿Cómo se atreven estos criminales a robar tan descaradamente el poder de los Cerezos del Trueno para su propio beneficio? Sus acciones son imperdonables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "También mencionaste que encontraste un cristal de energía formado por el poder del Cerezo del Trueno en el campamento de los Ladrones de Tesoros, ¿verdad? Eso es increíblemente peligroso. Debemos encargarnos de él tan pronto como sea posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "Ya me has ayudado muchísimo, así que no podría pedirte que te ocupes de esto por tu cuenta una vez más. Me uniré a ti esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "No hay tiempo que perder. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212315",
							"2"
						],
						"stepId": 7212315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "¡Hum! Así que eres tú, una miko, la que se interpone en nuestro camino para hacer dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "¿Hacer dinero? Sinvergüenzas. ¿Cómo se atreven a planear algo contra los Cerezos del Trueno? La Srta. Yae Miko no dejará que salgan libres de esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Gran discurso, pero ¿acaso han olvidado con quién se están metiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "#Jefe, {F#esa viajera es la}{M#ese viajero es el} que se interpone en sus negocios. Si no hace algo, nuestro trato no podrá formalizarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Jaja, ¿cómo te atreves a actuar así delante de mí siendo tan débil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldado Fatui"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212317",
							"2"
						],
						"stepId": 7212317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "¡Ay! Qué suerte la mía, metiéndome en una situación así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Villanos sinvergüenzas. Conspirando con los Fatui... la Gran Narukami los castigará a todos tarde o temprano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "¡No intentes intimidarme! ¡No pienses que has conseguido algo al meterte donde no te llaman! ¡Todavía tengo un as en la manga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212319",
							"2"
						],
						"stepId": 7212319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "Deja de perseguirme, por favor... Ya hemos hecho esto tres veces, apenas puedo caminar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Viles desgraciados, ¡conspiran con los forasteros para sacar provecho! No habría piedad para ustedes aunque hiciéramos otros diez asaltos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "#Uf... Viajer{F#a}{M#o}, a juzgar por tu relajada mirada, supongo que has solucionado el problema. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "El poder de los Cerezos del Trueno no puede caer en manos de esta calaña, y mucho menos entregarse a los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "No sé qué traman los Fatui, pero ya que hemos capturado a este vasallo suyo, me aseguraré de que responda a mis preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Deja lo demás en mis manos. Conozco bien las ubicaciones del ejército de la Shogun. Este hombre no escapará sin un castigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212308,
