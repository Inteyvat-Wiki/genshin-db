				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "¿Cómo va la pintura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "He estado pintando aquí al lado de esas dos estatuas desde que sus ojos se iluminaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Pero... ¿cómo decirlo? No he podido pintar el cuadro perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Parece que algo le falta, ¿sabes de qué estoy hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "Es como si usáramos los ingredientes correctos y los preparáramos correctamente, pero, aun así, algo le falta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Es una sensación que no sé cómo expresar, ni cómo comprenderla, así que solo me queda seguir pintando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Puedes reírte de mí si quieres, me siento mareado de tanto pintar. Debería darme un descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Pero cada vez que cierro los ojos, de repente puedo ver los ojos brillantes de esas estatuas frente a mí. Es como si hubieran cobrado vida y me estuvieran mirando fijamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Por eso regresé a tomar un descanso. Desde aquí no puedo ver los ojos de las estatuas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Por cierto, ¿por qué no te llevas este cuadro? Es el mejor que he hecho hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Ahora, si no te importa, descansaré un poco. Estoy muy cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Aun así, algo les falta a mis cuadros. ¿Qué será? ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}