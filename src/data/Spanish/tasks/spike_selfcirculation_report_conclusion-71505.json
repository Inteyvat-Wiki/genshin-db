				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, volviste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050102,
					"content": "¿Cómo va la investigación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "He terminado de ajustar el Clavo. Aunque todavía estoy un poco preocupado, no podemos hacer más que colocarlo en el túnel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050104,
					"content": "Le he pedido a Khedive que prepare un poco de medicina para Tu y Hao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, activa el Clavo de Pursina y sella las aberturas por donde se escapa el fango oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050106,
					"content": "Al principio, cuando Khedive me pidió ayuda, pensé que, si no lograba encontrar una solución al problema, lo mejor sería llevar el Clavo de Pursina de vuelta a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050107,
					"content": "De todas formas, hemos hecho tantos experimentos con él que tenemos datos suficientes para elaborar un informe completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050108,
					"content": "Pero Tu, Hao y el resto de la gente que vive aquí... tendrían que lidiar con este fango oscuro para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050109,
					"content": "Si mi investigación solo sirviera para publicar un informe y no lograra ayudarlos, me temo que entonces no serviría de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050110,
					"content": "Por eso decidí que tenía que encontrar la forma de detener el fango oscuro que brota de las líneas ley. Además, estar en contacto con el fango ha sido... una llamada de atención para un erudito de Sumeru como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050111,
					"content": "#Confío en tu fuerza, pero las áreas por donde emana el fango oscuro son peligrosas. Ten cuidado, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050112,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Jajaja, *Cof, cof*... *Cof, cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050115,
					"content": "#Me refería a que te cuides tú, {NICKNAME}. Si el Clavo de Pursina se activa en las aberturas, puede disminuir los efectos que tiene el fango oscuro sobre los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050116,
					"content": "Pero el fango oscuro ha atraído a demasiados monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050117,
					"content": "Así que, por favor, ten cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050113,
					"content": "Tendré cuidado con el Clavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}