			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "#... y cuando terminó l{F#as}{M#os} traje directamente aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "#Viajer{F#as}{M#os} traíd{F#as}{M#os} por el viento, Mondstadt les da la bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Soy Jean, Gran Maestra Intendente de los Caballeros de Favonius. Ella es Lisa, la bibliotecaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "#¡Vaya! ¿Acaso vienen a ayudarnos, querid{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "¡Son tan adorables!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Desafortunadamente, llegan en un mal momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Con el resurgimiento de Stormterror, la ciudad está hecha un caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "En pocas palabras, el flujo elemental y las líneas ley de la ciudad nos ponen en desventaja. Somos como un ovillo de lana en las zarpas de un gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "No puede haber una situación peor para una bruja... Mi piel está a una partícula elemental de arruinarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Si no fuera por estas interferencias, los Caballeros de Favonius podríamos ayudarles mucho más. Por ahora, solo podemos ayudarles poniendo anuncios de personas desaparecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "#Les pedimos que se queden en Mondstadt por un tiempo... Los Caballeros de Favonius te ayudarán a encontrar a tu {F#hermano}{M#hermana}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "No puedo dejar que hagan todo el trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "¡Paimon también quiere ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Bien, entonces necesitamos un plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Con Stormterror atacando Mondstadt, tenemos la oportunidad de cortar el problema de raíz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Haciendo uso de sus poderes mágicos, Lisa inspeccionó la tormenta que cubre Mondstadt y descubrió el origen del poder de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "¿Y bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Su poder proviene de los <color=#00E1FFFF>Templos de los Cuatro Vientos</color> abandonados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "La habilidad de Stormterror de crear este tipo de tormentas se atribuye a que extrae su poder de los templos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Así que nuestro objetivo es inspeccionar <color=#00E1FFFF>tres</color> de los cuatro templos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Supongo que todos saben por qué solo tres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Paimon no entiende por qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Es algo que solo los lugareños saben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Caballeros de Favonius, el tiempo apremia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "La tormenta se avecina. No tiene sentido mantenernos a la defensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Debemos actuar ahora, antes de que la situación empeore. Vamos a las <color=#00E1FFFF>ruinas</color> de los <color=#00E1FFFF>templos abandonados</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Mejor preguntemos más tarde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "¡Qué bien! Todo suyo. ¿Dónde está la posada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "#¡Oye! ¡Qué perezos{F#a}{M#o}! Deberíamos ayudarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}