				]
			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#¡Buenos días, {NICKNAME} y Paimon! Les traigo... ¡unos peciglobos para darles los buenos días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "¡Buenos días, Mualani! ¿Cómo puedes tener tanta energía? ¿No lo diste todo anoche en la fiesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "¡Eso fue anoche! ¡Solo necesito dormir bien para estar como nueva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Toma. Es tu premio por completar el álbum. ¡Recogí el tuyo para ahorrarte el viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "¡Guaau! ¡Qué considerada, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Una buena guía siempre se anticipa a lo que la gente necesita, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Odio decirlo, pero hablando de trabajo, supongo que nuestras vacaciones casi han terminado... Además, si no vuelvo pronto, me preocupa que mi perrito no sepa ni quién soy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Hablando con los demás, parece que todos tienen sus propias razones para volver también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Algunos dijeron que echaban de menos a sus familias, otros, el sabor del vino de diente de león...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Incluso Chasca parece sentirlo. No es que lo haya dicho, pero al atardecer, se encarama a las copas de los árboles y mira hacia la Tribu Plumaflora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Es comprensible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Pero el verano aún no ha terminado. Así que yo digo que... ¡aprovechemos el tiempo que nos queda para vivir unos cuantos momentos inolvidables más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "¡Como tomarnos otra imagen grupal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Oye, ¿qué tal si la tomas aquí mismo? Después de todo este tiempo, Paimon se ha encariñado con este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "¡Buena idea! ¿Por qué no decoran un poco esta pared? Yo iré a reunir a los demás. ¡Nos vemos en la plaza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
