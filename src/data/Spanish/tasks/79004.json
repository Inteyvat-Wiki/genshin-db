				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "#¡Saludos, amig{F#a}{M#o}! ¿En qué l{F#as}{M#os} puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Ehmm... Tú eres un erudito, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Jeje, supongo que sí. Para ser precisos, soy un “erudito itinerante”, pero eso es solo una categoría dentro de “erudito”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "¿Qué pasa? ¿Encontraron algún problema que requiera mi “erudición”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Esto es lo que ocurrió...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Una isla... en medio del océano... ¿Y unos murales? Interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "Y la razón por la que buscan a un erudito es para descifrar esos murales, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "¿Puedes ayudarnos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Por supuesto, no puedo rechazar la oportunidad de explorar historias que el mundo nunca antes ha visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Bien, no perdamos más el tiempo, muéstrenme esos murales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Estos son los registros que tenemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Humm... Nada mal, nada mal. Lo siento, necesito un poco de tiempo para reflexionar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "Podemos darte algo como compensación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "#Jajaja, a juzgar por tu actitud, debes ser {F#una aventurera experimentada}{M#un aventurero experimentado}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "Pero para mí, desentrañar los secretos de esta historia es mi mayor compensación. Con eso es más que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
