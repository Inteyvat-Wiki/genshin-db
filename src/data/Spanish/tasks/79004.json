				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Ya tomamos nota de muchos murales. Si los unimos, podremos entender la historia que se esconde detrás de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
