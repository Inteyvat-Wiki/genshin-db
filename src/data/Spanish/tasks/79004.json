				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Humm... Las imágenes de estos murales no son difíciles de descifrar. No puedo decir a ciencia cierta cuál es el orden, pero no es ningún problema descifrarlos uno por uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040402,
					"content": "Comencemos con este. En él se ve un grupo de náufragos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040403,
					"content": "Después de naufragar, debieron llegar arrastrados por la corriente a la isla del mural que ustedes encontraron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040404,
					"content": "Luego debieron encontrar un lugar donde asentarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040405,
					"content": "Si vemos con detenimiento este mural, hay cinco objetos, cada uno con una marca distinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040406,
					"content": "Parecen ser copas llenas de agua, pero cada una contiene una cantidad distinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040407,
					"content": "En pocas palabras, este mural sugiere que hubo un cambio en ciertas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040414,
					"content": "Un cambio en las condiciones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Sin embargo, no puedo decir con exactitud a qué se refiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040409,
					"content": "Pero ya que se trata de una isla, quizás sea el nivel del mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040410,
					"content": "A continuación sigue esta imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040411,
					"content": "Al parecer hubo un segundo naufragio que trajo “nuevos huéspedes” a la isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040412,
					"content": "Como verán, el primer grupo de personas debió intentar rescatar al segundo. Además, observen este barco destrozado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040413,
					"content": "En el primer mural, la ilustración del barco se usa solo para explicar su situación, pero en este otro mural, el barco despedazado tiene una implicación muy específica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040416,
					"content": "Quizás este barco destrozado tiene un significado fuera de lo ordinario para la gente que quedó varada en esta isla desolada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040417,
					"content": "Lo que nos lleva al siguiente mural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040418,
					"content": "Como podrán ver, en la cima de la montaña de esta imagen hay un símbolo especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040419,
					"content": "Si me lo preguntan, seguramente para esas personas este punto tenía un significado de gran importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040422,
					"content": "Por último, tenemos este mural. Claramente encontraron una forma de dejar la isla y la abandonaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040423,
					"content": "Me imagino que esa es la historia que intentan contar por medio de estos murales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040424,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "No me lo agradezcas. En realidad, tengo mucho interés por esta área de estudio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040426,
					"content": "Gracias por compartir conmigo la historia de estos murales. No imaginé que daría con unos hallazgos así en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040427,
					"content": "Humm... Quizás debería tomarme un tiempo para ir a explorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040428,
					"content": "¿Por qué usarían unos murales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
					"content": "Cuando se trata de registrar y transmitir información, en ocasiones las imágenes pueden expresar más que las palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040415,
					"content": "¿Qué será?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				}
			]
		},
		{
