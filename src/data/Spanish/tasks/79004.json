			},
			"dialogs": [
				{
					"id": 790040101,
					"content": "¿Eh? ¡Mira! Al parecer esta estela tiene una imagen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 790040102,
					"content": "Parece que un barco encalló... Y había muchas personas en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 790040103,
					"content": "Paimon no le ve ni pies ni cabeza... Pero anotémoslo de todos modos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observar"
				}
			]
		},
