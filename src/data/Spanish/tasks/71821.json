			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "¿Cómo terminé haciendo este trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "#Viajer{F#a}{M#o}, quizás tú no lo entiendas, pero cada año se deben recoger las linternas celestes del Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Aunque sea bonito verlas volar, también pueden ser un dolor de cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "Si la pantalla no está bien hecha, la linterna volará hasta medio camino y se romperá, lo que suelta un fragmento de plaustrita que va flotando por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Y cuando las linternas son arrastradas por el viento, se quedan atascadas en los rincones más inesperados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "Eso pone en riesgo la seguridad y afecta al aspecto de la ciudad. Así que, normalmente, el Ministerio de Asuntos Civiles asigna a alguien para que se encargue de recoger todas esas linternas celestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "... que este año, soy yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Pero la cantidad de linternas celestes que liberan en el Rito de la Linterna es enorme... Si lo dejara para el último día del festival, nunca terminaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Así que, mientras todo el mundo las libera, yo recojo aquellas linternas celestes rotas o que quedaron abandonadas en algún rincón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Pero yo solo no puedo con este trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "#Viajer{F#a}{M#o}, si estás dispuest{F#a}{M#o}, ¿podrías ayudarme a ver si tengo que ir a recoger algo en estos sitios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "Marqué los puntos en tu mapa. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
			"completionStepIds": [
				7182108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
