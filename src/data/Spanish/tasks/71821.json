			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling Puño Veloz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "¡¿Cómo es posible?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210202,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Yo... *suspira*, hace poco, mi maestro creó una nueva técnica de patadas muy poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210204,
					"content": "Sin embargo, me dijo que mi motivación no era lo suficientemente fuerte, y que todavía tengo que trabajar en lo básico, así que no me enseñará su nueva técnica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210205,
					"content": "Así que quiero aprovechar que estamos en el Rito de la Linterna para ofrecerle una linterna celeste a mi maestro. Tal vez si se pone de buen humor acceda a enseñarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210206,
					"content": "Pero no encuentro ninguna plaustrita. Vi una linterna celeste atascada por allá, por lo que quise recuperar la plaustrita de su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210207,
					"content": "Y, bueno, ya sabes lo que pasó después... *Suspira*, no quiero la linterna, te la puedes quedar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Ling Puño Veloz"
				},
				{
					"id": 718210208,
					"content": "Al toparme con esos monstruos, me di cuenta que todavía me falta perfeccionar mis habilidades básicas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ling Puño Veloz"
				}
			]
		},
		{
			"id": 7182103,
			"completionStepIds": [
				7182110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182110",
							"2"
						],
						"stepId": 7182110,
						"stateName": "QUEST_STATE_UNFINISHED"
