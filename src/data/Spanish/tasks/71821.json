				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "¿Qué opinas? ¿Hay linternas celestes que necesiten recogerse en esos lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210302,
					"content": "Tres linternas celestes en total.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Muchas gracias. Recolectar linternas celestes es un trabajo muy extenuante. Cada vez que lo hago, termino muerto de cansancio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210304,
					"content": "Gracias a ti, por fin puedo relajarme un poco. Ah, sí, toma esta recompensa por tu esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182104,
