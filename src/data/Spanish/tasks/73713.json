			"dialogs": [
				{
					"id": 737130101,
					"content": "¡Tachán! ¡Llegamos! Si empezamos desde esta parte menos profunda, sentirán cómo el paisaje se va revelando poco a poco, ¡como si estuvieran adentrándose en una pintura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... Son ustedes. ¿Y trajeron nuevos compañeros? Son... ¿Hongos? Solo había leído cosas sobre ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "¡Oh, vaya! ¡Hasta hay una melusina por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Qué bueno verte de nuevo, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "En realidad, estoy trabajando. Salí a recolectar marealgas para preparar los encurtidos de este año. Muchas otras también han regresado a la aldea para ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Enghiene y la pequeña Roxane pidieron permiso para volver y ayudar. Están trabajando duro, y yo también iré al agua en un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "¿Sabes? Enghiene tenía razón. Los Hongos azules sí que se parecen un poco a las marealgas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "¡No digo que tengan aspecto de comida! Solo que son adorables, eso es todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Cabezabombo"
				},
				{
					"id": 737130111,
					"content": "Jeje, ¡está claro que tienes buen gusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Los compihongos son muy adorables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "En fin, tengo que irme, pero me alegra que nos hayamos visto. ¡Pásenselo bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Muy bien, pongámonos en marcha nosotros también. Con los compihongos, ¡seguro que podemos tomar imágenes impresionantes bajo las aguas de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Las melusinas también son adorables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "¡Hola! Es la primera vez que te veo por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
