						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viejo Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "¿Y tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210702,
					"content": "¡Ah, Endora! ¿Por qué saliste por ti misma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "Soy Endora, soy hada de manantial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "Ahora que Paimon lo recuerda, este señor creía firmemente en la existencia de un hada del manantial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210706,
					"content": "Eres prácticamente igual que ella, solo que mucho más pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210707,
					"content": "¡Endora aún pequeña! Todavía aprendiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "El hecho de que hayas aparecido, por lo menos, demuestra que nuestro encuentro no fue un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210709,
					"content": "Ella todavía existir. No sé su nombre. Si no sé nombre, ella no responder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Quiero hablar con ella. Puedo darle mensaje. Dímelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "¿Quieres decir que ella no se ha ido? ¿Puedes hablar con ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210712,
					"content": "Sí, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210714,
					"content": "Pero ya soy tan viejo... Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414210715,
					"content": "... Pregúntale cómo está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viejo Finch"
				}
			]
		},
