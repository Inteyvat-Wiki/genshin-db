			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "#Saludos, viajer{F#a}{M#o}. Espero que hayas estado bien desde la última vez que nos vimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210102,
					"content": "¿Otra vez ocurrió algo raro, Katheryne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "Comparado con los eventos más recientes, esto no es nada fuera de lo común. Es solo que, como afecta a la economía de Mondstadt, sigue siendo un dolor de cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210104,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Últimamente, el agua de cerca del viñedo se ha vuelto amarga sin razón aparente, lo cual podría acabar con la industria vinícola en cuestión de años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210107,
					"content": "Por favor, habla con Connor en el Viñedo del Amanecer para más detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210105,
					"content": "¿La economía de Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "¿Ustedes son los miembros que envía el Gremio de Aventureros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Entonces puedo estar tranquilo. En cuanto a... eso, creo que es mejor que lo vean con sus propios ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "El agua de esta botella fue extraída cerca de aquí. Ya ha pasado por todos los procesos de purificación y es absolutamente potable. Pueden probarla con confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "¡Paimon también! ¡Paimon también quiere probar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(Probaré un sorbo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "¡Puaj! Esto sabe amargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "Este sabor amargo no se puede eliminar con los métodos tradicionales de purificación. No es un problema de su composición, sino que debe ser un fenómeno provocado por un poder elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "Esta agua es fundamental para la producción de vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "Debe ser muy difícil para los peces que viven ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "Ya los probamos. Cuando los cocinamos, todos los peces estaban amargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "... ¡No me refería a eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "En fin, esa es la situación. Si quieres saber si tengo alguna pista, tengo el presentimiento de que debemos dirigirnos hacia el norte a investigar. Me pregunto cómo estará el agua del Río Bishui y la Aldea Chingtsé en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
