					"content": "Quizás lo entiendas más adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "Endora todavía tiene mucho que aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211007,
					"content": "Rhodeia está muy irritable últimamente. Si pudiera verla cara a cara, tal vez resolvería este problema.",
