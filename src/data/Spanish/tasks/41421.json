			"dialogs": [
				{
					"id": 414210801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210802,
					"content": "Su respuesta es rara. Endora no entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210803,
					"content": "Dice algo sobre... ¿“causa”? Endora preguntó, pero no respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210804,
					"content": "Parece que tu vocabulario es limitado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "Probablemente tiene una razón para no poder mostrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210806,
					"content": "No entiendo. A nosotras, ondinas, gusta fusionarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210807,
					"content": "Ella solo es consciencia. Es solitaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210808,
					"content": "Quizás se deba a que, para otras criaturas, es imposible fusionarse con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210809,
					"content": "¿Imposible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "¡Se ahogarían dentro de sus cuerpos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Humanos ser muy solitarios. Nosotras amar a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "¿Qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Cerca de Puerta de Piedra, ¡hay espías de Rhodeia! Pequeños animales de agua son espías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "¿Animales de agua? Una vez vimos unos animales de agua por aquí, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Creo haber visto alguno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Agua poderosa, convertirse en pequeños animales. Muy peligroso, pero al fusionarnos aprender mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Llévame allá. Rhodeia no tranquila, convertir agua en amarga. Yo aprendo a hablar para aclarar cosas con Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Entonces, ¿puedes ayudarnos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Sí, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, Paimon cree que vale la pena intentarlo. Después de todo, no tenemos otras pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "¿Ah, sí? No presté atención.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
