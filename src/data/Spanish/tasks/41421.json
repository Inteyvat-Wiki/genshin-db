						414211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414211003,
					"content": "Mi vocabulario aumentó al fusionarme con los animales oceánidos. Ahora entiendo el mensaje de la Aldea Aguaclara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211004,
					"content": "“Los cauces de la vida solo fluyen hacia adelante”. Suena un poco triste. Un poema corto y enigmático. No lo entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "Endora"
				},
				{
