				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "¡Gracias por ofrecer su ayuda! ¡Empecemos con la primera poción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}, no bebas mucho, ¿eh? Si te sabe mal, ¡escúpela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Tranquila, Paimon, no me va a pasar nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Ay... Paimon no puede dejar de preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "#Estoy preparad{F#a}{M#o}, déjame probar las pociones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Esta es la “Supermegapoción”. Si te la bebes te volverás supermegafuerte. En teoría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "Tomas la poción de Verenata y te la bebes de un trago.\\nTiene un olor acre difícil de soportar, y sabe dulce. La textura es pegajosa, pero no resulta difícil de tragar.\\nSin embargo, no notas ningún cambio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Siguiendo las instrucciones de Verenata, esperan a que aparezcan algunos Protofisuradores.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
