			"dialogs": [
				{
					"id": 740390601,
					"content": "Así que... ¿derrotaste a los monstruos en un santiamén gracias a la Supermegapoción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Exacto. ¡Me ha dado supermegapoderes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "¿Qué clase de eslogan publicitario es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "¡Qué bien! ¡Gracias! ¡Muchísimas gracias! La poción ha sido efectiva, ¡con razón es una fórmula de la Srta. Carabosse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Cierto. Hemos terminado con la prueba de la Supermegapoción, continuemos con la siguiente, ¡la “Acalorapoción”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "¿Le pusiste tú estos nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "No, no sé me da bien eso de poner nombres, así que tuve que pedirle ayuda a alguien para que se inventara unos mejores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "No digas eso. Siendo un medicamento, es más adecuado ponerle un nombre que se entienda a la primera. ¿A que sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Es la primera vez que me dicen eso, tienes razón. ¡Eso hizo la Srta. Carabosse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#*Ejem*, en fin. {NICKNAME}, ¿estás preparad{F#a}{M#o} para probar esta poción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Sí, adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Uff, esta tampoco tiene buena pinta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "La Acalorapoción hace que el frío no sea un problema y te hace entrar en calor. En teoría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "Tomas la poción de Verenata. Huele a cuero viejo, polvoriento y mohoso...\\nDespués de dudar por un momento, te la bebes de un trago. No sabe mal, tiene un toque a canela y jengibre... Te recuerda al crepitar de una chimenea en un día lluvioso.\\nSin embargo, no notas ningún cambio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Después, siguiendo las instrucciones de Verenata, te tomas un descanso.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "No he sentido nada en especial... Era dulce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "¿Ah, sí? Pues olía fatal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Ehm... ¿Qué es lo que habrá fallado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "#No te desanimes. Al menos no estaba tan mala y {NICKNAME} tampoco se ha envenenado. ¡Eso ya es un éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403907,
			"completionStepIds": [
				7403906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
