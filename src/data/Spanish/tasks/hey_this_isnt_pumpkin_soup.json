			"dialogs": [
				{
					"id": 740390101,
					"content": "Humm... Marealga seca y quemada, entrañas marinadas de lumistela, y un poco de... Espera, ¿cuánto es “un poco” exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390102,
					"content": "¿Eh? ¿Estás preparando una sopa? Puaj, ¡qué raro huele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "¿Que huele raro? No puede ser... He seguido la receta de la Srta. Carabosse, no debería oler mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390104,
					"content": "Huele como si alguien hubiera fermentado una perca durante tres años en un cubo de ranas muertas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Puff, Paimon ya se lo está imaginando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "Da lo mismo. ¿Qué estás preparando? ¿Necesitas nuestra ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "Pócimas, estoy elaborando unas pócimas que pueden ayudar a muchísima gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390110,
					"content": "Ah... Entonces, ¿eres una especie de maestra de pociones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "No, todavía no. Soy ayudante de la Srta. Carabosse. Es una gran farmacéutica. A mí todavía me queda mucho por aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390112,
					"content": "Ya, bueno, pero si eres ayudante de una farmacéutica increíble, debe ser porque eres una ayudante increíble, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Jeje, exact... No, no, ¡no lo soy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390114,
					"content": "Hay muchas cosas que no sé, solo hago lo que puedo para ayudarla a preparar medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390115,
					"content": "Me llamo Verenata. Ehmm... Ya saben mi nombre, pero yo aún no conozco el suyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390116,
					"content": "#Paimon es Paimon y {F#ella}{M#él} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "Paimon, qué bonito nombre. Suena a nombre de una medusa blanquita y charlatana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME} es un nombre un tanto peculiar, pero muy llamativo. Suena agradable. ¡Encantada de conocerl{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390119,
					"content": "Me estaban preguntando si necesitaba ayuda, ¿no? Pues sí, la necesito, pero no sé si querrán ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390120,
					"content": "Tú pide por esa boquita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Eso, si necesitas ayuda, ¡solo tienes que decírnoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Me gustaría que probaran mis nuevas pociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390123,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "Sé que huelen mal y no saben bien, pero podrían ayudar a muchísima gente y curar muchísimas enfermedades. De verdad, son muy efectivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390125,
					"content": "Pero las melusinas no nos ponemos enfermas y tampoco nos gusta beber cosas raras, así que, con el tiempo, las melusinas dejaron de ayudarme a probar mis pociones. Así resulta mucho más difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390126,
					"content": "Ehm... ¡Pero tú misma reconoces que son pociones raras! ¿No será peligroso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "No lo creo. Nosotras no nos envenenamos al probarlas, así que ustedes tampoco deberían. En teoría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390128,
					"content": "Tienen que probar tres pociones en total. Una que te hace muy fuerte, otra que te hace entrar en calor y otra que... humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390129,
					"content": "No sé cómo explicarlo... La Srta. Carabosse dijo que podía hacer que la gente viera la “realidad”, pero no entiendo muy bien a qué se refiere, la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390130,
					"content": "A Paimon le sigue pareciendo muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "#No, no es peligroso. Por favor, échenme una mano. ¡L{F#a}{M#o}s llevaré al lugar ahora mismo si aceptan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390106,
					"content": "Si lo hueles bien, puedes sentir un suave aroma a flor dulce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Oye, ¡eso no es normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
