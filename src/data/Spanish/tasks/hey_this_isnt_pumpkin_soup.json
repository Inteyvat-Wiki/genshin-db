						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#¡{NICKNAME}! ¿Estás bien? ¿Hola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390702,
					"content": "*Solloza*... Lo siento, no sabía que la poción pudiera atraer criaturas raras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390703,
					"content": "Es que la poción me ha hecho entrar en calor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "¿De verdad ha sido por eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Guau... Es verdad, los animales acuáticos han confundido las cosas calientes con el sol, por eso han sido atraídos. Entonces, ¡la poción ha surtido efecto! ¡Gracias, muchísimas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390706,
					"content": "Paimon no cree que sea por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "¿Animales acuáticos? ¿No eran Slimes Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "¿Eh? Humm... Crea efectos ilusorios, ¡me lo apunto! Al menos hace algún efecto, aunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390709,
					"content": "No sea el previsto... Hoy has confundido a los cangrejos por los Slimes Pyro, ¿qué pasa si la próxima vez te toca un monstruo más peligroso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Sí... Ya me han hecho muchos favores, pero queda una última poción que necesita ser probada... ¿Te ofreces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390721,
					"content": "Con que no esté envenenada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Para saberlo tendrás que probarla primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "¡Sí, muchas gracias! Pues continuemos con la siguiente poción, la poción de la clarividencia, ¡eso es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390726,
					"content": "¿Eh? ¡Espera, espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "La primera poción se llama Supermegapoción, la segunda Acalorapoción y esta se llama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "Poción de la clarividencia. Sí, puede hacer que la gente vea claramente la realidad. ¿Cuál es el problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390729,
					"content": "Nada, nada. Solo que en comparación con los otros dos nombres, ¡este ha sufrido un giro de trescientos sesenta grados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Entonces se ha quedado donde estaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "¿Eh? Da igual, ¡ya sabes a lo que me refiero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Jeje, porque los dos anteriores los puso la Srta. Carabosse y a mí se me ocurrió este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390734,
					"content": "Soy muy mala para poner nombres, a la Srta. Carabosse se le da mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390735,
					"content": "¿Ah, sí? Paimon piensa que es al revés. ¡Confía más en ti misma! A Paimon le parece que este sí que podría ser el nombre de una poción de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Está bien, gracias. Esta poción es diferente a las dos anteriores, puede ser muy peligrosa. Vengan conmigo al laboratorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390737,
					"content": "Si estamos en el mar, el ambiente debería ayudar a moderar los efectos de la poción, y en mi taller hay herramientas para lidiar con los peligros, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390738,
					"content": "Ay, esta vez va en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Comencemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Bien, ¡síganme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390731,
					"content": "Ciento ochenta grados, dirás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Bueno, ya que estamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "¡Exactamente! ¿Qué sentido tendría todo esto si nos rindiéramos a mitad de camino? Aunque... Paimon sigue un poco preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "No pasa nada, los Slimes Pyro son fáciles de derrotar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#No, no, no. ¡Es que eres muy fuerte, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Espera, ¿acabas de decir Slimes Pyro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390713,
					"content": "Es verdad, ¡pero si solo vimos un montón de cangrejos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "¿Cangrejos? Ah, sí. Estamos al lado de la playa, normal que haya cangrejos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "¿Por qué estás actuando tan raro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Pero la sensación de ardor era muy real. Incluso podía sentir ondas de calor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "¿Eh? Humm... Crea efectos ilusorios, ¡me lo apunto! No es del todo inefectivo, pero... *Suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390718,
					"content": "¡Me alegro que estés bien! Solo que me siento mal porque la poción me ha fallado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390719,
					"content": "#¡No pasa nada! Huele un pelín mal, ¡pero es un paso más que has dado! Mira, ¡{NICKNAME} se la ha bebido y está estupendamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
