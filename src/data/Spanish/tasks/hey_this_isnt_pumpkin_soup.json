			"dialogs": [
				{
					"id": 740390801,
					"content": "¡Este es mi laboratorio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390802,
					"content": "#A continuación, probarás la poción de la clarividencia, ¿estás list{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390803,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Ten mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Tomas la poción de Verenata y el olor rancio de algas muertas que se pudren bajo el abrasador sol te inunda las fosas nasales, provocándote arcadas...\\nDudas un momento, y luego te la bebes de un trago. El sabor en sí no es tan horrible y, de hecho, carece de cualquier regusto distintivo...\\nSin embargo, no notas ningún cambio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Después, bajo las indicaciones de Verenata, tomas un descanso y nada ha cambiado.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Pero, poco tiempo después...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Parece que todo sigue igual. *Fiuu*, Paimon ya no se tiene que preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Sí, pero... {NICKNAME}, parece que te quedaste pasmad{F#a}{M#o} por un momento. ¿Qué ha pasado? ¿Has visto algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390810,
					"content": "He visto... ¿la mitad de un barco medio transparente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Oh, ¡fascinante! Ehmm... ¿Podrías darme más detalles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390812,
					"content": "Estaba muy lejos, no sé cómo era exactamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "¡Interesante! Pero no puede servir como prueba concreta de los efectos de la poción... Porque no puedes demostrar si confundiste algún arrecife o naufragio con un “barco fantasma”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390814,
					"content": "Así que el experimento sigue sin tener avances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390818,
					"content": "Gracias, esta vez he podido recopilar mucha más información. ¡Estoy segura de que me servirá para las próximas pociones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390819,
					"content": "Humm... “Ya me contaron de algo similar... pero aún queda mucho por observar, y ver si otros pueden ver el mismo fenómeno”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390820,
					"content": "*Suspira*... ¿Eso quiere decir que necesitas a más gente para probar tus pociones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "Sí, exacto. Porque... humm... necesito tener al menos a dos testigos fiables que hayan visto lo mismo para demostrar que la poción es capaz de hacer que la gente vea la realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390822,
					"content": "Porque la realidad no se limita a aquello que podemos ver. Cada persona tiene su propia perspectiva de las cosas, pero la realidad no cambia en función del corazón de la gente. La realidad existe, está ahí, se perciba o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390823,
					"content": "Humm... ¿Como las divinidades que viven miles de años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390825,
					"content": "No, es como la arena fina y blanca, el cuerpo de las estrellas de mar, las olas que rompen y golpean... todo eso es real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390826,
					"content": "Pero la Srta. Carabosse también me dijo que la realidad puede crearse a través de los sueños y los recuerdos. No acabo de entenderlo. Me parece una contradicción, pero estoy haciendo lo posible para comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390827,
					"content": "Vaya... El tema se ha vuelto de repente muy profundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Jaja, ¡entonces dejemos de hablar de eso! De todos modos, ¡me gustaría darles las gracias por su ayuda! Por favor, ¡acepten esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390829,
					"content": "#¡L{F#as}{M#os} avisaré cuando tenga nuevas pociones que probar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390815,
					"content": "Parece que fue partido por algo inmenso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390817,
					"content": "Ay, ¡lo siento! Me he quedado en las corrientes, ¡pero no te preocupes que tomo nota ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				}
			]
		},
