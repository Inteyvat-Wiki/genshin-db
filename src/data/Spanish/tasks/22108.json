				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Espero que aparezca la próxima vez... Ya no quedan muchas pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "¿Quién eres? Si quieres saber más sobre el gremio, habla con Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "#¿Ya eres {F#una aventurera}{M#un aventurero}? Lo siento, soy la jefa de esta división, pero poco me interesan los asuntos del gremio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "#... así que no conozco a los nuevos. Pero a juzgar por tu apariencia, ya estás familiarizad{F#a}{M#o} con las aventuras, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "¿Puedes ayudarme? Pero tengo que advertirte, lo que voy a pedirte no tiene nada que ver con el gremio, es un encargo personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "¡Genial! Aunque no es muy sabio aceptar un encargo sin conocer los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "En cuanto al encargo, me gustaría que te deshicieras de dos Hilichurls muy fornidos que llevan escudos gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Sus escudos están infundidos con poder Geo. No son muy peligrosos, pero tampoco hay que confiarse de más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Solo tienes que vencerlos. Cuando termines, vuelve conmigo y te daré una recompensa razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Otra cosa, si encuentras un objeto relacionado con una espada, tráemelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "#Si no, no pasa nada, olvídalo. Solo extermina a esos Hilichurls y te daré la recompensa. Puedes estar tranquil{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "¿Qué encargo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "#Eres muy cuidados{F#a}{M#o}, ¿te han tendido una trampa antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
