			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "Otro día que vuelvo a casa con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210402,
					"content": "¿Qué estás haciendo por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "Estoy pescando. Pero hasta ahora solo he pescado cosas que no son peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210404,
					"content": "Si al menos fueran cachivaches de algún barco hundido, los comerciantes ambulantes los comprarían. Una vez pesqué una bota con media... *Suspira*, mejor me callo, o voy a espantar a los peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210405,
					"content": "¿Hay algo de lo que deba tener cuidado por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "¿Vienes de nuevo a buscar tesoros? Ese Gran Tesoro del que hablan, que solo se puede encontrar al este de la luna y al oeste del sol... no tiene ninguna pinta de que vaya a estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210407,
					"content": "Es cierto que aquí ocurrieron varios naufragios. Quizás haya cosas valiosas en esos barcos hundidos, pero no será nada fácil encontrarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210408,
					"content": "En la taberna, algunos marineros que sobrevivieron dijeron que esa noche, aunque no había luna, vieron algo brillante entre las olas gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210409,
					"content": "Dicen que debía ser el tuerto Kratti, un monstruo capaz de devorar hasta la luna, peleando con una serpiente marina enorme por el territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210410,
					"content": "Después de eso, durante mucho tiempo, esta zona permaneció tan oscura como un tintero, y ningún barco se atrevía a pasar por miedo a ser arrastrado por los espíritus del fondo del mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210411,
					"content": "Me da igual si esos espíritus siguen rondando por aquí, ¿sabes? De todas formas no puedo verlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210412,
					"content": "Ese árbol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "Es supersiniestro. Antes había un remolino aquí, al que los marineros llamaban el Ojo de Kratti. Pero un día, de la nada, brotó ese árbol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210414,
					"content": "Aunque no fue la única cosa rara que pasó por esa época. Si lo piensas bien, todo empezó cuando cayeron esas piedras del cielo... Quizás este árbol, al igual que las piedras, vino de otro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210415,
					"content": "También están esas cositas brillantes que a veces se ven por aquí. Son muy raras. Pensé que tal vez habría especies nuevas de peces, así que vine a probar suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210416,
					"content": "Al principio venía con un compañero de pesca, pero él decía que escuchaba cantos extraños y se asustó tanto que ya no quiso volver. ¡Bah! Aunque solo sea mitad Descendiente Lunaescarcha, le sobran las malas mañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210417,
					"content": "Cuéntame más sobre la Insignia del conocedor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "¿Sabes qué opino? Que todo eso de la Insignia del conocedor, el Gran Tesoro que solo se puede encontrar al este de la luna y al oeste del sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210419,
					"content": "Cuando la codicia te impulsa a perseguir cosas que no te pertenecen, nunca termina bien. Como el Atlas. Dicen que el capitán Grettir perdió la cabeza por ese tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210420,
					"content": "Y al final, acabó en el fondo del mar. Pero el tesoro no se quedó con él... Todo ese esfuerzo para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210421,
					"content": "No te molesto más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "No importa. De todas formas, no parece que haya ningún pez por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}