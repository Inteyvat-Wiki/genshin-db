				"points": []
			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "Vaya, como hace mucho tiempo que no venía nadie, no pensé que pudieras encontrar la entrada a este sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Espíritu noctámbulo"
				},
				{
					"id": 750490402,
					"content": "Aquí... Aquí es donde deambulan las almas noctámbulas. Sin embargo, me temo que allá donde brilla el sol, ya no hay nadie que recuerde los nombres prohibidos de dichas almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Espíritu noctámbulo"
				},
				{
					"id": 750490403,
					"content": "Cuando nuestra maestra duerme, las almas noctámbulas somos su sueño. Cuando nuestra diosa se despierta, cosa que rara vez ocurre, nosotras somos su pensamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Espíritu noctámbulo"
				},
				{
					"id": 750490404,
					"content": "#Es muy extraño que alguien vivo haya podido venir hasta aquí, jeje. Aquellos en los que arde el ansia de guerra ya no pueden aguantarlo, pero tú, {F#heroína forastera}{M#héroe forastero}, tú, que has sido bendecid{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Espíritu noctámbulo"
				},
				{
					"id": 750490405,
					"content": "Tranquiliza a las almas angustiadas con el fuego del combate. Obtén la victoria y ellas, que duermen profundamente aquí, te concederán una recompensa... ¿Aceptas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Espíritu noctámbulo"
				}
			]
		},
