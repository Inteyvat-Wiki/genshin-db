			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fréminet"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3509.359,
							452.648,
							4162.708
						],
						"pointId": 17298
					}
				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "¿Fréminet? ¡Pareces agotado! No te habrás estado esforzando demasiado, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150102,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150103,
					"content": "#¡Eh! ¡No te escondas dentro de tu casco de buceo! Somos tus amig{F#a}{M#o}s. Te sentirás mucho mejor si lo sueltas todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150104,
					"content": "*Suspira*, supongo que tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150105,
					"content": "Me topé con alguien de lo más molesto mientras buceaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150106,
					"content": "¿Alguien molesto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150107,
					"content": "Sí... ¿Cómo explicarlo? Según las leyes de Fontaine, si el propietario de la mercancía hundida acepta un pago del seguro, el cargamento pasa a ser considerado como una propiedad sin dueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150108,
					"content": "Por eso, hay gente que ve el buceo como una forma de enriquecerse. Recuperan cosas que otros han perdido y las venden en tierra firme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150109,
					"content": "Es un trabajo que no requiere mucha habilidad, lo que significa que hay muchos buzos que... bueno, son del tipo a los que solo les importa el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150110,
					"content": "Suelen recurrir a métodos crueles para alejar a los peces y las Focas Abotargadas con tal de poder recuperar los valiosos cargamentos... Si no acepto ciertos encargos es precisamente por gente como ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150111,
					"content": "Así que eso es lo que te preocupa... Paimon entiende muy bien cómo te sientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150112,
					"content": "Hace un momento, mientras buceaba, me encontré con alguien que estaba espantando a los animales. Reuní el valor suficiente para detenerlo, pero al final me dijo cosas bastante desagradables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150113,
					"content": "Qué mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150114,
					"content": "¡Hiciste lo correcto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "Gracias por el ofrecimiento, pero... aunque me resulte difícil y agotador, quiero intentar cambiar las cosas por mis propios medios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150117,
					"content": "Me encanta bucear, ver los patrones de las caracolas azurescentes, sentir la respiración de las flores rociomarinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150118,
					"content": "Cuando el mundo submarino te acepta, te muestra su gran benevolencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150119,
					"content": "Creo que así es como deberíamos relacionarnos con la naturaleza, en lugar de simplemente tomar lo que queremos de forma egoísta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150120,
					"content": "Vaya, Fréminet, ¡a Paimon le encanta todo lo que has dicho! ¿Ves lo bien que sienta expresar aquello que verdaderamente quieres decir o hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150121,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150122,
					"content": "¿Fréminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150123,
					"content": "Lo siento... Sigo siendo un poco tímido. Pero no se preocupen... S-seguiré trabajando en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150124,
					"content": "Ah, casi lo olvido... Aquí están los últimos datos del reconocimiento submarino. Tómenlos, estoy seguro de que les serán de utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747150115,
					"content": "¡La próxima vez podemos encargarnos de ellos por ti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}