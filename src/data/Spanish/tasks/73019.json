			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "¿Y-y bien? ¿Encontraron sabor de felicidad?... Está en Villa Gandharva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190302,
					"content": "Hay nara que carga bulto en espalda. Sabor de felicidad está dentro de bulto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Oh, hola... ¿Q-qué desean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Verás, lo cierto es que sí que queremos algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Jeje, claro que sí, todo el mundo viene porque quiere algo. Pero tan solo con decir “algo”, no voy a saber a qué se refieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Humm, pues... ¿Cómo podría Paimon explicarlo? Lo que queremos es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Algo blanco y cuadrado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "¿Blanco y cuadrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Sí, es blanco y se desmorona como la arena cuando lo frotas. Y está guardado dentro de una burbuja muy dura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "Qué descripción más extraña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Solo con eso me temo que no sé lo que es. ¿Para qué se usa esa cosa blanca y cuadrada de la que hablan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Saben para qué se usa, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Es comestible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "¿Comestible, blanco y cuadrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "¡Ah! Ya sé, ya sé lo que es... Jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "¡¿De qué te ríes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Ay, jajaja, es blanco y cuadrado, se desmorona en cuanto lo frotas, se convierte en arena... Y es comestible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "¡Tiene que ser el azúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Y eso de la burbuja dura, supongo que es el frasco de cristal donde se guarda. Por Los Siete, jajaja, una burbuja dura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "¿Qué? Así que se refería al azúcar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "Esto es un poco vergonzoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Ay, me reí tanto que hasta se me salieron unas lágrimas. He estado demasiado ocupado con mi negocio estos años. Ya ni recuerdo cuándo fue la última vez que me reí tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Pero lo cierto es que todo esto me trae muchos recuerdos. Cuando era pequeño, tenía un amigo que, al probar el azúcar por primera vez, dijo algo parecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "“¡Esta cosa blanca y cuadrada está deliciosa! ¡Increíble! ¡Es el sabor de la felicidad!”. Me sorprendió mucho su reacción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Jaja... Aunque eso fue hace muchos años, yo todavía era un niño. Pero ahora, cuando lo pienso, ni siquiera recuerdo su cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "¡Ya sé! Te daré este frasco de azúcar como agradecimiento por haberme hecho reír.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Ten cuidado. La burbuja es dura, pero si la dejas caer, se romperá en pedazos. Burbuja dura, jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "Qué vergüenza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Es para cocinar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Se usa para cocinar, es blanco y cuadrado, ¿es algún tipo de condimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
