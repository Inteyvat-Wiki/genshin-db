			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "En mi familia siempre han trabajado como comerciantes ambulantes, desde la Sima hasta Sumeru. Importamos gemas desde Liyue, y llevamos especias de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Hubo una vez... No recuerdo bien el porqué, pero mi padre me dejó un tiempo en la Villa Gandharva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Recuerdo estar en el bosque y hacer un amigo. Corríamos juntos por ahí y al final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "No recuerdo lo que pasó después. No recuerdo su nombre ni cómo era. No puedo recordar nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Solo recuerdo lo feliz que me sentí entonces. Al final, mi padre regresó y me llevó con él. Pensé en volver, pero nunca tuve la oportunidad. Y ahora he acabado olvidándolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Si no fuera porque me preguntaron por el azúcar, me habría olvidado de todas esas cosas. Es una pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "¡Eso es! Arasaka no esperaba que lo trajeran tan rápido... ¿E-es de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "#No lo habrán creado ustedes mism{F#as}{M#os} para engañar a Arasaka, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "¿Cómo vamos a crear algo solo a partir de esa descripción tuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Si no confías, puedes probarlo tú mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "No habrán puesto cosas raras dentro, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "#Claro que no. *Suspira*, ¿vas a probarlo o no? Si no, nos lo quedaremos {F#nosotras}{M#nosotros}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "N-No... No se lo lleven. Dejen que Arasaka pruebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "No se lo lleven. Arasaka probará ahora. Sí, ahora mismo... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, es de verdad... Es sabor de felicidad. Jeje, Arasaka está tan feliz de poder probar otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "No esperaba probar otra vez. *Suspira*, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Hum... ¿Cómo decir? Este sabor de felicidad no es como última vez. Por alguna razón, Arasaka no se siente tan feliz como cuando probó por primera vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "¿Será que el azúcar que nos dio no es tan dulce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "No, no, sabor es igual, pero cuando Arasaka probó con su amigo... Bueno, fue primera vez que probaba sabor de felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Arasaka piensa que en aquel entonces era más feliz que ahora. ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#Es normal, aunque sea el mismo plato, cada vez que {NICKNAME} lo prepara sabe diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "El estado de ánimo de Paimon es diferente cada vez que Paimon lo come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Exacto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "... No, no puede ser. Debe haber alguna forma para hacer que Arasaka sienta feliz como cuando probó sabor de felicidad por primera vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "Arasaka ya sabe, lo comió con su amigo de entonces. Seguro que sabor de felicidad sabe mucho, mucho mejor cuando comes con amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "#Debe ser eso. Ustedes son {F#buenas}{M#buenos} nara y encontraron sabor de felicidad. Ahora son {F#amigas}{M#amigos} de Arasaka. Arasaka hará comida para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "Sí, ¡somos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka comienza a cocinar. Añade las duraznolivas y el azúcar a la olla...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Luego, les sirve la comida.\\nComo era de esperar, sabe realmente dulce.\\nTal vez este sea el sabor de la felicidad.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah, sabe a felicidad. Está exquisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Sí, este plato sabe a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Sabe a felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Es demasiado dulce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Paimon también cree que se ha pasado con el azúcar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "¿E-en serio? Oh, parece que Arasaka puso demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Pero... Jeje, sí es cierto que sabor de felicidad sabe mejor cuando comes con amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Se siente diferente a primera vez que Arasaka comió sabor de felicidad, pero cuando comió con ustedes... Arasaka sintió otro tipo de felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Lo importante es que estés feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "En principio Arasaka no confiaba en ustedes, pero han ayudado a Arasaka a encontrar sabor de felicidad a pesar de sospechas de Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Con su ayuda, Arasaka pudo terminar su manjar supremo y practicar cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "No fue nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "¿C-cómo que nada? Ustedes han ayudado mucho a Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Arasaka ya sabe. Enseñará a ustedes a hacer este plato. Así también podrán compartir sabor de felicidad con amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Humm... Si ajustas un poco las cantidades y añades alguna cosa más, podría ser un buen aperitivo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "Necesito agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "Necesito agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
