			},
			"dialogs": [
				{
					"id": 722430102,
					"content": "Tengo un tesoro que me gustaría vender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "¿Quieres vender un tesoro? Qué sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "#Me imagino que {F#una aventurera}{M#un aventurero} tan hábil como tú debe tener objetos realmente raros para vender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Déjame echarle un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "Le hablas a Marjorie sobre el condensado dragohueso.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Ah, ¿no es esto lo que los bardos llaman “quitapesares”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "Y pensar que realmente existe... Así que su verdadero nombre es “condensado dragohueso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "#Si realmente funciona como dices, estoy dispuesta a pagar 80{NON_BREAK_SPACE}000 Moras más alguna especialidad gastronómica a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "#Humm... 80{NON_BREAK_SPACE}000 Moras y 5 pastelillos de luna, ¿qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "¿Para qué lo vas a usar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Jeje, es un tesoro único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Tiene unos efectos que parecen sacados de un cuento de hadas. Los alquimistas no dudarían en pagar un buen precio por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "Me parece un precio justo. Trato hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "Me quedo con esto, entonces. ¡Gracias por tu visita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Ah, sí. Estos condensados tienden a evaporarse lentamente con el viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "Por eso, lo mejor sería cubrirlos o colocarlos dentro de un recipiente sellado para asegurar su calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "Te doy este consejo gratis. Espero que te sirva de algo en tus aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "Si en el futuro te encuentras tesoros de este tipo, recuerda que yo siempre estaré dispuesta a comprarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Déjame pensarlo un poco más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Claro, no hay problema. No obstante, confío en mi estimación del valor de este artículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "Puedes volver a consultarme cuando lo hayas pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
