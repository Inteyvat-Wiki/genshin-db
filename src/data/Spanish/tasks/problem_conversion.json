			"dialogs": [
				{
					"id": 230190401,
					"content": "¿Qué tal? ¿Terminaste de revisar el barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Acabo de revisarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Le describes el estado del barco...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Ya veo. Así que hay un problema con las estructuras que usamos para ahorrar dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Repararlas va a costar un ojo de la cara. Si no recuerdo mal, el dueño siempre anda corto de Moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*Suspira*, será mejor que vaya a hablar con él. La vida es definitivamente más importante que el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
