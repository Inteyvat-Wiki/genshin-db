				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Hacerlo así va a costar más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "¿De qué estás hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Ah, hola. Estaba investigando un problema de diseño en un barco y me he encontrado con algunos contratiempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "La versión corta es que quiero ampliar la capacidad del barco sin aumentar los costes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Si la carga pesa mucho, la estructura podría romperse. Además, sería difícil equilibrar el barco si la carga es desigual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "La mejor manera de resolver estos problemas sería utilizar materiales de mejor calidad, pero eso aumentaría el coste de producción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "*Suspira*, no dispongo de muchos fondos, pero quiero construir un buen barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Por eso estoy intentando solucionar los problemas de costes trabajando en el diseño del barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "¿De verdad puedes hacer eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Jajaja, puede que no te lo creas, pero es más frecuente de lo que crees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Al fin y al cabo, nos dedicamos a construir barcos pesqueros que faenan cerca de la costa. No suelen encontrarse con tormentas ni temporales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Estamos tratando de ahorrarnos unos Moras a base de hacerle un par de mejoras aquí y allá. Lo importante es que funcione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Y precisamente por eso nuestro negocio de reparación de barcos va viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "#Viajer{F#a}{M#o}, si no te importa, ¿podrías revisar ese barco que acaba de volver a puerto? Parece que están teniendo problemas transportando cargas pesadas con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Precisamente estoy investigando ese tipo de problemas. A lo mejor descubro algo nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Sin problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "¡Lo dejo en tus manos! Yo tengo que ir a arreglar otro barco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "¿Por qué no vas tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Quería ir yo, pero me han pedido que repare otro barco que quieren que salga ya a recoger las redes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "#¡Eres {F#la única}{M#el único} a quien se lo puedo pedir, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
