			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "¿Por qué volvió nuestra hija antes de la fecha en la que firmó esta carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "No le demos demasiadas vueltas. Probablemente sea un malentendido. Será más útil si me ayudas a saber qué preparar para el almuerzo de mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280204",
							"2"
						],
						"stepId": 7280204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoh",
					"Michiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "Atsuko aún no volvió. Vuelve por la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Si esperas hasta la noche, Atsuko ya debería volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko debería estar en casa. Llamemos a la puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Parece que están hablando de algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Dicho esto, me pregunto qué pasó con el tanuki que rescatamos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Eres demasiado amable. Ese tanuki solo tenía un pequeño rasguño en la pierna. Si lo hubieras dejado en los arbustos, se habría recuperado solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "No pude evitarlo. Me miraba con lágrimas en los ojos. Tenía un aspecto muy lamentable. Mi conciencia no me lo permitía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Olvídalo. Nunca está mal hacer buenas acciones. Es solo que comió un poco de más, casi tanto como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "Llamar a la puerta",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "¿Quién es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "#Soy {F#la}{M#el} viajer{F#a}{M#o} que vino antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Ah, te recuerdo. Espera aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "¡Ho-Hola! Soy Atsuko, un placer conoce... Quiero decir, ¡qué bueno verte de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Lo siento, tenía nostalgia. Después de darte la carta, cambié de opinión y tomé un barco de vuelta a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Jaja... Siento no haber aclarado las cosas antes y haberte hecho viajar tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "¿Cómo volviste a Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "Ah, tenía mis maneras, jaja. No te preocupes por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Preparé tu paga, tómala. Gracias por tu ayuda. Date prisa... date prisa y sigue con el resto de tu día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "¿Cómo puede ser que las cosas que Atsuko nos cuenta ahora son diferentes a las de antes? Si volver a Inazuma fue tan fácil, ¿por qué nos pidió ayuda en primer lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "¿Qué pasó con tu negocio en Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "¿Negocio? ¿Qué negocio? ¿Tenía un negocio en Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "Ah, ese tipo de cosas no son importantes. Nada es más importante que la familia. Ya le encargué todo a otra persona, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "¡Espera! La verdadera Atsuko tuvo problemas para encontrar un trabajo en Liyue, ¡sería imposible que se volviera rica de repente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "¡Soy Atsuko, por supuesto! Me veo como Atsuko y sueno como Atsuko. ¿Por qué sospechas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "¡Mira aquí! Deja de ser tan persistente... olvídalo. No voy a hablar más contigo. Tengo que trabajar mañana. Me voy ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "¡Atsuko! Esa niña... ¿Por qué se enojó de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "#Lo siento, viajer{F#a}{M#o}. La niña debe estar muy cansada de su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Pero ustedes la vieron por sí mismos. Es nuestra hija. Esa carta... tal vez se olvidó de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Pero de todas formas, nos gustaría agradecerte las molestias que te tomaste. En cuanto al pago... ¿Podrías esperar un poco más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Nada de eso. Todavía podemos afrontar el pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "¿Recuerdas que te dijimos que Atsuko va a trabajar durante el día? El pago que recibe es extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Siempre trae semillas raras o algunos frutos silvestres, pero nunca trae Moras consigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Aunque este tipo de cosas tienen algún valor, pero si las vendemos primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "#Para {F#una}{M#un} viajer{F#a}{M#o} como tú, supongo que Mora sería más conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Vuelve mañana. Para entonces, deberíamos poder darte Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Si hay algún problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "¿Y tu mansión?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "¿Mansión? ¿Qué? ¡¿También tenía una mansión en Liyue?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
