			},
			"dialogs": [
				{
					"id": 728020601,
					"content": "¿A dónde se fue nuestra hija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "¿Qué ocurrió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Aun si tiene que trabajar al día siguiente, Atsuko suele decirnos algo antes de irse. Pero hoy se fue sin decir nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Después de que te fueras ayer, Atsuko dijo que estaba cansada y se fue directamente a su habitación a dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Cuando nos levantamos al día siguiente, ya no estaba en la cama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Intentamos buscarla por todas partes. Mi marido buscó por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Sin embargo, incluso después de medio día, seguimos sin encontrar ningún rastro de nuestra hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "*Suspira*, ¿la niña se fue de viaje otra vez? Qué niña tan problemática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Cálmate, querida. La buscaré de nuevo. Examina primero la habitación de Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Cuando se fue, no cerró bien la ventana. Muchas hojas entraron por la habitación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "Antes de que me olvide. Aquí está el pago. Tómalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "*Suspira*, esa niña, Atsuko... A dónde va esta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "¿Atsuko se fue a trabajar de nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
