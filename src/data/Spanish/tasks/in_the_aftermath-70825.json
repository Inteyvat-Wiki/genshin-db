			"dialogs": [
				{
					"id": 708250601,
					"content": "¿Cómo vas? ¿Ya terminaste de despejar el área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "Ya no hay ni rastro de esas barricadas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Fantástico. Has sido de gran ayuda, sin tu apoyo, quién sabe cuánto tiempo más estarían esas barricadas ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, por favor, acepta esto como expresión de mi gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
