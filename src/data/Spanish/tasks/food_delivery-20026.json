			"dialogs": [
				{
					"id": 200260201,
					"content": "Traje los ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260202
					]
				},
				{
					"id": 200260202,
					"content": "Con eso es suficiente. Un segundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "¡Esta listo! Ahora, ¡lleva estas <color=#00E1FFFF>albóndigas de rábano fritas</color> a Ernest, pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "... No me mires de esa manera, sé que estás muriendo de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "¡Habrá una sorpresa especial de parte de El Buen Cazador esperándote cuando regreses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
