			"dialogs": [
				{
					"id": 200260401,
					"content": "Vengo a pagar la cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260402,
					"content": "¡Estás de vuelta! ¿Hiciste la entrega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260403,
					"content": "Aquí está tu dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260404
					]
				},
				{
					"id": 200260404,
					"content": "Veamos... ¡Excelente! Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260405,
					"content": "Ten, es un <color=#00E1FFFF>asado mar y montaña</color> de parte de la casa. Está recién salido del horno, ¡así que cómelo mientras esté caliente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
