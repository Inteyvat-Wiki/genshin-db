					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200260101,
					"content": "¿Alguien pidió comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "#¡Hola, viajer{F#a}{M#o}! Llegas en buen momen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Oh, ¿dices que estás aquí para comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Entiendo, de verdad que sí... Pero te prometo que te prepararé la mejor comida que hayas probado si me echas una mano primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ernest, del Viñedo del Amanecer, a menudo pide comida de aquí para acompañar su vino, y sus pedidos siempre vienen con solicitudes especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Esta vez quiere <color=#00E1FFFF>albóndigas de rábano fritas</color> pero con huevo extra. ¡Desafortunadamente, se nos acabaron los huevos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Así que, si pudieras ir por unos cuantos huevos de pájaro, sería genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Si tanto insistes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Debe haber muchos alrededor de Levantaviento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "¡Lo aprecio mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Solo vine a comer. ¡Muero de hambre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Debe haber muchos alrededor de Levantaviento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Una vez que hayas hecho lo que te pedí, ¡te invitaré algo del menú especial de El Buen Cazador! Es lo menos que puedo hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
