			"dialogs": [
				{
					"id": 200260301,
					"content": "Su comida, señor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "¡Ajá! Mis <color=#00E1FFFF>albóndigas de rábano fritas</color>... ¡y preparadas como lo pedí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Sí, el huevo hace maravillas con la textura y el aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "¡Oh sí! Sé lo que hago cuando se trata de comida. *¡Ñam!*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Ah, y esto es para ti. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
				}
			]
		},
