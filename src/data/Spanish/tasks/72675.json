			"dialogs": [
				{
					"id": 726750301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750302,
					"content": "No amarilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750303,
					"content": "¿Eh? ¡Es cierto! ¡El núcleo de cristal no es dorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Eso es lo que dicen ustedes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Ahora que Paimon lo piensa, Paimon nunca se percató de esto, aunque ya capturamos cientos de cristalópteros antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "... ¿Esto es lo que llaman “desilusión”? ¿Eso que pasa cuando te haces mayor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Parece que tú también necesitas aprender un par de cosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "¡Pelo blanco poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750310,
					"content": "¡No le des ánimos a Paimon! ¡Paimon debería dártelos a ti, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Pero ¿no te parece decepcionante? ¿Por qué los núcleos de cristal de los cristalópteros Geo no son dorados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Sí. Mariposa amarilla. ¿Por qué no amarilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750313,
					"content": "¿Será que el organismo de los cristalópteros es así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Oh, bueno. En cualquier caso, sigamos con nuestro plan. ¡Es momento de llevar a Kichiboushi a ver el Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "#Si te soy sincer{F#a}{M#o}, no sé cómo responder a esa pregunta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "No puedo hacer nada al respecto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
		{
