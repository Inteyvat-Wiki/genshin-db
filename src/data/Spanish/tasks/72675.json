					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750601,
					"content": "Ahora, ¡llevemos a Kichiboushi a bordo del Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "No bueno. Barco hundir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750603,
					"content": "Tranquilo, el barco no se hundirá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "Este barco nos llevó hasta Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "¡Exacto! Y así fue como pudimos conocernos todos. ¡No hay nada que temer, pequeño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Hum. Kichiboushi entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750607,
					"content": "La Capitana Beidou es de fiar, y el resto de la tripulación también. ¡Hasta se podría decir que este es el lugar más seguro en alta mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Hum, ¡sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
			"id": 7267508,
			"completionStepIds": [
				7267508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
