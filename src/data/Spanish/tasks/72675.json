			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "Diferente de montaña nevada. No frío. No nieve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750102,
					"content": "¡Este es el Bosque de Piedra Guyun! La leyenda cuenta que aquí fue donde Rex Lapis derrotó a... una serpiente acuática de múltiples cabezas... ¿Cuál era su nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "¿Osial, el Señor del Vórtice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "¡Sí, ese! ¡Osial, el Señor del Vórtice! Aquí fue donde Rex Lapis lo derrotó con sus lanzas de piedra y después lo selló.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "¡Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750107,
					"content": "#¿Alucinante, eh? Pero nosotr{F#as}{M#os} luchamos contra él también, ¿sabes? En la Cámara de Jade de Ninguang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "¡Mariposa amarilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750109,
					"content": "Oh, ¿eso es lo que estabas mirando? ¡Atiende, que Paimon te está hablando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Bueno, estos se ven diferentes a los de Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Seguro que es la primera vez que ve un cristalóptero que no sea violeta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Bueno... Puede ser. De acuerdo, ¿puedes capturar uno para él, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "¿Y por qué no vas tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Porque tú tienes más experiencia en estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "De poder, se puede, pero solo podemos capturar su núcleo de cristal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "¡Sí! ¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750115,
					"content": "Aquí la única que puede flotar eres tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Cierto, ¡pero tú tienes más experiencia atrapándolos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "¿Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
