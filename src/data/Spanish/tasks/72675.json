					"speakerTitle": "Paimon"
				},
				{
					"id": 726750402,
					"content": "¡Guau! ¡Agua mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750403,
					"content": "¡Grande! ¡Muy grande! ¡En agua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750404,
					"content": "Muy grande, pesar mucho. ¿Por qué no hundir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750405,
					"content": "Porque el Alcor es un barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Pero barco de barro hundir, Ioroi contar a Kichiboushi. Historia de conejo, tanuki y barco de barro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750407,
					"content": "Humm... Bueno, eh... El Alcor no está construido de barro. Por eso no se hundirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "¿Por qué barco grande no hundir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750409,
					"content": "Guau, hablas cada vez más fluido, Kichiboushi. Pero... ¿cómo podría Paimon responderte?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Jeje, {NICKNAME}, ¿por qué los barcos flotan sobre el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Los barcos están hechos de madera. ¡Viva el poder Dendro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "¿Eh? ¿Eso lo hace el poder Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Humm... ¿Entonces por qué no flotan los Hilichurls si llevan escudos de madera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Ay... Kichiboushi no entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750417,
					"content": "No te preocupes, Kichiboushi. Algún día, cuando seas mayor, ¡serás tan listo como Paimon! Entonces comprenderás todas estas cosas: por qué los barcos flotan, por qué nieva en Espinadragón... ¡Lo entenderás todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "#No estoy segur{F#a}{M#o} de que tú lo hayas comprendido, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "¡Sí! Sea como sea, podemos divisar el Alcor desde aquí. ¡Tomemos una imagen de Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "¡Imagen! ¡Dibujo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726750424,
					"content": "¡Sí, eso es! De acuerdo, ¡quietecito, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Está bien si no lo has comprendido, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Tampoco tienes por qué entenderlo todo en esta vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Los barcos pueden flotar si su flotabilidad excede la fuerza de la gravedad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "Ooh, Paimon ya entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
