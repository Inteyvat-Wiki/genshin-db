				"objectNames": [
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722641401,
					"content": "¡Yuju! ¡Entrenar es divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641402,
					"content": "#Qué bien que estés tan contento con {F#nosotras}{M#nosotros}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "Pelo rubio es muy fuerte. Buum buum y cosa grande redonda desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641404,
					"content": "Eso es porque entreno mucho, ¿sabes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "¡Hum! Kichiboushi fuerte como pelo rubio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641406,
					"content": "¡Entrenar, entrenar y entrenar! ¡Más fuerte, más fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641407,
					"content": "¿Y qué harás cuando seas más fuerte, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "¡Vengarme de Gyoubu Koban! ¡Muajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641409,
					"content": "Sacar a Ioroi de la piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641410,
					"content": "#Ánimo con eso. Nosotr{F#as}{M#os} te ayudaremos con tu ruta de entrenamiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722641412,
					"content": "Nos divertiremos mucho. ¡Hasta pronto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
			"id": 7267501,
			"completionStepIds": [
				7267501
			],
