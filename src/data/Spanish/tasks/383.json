			"dialogs": [
				{
					"id": 3830201,
					"content": "¡Yupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830202,
					"content": "¡Escuadrón de Protección de Dvalin! ¡Todos juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830203,
					"content": "Bien, saquemos los cristales que hemos reunido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830204,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830205,
					"content": "El color de estos cristales es un poco turbio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830206,
					"content": "Dvalin... debes estar sufriendo mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830207,
					"content": "#En fin, comencemos por purificar estos cristales. Viajer{F#a}{M#o}, haz los honores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "Es difícil de creer que algo así es posible, hasta que lo ves con tus propios ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Interesante. Da una sensación refrescante, parecida a la de filtrar vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830210,
					"content": "Creo que ya tenemos lágrimas suficientes. Y ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
