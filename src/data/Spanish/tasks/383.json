			"dialogs": [
				{
					"id": 3830401,
					"content": "¡Funcionó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830402,
					"content": "Se ve completamente diferente a como antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830403,
					"content": "Parece que el poder Anemo de la lira ha sido restaurado por completo. Deberíamos poder usarla ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830404,
					"content": "#Todo gracias a ti, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830405,
					"content": "¿Dónde deberíamos invocar a Stormterror?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830406,
					"content": "Debería ser lejos de la ciudad, o habrá pérdidas si fracasamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830407,
					"content": "¿Tal vez aquí en el viñedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830408,
					"content": "Podría reparar el viñedo en caso de que fuera destruido, pero preferiría evitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830410,
					"content": "El viento en la orilla del mar o en un lugar elevado podría ayudar a que los versos del bardo lleguen más lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830411,
					"content": "No funcionará si el viento es muy seco o asfixiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830412,
					"content": "Paimon lo entiende. En el mar o desde un lugar alto, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830413,
					"content": "Entonces, el lugar más adecuado para tocar la lira es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830414,
					"content": "¿Desde un acantilado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "Si vas al este del Lago Estelar, encontrarás unas montañas al sur de la costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830419,
					"content": "#¡Oh! Debe ser la playa en la que le contaste a Paimon sobre tu {F#hermano}{M#hermana}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830420,
					"content": "Si sigues las montañas, llegarás a un lugar llamado <color=#00E1FFFF>Acantilado Estrellado</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830421,
					"content": "¿Qué dices, bardo? Cumple con todos los requisitos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830422,
					"content": "Déjame pensar... El Acantilado Estrellado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830423,
					"content": "De acuerdo, ¡hagámoslo ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830424,
					"content": "Muy bien. Entonces, nos reuniremos en el Acantilado Estrellado cuando estén listos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830425,
					"content": "Por favor, no lleguen tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830426,
					"content": "¡A sus órdenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830427,
					"content": "Oh, lo siento. No quise sonar mandona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830415,
					"content": "¿Cerca del mar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "¿Mientras vuelas con estilo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Ni siquiera Amber pensaría en hacer algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Jean"
				}
			]
		}
	]
