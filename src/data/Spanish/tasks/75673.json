			"dialogs": [
				{
					"id": 756730101,
					"content": "Parece que nuestros Ashas coloristas se han quedado muy satisfechos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "¡Otro desafío completado para nuestros maravillosos Ashas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "¡Genial! ¡Lo logramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "¿Está este Asha inspirado para empezar otra obra de arte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "La inspiración puede aparecer y desaparecer en un abrir y cerrar de ojos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ah, miren todo el tesoro que ha dejado... ¡{NICKNAME}, Paimon, quédenselo ustedes dos! ¡Es lo mínimo después de todo el esfuerzo que han hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Tal vez podamos ver la obra de arte del Asha colorista la próxima vez que vengamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "¡Imagínense cómo será! Sobre todo teniendo en cuenta que los Ashas normales ya son capaces de crear colores tan bonitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "¡Paimon se muere de ganas por saber qué crearán los Ashas coloristas! Quizás logren algo... completamente indescriptible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Algo como los colores del flogisto, de la luna o de las profundidades de un cielo estrellado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "¡Sí, así debería ser! Si durante nuestras aventuras nos encontramos con una criatura en problemas, ¡deberíamos hacer todo lo posible por ayudarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "¡Eso, eso! ¿Quién sabe? ¡Tal vez un día recibamos una recompensa inesperada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Estoy de acuerdo con Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ah, pero... no deberíamos hacerlo solo porque esperemos una recompensa. Eso no es lo importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Aunque no obtengamos nada a cambio, ayudar a los amigos cuando lo necesitan y ver cómo vuelven a sonreír cuando todo mejora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "... ¡Eso es lo que me gusta a mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "Y también es algo muy gratificante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Hay que aprovechar cuando se presenta una oportunidad así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}