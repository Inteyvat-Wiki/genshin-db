			"dialogs": [
				{
					"id": 730580401,
					"content": "¡Vamos a escondite de nara malos a descubrir qué están haciendo aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "¿Cómo puedes saber si alguien es malo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Bueno, Aragaru no sabe cómo explicarlo, ¡pero nara {NICKNAME} y cosa blanca voladora no son mal{F#as}{M#os}! ¡Aragaru está seguro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
