			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#¡Nara rubi{F#a}{M#o} y cosa blanca voladora! ¡Otra vez nos encontramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "¡Ay! ¡La próxima avisa antes de aparecer de la nada! ¡Paimon se asustó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "#No somos mal{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#Humm, tiene sentido... Entonces, nara {F#rubia}{M#rubio} y cosa blanca voladora, ya que no son mal{F#as}{M#os}, ¿pueden ayudarme de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Será un placer, yo soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Y Paimon es Paimon, ¡esta vez no lo olvides!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "¿Esta vez? Eh... *Ejem*, ¡llámenme Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Ya hemos estado en este lugar antes, pero no lo recuerdas... *Suspira*, ¡no es fácil de explicar! {NICKNAME}, ¿por qué no se lo explicamos junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Le cuentan a Aragaru sobre las aventuras que vivieron juntos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "¿Ah, sí? Aragaru no recuerda, pero quiere creer en ustedes... Además, tienen flor que Aragaru regaló. Aragaru puede sentir que está aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "¡Oh, cierto! Nara malos abandonaron campamento. Vamos a ver qué dejaron, ¡veamos que están tramando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Atrapamos a los malos por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
