			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "¿Bien? ¿Encontraron algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Humm... Solo encontramos unas órdenes confusas. ¡Y esto! ¡Una flor seca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "¡¿Eh?! Esta flor... ¿Pueden dar a Aragaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Es de los malos, ¿no te da miedo que esté envenenada o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "No preocupen, he visto flor antes. Nara debe ser alguien conocido. Denme flor, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Claro, aquí tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#¡Muchas gracias, nara {F#rubia}{M#rubio} y cosa blanca voladora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru se lleva la flor seca a la Arboleda Moutiyima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
