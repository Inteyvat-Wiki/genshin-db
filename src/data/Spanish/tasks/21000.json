			"trigger": {
				"objectNames": [
					"Pequeño Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "*Suspira*... ¿De verdad podré hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000102,
					"content": "Meng, ¿estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#Ah, {NICKNAME}, eres tú... Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000104,
					"content": "Te ves triste, Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "¿Qué pasa? ¿Los otros niños no quieren jugar a los piratas contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "¿Eh? No es eso. Lulu y Fei regresaron a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000107,
					"content": "Yo... quiero dar un paseo por mi cuenta, así que todavía no volveré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000108,
					"content": "¿Tus padres no se van a preocupar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "A esta hora, mis padres deben seguir trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000110,
					"content": "Pero no hablemos de eso. ¿Puedo hacerte una pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000111,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{NICKNAME}, he oído muchas historias de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000115,
					"content": "Has visitado muchos lugares y has visto muchas cosas, así que tal vez puedes responderme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000116,
					"content": "Vaya... Meng se ve tan serio. ¿Cuál es el problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "#{NICKNAME}, quiero preguntarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000118,
					"content": "¿Cómo puede uno “madurar”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000119,
					"content": "Se necesita tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "¿Estás diciendo que solo se necesita ser mayor para madurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000121,
					"content": "Pero, si uno espera hasta ser mayor, ¿no es demasiado tarde para madurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000124,
					"content": "Bueno, si quieres dar una vuelta fuera de la ciudad, ¡podemos ir contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "No quiero molestarles. Además, no creo que consiga nada con salir de la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000126,
					"content": "Quería pedirles que me ayuden con algo más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000127,
					"content": "Dicen que si tienes algún pensamiento que no te deja en paz, puedes escribirlo, ponerlo en una botella y dejar que se vaya flotando en las aguas del río...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000128,
					"content": "Tal vez así solucione mi problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000129,
					"content": "Pero escuché que hay muchos monstruos por ahí. No es muy seguro que vaya por mi cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000130,
					"content": "Así que, ¿podrían protegerme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000131,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#¡Gracias, {NICKNAME}! Te pagaré con el dinero que he ahorrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000134,
					"content": "¡En marcha! Primero vayamos al Río Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000132,
					"content": "Cuenta conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Se necesita vivir ciertas experiencias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Ciertas experiencias... Pero hasta ahora no he salido de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000112,
					"content": "Me temo que no tengo tiempo para jugar contigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Jajaja, solo juego con Lulu y Fei, pero ahora ellos no están, así que no podemos jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
