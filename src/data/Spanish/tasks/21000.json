			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "No puedo creer que exista algo así... Casi me mata del susto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000302,
					"content": "#¡Gracias, {NICKNAME}! Continuemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000303,
					"content": "¿Eh? ¿Y mi botella? Estaba aquí hace un momento, ¡pero desapareció!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000304,
					"content": "¿Se habrá caído cuando esa Megaflora nos atacó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000305,
					"content": "#Por favor, {NICKNAME}, ¡ayúdame a encontrarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100017",
							"3"
						],
						"stepId": 2100017,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100011",
							"2"
						],
						"stepId": 2100011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Qué alivio... Ayer me pasé toda la noche escribiendo ese mensaje. Si se hubiera perdido, tendría que escribirlo de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000502,
					"content": "Guau... ¿Tantas preocupaciones tienes? ¿Cómo pudiste pasar toda la noche escribiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "No... No es que tenga tantos problemas. Solo quiero saber cómo madurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000504,
					"content": "He buscado mucha información y he leído muchos libros, pero cuanto más leo, más preguntas tengo...",
