			"dialogs": [
				{
					"id": 210000201,
					"content": "¿Ya llegamos? Humm... Hay que escoger un buen lugar para soltar la botella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210000202,
					"content": "Si quieres que la botella llegue más lejos, hay que escoger un lugar río arriba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
