			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Sobre esta roca tan rara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "¿Así que has capturado una imagen de una roca muy rara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "¡Deja que le eche un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Aquí tienes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "¡Por Los Siete! ¡Fíjate en esto! Qué buena calidad de imagen... Los nuevos modelos de Daguerrotipo hechos en Fontaine sí que son tan buenos como dicen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Una vez compré unos prototipos, pero todas las imágenes salían borrosas. Además, eran demasiado aparatosos como para que los manejara una sola persona. Así que al final se quedaron acumulando polvo en la Academia de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Acumulando polvo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Pues sí, me costó el Mora de toda una comida. Hum... Tal vez debería comprarme unos nuevos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Me desvié del tema. Déjame ver. Esta roca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Sí, ¡es un fósil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "¿Un fósil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Pues sí, y hay muchas criaturas marinas fosilizadas... Qué interesante. En Liyue tienen un refrán que dice algo como “el vasto océano es capaz de engullir bosques y praderas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "El hecho de que este fósil haya aparecido en la Sima quiere decir que estas criaturas fueron enterradas bajo tierra en un instante. Si no, sus cuerpos no se habrían conservado en tan buen estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "Ahora que lo mencionas, he oído que en esta zona se producen muchos terremotos... Ahora todo tiene sentido. Los movimientos de tierra son un requisito fundamental para la formación de fósiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Este descubrimiento arrojará luz en nuestra investigación sobre el tipo de criaturas que solían vivir en este lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Pero una sola imagen no será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Si te encuentras con otros fósiles, no olvides traerme las imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "¿Cuántas imágenes necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Déjame pensar... Necesitaré 4 o 5 imágenes para incluir en el informe. Bien, con 5 me bastará. Tráeme 5 imágenes de rocas como esa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Te las pagaré a buen precio. Al fin y al cabo, es un gran descubrimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Qué desperdicio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
