			]
		},
		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Bien, muy bien, estas imágenes son muy buenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "Sin duda vale la pena gastar el presupuesto del equipo de espeleología en estas imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Fíjate, son huesos de antiguas criaturas marinas. Puedes apreciar claramente los detalles de sus estructuras óseas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Esto demuestra que antes de que se formara la Sima, este lugar estaba situado bajo el lecho marino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Es una pena. Si hubiésemos descubierto estos fósiles más cerca de Sumeru, podría llevarlos directamente a la Academia para estudiarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "No podemos permitir que cualquier minero estropee estos fósiles. Lo he hablado con el Ministerio de Asuntos Civiles y van a enviar a alguien a vigilar que no le ocurra nada a los fósiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Pero ¿qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Bueno, tendré que conformarme con estas imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Como ya he dicho, los fósiles están en perfecto estado de conservación y su estructura aún permanece intacta. Eso solo puede significar una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Fueron sepultados a gran velocidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "La mayor parte de los fósiles de la Sima se localizan a una altura determinada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "¿A una altura determinada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Bueno, desde un punto de vista geológico, la diferencia de altura es minúscula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Todo ocurrió muy deprisa, por lo que la mayoría de fósiles se formaron al mismo tiempo. En definitiva, algo alteró el ecosistema del lugar de manera abrupta y rápida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Algo como una gran onda... O algo por el estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Humm, ¿qué pasó exactamente en la Sima...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "Pero hay una gran diferencia de altura en ciertos casos, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "¿Es que no te basta con las imágenes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
