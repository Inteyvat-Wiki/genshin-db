	"talks": [
		{
			"id": 7105006,
			"completionStepIds": [
				7105206
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
