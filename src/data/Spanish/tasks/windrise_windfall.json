			"dialogs": [
				{
					"id": 207432001,
					"content": "¿Despejó las rutas comerciales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "No hay monstruos en la costa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Excelente, ahora el negocio de nuestra bodega podrá recuperarse poco a poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Creo que debería haber informado al Señor Diluc de este asunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Pero no lo encuentro por ningún lado. Lo he buscado por todas partes del viñedo, pero nadie sabe a dónde fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde dijo algo así como que “el Sr. Diluc fue a atender un asunto personal”, pero se rehusó a decir una palabra más. Ni siquiera se veía preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*Suspira*, olvídelo. Cuando regrese, hablaré con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
