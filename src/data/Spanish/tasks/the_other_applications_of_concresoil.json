			"dialogs": [
				{
					"id": 230091701,
					"content": "Gracias. Así ya tengo todos los materiales que necesito por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091702,
					"content": "Espera aquí, voy a revisar las proporciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091703,
					"content": "Akim comienza a mezclar los componentes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "#Bien, ya está. Toma, viajer{F#a}{M#o}, llévale este barro a Nima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "Lleva mucho tiempo esperando el barro. Seguro que se está impacientando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "Ese muchacho tiene una imaginación extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima me contó que quería crear un ejército de guerreros hechos de vasijas de barro capaces de hablar, rodar, derribar a los enemigos y adquirir todo tipo de habilidades especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "Por lo visto, las habilidades de esos guerreros vasija dependería de lo que guardaran dentro de sí mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "Además, les dio nombres muy curiosos. ¿Cómo eran? Uno se llamaba Adrián o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Jajaja... Es del todo imposible, pero me pareció muy curioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "Pensé que con esas ideas tan novedosas, podría darle un poco de barro para jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "Así, podrá modelar sus guerreros vasija con sus propias manos y convertirse en el Shogun de los guerreros vasija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Bueno, basta de cháchara. Llévenle el barro a Nima, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "A lo mejor cuando termine de crear su ejército, nos nombre a ti y a mí generales de los guerreros vasija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
