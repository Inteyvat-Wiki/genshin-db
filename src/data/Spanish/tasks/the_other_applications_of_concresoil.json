			"dialogs": [
				{
					"id": 230091101,
					"content": "#¡Viajer{F#a}{M#o}! Llegas justo a tiempo. Necesito ayuda urgentísimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "¿Algún progreso en la investigación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Bueno... Yo no lo llamaría avance, pero uno de mis clientes me dio un buen consejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Me dijo que le gusta cultivar flores, y que lo que más le cuesta es encontrar el sustrato adecuado para ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "Tiene que ser transpirable y nutritivo, no demasiado absorbente, ni demasiado deshidratante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Vio que conseguí mejorar tanto mi lodomento que me preguntó si podría crear una fórmula para un sustrato condensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Creo que es un punto de vista muy interesante, así que estoy buscando otros materiales para mejorar mi lodomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Esta vez, me gustaría pedirte que excaves y me traigas algo de barro fértil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Te marcaré en el mapa la localización de este tipo de barro. Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "¿Por qué está tan lejos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "Alguien me habló de ese lugar. Está un poco lejos, pero me dijeron que el barro de allí es muy fértil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091112,
					"content": "Pero, parece ser que hay muchos monstruos en esa zona, así que no me atrevo a ir yo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091113,
					"content": "#¡Eres {F#la única}{M#el único} a quien se lo puedo pedir, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091110,
					"content": "¿Cómo encontraste este lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
			]
