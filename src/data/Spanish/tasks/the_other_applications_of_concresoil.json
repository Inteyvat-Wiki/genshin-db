			"dialogs": [
				{
					"id": 230091401,
					"content": "Qué desastre... ¿Qué ha podido pasar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091402,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "#¡Ah! Eres tú, viajer{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "Pues mira, tengo problemas con el lodomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "No sé si es que mi fórmula está mal, o que no pensé bien en su aplicación práctica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Muchos clientes que construyeron sus cocinas con mi lodomento se quejan ahora de que el barro se agrieta después de un par de días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Tal vez la temperatura sea demasiado alta y eso provoque que alguno de los componentes del barro no cumpla con su cometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "Sea como sea, tuve que ir y ayudar a cada uno de ellos a arreglar los desperfectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Como había tanta gente a la que ayudar, no pude llevarme conmigo el lodomento sobrante, así que les pedí que lo guardaran en vasijas. Y al final resulta que hay un montón de vasijas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "#Viajer{F#a}{M#o}, necesito que vayas a estas casas a recuperar el lodomento y me lo traigas. Yo iré al resto de las casas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "*Suspira*, ¿en qué me habré equivocado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
