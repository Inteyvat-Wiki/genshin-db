			"dialogs": [
				{
					"id": 230090201,
					"content": "Tengo que ir a comprar más materiales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "¿Cómo te va con tu lodomento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "¡Muy bien! Me atrevería a decir que este barro tiene más usos de los que podría haber imaginado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Se puede utilizar para hacer jarrones y vasijas, y también para reparar grietas en edificios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Solo hace falta ajustar un poco las proporciones de la mezcla y se podrá usar para construir una casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "El problema es que ahora todos vienen a comprarme barro y estoy agotando los materiales a una velocidad preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "#Lo peor es que ya casi no me queda condensado de Slime. Viajer{F#a}{M#o}, ¿me harías el favor de ir a buscar 3 condensados más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "De acuerdo, déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#Por favor, viajer{F#a}{M#o}, tráeme de nuevo 3 condensados más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "¿Y qué hay del resto de los ingredientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Ya se los he encargado a otros proveedores o le he pedido a alguien que vaya a buscarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Pero no me esperaba que gastara mis existencias de Slime tan rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
