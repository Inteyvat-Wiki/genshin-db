			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "¡Espera un momento! ¿Tú también estás aquí por el Torneo del Rey de los Invocadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Si tienes tiempo, me gustaría presentarte un evento que está organizando el Gremio de Aventureros llamado “Peregrinaje turístico”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "S-supongo que tengo un rato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "¡Muchas gracias! Entonces, te explicaré en qué consiste el evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "En pocas palabras, el Gremio de Aventureros ha colocado varios puntos turísticos por toda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Todo lo que tienes que hacer es encontrar estos puntos turísticos y marcarlos en el Manual turístico con los sellos conmemorativos de cada lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Habrás completado el desafío cuando hayas encontrado todos los puntos y hayas conseguido todos los sellos conmemorativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Este evento es muy del estilo del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Jeje, hemos pensado bien las ubicaciones de los puntos turísticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Sin embargo, algunos puntos turísticos están colocados en ubicaciones bastante remotas y no puedo asegurar que no aparezcan monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "#Pero seguro que lidiar con ellos será pan comido para alguien tan experimentad{F#a}{M#o} como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "¡Esto es todo! Enseguida te doy el Manual turístico. ¡Que te diviertas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Bueno, cuéntame de qué trata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}