					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "¡Has vuelto! ¡No puedo esperar a escuchar tus nuevos hallazgos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229601,
					"content": "Encontré dos estelas más...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "¡Déjame ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "“Y, entonces, ambos lucharon en la Llanura Guili, donde la arena negra asfixió los cielos y mil rocas se rompieron en pedazos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Al parecer ocurrió una guerra de grandes proporciones en la Llanura Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "La Congregación de Guili debió desaparecer en esta guerra. Pero, según el otro fragmento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "... al parecer hubo una persona que se negó a dejar la Congregación de Guili y se quedó a protegerla y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "... Y, además, hay un tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "... Claramente tienes afición por los tesoros. Pero tienes razón. De hecho, hay un tesoro en la Llanura Guili, a juzgar por este texto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Pero la primera parte menciona algo sobre los “Cuatro Mandamientos de Guizhong”, y la segunda dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "“Enseña con sabiduría, gobierna con virtud, mantente firme y únete en la ambición. La unión entre estos Cuatro Mandamientos se conocerá como la «Congregación de Guili»”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Humm... No sé por dónde empezar a descifrar estos fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Será mejor que regresemos a la Posada Wangshu. Después de descansar y reorganizarnos, podemos volver a intentar descifrar los Cuatro Mandamientos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
