					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "¿Encontraste alguna pista en las ruinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229501,
					"content": "Encontré cinco estelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "¡Excelente! Déjame ver... Oh, la secuencia de estos pasajes está mal, déjame ordenarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "Hay muchos textos incompletos, hay partes faltantes, y no sé cuál es el orden correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "En fin, trataré de ponerlos en orden. Creo que la secuencia es así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "“... En el principio, cuando la gente se congregó para cultivar la tierra, una diosa llamada Guizhong descendió del cielo. Reinaba sobre la Arena y arropó los cielos en un territorio de mil millas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "“La diosa estableció cuatro mandamientos para la gente. Pero más tarde, un nuevo dios, poseedor del poder Geo, descendió e hizo que la gente de Liyue, a quien ofreció protección, se congregara una vez más”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "“Esta congregación recibió el nombre de Guili, el cual provenía de la combinación de los nombres de los dos dioses”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "Humm... Al parecer este fragmento narra la historia de la Congregación de Guili, y de su protectora. Todo indica que era una diosa capaz de controlar las arenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "Además, dice que hubo otro dios que llegó después, quien trasladó a una parte de su pueblo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "El nombre de la Congregación de Guili proviene de la unión de los nombres de ambos dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "Este documento es único. No solo menciona a dos dioses que coexistieron, sino que incluso cooperaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "Más que dos dioses, debería decir que eran dos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "Pero es muy extraño. Falta el resto de la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "¿Y por qué la Congregación de Guili terminó en ruinas? Con dos protectores, ya fueran desastres naturales o humanos, ninguno sería capaz de acabar con la Congregación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "Definitivamente ocurrió una catástrofe que ni los dioses pudieron evitar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ir de nuevo a buscar más pistas? Si estoy en lo correcto, debe haber más estelas de las que encontraste antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "Quizás esas estelas contengan la segunda parte de la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "Aunque, por lo que veo, lo que se registra en estas estelas de piedra difiere con lo que se documenta en algunas fuentes escritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "*Suspira*, tantas leyendas y relatos... Me pregunto cuál de todos dirá la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
