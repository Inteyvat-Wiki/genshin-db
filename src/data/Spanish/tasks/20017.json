			"dialogs": [
				{
					"id": 200170401,
					"content": "#Muchas gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170402,
					"content": "Parece que esos monstruos no piensan irse a ningún lado. Mejor me voy lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170403,
					"content": "Golpearon el carruaje una vez más. No tiene sentido tratar de arreglarlo a la perfección... Supongo que tendré que arreglármelas con una soga. Oh, por Los Siete, ¿dónde puse mi soga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170404,
					"content": "#¡Maldición! Estoy seguro de que ese grupo de monstruos se la llevó. Viajer{F#a}{M#o}, ayúdame a encontrar una <color=#00E1FFFF>soga</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
