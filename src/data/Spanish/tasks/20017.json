				"objectNames": [
					"Farrah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "#¡No, por favor! ¡No me hagan daño! No me... ¿Eh? Viajer{F#a}{M#o}, ¿a dónde fueron todos los Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "¡Excelente! ¡Muchas gracias! ¿De verdad se han ido todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "¡Uf!... Te debo una. Después de todo este alboroto no podré alcanzar a la caravana ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Además, mi carruaje está roto. Necesito arreglarlo y dirigirme a la ciudad antes de que la fruta se eche a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "No imaginas el olor de esta fruta cuando se descompone. No se puede quitar aunque lo laves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Voy a tener que aprovisionarme de nuevo... Ya puedo oler que algunas de las frutas se echaron a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "¿Puedes ayudarme a buscar algunos materiales para arreglar mi carruaje? Con una <color=#00E1FFFF>tabla de madera</color> debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
