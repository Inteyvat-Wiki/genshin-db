			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "#¡Ustedes dos! L{F#a}{M#o}s he estado esperando un buen rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "¿Pudiste entablar amistad con la Regisvid Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Ay, ni lo menciones. Después de la interacción que tuvieron con ella, se calmó, pero solo durante un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "En cuanto se recuperó, adoptó una actitud muy amenazadora... ¡Qué susto me llevé! Parece que tenían razón, hacerse amigo de una Regisvid Pyro es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Bueno, al menos el fruto de la Regisvid Pyro es muy sabroso. Sabe como a Pyro. Seguro que a mis amigos de Natlan les gustará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Paimon no puede imaginarse qué sabor es ese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "¿Quieres probarlo? Si quieres, puedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Eh... ¡Mejor no! Volviendo al tema, ¿aún piensas desafiar a un Protodragarto Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Claro. Creo que tenemos bastantes posibilidades, ya que los Protodragartos Geo se parecen bastante a los Tepetlisaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Si hacen como yo y van a Natlan desde Sumeru, será la primera cosa que se encuentren por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Está bien, aunque Paimon tiene el presentimiento de que esta vez tampoco irá bien... ¿Por qué no intentarlo mejor con una Cría de Dragarto Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "Porque su barriga no es rechoncha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "La barriga de las Crías de Dragarto Geo no es rechoncha, seguramente porque siempre andan rodando a gran velocidad y queman toda su grasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*Suspira*, en realidad, la razón principal es que no es lo suficientemente emocionante. ¿Qué tendría de especial una Cría de Dragarto Geo para los habitantes de Natlan, que conviven con los saurios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Los Protodragartos Geo ya son otra cosa. Oponentes formidables incluso en las historias. ¡Cuanto más fuerte es el rival, más poderoso parece el protagonista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Bueno, no perdamos más tiempo. ¡El Protodragarto Geo nos espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Ahora no tengo tiempo, hasta luego.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "No hay problema. Aquí estaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}