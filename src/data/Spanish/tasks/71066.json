			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "¡Sí! ¡Este es! ¡Mil gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "¡Acepten esta recompensa! Aunque no es mucho, espero que no les importe... ¡Voy a plasmar esto en mis poemas y luego los cantaré a los cuatro vientos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
