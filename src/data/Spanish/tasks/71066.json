				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Jeje... Disculpen, disculpen... Como poeta que soy, siempre añado a la narrativa un toque de ficción... Así la historia queda más original, ¿saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Jeje, en realidad ese anillo lo encontré en la madriguera de unos hurones ladrones de tesoros hace un par de años... Estaba en buen estado y era bonito, así que me lo quedé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "¡Así que robaste lo que robó otro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Eso suena demasiado feo... Solo lo recogí, ¡no hay nada de malo en eso! Además, le tengo aprecio a ese pequeño tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "¿Tienes alguna pista de dónde podría estar el anillo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Sí... Escuché que por esta zona suele haber hurones ladrones de tesoros... Quizás aprovecharon que estaba dormido para robarme el anillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Así que hay personas que se quitan los anillos antes de dormir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Nunca lo había escuchado antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Desde luego, ¡Paimon no tiene esa costumbre! Hay que tomarse un tiempo para decidir dónde guardar el anillo una vez que te lo quitas. Eso te haría perder valiosas horas de sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "¿También hacen anillos para los deditos de Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "¡Por supuesto! ¡En este mundo tiene que haber de todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Bueno, ¡espero que ustedes dos no vayan por ahí juzgando de cualquier manera las costumbres de la gente, criticándola a sus espaldas! ¡Eso estaría muy feo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "De todas formas, si quieren ayudarme a encontrar el anillo... Deberían comenzar buscando en las madrigueras de los hurones ladrones de tesoros, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "He oído que los Ladrones de Tesoros establecieron en este punto del mapa un campamento sospechoso. Aquí, se lo marco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Según dicen, en esta zona aparecieron hurones ladrones de tesoros. Es muy probable que tengan relación con esos sinvergüenzas de los Ladrones de Tesoros. En fin, deberían ir a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hum... Si los hurones ladrones de tesoros te robaron el anillo que tú les robaste en un principio, ¿no significa que el anillo regresó con su dueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "¡Deja de boicotearme, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
