					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660201,
					"content": "¡Volviste! ¿Cómo fue? ¿Lo recuperaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660202,
					"content": "Mira, ¿es este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106603,
			"completionStepIds": [
