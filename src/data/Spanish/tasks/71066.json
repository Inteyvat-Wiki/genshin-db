			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitofo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Hola, ¿ha pasado algo últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660802,
					"content": "Sobre los hurones ladrones de tesoros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Oh, ¿quieres decir los hurones ladrones de la Sima? Jaja... En un principio, yo tenía que encargarme del asunto, pero lo estropeé... No puedo decirles nada bueno, la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660804,
					"content": "Pues... Es muy poco probable que yo pueda atraparlos... Al fin y al cabo, aparecen y desaparecen como si fueran fantasmas. Es imposible alcanzarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660805,
					"content": "Pero, si esos sinvergüenzas robaron algo a alguien, puedo darles unos pequeños consejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660806,
					"content": "Los ladrones de tesoros alimentan a los hurones ladrones que crían a determinadas horas. Hay tres tipos diferentes de hurones ladrones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660807,
					"content": "Los más fuertes son los hurones ladrones dorados... Después diría que los más comunes son los hurones ladrones de tesoros y luego están los hurones ladrones novatos, que son los menos listos. Pero ¿a qué horas salen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660808,
					"content": "Ay... Debería haber un manual o algo así en el que escriban las horas. Si no, ¿cómo se iban a acordar? No debe estar lejos del campamento a donde van los hurones ladrones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660809,
					"content": "Oh, ¡por poco me olvido! Para que vayan hacia ustedes, solo tienen que silbarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitofo"
				},
				{
					"id": 710660810,
					"content": "¿Silbarles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Sí, un simple silbido es suficiente, no tienen que esforzarse demasiado, solo tienen que hacerlo en el momento idóneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitofo"
				}
			]
		}
	]
}