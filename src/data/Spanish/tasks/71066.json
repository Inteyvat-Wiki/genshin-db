				"objectNames": [
					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "*Suspira*... Qué extraño... ¿Cómo puede ser?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Debería estar por aquí, ¿por qué no lo encuentro?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Mi anillo... No lo veo por ningún lado. Ese anillo es muy importante para mí, no puede ser que lo haya perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "¿Cómo es el anillo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Está hecho de latón y lleva incrustada una gema preciosa de color rojo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Lo encontré en el lago de lava junto a la guarida del legendario dragón Durin. Eso explica por qué parece tener un siniestro resplandor, como el de una llama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Cuenta la leyenda que, en el momento en que su dueño se lo ponga, el Señor del Abismo se fijará en él y será perseguido por un ejército oscuro hasta la muerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
