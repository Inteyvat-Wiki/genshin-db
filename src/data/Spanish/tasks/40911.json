			"dialogs": [
				{
					"id": 409110301,
					"content": "Ahí tienes. Entonces. Hela aquí, la <color=#00E1FFFF>Fragua Elemental</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Vamos a encenderla y ver si funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091104,
