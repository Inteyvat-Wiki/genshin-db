				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "¿Ya colocaste las balizas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Bien hecho. Ahora solo tenemos que dejar que recopilen los datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "¿Cómo sabías dónde colocarlas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Formé parte del equipo de diseño de la Fragua Mikage. Colocar balizas en estos puntos te dará básicamente todos los datos del interior de la Fragua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150306,
					"content": "Humm, si instaláramos dispositivos de purificación en estos lugares, nuestros problemas estarían resueltos de la noche a la mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150307,
					"content": "El Sr. Flois seguramente enloquecería si se enterara de la situación actual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150311,
					"content": "Muy bien, gracias por tu ayuda. Ten, llévate esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150312,
					"content": "*Ejem*... Humm... Además, puede que tenga que volver a molestarte para que vayas a recuperar las balizas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150313,
					"content": "No tengo una Visión, así que no puedo viajar por zonas saturadas de energía de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150314,
					"content": "Además, los Fatui siguen ahí dentro. No creo que haya nadie más que tú en esta isla que pueda ocuparse de ellos y de la fragua al mismo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150308,
					"content": "¿Estas balizas están a la venta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
				{
					"id": 721150309,
					"content": "¡Jaja, qué buena broma! Si quisiera vendértelas, ¿qué podría usar yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150310,
					"content": "Sin embargo, si alguna vez planeas ir a Fontaine, puedo presentarte a alguien que vende balizas de este tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				}
			]
		}
	]
}