	"talks": [
		{
			"id": 7211501,
			"completionStepIds": [
				7211502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211502",
							"2"
						],
						"stepId": 7211502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#¡Hola, mi querid{F#a}{M#o} {F#muchacha}{M#muchacho} galante! Tengo buenas y malas noticias sobre la Fragua Mikage. ¿Cuáles quieres escuchar primero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "La buena noticia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "La buena noticia es que el núcleo solo sufrió daños menores. Todavía está dentro de mis posibilidades repararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "La mala noticia, sin embargo, es que los Fatui que andan merodeando en su interior no parecen saber valorar la buena noticia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "Parece que están muy ansiosos por poner sus sucias manos en el núcleo de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "Pero si dejamos que sigan revoloteando a sus anchas, los poderes de los tatarigami pasarán a ser incontrolables. Esta isla entera volará por los aires con nosotros todavía en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "Sin embargo, si solo nos centramos en los Fatui, la energía de los tatarigami acumulada en el escudo acabará alcanzando su clímax...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "Entonces, ¿tenemos que ocuparnos de los dos al mismo tiempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Humm... básica, técnica y subjetivamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "... En efecto, tenemos ante nosotros un problema doble: los Fatui y los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "Pero tal y como está la situación dentro de la Fragua Mikage, es probable que nos topemos con el segundo problema mientras intentamos lidiar con el primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "Así que, en realidad, nuestra situación es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "O sea, “sí”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Humm, sí, eso es correcto. Tenemos que lidiar con ambos al mismo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "Pero vayamos paso a paso. En Liyue, hay un dicho que dice: “una persona apurada nunca se llega a comer el tofu caliente”. Significa que el que espera, desespera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "¿De verdad conoces proverbios de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Ya estuvimos en Liyue. Es una una pequeña joya de sabiduría que conservo como recuerdo del viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "Tengo muchos más recuerdos como ese. Debo confesar que bebí demasiados “recuerdos” de Mondstadt, aunque realmente estaban muy buenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Volvamos a lo importante. Tengo un pequeñísimo y sencillísimo plan para arreglar la situación de la Fragua Mikage, pero necesitaré tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "¡Ajá! ¡Una persona decidida y lista para luchar! ¡Eso es lo que me gusta de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "*Ejem*, volvamos al tema. Toma estas balizas sensoras, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "Necesito que coloques estas balizas en varios lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "Son capaces de recoger datos sobre la dispersión y la densidad de la energía de los tatarigami que hay dentro de la Fragua Mikage. Una vez que disponga de estos datos, podré elaborar un plan más detallado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "Bien, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "#Marcaré las ubicaciones de las balizas en tu mapa. ¡Cuento contigo, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "¿Cómo funcionan estas balizas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "La manera sencilla de explicarlo es que son instrumentos que utilizan el poder elemental para cuantificar y calcular todo tipo de energías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "Bueno, digo “sencilla”, pero en realidad no es tan fácil de explicar... ¡Supongo que podríamos partir de la teoría de los siete elementos! Es decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "No, no, no hace falta que la expliques.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Bueno, como quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "¿Qué gano yo con todo esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Humm... ¿qué tal los tesoros sin descubrir de esta isla y los materiales sobrantes del interior de la Fragua Mikage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "Verás, como la mayor fundición de Inazuma, la Fragua Mikage debe tener todavía... algunas cosas buenas que ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Por supuesto, como no poseo una Visión, no puedo entrar en la Fragua Mikage en este momento, y tampoco sabría realmente lo que está ocurriendo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "Escuchemos la mala noticia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "La mala noticia es que los Fatui siguen haciendo de las suyas dentro de la Fragua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "Parece que están muy ansiosos por poner sus sucias manos en el núcleo de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "La buena noticia es que el núcleo no sufrió mucho daño, así que puedo ocuparme yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Está claro que a los Fatui no les agradará la idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
