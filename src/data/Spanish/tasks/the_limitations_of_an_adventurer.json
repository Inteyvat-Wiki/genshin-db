					"content": "¿Encontraste los maniquíes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620402
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Todavía no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin está entrenando duramente. Esto es todo lo que puedo hacer por ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Si volviera a ser un aventurero, yo mismo iría por los maniquíes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Y a juzgar por la situación del Gremio de Aventureros de Mondstadt, la mayoría de mis viejos compañeros tampoco se atreverían a ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "No sé qué hacer. Los Caballeros de Favonius son fuertes, todos los jóvenes ahora quieren entrar a la Orden. En cuanto a los aventureros que están allá afuera partiéndose el lomo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "No muchos quieren hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
