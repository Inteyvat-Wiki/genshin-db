			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "¿Qué debo hacer?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Es que... mi hija Ellin quiere entrar a los Caballeros de Favonius, y se está preparando para el proceso de selección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "Es solo que... *Suspira*, yo quería guiarla por mí mismo, pero ella no se cree que fui un aventurero en mis viejos tiempos, e insiste en entrenar por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "No puedo demostrarlo... Y ahora que tengo esposa y una hija, no me atrevo a hacer algo tan imprudente como irme de aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "En lugar de satisfacer mis ansias de aventura y mi autoestima, lo más importante para mí es cuidar de mi familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Sin embargo, todavía soy un aventurero de corazón, y ciertamente todavía sé una o dos cosas al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Antes, cuando salía de aventuras, me fijé en los maniquíes que utilizan los Hilichurls para entrenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Esos maniquíes son de excelente calidad, y definitivamente son adecuados para el entrenamiento de Ellin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Ayúdame a encontrar algunos maniquíes de entrenamiento y tráelos de vuelta. De acuerdo a las reglas de los aventureros, no te haré trabajar de gratis. ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Me gusta la gente decidida, me recuerdas a mí cuando era joven y acababa de entrar al gremio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "¡Es broma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Son solo Hilichurls, no serán problema para ti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Pero yo no podría... Los aventureros tienen límites. Uno solo puede lidiar con una aventura a la vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Y cuando se trata de la aventura de una vida en matrimonio... No importa qué tan grande seas como aventurero, tienes que entregarte de lleno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Así que te pido que recolectes los maniquíes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006202,
