			"dialogs": [
				{
					"id": 200620301,
					"content": "¿Encontraste los maniquíes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Los encontré, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "¡Ja! ¡Debes tener brazos fuertes como para romper uno de estos maniquíes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Supongo que nadie aflojará sus golpes en combate a causa de unos palos de madera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "No se lo puedo dar a Ellin en estas condiciones, pero los materiales son suficientes, puedo arreglarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Después de mucho trabajo, quedó como nuevo. ¿Ves? Se ve... ¿bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "En fin, gracias. Esta es tu recompensa. Dije que no te dejaría ir sin pagarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "¡Puedes dejar de ser un aventurero, pero no puedes dejar de respetar el código!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
