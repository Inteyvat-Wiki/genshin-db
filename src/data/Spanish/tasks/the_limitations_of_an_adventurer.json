			"dialogs": [
				{
					"id": 200620601,
					"content": "Este maniquí es realmente bueno. ¡Ahora puedo entrenar más cómodamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620602,
					"content": "¿De dónde sacó mi padre un maniquí tan sólido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620603,
					"content": "¡No me digas que lo compró! No me imagino cuánto cuesta uno de estos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
