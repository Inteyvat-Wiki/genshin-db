			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "¿Encontraste los maniquíes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "¡Genial! ¡Jaja! Se ven de buena calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "Si este maniquí puede soportar la embestida de un Hilichurl, seguramente podrá soportar la embestida de Ellin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "Gracias. Por cierto, de acuerdo a las reglas de los aventureros, esta es tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
