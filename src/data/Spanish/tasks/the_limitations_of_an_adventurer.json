				"points": []
			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "¿Cuál será la mejor forma de entrenar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Oh, estoy entrenando para el reclutamiento de los Caballeros. Pero no tengo la menor idea de qué hacer, ni tengo a nadie que me guíe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Mi padre se la pasa diciendo que fue un aventurero, que podría entrenarme, pero no le creo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "¿Cómo podría entrenarme para entrar a la Orden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "También dijo que prepararía el equipo de entrenamiento... ¿Qué tiene en mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
