			"dialogs": [
				{
					"id": 200390401,
					"content": "Comencemos por hacer un poco de aceite esencial de impacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "Es un producto alquímico fundamental. El mejor lugar para comenzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Para hacer un aceite esencial de impacto, necesitarás un electrocristal y una rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Ambos se pueden encontrar fácilmente fuera de la ciudad. ¿Qué? ¿No puedes ver la relación entre el cristal y el aceite esencial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "¡Jajaja! ¡Es porque no la hay! El electrocristal es para el impacto. Es la rana la que proporciona el aceite esencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Una vez que hayas reunido todo, intenta crear un aceite esencial de impacto. No hay medias tintas ahora, ¡dale todo lo que tienes! Estaré observando desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "¡Entendido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
