					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390604,
					"content": "Deberías poder encontrarlos fácilmente fuera de la ciudad. ¿Y qué relación tiene una rana con el fuego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390605
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390605,
					"content": "Pues que las flores llameantes deben diluirse con la mucosidad que se encuentra en la piel de la rana antes de que sean seguras para su consumo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390606
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390606,
					"content": "Es decir... ¡Ah, no! ¡No dije nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390607
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390607,
					"content": "Una vez que hayas reunido todo, intenta crear un poco de aceite esencial de llamas ardientes. No hay medias tintas ahora, ¡dale todo lo que tienes! Estaré observando desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390608
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390608,
					"content": "¡Entendido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
