					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "Pues bien, ¡es hora de que adquieras experiencia de primera mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390106,
					"content": "Todos los grandes logros comienzan con una comprensión firme de los conceptos básicos.",
					"roleType": "TALK_ROLE_NPC",
