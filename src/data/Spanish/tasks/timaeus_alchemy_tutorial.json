					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390103,
					"content": "¿A ti también te gusta la alquimia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
