	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "¿Eh? Qué extraño, estaban en mi bolsillo hace un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Hola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "No servirá de nada sin ellas... Debemos dárselas a la Abuela Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "La abuela ya está muy mayor, ya no recuerda muchas cosas... Y recientemente no deja de hablar sobre sus años de juventud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Siempre dice “las flores esto...”, “las flores lo otro”... Que son flores de colores inusuales de más allá de la niebla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Pero entonces, un día tuve un sueño... Soñé que la niebla de la isla desaparecía. “Guau”, me dije a mí mismo, mientras al otro lado del mar surgía una casa gigantesca y hermosa, pero no era de madera ni oro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "¡Yo también lo soñé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "En ese sueño, subía una montaña muy alta y trepaba a un árbol enorme para recoger un montón de flores... Nunca las había visto en mi vida, pero estaba seguro de que eran las que la Abuela Una buscaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Pero las flores eran tan pesadas, que caí del árbol. Caía y caía sin parar... hasta que desperté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "¡Hum! ¡Eso es porque eres muy avaricioso! Te dije una y otra vez que era suficiente, pero al final incluso yo caí contigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "La bolsa está vacía... No hay absolutamente nada. ¿Cómo podemos volver con la Abuela Una con las manos vacías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
