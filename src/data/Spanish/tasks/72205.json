					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "¡Otra vez nos encontramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "¡Nos encontramos de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "¡Hola!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#Jeje, ¡no nos hemos ido a ningún lado! Cambiando de tema, {NICKNAME}, ¿sabes qué son esas rocas enormes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Jeje, ¡Kito lo sabe todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Ni idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Escuché al Abuelo Mata decir que se usan para guiar las almas de las tumbas... Esas almas que se extraviaron y permanecieron aquí son atraídas a estas rocas gigantes y despiertan de su sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Entonces, vagan por toda la isla en busca de alguien que pueda cumplir con su deseo. En cuanto encuentran a alguien, lo siguen por todos lados hasta cumplir su deseo... Entonces el barquero al fin puede llevarlas consigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Algunas almas son buenas y algunas, malas... ¡Así que, aquellos que deambulan en la niebla de noche deben revelar su nombre y clan en voz alta frente a la roca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Al fin y al cabo, los que saben quiénes son sus antepasados tienen mucha más confianza que los fantasmas solitarios. ¡Cuando sepan de dónde vienes, se apartarán en silencio y no te molestarán más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "#Es una pena que {NICKNAME} sea {F#una forastera}{M#un forastero} y no tenga un nombre de clan que anunciar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "#Ay... Si viene un alma malvada, ¿qué será de {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "Jeje, no importa. ¡No hay que temer, yo te protegeré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "¡Eso es! ¡Yo también asustaré a esas almas malévolas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "¿Para qué son?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "¿Siguen aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
			"id": 7220507,
			"completionStepIds": [
				7220514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
