			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "¿Es para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Esa caja era solo un juego, al igual que la nota. ¡No tienes que disculparte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "No es gran cosa. De todas formas no uso esta maceta, es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "También le pedí a alguien que consiga algunas semillas, debería llegar pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "¡Aquí están las semillas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "¿Eh? ¿Cuándo llegaste? No me di cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "*Ejem*... Ami, querías convertirte en florista, ¿verdad? ¿Por qué no empiezas plantando estas semillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Gracias... Pero si lo hago junto a la tienda de mi padre, los insectos podrían colarse en la olla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Sería una pena por los insectos que cayeran en la olla y por los adultos que tuvieran insectos en su comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Pero si pongo las flores en un lugar alejado, me temo que podría olvidarme de ellas. Eso también sería una pena porque se secarían...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Además, papá siempre está ocupado, y nunca me deja ir sola demasiado lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Humm... Podemos cuidarlas juntos si quieres. ¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Aunque solo puedo venir después del trabajo, tengo algo de tiempo libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "¡Genial! Pero puede que mi padre no esté de acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "El Sr. Jahangir y yo somos como amigos. Podemos ir juntos a hablar con él. No debería ser un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "¡Está bien! Entonces... ¡me gustaría tener más flores! ¡La rosa de Sumeru es mi favorita! ¡Algún día rodearé la tienda de mi padre con rosas de Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Bien, es un hermoso sueño. ¡Hagamos todo lo posible para cumplirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Guárdame una, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#Sí. Gracias, {F#señora}{M#señor}. Déjenme pensar... También quiero una flor dulce y... ¿qué más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "Veo que de verdad le gustan mucho las flores. Espero que pueda cumplir su sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Jeje, espero que no crezca como yo, un tipo común y aburrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "#*Ejem*, gracias por tu ayuda, viajer{F#a}{M#o}. Por favor, acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Si disfrutas la vida con todo tu corazón, entonces no eres una persona común.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Gracias. Tampoco es que me queje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "Es solo que... me sentí algo emotivo después de ver el sueño que había enterrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "#Bueno, ya debería irme. Gracias por tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Tal vez deba escribir otro sueño y enterrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Si disfrutas la vida con todo tu corazón, entonces no eres una persona aburrida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "¡Ánimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Toma, semillas de flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
