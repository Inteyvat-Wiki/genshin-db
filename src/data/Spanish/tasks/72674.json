				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740401,
					"content": "Con el poder de esta comida tanuki que preparé con mis propias manos, ustedes también podrán hablarle al pequeño tanuki. Vamos, prueben a mantener una conversación con Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740402
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740402,
					"content": "Vamos, probemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740403
					]
				},
				{
					"id": 726740403,
					"content": "Vayan, vayan. Yo tengo todo el tiempo del mundo para ir a cualquier lugar, pero para el pequeño tanuki es diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		}
	]
