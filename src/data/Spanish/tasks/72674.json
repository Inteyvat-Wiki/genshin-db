	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "¡Hola, Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "¡Rayos! ¡Me descubrieron! Ustedes... Este olor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "#Así que son ustedes. Hace tiempo que no {F#las}{M#los} veo y casi ni reconozco su olor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "Tú, en cambio, no has cambiado en absoluto, sigues asustándote al ver a la gente y atrapado en una roca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "¡¿Ah?! ¿Qué quieres decir con eso, jovencita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Ojalá tu sello se rompa pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "¡No es más que un sello humano! Solo tengo que ponerle un poco más de empeño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "*Ejem*.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#¡Hum! De todos modos, los niños han recibido muchos cuidados de tu parte. Los pequeños tanuki dicen que {F#una señora}{M#un señor} de pelo rubio que huele bien juega mucho con ellos y es muy divertid{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#“{F#Una señora}{M#Un señor} de pelo rubio...”",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "Pensaba que todos los humanos eran tan malos y temibles como el que selló a los tanuki. Parece que, después de todo, hay gente buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "La mayoría es gente buena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#Sí, la mayoría de la gente que Paimon ha conocido con {NICKNAME} ha sido buena. ¿A ti no te sellaron por robar un peine...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "¡Hum! ¡Y lo he devuelto! Así que si alguna vez te encuentras con ese tipo que aprendió magia de Reizenbou, ¡dile que me saque de esta piedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "He estado sentado aquí durante mucho tiempo y todo es culpa de esa escurridiza kitsune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi de verdad se queja como un anciano.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Bueno, lo cierto es que tiene muchos años.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Pues bien, ni sus manos ni sus piernas son de piedra, así que seguro que han estado en muchos sitios, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "#Jeje, ¡Paimon y {NICKNAME} viajaron desde el otro lado del mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "Le cuentan a Ioroi sus aventuras en Mondstadt y en Liyue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "... Así que hay tantos lugares en el extranjero. ¡Impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "Durante todo este tiempo, mi única información ha sido la que me cuentan los pequeños tanuki, por eso no sé cómo es el mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Una vez estuve en la cima de la Montaña Yougou y vi una montaña muy, muy alta al otro lado del océano. Posiblemente era incluso más alta que la Montaña Yougou. Aún hoy me pregunto qué lugar era ese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "¿Al otro lado del océano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "¡Por la dirección, Paimon cree que debería ser Espinadragón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Humm, Espinadragón... Solo con oírlo siento escalofríos en la barriga. No sé cómo ese tipo quiere ir a ese lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "*Ejem*. Como dije antes, ustedes son buena gente, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Paimon ya reconoce a leguas ese tono de pedir un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "¡Hum! Incluso así, sigo siendo el Protector Oculto de la Arboleda, y el defensor del Bosque Chinju, ¡nombrado por Su Excelencia misma! Si no estuviera sellado en piedra, ciertamente usaría ocho enormes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "De acuerdo, entonces, ¿en qué necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Yo no puedo moverme con mi propia fuerza, pero los pequeños pueden hacerlo. Por eso, me gustaría pedirles que lleven a un pequeño tanuki para que se entrene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "#Llévense a Kichiboushi. Ha tenido muchas ganas de verl{F#as}{M#os} desde la última vez que jugaron juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Podemos hacer eso, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Es cierto. No podemos entendernos con Kichiboushi, así que ¿no sería un poco difícil viajar juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Imposible. Nosotros los tanuki entendemos el lenguaje humano por naturaleza. Son ustedes, los humanos, los que no hablan nuestro lenguaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "¡¿Qué?! ¿En serio es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "Pero, como compañeros de viaje...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Nos gustaría charlar mientras viajamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#¡Como hacen Paimon y {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Humm, bien. Ahora que lo considero, ¿no usó alguien una vez nuestra magia para hacerles algo de comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Puede que tenga este aspecto, pero hacerles una comida que les permita entender lo que dice Kichiboushi no es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "¡Qué bien! ¡Comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "No significa que vaya a saber bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "¡No subestimes mi destreza culinaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Aunque no saben de dónde sacó todo Ioroi... \\n Paimon y tú se dan un festín que “parece muy delicioso” sobre su panza de piedra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "¡Toda una delicia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Por supuesto. Soy Ioroi, ¡el mismo que una vez hizo surtidos de sashimi con bolas de barro y pelo de tanuki para engañar completamente a los Cuatro Oni de Ogata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "¡Eso es impresionante, Ioroi! Pero ¿de qué hiciste la comida que acabamos de comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Algunas preguntas es mejor dejarlas sin respuesta, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "¿?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Bueno, olvídalo. ¡Busquemos a Kichiboushi para charlar con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "Hay un problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#¡Oh, Paimon sabe lo que quieres decir, {NICKNAME}! ¿Habrá un tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "¿Tesoro? ¡Por supuesto! Después de todo, soy el jefe de quinientos cinco tanuki. Ni uno solo de los tesoros de Inazuma se me ha escapado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "En ese caso, ¿para qué necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "#Sí, ¡somos superbuen{F#as}{M#os} ayudando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "Por la dirección, debe ser Espinadragón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "¿“Que huele bien...”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#No soy {F#ninguna señora}{M#ningún señor}, no me veo tan viej{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Lo que Paimon quería decir es que esperaba que tu sello se rompiera pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "¡Cuánto tiempo sin verte, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740202,
					"content": "¡Oh! Pelo blanco y pelo rubio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740203,
					"content": "Con “pelo rubio” se debe referir a mí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "¡Ey! ¡¿A quién llamas pelo blanco?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Muy fuerte. Puedo entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740206,
					"content": "#Yo soy {NICKNAME} y ella es Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "¡Más te vale recordarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Chas, chas, calavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740209,
					"content": "Ehm... ¿Calavanda? ¿Y qué quieres decir con “chas, chas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "En cualquier caso, al menos nos podemos comunicar más o menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "Más menos que más, pero sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#Como sea, {NICKNAME}, volvamos a ver a Ioroi. Estamos llevando a Kichiboushi a un largo viaje, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "¡Ioroi! ¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740214,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "¡Hum! ¿Qué tal fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "¡Hum! Feliz de ver pelo blanco y pelo rubio. Calavanda buum buum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740303,
					"content": "Calavanda buum buum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "¿Eh? Estás muy animado, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "¡Buuum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740306,
					"content": "Bueno, ¿qué significa “calavanda buum buum”...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Buumm significa buumm, y calavanda significa calavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740308,
					"content": "Pues parece que ya no tienen problemas para comunicarse. Mis habilidades culinarias siguen siendo tan buenas como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "Supongo que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "¡No! ¡Sí tenemos problemas! ¡No se entiende nada de lo que dice Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Resulta que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "Le cuentas a Ioroi cómo van los intentos de comunicación.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "#Humm... Ya veo. No se preocupen. Eso pasa porque no están acostumbrad{F#as}{M#os} a Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "¡Tómense su tiempo! Cuanto más se acostumbren a su olor, más podrán entender lo que dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "¿Cuánto tiempo nos llevará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Humm... Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "Ehm... Solo tengan paciencia, no hay prisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Ser impaciente no bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740320,
					"content": "Tú tampoco lo sabes, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "¡Hum! Debes saber que yo soy Ioroi, el Rey de los Tanuki. He vivido muchos años, no le doy tanta importancia al tiempo como ustedes los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Aunque la mayor parte de su vida la ha pasado sellado en una estatua de piedra.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Entonces, ¿cómo puedes hablar con los humanos sin problema, Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "¡Hum! ¡Qué impertinente! Más bien, ustedes deberían preguntarse por qué los humanos pueden hablar con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Alguien como yo, que ha vivido tanto tiempo y se ha vuelto tan poderoso, ha podido interactuar un poco con los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "Hace mucho, mucho tiempo, solía hablar con tengu, kitsune, oni, youkai y humanos por igual. Y aunque las historias de los humanos a menudo se refieren a ellos mismos, al menos la mitad de ellas son sobre tanuki que se transformaron en humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "La mitad de la mitad son historias sobre humanos, y la otra mitad son sobre todos los demás youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "Pero incluso una parte de esta mitad es sobre nosotros, los tanuki, que nos transformamos en ellos. Y la mitad de las historias de los tanuki son sobre mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Hum. Como ven, soy el más grande de todos, por eso hablar con ustedes los jóvenes no es un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "Ya entiendo, cinco dieciseisavos son de Ioroi, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "¿Eh? ¿Dieciseisavos? ¿Con qué se come eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Suena delicioso. Yo probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME} se refiere al porcentaje de historias que son sobre ti, Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi. ¡Grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740335,
					"content": "Hum. No hace falta decirlo. Tienes mucho que aprender de mi grandeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "¿Eh? Ahora que Paimon lo piensa, parece que estamos comenzando a entender lo que dice Kichiboushi, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "Pelo blanco inteligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740338,
					"content": "Vaya, puede que sea un cumplido, pero no se siente bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Muy bien. Entonces, dejo a este pequeño en sus manos. Llévenlo a entrenar por el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Cuando era un joven tanuki, una vez viajé a dieciocho lugares de Inazuma siguiendo los pasos de Tsukumo, el grande, sin apartarme ni una sola vez del camino. Solo así logré alcanzar mi grandeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "¿Eh? ¿Por eso te sellaron en una piedra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Jajaja, ¡piedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740343,
					"content": "¿Eh? ¿Tú también, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "Bueno, de vuelta al tema. ¿A dónde vamos primero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "Ese lugar que Ioroi mencionó hace un momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "¡Oh, sí! Entonces, ¡vamos a Espinadragón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740348,
					"content": "“Si hay una montaña, ¡habrá que subirla!”. ¡Paimon ha estado esperando la oportunidad para decir algo tan genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740349,
					"content": "¡Montaña, allí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740350,
					"content": "Ay, qué frío suena... No dejes que tu panza se enfríe, Kichiboushi. Si no, te vas a resfriar y, si lo haces, no podrás actuar tocando tu barriga como tambor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740351,
					"content": "#Además, recuerda comer adecuadamente y seguir {F#a la señora}{M#al señor} pelo rubio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740352,
					"content": "#¡Entendido! Seguir {F#a la señora}{M#al señor} pelo rubio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740353,
					"content": "#Nosotr{F#as}{M#os} cuidaremos bien de Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "¡Ten mucho cuidado, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740357,
					"content": "Hum. ¡No preocupar! ¡Kichiboushi cuidar a ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 726740358,
					"content": "Humm... Parece que no nos estamos entendiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740354,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740355,
					"content": "#¡No me digas {F#señora}{M#señor}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740347,
					"content": "¿Qué te parece Espinadragón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740348
					]
				},
				{
					"id": 726740311,
					"content": "¡Sí tenemos problemas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740312
					]
				}
			]
		},
		{
			"id": 7267404,
