						700890103
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890103,
					"content": "Oye, ¿qué estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Estoy buscando el camino de vuelta. Solo recuerdo que tengo que encontrar la estatua del Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890105,
					"content": "No recuerdo nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890106,
					"content": "¿El camino de vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Es una vaga sensación de nostalgia... pero no recuerdo nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890108,
					"content": "Cuando desperté, lo único que tenía era una nota en la mano que decía: “Eres Maukie”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890109,
					"content": "Así que supongo que me llamo Maukie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890110,
					"content": "Tengo que irme. Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "Maukie"
				},
				{
					"id": 700890111,
					"content": "Qué persona más rara. Aunque no parece mal tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "He tenido una visión extraña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "¿Una visión extraña? ¿Será porque esa persona de antes tocó la estatua?",
