			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "¿Hiciste tu ofrenda? ¿Qué te pareció?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "No estuvo mal la experiencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Excelente. Espero que el templo siempre esté lleno de incienso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Me quedaré aquí un rato. Es un lugar tranquilo, perfecto para trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Necesito ordenar la información que tengo y continuar recopilando material para el libro sobre el Guardián Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Cuando tengas tiempo, puedes venir al templo a ver cómo va todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Si quieres ofrecer incienso, puedes venir a buscarme y te daré unos cuantos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "*Suspira*, la verdad es que me gustaría reparar los alrededores también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "Debería volver a pavimentarse este camino, con vallas en cada lado y deberíamos tener un parterre cerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
