			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "El templo se ve bastante bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "Sí, realmente bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "¿Eh? Llegas justo a tiempo. La reparación ha culminado, acabo de pagarle a los artesanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "No esperaba que fuera tan caro, todo el dinero que gané con tanto esfuerzo se ha ido en esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "Pero, en fin, el templo ya está como nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "¿Te gustaría ofrecer incienso? He mandado a hacer un nuevo incensario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Toma estas varitas de incienso. El incensario está por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "¿Tú ya ofreciste incienso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Desde luego. Fui el primero en hacerlo en cuanto se terminó la reparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183105,
