				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Oh, se fue... Bueno, después de todo no recuerda nuestras aventuras juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570102,
					"content": "No te desanimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "Sí, tienes razón. ¡Oh, por cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570105,
					"content": "¡La última vez Aranakin nos enseñó una canción! ¡Si la tocamos, tal vez recuerde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570106,
					"content": "Tienes razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Jeje, ¡claro! ¡Porque Paimon lo dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570108,
					"content": "Por fin una idea útil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "#¡Qué mal{F#a}{M#o} eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570103,
					"content": "Seguro podremos ser amigos de nuevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Jaja, ¡aquí está! ¡Hola, pequeñín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570202,
					"content": "¡Aranakin no es pequeño! ¡Tú sí que eres, cosita blanca voladora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570203,
					"content": "#Volviendo a tema, nara rubi{F#a}{M#o}, ¿cómo conocen esta canción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570204,
					"content": "Pues porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570205,
					"content": "Tú nos la enseñaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "¡Así es! ¡Nos la enseñaste en nuestra última aventura juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570209,
					"content": "Ya veo. Humm, Aranakin no es muy listo, pero ustedes no parecen arena para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570210,
					"content": "#¡Exacto! Valuka es arena, es mal nara. ¡Pero nosotr{F#as}{M#os} somos buen{F#as}{M#os} nara! ¡Nos lo has dicho antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570211,
					"content": "¡¿Eh?! ¿Yo he dicho eso antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570212,
					"content": "#Jaja, ¡sí! {NICKNAME}, ¡hay que contarle la historia otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570213,
					"content": "Le cuentan a Aranakin las aventuras que vivieron juntos y le explican cómo neutralizaron la zona marchita.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "... Conque así fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570215,
					"content": "Aranakin no es muy listo, pero suena a que es verdad. Aranakin no recuerda, disculpen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570216,
					"content": "¡No es necesario disculparse! Es normal olvidarse de las cosas. Además, aún podemos volver a ser amigos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570217,
					"content": "Aranakin es un buen chico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Hummm... Ya que somos buenos amigos, ¡vengan con Aranakin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570221,
					"content": "¿Eh? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570222,
					"content": "#Nara {F#rubia}{M#rubio}, cosita blanca voladora, ¡Aranakin invita a su hogar! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570218,
					"content": "Paimon es una buena chica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Jeje, ¡por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570207,
					"content": "Tocamos esta canción para verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Jeje, ¿qué te pareció la interpretación de {NICKNAME}? ¡Todavía recordamos la melodía tal y como nos la enseñaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
