				"points": []
			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Esa cosa nara... Humm, ¿cómo se llama? Aranakin no necesita para dormir, así que no sabe nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "Se llama cama, y parece nueva. ¿Habrá dormido alguien aquí antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Jeje, Aranakin es muy ordenado. ¡Si quieren, pueden dormir ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
