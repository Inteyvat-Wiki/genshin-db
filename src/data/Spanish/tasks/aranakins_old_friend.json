			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "¿Qué recuerdos hay ahí? ¿Qué leyeron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "Parece que los dueños del cuaderno te conocen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Ya veo... No recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "Dicen que tampoco pueden verte... Tal vez sea porque crecieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Bueno, crecer es un verdadero problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Sí. También dicen... ¡que esta flor es para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Toma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "¿Eh? ¡Oh! ¡Esta es flor importante! ¿Cómo es que tú...? ¿Cómo es que él tiene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "De hecho, tú no lo recuerdas pero... nos diste una flor igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Entonces, Aranakin volver a ser amigo de ustedes. Pero ellos... Aranakin no recuerda rostro de ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "T-tranquilo... No te pongas triste. Recuerda que tienes esta flor, seguro que te ayudará a recordar, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Sí, cosa blanca voladora tiene razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "Aranakin guardará flor, seguro que Moutiyima sabrá cómo despertar flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#*Suspira*... Nara {NICKNAME} y cosa blanca voladora, Aranakin volverá con Aranaga para plantar flor y escuchar canciones. Si quieren venir, ¡son bienvenid{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "¡Claro que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
