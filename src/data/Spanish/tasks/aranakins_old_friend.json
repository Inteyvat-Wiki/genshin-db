				{
					"id": 730570401,
					"content": "Es instrumento nara, Aranakin cuida. Pero parece que ya no se puede tocar... Cuerdas no afinadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570402,
					"content": "(Es un laúd antiguo que está algo roto y tiene varias marcas, pero parece que ha sido reparado y conservado con mucho cuidado.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
