			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "“... El laúd que se le cayó al Sr. Bakr ya está reparado, así que deja de lloriquear, ¿de acuerdo? Si estás triste, habla conmigo o con Jayam”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570902,
					"content": "“¡He sido aceptada en la Academia de Sumeru! ¡Felicidades a mí misma! Nunca quise acabar siendo ‘la esposa de un guerrero’. ¡Voy a ser Siman, la gran sabia!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570903,
					"content": "“Jeje. ¡Gran músico Irfan, sabio Jayam! ¡No se olviden de mí cuando nos separemos! ¡Sobre todo tú, Jayam! ¡No puedes olvidarte de mí!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570904,
					"content": "“¡Adiós, cuaderno! ¡Adiós, Irfan y Siman, mis mejores amigos! Que el bosque nunca olvide nuestra historia, y que nosotros siempre nos recordemos los unos a los otros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570905,
					"content": "(El resto del contenido del cuaderno está escrito de forma caótica y confusa, repleto de los recuerdos alegres y tristes de unos muchachos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570906,
					"content": "“Aranakin ha desaparecido. No sabemos cuándo, pero no lo vemos por ninguna parte. Ya es hora de que yo también me despida del laúd y me convierta en un artesano, tal como quería mi padre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570907,
					"content": "(Parece que pone algo más, pero está cubierto con una tinta negra.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570908,
					"content": "“A mi yo que lea este cuaderno dentro de unos cuantos años: si ocurre un milagro y vuelves a encontrarme con Aranakin y los demás, por favor, dales esta flor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Cuaderno antiguo"
				},
				{
					"id": 730570909,
					"content": "¿Eh? ¡Parece que algo cayó del cuaderno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "¿Una flor? Es parecida a la que tenemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
