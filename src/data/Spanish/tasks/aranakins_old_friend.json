				{
					"id": 730570602,
					"content": "Son hojas que nara usaban para escribir recuerdos. Escribían y juntaban. Pero Aranakin no entiende letras nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "¿Te refieres a un cuaderno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "¿Un cuaderno? ¿Ahí escribían sus recuerdos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Sí, así es. ¿Te importa si subimos juntos a leer qué dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "¿A Aranakin? ¡No importa nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
