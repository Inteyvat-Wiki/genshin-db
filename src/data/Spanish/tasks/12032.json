			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "A Inazuma aún le esperan más retos, pero estoy preparada para ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320102,
					"content": "¿Qué desafíos prevés para Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "La abolición del Decreto de cierre de fronteras tiene un sinfín de implicaciones. Sería una locura decir que todo será positivo y que no habrá repercusiones negativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320104,
					"content": "Por ejemplo, preveo que el mundo exterior podrá suponer una amenaza para los negocios de Inazuma. Estos son los problemas por los que debo trabajar para resolverlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320105,
					"content": "Ei, estás pensando en esto muy concienzudamente. Yo solo he llegado a preguntarme si podré vender entradas al Gran Santuario Narukami en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "En serio, Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320107,
					"content": "Sobre la mirada de los dioses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "La mirada de Makoto siempre estuvo fija sobre la gente de Inazuma. Siempre pensé que era... su deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320109,
					"content": "Pero ahora veo que su mirada estaba llena de admiración y esperanza. No era solo un deber, sino también una alegría. Ella amaba profundamente a la humanidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320110,
					"content": "Si la gente del pasado merecía la atención de los dioses, entonces también la merece la gente del presente y del futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Sí, es cierto. Ya no voy a ignorar sus pasiones y sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320112,
					"content": "¿Cómo fue el duelo que duró siglos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Fue, francamente, un calvario sin final a la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320114,
					"content": "Frente a una batalla interminable, tenía que permanecer concentrada en todo momento. Si hubiera perdido la concentración por un segundo, la espada de la Shogun me habría quitado la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320115,
					"content": "Cabe decir que, si no fuera por mis experiencias previas en combate, mis habilidades no habrían estado a la altura del desafío. Seguramente habría sido derrotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320116,
					"content": "Tú también tuviste parte en eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320117,
					"content": "¿Qué hay de los daños causados al Cerezo Sagrado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "No te preocupes, no lo he olvidado, daré instrucciones a la Comisión Tenryou y a la Comisión Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320119,
					"content": "No solo me preocupan los monstruos, me preocupa también lo que pueda escapar del Cerezo Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320120,
					"content": "Es difícil de saber... Las líneas ley conservan más cosas además de recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Ya que sabes de qué se trata esto, quizás podrías pensar en hacer un esfuerzo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320122,
					"content": "Yae Miko dijo que me confiaba a su dio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "#*Ejem*, Yae Miko no dijo nada de eso. Viajer{F#a}{M#o}, ¿osas afirmar tal cosa sobre mí mientras estoy presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Hay cosas que no se deben decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "#Créeme, no quieres saber el precio de traicionarme. Lo que hablamos debe quedarse entre nosotr{F#as}{M#os}. ¿Entendiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "¿De qué hablan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320127,
					"content": "Nada. Oh, de repente me apetece tofu frito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}