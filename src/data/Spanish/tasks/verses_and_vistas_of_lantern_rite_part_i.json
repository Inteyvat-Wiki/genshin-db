					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "¿Y bien? ¿Conseguiste el néctar de Megaflora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Aquí lo tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Veamos... Sí, es este. Bien, bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Cuando prepare el pigmento, encontraré un buen paisaje y me pondré manos a la obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "¡Hum! Espera a que ese poeta vea mi cuadro, ¡sabrá lo que es bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "¡Ah, casi lo olvido! Para el Rito de la Linterna hay que liberar linternas celestes con deseos escritos en ellas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Jeje, afortunadamente tenía en reserva una linterna celeste. En cuanto al deseo... no te lo puedo contar o, si no, no se cumplirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Ah, casi lo olvido... Toma esto. Es tu recompensa por ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350709,
					"content": "Este cuadro le enseñará quién es el mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
