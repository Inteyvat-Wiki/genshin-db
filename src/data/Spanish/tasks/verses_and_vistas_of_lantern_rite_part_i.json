			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "No, así tampoco servirá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Ah, hola. Estaba buscando inspiración por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Estamos en el Rito de la Linterna, ¿no? Estaba pensando en cómo plasmar en un cuadro el Puerto de Liyue y el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "*Suspira*, pero por alguna razón, siento que mi técnica no es la correcta. Ningún cuadro termina de convencerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Estaba pensando que tal vez cambiar de paisaje me ayudaría a tener un poco de inspiración, pero no encuentro uno que me convenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "#Viajer{F#a}{M#o}, ¿conoces algún paisaje más adecuado para pintar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "¡Busquemos en los alrededores!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Humm... Está bien. Busquemos por aquí, quizás encontremos un lugar con unas buenas vistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Este lugar no tiene malas vistas. Oh, ¿tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "El nombre de este servidor es Chingzhou. Me atrevo a decir que soy un poeta. ¿Y tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350303,
					"content": "Oh, ¿un poeta? Yo soy un pintor. Vine aquí a buscar un poco de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "¿Inspiración? Vaya, qué encuentro tan fortuito, yo también vine en busca de mi musa. Si me permite la pregunta, ¿a qué se debe su búsqueda de inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350305,
					"content": "#Eh... Quiero pintar un cuadro que represente a Liyue y al Rito de la Linterna. Estaba buscando el sitio perfecto con est{F#a}{M#e} viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "Por cierto, ¿tú para qué buscas inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Eh... Es una gran coincidencia. Yo también estoy cavilando sobre cómo plasmar ambas cosas en un poema, así que vine a este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350308,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350310,
					"content": "Un poema... es demasiado simplón. ¿Cómo puedes describir a Liyue y al Rito de la Linterna en unos cuantos versos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Jaja, si me lo preguntas, solo un gran cuadro podría capturar la esencia del festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "¿Un cuadro? Sería un desperdicio de tinta. Es más, solo escondería la esencia del Rito de la Linterna, y despojaría a Liyue de su espíritu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350313,
					"content": "Además, ¿cómo podría una ciudad tan majestuosa como Liyue caber en un cuadro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350314,
					"content": "Jaja, yo digo que un cuadro es mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Y yo digo que un poema es mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350316,
					"content": "Vamos a calmarnos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Discutir no resolverá nada. Propongo que cada uno produzca una obra en su disciplina de preferencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Cuando terminemos, pondremos ambas obras lado a lado y dejaremos que el público decida cuál es mejor. ¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "¡Acepto el duelo! Cuando termines tu cuadro, ven a verme a la Posada Wangshu. Ahí buscaremos un jurado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350320,
					"content": "¡Bien! ¡Tenemos un trato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "Tenemos un trato. Ahora, si me disculpan, me retiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 413350322,
					"content": "Ese poeta es un fanfarrón. ¿Piensa que con unas cuantas palabras puede resumir la grandeza de Liyue y el Rito de la Linterna? ¡Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "¡Hum! En cuanto termine mi pintura, ¡a ese poeta no le quedará más opción que reconocer su derrota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "Debo poner toda mi creatividad en esta obra... y preparar los mejores utensilios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a buscar algunos materiales especiales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Perfecto, déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Humm... ¿Puedes recolectar el néctar de una Megaflora Pyro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "Con él, seguramente podré hacer un buen pigmento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "¿Qué tipo de materiales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
