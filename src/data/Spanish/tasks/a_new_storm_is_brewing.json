			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "*Suspira*, ¿cómo voy a llegar?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Oh, hola... ¿qué ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "Estoy tratando de llegar a la torre de vigilancia del Punto Portatormentas para ver si una tormenta se está gestando en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "Pero más adelante hay un grupo de monstruos bloqueando el camino y no sé cómo pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "No te preocupes, ¡no voy a pedirte que vayas a la torre de vigilancia por mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "Es mi deber, y debo cumplir con él sea como sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "Probablemente tengas cosas que hacer. No te preocupes por mí, encontraré la manera de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004002,
			"completionStepIds": [
				2004003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
