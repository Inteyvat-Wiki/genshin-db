				"points": []
			},
			"dialogs": [
				{
					"id": 200400501,
					"content": "Habla como si lo tuviera todo resuelto, pero hay tantos monstruos allá adelante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400502,
					"content": "Vamos, despejemos el área para la Sra. Vind, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400503,
					"content": "Mírala... Está pensando seriamente en correr como alma que lleva el diablo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400504,
					"content": "Ayudémosla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "Las personas de tan buen carácter merecen un poco de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400505,
					"content": "¿Crees que se atreverá a ir a la torre ella sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Eso sería lo peor que podría pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400508,
					"content": "No lo permitamos. Vamos, ¡a deshacernos de estos monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
