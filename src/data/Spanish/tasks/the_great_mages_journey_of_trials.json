			"dialogs": [
				{
					"id": 100100801,
					"content": "Por fin conseguimos ahuyentarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100802,
					"content": "La nota sugería que las cosas no serían tan simples. Paimon supone que se refería a esos monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100803,
					"content": "Pero eso significa que... ¡superamos la prueba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100804,
					"content": "¡Jeje, sí! Ahora, veamos qué hay en el cofre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100805,
					"content": "Oh, esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100806
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100806,
					"content": "¿Un sombrero pequeño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "¡Un sombrero para Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "En el Clan Dodo, ¡solo los Dodocos más increíbles y brillantes pueden ganarse el reconocimiento del Rey Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Su trabajo es ayudar y proteger a los demás Dodocos, por eso el Rey Dodo les entrega un sombrero especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "Así, los otros Dodocos los reconocerán y sabrán a quién acudir cuando necesiten ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "¡Oh! ¡Así que ahora tu Dodoco es uno de esos Dodocos especiales con sombrero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "¡Exacto! ¡El sombrero convierte a Dodoco en Dodohechicero! ¡Ahora puede usar magia de chispas para ayudar a más gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100813,
					"content": "Klee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "Los Caballeros de Favonius me han comunicado que hubo explosiones muy fuertes en el bosque a las afueras de la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, Paimon... Necesito un poco de ayuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ah, eso es porque eliminamos un campamento de Hilichurls y unos cuantos Slimes. Además, estábamos trabajando en la tarea de Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "¡Eso es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "¿Y qué hay de los peces del lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "Bueno... puede que los haya hecho volar también. ¡Pero solo porque había monstruos en el lago! ¡No lo hice a propósito! No es como las otras veces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Ya veo. ¿Entonces las otras veces fueron a propósito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "No tengo nada que decir sobre las otras veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*Suspira*, vi el campamento destruido de camino y también a los monstruos que huían despavoridos por la orilla del Lago Estelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100823,
					"content": "#¿Ha sido ese todo el daño causado, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100824,
					"content": "Lo demás ha sido cosa de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "... Claro, ya conoces a Paimon, ¡es capaz de acabar con los monstruos de un puñetazo! Es supergenial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100827,
					"content": "Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100828,
					"content": "Ven conmigo, regresemos a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100829,
					"content": "Oh... ¿otra vez al cuarto de confinamiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100830,
					"content": "#Bueno, ya que {NICKNAME} ha respondido por ti, supongo que tu castigo tendrá que ser... ¡una comilona en El Buen Cazador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100831,
					"content": "Después de tanto ajetreo, debes tener hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100832,
					"content": "¡Qué buena eres, Maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100833,
					"content": "¡Vengan ustedes dos también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Jeje, ¡a Paimon le apetece mucho un buen pollo asado con miel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100835,
					"content": "#Jean l{F#a}{M#o}s invita a comer a l{F#a}{M#o}s tres en El Buen Cazador...\\nAh, también viene el nuevo “Dodohechicero”, claro.\\nAsí, logran ponerle fin a la prueba.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 100100826,
					"content": "Eso es todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100827
					]
				}
