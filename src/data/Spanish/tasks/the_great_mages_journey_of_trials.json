			"dialogs": [
				{
					"id": 100100101,
					"content": "Humm... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100102,
					"content": "¡Hola, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100103,
					"content": "#¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¡Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100104,
					"content": "¡Dodoco necesita ayuda! Mi mamá me dijo que vendrían, ¡pero no imaginé que sería tan pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100105,
					"content": "¿Dodoco necesita ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100106,
					"content": "¿Eh? ¿Acaso esta es la tarea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100107,
					"content": "No lo sé... Pero soy Klee, no una tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100108,
					"content": "Ya, Paimon lo sabe bien. Paimon preguntaba por la tarea. Sabes lo que es, ¿verdad? Es como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100109,
					"content": "Una tarea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100111,
					"content": "*Suspira*, gracias por esa explicación inútil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100112,
					"content": "En fin, eh... Una tarea es... Arg, ¿por qué cuesta tanto explicarlo? Es como... ¡ayudar a Dodoco! ¡Sí, esa es una tarea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100119,
					"content": "¡Oh! Gracias, Paimon. Eso tiene un poco más de sentido, aunque no del todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100120,
					"content": "¡Bueno, vamos a ayudar a Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100121,
					"content": "Espera. ¿Qué tipo de ayuda necesita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100122,
					"content": "Ah, claro. Bueno, todo Dodoco debe encontrar un trébol de cuatro hojas rojo para convertirse en un Dodoco superespecial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100123,
					"content": "Después, Dodoco necesita hacer muchos amigos para superar la prueba del Rey Dodo. Después de eso, podrá convertirse en un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100124,
					"content": "¡Dodohechicero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100125,
					"content": "Al menos eso fue lo que dijo mi mamá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100126,
					"content": "Vaya, un Rey Dodo a cargo de un Dodohechicero... En realidad, tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100127,
					"content": "Bueno, ¿qué tenemos que hacer exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100128,
					"content": "Yo tampoco lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100129,
					"content": "Pero mi mamá dijo que ustedes dos me lo contarían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100130,
					"content": "S-sí... Miremos este libro, Klee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100131,
					"content": "Oh, hay una nota dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100132,
					"content": "A ver qué dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100133,
					"content": "“En la primera etapa de la prueba, Dodoco llegó a un bosque de hojas susurrantes. Allí, tras múltiples obstáculos, yacía enterrado un secreto, esperando a ser descubierto...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100134,
					"content": "Parece ser parte de una historia sobre Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100135,
					"content": "¡Oh, ya sé dónde está! Es el bosque donde voy a explo... digo, ¡donde voy a jugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100136,
					"content": "¡Vamos, síganme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100137,
					"content": "¡Muy bien, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100113,
					"content": "Es algo que debe hacerse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "¡Sí, algo que hay que hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100115,
					"content": "Oh, entonces... ¿También es una tarea cuando uso Bombas saltarinas para hacer pesca explosiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100116,
					"content": "No eso no cuenta. No todas las cosas pueden considerarse una tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100117,
					"content": "Estoy confundida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100118,
					"content": "*Suspira*, es como... ¡cuando tu mamá te dice que hagas algo! ¡Eso es una tarea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
