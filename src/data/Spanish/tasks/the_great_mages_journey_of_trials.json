						100100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100603,
					"content": "Klee, ¿quieres hacer los honores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100604
					]
				},
				{
					"id": 100100604,
					"content": "¡Sí, Dodoco y yo nos encargaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100605
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100605,
					"content": "Un momento... ¡Se aproximan monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100606,
					"content": "Parece que no será tan sencillo después de todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100607
					]
				},
				{
					"id": 100100607,
					"content": "Hum, ¡está claro, quieren robar el tesoro de Dodoco!",
