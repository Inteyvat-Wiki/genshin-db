			},
			"dialogs": [
				{
					"id": 100100301,
					"content": "¿Por qué hay tantas cosas raras aquí? ¿Y tantísimos Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100302,
					"content": "¿Eh? ¿Será que los Hilichurls trajeron todo esto aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100303,
					"content": "Oh, ¡entonces aquí es donde encontraremos los espectáculos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Aunque suene parecido, lo que dijo fue “obstáculos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "Sea lo que sea que estamos buscando supuestamente está enterrado tras “múltiples obstáculos”... ¿Habrá más pistas por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "¿No hay ninguna Dodoguía que pueda ayudarnos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100307,
					"content": "Eh... No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "¿Entonces qué vamos a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Humm... Mi mamá dice que cuando te encuentras con un problema, ¡lo que hay que hacer es resolverlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100310,
					"content": "Entonces encarguémonos de esos obstáculos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
