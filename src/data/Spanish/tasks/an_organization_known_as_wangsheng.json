				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "#Viajer{F#a}{M#o}, después de atestiguar una ciudad sin Arconte, ¿qué se siente visitar una ciudad con uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Me gusta más el ambiente de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "#Ya veo... con que eres ese tipo de viajer{F#a}{M#o}... No está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "Tal vez sea porque no has experimentado por completo los 3700 años de historia de las tierras del Arconte Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "La preparación del Rito del Ascenso también será una experiencia enriquecedora en tu travesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "De entre las Siete Naciones, Liyue es la más próspera, defendida por los dioses y gobernada por las Siete Estrellas, así que las maniobras diplomáticas de los Fatui no han rendido frutos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ninguang, de las Siete Estrellas, siempre ha estado alerta de ellos. Quizás por eso Nobile quiere usar las conexiones de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Pero... ¿qué beneficio obtiene Nobile si ayudamos en la preparación del Rito del Ascenso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "No lo sé, ni me interesa. Para mí, los Fatui solamente son un apoyo financiero. Lo único que deseo es que las tradiciones de Liyue no caigan en el olvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli le da al jugador un bolso con monedas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "Este es un adelanto de parte de Nobile. Si lo gastas todo, puedes acudir a él para más fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Bien, en marcha. El primer paso de las exequias es... obtener <color=#00E1FFFF>jade noctilucoso</color> de la más alta calidad, digno de una divinidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Creo que me gusta más Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "No es de extrañar. Las tierras del Arconte Geo tienen una historia de 3700 años, mucho más larga que el resto de las Siete Naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
