				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Bienvenid{F#a}{M#o}, {NICKNAME}, amig{F#a}{M#o} de Nobile, y felicidades en el primer día de tu trayectoria brillante como miembro de los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Nobile y yo no somos amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "#Suenas muy segur{F#a}{M#o} de ti mism{F#a}{M#o}... Nuestras ideas son fluidas como el agua. En cambio, la voluntad de la Zarina es firme como un témpano de hielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Pero volvamos al tema en cuestión. Nobile dice que ha cumplido con su parte de la promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "¿Promesa? ¿Se refiere a lo que dijo acerca de ayudarnos a buscar a alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Correcto. Nobile prometió que encontraría a alguien que pudiera sacarte de tus problemas. Los Once no suelen romper sus promesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Entonces, ¿dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Se encuentra en el <color=#00E1FFFF>Pabellón Liuli</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "¿El Pabellón Liuli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "¡Oh! ¡He oído hablar de él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "Hay dos grandes corrientes culinarias en Liyue, el estilo Li y el estilo Yue. Han estado en disputa por siglos, sin un ganador definitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "El restaurante insignia del estilo Li es el Pabellón Liuli. El dueño abrió el restaurante en la Pendiente Feiyun para competir frente a frente con el Quiosco Xinyue, el restaurante insignia del estilo Yue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Solo en momentos así eres una guía útil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#¡Eh, no le hables así a Paimon! En fin, Paimon tiene hambre. ¡Vamos rápido, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Cuando de comida y bebida se trata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "No tengo la intención de unirme a los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "¡Oh, llegaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100302,
					"content": "Tal y como prometí, encontré a alguien que puede ayudarles, alguien que puede resolver el misterio de por qué las Siete Estrellas ocultan los restos de Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100303,
					"content": "¿Y dónde está esa persona? ¿En el <color=#00E1FFFF>Pabellón Liuli</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Así es. Síganme, se lo presentaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100305,
					"content": "Siguiendo la tradición de Liyue, me tomé la libertad de preparar una “cena de negocios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Permítanme presentarlos. Este es el Sr. Zhongli, asesor de una organización llamada “El Camino”. Un socio de confianza entre los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100502,
					"content": "¿Socio de los Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Así es, debido a la naturaleza de su industria en Liyue, es imposible que no lo conozcamos en nuestros círculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100505,
					"content": "Y a nosotros los Fatui nos gusta hacer negocios con amigos que operan en las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100506,
					"content": "¿En las sombras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "Es un honor conocerles. He escuchado rumores de ustedes en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "¿Círculos, sombras...? ¡Ah! ¡¿Quiere decir que El Camino se “hace cargo” de las personas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Así es. Acertaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "¡AH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "La Funeraria El Camino organiza entierros. Nos aseguramos de que la gente que pasa a la otra vida lo haga en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "¡Jaja! ¿Pensaron que Zhongli era un asesino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100514,
					"content": "Hay muchos asesinos entre las amistades de los Fatui, pero El Camino no se dedica a esa industria. Al menos no en apariencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100515,
					"content": "¿“En apariencia”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Claro. Al fin y al cabo, es un hombre de negocios. Pero no hablemos de eso. Les traje a conocer a Zhongli porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100517,
					"content": "Porque puedo llevarlos a que vean los restos de Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "No es de sorprender. Ciertamente, las Siete Estrellas escondieron los restos bajo las instrucciones de Ninguang, el Equilibrio Celestial, pero primero escuchemos lo que el Sr. Zhongli tiene que decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100520,
					"content": "Rex Lapis es el Adeptus Primigenio y, como tal, sigue siendo un Adeptus. A lo largo de los miles de años de historia de Liyue, hemos despedido a varios de ellos. Es algo que no podemos evitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "Pero los tiempos han cambiado. Seguramente también lo notaste mientras estabas en el Desfiladero Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Ciertamente, los Adeptus están dejando Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Como se habrán dado cuenta, la era de los Adeptus está llegando a su ocaso, y la era de los humanos está en sus albores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Antes, cuando un Adeptus partía, la tradición de Liyue dictaba que se debía llevar a cabo un servicio fúnebre solemne. Pero en esta ocasión, las Siete Estrellas no han hecho el más mínimo intento de respetar esta tradición. Es un sacrilegio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Especialmente cuando se trata de un deicidio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Sí, ¡y todavía no han dado con el verdadero asesino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "A El Camino no le interesa el deicidio en sí. Lo que nos interesa es que, si la ceremonia para recibir a un dios es majestuosa, es aún más indignante que su última despedida quede desatendida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "#Viajer{F#a}{M#o}, Nobile me ha contado muchas cosas sobre ti. Ya que tienes relación con el Arconte Anemo, ¿podrías ayudarme a preparar las exequias del Arconte Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Tengo que pensarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#Humm... {NICKNAME}, no hay mucho que pensar, creo que no nos queda de otra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Así es. Por más que lo pienses, solo podemos hacer una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100539,
					"content": "Ninguang, el Equilibrio Celestial, ha dicho que nadie puede ver los restos de Rex Lapis. Así que, si tu objetivo es ver a Los Siete, solo queda una forma de hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100540,
					"content": "Así es. Solo asistiendo al Rito del Ascenso podrás ver a Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Supongo que no tengo alternativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Bien. Si estamos todos de acuerdo, acompáñenme. Hablaremos de los detalles en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Se oscurece la pantalla. Zhongli sale por la puerta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Bien, mi trabajo como intermediario ha llegado a su fin. Salió bien, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100545,
					"content": "Si quieren irse, pueden hacerlo. No se preocupen por mí, me quedaré a beber una copa más... y de paso trataré de aprender a usar los palillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100534,
					"content": "Acepto tu invitación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Sabia elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100536,
					"content": "Nobile habla de más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "¿Eh? En nuestros círculos, eso significa que quieres “silenciarme”... Interesante. ¡Desenfunda tu espada, vamos afuera y...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100538,
					"content": "¡Jaja! Estoy bromeando. De vuelta al tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10100523,
					"content": "Así que, además de ser uno de Los Siete, ¿el Arconte Geo también es un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "El Arconte Geo tiene varios títulos: Patrono de los contratos, Patrono del comercio, el Dios de la Guerra, Morax, Rex Lapis... y, naturalmente, Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "¿El Camino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
