			"dialogs": [
				{
					"id": 710350101,
					"content": "¿Qué les gustaría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350102,
					"content": "Tres porciones de pez tigre a la parrilla, para llevar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "¡Bien! Esperen aquí un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350104,
					"content": "¿Tres porciones? Una para ti, otra para Paimon... ¿y otra para...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Vamos a visitar a Pervases.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "¿Te refieres al mismo Pervases que nos dio las lámparas ceremoniales y el incensario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Oh, sí. Paimon recuerda que Pervases dijo que echaba de menos asar y comer pez tigre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Pero, Pervases ya debe haberse ido... ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Igual podemos ir a ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Sí, tienes razón. ¡Vayamos a verlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Cuando vimos a Pervases allí, el templo estaba deteriorado y viejo, y parecía haber rastros de los Ladrones de Tesoros en los alrededores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Paimon espera que no hayan vandalizado su estatua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Aquí tienen, tres porciones de pez tigre a la parrilla para llevar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350115,
					"content": "#¡Qué bien huele! {NICKNAME}, vamos rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "A Pervases le gusta el pez tigre a la parrilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
