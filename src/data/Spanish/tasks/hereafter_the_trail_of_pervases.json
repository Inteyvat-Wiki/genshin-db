			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Pensar que este templo sigue tan dañado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "¿Por qué de repente quieres reparar el templo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "*Ejem*, es una larga historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Mientras fingía ser un Adeptus, reuní un montón de recursos que me ayudarían a mantener las apariencias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "Pero juré hacer el bien después de recibir una lección de ese Adeptus, ¿verdad? Así que volví y me preparé para destruir todos mis materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Pero entonces se me ocurrió una idea... En lugar de destruir todo esto, ¿no sería mejor tomar estos recursos y los métodos que utilicé, y compartirlos con los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "De esta manera, puedo ayudar a otros a descubrir estafadores y charlatanes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "No esperaba que la guía que escribí ayudara a tanta gente. Incluso el Ministerio de Asuntos Civiles dijo que era muy útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Incluso me proporcionaron algunas medidas adicionales contra las estafas para añadirlas al material que yo mismo había escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "Me pagaron una suma considerable por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Además de esa guía, también estoy trabajando en otro libro sobre el Guardián Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Su propósito, por supuesto, es publicitar sus historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "Así podré hacer buen uso de mis conocimientos folclóricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "En cuanto a este templo de Pervases, lo descubrí mientras recopilaba material para el segundo libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Los registros indican que el templo se construyó para conmemorar al Yaksha Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Sin embargo, nunca esperé encontrar el templo en tal estado de deterioro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Cuando volví y pensé en ello, decidí financiar la reparación de este templo de mi propio bolsillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Después de todo, fue un Adeptus el que me trajo de vuelta al camino del bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "La restauración de este templo es una especie de expiación por todos los males que he causado antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Humm... A Paimon le parece que lo dice de corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#¿Qué opinas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Parece que dice la verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "¿Qué quieres decir con “parece”? ¡Estoy diciendo la verdad! ¡Es cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "*Suspira*, olvídalo, puedes pensar lo que quieras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Si no me crees, entonces vuelve una vez que el trabajo haya comenzado y verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Bueno, hasta hace poco eras un estafador...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "¡Pero ya no lo soy! ¡Ahora soy un ciudadano honrado! ¿No juré que lo sería ante ese Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
