			"dialogs": [
				{
					"id": 710350301,
					"content": "#Oh, gracias, poderosos Adeptus, muchas gracias... Qué casualidad encontrarl{F#as}{M#os} de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350302,
					"content": "¿Nos conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "¿Cómo podría olvidarme de ustedes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350304,
					"content": "¿Y tú eres...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "¡Soy Wang Ping'an! ¿No se acuerdan de mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350306,
					"content": "¿“Ladrón de Estrellas”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "¡¿Ah?! No, no, no. ¿Acaso quieres que me maten? Ese Adeptus sigue aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350310,
					"content": "Estaba por visitar el templo para hacerle una ofrenda al Yaksha Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350311,
					"content": "Pero poco después de entrar en la montaña, fui blanco de ese grupo de Ladrones de Tesoros... Gracias por salvarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350312,
					"content": "Un momento, ¿qué era lo que ibas a hacer en el templo de Pervases?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "¿Estabas planeando hacerle algo malo a su estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "¡No, no! ¡Nunca haría algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350315,
					"content": "Entonces, ¿qué planeabas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Quería... restaurar ese templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350317,
					"content": "Vine hoy porque iba a echarle otro vistazo al templo para poder volver y comprar los materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350318,
					"content": "Nunca esperé que sería objetivo de los Ladrones de Tesoros a mitad de camino y tuviera que huir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350319,
					"content": "Pero corrí y corrí... hasta que me perdí. Ya pueden imaginar el resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350320,
					"content": "Cuéntanos los detalles en el templo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Sí, este no es un buen lugar para hablar, vayamos primero al templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350322,
					"content": "Allá podremos conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350323,
					"content": "Adelántense ustedes, yo todavía tengo otras cosas que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "¿Eh? ¿Ya te vas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "Y... se fue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Te recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Ah, bien, bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
