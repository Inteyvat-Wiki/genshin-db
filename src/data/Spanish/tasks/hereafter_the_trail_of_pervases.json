			"dialogs": [
				{
					"id": 710350201,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350202,
					"content": "¿También viniste a ver a Pervases?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Solo pasaba por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350204,
					"content": "#¿Qué l{F#as}{M#os} trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350205,
					"content": "¡Vinimos a ver a Pervases!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350206,
					"content": "Oh, pero si este lugar sigue hecho un desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350207,
					"content": "Es evidente que aquí hay un templo y una estatua, ¿por qué nadie les da mantenimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350208,
					"content": "Tal vez se han olvidado de este lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "¿Cómo pudieron? Los Yaksha fueron los grandes héroes que protegieron Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350211,
					"content": "Xiao... ¿E-estás molesto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350212,
					"content": "No. Los Yaksha cumplieron con su deber sin perseguir ningún tipo de reconocimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350213,
					"content": "... En fin, no hablemos de eso, ¡mejor comamos el pez tigre a la parrilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350214,
					"content": "Humm... Xiao, si tú también quieres un poco, podemos darte la mitad de nuestra porción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350215,
					"content": "No es necesario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350216,
					"content": "¡Ayuda! ¡Ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350217,
					"content": "¿Eh? A Paimon le pareció escuchar una voz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350218,
					"content": "¡Alguien pide ayuda, por ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350219,
					"content": "¡Vamos rápido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "¿Eh? ¡¿Qué hay del pez tigre a la parrilla?! ¡Paimon aún no ha comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
