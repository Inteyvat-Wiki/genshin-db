			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370201,
					"content": "¡Ha pasado mucho tiempo desde que pisamos Inazuma por primera vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370202,
					"content": "Han pasado muchas cosas desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370203,
					"content": "Todo en un abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "Sí. Definitivamente hemos avanzado en nuestro viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370206,
					"content": "Entonces, ¿a dónde nos dirigimos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370207,
					"content": "Espera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "¿Eh? ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370209,
					"content": "Ten cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "Alguien viene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "Hay tantos recuerdos entrañables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203704",
							"2"
						],
						"stepId": 1203704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "¿Eh? Así que no tienes una Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "Me temo que me confundí de persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "¡Antes de atacar, al menos deberías asegurarte de que es la persona correcta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Pensándolo bien... ¡No deberías ir atacando a las personas así sin más! ¡Es muy peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "¿Conocen a alguien llamado Kaedehara Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Lleva una espada, al igual que tú. Además, he oído decir que tiene una Visión Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "¿Qué quieres de él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "No es asunto tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "¡Hum! Olvídenlo. Si no lo conocen, solo estoy perdiendo el tiempo con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "¿Qué le pasa a ese tipo? Se presenta blandiendo esa extraña espada ante nuestras narices, ¡y ni siquiera se disculpó! Es un verdadero patán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Aunque al menos tenemos algo claro: no le diremos nada acerca de Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Estoy totalmente de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "¿A que sí? Paimon tiene el presentimiento de que, aunque ese tipo desafiara a Kazuha a un duelo, mordería el polvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "#En fin, aunque solo sea para estar segur{F#as}{M#os}, deberíamos buscar a Kazuha de inmediato y decirle que alguien va tras él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "Lo cierto es que tengo una corazonada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "¿Eh? ¿Y qué corazonada es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Creo que ese tipo tiene una conexión especial con Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "¿Una “conexión especial”? ¿Estás diciendo que ya se conocen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "No puedo decirlo a ciencia cierta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Humm, sí, un poco... Pero casi todas las personas parecen iguales cuando pelean, así que eso no significa nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "En fin, no hay tiempo que perder. ¡Vamos a buscar a Kazuha y advertirle del peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "Paimon ha escuchado que la Flota Crux Meridianam se está abasteciendo de mercancía en Ritou. Vamos para allá a buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "Su manera de luchar es parecida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Por fin dices algo inteligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "#¡Oye, qué mal{F#a}{M#o} eres! ¡Paimon siempre dice cosas inteligentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "¡Oh, hola! ¿Sabes dónde está Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "¿Así que ustedes también están buscando a Kazuha? Debe haberse metido en algo realmente serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "¿“También”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Jajaja, bueno, resulta que nos dirigíamos a Ritou por suministros en nuestras embarcaciones más pequeñas, como siempre... Pero esta vez, en cuanto entramos en el puerto, nos topamos con una enorme multitud de personas de Inazuma, todos estaban buscando a Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Puede que sea por la batalla en la Playa Nazuchi, pero la Capitana Beidou también estuvo ahí, ¡y su presencia no ha causado tanto alboroto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Kazuha es bastante reservado la mayor parte del tiempo. De hecho, a veces ni siquiera escucha a la Capitana, pero a ella no le importa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "¿Eh? Así que tú tampoco sabes lo que hizo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "He escuchado algún que otro rumor... Algo así como que bloqueó el Filo del pensamiento vacío de la Shogun Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "¿De verdad es una gran hazaña como todos la pintan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Supongo que es como la técnica que Beidou usó para derrotar a Haishan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "¿En serio? Guau, si lo pones así, tiene sentido. Jajaja, en ese caso, ¡sí que merece ser famoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Hace poco lo llamaron de la Comisión Tenryou. Por lo visto tenían algún asunto importante que tratar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Al principio pensé que iban a arrestarlo, pero no pudieron ser más amables con él. Parece que le tienen en alta estima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Hasta hace poco, nadie lo habría imaginado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Tal vez el shogunato quiere hacer una buena acción.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Bueno, ¡gracias! Entonces deberíamos ir a la Sede de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Bien. Yo me quedaré aquí intentando controlar a la multitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Después de todo, la mentalidad de la Shogun Raiden ha cambiado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Ah, eres tú, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Hola. Estábamos hablando sobre la abolición del Decreto de captura de Visiones. Ya que estás aquí, puedes participar en la conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Hemos invitado al Sr. Kaedehara Kazuha como un gesto de amabilidad de parte del shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Gracias a sus esfuerzos, hemos alcanzado la paz de la que ahora disfrutamos. Además, se me ha concedido la oportunidad de corregir los errores del pasado de mi familia, y estoy profundamente agradecido por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "La todopoderosa Shogun ha emitido una gran cantidad de disposiciones para eliminar, o al menos aliviar, las tensiones acumuladas a lo largo de los años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "El Triunvirato ha sugerido que se aproveche esta oportunidad para limpiar el nombre del clan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Supongo que conoces la historia del clan Kaedehara, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Algo he oído.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Bueno, en resumen, antiguamente existía un grupo de espaderos que servían directamente a la Shogun. Eran responsables de mantener y desarrollar el arte tradicional de la forja, y el clan Kaedehara formaba parte de ese grupo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Sin embargo, algunos de estos espaderos se rebelaron y huyeron a Snezhnaya. Tanto el clan Kaedehara como el clan Kamisato fueron culpados por su mala gestión y así comenzó un periodo de gran agitación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Más tarde nos enteramos que todo había sido parte de un plan secreto urdido por los Fatui. Fue injusto e inaceptable hacer que los clanes Kamisato y Kaedehara cargaran con las culpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Tomando en cuenta la importante contribución que el Sr. Kaedehara ha hecho de nuevo a Inazuma, la todopoderosa Shogun cree que no solo debería ser recompensado por sus logros, sino que también debería recibir una compensación por la injusticia cometida contra su clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Para evitar que los Fatui causen problemas a otros clanes de espaderos en el futuro, hemos decidido no hacer públicos los resultados de nuestras investigaciones sobre este asunto. Espero que puedan comprender el porqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Es un verdadero honor. Me complace tener la oportunidad de aceptar las buenas intenciones de la todopoderosa Shogun y del shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Aunque creo que estoy en lo correcto al asumir que este acto de bondad no será a cambio de nada, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Me temo que se equivoca. Solo estamos intentando corregir las injusticias del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Una vez compensadas las afrentas llevadas a cabo contra el clan Kaedehara, volverán a ser una familia de espaderos. Ya no tendrá que seguir vagando sin rumbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Podrá llevar una vida segura y próspera en Inazuma con la bendición de la todopoderosa Shogun y el apoyo total del shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Me he acostumbrado a vivir en este gran mundo. Me temo que no me sentiría a gusto si viviera encerrado entre cuatro paredes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Pero mis antepasados se sentían muy orgullosos del nombre Kaedehara y del arte de la forja que representaban. Es mi responsabilidad restaurar su honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "No parece muy convencido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Si acepta, creo que muchas de las calumnias que han circulado por las calles estos días desaparecerían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "¿Calumnias? Solo hemos escuchado comentarios positivos. Por un momento Paimon pensó que se referían a otro Kaedehara Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Para algunos, el Filo del pensamiento vacío es algo que nunca podría ser derrotado. No pueden aceptar la idea de que Kaedehara realmente bloqueara el golpe de la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Además, algunos testigos aseguran que lo vieron utilizar energía Electro y Anemo, y comenzó a expandirse el falso rumor de que Kaedehara Kazuha estaba usando un Engaño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "¿Qué? Eso no tiene ningún sentido. Utilizar un Engaño te debilita y te hace envejecer, pero Kazuha está fresco como una lechuga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Correcto. Pero para algunas personas, la idea de que una persona utilice dos elementos a la vez resulta aún más incomprensible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Y ese es solo uno de tantos rumores. No me agrada la idea de que la gente hable de mí, ya sea para criticarme o elogiarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Pero si el shogunato está dispuesto a apoyarme, todas esas voces quizás se calmen antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "Es precisamente por eso que le pedimos que lo piense con detenimiento. Esta solución nos beneficiaría a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Está bien. Permítame considerarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Dejemos el tema por ahora. ¿A qué han venido ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "¡Ay! ¡Casi nos olvidamos de lo más importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Le hablan a Kazuha sobre el ataque a las afueras de la ciudad.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "¿Por qué me estaría buscando alguien tan peligroso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "¿Tienes hermanos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "No. Estoy tan confundido como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Heredé mis técnicas de combate de mi familia. Originalmente fueron creadas con el fin de probar las espadas. Nos sometemos a un exhaustivo entrenamiento para estandarizar las estocadas dadas con cada espada y así poder evaluar imparcialmente su calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Con el tiempo, ese conjunto de técnicas se convirtió en una especie de técnica de espada de los Kaedehara. Está básicamente enfocada a probar espadas, pero también incluye un amplio repertorio de métodos de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Nuestros métodos de combate distan enormemente de otros más prácticos que utilizan los samuráis en batalla, así que cuesta creer que ese parecido del que hablas sea fruto de la coincidencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "¡Razón de más para tener cuidado! A ese tipo le falta más de un tornillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Sí, suena a que es muy agresivo. Si llegara a atacar a alguien, el asunto podría acabar mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "En ese caso, enviaré a alguien tras él de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Se lo agradezco. He de admitir que siento mucha curiosidad por todo este asunto. En cuanto a su propuesta, necesito más tiempo para pensarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "#Primero investigaré junto {F#a la viajera}{M#al viajero} quién {F#la}{M#lo} atacó. Tendrá una respuesta a mi regreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Bien. Tengan mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Vamos, encontremos al atacante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "¿Sería otro discípulo de tu maestro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "No lo recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
