					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690325,
					"content": "Después, <color=#00E1FFFF>busca un sitio con agua en la montaña</color>... No importa si es un lago o un estanque, pon la caja en la orilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Debes tener mucho cuidado, no vayas a arruinar las flores.",
					"roleType": "TALK_ROLE_NPC",
