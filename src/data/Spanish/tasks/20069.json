			"dialogs": [
				{
					"id": 200690201,
					"content": "¿Cómo están las flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690202,
					"content": "Ya las enterré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Gracias. Entonces, dejémoslas en la montaña por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690204,
					"content": "Jeje, gracias por tu ayuda. Toma esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Flora"
				}
			]
		},
