			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Estas flores han perdido su vitalidad, es una pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Como todos los días vienen personas que compran una sola flor para regalar, suelo cortar unas cuantas con antelación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Pero después de cortarlas, no se conservan bien por mucho tiempo. Si no las vendo ese mismo día, se marchitarán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Lo he intentado de muchas formas, pero al cabo de un día, la mayoría de las flores se marchitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "¿Cómo puedo hacer que se conserven durante más tiempo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Usa métodos de conservación de comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Escuché a Sara de El Buen Cazador decir que la comida que les queda la dejan en un lugar frío y a la sombra, o usan hielo para conservarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Yo también lo intenté, pero por alguna razón, si dejo las flores directamente sobre el hielo, su color y forma se estropean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "No es que se marchiten, pero tampoco permanecen frescas. Aunque si no hay más remedio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Le pregunté a muchas personas, incluso al Sr. Sayid... ¿Lo conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Un día vino a comprarme una flor, y me dijo que una vez leyó en un libro sobre métodos de refrigeración de flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "En concreto, llenas un recipiente con flores, y luego lo dejas cerca del hielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Además, dijo que si quería hacer una prueba, las temperaturas bajas de Espinadragón eran las más adecuadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Pero he oído que la montaña es muy peligrosa. Llevo horas buscando, y no he encontrado un solo aventurero que esté dispuesto a ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme y enterrar estas tres cajas de flores frescas bajo la nieve de Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Gracias por tu ayuda. Déjame pensar... he oído que esa montaña es enorme y que hay muchas zonas distintas. Los efectos de conservación también deben ser diferentes dependiendo de cada lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Humm... Sería genial si pudiera comparar los diferentes efectos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "¿Podrías poner estas flores <color=#00E1FFFF>cerca de la Estatua de Los Siete</color>, <color=#00E1FFFF>a la orilla del agua</color>, y... <color=#00E1FFFF>en la entrada de la caverna</color>, respectivamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "¿Dónde tengo que enterrarlas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Véndelas todas ese mismo día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Eso sería lo mejor, pero siempre quedan una o dos flores que nadie compra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Aunque son solo un par, no puedo dejar que se marchiten en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
