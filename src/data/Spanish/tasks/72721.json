					"nextDialogs": [
						727210104
					]
				},
				{
					"id": 727210104,
					"content": "Según Yasuhiko Tarou, el cuarto participante se apuntó solo porque estaba un poco escaso de Mora, pero parece que Taroumaru también tiene los ojos puestos en el premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727210105,
					"content": "Lo siento, Taroumaru, pero, en lo que se refiere al dinero, ¡Paimon nunca da su brazo a torcer!",
