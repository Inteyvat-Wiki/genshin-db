			"dialogs": [
				{
					"id": 401930301,
					"content": "¡Jefa, el Festival Floral Mikawa ha sido un gran éxito para nosotros! Estos días, ¡estamos teniendo el triple de turistas que de costumbre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "Viendo lo que hemos ganado hasta ahora, creo que podremos alcanzar... ¡esta cifra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "¡Nada mal! Puede que este mes ganemos a la Editorial Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "¿Qué es tan divertido y por qué no me avisaron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh jeje... Nada, nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "Ah, por cierto, olvidé contarte una buena noticia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Ya llegaron a la Editorial Yae el 30% de los ingresos del Festival Floral Mikawa. Creemos que este mes vamos a batir un nuevo récord. Adelante, ya puedes darme la enhorabuena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "¡¿Cómo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "B-bueno, pues... Jefa, ¡enhorabuena por quedar en el segundo puesto en su intento n.º 333 de superar en ventas a la Editorial Yae!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Jejeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "Que todo el mundo tenga dulces sueños esta noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
