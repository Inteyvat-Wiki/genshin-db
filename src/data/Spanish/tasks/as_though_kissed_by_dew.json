			"dialogs": [
				{
					"id": 401930101,
					"content": "¡Colega del almaaaa! Me ha dicho un pajarito que anoche estuviste en el Balneario Aisa, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Tengo pensado ir con toda la banda para celebrar la ocasión. ¿Te apuntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Pero es que ya estuvimos ayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Bueno, pero hay gente que anoche no pudo ir, como Kuki, Gorou, mi colega Ayato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Básicamente, cuando el jefe se enteró de que fueron al balneario, le entraron ganas de ir a él también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "S-sí, sí, bueno... El caso es que, si has terminado todo lo que tenías que hacer, ¡dímelo y vamos todos a darnos un chapuzón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
