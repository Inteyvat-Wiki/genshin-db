			"dialogs": [
				{
					"id": 200070201,
					"content": "Solo necesita un pequeño arreglo, lo suficiente para que pueda llegar a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070202
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070202,
					"content": "Seguramente habrá algo de madera en los bosques de por aquí.",
					"roleType": "TALK_ROLE_NPC",
