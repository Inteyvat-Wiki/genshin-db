				"points": []
			},
			"dialogs": [
				{
					"id": 200070401,
					"content": "¡Me salvaste la vida! Son terriblemente persistentes, ¿no? Me pregunto qué atraparon esos cazadores que es tan irresistible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Solo tengo admiración por Draff, él logra cazar cosas tan buenas... *Suspira*, ojalá pudiera aprender a cazar como él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Bueno, lo primero es lo primero. Debo llevar este viejo carro a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "No me vas a creer, pero... casi había terminado de reparar el carruaje cuando lo dañaron de nuevo al volver a atacarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Mientras más tiempo me quede aquí, más empeorarán las cosas. Necesito arreglar esto lo antes posible. Recuerdo que había una soga en el carro, pero los Hilichurls debieron habérsela llevado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "#Viajer{F#a}{M#o}, ¿puedo pedirte que mires alrededor del área y veas si puedes encontrar alguna <color=#00E1FFFF>soga</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
