			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#G-gracias, {NICKNAME}, no puedo creer la suerte que tengo... Estaba seguro de que era el fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Este carruaje está cargado con todo lo que los cazadores lograron atrapar. Draff pidió entregarlo a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "No soy el mejor cazador del mundo, pero una simple entrega no debería ser problema. O eso pensé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Casi lo arruino todo. Este ataque fue completamente inesperado, supongo que iban detrás de la mercancía. Qué alivio que apareciste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Es un poco vergonzoso tener que pedirlo, pero... mi transporte se dañó en el ataque, y es mi única forma de salir de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Estoy seguro de que los bosques de por aquí tienen los materiales necesarios para cualquier reparación, pero no puedo dejar mis productos sin vigilar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "¿Puedes ayudarme a buscar algunos materiales para arreglar mi carruaje? Con una <color=#00E1FFFF>tabla de madera</color> debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000702,
