			"dialogs": [
				{
					"id": 200070601,
					"content": "Con esto bastará . Parece que se caerá a pedazos en cualquier momento, pero mientras me lleve de regreso a Mondstadt estaré bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "¡Gracias por todo! Estoy listo para irme ahora. ¡Llámenme la próxima vez que esté en Aguaclara y tomemos una copa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "... Siempre y cuando no bebas como Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
