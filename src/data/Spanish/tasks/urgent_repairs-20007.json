			"dialogs": [
				{
					"id": 200070301,
					"content": "Con esto es suficiente, lo tendré listo en menos de lo que canta un gallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070302
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070302,
					"content": "#¡Ah! ¡Han vuelto! ¡Viajer{F#a}{M#o}, han vuelto!",
