			"dialogs": [
				{
					"id": 718230701,
					"content": "Espera, ahora no es buen momento para recolectar cabezas de loto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718230702,
					"content": "Paimon está pensando... La señorita Zhi nos pidió que recolectáramos cabezas de loto por la noche, antes de las seis de la mañana, ¿cierto? Esperemos a la hora adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
