			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Oh, me quedan pocas hierbas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230202,
					"content": "¿Vas a ir a recoger hierbas medicinales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Humm... Justamente estaba preparándome para salir. Cada año, aprovecho esta temporada para preparar medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230204,
					"content": "No es nada fuera de lo común, solo son medicamentos para la fiebre o ayudar a hacer la digestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230205,
					"content": "¿Por qué no vas directamente a la Farmacia Bubu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Porque la farmacia queda muy lejos de aquí. Tardaría una eternidad en ir y volver de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230207,
					"content": "Además, la mayoría de las personas de la Aldea Chingtsé son niños y ancianos. A diferencia de ti, ellos no pueden ir tan lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230208,
					"content": "Así que, para curar sus malestares, no me queda más remedio que preparar estos medicamentos con antelación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230209,
					"content": "Cuando se trata de algo más grave sí tengo que ir a la Farmacia Bubu por una receta. *Suspira*, espero que no pase nada así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230210,
					"content": "En fin, no debería estar de charla. Todavía tengo que recolectar hierbas medicinales y, cuando termine, tengo que regresar para procesarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230211,
					"content": "Yo te ayudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "#¿Eh? ¿Estás dispuest{F#a}{M#o} a ayudarme? ¡Genial! Yo sola tardaría una eternidad en recolectar todas las plantas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230213,
					"content": "Déjame ver... Todavía me faltan tres tipos de hierbas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230214,
					"content": "Humm... Una es la flor chingxin, que crece en lo alto de las montañas. Es excelente para hacer la digestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230215,
					"content": "Después, está el lirio cala, que crece a orillas de los ríos. Es bueno para absorber la humedad interna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230216,
					"content": "En estos ríos crecen los lirios cala de mejor calidad. Normalmente solo uso lirios de estos ríos para hacer medicina, ya que los de otros lugares no son tan efectivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230217,
					"content": "Por último, necesitaremos cabezas de loto, que crecen en un estanque que hay aquí al lado. Pueden ser usadas como calmante y para fortalecer el corazón. Estrictamente hablando, lo mejor es recolectarlas por la noche, como muy tarde a las seis de la mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
