					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "Ah, volviste. ¿Pudiste conseguir las hierbas medicinales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Aquí las tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Gracias por tu ayuda. También le pedí a la Srta. Bai que me echara una mano preparando los ingredientes. Llevémoslos al molino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
