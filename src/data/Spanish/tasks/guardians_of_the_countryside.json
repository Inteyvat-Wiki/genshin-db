			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Srta. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "... Humm... Yo me hago cargo de las hierbas. Cuando termine, pueden llevárselas para preparar los medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718231002,
					"content": "Gracias. Ahora tengo que pensar en una forma de hacer la medicina más dulce... De lo contrario, los niños no se la querrán tomar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "¿Todos los años estás tan ocupada en esta época?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Sí, más o menos. Después de todo, no hay muchos jóvenes en la Aldea Chingtsé, así que ayudamos en lo que podemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 718231005,
					"content": "Estar ocupada en esta época del año no es problema. Además, gracias a tu ayuda, este año las cosas fueron más fáciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "En años anteriores, me tomaba una eternidad recolectar hierbas medicinales. Ni qué decir de procesarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Bien, gracias por ayudarme. Prepararemos los medicamentos rápido, y luego iremos a hacer las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "El año pasado casi me olvidé de liberarlas. Este año definitivamente tengo que acordarme de hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "¿Qué deseo pedirás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Humm... ¿Salud para la gente de la Aldea Chingtsé? Jeje, algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Pero si te lo contara, no se cumpliría, así que no te lo diré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Toma, gracias por ayudarme el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
