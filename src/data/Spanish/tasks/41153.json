					"nextDialogs": [
						411530303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411530303,
					"content": "Es muy importante que su caldo se conserve bien, así que <color=#00E1FFFF>no vueles o escales</color> para que no se derrame. Ah, y entrégalo rápido, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411530304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411530304,
					"content": "Si sucede algún imprevisto, vuelve y te prepararé otra ración.",
					"roleType": "TALK_ROLE_NPC",
