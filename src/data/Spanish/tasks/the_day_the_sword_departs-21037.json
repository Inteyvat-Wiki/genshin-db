			"trigger": {
				"objectNames": [
					"Chue'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Zhiruo, ¿tú crees que lo ha hecho adrede? E-es que... ¡no quiere estar conmigo! *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 210370402,
					"content": "Chue'er, con la de tiempo que llevan juntos, ¿cómo no va a saber lo que estás pensando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Si está decidido a dejar atrás Liyue y emprender un nuevo viaje, seguro que tiene sus motivos. ¿Qué tiene de malo que viajes con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "¡No quiero irme de Liyue! ¿Qué tiene de malo querer quedarse aquí siempre? ¡A mí el Clan Guhua me importa un comino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 210370405,
					"content": "¿Y por qué no se lo dices a él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "*Suspira*, él está empeñado en la antigua gloria del Clan Guhua. Si se lo dijera, seguro que me odiaría por ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 210370407,
					"content": "*Suspira*, Chue'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
