			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Muchas gracias, con esto bastará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "No pareces muy animado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Ah, no, no es nada. Jaja, no quería preocuparte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Es que me da pena abandonar Liyue, ¿sabes? He vivido aquí la mayor parte de mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "¿Cuándo partirán?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Cuando los suministros estén preparados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ah, por cierto, la aventurera que me llevó a la Sima también va a venir con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Cuando le comenté que iría a Fontaine, le picó la curiosidad y ha decidido venir también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "El comerciante estaba encantado de tener otra viajera a bordo para protegerlo, pero... yo no soy muy bueno comunicándome con gente tan efusiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Nunca pensé que yo también abandonaría Liyue algún día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
