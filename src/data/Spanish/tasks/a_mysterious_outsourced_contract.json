			"dialogs": [
				{
					"id": 766530401,
					"content": "Por fin has llegado. No se te habrá olvidado esta oportunidad única de trabajo externo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Un momento, ¿cuál era tu pedido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "... Soy Gaudenty, representante externo de la Oficina de Diseño Experimental Kuuvahki. ¿Te refresca eso la memoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Qué pereza... Háblame del pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "Arg... Bueno, lo repetiré una vez más. Recientemente, un grupo de robosondeadores perdió el control y escapó volando de la Oficina de Diseño Experimental Kuuvahki. Ahora están vagando por ahí y mi misión es recuperarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "Pero esos robosondeadores vuelan demasiado alto y yo no tengo forma de ocuparme de ellos por mí mismo. Por eso te ofrezco esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Cuando digo “recuperarlos”, también podemos destruirlos. El objetivo es que no caigan en manos de personas ajenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "¡Ah, ya me acuerdo del pedido! Esos robosondeadores vuelan muy alto y la mayoría de la gente no podrá alcanzarlos, pero he aprendido a construir vías kuuhenki artificiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#Podrías conseguir que nos ayude una kuuhenki, ¿verdad, {NICKNAME}? Podemos probar a usar las vías kuuhenki para volar en las alturas y derribar los robosondeadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#¡Sí, {NICKNAME} no tendrá problema alguno con eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "Será pan comido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "Por cierto, no les pagaré con Moras, sino que la recompensa consistirá en componentes de los robosondeadores como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "Ya estipulamos esa cláusula cuando realizamos el pedido, así que no puedes cambiar de opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "¿Pagar con componentes? ¿No decías que no querías que esos robosondeadores cayeran en manos ajenas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "¡Por eso mismo se trata de una oportunidad única de subcontratación! Si todo va bien, no me importará hacer la vista gorda esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "Qué raro... Lo que parece es que no quieres pagarnos, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "No me importa si el pago incluye Moras o no. Esos componentes me servirán justo para mi próximo proyecto de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Bueno, si tú lo dices, Aino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Suena un tanto desafiante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
}