				"objectNames": [
					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "E-esto es... ¡Mi “modus operandi”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#¡{NICKNAME}! ¡Acaba de admitirlo sin más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "¡Ah! Por favor, no me malinterpreten. Es una trama que pensaba incluir en mi próxima novela. Se me ocurrió mientras bebía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "No esperaba que esta hoja desapareciera en cuanto se me pasó la borrachera... Casi creía que todo había sido un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "En fin, ¡muchas gracias por ayudarme a recuperarla! Ahora debería poder sacar mi novela sin problemas. Cuando esté lista, ¡te daré un ejemplar! ¡Con autógrafo incluido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
