				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "¿Oh? Qué interesante, déjame ver... Humm, le daría un seis en creatividad, pero en viabilidad quizás un cuatro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "¿E-esto es un “plan criminal”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Jaja. En realidad, vine corriendo desde el puesto porque escuché que alguien por aquí estaba tramando un “plan criminal” de lo más extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "... Aunque después de ver esta página de notas, ya me hago una idea de cómo empezaron esos rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Dejemos este “plan criminal” en manos de los Caballeros de Favonius. Si tienes tiempo, pásate por mi puesto de guardia. Quizás haya algo interesante que ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
