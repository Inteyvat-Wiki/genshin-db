					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Hay muchos trozos de papel esparcidos por el nido, y parece que tienen algunas palabras escritas...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Estos papelitos... ¿No los habrán roto a propósito para hacer el nido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Parece que hay algo escrito en ellos. ¿Quieres que intentemos juntarlos para ver qué dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "#Tendremos que hacerlo nosotr{F#a}{M#o}s mism{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "¿No tienes curiosidad? ¡A lo mejor es un mapa del tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Bajo la insistencia de Paimon, armas la nota...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "A ver... Esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Acaso esto es... ¡¿un plan criminal?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "¡¿A quién se le ocurre dejar que un pájaro se lleve su plan criminal?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "Pero... ¡pero en las novelas siempre pasan cosas así! Un plan perfecto que falla justo en el momento más inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "¿Qué tal si vamos a la taberna de por aquí a preguntar? A ver si alguien ha oído algo como “¡últimamente alguien planea cometer un crimen!”, o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "Ante la duda, más vale prevenir que curar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "T-tienes razón... Si de verdad alguien está planeando cometer un crimen, ¡después será demasiado tarde para arrepentirse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
