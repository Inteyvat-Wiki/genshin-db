			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120701,
					"content": "¡Es tal como siempre lo imaginé! ¡Es el mundo del Sr. Cíclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120702,
						110120703
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120702,
					"content": "Es una sorpresa que preparó tu hermano para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				},
				{
					"id": 110120704,
					"content": "Guau... ¡De verdad lo hizo! Y la forma en la que derribó a esos Guardianes de las Ruinas, ¡parecían de juguete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120705,
					"content": "Pero Paimon se pregunta si está bien que use Legado del mal de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120706,
					"content": "¡Genial! ¡Jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120707
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120707,
					"content": "Si estos Señores Cíclopes no fueran tan grandes, me llevaría uno a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120708
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120708,
					"content": "Hablando de mi hermano... ¿A dónde fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120709
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120709,
					"content": "¿No estaban jugando a las escondidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120710,
					"content": "¡Oh, es cierto! ¡Estaba tan emocionado que me olvidé del juego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120711
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120711,
					"content": "#Bueno, viajer{F#a}{M#o}, vamos a buscarlo juntos, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120703,
					"content": "¡El Sr. Cíclope es el mejor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				}
			]
		},
		{
			"id": 1101208,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101212",
							"2"
						],
						"stepId": 1101212,
						"stateName": "QUEST_STATE_UNFINISHED"
