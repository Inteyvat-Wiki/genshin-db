						"rawParams": [
							"1101202",
							"2"
						],
						"stepId": 1101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Ya llegamos, ¡bienvenidos al Instituto de Investigación de Juguetes de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120102,
					"content": "¡Al fin, llegamos! Ya puedo escuchar los sonidos de la maquinaria, ¡genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "¿Qué es este lugar? ¿Y cómo sabías que existía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Por lo que sé, creo que se trata de una de las instalaciones de Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120105,
					"content": "Dottore es otro de Los Once. Le gusta jugar con cacharros viejos. Es... una afición personal. Transformó estas ruinas en un centro de investigación sobre Guardianes de las Ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120106,
					"content": "¿Eh? ¿Quiere decir que los Guardianes de las Ruinas fueron creados por los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "No, tienen una conexión más cercana con la Orden del Abismo. Técnicamente, son nuestros enemigos... Nosotros solo los investigamos, nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120108,
					"content": "En cuanto a por qué los Guardianes de las Ruinas han estado deambulando fuera de su zona... Me imagino que es porque ya se cansó de jugar con ellos y perdió el interés en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120109,
					"content": "¡Guau! ¡Otro de Los Once con mal temperamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Eso explica por qué estabas dispuesto a traer a Teucer aquí. Parece que hiciste bien tu tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "En realidad... No del todo. No tengo idea de qué hay ahí dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120112,
					"content": "E-entonces, ¿no te preocupa la seguridad de tu hermano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "¡Claro que sí! Sea cual sea el peligro que haya ahí dentro, lo protegeré. ¿No es ese el deber de un hermano mayor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120114,
					"content": "Incluso Teucer comprende el motivo de mi lucha... Es el mismo motivo que he resguardado en lo profundo de mi corazón todos estos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120115,
					"content": "Hermano, ¿de qué hablan tanto? ¡Vamos adentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "¡Jaja! De acuerdo, síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Menos mal que me encontraron antes que él... Al parecer, las lesiones por usar Legado del mal son más graves de lo que pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120202,
					"content": "No tengo ni idea de qué haría si Teucer me viera en este estado... Mírame, parezco un globo desinflado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120203,
					"content": "¿No temes que acabe contigo aquí y ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "#¡Jaja! Si mal no recuerdo, tú también tienes {F#un hermano}{M#una hermana}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120205,
					"content": "Supuse que no acabarías conmigo enfrente de mi hermanito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120206,
					"content": "Pero nunca pensamos que llegarías hasta este punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Como dije antes... No puedo dejar pasar una oportunidad para ponerme a prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120209,
					"content": "Y esa es la razón por la que yo, Tartaglia, soy cada vez más fuerte, ¡jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120210,
					"content": "En fin, los sueños de la infancia son muy frágiles. Si no los cumples, llegará un día en el que se harán trizas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120211,
					"content": "Así que alguien tiene que protegerlos, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120212,
					"content": "Si haces una promesa, la cumples. Si cometes un error, te disculpas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120213,
					"content": "Y si le das un sueño a alguien, lo proteges hasta el final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120214,
					"content": "De eso se trata la familia, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "¿Todo esto te hizo recordar a alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120217,
					"content": "*Ejem, ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120218,
					"content": "¡Deja de hacerte el fuerte! ¡Necesitas ver a un médico! ¡Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Es una buena idea, pero primero, tengo un pequeño detalle para Teucer. Por favor, entréguenselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120220,
					"content": "¿Eh? Esto es... ¿un juguete del Sr. Cíclope?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Así es. Se la pedí a un herrero hace tiempo. Tenía la intención de dársela al regresar a Snezhnaya, pero creo que es más apropiada como un recuerdo para esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120222,
					"content": "Guau... Ahora que Paimon lo piensa, la familia de Nobile es muy afortunada, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Por cierto, tendrás que explicarle tú a Teucer por qué me he ido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120224,
					"content": "Me ayudarás, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120225,
					"content": "“Si con el meñique prometes, lo mantienes toda la vida”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "¡Jajaja! “Tu lengua se congelaría, ¡y nunca más mentirías!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120228,
					"content": "Ah... esa canción infantil me trae muchos recuerdos... Te la enseñó Teucer, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120229,
					"content": "Adelántate, no te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "... De acuerdo. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120226,
					"content": "“Si la promesa rompieres, al hielo te arrojaría”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120207,
					"content": "¿De verdad valió la pena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120208
					]
				}
			]
		},
		{
			"id": 1101203,
			"completionStepIds": [
				1101208,
				1101220
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101208",
							"2"
						],
						"stepId": 1101208,
						"stateName": "QUEST_STATE_UNFINISHED"
