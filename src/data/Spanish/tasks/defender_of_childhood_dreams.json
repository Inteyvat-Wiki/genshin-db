			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120301,
					"content": "No lo encuentro por ningún lado... ¿A dónde habrá ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120302,
						110120304
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120302,
					"content": "Vi a tu hermano hace un momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "¿En serio? ¿Dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "¡Muchas personas de repente querían comprar una copia de Sr. Cíclope!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "S-sí... tuvo que salir a toda prisa. No te abandonó a propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Oh... entonces, ¡genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "Es una pena, esperaba que pudiera jugar más tiempo con mi hermano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "Esto es de parte suya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120312,
					"content": "¡Guau! ¡Este es...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "¡No sabía que hacían Señores Cíclope de este tamaño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "¡Incluso tiene mi nombre! ¡Es mi propio Sr. Cíclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "Parece que te gusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "¡Claro que sí! ¡Mi hermano es el mejor del mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "Recorriste Liyue, viste a tu hermano, visitaste el Instituto de Investigación de Juguetes y tienes un recuerdo... Es el viaje perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "¿Estás listo para regresar a Snezhnaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Jeje, no se preocupen, sé que no siempre puedo salirme con la mía. Sería un dolor de cabeza para los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "El Sr. Cíclope te acompañará en su lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "Ya se fue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120305
					]
				},
				{
					"id": 110120305,
					"content": "¿Qué? ¿Por qué...? ¿Por qué se iría sin mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101204,
			"completionStepIds": [
				1101207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101207",
							"2"
						],
						"stepId": 1101207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Andrei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120401,
					"content": "#{F#Señorita}{M#Joven}, Teucer, los he estado esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120402,
					"content": "¿Eres un enviado de Nobile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120403,
					"content": "Así es. El Señor Nobile me ordenó que hiciera los preparativos para el regreso de Teucer. Por aquí, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120404,
					"content": "¿Quién eres tú? ¡Mi hermano siempre me dice que no confíe en extraños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120405,
					"content": "Pero nos has estado siguiendo todo este tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120406,
					"content": "Eso es porque sabía desde un principio que eran buenas personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120407
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120407,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120408,
					"content": "Mi hermano nos lo contó en una carta que envió a casa. Tonia la leyó para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120409,
					"content": "#Así que, {F#las}{M#los} reconocí tan pronto como {F#las}{M#los} vi. Es solo que... no podía recordar sus nombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120410
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120410,
					"content": "Qué giro del destino tan inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120411,
						110120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120411,
					"content": "Ha sido un gusto poder conocerte, Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120412
					]
				},
				{
					"id": 110120412,
					"content": "Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120415,
					"content": "Joven amo Teucer, el barco con rumbo a Snezhnaya atracará pronto. Es mejor que nos apresuremos a abordar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120416
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120416,
					"content": "Vaya, el tiempo vuela cuando te diviertes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120417
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120417,
					"content": "#Bueno, ¡nos vemos, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120418,
					"content": "#{F#Las}{M#Los} esperaré en casa. ¡Definitivamente tienen que visitar Snezhnaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120419,
						110120421
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120419,
					"content": "¡Trato hecho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120420
					]
				},
				{
					"id": 110120420,
					"content": "¿Lo prometes con el meñique?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120423,
					"content": "“Si con el meñique prometes, lo mantienes toda la vida. Si la promesa rompieres, Paimon al hielo te arrojaría. Tu lengua se congelaría, ¡y nunca más mentirías!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120424,
					"content": "Jeje, ¡es una promesa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120425,
					"content": "¡Adiós, Teucer! ¡Que tengas un buen viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120421,
					"content": "¿Quieres hacer una promesa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "¡De acuerdo! ¡Promételo con el meñique!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120413,
					"content": "Tu hermano no dijo nada malo de mí, ¿o sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "¡No, para nada! De hecho, dijo que si pudiera, ¡dejaría su trabajo y se iría de aventuras contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101206,
