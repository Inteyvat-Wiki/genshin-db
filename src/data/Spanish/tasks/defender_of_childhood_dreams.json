			},
			"dialogs": [
				{
					"id": 110120601,
					"content": "Teucer, ¿ves ese gran cubo de piedra ahí adelante? Necesito que me ayudes con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120602
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120602,
					"content": "¡Sí! ¿De verdad puedo ayudar a mi hermano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120603
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120603,
					"content": "Por supuesto. A la cuenta de tres, lo tocamos juntos. ¿Listo? Tres... dos... uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 1101207,
			"completionStepIds": [
				1101209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101209",
