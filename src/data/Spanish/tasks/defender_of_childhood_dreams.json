			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "Hermano... alguien dijo que el Sr. Cíclope es una máquina de matar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120802,
					"content": "¿Lo es? Qué cosas tan tontas dice la gente... Y tú no deberías repetirlo, eres muy pequeño para entender de estos temas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120803,
					"content": "Sí, yo sabía que estaban mintiendo. El Sr. Cíclope está aquí para derrotar a los malos y proteger al mundo. ¡Es mi juguete favorito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Así es. Con el Sr. Cíclope cerca, los malos nunca te atraparán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120805,
					"content": "¡Jeje, así es! ¡Bien, iré a jugar con mi Sr. Cíclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Oye, Teucer, espera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120807,
					"content": "¡L-la puerta se ha cerrado! ¿Estará bien Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Hay otro camino por allí, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 1101209,
			"completionStepIds": [
				1101213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101213",
							"2"
						],
						"stepId": 1101213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "¡Oh, la puerta se abrió! ¿Fuiste tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "Así es. Espera aquí, Teucer. Tengo que confirmar que sea seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110120903,
					"content": "*Suspira*, tal vez no debí haberlo malcriado tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
				1101214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101214",
							"2"
						],
						"stepId": 1101214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Uf, al fin, juntos de nuevo. No estás herido, ¿verdad, Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121002,
					"content": "¿Herido? ¡Para nada, fue muy divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Tal vez fue divertido para ti, pero nosotros estábamos muertos de miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "¿Qué hay ahí? ¡Guau, esta habitación es enorme! ¿Es aquí a donde el Sr. Cíclope trae a sus amigos cuando vienen de visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Así es. Impresionante, ¿verdad? Bien, ¿qué tal si jugamos al escondite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121006,
					"content": "¿Eh? ¿Ahora? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Jeje, es porque tengo... una sorpresa para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121008,
					"content": "¡Una sorpresa! ¿Qué tipo de sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "No te preocupes, podrás buscarla más tarde. Pero antes, debes cerrar los ojos, darte la vuelta y contar a partir de 60.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121010,
					"content": "Está bien... pero 60 es mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101211,
			"completionStepIds": [
				1101215
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101215",
							"2"
						],
						"stepId": 1101215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "Oye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121102,
					"content": "¿Nobile? Así que estabas aquí... ¿Por qué te escondes? ¿Por qué no viniste a despedirte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Las despedidas son momentos especiales. Si pasara sus últimos momentos viéndome en este estado lamentable... No quiero que se lleve ese recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121104,
					"content": "Aun así, es una pena que no pueda despedirme de él personalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121105,
					"content": "*Suspira*, debería ser yo quien lo llevara de regreso. Tengo subordinados que pueden hacerlo por mí, pero no me siento tranquilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121106,
					"content": "¡Por Los Siete! ¿No crees que ya lo has consentido lo suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Jaja. No sé cómo explicarlo, pero por alguna razón me sentí mucho más tranquilo dejándolo a tu cuidado. Y pensar que no hace mucho, nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121108,
					"content": "Ah, sí. Por poco lo olvido. Esta es la remuneración por tus servicios, de los cuales no hubiera podido prescindir para esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121109,
					"content": "Guau, así que, después de todo, ¡tienes corazón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Otra cosa, no olvides nuestra promesa. Ajustaremos las cuentas a la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121111,
					"content": "Esta vez, mi honor como uno de Los Once está en juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121112,
					"content": "Lo espero con ansias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Pero primero, descansa bien. ¡Así no podrás decir que nos aprovechamos de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Jajaja... Independientemente de quién gane o pierda en nuestro próximo encuentro, también me gustaría invitarte a mi casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121116,
					"content": "Te presentaré a mis otros hermanos, Tonia y Anthon. Son buenos chicos, y mi mayor orgullo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121117,
					"content": "¡Aceptamos la oferta! Especialmente porque se lo prometimos a Teucer con el meñique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "#Jaja, él también estará muy emocionado de verl{F#as}{M#os}. Bueno, es una promesa. Lo espero con ansias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121119,
					"content": "#Adiós, amig{F#as}{M#os}. Nos veremos de nuevo en Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 110121113,
					"content": "No dejaré que ganes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}