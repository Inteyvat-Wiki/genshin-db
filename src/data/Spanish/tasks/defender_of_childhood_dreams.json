	"talks": [
		{
			"id": 1101201,
			"completionStepIds": [
				1101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
