			"dialogs": [
				{
					"id": 727340101,
					"content": "Falta de disciplina, elegancia, creatividad, inspiración... y sobre todo, coordinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Aurimago Melindroso"
				},
				{
					"id": 727340102,
					"content": "Colega, ¿qué ladras? Ah, ya sé, estás lamentándote por los compañeros de equipo tuyos que hemos derrotado, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Aurimago Melindroso"
				},
				{
					"id": 727340104,
					"content": "Hablaba de su técnica de lucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Aurimago Melindroso"
				},
				{
					"id": 727340105,
					"content": "¿Es que te has chocado contra un Espectro y te ha afectado a la cabeza? ¿Qué crees, que esto es un circo? ¿Sabes cuál es mi estilo? ¡Una fuerza incomparable, una voluntad inquebrantable y unos escaradiablos invencibles! Te daré una clase magistral cuando quieras y donde quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Haces que recuerde cosas muy desagradables del pasado... No soporto a la gente ruidosa y desagradable como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Aurimago Melindroso"
				},
				{
					"id": 727340107,
					"content": "#Humm, pero {F#la rubita}{M#el rubito} parece bastante débil. ¡Decidido! ¡Te reto a un combate de escaradiablos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Aurimago Melindroso"
				},
				{
					"id": 727340108,
					"content": "Pfff, ¡JAJAJAJAJA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "Colega, ¿has oído lo que dice este payaso? ¡Cree que será fácil ganarte! ¿Por qué no le enseñas una lección al estilo Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Jaja, será un placer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon no lo entiende, esta gente ni siquiera se ha molestado en informarse sobre su oponente. Solo vienen aquí en fila para contribuir a nuestra racha de victorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Vaya mezcla de raritos hay en el equipo del Gran Maestre Hanakado... Pues en cuanto a estrategia, ¡nadie nos gana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Ohhh, qué miedo, mira cómo me tiemblan las piernas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
