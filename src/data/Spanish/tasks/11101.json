			"dialogs": [
				{
					"id": 111010701,
					"content": "No lo entiendo... ¿Por qué no funcionó el Sello del Permiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010702,
					"content": "¿Acaso se volvió más potente el aura maligna de estos Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010703,
					"content": "El Sello del Permiso... ¿Dónde ha oído Paimon eso antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Es eso que te deja salir y entrar libremente del Desfiladero Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "¡Oh, cierto! Es el emblema de los Adeptus, ¡aún debe tener restos de su poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "A Paimon no le extraña que antes lograra ahuyentar a los monstruos con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "¿D-de qué hablan ustedes dos? ¡Es solo que anoche no pude conciliar bien el sueño, y mi poder adéptico no fluye del todo bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010709,
					"content": "Si me dieran otra oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010710,
					"content": "Pues, casualmente ahí vienen más Hilichurls malignos. ¿Quieres que te los dejemos a ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Yo... de repente no me encuentro bien, he utilizado demasiado poder adéptico. De lo contrario, esos demonios no tendrían ninguna posibilidad de vencerme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010712,
					"content": "*Suspira*, vaya, así que solo estabas dándote aires de grandeza. ¡Hicimos bien en sospechar de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "#Vamos, {NICKNAME}, parece una tarea para nosotr{F#as}{M#os}. ¡Recuerda usar tu Visión Elemental para rastrear a esos monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "O sea, que usaba el Sello para sus exorcismos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
