			"dialogs": [
				{
					"id": 111010201,
					"content": "Entonces, ¿quieres una copia de «Yakshas: los guardianes Adeptus»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010202,
					"content": "Sí. Toma, quédate con el cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010203,
					"content": "Oh, ¡qué generoso! ¡Gracias por tu visita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010204,
					"content": "¿Ese no es Bribón de Estrellas? Qué casualidad encontrarlo por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010205,
					"content": "Es “Ladrón de Estrellas”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "¿Escuchaste el título del libro que pidió? ¿Era «Yakshas: los guardianes Adeptus»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010208,
					"content": "Paimon recuerda que es un libro sobre los Adeptus, pero ¿por qué un Adeptus compraría un libro sobre sí mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010209,
					"content": "Desde el principio supe que no era de fiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "¿En serio? ¿Qué tiene de sospechoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010214,
					"content": "¿Para qué necesita Mora un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "#Ah... Eso es cierto. Ningún Adeptus que hayamos conocido necesitó algo de nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010220,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010221,
					"content": "Paimon cree que deberíamos revisar el contenido de ese libro. ¡Quizás averigüemos algo que podamos usar contra él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010216,
					"content": "Me parece un charlatán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Entonces, ¿quieres decir que no puede conceder ningún deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010218,
					"content": "Su máscara es feísima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "¡Ah! ¡Es verdad! Humm, es un tipo muy sospechoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010211,
					"content": "¿Tal vez sea un narcisista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "Humm... ¡Tienes razón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010213,
					"content": "Pero, ahora que Paimon lo piensa... Es cierto, hay algo extraño en este Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010206,
					"content": "Esto debe ser lo que llaman “destino”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
