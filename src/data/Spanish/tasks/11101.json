			"dialogs": [
				{
					"id": 111011101,
					"content": "Habla de unos “demonios”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011102
					]
				},
				{
					"id": 111011102,
					"content": "El libro dice que el odio de los dioses que fueron derrotados durante la Guerra de los Arcontes dio lugar a enfermedades, plagas, monstruos y extrañas mutaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011103,
					"content": "Todo esto suena terrible... Espera un momento. ¿Significa eso que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011104,
					"content": "... esos Hilichurls malvados que vimos eran “mutaciones”, como de las que habla el libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
