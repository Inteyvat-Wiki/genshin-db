			"dialogs": [
				{
					"id": 111010501,
					"content": "¡Huyan, demonios malignos! ¡Es una orden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010502,
					"content": "¡Váyanse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010503,
					"content": "¡¿P-por qué no se van?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111010504,
					"content": "Beru nye! Beru nya! Beru nyaaaa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 111010505,
					"content": "Oh, oh... ¡Parece que Ladrón de Estrellas está en problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010506,
					"content": "Hay gente inocente por aquí, ¡tenemos que ayudarlo!",
