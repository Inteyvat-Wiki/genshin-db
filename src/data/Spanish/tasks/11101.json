				{
					"id": 111011201,
					"content": "Habla de algo relacionado con el “karma”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011202
					]
				},
				{
					"id": 111011202,
					"content": "El libro dice que los Yakshas, después de luchar contra el odio de los dioses durante miles de años, fueron sometidos por su propio mal karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011203,
					"content": "Envenenados por la amargura de los Arcontes, algunos sucumbieron a una ira, una locura y un dolor indescriptibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011204,
					"content": "*Suspira* Es tan triste... Después de proteger Liyue durante tanto tiempo, no obtuvieron ninguna recompensa y, además, tuvieron que soportar un terrible sufrimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
