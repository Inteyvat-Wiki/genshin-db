					"nextDialogs": [
						111011303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011303,
					"content": "¿Tendrá algo que ver con ese Ladrón de Estrellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011304
					],
					"speakerTitle": "Paimon"
				},
				{
