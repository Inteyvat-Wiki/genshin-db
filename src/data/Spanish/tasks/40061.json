				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "El viento del sur sopla hoy sobre la Isla Watatsumi, así que asumí que unos amigos vendrían de visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "#Siempre que dices eso, significa que tienes algo para {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Por favor, no digas eso. ¿O acaso nuestra asociación no ha rendido frutos? Y muchos, diría yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Sin embargo, es verdad que hoy tengo una solicitud para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "Además de llevar a cabo la ceremonia de ofrendas de Watatsumi, se dice que mis antepasados añadieron otra serie de desafíos. Sin embargo, no está relacionado con la supervivencia de la isla, sino con la búsqueda de la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "¿Más desafíos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Ahora que la Isla Watatsumi está libre de amenazas, es mi deber decirles una cosa como parte de mi responsabilidad con mis ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Diríjanse al lugar que tiene por nombre “Corazón de la Serpiente”. Allí encontrarán las pistas para el segundo desafío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "¡Uf! Qué alivio. Ahora puedo dejar esta responsabilidad en manos de mi futura hija con la conciencia tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "¿Eso es todo lo que tienes que decir de tu misión ancestral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "Después de todo este tiempo, Paimon sigue sin poder comprenderte, Tsuyuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}