				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "¡Alto ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 10200402,
					"content": "¿Quién se atreve a traspasar este territorio sagrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 10200403,
					"content": "Solo veníamos de paso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "¡Exacto! ¿De qué estás hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "#¡Somos invitad{F#as}{M#os} de honor! ¿Qué te hace pensar que puedes tratarnos así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "No, espera... ¡Tal vez este era el plan de Ninguang desde el principio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Pretendió invitarnos a la Cámara de Jade, ¡pero en realidad nos tendió una emboscada para que la Geoarmada nos arrestara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "No creo que sea eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "¡Ah, Paimon está furiosa! ¡Oye, tú! Esta es una trampa, ¿cierto? ¡Qué sinvergüenzas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "¿De qué estás hablando? Solo estamos haciendo una vigilancia rutinaria, ¿por qué nos llamas sinvergüenzas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 10200413,
					"content": "#¡Basta de tonterías! ¡Detengan a {F#estas intrusas}{M#estos intrusos} de una vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Apolo"
				},
				{
					"id": 10200414,
					"content": "Ahí vienen, ¡dales su merecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "#No les hemos explicado que fuimos invitad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "¿Territorio sagrado? Son solo las afueras de la Cordillera Tianheng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "¡Alto ahí! ¿Qué es este alboroto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 10200602,
					"content": "#Maestra Keching, {F#estas sospechosas}{M#estos sospechosos} aparecieron de la nada. Al parecer, tenían miras de hacerle algo a la Balista Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaching"
				},
				{
					"id": 10200603,
					"content": "#¡Oye! ¿A quién llamas sospechos{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Solo estaba buscando cómo llegar a la Cámara de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "¿Eh? ¿Quieren ir a la Cámara de Jade? ¿Quiénes son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200606,
					"content": "#Somos invitad{F#as}{M#os} de honor, ¡vinimos a buscar a las Siete Estrellas de Liyue! ¿Tú quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200608,
					"content": "Da la casualidad que yo soy una de las Siete Estrellas de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200609,
					"content": "¿?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Me llamo Keching, soy el Equilibrio Terrenal de las Siete Estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200611,
					"content": "#He oído hablar de ti, viajer{F#a}{M#o}. ¿Así que eres invitad{F#a}{M#o} de Ninguang? No esperaba encontrarte aquí en las montañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200612,
					"content": "¡Guau! ¡Paimon no pensó que encontraríamos a una magnate en un lugar tan remoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "La Balista Guizhong del Paso Tianheng ha sido descuidada por mucho tiempo, pero de la noche a la mañana estaba como nueva. Vine a investigar a qué se debe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200614,
					"content": "Los soldados de la Geoarmada solo están aquí para vigilar la zona, no para arrestar a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200615,
					"content": "Entonces, ¿fue un malentendido? Paimon no se lo esperaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "No piensas mucho, ¿cierto, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "#En fin, es un verdadero misterio que {F#una}{M#un} simple mortal haya podido reparar un mecanismo Adeptus, incluso para las Siete Estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200618,
					"content": "Jeje, eso es porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(*Shh*, ¡no compliques más las cosas, Paimon!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "¿Eh? ¡Oh, cierto! Equilibrio Terrenal, ¿sabe dónde se encuentra el Equilibrio Celestial? Fue quien nos invitó a la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Llámenme Keching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200623,
					"content": "#Me imagino que si Ninguang invitó {F#a la heroína}{M#al héroe} de Mondstadt, es para que tome una postura más neutral. Eso, o que al menos no se incline a favor de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200624,
					"content": "¡No estamos posicionándonos a favor de nadie! Hablamos con los Adeptus, ellos también piensan proteger Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Cuando dices “proteger”, ¿te refieres a su santurrona arrogancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200626,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "#Como ustedes son mortales, los Adeptus l{F#as}{M#os} protegen. No l{F#a}{M#o}s consideran como “alguien que pueda matar a un dios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200628,
					"content": "Así que ellos piensan que el hecho de que Ninguang cierre la zona e interrogue a los ciudadanos no servirá para encontrar al asesino... Quizás incluso sospechen que sea una fachada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200629,
					"content": "Seré franca, nos subestiman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200630,
					"content": "Bueno, tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Pero esta es la primera vez que veo a alguien de Liyue que no tenga en alta estima a los dioses o a los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "¡Ja! ¿Acaso debería respetar su superficial sentido del tiempo y su condescendencia hacia los mortales, que es lo que los ha demorado a actuar en contra de las Siete Estrellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200633,
					"content": "Olvídenlo. No debería hablar de los Adeptus de esa forma. Soy yo quien no cree en los dioses y los Adeptus, Ninguang nunca hablaría así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200634,
					"content": "En fin, debo reconocer que las acciones de los Adeptus fueron muy mesuradas en esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200635,
					"content": "Ciertamente, la muerte de Rex Lapis es un evento sin precedentes. Pero si, en lugar de venir directamente aquí, decidieron convocar un consejo de Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200636,
					"content": "Es inesperadamente civilizado de su parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200637,
					"content": "Entonces, ¿existe la posibilidad de hablar cordialmente con ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Para Ninguang, cualquier asunto puede dialogarse, pero me temo que en esta ocasión es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200640,
					"content": "El tiempo de los Adeptus ha llegado a su fin. Si las Siete Estrellas de Liyue se niegan a encarar esta verdad, ¿qué futuro hay para Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200641,
					"content": "¡Uf! Otra declaración muy atrevida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "#*Suspira*, en fin, no hablemos más del tema. Francamente, no tenía la intención de hablar de más, pero eres {F#una buena}{M#un buen} oyente, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200643,
					"content": "De acuerdo, deberían ir a la Cámara de Jade. No lleguen tarde, la agenda de Ninguang está llena hasta el año que viene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200644,
					"content": "Para los comerciantes más ricos de Liyue, subir a la Cámara de Jade es el mayor de los honores. Todos llevan lujosos obsequios con tal de que Ninguang les dé alguna ventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200645,
					"content": "¿V-ventaja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, eso no es lo importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Pero... pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "¡Eso es! Llevar un obsequio es parte de la cultura de Liyue. No pretendemos que nos dé ninguna ventaja, solo estamos... ¡respetando las tradiciones de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Qué entusiasmada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "#Está bien, está bien. Ustedes mism{F#as}{M#os} deciden qué obsequiarle. Primero les diré cómo llegar a la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200652,
					"content": "En realidad, no era necesario venir a la Cordillera Tianheng. Regresen a Liyue, encuentren un guía en el Pabellón Yuehai, y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200653,
					"content": "#Bueno, nos veremos de nuevo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10200654,
					"content": "Vaya, aunque el Equilibrio Terrenal no respete a los dioses, Paimon tiene la impresión de que es una persona extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Yo también tengo una buena impresión de ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Por cierto, ¿qué deberíamos llevarle a Ninguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Otra vez de vuelta al obsequio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "¡Oh, lo tengo! Ayer mientras dormía, soñé con una comida deliciosa: ¡<color=#00E1FFFF>Slime confitado</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "¡Paimon tiene la impresión que será el obsequio perfecto para alguien de la talla de Ninguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "¿Qué tal si escogemos eso como obsequio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "¿Tienes la receta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "¡Por supuesto que no! Pero Paimon está segura de que lo único que hace falta es un poco de “bum”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Vamos a recoger ingredientes. El tiempo apremia, ¡y la gloria y la riqueza nos esperan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Y... ¿cómo hacemos esa cosa que soñaste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "¡Con un poco de “bum”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Estoy de acuerdo con lo que dice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, estamos hablando en serio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "¿Ninguang también querrá negociar con ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Solo fue un ajuste por aquí, otro ajuste por allá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "¿Eh? Solo nos lleva hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Si esa corriente de viento fuera más fuerte, ¡podríamos llegar hasta la cima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Es mejor que volvamos a Liyue y le preguntemos a la Geoarmada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "¿Eh? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "No debería haber ningún secreto para subir. De lo contrario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "#¿De lo contrario...? Oh, ya entiendo, de lo contrario, Ganyu no nos dejaría averiguarlo por nosotr{F#as}{M#os} mism{F#as}{M#os}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Está bien, hagamos como dices. Así podremos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "¡Ah! ¡Espera, mira ahí abajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Parece que estamos cerca de la <color=#00E1FFFF>Balista Guizhong</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "En ese caso... ¡Paimon tiene una nueva idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "¿Qué tal si usamos la Balista Guizhong para propulsarnos a la Cámara de Jade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "No, gracias, aún quiero vivir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Oh, cierto. No tuve en cuenta la seguridad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Recuerdo que la Balista tenía un catalejo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "¡Oh, cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Ahora que lo dices, ¡podemos usar ese catalejo para buscar un camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Paimon, ¿tanto me odias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Oh, no tuve en cuenta la seguridad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}