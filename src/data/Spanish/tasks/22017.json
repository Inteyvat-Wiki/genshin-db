			"dialogs": [
				{
					"id": 220170201,
					"content": "#Viajer{F#a}{M#o}, haz el favor de traerme unas cuantas novelas para que pueda demostrárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "¡Si le dejo que escriba como le apetezca, arruinará la novela de una vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		},
		{
			"id": 2201703,
