			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "¡Ya no escribo más! ¡Presióname todo lo que quieras, no servirá de nada! ¡Ya no quiero ser escritor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Hay que ver... ¡Ya me has amenazado con ponerte de huelga siete veces! ¿Acaso ha funcionado alguna vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "¿Otra vez están discutiendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#Ah, hola, viajer{F#a}{M#o}. ¡Tienes que ayudarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Este tipo ha aprovechado que te pusiste de su parte la última vez para hacer más y más demandas. ¡Me ha impuesto muchísimas normas nuevas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "¡Cubren todo tipo de aspectos, desde el más nimio hasta el más crucial! ¡Quiere que todo se ajuste a una norma estándar de redacción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "¿Qué clase de novela voy a escribir así? ¡Que la escriba él siguiendo sus estándares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Todas son normas extraídas de novelas que han alcanzado el éxito. ¡Es la experiencia de nuestros predecesores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "¡Entonces lo que estás haciendo es imponer en mi novela los recursos usados por otros! ¿Quién está escribiendo mi novela, yo o esos predecesores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "¡No voy a escribir algo tan rígido! ¿Dónde está mi libertad creativa? ¡Si quieres hacerlo así, hazlo tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Además, ¿no tiene la Editorial Yae muchas novelas así que apenas se venden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Eso es un problema de mercadotecnia y estrategia, no está relacionado con las novelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "¡Por supuesto que no tiene nada que ver con la mercadotecnia y la estrategia! ¡Simplemente es que la forma de escribir de esos autores no funciona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Tú quizás no conozcas todos los libros que se han editado, pero yo, como escritor, ¡he leído todas y cada una de las novelas de la Editorial Yae!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "#Viajer{F#a}{M#o}, haz el favor de traerme unas cuantas novelas para que pueda demostrárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "¿Qué novelas necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Tráeme las novelas que he dejado por aquí cerca. Suelo utilizarlas para recordarme a mí mismo qué cosas debo evitar al escribir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
