			"dialogs": [
				{
					"id": 191430901,
					"content": "Estaba limpiando cuando de repente oí un ruido muy fuerte afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430902,
					"content": "¡Tan pronto como salí, vi <color=#00E1FFFF>una sombra negra que desapareció por aquel árbol</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430903,
					"content": "Esta es una calle bastante concurrida, no creo que se trate de un ladrón, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aikawa Susumu"
