			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "¿Qué hacemos? ¿Hoy ya no podremos jugar a Invocación de los Sabios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Podríamos ir a otro sitio. Aunque, aparte de debajo del puente, ¿a qué otro lugar podríamos ir para que no nos descubran los adultos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "¡Ya sé! Podríamos pedirle a Yoimiya que lance algunos fuegos artificiales para asustar al tipo que se apoderó de nuestra base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Eso suena cruel. Aunque, bueno, él nos echó primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "¡Sí! ¡Es su culpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Tal vez... ¿deberíamos volver a casa y hacer los deberes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "La gente que juega todo el tiempo y nunca estudia, termina como <color=#00E1FFFF>esos adultos que se pasan el día debajo del puente</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
