			"dialogs": [
				{
					"id": 191431101,
					"content": "Quédense aquí. No se vayan a mover. ¿Entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431102
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431102,
					"content": "Entendido. No iremos a ninguna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "Sí, ya me di cuenta. Espero que no cambien de parecer una vez que hayan descansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431104,
					"content": "¡No, no! ¡No volveremos a hacerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
