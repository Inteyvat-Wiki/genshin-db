				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "¿Qué son los huevos volcánicos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Se trata de un manjar que solo se halla en nuestra región volcánica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Colocamos los huevos de pájaro sobre un orificio geotérmico para que el flogisto gaseoso lo cocine. Luego, los extraemos cuando hayan llegado a la temperatura adecuada y obtenemos unos huevos volcánicos perfectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Pero, si te pasas de tiempo y se queman, el sabor acabará siendo... bastante extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
