					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "¡Qué habilidad! Has completado el desafío como si nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Veamos... Guau, ese color oscuro y ese aroma intenso... Uf, se me ha abierto el apetito. ¡Vamos, pruébalo mientras aún está caliente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Ah, y toma también esta receta. Así, en el futuro, podrás hacer huevos volcánicos cuando te apetezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
