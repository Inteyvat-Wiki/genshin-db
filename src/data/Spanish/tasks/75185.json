					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "#Ah, eres tú, viajer{F#a}{M#o} de gran talento. ¿Qué, has probado a cocinar huevos volcánicos por tu cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Sí, ¡y es una comida muy vigorizante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "¿A que sí? Son una delicia que contiene la esencia del volcán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "¡Dicen que, si los comes a diario, te vuelves más fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Los cocí de más y casi me desmayo después de comerlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Jajaja, ¿a que es un sabor difícil de olvidar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "En realidad, no es tan horrible una vez que te acostumbras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Aún no, los probaré en otra ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "¡Muy bien! ¡Que tengas un buen viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		}
