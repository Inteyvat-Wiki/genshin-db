				"points": []
			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "¡Lo único que tienes que hacer es completar un pequeño desafío! Ve a ese orificio geotérmico de ahí, saca los huevos que hay en su interior ¡y podrás probar tal exquisito manjar recién hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518503,
