				{
					"id": 751850101,
					"content": "#¡Hola, viajer{F#a}{M#o} de tierras lejanas! ¿Has oído hablar alguna vez de la especialidad de la Comunidad de la Feracidad, los huevos volcánicos?",
					"roleType": "TALK_ROLE_NPC",
