			"dialogs": [
				{
					"id": 740920101,
					"content": "¡Arg! ¿Por qué? ¿Por qué son así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "¿Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#¡{NICKNAME}! Qué bien que estés aquí. Seguro que tú al menos sabes lo que ha ocurrido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Chronie, cálmate. ¿Qué te pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Incluso si no consigo publicar mi artículo en el periódico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "¿Cómo llevas la herida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Por cierto, ¿cuándo podremos ver tu artículo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "No lo han visto... Cierto, ustedes todavía no... lo han visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "¿Por qué estás tan nerviosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Verán... Después de abandonar el Instituto, empecé a escribir y compilar artículos a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Anotaba todo lo que veía, leía o sentía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Por ejemplo, el Instituto no se deshizo de todos los fragmentos de árjium. Al contrario, pusieron en marcha otro proyecto dedicado al estudio de este mineral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Enviaron a uno de los subordinados del Sr. Edwin a que inspeccionara las ruinas, pero acabó falleciendo durante una investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "El Sr. Raimundo, el codirector actual del centro, se negó a reconocer lo ocurrido. Y no solo eso, se empeñó en sostener que todo aquello entraba dentro de los planes del Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Pero lo cierto es que el Instituto perdió el control del gran mecanismo que escondían en las ruinas y ello provocó la contaminación de las masas de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "¡Escribí en el artículo todo lo que el Instituto pretendía ocultar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Sin embargo... cuando entregué el borrador, ¡me dijeron que el Instituto de Ciencias de Fontaine me había denunciado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Según las normas del periódico, todos los artículos que escriba sobre el Instituto a partir de ahora deberán pasar una revisión de veracidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Y han descartado mi artículo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "¿Una revisión de veracidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "No, no es eso. Lo cierto es que ese tipo de comprobaciones no están centradas en el contenido, sino en el autor de los artículos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "En otras palabras, el Instituto de Ciencias me acusó de introducir ideas subjetivas en mi artículo a raíz de un conflicto de intereses y de difundir información errónea a los lectores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "¿Y de verdad hay un conflicto de intereses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Pero si solo tomaste algunas fotos de las ruinas y de una máquina gigante que ni siquiera podía moverse... ¿Qué clase de conflicto de interés puede haber ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "¿Fue porque expusiste su falta de ética?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "... Me acusan de filtrar información sobre las nuevas variedades de fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Dicen que en las fotos que tomé en las ruinas aparecen planes de diseño de los nuevos sabores de fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Ahora tienen que comprobar cada imagen. Hasta entonces, el Instituto no retirará la denuncia y yo seguiré teniendo que pasar la revisión de veracidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "Tengo muy claro que el Instituto lo está haciendo para evitar que publique mi artículo... Pero no pienso rendirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "¡Ten! ¡Mira esto! Es un número del periódico que he impreso a escondidas. Pienso salir a repartirlos por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Haré que todo el mundo sepa la verdad y revelaré la cara oculta del Instituto. Además...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Chronie, ¿qué haces todavía aquí? Llevo buscándote un buen rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "¡Ah! Viene alguien, tengo que irme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Toma, quédate esta copia. No la pierdas, toda la verdad está ahí escrita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Chronie, las normas estipulan que tienes que presentarte cada día en la Oficina Administrativa para pasar la revisión correspondiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "¡Ah! ¡Chronie! ¡Vuelve aquí, no corras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "Solo son imágenes de fonta. ¡Quizá sea un malentendido! Solo tienes que explicarlo y ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "¡Espera! ¡Por favor, espera! ¡Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "¿El periódico piensa que tu artículo es falso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}