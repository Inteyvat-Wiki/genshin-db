			"dialogs": [
				{
					"id": 722680101,
					"content": "#Soy Uda, de los jibashiri. {F#Heroína}{M#Héroe} de Sangonomiya, sé que eres capaz de enfrentarte a este desafío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Soy el responsable de la prueba de sabiduría. Ponte en marcha y resuelve todos los acertijos para devolver las llamas del gran portal a su lugar correspondiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "Quien actúa sin sabiduría no es un valiente, ¡sino un insensato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Esperaré a que completes el desafío en la Torre de las Tres Fronteras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
