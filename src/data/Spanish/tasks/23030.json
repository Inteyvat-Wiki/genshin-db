			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Farés"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "¡Necesitamos más datos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "¿Cómo van a funcionar tus dispositivos si no introduces los datos necesarios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "No pensarás en que empecemos a trabajar solo después de haber reunido hasta el último dato, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300104,
					"content": "¿Tú crees que los pescadores se fijan en cada ola antes de lanzar las redes? Pues no, lo único que importa es que haya peces por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300105,
					"content": "Y por eso mismo nunca pescas nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "¡Ni siquiera estudiaste en la Haravatat! Deja de quejarte, tenemos trabajo que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300107,
					"content": "No podemos retrasarlo más. Si no, no podremos entregar la tesis a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300108,
					"content": "¿Por qué discuten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "#Debes ser {F#la viajera}{M#el viajero} que mencionó Yasmín. Nos has ayudado mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300111,
					"content": "#¡Encantado, viajer{F#a}{M#o}! ¡Es un placer conocerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Me llamo Farés. Soy estudiante de la Facultad Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300113,
					"content": "Me llamo Ladep, soy estudiante de la Facultad Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "#Viajer{F#a}{M#o}, queremos pedirte un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300115,
					"content": "Sabes que Yasmín ha estado rociando pociones alrededor de las raíces del Árbol Sagrado, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300116,
					"content": "Bueno, pues parece que ha habido un ligero contratiempo con las pociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300117,
					"content": "Han estado concentrándose monstruos allá donde Yasmín roció las soluciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300118,
					"content": "Te juro que no he cambiado nada en la composición. Supongo que se trata de algo que no habíamos previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "#Sí tú lo dices... En fin, viajer{F#a}{M#o}, ¿te importaría venir con nosotros a visitar las zonas afectadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300120,
					"content": "Probablemente haya un montón de monstruos y no nos atrevemos a ir solos... Necesitamos a alguien fuerte para que nos acompañe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300121,
					"content": "Además, aunque los Hongos no sean demasiado peligrosos, si nuestro tutor se entera de esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Seguro que nos rechaza el informe preliminar de la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300123,
					"content": "En la Facultad Spantamad, si los informes contienen el más mínimo error, nos echan un buen sermón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Iré con ustedes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "¿Cómo se las han arreglado para resolver el problema otras veces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Normalmente contratamos a un aventurero. O le pedimos a nuestro tutor que nos ayude a encontrar a alguien de confianza entre Los Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300127,
					"content": "El problema es que nuestro tutor no tiene mucha paciencia. Ya no nos atrevemos a pedirle ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300128,
					"content": "#¡Eres {F#la única}{M#el único} a quien le podemos pedir algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
		{
			"id": 2303002,
			"completionStepIds": [
				2303002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
