							"2303005",
							"2"
						],
						"stepId": 2303005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Farés",
					"Yasmín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*Cof, cof*. Aquí está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Puaj... Tú... ¡Tú eres quien hizo esto! ¿Por qué estás vomitando tú también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300503,
					"content": "*Cof, cof*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Pero... *Cof*...¡¿Cuántas veces tengo que explicar que lo hice precisamente para que la gente vomitara?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "No importa si estás acostumbrado o no. Si lo hueles, el cuerpo reacciona de forma adversa y sientes náuseas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "¿Por qué me molesto en repetirlo? Dudo mucho que lo entiendas. Puaj...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "#¿Eh? ¿Ladep? ¿Farés? Y tú también, viajer{F#a}{M#o}. ¿Qué están haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230300508,
					"content": "¿Acaso se ha roto el frasco y los han atacado los monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230300509,
					"content": "Sí, tiene toda la pinta de que fue eso. ¿No viste ningún monstruo por el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "No, incluso tuve tiempo suficiente para recoger algunas muestras de las plantas de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230300511,
					"content": "Qué extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "¡No tiene nada de raro! ¡Tu poción es lo que atrae a los monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300513
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300513,
					"content": "¿Qué? Pero eso no ocurrió durante los ensayos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300514
					],
					"speakerTitle": "Ladep"
				},
				{
