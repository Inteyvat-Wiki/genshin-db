			"trigger": {
				"objectNames": [
					"Ladep",
					"Farés"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "¡Mira, ahí hay una caja! Seguro que está llena de pociones. Parece que Yasmín ya ha estado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "¿Eh? Las pociones siguen cerradas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "¡No la abras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300204,
					"content": "¡Ah! Mira eso, ¡ha aparecido un montón de Hongos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "¿Qué? Pero si hace un momento no había ninguno. ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Deja de escuchar a estos quejicas. ¡{NICKNAME}, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Farés"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Menos mal que los frascos no se han roto, o estaríamos vomitando el almuerzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "¿Cómo es que no estás acostumbrado al olor si lo creaste tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300403,
					"content": "¡¿Cuántas veces tengo que explicar que lo hice precisamente para que la gente vomitara?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "No importa si estás acostumbrado o no. Si lo hueles, el cuerpo reacciona de forma adversa y sientes náuseas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "¿Por qué me molesto en repetirlo? Dudo mucho que lo entiendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "¿Y dónde está Yasmín? Ni siquiera ha rociado la poción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Seguro que ha encontrado otra planta extraña y está tomando muestras. Ya deberías estar familiarizado con las costumbres de los de la Facultad Amurta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Farés"
				},
				{
					"id": 230300408,
					"content": "#Bueno, pues ya nos encargamos nosotros del frasco. Gracias por tu ayuda, viajer{F#a}{M#o}. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Estos estudiantes de la Amurta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farés"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
