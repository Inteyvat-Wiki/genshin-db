					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "¿Qué dicen? ¿Creen que podamos vender esta piedra? Si estaba escondida entre los minerales, debe de valer algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Qi el Viejaescuela"
				},
				{
					"id": 726610702,
					"content": "¡No digas tonterías! ¿A qué le llamas “piedra”? ¿Nunca has leído un libro? Esto es un fósil, ¿entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Lin el Huidizo"
				},
				{
					"id": 726610703,
					"content": "¡Vale un montón! ¡Con solo este fósil podemos comprar media Liyue! No te vendría mal leer un libro de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Lin el Huidizo"
				},
				{
					"id": 726610704,
					"content": "¿De verdad vale tanto? Entonces, con todos los que tenemos en el campamento, ¡tendremos un ascenso meteorológico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Bazi el Patoso"
				},
				{
					"id": 726610705,
					"content": "¡Se dice meteórico! Rayos, ¡otro que no sabe leer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Lin el Huidizo"
				},
				{
					"id": 726610706,
					"content": "¡Oigan, ustedes! ¡Entréguennos el fósil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610707,
					"content": "¿Eh? ¿Quiénes son ustedes? Maldición, ¡nos descubrieron! ¡Vamos, hermanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lin el Huidizo"
				}
			]
		}
	]
}