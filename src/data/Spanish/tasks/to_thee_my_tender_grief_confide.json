			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266106",
							"2"
						],
						"stepId": 7266106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "Son solo restos de minerales. Parece que alguien se llevó lo demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610502,
					"content": "¡¿Eh?! ¿Son... los Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610503,
					"content": "¿Serán ellos quienes se llevaron lo que estaba entre los minerales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610504,
					"content": "¡Rápido, tras ellos! Paimon tiene el presentimiento de que tienen un campamento aquí cerca. ¡Sea lo que sea que estaba escondido entre esas rocas, seguramente está ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610505,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "#Tenemos que ser sigilos{F#as}{M#os}, muy sigilos{F#as}{M#os}. No queremos que nos descubran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7266106,
			"completionStepIds": [
				7266109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
