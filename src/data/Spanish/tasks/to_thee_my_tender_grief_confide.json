			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Al fin volvieron. ¿Eh? ¿Dónde está Jiawei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Sentó cabeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "¿Eh? Con que ya tiene una familia... ¡Jaja! Como era de esperarse de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Así que ese fue su deseo... Está bien, si esa es la razón, puedo comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "¿Qué hay de Nantuck? ¿Lo encontraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Escribió un éxito comercial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "¿Eh? No creí que de verdad se convertiría en un escritor. ¡Nada mal! ¿Y de qué trata su libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "¡Paimon se sabe esta! El título del libro es: «La verdad sobre el incidente del leviatán lunar, que en realidad es una tortuga marina gigante».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Guau, ¡qué título tan largo! ¿Es una novela ligera? Nada mal... Quizás yo misma compre un... ¿Eh? Un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "¿La verdad sobre el leviatán lunar? ¡¿La verdad... sobre el leviatán lunar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Ehmm... Sí. En realidad era una tortuga marina gigante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "¿Pero qué está diciendo ese Nantuck? ¿Cómo va a ser una tortuga gigante? ¿Olvidó que lo vimos con nuestros propios ojos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "#Nosotr{F#as}{M#os} tampoco queríamos creerlo, pero después encontramos un fósil de leviatán lunar en Espinadragón... Aquí tienes el libro y el fósil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "No, no puedo creerlo. No es verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Quizás no lo sepan, pero los Kujirai hemos sido una familia de pescadores por generaciones. Incluso mi padre es un pescador de renombre en toda Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Él ha pasado décadas en altamar detrás del leviatán lunar, y en una ocasión estuvo a punto de atraparlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Aunque fue en vano, no se dio por vencido. Atrapar al legendario leviatán lunar es la mayor gloria a la que un pescador puede aspirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Pero después de esa ocasión, no volvió a encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Entonces, no puedo creer en algo así tan fácilmente. ¡Por favor, tienen que ayudarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "¿Qué tienes en mente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Iré por los objetos que dejó mi padre. Durante su vida entera, dedicada a la búsqueda del leviatán lunar, dejó muchos documentos. Estoy segura de que encontraré algo en ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Dejé preparado para ustedes un entrenamiento de pesca. Cuando regrese con las noticias, volveré a pedirles su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
