				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "#Oh, eres tú, {F#joven pescadora}{M#joven pescador}. Me alegra volver a verte. ¿Qué ocurre? ¿Tienes algún problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Ven, acércate. Yo soy tu guía en esto de la pesca. Puedes preguntarme lo que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Así que se trata del leviatán lunar... No me sorprende que Kujirai sea tan insistente sobre el tema. Después de todo, su deseo era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "*Suspira*... Si supiera la verdad sobre el leviatán lunar, se decepcionaría bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "¿Cuál es la verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "En realidad, después de volver a casa seguí averiguando sobre él, hasta que di con una pista en un libro viejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Siguiendo el hilo de esa pista, descubrí algo sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "Todos mis hallazgos los escribí en mi obra. Las ventas han ido viento en popa últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Da la casualidad de que tengo un libro de cortesía que dejó la editorial. Es tuyo. En él encontrarás la verdad sobre el leviatán lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "¡Paimon también quiere leerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "«La verdad sobre el incidente del leviatán lunar, que en realidad es una tortuga marina gigante»... Un título un poco largo, ¿no crees...? ¡Un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "¿Una tortuga marina gigante? ¿El leviatán lunar es en realidad una tortuga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "Así es. El leviatán lunar no es ni más ni menos que una tortuga marina gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "Aquella noche, lo que vimos en realidad era solo una tortuga gigante cuyo caparazón estaba repleto de lucettas o alguna otra planta luminiscente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Quizás era una madre que se dirigía a la costa a desovar, y así fue como encontramos el camino a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Así que, por favor, regresen con Kujirai y compartan con ella mis palabras. No importa cuál sea la situación, la gente debe enfrentarse a la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Tal vez haya otra explicación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "#A juzgar por tu expresión, aún no estás convencid{F#a}{M#o}, pero tengo pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "En los registros antiguos describen al leviatán lunar como una criatura longeva que convivió con otros seres vivos que hace tiempo dejaron de existir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Sus antepasados habitaron en lo que hoy es Espinadragón. Incluso se pueden encontrar restos de fósiles ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "La última vez, descubrí unos cuantos en un depósito mineral al <color=#00E1FFFF>oeste del Valle Dragondurmiente</color>. Si no me creen, pueden ir a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
