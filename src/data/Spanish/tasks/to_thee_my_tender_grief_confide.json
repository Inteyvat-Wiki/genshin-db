	"talks": [
		{
			"id": 7266101,
			"completionStepIds": [
				7266101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
