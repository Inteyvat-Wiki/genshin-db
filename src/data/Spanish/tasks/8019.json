					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "¿La Orden del Abismo? ¿Estarán ellos detrás de todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190540,
					"content": "#¡Oh, no! ¡Nos han descubierto! {NICKNAME}, ¡prepárate para luchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190534,
