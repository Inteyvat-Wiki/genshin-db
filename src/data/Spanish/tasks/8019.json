					}
				]
			},
			"dialogs": [
				{
					"id": 80190501,
					"content": "¿Este es el lugar? ¿Debajo de este árbol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190502,
					"content": "Sí. Sé que no parece nada del otro mundo, pero para mí significa mucho porque me trae un montón de recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190503,
					"content": "Solíamos sentarnos bajo este árbol para charlar, admirar las nubes del cielo, sentir la brisa en la piel... Podíamos estar aquí durante horas sin darnos cuenta del tiempo que había pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190504
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190504,
					"content": "En realidad, me adoptaron los habitantes de la Aldea Vimara. Los guardabosques me encontraron en el bosque cuando era una niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190505,
					"content": "Aunque todos me trataban superbién y tenía una vida muy animada, a veces me sentía muy sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190506,
					"content": "¿Y eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190507,
					"content": "Humm, digamos que... siempre dudaba de a quién debía contarle las cosas, fueran buenas o malas, o si tan siquiera debía contarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190508,
					"content": "Todo el mundo tenía su vida y sus cosas, así que sentía que contar mis preocupaciones solo sería una molestia para los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190509,
					"content": "Puedo entenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "¿Tú también eres así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190512,
					"content": "#Antes tenía {F#un hermano}{M#una hermana} que siempre me escuchaba, pero ahora tengo a mis amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190515,
					"content": "¿De verdad? Vaya, qué envidia... Bueno, lo cierto es que para mí, él era tanto familia como un amigo que me comprendía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190516,
					"content": "Pasase lo que me pasase, podía contárselo sin reservas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190517,
					"content": "Era una persona tan sencilla y considerada... y también muy paciente. Mostraba todo su interés cada vez que hablábamos, como si lo que yo contaba fuera tan importante para él como lo era para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190518,
					"content": "Desde que desapareció, han pasado tantas cosas que quiero contarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190519,
					"content": "No, no. Esas cosas no son importantes. Lo que realmente deseo es volver a verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190520,
					"content": "Sí que se llevaban bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190521,
					"content": "¿Recuerdas si alguna vez te contó algo sobre él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190522,
					"content": "Humm, principalmente hablaba de las cosas interesantes que veía en la aldea... y también de algunas ideas suyas descabelladas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190523,
					"content": "Ah, y una vez le pregunté dónde estaban sus padres... a lo que me respondió que “ya no están aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190524,
					"content": "No quise preguntarle si eso significaba que se habían marchado de la aldea o si no estaban en este mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190525,
					"content": "Seguimos sin tener mucho de lo que partir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190526,
					"content": "Después de tanto hablar y, aun así, no he podido ser de ayuda. Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190527,
					"content": "No digas eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "La última vez que hablé tanto fue cuando aún estábamos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190530,
					"content": "Ahora que lo pienso, cuando hablábamos, siempre era a estas horas del atardecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190531,
					"content": "Recuerdo que el tiempo se me pasaba muy, muy lento. Incluso cuando parecía que habíamos hablado durante horas, el sol aún no se había puesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190532,
					"content": "#Sí, la verdad es que el tiempo pasa más lento cuando estás relajado... ¿Eh? {NICKNAME}, ¿pasa algo?",
