							2651.488
						],
						"pointId": 330400533
					}
				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "¡Hola! ¿Desean comprar algo? Hago negocios por esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190302,
					"content": "#Ah, no, no es eso. ¡Somos aventurer{F#a}{M#o}s! Katheryne nos envió aquí para investigar un encargo de la Aldea Vimara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190303,
					"content": "#Ah, eso... *Suspira*, lo cierto es que no son l{F#a}{M#o}s primer{F#a}{M#o}s. Ya hemos molestado a muchos otros aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190304,
					"content": "A decir verdad, no tenemos muchas esperanzas. Siempre que aparece alguien prometiendo que nos va a ayudar, vuelve sin haber conseguido nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190305,
					"content": "Ya nos han preguntado todo lo que se podía preguntar y hemos peinado al completo los alrededores de la aldea, pero no hemos averiguado nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190306,
					"content": "¿Pero cómo se llamaba esa persona? ¿Dónde vivía? ¿No tiene familia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190307,
					"content": "No lo sé, no lo sé y no lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190308,
					"content": "De acuerdo, de acuerdo... Paimon ya ve que están hartos de contestar preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190309,
					"content": "Ay, lo siento. No quería ser maleducado con ustedes, solo estaba respondiendo a sus tres preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190310,
					"content": "O sea, que esas preguntas no nos llevarán a ningún lado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "Aunque no tengamos mucha información que ofrecer, puedo asegurarles que lo recordamos muy bien. Como todos somos de la Aldea Vimara, tenemos muchos recuerdos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190313,
					"content": "Lo que no sabemos son los detalles. Tal vez los supiéramos antes, pero ahora nadie los recuerda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190314,
					"content": "Al menos esa es la conclusión a la que hemos llegado tras poner en común todo lo que sabíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190315,
					"content": "De acuerdo, y aparte de eso... ¿Qué tipo de persona era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190316,
					"content": "Un joven de unos veintipico años, muy buena persona y siempre dispuesto a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190317,
					"content": "Solía charlar con él cuando no tenía clientes a los que atender. Hasta lo vi cometiendo alguna imprudencia si eso era para ayudar a otros, jaja. Era un muchacho muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190318,
					"content": "¡Qué buena opinión tienes de él! En cuanto te has puesto a hablar de él, te ha cambiado la cara de preocupación que tenías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190319,
					"content": "¡Claro! Todos le tenemos mucho aprecio. Si no, no habríamos publicado un encargo en el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190320,
					"content": "Ya no hay muchos jóvenes por ahí tan auténticos y puros como él. Y pensar que desapareció un día sin más... Espero que no haya ocurrido nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190321,
					"content": "A lo mejor... ¿se mudó a otro sitio sin decírselo a nadie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190322,
					"content": "No, él no se iría sin despedirse. Y aunque así fuera, es imposible que se haya mudado sin que nadie de la Aldea Vimara lo haya visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190323,
					"content": "Humm... Está bien. ¡Gracias por la información! Seguiremos preguntando por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190311,
					"content": "¿Qué pueden contarnos del caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
		{
			"id": 801904,
