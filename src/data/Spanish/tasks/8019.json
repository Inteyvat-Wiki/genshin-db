				]
			},
			"dialogs": [
				{
					"id": 80190401,
					"content": "¿Oigo visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190402,
					"content": "¡Abuelo Amadhiah, hola! Venimos para ayudarles a buscar al joven desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190403,
					"content": "Oh, ¡muchas gracias por ayudarnos! Deben haber venido desde muy lejos... Pero con ustedes, el caso de ese muchacho está en buenas manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190404,
					"content": "¿Puede contarnos algo sobre él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190405,
					"content": "Claro, será un placer ayudarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190406,
					"content": "No veo bien, así que no puedo hablarles de cómo era, pero sí recuerdo su voz... Y ahora que no está, siento su ausencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190407,
					"content": "Aunque sus padres no vivían en la Aldea Vimara, él no parecía sentirse solo. De hecho, siempre se ofrecía a hacer compañía a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190408,
					"content": "Solía visitar a los ancianos o jugar con los huérfanos de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190409,
					"content": "Cuando alguien estaba triste, él siempre estaba ahí para escucharle y reconfortarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190410,
					"content": "Como jefe de la aldea, aún tengo que darle las gracias por todo. Al fin y al cabo, ayudar a los aldeanos necesitados es parte de mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190411,
					"content": "A Paimon no le extraña que estén tan afectados por su desaparición. ¡Era una persona superamable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190412,
					"content": "Y entonces, ¿no sabe nada sobre cómo se llamaba, dónde vivía, quién era su familia y esas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190413,
					"content": "*Suspira*, me avergüenza admitirlo, pero... por más que lo intento, no consigo recordar nada. Tal vez sea cosa de la edad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190414,
					"content": "Oh, no se preocupe, y tampoco se esfuerce en recordar. Ya se nos ocurrirá algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190415,
					"content": "#{NICKNAME}, ¿qué opinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190416,
					"content": "No parece ser un simple caso de desaparición.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "Sí, Paimon también lo piensa... Además, es rarísimo que nadie recuerde cómo se llama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190419,
					"content": "Y que nadie sepa nada sobre dónde vivía o sobre su familia... Es como si lo hubieran borrado de la realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190420,
					"content": "Yo creo que, más bien, solo existe en la memoria de los aldeanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "Humm, ¿quieres decir que no es que lo hayan borrado de la realidad, sino que directamente nunca existió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190423,
					"content": "A ver, Paimon necesita procesar eso que has dicho. Alguien que solo existe en la memoria de la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190424,
					"content": "(¿Podría ser como lo que ocurrió con la Reina Mayor Rukkhadevata? ¿Algo así como una alteración de la memoria colectiva?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "#¿Son ustedes l{F#a}{M#o}s aventurer{F#a}{M#o}s que acaban de llegar? ¿Están aquí por el encargo de la Aldea Vimara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190426,
					"content": "¡Sí! Estamos investigando el caso del joven desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190427,
					"content": "Muchas gracias por no tirar la toalla. Me preocupaba mucho que el Gremio de Aventureros cancelara el encargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190428,
					"content": "Me llamo Atosa y también vivo en la Aldea Vimara. Por favor, les ruego que sigan buscándolo. Tienen que encontrarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190429,
					"content": "Descuida, eso haremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "¡Sí, no tienes de que preocuparte! Entonces, ¿te llevabas bien con el desaparecido? ¿No tendrás alguna pista que puedas darnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190432,
					"content": "#Humm, no sé si contará como pista, pero vengan conmigo. L{F#a}{M#o}s llevaré a un sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80190430,
					"content": "Haremos todo lo que podamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "A mi parecer, es más como si solo existiera en la memoria de la gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "Hay muchas cosas que no encajan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
		{
