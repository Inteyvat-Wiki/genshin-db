					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "(Tal vez lo que acaba de contarnos Atosa sobre la hora sea la clave para resolver el misterio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "#Oye, {NICKNAME}, ¿esos Hilichurls de ahí no te parecen un poco raros?",
