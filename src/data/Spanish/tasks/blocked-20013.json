					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#Muchas gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Quería visitar los lugares a los que se aventuró Stanley, pero no pensé que a mitad del camino fuera a encontrarme con estos sujetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Es que no soy lo suficientemente fuerte... Seguramente Stanley no habría tenido problemas para tratar con un grupo como ese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "¿Por qué no te unes a mí? ¡Anímate!... Bueno, olvídalo... No puedo dejar que alguien más haga mis aventuras por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Ya me voy. Esto es para ti, he reunido muchos en el camino para complementar mis suministros de raciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "... Aunque no son exactamente raciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
	]
