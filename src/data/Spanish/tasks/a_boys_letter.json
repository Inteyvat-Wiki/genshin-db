			"dialogs": [
				{
					"id": 201020701,
					"content": "¿Y bien? ¿Le entregaste la carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020702,
					"content": "Esta es una carta de Timmie para su padre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Una carta de Timmie para su padre... Supongo que la hermana Grace te lo contó todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "No puedo enviar esta carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "¿Entonces no la vas a enviar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Por más que quiera, no hay forma de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "En fin, la guardaré conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "De acuerdo, guardaré esta carta conmigo. Vamos a pretender que se la enviamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "Estoy seguro que mi viejo amigo lo entenderá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "Gracias. Y bajo ninguna circunstancia le digas a Timmie, ¿de acuerdo? Ten, es lo mínimo que puedo darte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "Puedes quemarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "#¡Jaja! ¡Ese es el espíritu de {F#una aventurera}{M#un aventurero}, decidid{F#a}{M#o} y eficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "Pero yo no soy ningún aventurero, soy un simple cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "No puedo quemar esta carta, ni puedo abrirla. Lo único que puedo hacer es guardarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "La guardaré yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "¿Y qué piensas hacer con ella? ¿Acaso crees que mi amigo sigue vivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "... en algún lugar lejano, esperando a que alguien lo encuentre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "Yo solía pensar igual que tú, e incluso lo intenté, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "Al final, terminé por aceptar los hechos: mi mejor amigo se ha ido para siempre, y no volverá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
		},
