				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "¿Encontraste los dientes de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020602,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "¡Bien! Son suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020604,
					"content": "Pon las semillas de diente de león dentro del sobre... y ahora lo cerramos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020605,
					"content": "¡Listo! Jeje, papá se pondrá contento cuando reciba esta carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020606,
					"content": "Pero escuché que para enviar una carta se necesita de una paloma especial... Y tampoco sé el domicilio de papá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020607,
					"content": "¡Ya sé! Grace dice que Draff cría palomas mensajeras en Aguaclara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020608,
					"content": "También dice que Draff conoce a papá, así que seguramente sabe cómo enviarle la carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020609,
					"content": "¿Puedes ir a buscar a Draff en Aguaclara y pedirle que le envíe esta carta a Papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020610,
					"content": "Otra cosa, ¡no puedes leer la carta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
