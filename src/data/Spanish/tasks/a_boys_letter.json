			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "... No hay noticias de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020402,
					"content": "¿Estás dándole de comer a las palomas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "Ya les di de comer el día de hoy, y las ahuyenté antes de que vinieras a hacer un estropicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020404,
					"content": "Ahora estoy escribiendo una carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020407,
					"content": "Grace dice que si papá tiene tiempo, me mandará una carta con una paloma mensajera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020408,
					"content": "Pero todavía no ha llegado ninguna carta... Tal vez papá está muy ocupado trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Así que pensé que si él estaba ocupado, yo podría mandarle una carta con un obsequio, pero no sé qué regalarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "¡Lo tengo! ¡<color=#00E1FFFF>Dientes de león</color>! ¡Grace dice que a todos en Mondstadt les gustan los dientes de león!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "Si estás libre, ¿puedes ayudarme a recoger unos cuantos <color=#00E1FFFF>dientes de león</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020412,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#¡Gracias! No eres tan mal{F#a}{M#o} de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "¿Algo más que quieras enviar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Eso quisiera, pero si es muy pesado, la paloma no podrá volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "Además, papá trabaja muy, muy lejos. Seguramente la paloma volará por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "Escribo una carta para papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				}
			]
		},
