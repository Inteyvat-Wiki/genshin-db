				{
					"id": 750641401,
					"content": "Espera... ¿Por qué cuando el Iktomisaurio está, tú desapareces, y cuando tú estás, él desaparece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641402
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750641402,
					"content": "Acaso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641403
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750641403,
					"content": "Efectivamente, ¡se fue al baño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641404,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641405
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750641405,
					"content": "#Eh, piénsalo, no podríamos haber ido junt{F#as}{M#os} al baño, ¿verdad? ¡Sería muy incómodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641406,
					"content": "#Es verdad... Jaja, tienes razón, ¡no creo que {NICKNAME} pudiera convertirse en un saurio! Aunque no estaría nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				}
			]
		},
