			"dialogs": [
				{
					"id": 750641501,
					"content": "Escuché que alguien mencionó mi nombre. ¡No me esperaba que fueran ustedes! Jajaja, ¡qué casualidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641502
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750641502,
					"content": "¡Guau! ¡Se nos olvidó que tenías un globo aerostático! ¿Por qué no nos llevaste contigo? Qué poca amabilidad, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641503
					],
					"speakerTitle": "Paimon"
				},
