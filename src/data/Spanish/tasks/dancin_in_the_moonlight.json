			"dialogs": [
				{
					"id": 750640801,
					"content": "“Louis, ¡Louis!”... Ah, ¡me dieron un buen susto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640802,
					"content": "¿Qué tal? ¿Cambiaron de idea? ¿O solo vinieron a saludar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640803,
					"content": "Vinimos a saludar y a ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "Jaja, qué bien. ¡Pues manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640806,
					"content": "Solo estamos de paso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
					"id": 750640807,
					"content": "De acuerdo, ¡mucha suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				}
			]
