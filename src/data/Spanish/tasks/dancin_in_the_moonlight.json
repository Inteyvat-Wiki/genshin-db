			"dialogs": [
				{
					"id": 750640412,
					"content": "¡Tachán! Miren, ¡un milagro de las luces y las sombras! ¡El último logro industrial de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640413,
					"content": "#¡Esto ya no es nada nuevo para nosotr{F#as}{M#os}! Y aún no has dicho en qué quieres que te ayudemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Ve directo al grano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Por lo que parece, ¿quiere que le ayudemos a tomar imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "Ah... claro. Tomen, aquí tienen la fianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640419,
					"content": "¡¡Cuánto Mora!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "¡¡Gruaaa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Como ven, necesito tomar unas imágenes a los saurios locales, y no me refiero a esas típicas imágenes de una enciclopedia de animales... ¡lo que quiero son imágenes con más vitalidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640422,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "#Solo que... Las cosas con vitalidad no son tan obedientes. Como ustedes son aventurer{F#as}{M#os}, tal vez lograrían tomar esas imágenes ideales que quiero. Si es que tienen disponibilidad, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640424,
					"content": "¡C-claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "Aunque bueno, si lo que pido sobrepasa sus capacidades, tampoco tienen que forzarse, pero creo que al menos serán capaces de protegerme de los monstruos de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640426,
					"content": "Así que, pueden quedarse con la fianza sin ningún compromiso. Y sobre si deciden ayudarme o no, ¡les dejo la decisión a ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640427,
					"content": "¡Guau! Tanto dinero debe de pesar lo suyo... ¿Seguro que nos lo podemos quedar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "¡Pues claro! ¡Pueden fiarse de lo que les digo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640429,
					"content": "#¡Jaja! ¡Pues has buscado a l{F#as}{M#os} indicad{F#as}{M#os}! ¡Paimon es la domasaurios más famosa de toda Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#¡No hay problema, cuenta con nosotr{F#as}{M#os}! Con {NICKNAME} y Paimon aquí, sea cual sea el saurio que buscas, ¡te lo domamos en segundos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "¿Un Tepetlisaurio? ¡Pan comido! ¿Un Qucusaurio? ¡Facilísimo! ¿Un Iktomisaurio? ¡Controladísimo! Y qué más... Eh, también podemos con los Koholasaurios, Yumkasaurios, Tatankasaurios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "¿Tatankasaurios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "Paimon va a contar de nuevo... El saurio cabezota, el saurio de manos chiquitas, el saurio de ojos grandes, el saurio aterrador, el saurio súperaterrador, el saurio que no da tanto miedo, el saurio raro, el saurio corriente, el saurio delgado, el saurio gordete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "¡Grrm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "¡¿De qué me estás hablando?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "Aún queda... ¡El saurio que aúlla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "¡Arruuu! ¡Arruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "¡Y el saurio que chilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "¡Grraaa! ¡Grr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "#En resumen, ¡seguro que podemos con todos! Confía en Paimon, ¡somos maestr{F#as}{M#os} domasaurios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "¡Grrm, grrm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "*Suspira*... Te ayudaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Ya que nos quedamos con una fianza tan generosa, ¡está claro que te vamos a ayudar! ¿A que sí, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640447,
					"content": "Lo siento, ahora no tengo tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Pero ya tomamos la fianza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Jaja, no pasa nada, pueden venir cuando tengan tiempo, ¡tampoco es que necesite sí o sí unos ayudantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640437,
					"content": "Para el carro, ¡escucha bien lo que estás diciendo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Espera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Páganos y te ayudaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Sin Mora, no hay trato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
