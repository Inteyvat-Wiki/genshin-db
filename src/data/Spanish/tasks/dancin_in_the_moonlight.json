			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Jaja, ¡muy bien! Bueno, ahora nuestro pequeño modelo solo tiene que quedarse quieto... ¡Estupendo! Tres, dos, uno, ¡*clic*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640602,
					"content": "¡Miren! ¡Es toda una obra maestra! ¿Y quién la hizo? ¡Yo! ¿Quién tomó la imagen? ¡Magnífico Magnífiquez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640603,
					"content": "Gracias, ¡mil gracias! ¡Jaja! Aquí tienen la parte de la recompensa que quedaba por pagar. Ah, y esto, miren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640604,
					"content": "¡Guau! ¡Más Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "¿Eh? ¿Solo es un Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Muy bien, ¡ahora es el turno de nuestro protagonista! ¡No seas tímido! ¡Sal a la escena como una celebridad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640607,
					"content": "Uff... ¡Trabajo terminado! Les regalo esta copia, ¡han conseguido esta obra maestra antes que cualquier galería de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640608,
					"content": "Gracias, la apreciaremos mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Pero... la parte que quedaba por pagar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "A continuación iré a este sitio... Deja que te lo señale en el mapa. Jeje, quién sabe, ¡quizás nuestros caminos se vuelvan a cruzar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640614,
					"content": "Y si eso ocurriera, ¡es muy probable que tenga que pedirles ayuda de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640615,
					"content": "¡Oye! ¡No lo des por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Jaja, tampoco es algo que pueda decidir yo, ¡el que decide es el destino! ¡El destino nos unió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640617,
					"content": "Adiós, amigos, ¡que les vaya todo bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnífico"
				},
				{
					"id": 750640618,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnífico recoge su equipaje y se sube al globo aerostático en un abrir y cerrar de ojos.\\nObservan cómo el globo se agita fuertemente durante unos segundos, provocando las carcajadas de Magnífico. Poco después, recupera la estabilidad y se aleja hacia el horizonte.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "No parece que tenga mucho valor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "¿Grr? Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Sí, qué decepción... Paimon pensaba que la parte final iba a ser más que la fianza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
