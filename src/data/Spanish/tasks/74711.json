			"dialogs": [
				{
					"id": 747110101,
					"content": "¡Ajá! Todo va sobre ruedas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Estoy convencida de que nuestra búsqueda de una cura está entrando en la etapa final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Pero además de encontrar a unos cuantos pacientes acuáticos más para completar la lista, tengo otra petición, un poco más particular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Necesito que localicen algunos mecanismos submarinos clave en las aguas afectadas y recuperen los datos registrados por sus sensores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "¿Para analizar los datos y encontrar patrones relevantes?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "¡Exacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "¡También deberíamos hablar con los dueños de los barcos y los buzos para asegurarnos de que hayan aprendido la lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Eso es, sin mencionar a los pescadores y turistas... Cualquiera que atraviese la superficie del mar en barco y aquellos que buceen bajo el agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Quienes tengan contacto con nuestras aguas deben ser conscientes de ello. No pueden andar tirando cosas al mar y destruyendo los hábitats marinos como si nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "De lo contrario, podrían aparecer peces muy agresivos que intentarán derribar sus embarcaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "¿Para que no vuelva a pasar algo así en el futuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
}