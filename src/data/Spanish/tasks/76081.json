				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Ha luchado bien, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Puede quedarse tranquilo. Después de que usted y sus compañeros cayeran, el viejo Nikita se convirtió en el nuevo starshiná y lideró a aquellos que salvaron para reconstruir la orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Hoy, somos lo suficientemente fuertes como para proteger esta tierra incluso bajo la sombra de la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Su sacrificio no fue en vano. Sus hazañas y su voluntad vivirán para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Adiós, Sr. Sigurd. Vendré a visitarlo de cuando en cuando. Espero que finalmente pueda alcanzar la paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
