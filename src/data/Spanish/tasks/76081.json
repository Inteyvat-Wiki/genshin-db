			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Esa forma de dar muerte a los monstruos... No, ese personaje de leyenda se sacrificó hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "¿Sería posible que hubiera despertado de alguna forma? Si tenemos tiempo, podríamos ir a la playa del noreste de los Páramos Musgóseos. Su tumba se encuentra allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "El viejo me contó una vez historias sobre el legendario starshiná Sigurd, con quien luchó codo con codo hace años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Su espada púrpura, su cabello dorado... es exactamente como lo describían las historias. Esa persona a la que he estado viendo estos últimos días... ¿podría tratarse de él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Su lugar de descanso se encuentra en una playa al noreste de los Páramos Musgóseos. Si tengo tiempo en algún momento, debería ir allí a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}