					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Ha sido un placer combatir contra ti, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Es una verdadera pena que un héroe haya acabado así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Vagar en solitario por esta tierra por la que te sacrificaste... Cuando respondiste al juramento de los Lampareros, ¿imaginaste que llegaría este día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Incluso de ser así, tal vez ni siquiera habrías vacilado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Volveré a visitarte en el futuro. Hasta la próxima, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
