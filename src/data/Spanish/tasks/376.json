					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "Sr. Diluc, estas son las cuentas de la semana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "El desastre afectó gravemente al negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Esperemos que acabe pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Saludos, quisiéramos sentarnos... en su mesa más discreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "En el segundo piso hay menos clientes. Levantarán menos sospechas ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Pero ¿no eres un bardo? ¿Por qué no te sientas en el centro y cantas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "¡Jaja! Dejemos la función para la próxima. Por ahora, subiremos. ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Échales un ojo. Ese bardo parece muy sospechoso. Iré a preguntar sobre él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "Um... ¿Preguntarle a quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "A los “protectores” de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
