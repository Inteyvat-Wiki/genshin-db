			"dialogs": [
				{
					"id": 741860301,
					"content": "Sr. Casiodoro... Sr. Casiodoro... ¿es usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741860303,
					"content": "¡Es usted! Por fin ha regresado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860304,
					"content": "Sé que me ordenaron defender este baluarte, pero los ataques de esos cruentos Dragartos y de los bárbaros eran tan potentes que no tuve más remedio que retirarme hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860305,
					"content": "No sé cuántos años han pasado desde entonces... ¿Cómo va todo ahí fuera? ¿Vencimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741860307,
					"content": "Vaya. Así que perdimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860308,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741860309,
					"content": "Oh, no diga eso, honorable Casiodoro. Cuando me alisté a la legión de nuestro sebasto, sabía que este día podría llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860310,
					"content": "Nuestro sebasto dijo que nos lideraría para destruir las cadenas de la Fortuna, pero imagino que no podía ser tan sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860311,
					"content": "Después de todo, nos enfrentamos al destino, algo que ni siquiera pueden contradecir los mismísimos dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860312,
					"content": "Al final, todos nuestros esfuerzos fueron en vano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741860313,
					"content": "No, señor, no es así. Alzamos nuestras espadas contra el destino divino y creamos una causa que desafiaba a las leyes del cielo. Resistimos valientemente contra la profecía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860314,
					"content": "Y aunque al final nos derrotaron... estoy seguro de que fue porque alguien nos traicionó y nos llevó por el mal camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860315,
					"content": "Pero el resultado ya no importa, pues después de todo, pasaremos a los anales de la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Gólem sin nombre"
				},
				{
					"id": 741860316,
					"content": "¿Eh? ¿Por qué se ha caído así? ¿La gente de piedra también puede... desmayarse de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "No llegó a decirme cómo se llamaba... Parece que su historia ha terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741860318,
					"content": "Pobre hombre... ¿Ha estado aquí luchando durante miles de años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Sí. Por fin puede descansar en paz. Sigamos avanzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osifuz"
				}
			]
		}
	]
}