			"dialogs": [
				{
					"id": 401450101,
					"content": "Tras cierto periodo de prueba, la tienda de alquimia se ha vuelto muy popular...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "Uf, cada vez llegan más clientes. A Paimon le va a dar algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "El negocio va viento en popa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Con tantos pedidos, es normal que estemos hasta arriba de trabajo si solo somos dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Tal vez deberíamos buscar nuevos ayudantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "#¿Están tomándose un descanso, querid{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Acabo de revisar los datos de las ventas recientes. ¡Tienen un talento natural para los negocios! ¡Han vendido montones de pociones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "¡Por fin vienes, Lisa! Justo estábamos discutiendo la posibilidad de buscar un ayudante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "¿Eh? No dan abasto ahora que hay más pedidos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Sí. Paimon no esperaba que vinieran tantos clientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Jeje, no puedo decir que me sorprenda este resultado. Yo sí que sabía que tendríamos éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "En realidad, mientras ustedes se encargaban de abrir el negocio, Freda y yo ya estábamos discutiendo sobre cómo mejorar la eficiencia de la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "He estado observando cómo se desenvuelven, y he visto que aún les queda mucho margen de mejora tanto con las técnicas de alquimia como con el cultivo de ingredientes y el proceso de venta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "¡Guau! ¿Nos has estado observando todo este tiempo en secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Y Paimon que pensaba que estabas vagueando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "¿Qué están diciendo? En los momentos importantes, ¡soy alguien muy confiable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Bueno, y eso que decías de mejorar la eficiencia... ¿Cómo pensabas hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Bueno, ya he estado discutiendo con Freda sobre el plan de mejora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Si quieren saber más sobre ello, pueden ir a hablar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "¡La tienda es muy popular!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
