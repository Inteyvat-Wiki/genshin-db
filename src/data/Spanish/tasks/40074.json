			"dialogs": [
				{
					"id": 400741101,
					"content": "¡Todo el mundo, por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741102,
					"content": "¿Están todos despiertos? Mona dice que tiene un anuncio importante que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741103,
					"content": "El primer rayo del alba después del retorno del Reino de la Noche Eterna es reconfortante para el espíritu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741104,
					"content": "Lo que la señorita quiso decir es que está lista para el siguiente desafío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741105,
					"content": "#¡Nosotr{F#as}{M#os} también estamos list{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741106,
					"content": "Muy bien. Entonces iré directa al grano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741107,
					"content": "En mi artilugio de adivinación he visto que una nueva ilusión se materializó en la isla de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741108,
					"content": "Tengo el presentimiento de que esta vez se trata de mi ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741109,
					"content": "Así que esta vez es el turno de Mona. Nos has acompañado anteriormente en varias de nuestras ilusiones, ¡así que ahora es nuestro turno de acompañarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741110,
					"content": "Bueno... No hay gran cosa que ver, en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741111,
					"content": "Srta. Megistus, ¿acaso le da vergüenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741112,
					"content": "¡No, para nada! Jaja... No es que me preocupe que me juzguen por ver una ilusión tan patética o algo por el estilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741113,
					"content": "No suenas muy convencida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741114,
					"content": "Pues... *Ejem*, la gente considera a los astrólogos como algo fuera de este mundo, ¿verdad? Me preocupa que mi ilusión no sea así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741115,
					"content": "No temas. Tu Princesa no es tan ingenua como para tener expectativas sobre el aspecto que tu ilusión debiera mostrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741116,
					"content": "¡Ni yo! No es que no espere grandes cosas de ti, Mona, pero sé que eres una persona increíble. No tienes por qué intentar estar a la altura de las expectativas de otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741117,
					"content": "Estoy seguro de que tu ilusión será fiel a tu corazón, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741118,
					"content": "Y además, no es que vayamos para admirar el paisaje. También hay otras razones, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741119,
					"content": "Supongo que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "¿En serio? De acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741122,
					"content": "Siempre y cuando no esperen mucho de mi ilusión, me siento tranquila. En fin, andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741120,
					"content": "Quizás encontremos alguna pista sobre lo que ocurre en estas islas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
			"id": 4007412,
