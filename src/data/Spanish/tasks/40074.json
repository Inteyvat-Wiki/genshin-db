			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oz",
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "Srta. Megistus... esto es descorazonador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Ay... No intenten consolarme, solo hacen que me dé más vergüenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "¡El silencio dice más que las palabras! ¿Necesitas un abrazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "¡De eso nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "Eso es lo que pensaba cuando empecé a practicar astrología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "Pero he madurado, y ya no me dejo llevar por la opinión de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "¡Quién lo diría! Ni siquiera Megistus, la Archimaga de la Corte, estaba preparada para momentos tan angustiantes en su profesión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "Debe de ser duro no ser comprendida. Me alegro de que lo hayas superado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "De hecho, mucha gente acaba renunciando a la astrología debido a circunstancias similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "Pero yo soy un prodigio, así que es de esperar que pueda lograr lo que pocos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "¡Qué palabras tan inspiradoras en un lugar tan increíble como este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "¡Mona, eres genial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Bien, bien, no paren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "*Ejem*, perdonen la interrupción, pero la puerta está por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Bien, ya habrá tiempo para sus elogios cuando resolvamos el misterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "Sabía que eras una genio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
}