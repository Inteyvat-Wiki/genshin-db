					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "Parece que los alrededores cambiaron. Esta no es la playa que dejamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740902,
					"content": "Esas montañas se parecen a las de Mondstadt. Un momento, ¿acaso volvimos a Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740903,
					"content": "Pero seguimos rodeados por un vasto mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740904,
					"content": "Por aquí debería haber otro estanque como el de antes por el cual entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740905,
					"content": "¡Por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740906,
					"content": "¿Eh? ¿Por qué no nos deja entrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740907,
					"content": "Parece que algo está flotando en el agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740908,
					"content": "Es... ¿una pintura? O tal vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740909,
					"content": "Tal vez señala a una ubicación determinada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740910,
					"content": "Está anticipando que la Princesa guiará a sus leales seguidores a la ubicación designada por el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740911,
					"content": "¿Por qué siempre tienes que ser tú la líder...? *Suspira*, da igual. Encontremos la ubicación primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
