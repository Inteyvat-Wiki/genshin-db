					"content": "¡Aaah! ¡Me has encontrado muy pronto! Justo estaba pensando en cambiar de escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "Verut"
				},
				{
