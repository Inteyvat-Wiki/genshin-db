	"talks": [
		{
			"id": 2400401,
			"completionStepIds": [
				2400401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
