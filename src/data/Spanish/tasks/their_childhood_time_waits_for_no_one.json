			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "¿Eh? Me has encontrado... ¿Quién eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "#Soy amig{F#a}{M#o} de Aurèle y Verut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#Ah, sí, les he oído hablar de ti. Verut dice que eres muy buen{F#a}{M#o} jugando a esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "Bueno, yo misma he sido testigo de ello, ¿no? No se te da nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Me rindo, iré a reunirme con los otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
