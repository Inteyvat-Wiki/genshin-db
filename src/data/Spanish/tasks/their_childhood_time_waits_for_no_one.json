			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Hermanito, ¡vamos a escondernos aquí! ¡Este sitio es mucho mejor que el que ha elegido ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "¡Verut, vuelve aquí! Si te pierdes, no podré encontrarte tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040103,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "¡Holaaa! ¿Tienes tiempo otra vez? Vamos, tú te esconderás con nosotros. Lovi probablemente ya haya encontrado un escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Háblame de Lovi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "No hay tiempo para eso. ¡Vamos, vamos! Lovi conoce este sitio como la palma de su mano. ¡Tenemos que encontrar un escondite mejor que el suyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut se marcha a toda prisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*Suspira*, me pregunto cuándo empezará Verut a hacer caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040110,
					"content": "Sintiéndolo mucho, me gustaría pedirte que nos acompañes otra vez. Por algún motivo, Verut está muy emocionado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040111,
					"content": "Probablemente porque ahora tiene una nueva amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Sí, eso estaba pensando yo también. Además, lo importante es que esté contento, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040113,
					"content": "Solo espero que no se emocione demasiado y se esconda con Lovi en algún sitio extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040118,
					"content": "Así que ¿te importaría jugar con nosotros otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040119,
					"content": "Yo también me esconderé esta vez, no quiero que Verut se enfade. No sabría qué hacer si se pone a llorar en mitad de la calle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040120,
					"content": "Aurèle se marcha...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Háblame de Lovi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Una chica que acabamos de conocer. Nos vio jugando al escondite y dijo que quería unirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040116,
					"content": "Se parece mucho a Verut, así que se llevan divinamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040117,
					"content": "Además, su padre tampoco tiene mucho tiempo para hacerle compañía, así que supongo que estamos en las mismas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040104,
					"content": "¿Siguen jugando al escondite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
			"completionStepIds": [
				2400402
