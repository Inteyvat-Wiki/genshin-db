			},
			"dialogs": [
				{
					"id": 240040501,
					"content": "¿Eh? ¿Por qué me miran así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040502,
					"content": "Simplemente te escondiste en algún sitio a leer, ¿verdad? ¡No te tomas el juego en serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "¡Eso! ¡Hay que tomárselo más en serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Bueno, es que ustedes ya se quedaron con los mejores escondites. Además, esto no es lo mío... Yo solo quiero sentarme un rato a leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040505,
					"content": "¡Bah! ¡Eres un mentiroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "¡Buuuu! ¡Eres un ratón de biblioteca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "¿Por qué no me dejan en paz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040508,
					"content": "Sí, déjenlo tranquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Jeje, Lovi es buenísima jugando al escondite. Se sabe un montón de escondites geniales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Jeje, estando Lovi aquí para jugar, ¡este lugar no está nada mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Pues Verut trepa paredes a la velocidad de la luz y es superfuerte. Yo nunca podría llegar a esos sitios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "¡Si vamos juntos, seguro que nadie puede encontrarnos aparte de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Bueno, creo que es suficiente por hoy. Te acompañaremos a casa, Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040514,
					"content": "¿Y después? Lo que quieres es hacerle mil preguntas a mi padre, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040515,
					"content": "B-bueno, es que me han surgido un par de dudas que me gustaría consultar con él...",
