			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "... Creo que ya he leído esta página.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040202,
					"content": "¿Estás leyendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Pues sí que has tardado poco. Justo acabo de sacar el libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040205,
					"content": "El padre de Lovi le dijo que me diera este libro y que podría preguntarle todo lo que no entendiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040206,
					"content": "El problema es... que no entiendo nada de lo que dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040207,
					"content": "Bueno, nos vemos donde antes. Me has encontrado, así que el juego se ha acabado para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040203,
					"content": "Te gusta mucho estudiar, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
