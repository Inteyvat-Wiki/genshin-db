			"dialogs": [
				{
					"id": 741360601,
					"content": "Hay un vacío inmenso, aquí dentro no hay nada. No habremos venido en vano, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "Las plantas de por aquí se han despejado a propósito y, a juzgar por las marcas, las han podado hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "Y yo atravesando todo este caos solo por él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "En fin, iré primero para echar un vistazo. Quédense con la señorita investigadora. Y si la situación se pone peligrosa... llévensela lejos, enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Aunque lo cierto es que aquí no hay nada. Por muy peligrosa que se ponga la situación, no debería empeorar demasiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "*Chirrido*... *Crac, crac*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "¡Ah! ¡Cuidado ahí! ¡Se acerca algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
