			"dialogs": [
				{
					"id": 741360901,
					"content": "#¡Lacay{F#as}{M#os} del Instituto! ¿Cuánto les pagaron Choiseul y Raimundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Solo me dieron un título.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Mira... escucha, déjame en paz. Estoy a punto de completar mi Generador de Campo Experimental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Si consigo vincular el núcleo cinético con el generador, pues... ¡Me convertiré en el mayor ingeniero cinético de la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "Te aprovechas de los logros de otra persona y aún te atreves a declararte el mejor ingeniero de la historia. Qué poca vergüenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Por fin me doy cuenta de por qué Ed... el Sr. Edwin nunca te ha querido dejar participar en la investigación del núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "¡Él no tiene ni idea de lo útil que es! Tú también eres del Instituto de Ciencias... Debes de saber el valor que tiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Ayúdame. Puedo... desarrollarlo contigo, y llegado el momento, ¡no habrá nadie más famoso que nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Ni Edwin, ni Raimundo, ni Choiseul... ¡Nadie podrá superarnos nunca más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Parece que lo que dijo Raimundo era cierto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Los resultados de la investigación de... del Sr. Edwin pertenecen al Instituto de Ciencias. Solo vine a recuperarlos, lo demás no me interesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Fusilier ahora le está llamando como el Sr. Edwin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "¡No digas estupideces! Muchacha, ¡¿no te das cuenta de lo mucho que nos puede ofrecer el Sr. Concini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "¡Son cosas que no conseguiríamos ni estando al servicio de Edwin durante siglos! Edwin y el Instituto de Ciencias están intentando utilizarnos, ¡y tenemos que pensar por nosotros mismos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Bien, se acabaron las sandeces. Tú, cierra el pico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "¡¿Y tú quién eres?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Soy el que guarda y encargado de cuidar el Puerto Lumidulce. Si dices una sola palabra más, te propinaré un puñetazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, ayúdame a atarlo y llévate ese núcleo o como se llame. Tenemos que regresar para informar de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Seguro que te costó demasiado guardarte todo eso para ti solito, Nacker...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Ni un centavo, hago esto porque quiero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
