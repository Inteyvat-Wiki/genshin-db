			"dialogs": [
				{
					"id": 741360401,
					"content": "Entonces el motivo por el que no dejaba de repetir “cinco” era para decirnos cómo resolver el acertijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "¿Y por qué no nos lo dijo directamente? ¿Por qué complicarlo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Hum, a saber qué estaba tramando... Aunque parece que nos ha estado conduciendo hacia Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Esos trajes de buceo, ahí, junto a esa habitación, parece que los prepararon especialmente para nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Parece que es él quien nos encontró.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "No tiene ningún valor de investigación... a pesar de todo el empeño que le puse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fusilier lleva todo el camino murmurando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#{NICKNAME}, ¿tienes la sensación de que te están vigilando? Paimon no se siente bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "Yo iré el primero para que podamos seguir avanzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "En cualquier caso, debemos ocuparnos de Nacker primero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
