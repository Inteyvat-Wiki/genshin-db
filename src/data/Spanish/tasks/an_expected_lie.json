			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... ¡lo sabía! Fuiste tú quien los atrajiste hasta aquí... ¡Estás celoso de mí! ¡Tienes miedo de que mis investigaciones sean mejores que las tuyas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Sí, claro, tengo envidia de tu perspectiva ignorante y bobalicona... No me extraña que vivieses tan a gusto en el Instituto de Ciencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Si Choiseul viera esta escena, seguro que se desmayaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Sería mejor que no se despertase.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Simplemente acompáñalos al Instituto de Ciencias y discúlpate. Yo volveré a mis investigaciones... No habrás estropeado mi equipamiento de investigación, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "¿Quién te dijo que puedes volver a tus investigaciones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "¿Qué van a hacer? ¿Van a llevarme de vuelta al Instituto de Ciencias? ¿Y cómo sigo con mis investigaciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Ese idiota de Raimundo debe de haber puesto el Instituto de Ciencias patas arriba, y luego está Choiseul... Arg, solo de pensar en ello me duele la cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "¡Eres tú quien puso el Instituto de Ciencias patas arriba! ¡No culpes a los demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "¿Yo? Ah, claro. El Instituto de Ciencias ahora me culpa por la explosión en el Laboratorio Central, ¿no es así? ¡Ni siquiera me encontraba en el Instituto de Ciencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Hay tanto insensato en el Instituto de Ciencias que incluso con solo servirse un café podrían echar al traste todo el equipamiento de investigación, así que no me sorprende que causaran una explosión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "¿Por qué no te explicas, entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "¿Explicarme? Lo que no voy a hacer es ser su chivo expiatorio. Tengo mucho que investigar y no tengo tiempo que perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "¿Por eso comenzaste a tratar con ese hombre, Concini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Bueno, Concini no es mucho mejor... Ni siquiera es capaz de comprar instrumentos de precisión, debo fabricarlos yo todos. Por suerte, está dispuesto a poner dinero, así que mis investigaciones avanzan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Pero, para mi sorpresa, nuestro estimado Nacker apareció con ese prototipo de núcleo que ni siquiera funcionaba bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "¡Pero lo remodelé! ¡Usé una tecnología que tú jamás podrías haber desarrollado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Jajaja, Nacker, ya no puedes ganarte el favor de Concini, así que no te mientas a ti mismo. ¿Es que no te queda ni una pizca de orgullo como científico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "¡Bobadas! Dices que no funciona bien, pero eso es solo porque no sabes cómo arreglar el aparato. ¡Yo sí que sé hacerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Sí, bueno, pues toma esta chatarra, regresa al Instituto de Ciencias y sigue jugando con ella. Yo tengo cosas más importantes que hacer. Toma, Fusilli, o como te llames... Para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "¿Y ahora por qué se han puesto a discutir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "Basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "¿Qué haces? ¿Quieres dejar de malgastar mi tiempo? ¡Tengo que volver al trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "¡Dije que basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "¡Edwin Eastinghouse! ¡Tú eres el culpable de la explosión en el Instituto de Ciencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "¡Nacker! ¡Tú eres quien robó los activos del Instituto de Ciencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Y quien provocó una nueva explosión allí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Ustedes dos causaron un gran perjuicio al Instituto... Como investigadora especial del Instituto de Ciencias de Fontaine, ¡he de escoltarlos de vuelta para que aguarden medidas disciplinarias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Maldición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Nooo, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Lemarcq y yo escoltaremos a estos dos. Esto nos llevó mucho trabajo... el Instituto de Ciencias debería ofrecernos alguna remuneración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Recuerden mantener la boca cerrada en el camino. De lo contrario, el final les llegará antes de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "¡Quieto ahí! ¡No te muevas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Yo estoy a punto de desmayarme también...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
