			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "¿Qué hacen...? Ves, sabía que no le encontrarían aunque se recorrieran la zona cinco veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Si les apetece pueden quedarse a beber un poco de té. Acabo de comprar cinco tazas... y varios cuencos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Parece que el número cinco le apasiona, Sr. Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Oh, se trata de un número mágico. Si se usa correctamente, puede abrir las puertas de la inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Por cierto, en total hay cinco puertas de la inspiración, así que como mínimo tendrás que girar cinco pomos... ¡Cinco! ¿Lo sabes? ¡Cinco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Discúlpeme, pero ahora lo que me apetece es darle cinco puñetazos. Le ruego que cierre la boca, ¿estamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
