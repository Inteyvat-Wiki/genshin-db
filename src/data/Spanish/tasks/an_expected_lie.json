			"dialogs": [
				{
					"id": 741361101,
					"content": "#Srta. Fusilier y {NICKNAME}, ¡están de vuelta! Seguro que ya todo está resuelto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "¡Ay! ¡Que Choiseul se nos desmaya de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "No esperaba que estuvieses de vuelta en el Instituto de Ciencias, Choiseul. Pensaba que te pasarías el resto de tu vida entre sellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "¡N-no puede ser! ¡Por Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimundo, ¿qué se siente al ocupar mi trabajo? ¿Alguna novedad que debas notificarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "Qué reencuentro más entrañable, Sr. Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361108,
					"content": "¡Ja! Mira a tu alrededor. Sí que se te dan bien las tareas de limpieza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "Hum, tampoco se le da tan bien limpiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Porque no te barrió a ti cuando debíó haberlo hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Muchas gracias por traer a estos dos de vuelta, {F#investigadora}{M#investigador} sénior honorífic{F#a}{M#o} {NICKNAME} y Srta. Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361112,
					"content": "El infortunio y la desgracia que han plagado el Instituto de Ciencias de Fontaine terminarán por completo hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361113,
					"content": "Jajaja, muy bien, el Instituto de Ciencias de Fontaine se quedará sumido en un mortal silencio y la inspiración no volverá a surgir jamás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Ya aprovechaste lo suficiente los golpes de inspiración del Instituto. Es hora de que las cosas se calmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361115,
					"content": "Raimundo Havenport, no sabes lo suficiente sobre investigación para dirigir el Instituto de Investigación Científica e Ingeniería de Energía Cinética de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Pero sí sé cómo trabajar de forma correcta y apropiada en este Instituto, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361117,
					"content": "Lo que necesitas ahora es mantenerte alejado de la investigación y del árjium. Eso será lo mejor para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361118,
					"content": "Un tiempo después, los agentes de la Oficina Judicial llegan y se llevan a Nacker y Edwin. Afortunadamente, al fin están completamente fuera del Instituto de Ciencias de Fontaine...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Gracias a los Arcontes, por fin he conseguido despertar de mi pesadilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Son Chaussivert y Lemarcq, ¿cierto? Escuché mencionar lo mucho que han ayudado en el trabajo de nuestro Instituto. Estamos preparando unas recompensas de agradecimiento adecuadas. Descansen aquí un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Jajaja, nunca llegué a pensar que alguien como yo pudiese verse involucrado con el Instituto de Ciencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "¿Por qué dices eso? ¡Mi buen señor, eres sincero, afable y buena persona! Quizás incluso vuelva a recurrir a tu ayuda en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "#Y tú, {F#investigadora}{M#investigador} sénior honorífic{F#a}{M#o}, volviste a hacer un gran favor al Instituto de Ciencias. ¿Cómo tenemos que agradecértelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Procuren no provocar más explosiones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Oye, hablando de eso... ¿Dónde está Fusilier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "Dejemos a esta jovencita que se calme un poco. Parece que la imagen honorable que tenía de Edwin Eastinghouse se hizo pedazos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361130,
					"content": "Edwin y Nacker también tendrán que calmarse... Espero que pronto se den cuenta de lo que hicieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361131,
					"content": "¿Pasarán el resto de sus vidas en el Fuerte Merópide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Por todo el peligro que podrían causar, espero que nunca salgan de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361133,
					"content": "Sin embargo, en lo que respecta ahora al Instituto de Ciencias de Fontaine... *Suspira*, espero no enfrentarme nunca a una situación en la que tenga que recurrir a estos dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361134,
					"content": "#Reitero mi agradecimiento en nombre del Instituto de Ciencias de Fontaine, {F#investigadora}{M#investigador} sénior honorífic{F#a}{M#o}. Si quieres plantearme alguna otra pregunta, aquí estaré para responderl{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimundo"
				},
				{
					"id": 741361125,
					"content": "¿Quizás podrían darme un título más alto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Bueno, en teoría su título actual ya es el máximo... Pero podría intentar solicitar un título especial para usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "#Por ejemplo... ¿{F#investigadora}{M#investigador} sénior honorífic{F#a}{M#o} de primacía? ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
