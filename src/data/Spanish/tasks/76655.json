			"dialogs": [
				{
					"id": 766550101,
					"content": "¡Flins, llegaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Por supuesto. Después de todo, tenía que darles las gracias. El faro está mucho mejor ahora que hay alguien dándole el mantenimiento que necesita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Jeje, no fue nada. El problema es que, por mucho mantenimiento que le demos, este lugar sigue estando oscuro y sigue habiendo sitios a los que no llega su luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Sí. A diferencia de lo que ocurre fuera de este cementerio, es como si el tiempo aquí se hubiera congelado justo en el momento en el que acabó la batalla de aquella noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Yo no tenía intención de cambiar el entorno, pero ustedes han hecho que el tiempo avance al encender el faro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "¿Afectará esto a tu vida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Si quieres saber si me causará algún inconveniente, la respuesta es negativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "La vida es un ciclo. Aun sin nosotros, los fantasmas que deambulan por aquí se habrían terminado desvaneciendo y habrían vuelto a las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Así que no te preocupes por que la luz de este faro no llegue a todos los rincones de la isla. A medida que desaparezcan los fantasmas, también lo hará la bruma que envuelve este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "El sol siempre acaba saliendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Lo siento, todo fue tan inesperado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Oh, no es necesario que te disculpes. No me disgustan este tipo de cambios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
