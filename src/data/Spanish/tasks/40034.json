				},
				{
					"id": 400340602,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340603,
					"content": "Eh... es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340604,
					"content": "El perro jefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "¿Eh? No, ¿qué clase de apodo es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340609,
					"content": "Bueno, sea lo que sea, parece que no tiene intención de atacarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340610,
					"content": "¡Guau, guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340611,
					"content": "Oh, se fue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340612,
					"content": "Se está volteando para mirarnos mientras corre. Creo que quiere que lo sigamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340613,
					"content": "¡Pues vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Sí, tal vez la verdad nos espera más adelante. Quizás es tal y como dijo Sango...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340606,
					"content": "Chucho matón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "No, es “perro jefe”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340608,
					"content": "Sombra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003409",
							"2"
						],
						"stepId": 4003409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#Bueno, otra cosa hecha. ¡Qué extraño fue eso! Kageroumaru parecía amable al principio, ¡pero antes de que pudiéramos darnos cuenta estábamos peleando contra él! Menos mal que tenemos a {NICKNAME} de nuestro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340902,
					"content": "#Ahora que lo pienso... {NICKNAME}, ¿por qué crees que Kageroumaru te sigue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340903,
					"content": "¡Guau! ¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340904,
					"content": "Estos ladridos suenan más... alegres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "¿Cómo lo sabes? ¡Paimon no notó nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340906,
					"content": "#Si mi intuición no me falla, creo que Kageroumaru ahora es el perro ninja de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340907,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340908,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Bueno, no soy experto en contratos de perros ninja, pero se dice que tienes que derrotar a uno para obtener su reconocimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340910,
					"content": "Los ninjas anhelan tener acompañantes fuertes, y los perros ninja también. Esos contratos solo pueden establecerse mediante un reconocimiento mutuo y ese parece ser el caso ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340911,
					"content": "#¡Pero {NICKNAME} no es {F#una}{M#un} ninja! Y además...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340912,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340913,
					"content": "¿Qué te pasa, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#¡Tienes que prometerle algo a Paimon, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340915,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "¡Primero tienes que prometerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340917,
					"content": "Eh... De acuerdo, lo prometo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Aunque firmes un contrato con Kageroumaru, ¡no olvides que Paimon es tu supermejor compañera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340919,
					"content": "Prometo que nunca olvidaré que Paimon es mi supermejor compañera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "¡Bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340921,
					"content": "Comparada con un gato o un perro, tú eres más fiable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "#¡Eso es! ¡Somos mejores amig{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340924,
					"content": "*Ejem*, es muy bonito ver que se llevan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340925,
					"content": "Pero regresemos a lo que nos traemos entre manos... Si Kageroumaru es tan fuerte, ¿por qué la persona de antes dejó una carta diciendo que lo cuidaran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340926,
					"content": "#¡Paimon lo sabe, Paimon lo sabe! Mira, {NICKNAME} es muy fuerte, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340927,
					"content": "Más de lo normal, desde luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340928,
					"content": "#¿Verdad que sí? Pero si un día pasa algo y Paimon tiene que dejar a {NICKNAME}, Paimon se preocuparía mucho, independientemente de si {NICKNAME} es muy fuerte o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340929,
					"content": "Uff, ¡pero eso nunca ocurrirá! ¡Paimon solo está poniendo un ejemplo! ¡Nunca jamás nos separaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340930,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Ese razonamiento tiene mucho sentido. En ese caso, queda una última pregunta: ¿por qué este perro robó los animalitos de los aldeanos y después los protegió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340932,
					"content": "Oh, eh... Paimon tampoco sabe eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340933,
					"content": "#Es una lástima que Kageroumaru no pueda hablar. Si no, {NICKNAME} podría interrogarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340934,
					"content": "Yo propongo que vayamos a buscar a Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "¡Buena idea! ¡Es hora de que el cerebro tras esta operación salga a escena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340936,
					"content": "Sí. Primero devolveré estos animales, nos encontraremos en la agencia más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340922,
					"content": "Eres en quien más confío, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Volvimos, Sango. Déjame contarte lo que sucedió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341002,
					"content": "Ah, así que ese es el caso. Se me ha ocurrido una buena razón por la que Kageroumaru protegía a los animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341003,
					"content": "Debe de haber estado intentando hacerlos más fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341004,
					"content": "Seguramente cuando era pequeño era muy débil, y con el tiempo se hizo más fuerte. Según este razonamiento, es obvio que quería ayudar a los otros animales a volverse más fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341005,
					"content": "#Pero al final Kageroumaru te encontró a ti, alguien dispuesto a proteger a los más débiles, por lo que te reconoció como su dueñ{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341006,
					"content": "Esto se debe a su empatía hacia los débiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341007,
					"content": "Bueno, de todas formas, estas solo son mi deducciones de las pistas que tenemos por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341008,
					"content": "En cuanto a la situación real, no creo que me haya desviado demasiado. Pero, dado que Kageroumaru no puede hablar, tampoco obtendremos una respuesta cierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341009,
					"content": "Humm, tiene sentido. No se podía esperar menos del cerebro de la operación, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341010,
					"content": "¡Guau, guau, guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341011,
					"content": "Tú también estás de acuerdo con Sango, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341012,
					"content": "Gracias por los halagos, pero no creas que por eso te haré algún descuento la próxima vez que me mandes un encargo. Bueno, creo que podemos cerrar este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341013,
					"content": "#{NICKNAME}, Paimon, muchas gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341014,
					"content": "Ah, casi se me olvida. ¿Qué les pareció la Red de la ubicuidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341015,
					"content": "Muy útil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Gracias, le enviaré tu opinión a mi amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341018,
					"content": "#¡De nada! Si tienen algún otro problema, no duden en llamarnos. ¡{NICKNAME} se pondrá en el caso en menos de lo que canta un bardo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341019,
					"content": "#Eres muy hábil, viajer{F#a}{M#o}. Pero estas cortesías son innecesarias. El sentimentalismo es el enemigo de la verdad, al fin y al cabo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341016,
					"content": "Me daba miedo que se rompiera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kageroumaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "Uf, por fin lo alcanzamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341102,
					"content": "¿Eh? Hay una especie de carta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341103,
					"content": "Vamos a leerla, es la única pista que tenemos al fin y al cabo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341104,
					"content": "¡Cierto! Deja que Paimon la lea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341105,
					"content": "“A quien...”. No sé qué... No sé qué... Uf, ¡está muy estropeada y Paimon no entiende qué pone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341106,
					"content": "Tal vez se refiera a “A quienquiera que lea esta carta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341107,
					"content": "Oh, supongo. También dice: “Nuestro clan se dedica al entrenamiento de perros ninja para proporcionar a los ninjas compañeros fieles”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341108,
					"content": "“Temo que es poco probable mi regreso de esta última expedición. No me arrepiento de nada, pero si tuviera alguna preocupación, sería Kageroumaru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341109,
					"content": "“Él era muy débil cuando era más joven y por eso lo excluyeron cuando los ninjas vinieron a firmar contratos con los perros ninja. A mí no me importaba eso. Como entrenador, me negaba a rendirme con ningún perro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341110,
					"content": "“Día tras día y entrenamiento tras entrenamiento, Kageroumaru se hizo cada vez más fuerte. Desgraciadamente, él no está interesado en firmar un contrato con ningún ninja”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341111,
					"content": "“La guerra todavía no ha comenzado, pero las misivas de la comisaría se volvieron cada vez más urgentes. Ya no puedo dedicarle tanto tiempo como antes. Ha llegado el momento de marcharme”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341112,
					"content": "“Lo único que puedo dejar es esta carta. Si alguien la encuentra en los próximos días, por favor, que me ayude a cuidar de Kageroumaru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341113,
					"content": "“Tiene una cicatriz en el rostro que se hizo cuando era joven y su comportamiento es claramente diferente al del resto de los perros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341114,
					"content": "Entonces, este “Kageroumaru” del que se habla en la carta es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341115,
					"content": "Este perro que nos trajo hasta aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "¡La verdad es que es muy particular! Esperen, dice más cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341117,
					"content": "“Creo que esta petición es de lo más presuntuosa, pero no tengo otra opción. Además, si en el futuro accede a firmar un contrato y puede traer hasta aquí a la persona que elija, el método para hacer un contrato será el siguiente...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341118,
					"content": "¡¿Qué?! ¡¿En serio?! ¡Quien escribió esta carta tachó la parte más importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341119,
					"content": "Quizás pensó que sería imposible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341120
					]
				},
				{
					"id": 400341120,
					"content": "Cierto. Desde el comienzo no hubo ninguna evidencia de que Kageroumaru quisiera firmar un contrato con alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341121,
					"content": "¡Guau, guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341122
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341122,
					"content": "#¿Eh? Otra vez salió corriendo, y esta vez entró en un edificio. ¡Vamos, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003451,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
