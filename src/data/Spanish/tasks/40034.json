					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "Oh, ya llegaron, tal y como esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Ryuuji está investigando en la Isla Yashiori para seguir mi corazonada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Dejen que marque las ubicaciones en el mapa. Si se apresuran, les dará tiempo a alcanzarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "#¿Por qué tanta prisa de repente? ¿No iba Ryuuji a reunirse aquí con nosotr{F#as}{M#os} para salir juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Esta investigación está llegando a su fin. Apresúrense, la verdad está a punto de salir a la luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Oh, dicho así, ¡Paimon se siente muy emocionada! ¡Vamos, {NICKNAME}, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "¡Ryuuji! ¡Estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "Ah, son ustedes dos. La jefa me envió aquí para hacer algunas investigaciones preliminares. Dijo que llegarían pronto, y así fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "Bueno, ¡ella nos dijo que estarías aquí! ¿Cómo va todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Humm, aquí no hay nada, a excepción de un montón de jaulas para animales pequeños. ¿Dónde está todo el mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Se fueron por los Ladrones de Tesoros. Sango me comentó que planean robar perros para adiestrarlos y convertirlos en rastreadores de tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "¿Como los hurones ladrones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Exacto. Pero los hurones son criaturas maliciosas difíciles de adiestrar. Por eso fracasaron en su intento. Esta vez planean intentarlo de nuevo, pero con los perros, que son más fieles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "En ocasiones anteriores ya tuvimos varios encargos relacionados con los Ladrones de Tesoros. Ahora que lo pienso, la jefa tampoco se equivocó en cuanto a eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "Al igual que las personas dejan huellas tras ellas, las organizaciones también dejan rastros únicos. Aunque había otros animales perdidos y aprisionados que descubrimos durante el proceso, las pistas siempre acababan apuntando a los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Después de consultar los métodos utilizados anteriormente para resolver los casos, mis investigaciones me llevaron hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Aun así, no poner a ningún guardia... Estos individuos son demasiado descuidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#¡Sí, se durmieron en los laureles! Pero Paimon está segura de que ya estás agotad{F#a}{M#o} después de tantos días peleando, ¿no es así, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Bueno, aprovechando que no hay nadie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "Sí, ¡eso es justo lo que estaba pensando Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "Podríamos llevarnos a los animales sin más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "¿Como Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "¡Eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
