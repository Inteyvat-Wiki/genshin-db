					"Lilúpar",
					"Soldado Fatui n.º 1",
					"Soldado Fatui n.º 2",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "¡Shh! Mira... ¡Hay alguien ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "#Humm... Mi {F#señora}{M#señor}, ¿esos son quienes mencionasteis anteriormente? ¿Los “Fanfatui”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790403,
					"content": "Son los “Fatui”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "¿Acaso hay alguna diferencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790405,
					"content": "¡Shh! Si nos descubren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Calma. Ellos no pueden oírme. Si no me creen, observen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790407,
					"content": "¡Ey, tú! ¡El grandullón de ahí! ¡Estoy aquí! ¡El almuerzo está servido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790408,
					"content": "¿Eh? ¿Has oído algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Soldado Fatui n.º 1"
				},
				{
					"id": 732790409,
					"content": "No, ¿por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Soldado Fatui n.º 2"
				},
				{
					"id": 732790410,
					"content": "Humm... Me pareció oír a alguien diciendo que era la hora de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Soldado Fatui n.º 1"
				},
				{
					"id": 732790411,
					"content": "Jeje, ¿lo ven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790412,
					"content": "¡Paimon no conocía esta faceta infantil de Lilúpar! Jeje, es adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "¡Mira! ¡Allí! ¿No es Tadla a quien tienen encerrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Humm... Alta, morena, pelo largo de color claro... ¡Debe ser ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "#Gran retentiva, Paimon. Es nuestro turno para actuar, mi {F#señora}{M#señor}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790416,
					"content": "#¡Sí! {NICKNAME}, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
