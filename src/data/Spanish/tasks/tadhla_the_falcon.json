			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Lilúpar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, venerad{F#a}{M#o} maestr{F#a}{M#o} de genios. ¿A qué se debe el honor de su visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Espléndido, otro lacayo del desierto. Mi {F#señora}{M#señor}... *Suspira*, ignorad mis palabras. Confío en vuestro criterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790103,
					"content": "¿Podría concederme un minuto? He estado esperando su llegada con tantas ganas como la de la luna y la lluvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Las zalamerías son el escondite favorito de las segundas intenciones. Adelante pues, desembucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790105,
					"content": "Muy bien, gran genio... Ciertamente, tengo una petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Jaja, no es nada serio. Se trata de mi halcón, Tadla. Creo que podría estar en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "#*Suspira*... Si no fuera por mis débiles piernas, no tendría que molestarl{F#a}{M#o} con esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Corrige a Paimon si se equivoca. Así que quieres que vayamos a rescatarla, nos lo agradecerás enormemente, nos recompensarás con un montón de Moras y luego, iremos a comer un festín para celebrar que todo ha salido bien. ¿Cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Eh... Sí, justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "#Bueno, si ese es el caso, ¡nosotr{F#a}{M#o}s nos haremos cargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "En momentos como este, te vuelves muy perspicaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*Suspira*... Sea pues, lo haremos para que Paimon goce de su festín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790113,
					"content": "Muchísimas gracias. Cuento con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Les marcaré dónde la vi por última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "La persona que deben encontrar, Tadla, es alta, de piel morena, tiene el pelo largo de color claro, y usa un arco largo... Creo que con esos datos les será suficiente para encontrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "¿Lo recordarán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Humm... ¡Una chica alta, morena, con el pelo largo de color claro y que usa un arco largo! Jeje, ¡Paimon tiene una memoria excelente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "#Que el viento l{F#a}{M#o}s guíe a través de las tormentas de arena y l{F#a}{M#o}s mantenga alejad{F#a}{M#o}s del peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Gracias. ¡Nos vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
