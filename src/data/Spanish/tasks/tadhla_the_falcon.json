			"dialogs": [
				{
					"id": 732790201,
					"content": "¿La han encontrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "Ya veo, todavía necesitan más tiempo...",
					"roleType": "TALK_ROLE_NPC",
