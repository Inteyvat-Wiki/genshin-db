					"Lilúpar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "¡Ah! ¡Mi halconcita ha vuelto! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "#Lo siento... Me emboscaron. Gracias a ell{F#a}{M#o}s he podido volver a verte de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790703,
					"content": "#¿Ell{F#a}{M#o}s? ¡Entre “ell{F#a}{M#o}s” está nuestr{F#a}{M#o} venerad{F#a}{M#o} maestr{F#a}{M#o} de genios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790705,
					"content": "¡No hay nada de lo que disculparse! Tadla está herida, ¡pórtate bien con ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790707,
					"content": "... ¿Estás herida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "Lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790709,
					"content": "¿Qué animal te hizo esto? ¿O fue una persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "Fueron los norteños. Me emboscaron tras darse cuenta de que estaba siguiéndolos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790711,
					"content": "Eras tú quien debería haberles tendido una emboscada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Emboscada por su propia presa... El colmo de un halcón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790714,
					"content": "Ve a descansar, lo necesitas. Iré después a tratar tus heridas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadla asiente en silencio y se marcha lentamente con su dolor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Masseira es un poco duro con Tadla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "¿No se llevan bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "¿Eh? ¡Para nada! Ella es mi halcón favorita, y la quiero, pero no la malcrío. ¿Cómo puedes alimentar a una halcón que vuelve con las manos vacías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Así que de eso se trata... A esta chica le espera un funesto final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790723,
					"content": "#Por favor, acepte esto como muestra de mi gratitud, venerad{F#a}{M#o} maestr{F#a}{M#o} de genios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "#*Ejem*, ¿no te olvidas de alguien? Hay dos personas más ante ti aparte de tu gran maestr{F#a}{M#o} de genios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790725,
					"content": "Jeje, bueno, una de ellas no es exactamente una “persona”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Ah... sí, claro. El hada flotante no es una persona, mas aun así, ¿no crees que merecemos recibir el debido agradecimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790727,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Jaja, mis disculpas. Por favor, acepten esta recompensa adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "¡Oh! ¡Una recompensa extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "#... Sigue sin cumplir con mis expectativas, mas dado que mi {F#señora}{M#señor} no tiene objeción, lo aceptaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790731,
					"content": "Muy bien. Ah, espero que cuando tengan tiempo puedan volver por aquí. Creo que mi halcón podría necesitar su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "No seas demasiado duro con ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "¿Duro? Soy demasiado blando con ella. Es por eso que sus habilidades están empeorando... Lo único que hago es educarla. Es una halcón excepcional. ¿Cómo podría hacerle daño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "¿Cuál será el destino habitual de un halcón?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Lilúpar"
				}
			]
		}
	]
