				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790602,
					"content": "Eh... ¿Eres Tadla? ¡Hemos venido a salvarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "¿Qué? Ah, sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790604,
					"content": "Has permitido que escapen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790605,
					"content": "No son ninguna amenaza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "... Volverán a contárselo a más gente. Sabrán que estamos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790608,
					"content": "¿Ven? Las grandes mentes piensan igual. Me cae bien esta chica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790609,
					"content": "¡No importa! ¡Si vuelven, les daremos otra paliza! Aunque... estás herida. ¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "Estoy bien. Todavía puedo andar y buscar un lugar en el que morir en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790611,
					"content": "Oh, menos mal, todavía puede andar y buscar un lugar en el que... ¡Oye! ¡No puedes decir algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "Es broma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790613,
					"content": "Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790614,
					"content": "Me gusta su sentido del humor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790615,
					"content": "Gracias. Volvamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790616,
					"content": "¿Tienes problemas para andar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Sí, pero no necesito ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790618,
					"content": "¿No quieres descansar un poco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "¿Descansar? No. No nos conocemos lo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790620,
					"content": "Entonces, quizá debamos conocernos más en profundidad. ¿Qué te parece la idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732790621,
					"content": "Gracias, quizá más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732790606,
					"content": "No hace falta eliminarlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
