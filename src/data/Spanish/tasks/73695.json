			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "¿Ya encontraste todas las réplicas de reliquia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "¡Excelente! Tienes un don para la arqueología, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Muy bien. Este obsequio es para ti. Gracias por participar en la actividad de nuestra facultad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "#Espero que hayas podido sentir la magia que esconde la arqueología, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Aunque el trabajo arqueológico de la vida real sea bastante más pesado y tedioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Pero en el momento que descubres una reliquia importante, pensarás de inmediato que todo ese esfuerzo habrá merecido la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "¿Y si no llegas a descubrir ninguna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Si no descubres nada, sería lo que se conoce como “un esfuerzo en vano”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "En realidad, esto es lo que suele ocurrir en nuestro día a día. Son muy pocas las ocasiones en las que se consigue desenterrar reliquias importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Pero para trabajar en arqueología, uno tiene que acostumbrarse a estas circunstancias y mantener la esperanza. De lo contrario, nadie podría aguantar este trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Habrá ocasiones en las que no encuentres nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
