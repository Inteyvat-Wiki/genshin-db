	"talks": [
		{
			"id": 4133801,
			"completionStepIds": [
				4133801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
