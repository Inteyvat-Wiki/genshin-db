			"dialogs": [
				{
					"id": 413380501,
					"content": "¿Cómo te sentiste en ambas rutas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380502,
					"content": "Nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Entonces, todo está perfecto. Iré a informar a la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380504,
					"content": "Con una actividad así de emocionante, estoy segura de que habrá mucha gente que querrá unirse al Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380505,
					"content": "Ah, cierto. Esta es tu recompensa por evaluar ambas rutas. Por favor, acéptala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
