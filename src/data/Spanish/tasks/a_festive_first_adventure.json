				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Ay... ¿por qué no vino nadie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "#¡Viajer{F#a}{M#o}! ¡P-por favor, tienes que ayudarme! Estamos en el Rito de la Linterna, ¿cierto? El Gremio quiere aprovechar el ambiente festivo para promocionarse y reclutar nuevos aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "Escuché que Chian inventó un juego llamado... algo con unas linternas... ¡No puedo quedarme atrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "Así que diseñé una actividad nueva llamada... ¡“Mi primera aventura”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "En pocas palabras, quiero usar las linternas celestes como señales para marcar una ruta aérea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Entonces, los interesados pueden usar su planeador y volar siguiendo el camino de linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "Así, podrán experimentar la emoción de la aventura, a la vez que disfrutan de la hermosa vista de Liyue, ¡todo mientras planean junto a las linternas celestes! ¿Qué dices? ¿Suena interesante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "En un principio había diseñado dos rutas, pero al decírselo a la Geoarmada, dijeron que alguien tiene que valorar la seguridad primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "#Tú eres {F#una viajera experimentada}{M#un viajero experimentado}, ¿cierto? S-si estás de acuerdo, ¿podrías ayudarme a evaluar las rutas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Gracias por aceptar. Entonces, vayamos primero a la Cordillera Tianheng. La primera ruta comienza ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 4133802,
