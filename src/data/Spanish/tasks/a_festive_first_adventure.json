			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Esta es la meta. Por lo que veo, dominas el arte del vuelo. ¿Cómo te sentiste en esta ruta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "Pude sentir el ambiente del festival...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Jeje, ¡por supuesto! Presté atención hasta el último detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Bien, a continuación, vayamos a la segunda ruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "Las linternas celestes lucen bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
