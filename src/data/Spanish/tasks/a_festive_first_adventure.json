					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380402,
					"content": "#Puedes comenzar cuando estés list{F#a}{M#o}. Igual que la vez anterior, tienes que recolectar las linternas celestes y llegar a la meta.",
					"roleType": "TALK_ROLE_NPC",
