			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "Este es el punto de partida. Como puedes ver, ya he colocado las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "#¡Bien! Puedes comenzar cuando estés list{F#a}{M#o}. Por un lado, tienes que recolectar las linternas celestes y, por el otro, debes llegar a la meta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 4133803,
			"completionStepIds": [
