			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "Seguro que esas piedras verdes y amarillentas son problemáticas, me voy a morir pronto aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Ehm... ¿Se encuentra bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "Sí. Me temo que todos estamos bien, pero tarde o temprano dejaremos este mundo. Solo que yo lo haré antes, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Me alegro de que esté bien. Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "¡Espera, espera! ¡Eso no significa que esté bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "No, estoy bien. Y si no estuviera bien, ya es demasiado tarde, ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "Entonces, ¿está bien o no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon está mareada, ¿podría ser un poco más directo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Nada, es que últimamente me está entrando un terrible dolor de cabeza cuando vengo al Área de Producción. Tengo las manos y los pies fríos y a veces siento que mi corazón se acelera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "¡Estoy acabado! ¿Saben? ¡ACABADO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Seguro que son esas piedras verdes y amarillentas, ¡son piedras malditas! Conocen el accidente del Laboratorio Central del Instituto, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "Pues todo fue culpa de esas piedras, ¡lo destruyeron todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Tiene que ir al médico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "¡Yo mismo soy un médico! Ah, no, ya no lo soy. Ya no tengo derecho a atender pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Se lo ruego, busquen a un médico verdadero y calificado por mí y ayúdenme, ¡por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Parece que está bastante enfermo. {NICKNAME}, ¿vamos a buscar un médico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "¿Quiere ir a la enfermería?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "Me parece que está usando una retórica muy especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "No tiene ninguna pinta de estar bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
						"stateName": "QUEST_STATE_UNFINISHED"
