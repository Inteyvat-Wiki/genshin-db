			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "Ya estamos aquí, el médico nos ha pedido que le entreguemos esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Lechlade toma el Agua pura y se la bebe entera.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "¡Ya estoy mucho mejor! ¡Es como si hubiera revivido! ¡Hurra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "¡¿Ya?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "¡Qué efectiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Se nota que Arderne es un médico cualificado, tiene sus métodos para curar a la gente. No como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "¿Y esas piedras verdes y amarillentas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "¡Son excesivamente problemáticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320411,
					"content": "Parece que se ha recuperado del dolor de cabeza, pero sigue empeñándose con las piedras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320412,
					"content": "¡Ahora puedo trabajar tranquilo! Gracias por hacerme este favor. Quédense con estos Cupones crediticios como parte de mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320413,
					"content": "¡Les deseo buena salud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320406,
					"content": "Yo creo que no tiene ninguna enfermedad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "¡Estoy malo de verdad! ¡Y el medicamento es de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Lechlade"
				}
			]
		},
		{
