			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Nahida, hemos vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Hoy han vuelto temprano. ¿Alguna novedad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "#Más o menos. Ahora estamos casi segur{F#a}{M#o}s de que no estamos en un bucle temporal, y que tampoco estamos en el mundo real. Pero al mismo tiempo, nos ha surgido una nueva pregunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "¿Qué pasaría si intentamos salir de la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Dejar la ciudad... Por lo que recuerdo, ya han mencionado sus planes de hacerlo un par de veces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "¡¿?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "¿Ah, sí? ¡Pues no recordamos nada! ¿Qué pasó después de hablar de esos planes? ¿Qué dijimos al volver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "Déjame pensar... Creo que nunca me dijeron cuál fue el resultado. Para ser exacta, no volvieron en ninguna de las dos ocasiones por la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Pero a veces se quedan fuera toda la noche igualmente, así que no le di demasiada importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "#Es cierto que a veces perdemos la noción del tiempo durante nuestras investigaciones. Antes de que nos demos cuenta, ya es el día siguiente. Pero aun así... ningun{F#a}{M#o} de l{F#a}{M#o}s dos recuerda nada sobre salir de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "¿De verdad? Qué extraño. En teoría, ya deberían haber despertado todos sus recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Probemos de nuevo mañana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "¡Sí! Hay algo aquí que es definitivamente sospechoso. ¡Vamos a llegar al fondo de esto mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*Bip*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Puede que la clave de todo esté ahí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "¿Hemos probado a salir de la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
