	"talks": [
		{
			"id": 301101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301101",
							"2"
						],
						"stepId": 301101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "... ¡Y seguimos en el mismo día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Como era de esperar, no es tan sencillo como pensábamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "¡Nahida, anoche ya sabías que no habíamos salido del samsara del Día del Sabzeruz! ¿Por qué no nos lo dijiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "¿Habría tenido sentido? Habrían pasado la noche con nuevas preocupaciones, con el mañana aún fuera de su alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "En ese caso, podrían descansar en ese breve momento de esperanza. Una oportunidad como esa no se presenta a menudo, y pensé que podría ayudarles a despejar sus mentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "#Tienes razón. ¡Después de todo, estabas cuidando de nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "#Jeje, por supuesto. En el tiempo que hemos estado junt{F#as}{M#os}, ustedes han sido todo para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Oh... Paimon se siente halagada y todo, pero tal vez estés yendo un poco rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "#Jejeje... Lo que quiero decir es que, aunque les haya pedido que resuelvan este rompecabezas, siguen siendo l{F#a}{M#o}s únic{F#a}{M#o}s que pueden verme y sentir mi presencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "En otras palabras, si no estuvieran aquí, sería como si no existiera. Por eso ustedes dos lo son todo para mí. ¿Entienden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Nahida vuelve a hablar de cosas confusas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "#Bueno, basta de cháchara. Entonces, viajer{F#a}{M#o}, ¿las pistas de ayer te ayudaron a entender mejor la situación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "Efectivamente, la teoría del bucle temporal es incorrecta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "¿Eh? ¿Por qué estás desechando tu teoría anterior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Las habilidades de lucha de Dehya están mejorando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Oh, sí, tienes razón. ¿Cómo no nos dimos cuenta? En un simple bucle temporal, las condiciones físicas de las personas también deberían reiniciarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Entonces, ¿cuál es tu nueva hipótesis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "La enfermedad de Dunyarzad ha empeorado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "#... Ahí están. Por fin l{F#as}{M#os} encuentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Como era de esperar, Dehya tampoco se ha hecho daño hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "¿Hacerme daño? ¿Por qué lo haría? No me subestimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Bueno, todavía te estás acostumbrando a tu nuevo mandoble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "A decir verdad, yo también creo que es bastante extraño. De repente me resultaba tan familiar tenerlo en mis manos... Un segundo, ¿cómo saben que tengo un nuevo mandoble? No se lo dije a nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "#{NICKNAME}, ¿esta vez podrías explicarle tú la situación? Paimon está un poco harta de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "En realidad, no tenemos que explicarlo todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Oh, eso también puede funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "De repente te volviste diestra con el mandoble porque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "... Hemos vivido este día una y otra vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "¿Les pasó algo mientras yo no estaba? ¿Les lavó el cerebro alguna secta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Humm, no le prestes mucha atención. Solo toma lo que decimos al pie de la letra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "De acuerdo. A ver si entendí. ¿Me están diciendo que mi cuerpo ya se ha acostumbrado a este mandoble, pero que mi cerebro no lo recuerda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Sí, tu memoria está siendo borrada cada noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Entonces no puedo estar de acuerdo. Eso es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "¿Eh? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Si de verdad hemos estado viviendo el Festival Sabzeruz día tras día, ¿qué pasó con las cosas que usamos, el dinero que gastamos y la comida que comimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "De acuerdo al sentido común, mi cartera debería haberse vaciado hace mucho tiempo. Es imposible que no me haya dado cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "También he pensado en eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Pero si los sabios están detrás de todo esto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Podrían usar el Akasha para registrar lo que todo el mundo hizo ese día, y luego usar los recursos de la ciudad para reabastecerlo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Es una probabilidad remota, pero no es imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "No, es imposible. Tengo pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "¿Tienes pruebas? ¿Cuáles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "*Suspira*, se están tomando realmente en serio esta discusión sin sentido. Bien, les seguiré el juego un poco más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Acompáñenme. Srta. Dunyarzad, por favor, venga usted también. Todavía no puedo garantizar que estemos a salvo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Si usaron los recursos de toda la ciudad y la información del Akasha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Nuestros recuerdos del día son eliminados cada noche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Podemos ir al grano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "Es aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "¿Eh? ¿No es esto un poste de entrenamiento de madera? ¿Qué pasa con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "¿Ves esas marcas en el poste? Son el resultado de varios días de práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Supongamos que los sabios no lo reemplazan todos los días. ¿No debería estar ya hecho pedazos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "Es cierto, ¿pero y si lo hicieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Entonces los sabios habrían tenido que reproducir todas las marcas que dejé durante las sesiones de entrenamiento anteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Soy una luchadora profesional. Mi escuela marcial siempre ha hecho hincapié en la importancia de un control refinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "La fuerza, el ángulo y el punto de entrada de cada golpe son calculados e intencionales. Por eso recuerdo cada marca en el muñeco, así como mi estado de ánimo al realizar cada golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "Como se suele decir, cada espadachín tiene su propio estilo, e incluso el mismo espadachín no puede hacer el mismo corte dos veces. Sería imposible copiar estas marcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "¿De verdad es imposible? ¿Y si usaron alguna máquina moderna para tallar cada marca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "La gente suele decir que la imagen de un Daguerrotipo nunca podrá sustituir a la pintura de un artista porque la primera no tiene espíritu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "A mí me ocurre lo mismo. A simple vista, puedo diferenciar los resultados del entrenamiento de combate en las marcas talladas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "Tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Uf... Espero que eso te haya aclarado las cosas. Oye, ¿esto no es como ese juego llamado Calientacocos que es tan popular últimamente entre los eruditos? Es sorprendentemente divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "En fin, se hace tarde. Debo acompañar a la Srta. Dunyarzad al escenario de Nilou. Nos vemos luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "*Suspira*... De vuelta al punto de partida. ¿También es errónea nuestra teoría del borrado de la memoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "Pero al menos hemos sacado otras conclusiones, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "No estamos en un bucle temporal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Sí, es cierto. Entonces... ¿se nos ocurre alguna idea nueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Déjame pensar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "¿Crees que hay algo extraño? Paimon siente que todo es extraño últimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "¿Cómo es que nunca hemos pensado en salir de la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "¿Eh? Salir de la ciudad... ¡Tienes razón! Es muy extraño que nunca hayamos pensado en una solución tan simple. Podríamos aclarar muchas cosas si pudiéramos confirmar el flujo del tiempo fuera de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "#Paimon no puede creerlo... ¿No hemos caído en la cuenta porque estábamos demasiado obcecad{F#a}{M#o}s con nuestras teorías, o porque estábamos demasiado cansad{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "Es muy extraño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "¿Qué tal si volvemos y le preguntamos a Nahida? Tal vez hayamos olvidado algo sobre lo de salir de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Deberíamos haber pensado en esto hace mucho tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "Me acabo de dar cuenta de que hay algo extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "No estamos en el mundo real.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Parece que tendremos que descartar esta hipótesis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
