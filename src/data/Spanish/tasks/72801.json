					"id": 728011304,
					"content": "Realmente es una buena ubicación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "En conclusión, es un buen lugar para despegar... Y es un buen lugar sobre el cual escribir en el diario de viaje.",
