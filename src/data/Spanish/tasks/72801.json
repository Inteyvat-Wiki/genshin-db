				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "El agua de esta playa es cristalina y el color de la arena es tan blanco que es completamente diferente a la costa de mar abierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Sería un buen lugar para zarpar o... despegar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "El paisaje aquí es muy bonito. Lo escribiré en mis notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "#Espera un momento, viajer{F#a}{M#o}. Tengo que pensar cómo escribir mi diario de viaje. Puedes pasear y disfrutar del paisaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Pero no te alejes demasiado. Este tipo, Heihachi, me está siguiendo. Está cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
