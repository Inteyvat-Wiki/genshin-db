			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "¿Esta vez ocurrió en el Valle Tianchiu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Ah, eres tú, {NICKNAME}. Qué suerte, no esperaba encontrarte aquí hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "Oh... Ahora que lo pienso, ¿has ido al Valle Tianchiu o a la Montaña Nantianmen hace poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Últimamente, el gremio ha estado recibiendo informes de terremotos en el área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "Al principio solo fue un pequeño temblor, pero ha empeorado desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Y no hace mucho, el Gremio recibió otro informe según el cual, después de un terremoto especialmente fuerte, parte de las montañas y las ruinas colapsaron, dejando al descubierto una cueva enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "En el informe, también se mencionaba un tipo de monstruo desconocido. Según la descripción, podría tratarse de Dragartos y Protodragartos Geo, que alguna vez aterrorizaron a Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "¿Necesitas que me encargue de eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Oh, quería pedirte que fueras a buscar esa gran cueva del Valle Tianchiu y vieras cómo había afectado el terremoto al entorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "Y sobre esos monstruos, si realmente han aparecido en gran cantidad, no podemos quedarnos con los brazos cruzados, debemos tomar medidas rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Naturalmente, esto se considera como parte del trabajo del Gremio. Al terminar, también habrá una recompensa. ¿Qué opinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Está bien, yo me haré cargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Muchas gracias. Y, por favor, cuando estés buscando por allá ten mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
