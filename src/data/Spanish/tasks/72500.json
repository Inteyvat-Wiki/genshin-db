			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mamoru",
					"Akira",
					"Genta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "¡Malas noticias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "¡Han detenido al jefe otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Hace un momento, alguien de la Comisión Tenryou publicó en el tablón de anuncios que van a suspender temporalmente nuestro festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "No sé qué ha pasado exactamente. Creo que el jefe envió algunos folletos a Tenshukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "¡Dijo que seguro que la Shogun no querría perderse el Sublime y Glorioso Gran Festival de Tambores de Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Humm... La verdad es que yo creo que el jefe tiene razón. Seguro que la Shogun también quiere participar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "¡Eso digo yo! ¿Es que tú no estás de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "¡Diablos, a quién le importa lo que pensemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "En definitiva, los Okuzumeshuu arrestaron al jefe en ese mismo momento. Se lo llevaron a la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "¿Y qué piensan hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Seguro que Shinobu ya se está encargando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Los Okuzumeshuu acusan al jefe de causar un tumulto en un área militar restringida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Pero, al final, la Srta. Kujou Sara lo dejó en alteración del orden público.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "¡Esa maldita tengu Kujou! ¡No podemos permitir que se salga con la suya y presente cargos tan graves por algo como esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "¡Pero mira que eres tonto! Se trata de un delito menor, ha rebajado los cargos. Por un delito así, solo le darán una advertencia en comisaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "En cuanto al festival, esperaremos a que suelten al jefe para saber qué vamos a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "#No te preocupes, viajer{F#a}{M#o}. Estando Shinobu aquí, todo saldrá bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Nos has ayudado mucho con el festival. Cuando salga el jefe, ¡seguro que quiere agradecértelo en persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "Espero que tu viaje, al igual que nuestro festival, vaya a partir de ahora viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "¡Viento en popa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}