			"dialogs": [
				{
					"id": 750100101,
					"content": "“No tengo ningún objetivo o ambición. Soy una pastora feliz, sin condición. Solo me interesan mis alpacas al sol y las estaciones cambiando de rol”.",
					"roleType": "TALK_ROLE_NPC",
