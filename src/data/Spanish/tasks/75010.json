			},
			"dialogs": [
				{
					"id": 750101201,
					"content": "¿Has vuelto, pequeñín? ¿Cómo te fue? ¿Te hiciste amigo de alguna alpaca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Jaja, ¡mira qué contento estás! ¡Cuánto me alegro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Wactana, tienes que preocuparte más por las alpacas, ¿eh? La alpaca de la que se hizo amiga {REALNAME[ID(2)|SHOWHOST(true)]} estaba en un sitio muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "¿En serio? Le diré a Huevopoché que esté más atento entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "¡Qué bien vives!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "Jaja, lo sé. ¡Es la vida de mis sueños! ¡Alégrate por mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "Por cierto, si les gusta ese peluche de alpaca, se lo pueden quedar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#Oye, {REALNAME[ID(2)|SHOWHOST(true)]}, ni gracias ni nada, ¿eh? ¡Wactana, Paimon te da las gracias de su parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "Jaja, no importa. ¡Vengan a visitarnos de vez en cuando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "Pobre Huevopoché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Sí... Pero él es así. De hecho, si no le dejo que se encargue de las alpacas, se le caerá el pelo del estrés, ¡ya verás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "Así que esto es lo mejor para ambos. Él se siente satisfecho por su trabajo y yo por poder disfrutar de la vida, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
		},
