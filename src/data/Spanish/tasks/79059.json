			"dialogs": [
				{
					"id": 790590101,
					"content": "Este es un escenario abandonado del corto teatral «Viaje hacia el este: comienzo».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790590102,
					"content": "Originalmente, la historia trataba sobre un sabio viajero que parte desde Fontaine y viaja hacia el este, a Sumeru, donde va en busca de la verdadera sabiduría de la Casa de la Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790590103,
					"content": "En esta escena, el viajero salva a un maestro de la geomancia de ser aplastado por una enorme roca, y con el que emprende su viaje de aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790590104,
					"content": "Desafortunadamente, tanto el eidolon hidromimético que interpreta el papel del viajero como el que interpreta al maestro de la geomancia han desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Notas del plató"
				},
				{
					"id": 790590105,
					"content": "Si alguien pudiera <color=#00E1FFFF>traerlos de vuelta</color> y capturar la escena de cuando ensayan junto a la enorme roca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Notas del plató"
				}
			]
		},
