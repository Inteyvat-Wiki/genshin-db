			"dialogs": [
				{
					"id": 741411101,
					"content": "¡Guau! ¡Has vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411102,
					"content": "¿Cuánto tiempo he estado ahí dentro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Eh, pues ha sido un abrir y cerrar de ojos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411104,
					"content": "Si para ti solo fue un abrir y cerrar de ojos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411106,
					"content": "No pasa nada. Ciertamente, estar ahí dentro es peligroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Oh, vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Por cierto, ¿por qué no está de vuelta Canotila todavía? ¡No estará trabajando de guardia en la Corte de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "#Luego hablamos de eso. Estoy un poco maread{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "De acuerdo. ¿Quieres que vayamos a comer algo? ¡Preocuparse por ti le ha dado mucha hambre a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Pero si solo fue un abrir y cerrar de ojos, ¿no es así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "¡Pero la preocupación de Paimon por ti ha sido muy intensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
