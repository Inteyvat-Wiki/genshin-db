						],
						"pointId": 6835
					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "... ¿De verdad? Bien dicho. ¿Cómo te llamas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Hola, Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}, no esperaba verte por aquí. ¿No está Paimon contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Espera, ¿no serás algún tipo de monstruo que adoptó la forma de alguien a quien conozco para burlarse de mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Nos hemos visto hace un momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "... ¿De verdad? Me da la impresión de que ha pasado mucho tiempo desde que nos despedimos. No importa, puede que sea porque me estoy haciendo viejo, pero cada vez recuerdo menos cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "... ¿De verdad que no eres un monsturo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "¿Es que no lo recuerdas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Lo del jardín del gigante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Lo recuerdo, lo recuerdo. Eres tú de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Perdóname, pero por aquí ocurren tantas cosas increíbles... y he pasado por muchas batallas que no he podido ganar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Pero este lugar por fin ha cambiado. La luz dorada se ha elevado y los girasoles se han abierto. Quizás, incluso el universo como lo concibieron los antiguos pueda cambiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Quizás, todo cambie a mejor. Y quizás consiga comprenderlo y dejarlo ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Ven conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Jajaja... Parece que de verdad eres tú. Ya me acuerdo. Te conozco, y no has cambiado ni un poco. Siempre te andas preocupando por los asuntos ajenos, y eso es porque eres una persona decente y amable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "Pero no tienes que preocuparte por mí. No necesito ayuda. Ya sabes de lo que soy capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "Además, puede que incluso conozca este lugar mejor que tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "#Hilichurl, ayúdame a decirle a {F#esta}{M#este} joven que se apresure y se vaya de una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "¿Me hablas a mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "... ¿Puedes entenderme? Bueno, pues voy a preguntarte algo. ¿Qué soy para ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Un perro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Ah, bien... Entonces, aún no es demasiado tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "Esto es por tu propio bien. Vamos, salgamos de aquí, joven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Estoy de acuerdo. {NICKNAME}, tú perteneces a un mundo más brillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "Todavía tengo preguntas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "No deberías tenerlas. Adiós. No vuelvas por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "Lo del aprendiz y el pececito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
