			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "¿Qué quiero? ¡Derechos laborales! ¿Cuándo los quiero? ¡Ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Aquí están los núcleos que necesitabas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "¿Ah? ¡Déjame ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "¿Por qué estás protestando aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Uno se levanta en el mismo lugar donde lo derriban, ¡¿no?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "¿Y qué quieres que haga yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "¿Tú? ¡Yo no sé qué hacer contigo! Alguien ha colocado máquinas extrañas sobre el suelo y en las profundidades del agua. Es muy fácil distinguirlas, pues suelen emitir un resplandor a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "#Deshazte de ellas y tráeme esos núcleos especiales. Necesito <color=#00E1FFFF>siete</color> en total. ¡Confío en ti, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
		{
			"id": 7404303,
			"completionStepIds": [
				7404311
			],
