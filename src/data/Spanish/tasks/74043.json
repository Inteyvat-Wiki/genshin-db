			"dialogs": [
				{
					"id": 740430301,
					"content": "Guau, lo conseguiste de veras. No puedo creer que los siete núcleos misteriosos ya sean míos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "¿Y qué piensas hacer con ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "¿Yo? ¿Yo qué voy a saber? Mi jefe dijo que le hacían falta siete núcleos misteriosos como estos. Si se los llevo, me llevaré una buena comisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "#¡Con estos bastará! El jefe y yo acordamos vernos aquí hoy para informarle sobre el progreso del trabajo. Pueden aprovechar para preguntarle ustedes mism{F#a}{M#o}s. De todas formas, tengo que esperar a que él haga sus cuentas para poder recibir mi parte del dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Bueeno, si insistes... ¡Esperaremos aquí como dices!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Tras haber esperado un rato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Mi querido Henri, ¿cómo van las cosas por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430308,
					"content": "#¡No podrían ir mejor, jefe! Hemos conseguido los siete núcleos misteriosos que pidió. Venga, déjeme que le presente a mi soci{F#a}{M#o}. Eh... ¿Cómo te llamabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430311,
					"content": "¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "¿Ah? ¿Ustedes ya se conocen de antes? ¡Eso facilita mucho las cosas! Mire, jefe, lo que pasa es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#“¡Aaah! ¡Pero si es {NICKNAME}! ¡¿Se puede saber qué haces tú aquí, {NICKNAME}?!”.\\nEl supuesto jefe sale corriendo escopetado hasta que Hunter y Turner aparecen de la nada y consiguen darle caza.\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "¡Ay! ¡Tengan clemencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430316,
					"content": "Guau, sí que están bien entrenados esos dos tipos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "No se preocupe, jefe. ¡Le aseguro que su vida no corre peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "Por supuesto que no. No tenemos ni la más mínima intención de ponerlo en peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "... De momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "¡¿D-de momento?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430321,
					"content": "¿Y ahora qué?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Pollo asado... ¿o la guarnición que lo acompaña? Depende de cómo se porte, jefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "S-sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430324,
					"content": "¿Qué están haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "La última vez, cuando tuvimos el honor de conocerles... decidimos vigilar a Henri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Un momento, ¿y por qué tendrían que vigilarme a mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "No, mejor dicho, ¡¿por qué decidieron vigilarme a mí precisamente?! ¡Todos saben que no soy más que un trabajador normal y corriente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Las máquinas que desmontaste se utilizaban en el Instituto de Ciencias de Fontaine con fines investigativos para mejorar los dispositivos de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "¿Eh? ¿No se supone que fueron desarrolladas para producir contaminación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Esos núcleos que desmontaste contienen los componentes centrales y los datos sobre hidrología más innovadores de Fontaine. Nos gustaría poder conocer a... tu socio comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "¿E-eh? ¿C-cómo? ¡¿Qué?! ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "¡Henri, me has engañado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "¡¿Cómo es posible?! ¡Nos han engañado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "Te equivocas, tú eres mi héroe, ¡¿cómo iba a querer engañarte?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "¡Jefe, me has mentido! ¡Me engatusaste para que destruyera algo tan importante como esos núcleos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "Y-yo... no lo hice a propósito... Yo solo soy un mandado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430337,
					"content": "¿C-cómo? Jefe, creo que no he escuchado bien... ¿Acaba de decir que no lo hizo a propósito? ¿Podría repetir lo que ha dicho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "E-eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 740430339,
					"content": "Creo que el jefe está demasiado cansado... Tiene pinta de que se quedará dormido en cuanto cierre los ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "O-oh... N-no era nuestra intención...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "En cuanto a lo que vinimos a hacer... Será mejor que no insistamos por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "¿Eh? ¿Y no habrá ningún problema si lo dejan todo como está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "De todas formas, bastará con que los núcleos y los datos estén completos. Las máquinas en sí no tienen tanta importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Nuestros superiores mencionaron que son algo secundario, y que no deberíamos meternos con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "¿Y por qué se iban a meter conmigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Por nada, por nada. Escucha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Nosotros solo estamos paseando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Qué encuentro tan grato, ¿verdad? El sol brilla, los pájaros cantan... No podría haber sido mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Pero los buenos encuentros también llegan a su fin. Ha llegado el momento de decirnos adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Deja que el recuerdo de un encuentro tan hermoso como el de hoy quede grabado en tu corazón... O quizá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "... Sea mejor olvidarlo. Eso sería lo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "*Suspira*... Entonces, ¿todo está bien entre nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "¿Ah? ¿Acaso tienes sed de conflicto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "¡De ninguna manera! Jaja, pues claro que está todo bien. ¡Estamos divinamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "*Suspira*, hubo un momento en el que creí haber conocido a una buena persona con la que podría dar un giro a mi vida si trabajaba duro. Al final, resulta que en este mundo abundan más las personas malvadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "Eh, Henri. Ven a echarnos una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Me cuesta tener que decir esto, pero tu jefe no está en sus cabales, por muy buena persona que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "Necesitaremos a alguien para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "... Que trabaje duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "Alguien que sea de fiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Un amigo capaz de darle un giro a su vida trabajando duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "Exacto, un buen amigo que nos ayude a llevar al jefe a un refugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Así será más sencillo... charlar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Por supuesto, nosotros expresaremos nuestra plena gratitud hacia él... Con Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "¿Eh? ¡Claro! ¡Cuenten conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "¡Qué bien! ¡Muchas gracias, muchachos! Y a ustedes también, eh... ¿Cómo han dicho que se llamaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Yo soy {NICKNAME}, y ella es Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Gracias, {NICKNAME}. Gracias, Paimon. ¡Mi vida se ha transformado por completo después de haberme encontrado con ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "¡No fue nada! ¡Mucha suerte, Henri! ¡Y que no te vuelvan a engañar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "¡No lo permitiré! Me esforzaré todo lo que pueda, ¡hasta que me convierta en uno de esos peces gordos! ¡Algún día les contrataré para que trabajen para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Turner y Henri recogen al Fatui, que estaba inconsciente en el suelo, y se marchan llevándoselo con ellos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Paimon espera que Henri sea muy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "¡Un momento! ¿Y la recompensa que nos prometió Henri? ¡¿Dónde está?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}