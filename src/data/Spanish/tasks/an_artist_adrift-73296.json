				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "Dicen que un artista observa lo que desea plasmar desde distintos ángulos antes de empezar. ¿Se trata de una especie de... estereotipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "¿Echamos un vistazo por los alrededores? ¡Puede que encontremos un lugar elevado desde el que tener mejores vistas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "Parece una buena idea. Estoy listo para partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#Jeje, ¿hacemos una carrera hasta el final? {NICKNAME}, ¿estás list{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
							"2"
						],
						"stepId": 7329604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "¡Este lugar rebosa naturaleza! ¿No notas que te llega la inspiración y te dan ganas de hacer algunos bocetos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "Eso sí que es un estereotipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Humm... Pero a Paimon le dan muchas ganas de ponerse a dibujar. Este lugar rebosa vitalidad, y los colores son preciosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "*Ejem*.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Perdona... Paimon no quería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Jaja, no importa. Yo solo lo veo de forma distinta, pero su belleza sigue siendo la misma, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "¡Exacto! A Paimon le encanta este sitio. Es como si pudiese purificar el alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "No es algo que tú necesites, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "#Mis querid{F#a}{M#o}s amig{F#a}{M#o}s, agradezco de todo corazón su amabilidad conmigo, incluso cuando no les dije la verdad desde un principio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "#Amb{F#a}{M#o}s tienen un corazón puro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Jeje... Tampoco hay que exagerar. Por cierto, ¡todavía hay paisajes más especiales que este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#Seguro que sabes a lo que Paimon se refiere, {NICKNAME}. ¡Enseñémoselo a Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
