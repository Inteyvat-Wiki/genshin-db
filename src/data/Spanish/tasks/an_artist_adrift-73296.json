				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon, {NICKNAME}, ¡han venido! Ciertamente, uno debe confiar en sus amigos cuando sale fuera de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Bueno, dijimos que te indicaríamos el camino, ¿no? Hacer de guía tampoco es que sea una tarea muy complicada. De hecho, ¡es muy fácil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Pero ¿estás seguro de que quieres volver a Fontaine tan pronto? Estando ya en Sumeru... ¡hay muchos paisajes por ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "En el bosque hay paisajes muy bonitos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "¡Hay muchos árboles y ríos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Suena muy bien, pero... En realidad, todavía no he terminado de hacer los preparativos para un viaje tan largo como el que me espera. Aunque, en esta ocasión, mi viaje haya sido un fracaso, al menos me ha servido para aprender algunas valiosas lecciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Humm... ¡por aquí hay algunos paisajes dignos de contemplar! Sería una pena que te los perdieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Paimon nunca se equivoca con sus recomendaciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Bueno, si insisten, seguir negándome sería de mala educación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Jeje, Paimon es la guía número uno de todo Teyvat. ¡Paimon les marcará el camino! Solo tienen que seguir a Paimon y no quedarse atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Las vistas del desierto son bastante únicas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "¡Está lleno de arena y ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329612",
							"2"
						],
						"stepId": 7329612,
						"stateName": "QUEST_STATE_UNFINISHED"
