			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "¡U-una lluvia de fuego biológica! ¿Acaso el fuego puede volar sobre las cabezas de la gente como si estuviera vivo? Vaya, los volcanes de Natlan son realmente aterradores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, Paimon siente cierta curiosidad, jeje. ¿Por qué no nos acercamos a la zona de más adelante a explorar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
