			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Humm, fuego que parece vivo, sombras extrañas, un Daguerrotipo que toma imágenes por sí solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "¡El instinto de Paimon le dice que nos encontramos ante un acertijo de difícil solución! ¡Y puede que esté relacionado con algún tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "¿Qué es lo que has visto, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "En realidad... ¡Paimon no tiene ni idea! Pero... el dueño del Daguerrotipo lo colocó aquí seguramente para tomar imágenes cuando la tierra empezara a temblar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Así que lo único que tenemos que hacer es poner el Daguerrotipo como estaba y esperar a que la tierra tiemble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Jeje, Paimon cree que, cuando llegue el momento, las pistas sobre el tesoro aparecerán retumbando, ¡al igual que esta aparición!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
