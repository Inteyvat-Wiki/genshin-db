			"dialogs": [
				{
					"id": 731580101,
					"content": "“... Edad del paciente: 65 años. Género: varón...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580102
					],
					"speakerTitle": "Historial médico de Jayam"
				},
				{
					"id": 731580102,
					"content": "“... Síntomas: amnesia a corto plazo, la cual empeora con el tiempo. Emocionalmente inestable, repite constantemente historias de su niñez y juventud...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580103
					],
					"speakerTitle": "Historial médico de Jayam"
				},
				{
					"id": 731580103,
					"content": "“... Enfermedad cerebral de causa desconocida. Los resultados del examen realizado al paciente muestran inactividad y muerte neuronal progresiva desde los 60 años, lo que ha causado una pérdida gradual de memoria...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580104
					],
					"speakerTitle": "Historial médico de Jayam"
				},
				{
					"id": 731580104,
					"content": "“... Se presenta una solicitud de jubilación hacia la facultad de la Escuela de Biología de la Academia de Sumeru, con la esperanza de que una vida y entorno tranquilos y estables permitan ralentizar el deterioro de la condición del paciente...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580105
					],
					"speakerTitle": "Historial médico de Jayam"
				},
				{
					"id": 731580105,
					"content": "“... La Escuela de Biología anuncia que el sabio Siman Farrojzad estará personalmente a cargo del tratamiento del paciente...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Historial médico de Jayam"
				}
			]
		}
	]
