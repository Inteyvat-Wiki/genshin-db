	"talks": [
		{
			"id": 1302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302304",
							"2"
						],
						"stepId": 1302304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhacén"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "El nombre de Siraj no me suena. ¿Es alguien de tu clase?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230102,
					"content": "No llama mucho la atención, es comprensible que no lo recuerdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230103,
					"content": "A la Academia siempre le ha gustado presionar a la gente etiquetándola como genios. Nunca lo he entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230104,
					"content": "Aun así, la Academia no puede quedar en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230105,
					"content": "O mejor dicho, me alegra que seas consciente de ti mismo. Si los de la Academia no se han vuelto locos, seguramente saben que yo soy más adecuado que tú para ser un sabio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230106,
					"content": "¿Y que todo el mundo se entere de que tu carrera como sabio es tan inestable como esa pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230107,
					"content": "¡Qué palabras tan osadas de alguien que está a punto de renunciar! En unos días volverás a estar archivando documentos. ¡A eso llamo yo tocar fondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230108,
					"content": "Pero mi salario será el mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230109,
					"content": "Espera... ¡¿Qué?! ¡¿Por qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230110,
					"content": "Al menos no tengo que partirme el lomo como arquitecto para que mis clientes me paguen con una simple sonrisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230111,
					"content": "T-tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230126,
					"content": "Encima de que me tomo el tiempo de limpiar el salón para ti, ¿así es como me pagas? Mejor me hubiera puesto al corriente con mi trabajo. Aún tengo diseños por terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230112,
					"content": "No te olvides de pagarme la renta que me debes. Pienso comprar muebles con ese dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230113,
					"content": "¿Qu-qué?... ¿Lo dices para molestarme? Las decoraciones que compras son cada una más fea que la anterior, ¿qué objetivo tiene una estatua de madera en medio de la casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230114,
					"content": "Las ventajas de ser pudiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230115,
					"content": "Está bien, si quieres esconder tu inseguridad detrás del dinero, allá tú. Pero poniendo los Moras a un lado, ¿de qué presumes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230116,
					"content": "Hay tanto para escoger, que no me puedo decidir. En cambio, tú... ¿hay algo que valga la pena rescatar de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230117,
					"content": "¡El buen gusto, por supuesto! No sabes nada de diseño de interiores. ¡Ya te he dicho que no vayas por ahí comprando muebles sin mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230118,
					"content": "¿Para que te invite a unas copas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230119,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230120,
					"content": "¿Por qué lo haría? Agrandaríamos tu deuda, y tarde o temprano la tendrás que pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230121,
					"content": "O podrías ser más amable y no cobrarme nada, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230122,
					"content": "Fingir que no tienes deudas es tan ridículo como fingir que no vives en casa de otra persona. Tarde o temprano la gente se enterará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230123,
					"content": "#Hablando del tema, tus amig{F#as}{M#os} no van a contárselo a nadie, ¿o sí? Diles que guarden el secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230124,
					"content": "Estoy seguro de que ya lo saben todos, no tienes que ocultarlo. Te emborrachas tan fácilmente que lo gritas a los cuatro vientos tú solo cada vez que bebes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "Alhacén"
				},
				{
					"id": 130230125,
					"content": "¿Qué...? No... ¡Imposible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		}
	]
}