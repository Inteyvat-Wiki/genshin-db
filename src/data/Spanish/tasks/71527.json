				]
			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "¡El escaradiablo de Yanfei es superfuerte! ¿Con qué ha estado alimentándolo Madam Ping?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "¿Ves? No podemos subestimar al escaradiablo de la salvadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716664103,
					"content": "Al igual que la vez anterior, cuando mis subordinados te causaron algunos problemas, hay veces en que la espada más afilada es incapaz de cortar si no está en manos de un buen espadachín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716664104,
					"content": "B-bi-bien dicho, Gran Maestre... Ajá... ¡Menos mal que mi compadre se mantuvo firme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "¡Ya veo, ya veo! ¡Creo que le estoy encontrando el gusto a esto de las peleas de escaradiablos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664106,
					"content": "¡Esto es muy divertido! Gracias a todos. ¡Voy a seguir jugando un poco más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masacradora OP"
				}
			]
		},
