					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "¡Buenas! ¡Ya estoy por aquí! ¿Cómo les va con el Ferviente y Radiante Entrenamiento de Escaradiablos de Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664002,
					"content": "¡Justo a tiempo, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "¡Mi salvadora! ¡Gracias por ayudarme con la autorización! ¡Y por ese cartel tan increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Espera, conozco esa mirada. ¿Acaso... quieres jugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "¿Eh? ¿Tiene algo de malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664006,
					"content": "Tengo una buena clienta que suele hacer negocios en el extranjero. Una vez, la ayudé a ganar un pleito importante y me agasajó a regalos, entre los cuales se encontraba un escaradiablo muy especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664007,
					"content": "No sabía cómo cuidar de él en aquel entonces, así que le pedí a la abuela que se encargara de cuidarlo durante un tiempo. Ahora, ese escaradiablo parece que se ha hecho muy fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664008,
					"content": "¿Les importa si me uno a la competición? ¿O temen que estropee el ambiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664009,
					"content": "De ningún modo podemos subestimar a la salvadora, rey oni. Lo que le falta en experiencia lo compensa con uno de los escaradiablos más asombrosos y fuertes que he visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 716664010,
					"content": "¡Ya veo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "Entonces, es hora que la Mano del Rey Oni y Titán Carmesí entren en acción. ¡Mi compadre no vacila ante nadie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "¡Bien dicho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Entonces, soy yo contra {NICKNAME}, ¿verdad? ¡De acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664015,
					"content": "Todavía no estoy muy familiarizada con el juego, así que me disculpo por adelantado si me equivoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masacradora OP"
				},
				{
					"id": 716664013,
					"content": "¡Gracias por el cumplido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
