			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madarame Hyakubei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "¿Son... semillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830102,
					"content": "Son semillas de percibetormentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830103,
					"content": "¿Conoces esta planta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Bueno, sé algo sobre ella. He visto esta planta antes, y he escuchado a la gente decir maravillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830105,
					"content": "Recuerdo que se estremece ante el más leve sonido del trueno, incluso a falta de viento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830106,
					"content": "¿Cómo se ve al crecer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Si se refiere a su aspecto, nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830108,
					"content": "#¿Por qué no lo prueba usted mism{F#a}{M#o}? Pero la tierra de aquí no es la más ideal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830109,
					"content": "Yo tengo tierras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "¿En serio? Como era de esperar, incluso le dieron un pedazo de tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830111,
					"content": "Si me permite la pregunta, ¿en dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830112,
					"content": "No está en Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "¡Oh! He oído hablar de sus proezas en Mondstadt y en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830114,
					"content": "Es normal que tales hazañas sean recompensadas con tierras. ¡Como era de esperarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830120,
					"content": "#Oye, {NICKNAME}, ¿te refieres a ese pedazo de tierra que nos dio la anciana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830121,
					"content": "¿De verdad puedes cultivar algo ahí? Ella no dijo nada al respecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830122,
					"content": "Vayamos a preguntarle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "De acuerdo, vayamos a verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830124,
					"content": "Después de todo, los Adeptus son muy poderosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "¿Tú crees? Pero esa anciana sí que es muy poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830126,
					"content": "De acuerdo, vayamos a verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830115,
					"content": "En realidad, es una tetera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "¿Una... tetera? Por favor, no gaste ese tipo de bromas conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830117,
					"content": "Yo también he escuchado de sus logros en Mondstadt y en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830118,
					"content": "Supongo que ese pedazo de tierra debe estar en Liyue, o quizás en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830119,
					"content": "*Suspira*, como era de esperar de alguien como usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				}
			]
		},
		{
			"id": 7218302,
