			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "#¿Eh? Hola, jovencit{F#as}{M#os}. ¿Vinieron a verme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830202,
					"content": "Es sobre las semillas de percibetormentas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Semillas... ¡Ah! ¿Quieres cultivar semillas en la Relajatetera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830204,
					"content": "No debe de haber ningún problema, la Relajatetera es un universo diminuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830205,
					"content": "Pero... veo que solo has traído una bolsa de semillas. ¿Es todo lo que piensas sembrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830206,
					"content": "¡Es cierto! No sabemos cómo recolectar semillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Después de que plantemos esta bolsa de semillas, ¿dónde encontramos más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "De acuerdo, no se preocupen. Da la casualidad que tengo una cajita que solía usar hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830209,
					"content": "Antes, cuando cultivaba flores, las guardaba siempre aquí. Esta cajita puede preservarlas por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830210,
					"content": "Es más, al poner plantas en esta cajita, puede producir más semillas... Es una forma muy conveniente de cultivarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830211,
					"content": "A pesar de que ya no me sirve de mucho, tiene el poder de “generar semillas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830212,
					"content": "Humm... Puedes quedártela. Después de todo, no la uso mucho últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830213,
					"content": "Esta cajita debería de servirte si quieres cultivar flores, plantas o cosechar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830214,
					"content": "¡Gracias, abuela!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "¡Gracias, abuela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "#Jeje, no hace falta que sean tan corteses, jovencit{F#as}{M#os}. Denle un intento, pero debo advertirles que no es una tarea fácil cuidar de las flores y las plantas, así que deben estar preparad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830217,
					"content": "La abuela es muy poderosa... pero antes de que probemos la cajita, vayamos a la Relajatetera e intentemos sembrar esas semillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Humm... Paimon espera que estas semillas crezcan pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}