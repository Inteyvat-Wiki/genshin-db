			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "#*Ejem*, creo que estoy hablando demasiado. ¿Por qué no lo pruebas tú mism{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Puedo jugar una partida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Ahora no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "De acuerdo, vuelve cuando quieras probar «Cazadores y rebeldes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
