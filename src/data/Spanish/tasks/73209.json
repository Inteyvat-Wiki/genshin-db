			"dialogs": [
				{
					"id": 732090601,
					"content": "Si estos brotes florecen, podremos plantar más rosas doradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Pero antes tendremos que ver si los brotes son capaces de florecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
