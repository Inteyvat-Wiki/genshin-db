			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "#Mira quién es. Las rosas y yo hemos estado esperándol{F#a}{M#e}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabah también está ya aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Últimamente vengo mucho por aquí. Estoy leyendo las notas del Sr. Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090104,
					"content": "Me sentía muy sola cuando estaba en la Aldea Aaru, pero ahora estoy mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090105,
					"content": "Al menos ya no estoy sola. Tengo a las rosas para hacerme compañía y mis recuerdos de ustedes y el Sr. Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090106,
					"content": "Teniendo unos recuerdos tan hermosos, ya no me siento tan triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090107,
					"content": "El Sr. Affan y yo lo hemos estado hablando y voy a quedarme para ayudarle a cuidar de las rosas doradas a partir de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090108,
					"content": "Cultivaremos más rosas, hasta que podamos llenar todo el jardín. Aunque por ahora, tenemos que esperar a que florezcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090109,
					"content": "¿Todavía recuerdas cómo hiciste florecer las rosas de Sumeru? Deberíamos usar el mismo método.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090110,
					"content": "Te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Muy bien, te lo dejo a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		},
		{
