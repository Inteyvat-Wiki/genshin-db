				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Estaba a punto de perder la esperanza. No pensaba que las semillas germinarían. Supongo que mientras estemos vivos, todavía nos aguardarán momentos maravillosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Muchacha, no estés triste por Shafaqat. Los vivos deben honrar los deseos de aquellos que ya no están entre nosotros. No podemos fallarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Sr. Affan, ya no soy pequeña. Seguro que los chicos con los que crecí ahora ya son mayores y capaces de ir a comprar especias por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090704,
					"content": "Pero tiene razón. Ya que estamos vivos, deberíamos seguir adelante y ser felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		}
	]
