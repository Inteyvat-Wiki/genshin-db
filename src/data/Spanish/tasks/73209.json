			"dialogs": [
				{
					"id": 732090426,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin ♪",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "♪ Una rosa dorada que canta mientras que de entre fragmentos se alza ♪",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Las rosas doradas son realmente bonitas. Verlas florecer ha hecho a Paimon muy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Todo el trabajo de estos últimos días ha merecido la pena. ¡Paimon está la mar de contenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Por fin ha podido cumplir su sueño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "Al final he acabado haciendo algo bueno con mi vida. Shafaqat, te he ayudado a cumplir tu sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "Es una pena que no pueda verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090407,
					"content": "No digas eso, Sabah. ¿Todavía recuerdas los versos de la canción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "♪ No hay tierra que me dé sustento, pero esta melodía será mi aliento ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "♪ La música cargará con mi destino, algún día cumpliré mi sino ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "♪ Desafiarán a la eternidad, sobrevivirán a mi exigua mortalidad ♪”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "El recuerdo de su vida, sus rosas doradas y su canción aún siguen con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Tiene razón. Al final fue capaz de sobrevivir a la exigua mortalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090413,
					"content": "Muchas gracias por compartir conmigo su historia. Significa mucho para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090414,
					"content": "Como yo, él también fue un exiliado. Ver lo que fue una vez su vida me hace sentir como si hubiera atravesado el tiempo y el espacio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090415,
					"content": "Ahora ya no solo le veo a él, también me veo a mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090416,
					"content": "No podré decírselo en persona, pero cargaré con sus remordimientos y seguiré adelante con mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090417,
					"content": "Si yo también me esfuerzo por honrar su memoria, algún día seré capaz de compensar mis errores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090418,
					"content": "Espero que seas feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Ya no me siento tan apenada de vivir en este lugar. Y es todo gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090421,
					"content": "Las rosas son realmente capaces de traer la felicidad a la vida de las personas. Sr. Affan, sigamos esforzándonos para cultivar aún más flores doradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090422,
					"content": "Jajaja, me parece un buen trato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "¡Haré todo lo que pueda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732090419,
					"content": "No te rindas nunca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Ha merecido la pena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
