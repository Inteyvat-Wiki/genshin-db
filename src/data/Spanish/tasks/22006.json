		{
			"id": 2200603,
			"completionStepIds": [
				2200604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200604",
							"2"
						],
						"stepId": 2200604,
						"stateName": "QUEST_STATE_UNFINISHED"
