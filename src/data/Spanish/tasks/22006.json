					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Si lo pudiera leer, podría contribuir a llenar los espacios en blanco de los registros de la Academia de Sumeru.",
