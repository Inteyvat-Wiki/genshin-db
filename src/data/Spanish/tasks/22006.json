		{
			"id": 2200606,
			"completionStepIds": [
				2200606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200606",
							"2"
						],
						"stepId": 2200606,
						"stateName": "QUEST_STATE_UNFINISHED"
