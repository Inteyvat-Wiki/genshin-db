				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#Gracias, viajer{F#a}{M#o}. ¡Uf! Pensé que iba a morir. Los Ladrones de Tesoros están cada vez más fuera de control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Me llamo Soraya, soy una erudita. Actualmente estoy en medio de una investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Hace poco encontré unas ruinas siguiendo unas pistas. En el interior encontré un disco de jade cuyo grabado narra la Guerra de los Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Pero al salir de las ruinas, los Ladrones de Tesoros me atacaron. Intenté escapar, pero me alcanzaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "De no ser por ti, el disco de jade y yo estaríamos en peligro. Una vez más, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "¿Tú también eres una erudita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "¿“Tú también”? ¿Hay otros eruditos investigando el área? ¿Cómo se llamaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er... Espera un momento, cuando me atacaron los Ladrones de Tesoros escuché a alguien decir: “¿por qué es Bao'er la que se queda con el tesoro?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Es mucha coincidencia, ¿no crees? Perdona, ¿puedes decirme cómo fue tu encuentro con Bao'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "En resumen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "La ubicación que te dio Bao'er es la misma que la mía. Es una coincidencia, una gran coincidencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Si de verdad pertenece a los Ladrones de Tesoros, y si mi hipótesis es cierta, hace tiempo que me vienen persiguiendo, y aprovecharon la oportunidad para arrebatármelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Pero Bao'er decidió actuar por cuenta propia, así que se adelantó. Pero ella sola no puede cubrir toda esta área, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "#Al parecer fuiste utilizad{F#a}{M#o}, viajer{F#a}{M#o}. Seguro que lleva mucho tiempo con la mira en este lugar, solo que sus compañeros y yo llegamos antes que tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "#Tranquil{F#a}{M#o}, es solo una hipótesis, pero el nombre de Bao'er suena demasiado sospechoso. No parece un nombre real, más bien es un código.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "#Viajer{F#a}{M#o}, ¿puedes entretenerla un poco más? No puedes permitir que el disco de jade quede en manos de gente sospechosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Gracias, pero si regresas con las manos vacías, sospechará de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "¡Ya sé! Tengo una reliquia que no es de gran valor. Llévasela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "No creo que ganemos mucho tiempo, pero la detendrá temporalmente",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "De acuerdo, rápido. Aunque hayas ahuyentado a sus compañeros, ella está trabajando por su cuenta. Tardarán un poco en llegar y darle las noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Por cierto, si te vuelve a pedir que le ayudes a buscar y descubres algo, puedes traérmelo. Suelo estar en la Posada Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "No puedo ayudar en mucho, pero al menos puedo proteger la reliquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Si regreso con las manos vacías, ella sospechará de mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Humm... tienes razón. ¡Ya sé! Tengo una reliquia que no es de gran valor. Llévasela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "No creo que ganemos mucho tiempo, pero la detendrá temporalmente",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
