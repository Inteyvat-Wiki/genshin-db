			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley",
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*Puff*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "¡Pensé que me iba a morir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "Estuvo muy cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "Así que tú eres Jack el aventurero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Sí. ¿Tú quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "¡Somos el equipo de rescate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Ellin tiene un mensaje para ti. Dice que no podrá reunirse contigo hoy para planear su siguiente aventura, que lo hagan otro día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Oh, ya veo. Siento que hayan tenido que venir hasta aquí... a rescatarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "¡Ja! No sé por qué tanto alboroto. ¡No es algo que yo, Stanley, no pudiera solucionar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "¡Guau! ¿Tú eres Stanley? ¿El aventurero legendario conocido en toda Mondstadt? ¿Que puso pie en el Mare Jivari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "Así es. ¡En persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "¡Jaja! Es un gran honor conocer a alguien tan legendario como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Entonces, ¿cuál es el plan ahora? ¿Seguimos adelante o regresamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "Stanley, ¿qué opinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#Jaja, bueno, jovencit{F#a}{M#o}, ahora están a salvo con Stanley, ¡el gran explorador de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "Así que ¿para qué dar marcha atrás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Bien, ¡se aprueba la moción por voto unánime! Sigamos adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "Jack, ¿qué piensas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Creo que deberíamos seguir adelante. Con Stanley a nuestro lado, no debería haber ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "#Viajer{F#a}{M#o}, acabo de descubrir algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "¿Puedo pedirte de nuevo el detector de nirnama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "¿Eh? ¿Crees que Stanley tiene un amigo imaginario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Al parecer, su amigo es un guerrero curtido en batalla, con cicatrices de los pies a la cabeza y con una mirada de determinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Parece que es una descripción de sí mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "¿Quizás su amigo imaginario es una versión idealizada de sí mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Interesante... ¿Será eso posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Discúlpenme, tengo que irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "¡Adiós, Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "Oigan, ¿tienen tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "En realidad, el otro día Stanley se emborrachó y me contó un secreto que no le había contado a nadie antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Dijo que las armas que llevó en sus aventuras todos esos años no eran otras sino las que portó la gran heroína de Mondstadt, ¡Vennessa! ¡La <color=#00E1FFFF>Espada del Valor Fulgurante</color> y el <color=#00E1FFFF>Escudo de la Tenacidad Radiante</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Tal vez no me crean pero, al parecer, la espada y el escudo están aquí en Mondstadt, ¡en el <color=#00E1FFFF>Valle Dadaupa</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "#Ustedes son {F#expertas}{M#expertos} en esto. ¿Podrían venir conmigo a buscar las dos armas legendarias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "¿De verdad existen armas como esas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "¡Por supuesto que existen! Al fin y al cabo, estamos hablando de Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Si encuentro algo lo suficientemente extraordinario como para demostrarle a mi familia de lo que soy capaz, tal vez en ese caso apoyen que quiera ser un aventurero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Ahora soy débil y novato, y, por si fuera poco, papá y mamá están totalmente en contra de mi sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Por eso, te lo pido. ¡Ayúdame, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "No me atrevo a decírselo a Stanley, porque mis motivos son muy egoístas... ¡Pero juro que le devolveré las armas en cuanto termine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Oh, pobrecillo... ¡Tenemos que ayudarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, ¿tú también vienes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Eh... Es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Ah, tengo una botella de un vino excelente que una persona me ayudó a conseguir hace unos años. Si me ayudas a encontrar las armas, ¡el vino es todo tuyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "Dijiste que las armas estaban en el <color=#00E1FFFF>Valle Dadaupa</color>, ¿cierto? ¡Vamos, no hay tiempo que perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "No podemos ignorarlo tras haber escuchado esa historia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "¿Acaso las perdió Stanley por ahí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Bueno, las personas extraordinarias siempre tienen sus excentricidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "Ahora que lo dices, hay algo extraño en su historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Oh, ¿tú también lo notaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "Parece como si nos estuviera ocultando algo sobre su historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}