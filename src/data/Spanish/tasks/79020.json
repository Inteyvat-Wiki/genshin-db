				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "¡Déjame ver! Sip, ¡a Paimon le parece un mapa del tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "¡Hum! A Paimon le huele a tesoro, ¡así que no hay duda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Vaya, parece que fueron “Ako Domeki y los cuarenta piratas” los que dejaron esto aquí. A Paimon ese nombre le suena de algo, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "Además, ¡mira esto! Dice “El secreto sobre dónde está escondido el tesoro...”. No hay duda, ¡es un tesoro, Paimon está segura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Y lo siguiente que dice es: “... Está dividido en cuatro partes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Así que dividieron lo que fuera en cuatro partes, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "¿Eso quiere decir que hay cuatro tesoros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Paimon no está segura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Sea como sea, aquí pone que están “distribuidas por los arrecifes de las cuatro grandes islas”. Paimon cree que se refiere a los arrecifes de las islas del Archipiélago Manzana Dorada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "¡Oye, estamos en uno de esos arrecifes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Entonces supongo que habrá cuatro pistas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "¡Y deberían estar cerca de los arrecifes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "¡Seguro que se refiere a las cuatro islas más grandes del archipiélago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "¡Vayamos a buscar más pistas a los otros tres arrecifes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200108,
					"content": "¿Eso quiere decir que hay cuatro pistas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
