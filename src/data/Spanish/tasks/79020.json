			"dialogs": [
				{
					"id": 790200101,
					"content": "¡Déjame ver! Sip, ¡a Paimon le parece un mapa del tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "¿De verdad?",
