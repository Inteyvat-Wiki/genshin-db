			"dialogs": [
				{
					"id": 100080601,
					"content": "¡Lo logramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080602,
					"content": "Gracias... por la ayuda. Yo pensar que proteger a Lupical era solo mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080603,
					"content": "Pero Lupical también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "Hemos venido porque nos preocupamos por ti, ¡igual que tú! Para eso somos Lupical, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080605,
					"content": "Sí... Lupical para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Jeje, ¡ahora ya no habrá más intrusos en el Reino de los Lobos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "No... Manada de lobos oscuros rasgar espacio. Poder volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "Pero Lupical y yo cazarlos... cueste lo que cueste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "¡Y Paimon y yo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Sí, si alguna vez necesitas ayuda, ¡dínoslo y vendremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "Yo apreciarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "¡Auuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Aullido de lobo a lo lejos"
				},
				{
					"id": 100080613,
					"content": "Estar llamándome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080614,
					"content": "Jeje, parece que quieren asegurarse de que estás bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080615,
					"content": "Entonces... deber irme. Gracias por ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080616,
					"content": "No es nada, para eso está el Lupical.",
