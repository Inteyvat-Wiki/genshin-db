			"dialogs": [
				{
					"id": 100080301,
					"content": "¡Ha faltado poco! ¡Menos mal que los lobos nos ayudaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Mhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Interceptaron a los Sabuesos Acechadores... e incluso nos ayudaron a expulsarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Pero esto no ser problema de lobos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Jeje, estás haciendo esto para ayudar a tu Lupical, ¿verdad? ¡Ellos también quieren que estés a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Paimon apuesta a que fueron al Rey Lobo del Norte y le dijeron: “¡Escucha, esto no es problema solo de nuestro Lupical, es problema del mundo entero!”, y luego vinieron corriendo a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Sí, Lupical ser Lupical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Yo ser humano, pero no necesitar ser lobo para ser Lupical. Solo querer ayudarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "¡Bien dicho, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Tal vez Lupus Boreas aceptó que la manada ayudara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Porque conoce tus intenciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "¿Sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "¡Claro, desde luego! ¡Vamos, démosles una buena tunda a esos Sabuesos Acechadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000806,
