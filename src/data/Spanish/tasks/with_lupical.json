			"dialogs": [
				{
					"id": 100080101,
					"content": "¡Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080102,
					"content": "Olor familiar, ser ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080103,
					"content": "¿Cómo estar últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080104,
					"content": "¡Jeje, todo bien! Por cierto, Razor, ¿por qué ha desaparecido Boreas nada más vernos? ¿Estaban hablando de algún secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080105,
					"content": "Ir a cazar. Yo intentar convencer... al Señor de los Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080106,
					"content": "¿A cazar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080107,
					"content": "#(Oh, {NICKNAME}, ¿será esa la “tarea” de Razor?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080108,
					"content": "Razor, ¿acaso la manada de lobos se quedó sin comida y tienen que salir a cazar de nuevo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080109,
					"content": "Dame algunas trampas para animales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "No. Caza no ser para comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080112,
					"content": "Cazar... enemigos. Manada de lobos oscuros. Olor extraños venir del territorio que ellos invadir... Cada vez más intenso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080113,
					"content": "Tener que cazar enemigos para purificar el bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080114,
					"content": "¿Entonces Boreas ha aceptado? Paimon recuerda que la última vez dijo algo como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080115,
					"content": "*Ejem*, “Razor, no debes involucrarte. Esto es un ajuste de cuentas entre lobos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080117,
					"content": "Ah, perdón, Razor. Paimon no quería sacar ese tema de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080118,
					"content": "Estar bien, sé que Lupical no tener mala intención. Además, maestra enseñarme cómo hablar con Señor de los Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080119,
					"content": "¿Lisa te enseñó cómo hablar con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080120,
					"content": "¡Ah! ¿O sea que te dijo qué decir? Entonces lograste que aceptara, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080121,
					"content": "Sí. Las palabras ser... difíciles. Pero yo lograrlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080122,
					"content": "¡Conseguiste convencer a ese tipo tan testarudo! ¡Impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080123,
					"content": "Los lobos oscuros ser enemigos del mundo entero. Maestra decir que no ser problema de lobos, ser problema del mundo... Y el Señor de los Lobos estar de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080124,
					"content": "Pero, por eso, los otros lobos no unirse. Esta guerra ser entre los lobos oscuros y yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080125,
					"content": "#Jeje, ¡puedes contar con nosotr{F#a}{M#o}s! ¡Esos Sabuesos Acechadores tan horribles ya nos tienen hart{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080126,
					"content": "G-Gracias... La ayuda hacer que caza ser más fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080127,
					"content": "Por cierto, ¿cómo vamos a llevar a cabo la caza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080128,
					"content": "Colocar trampa. Luego perseguir lobos oscuros hasta aquí. Caer en la trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080129,
					"content": "El Señor de los Lobos atraparlos y nosotros... terminar caza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080130,
					"content": "#Avisar cuando estar list{F#a}{M#o}s para comenzar caza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080401,
					"content": "¡En marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "Los jabalíes del bosque ya han crecido lo suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
