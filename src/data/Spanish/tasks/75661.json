			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "Con razón tuve la corazonada de venir a echar un vistazo por aquí... ¡Así que nos volvemos a encontrar, Tum{RUBY#[D]esperanza}aini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610102,
					"content": "Y bien... ¿vienes a participar en las pruebas de la Tribu Plumaflora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610103,
					"content": "Así es, ¡vengo a probar su dificultad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "No te decepcionarás, soy muy estricta con los jinetes de Qucusaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610105,
					"content": "Como no se me da bien enseñar a la gente, cuando me invitaron a diseñar estas pruebas, opté por recordar desafíos extremos que experimenté en mi vida y añadirlos uno tras otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610109,
					"content": "Casi todos los guerreros de la Tribu Plumaflora quedaron atascados en la primera prueba... así que no tuve más remedio que seguir el consejo de Irade y reducir un poco la dificultad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610110,
					"content": "Pero para ti, quizás ni siquiera las pruebas originales sean un desafío. En tu caso... Si quisiéramos desafiarte, tendríamos que elegir situaciones que incluso yo fuera incapaz de resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610111,
					"content": "¡Gracias por el cumplido! ¡Pero no necesito un trato especial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "Ese es el respeto que te mereces. Aunque no se me dé bien enseñar, tengo buen ojo para juzgar la capacidad de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610114,
					"content": "Y con tu capacidad... los únicos retos que te merecen la pena son los más difíciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610115,
					"content": "Pero tengo que considerar las habilidades de un guerrero promedio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "Tienes razón, eso es lo que te han pedido hacer. Bueno, ya será la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610118,
					"content": "Algún día, diseñaré un desafío a tu medida... ¡Un combate que trascienda los límites de los jinetes de Qucusaurios! Solo espera y verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610116,
					"content": "Es importante evaluar si la prueba es apta para todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "¡Creo que me estás sobreestimando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "Puede ser que esté aquí por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "¿En serio? Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610108,
					"content": "¿Quieres superar mi récord? Eso quiero ver. Estas pruebas las diseñé con los problemas extremos que encontré en mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				}
			]
		}
	]
}