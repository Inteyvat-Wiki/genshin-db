			"dialogs": [
				{
					"id": 740990101,
					"content": "Sobre tu experiencia capturando pece... digo, monstruos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "¡Oh! Ahora que lo pienso, ¡ha sido interesante ver cómo mis cebos atraían a monstruos en lugar de peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Aunque no soy una persona que sienta especial miedo por los monstruos, pues no me costó mucho derrotar a todos los bandidos que me encontré cuando solía recorrer el camino que hay entre el Instituto de Ciencias y la Corte de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Pero la persona que tienen ahora mismo ante ustedes no puede permitirse ningún comportamiento violento que la haga quedarse sin empleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Tanto si asustar a los peces como molestar a los pescadores son conductas inapropiadas para la directora del Gremio de Pescadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "¡Tengo que mostrarme como la mujer seria que soy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
