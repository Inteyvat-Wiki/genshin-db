				"points": []
			},
			"dialogs": [
				{
					"id": 711082501,
					"content": "*Suspira*, y pensar que el Clan Guhua, con su milenario legado, ha quedado relegado a que el guardián time a otros para sobrevivir... Qué pena, qué pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082502
					],
					"speakerTitle": "Wen Cuarto"
				},
				{
					"id": 711082502,
					"content": "*Suspira*... Ya está bien, ¿acaso no estoy impidiendo que te mueras de hambre mientras guardas las puertas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082503
					],
					"speakerTitle": "Huang Tercero"
				},
				{
					"id": 711082503,
					"content": "#Y no me mires así. Nunca estás contento... Pero te gustó ver cómo se ha desenvuelto {F#la aventurera}{M#el aventurero}, ¿a que sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082504
					],
					"speakerTitle": "Huang Tercero"
				},
				{
					"id": 711082504,
					"content": "#¿{F#Esa chiquilla tonta}{M#chiquillo tonto}? Puede entrar a visitar el lugar a cambio de prepararte algo de comer, ¿y yo debería estar contento? Si fuera algo más joven, te daría una buena bofetada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082505
					],
					"speakerTitle": "Wen Cuarto"
				},
				{
					"id": 711082505,
					"content": "¡Je, hace unos pocos años tu técnica seguía siendo peor que la mía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082506
					],
					"speakerTitle": "Huang Tercero"
				},
				{
					"id": 711082506,
					"content": "Está bien, escucha... Solo quedamos unos pocos abuelos aquí ya. Si no pusiéramos a prueba a aquellos que podrían estar predestinados, ¿qué harías con esos libros? ¿Llevártelos a la tumba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082507
					],
					"speakerTitle": "Huang Tercero"
				},
				{
					"id": 711082507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082508
					],
					"speakerTitle": "Wen Cuarto"
				},
				{
					"id": 711082508,
					"content": "Jaja, olvídalo. ¿De qué sirve hablar de cosas tan deprimentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711082509
					],
					"speakerTitle": "Huang Tercero"
				},
				{
					"id": 711082509,
					"content": "¿Por qué no pruebas la comida que me han preparado? ¡Jeje, creo que sabe mejor que la del Restaurante Wanmin! Anda, ven, ¡prueba un bocado! ¡Uno aunque sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang Tercero"
				}
			]
		}
	]
