		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "“Practicando la técnica de perforación ligera destruí todos los muñecos de madera... No me quedan dinero ni recursos... Pero tengo una idea: usaré paja para crear mis propios muñecos...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080302,
					"content": "“Empiezo a recolectar paja”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080303,
					"content": "“Me pongo a atar las briznas de paja. Es agotador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080304,
					"content": "“Practicando la técnica de perforación ligera destruí todos los muñecos de paja... Creo que será mejor entrenar con la espada primero”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080305,
					"content": "Seguir leyendo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "“No hay nada que hacer. Veo la lluvia caer sentado en el patio y empiezo a sentir el hambre acuciando... Medito sobre lo que vi el otro día y de pronto me siento iluminado. Si uso la espada, (ilegible)... Lo llamaré “corte de lluvia”. Ya lo probaré la próxima vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080308,
					"content": "“Me he caído practicando la técnica de corte de lluvia, pero por suerte no es grave... Se me ocurrió una idea: excavar una laguna bajo los pilares. Así evitaría nuevas caídas y podría criar peces para comer...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080309,
					"content": "“Fui a ver a un pescador y compré diez pescados para cocinarlos... Su sabor es incomparable...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080310,
					"content": "(Las diez páginas siguientes describen diferentes métodos para cocinar pescado con todo tipo de detalle. Algunas recetas incluso incluyen ilustraciones.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080311,
					"content": "“Me he caído practicando la técnica de corte de lluvia...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080312,
					"content": "“... Ha sido un éxito”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080313,
					"content": "Seguir leyendo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "“Usar la lanza y la espada como es esperado (ilegible. Hay una nota del tercer maestro: “como un acto reflejo”)... Esa es la verdad... Aun así, no lo hay... ¿Cómo puede ser concedido? ¿Cómo puede ser revelado?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080316,
					"content": "“Empiezo a renovar la biblioteca. Diseño... el interior. Espero a...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080317,
					"content": "“... Usa los <color=#00E1FFFF>ojos</color> y combina <color=#00E1FFFF>pergaminos de todos los lares</color> con <color=#00E1FFFF>estantes de cada rincón</color>, y podrás...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080318,
					"content": "(Las páginas siguientes están emborronadas y resultan ilegibles. Hay una nota del tercer maestro: “Esto anima a las generaciones posteriores a leer y estudiar largo y tendido”.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080319,
					"content": "Seguir leyendo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "“... Ya me siento mucho mejor. El pequeño Bai vino con cordero y pescado, todo un manjar. Le pedí la receta... Les he enseñado la técnica de ejecutor de vidas... Tal y como queda registrada aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080322,
					"content": "(Las páginas siguientes detallan todo tipo de recetas de preparación del cordero.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notas de la Escuela Guhua"
				},
				{
					"id": 711080320,
					"content": "No pienso seguir leyendo, apenas es legible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "Ya leí suficiente, ni siquiera describe el proceso de entrenamiento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "No pienso seguir leyendo, es un sinsentido total...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
