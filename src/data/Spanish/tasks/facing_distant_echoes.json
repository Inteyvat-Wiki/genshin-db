			},
			"dialogs": [
				{
					"id": 726550101,
					"content": "¡Por fin hemos encontrado la ubicación de nuestro objetivo! ¡Sí, ya puedo volver al barco y dormir un poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "¡¿Qué?! ¿Te vas a ir así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "¡Claro que no! Ya que estamos a un paso de lo que necesitamos, ¡vamos ahora a capturar la máquina de las ruinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "¡Paimon pensaba que estabas a punto de volver al barco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*Suspira*, olvídalo, ¡sigámosla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7265502,
