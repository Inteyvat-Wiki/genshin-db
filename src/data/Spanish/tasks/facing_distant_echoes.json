			"dialogs": [
				{
					"id": 726550301,
					"content": "¿Hum? ¿Necesitas prepararte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Acerca de las ruinas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Pues, soy directora de tecnología de un barco, no sé mucho sobre la historia de tierra firme, lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Pero creo que todas estas ruinas están relacionadas con la catástrofe de hace quinientos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "También crecí escuchando a los viejos marineros hablar de la catástrofe, decían que ni la tierra ni el mar se salvaron del Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Pero para mí es como una historia de fantasmas para asustar a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Al fin y al cabo, poder verlo con tus propios ojos es lo que lo hace realmente horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Acerca de las máquinas misteriosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
