	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "En resumen, la zona contaminada fue provocada por una fuga de líneas ley en las profundidades del bosque. Las cosas han comenzado a regresar a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "Ya veo. Han hecho un buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Una vez que el excedente de energía de las líneas ley se disipe en el aire, podremos avisar a los residentes para que regresen a su rutina diaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "Aquí tienen la recompensa acordada. Por favor, acéptenla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "Después de marcharte del Gremio de Aventureros, Paimon te lleva a un lugar tranquilo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "¿Enviarán a Karkata de regreso a la Academia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Ya está averiado, pero Paimon se siente triste con tan solo pensar que lo van a desmontar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Yo también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "¿Qué tal si mañana buscamos a Tignari y le pedimos que no lo haga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Paimon quiere ir ahora mismo, pero Tignari dijo que hablaríamos mañana. Si vamos ahora, seguramente se pondrá furioso, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Eso creo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "¡Está bien! ¡Busquemos mañana a Tignari y digámosle que no desmonten a Karkata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tignari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tignari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "¡Shh! Baja la voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030303,
					"content": "La dafne, una lila del género Thymelaeaceae, tiene un efecto anticonvulsivo. Tal vez pueda usarse para crear un polvo anestésico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030304,
					"content": "Si extrapolamos estos dos conjuntos de datos, sería muy efectiva contra agentes tóxicos de origen piscícola... Concéntrate en grabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030305,
					"content": "¡*Gru*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "¡¿Karkata?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "¡*Gru*! ¡*Gru*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Pensé que les había dicho que bajaran la voz. Las plantas no le tienen miedo al ruido, pero tanto grito hace que me zumben los oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030309,
					"content": "¿No has desmontado a Karkata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "¿Y por qué lo iba a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030311,
					"content": "Pero Paimon recuerda que dijiste que “de acuerdo al reglamento de la Academia de Sumeru”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "Ah, así que es por eso que irrumpieron como un par de bárbaros a esta hora del día. Supongo que no me expresé lo suficientemente bien ayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030313,
					"content": "Lo que quise decir es que, de acuerdo al reglamento de la Academia, todos los productos de la investigación deben destruirse. Es por eso que no puedo permitir que descubran ese lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030314,
					"content": "Entonces, en realidad te quedaste allí para...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "En fin, lo primero que hice fue reparar a Karkata. Durante mi estancia en la Academia, tomé un curso optativo de la Escuela de Elementalismo. ¿Quién diría que algún día me fuera a servir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030316,
					"content": "Después, Karkata y yo enterramos a Abattouy. Puse en orden los materiales de su investigación y guardé unos cuantos como recuerdo, pero quemé la mayor parte de ellos para ocultar toda evidencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030317,
					"content": "Ya no pertenezco a la Academia de Sumeru, así que ¿qué tiene que ver su reglamento conmigo? Por otro lado, soy el guarda forestal del Bosque Avidya. Mi responsabilidad es proteger todas las formas de vida del bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030318,
					"content": "Toda forma de vida que llega a este mundo tiene un significado, y Karkata no es la excepción. Si existe, no podemos abandonarlo a su suerte o destruirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030319,
					"content": "Jeje, ¡genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "¿*Gru, gru*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Espera, ¿dijiste “forma de vida”? Entonces, ¿reconoces que Karkata es un verdadero ser vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "Es probable. Es difícil de explicar el esfuerzo de Karkata por “reparar” a Abattouy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030323,
					"content": "Abattouy solo dejó una pequeña parte de su investigación. Quién sabe cuántos comandos instaló.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030324,
					"content": "Quizás un conflicto entre todos esos comandos resultó en esta clase de comportamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030325,
					"content": "Siendo estrictos, es imposible llegar a una conclusión sobre si Karkata es una forma de vida o no. Pero si existe esa posibilidad, estoy dispuesto a creer en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030326,
					"content": "¡*Gru*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Por cierto, no me interesa continuar la investigación sobre el tema. Solo dejaré que se quede aquí porque este sitio está relativamente escondido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030328,
					"content": "Pero, dadas las circunstancias, no sería mala idea hacerlo mi asistente de investigación. Al menos puede hacer un registro de mis experimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030329,
					"content": "¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130030330,
					"content": "¡*Gru*! ¡*Gru*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
