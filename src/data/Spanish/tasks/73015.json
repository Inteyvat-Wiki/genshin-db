				{
					"id": 730152101,
					"content": "Los aranara son tan pequeños que no es de extrañar que tengan miedo de encontrarse con los Hongos, ya que son bastante más grandes que ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152102,
					"content": "¿Paimon no está asustada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730152103,
					"content": "¿Paimon? ¡Claro que no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152104,
					"content": "Oh... Obviamente, Aranakula es más fuerte que Paimon, pero no es más valiente que ella. Si Hongos atacan, Aranakula se esconde en <color=#00E1FFFF>un lugar seguro</color>...",
