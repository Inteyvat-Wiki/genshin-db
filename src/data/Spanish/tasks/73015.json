			"dialogs": [
				{
					"id": 730151301,
					"content": "Así que aquí estaba... De no ser por Aranakula, no habríamos encontrado este sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "Pero por aquí no hay hojas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "Hojas... están cerca de gran árbol. No está muy lejos, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Humm... Este lugar es seguro. Paimon no cree que los Hongos puedan encontrarlo. Aranakula, espéranos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu nos dijo que hay que girar las hojas de las tres piedras para que apunten hacia la rama. Es así, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Gracias, nara {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
