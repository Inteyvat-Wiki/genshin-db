					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150901,
					"content": "#Nara {NICKNAME}, esta es piedra de recuerdos que aranara crearon para nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150902,
					"content": "Por fin hemos llegado... Hemos tenido extremo cuidado para que los Hongos no nos vieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150903,
					"content": "Está bien haber evitado luchar contra ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Paimon cree que sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Humm... Así que esta es la piedra de los recuerdos... Parece una escultura de piedra hecha por los aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Por favor, nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Yo quitaré las semillas malas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Aranakula, no te preocupes. {F#La}{M#El} nara {NICKNAME} se encargará de esto, ¡seguro que será pan comido para {F#ella}{M#él}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "Tomémoslo como un lugar para almacenar comida de emergencia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
				},
				{
					"id": 730150906,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301510,
			"completionStepIds": [],
