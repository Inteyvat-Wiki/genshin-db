				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#¡Oh! ¡Gracias, nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Bosque recuerda todo cuanto ocurrió después de que nara Váruna llegase. Árboles recuerdan. Semillas recuerdan. Pero Aranakula no está seguro de si nara Váruna sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "#Por eso creamos recuerdo visible. De esta forma, cuando nara Váruna regrese, sabrá que ni bosque ni aranara han olvidado a {F#él}{M#ella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Paimon ya entiende... La piedra de los recuerdos es un monumento. En realidad, los humanos también construyen monumentos para no olvidar ciertas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Es porque los nara son seres olvidadizos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "Si los comparáramos con un bosque, los nara serían como pequeños brotes que nunca se convierten en grandes árboles, y que no son capaces de desarrollar anillos para contar los años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Aranara no pueden abandonar bosque. Aranara y bosque son uno, pero todos nara que han venido se han marchado, igual que nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Hay tantos aranara como árboles en bosque, igual que aranara tenemos tantos nombres como ramas y hojas tiene árbol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "#Nara rubi{F#a}{M#o}, tú recuerdas muchos nombres de aranara, incluso recuerdas nombre de Aranakula. Esto es igual que recoger hoja de suelo y saber de qué árbol ha caído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Para los aranara, {F#el}{M#la} nara Váruna es muy especial, ¿cierto? Por eso hicieron un monumento dedicado a {F#él}{M#ella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Aunque no eran exactamente iguales, hemos visto otras estatuas que también retrataban la apariencia de ciertas personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "¿Te refieres a las Estatuas de Los Siete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#¡Sí! Después de escuchar la historia {F#del}{M#de la} nara Váruna, Paimon apuesta que quieres saber cómo es su aspecto, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Los aranara tienen música, ¡tal vez también tengan otras cosas increíbles! Quizá sean capaces de esculpir estatuas muy realistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Si es así, la verdad es que me gustaría verlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "#¡Sí! ¡Yuju! Jeje, nara Váruna, {F#el}{M#la} nara rubi{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Por cierto, ya podemos ir a sanar la rama y las hojas de la máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Aranakula llevará a nara {NICKNAME} y a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "El arte de los aranara es muy simple, así que a saber cómo será.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#Humm... Quizá sea un arte demasiado moderno para ti, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
