			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "¿Eres Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "¡Oh, oh! ¡Nara descubrieron a Aranakula! ¡¿Y ahora qué hace Aranakula?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "¡Oye, no huyas! ¡Arapandu nos dijo que estabas aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "#B-bueno... Si Arapandu dijo a ustedes, deben de ser buen{F#as}{M#os} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Vaya, sí que confía fácilmente en los demás... ¿Qué hubiera pasado si {NICKNAME} fuera {F#una}{M#un} nara mal{F#a}{M#o} y hubiera usado el nombre de Arapandu para engañarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "#¡¿Cómo?! ¿Que est{F#a}{M#e} nara rubi{F#a}{M#o} es mal{F#a}{M#o} y quiere engañar a Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "Ahora Paimon se siente culpable por haber dicho eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "#No hagas caso a Paimon, soy {F#una}{M#un} nara buen{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#¡Menos mal! ¡Alabado sea Aramuhukunda! Nara {F#rubia}{M#rubio} es {F#buena}{M#buen} nara. Aunque seas mucho más alt{F#a}{M#o} que Aranakula, Aranakula no te teme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Paimon... Paimon es pequeña, Aranakula tampoco te teme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "Algún día tendrás que reconocer que eres pequeña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "¡Verás lo que es bueno si sigues subestimando a Paimon así! ¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Pero volviendo al tema, vinimos para reparar la máquina divina de Váruna. En esta parte del bosque también hay una rama y unas hojas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Arapandu nos dijo que viniéramos a ver cómo estaban las cosas por aquí y que, si tenías algún problema, te ayudáramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "¡Ah! Hay muchos malos en bosque... Caminos son seguros, pero hay que ir con cuidado. Además, hay semillas malas por todos lados, incluso semillas que fueron creadas para nara Váruna... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME}, eres alt{F#a}{M#o} y grande. Aranakula se pregunta si serás tan fuerte como Arabalika... Nara {NICKNAME}, ¿podrás arreglar problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "¿Podrás ayudar a Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#A eso hemos venido, ¿verdad, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "#Déjanoslo a nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula tiene otra cosa que pedir a ustedes antes de que arreglen máquina divina de Váruna. Aranakula quiere que lo ayuden a recuperar piedra de recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "¿Una piedra de los recuerdos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Bosque no olvida y aranara tampoco, pero aun así aranara creamos recuerdo visible. Cuando malos vinieron, semillas malas aparecieron por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Hablar con los aranara es como estar todo el tiempo resolviendo acertijos... Supongo que ya lo entenderemos cuando lo veamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Sea como sea, ¡vayamos con Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "#¡Nara buen{F#a}{M#o}, Paimon buena! No tenemos que alertar a malos, hay camino seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Si te refieres a los Hongos, ¡no hay de que preocuparse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#*Ejem*, Aranakula, escucha, ¡{F#la}{M#el} nara {NICKNAME} es muy fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "No. No es fuerte, ¡es superfuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "¡Ya derrotamos un montón de Hongos con Arapandu! ¡Hasta él reconoció nuestra fuerza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#Aranakula entiende. Seguro que nara {NICKNAME} es tan increíble como Arabalika. Pero ¿qué hay de Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "¿Eh? ¿Qué pasa con Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "Malos persiguieron a Aranakula, así que Aranakula tuvo que esconderse bajo tierra hasta que sacaron a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Hummm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "De grandes bocas de malos goteaba saliva. Era húmeda, caliente y desprendía olor parecido a fruta podrida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Si Arabalika no hubiese llegado a tiempo, Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "Ohh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Después de eso, Arapandu rezó durante mucho tiempo mientras sol salía y se ponía una y otra vez y semillas brotaban en jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "¡Eso es rezar durante mucho tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "¿Pero esto qué relación tiene con Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "¡Eso! ¿Qué tiene que ver todo esto con Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aunque Aranakula es más fuerte que Paimon, malos casi devoran a Aranakula. Paimon es muy pequeña, ¡tiene que tener cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#Tienes algo de razón... Espera, ¡no! {NICKNAME} es muy fuerte, seguro que puede proteger a Paimon, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#¡Jeje! Después de todo, ¡Paimon es la mejor amiga de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "#Pero es que hay muchos malos, y Aranakula no puede acabar con todos ellos... Humm... Puede que nara rubi{F#a}{M#o} sea muy fuerte, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Aranakula conoce camino seguro. Vayamos por él, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "¿Eh? Aranakula, no será que... ¿les tienes mucho miedo a los Hongos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "*Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Jeje, Paimon ya ve. ¡Pero no está bien usar a Paimon como excusa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "#{NICKNAME}, vayamos con Aranakula por el camino seguro. Tendremos que ir con cuidado para no alertar a ningún Hongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Pero yo ya tengo mucha experiencia con cosas así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Es cierto, hemos hecho cosas parecidas muchas veces en el pasado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Aranakula llevará a ustedes por camino seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "Puedes huir sola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#¡Oye! Paimon nunca dejaría que tuvieras que huir sol{F#a}{M#o}. O al menos eso cree Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Paimon es pequeña, pero tiene mucha energía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "¡Eso es! ¡Paimon es muy fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301509,
			"completionStepIds": [
				7301509
			],
