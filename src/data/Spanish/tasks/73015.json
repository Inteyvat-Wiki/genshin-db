			]
		},
		{
			"id": 7301511,
			"completionStepIds": [
				7301511
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
