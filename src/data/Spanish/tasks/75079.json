			"dialogs": [
				{
					"id": 750790701,
					"content": "Aquí estoy yo, un veterano de la vida y tu hermano mayor, para enseñarte a integrarte y convertirte en una persona popular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790702,
					"content": "Gracias por tu amabilidad, pero no es necesario. Además, no eres mi hermano mayor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Y otra cosa, ¿podrías hacerme el favor de no dar más galletas a Oberón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Guuu, aguuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750790705,
					"content": "Mocoso ignorante, si no fuera por tu hermana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790706,
					"content": "Disculpa, vengo a recoger mi premio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Oh, pero si es un pequeño Tepetlisaurio. Por aquí es inusual ver a uno de ellos. Y aquí tenemos a... Vaya, tienes una compañía de especies muy variopintas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790709,
					"content": "#¿Especies?... ¡No metas a Paimon y a {REALNAME[ID(2)|SHOWHOST(true)]} en el mismo saco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "¿Mmm? Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Espera, no, ambos somos compañeros de {NICKNAME}, pero a la vez somos diferentes. Ser diferentes no significa que uno sea mejor o peor, así que no te pongas triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "Las verdades dichas por accidente siempre son las peores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#{NICKNAME}, sabes bien que Paimon no quiso decir eso, no compliques más la cosa. ¡Paimon también considera a {REALNAME[ID(2)|SHOWHOST(true)]} un gran compañero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#Claro, {REALNAME[ID(2)|SHOWHOST(true)]} es un gran compañero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Jeje, ¡Paimon sabía que {REALNAME[ID(2)|SHOWHOST(true)]} era un saurio listo y que no malinterpretaría esas palabras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "¡Qué envidia me da la relación que tienen! A juzgar por su vestimenta, no son de aquí, pero tienen una gran confianza y amistad con el pequeño Tepetlisaurio... ¿Tienen algún truco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790718,
					"content": "Siendo sinceros, Taruka y su pequeño Qucusaurio no se llevan muy bien. Por eso preguntaba. Si hubiera algún truco para que se lleven mejor, le animaría a aprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790719,
					"content": "Volviendo al tema... ¿Y sus premios? ¿No me digas que aún no están listos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "¡Por supuesto que están listos! Tú sí que sabes cómo cambiar de tema... Ya hablaremos de eso luego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750790721,
					"content": "#Estos días va a haber una competición de vuelo. Si están interesad{F#a}{M#o}s, no se pierdan la oportunidad única de presenciar la carrera y, lo más importante, ¡no se pierdan mi gran espectáculo! Bueno, tengo que irme, ¡nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizán"
				}
			]
		},
