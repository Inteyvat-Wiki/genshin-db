			"dialogs": [
				{
					"id": 750791501,
					"content": "¡Felicidades por superar el desafío! El premio lo tendrás que recoger donde se encuentra Lamizán. Está bien cerca, no tiene pérdida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
