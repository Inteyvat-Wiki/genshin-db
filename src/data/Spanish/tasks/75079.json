			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "#No lo toques, eso es el premio. Si estás interesad{F#a}{M#o} en conseguirlo, tendrás que superar primero el circuito de entrenamiento que preparó Temach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizán"
				}
			]
		},
		{
			"id": 7507917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507907",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamizán",
					"Taruka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Oye, deberías cambiar un poco ese mal carácter que tienes por la cuenta que te trae, que ya estás muy mayor para comportarte como un niñato. Si no lo haces por tu hermana, debes considerarlo por tu propio bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750791702,
					"content": "Guuu, aguuu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750791703,
					"content": "Mira, está de acuerdo conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750791704,
					"content": "Si aquí hay alguien que debería aprender las cosas, está claro que no soy yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "¡Oye! Qué mocoso estás hecho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizán"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507909"
						],
						"stepId": 7507909
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parán"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Disculpa, Srta. Killa, ¿te ha hecho daño Can Carre? No suele mostrar tanto afecto a los desconocidos, algo así no es nada habitual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Parán"
				},
				{
					"id": 750791802,
					"content": "Jaja, no pasa nada. Estoy muy acostumbrada a interactuar con los animales, y me alegra que quiera mostrarme cariño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750791803,
					"content": "Por cierto, Hawka te extraña mucho. Cuando se enteró de que iba a venir por esta zona, me pidió que te preguntara cómo te encontrabas últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750791804,
					"content": "¿El Sr. Hawka? ¿Y por qué iba a preguntar por mí? Eh, lo siento, hemos tenido algún que otro conflicto, pero nada digno de mención...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parán"
				}
			]
		},
		{
			"id": 7507919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_STATE_NOT_EQUAL",
						"rawParams": [
							"7507909",
							"3"
						],
						"stepId": 7507909,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lliwa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791901,
					"content": "Qué quebradero de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "La cosa es que tengo un hermano pequeño al que le saco muchos años, y está en una edad rebelde y no se lleva bien con nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "Ay, contarte esto tampoco soluciona nada. ¡Solo espero que se le pase con los años!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "No te molesto más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "No pasa nada, adiós.",
					"roleType": "TALK_ROLE_NPC",
