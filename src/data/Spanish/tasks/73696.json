			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bahar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "#Hola, viajer{F#a}{M#o}. Humm... Vienes a visitar la Feria de la Academia, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "¿Te apetece probar una actividad que organiza la Facultad Haravatat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "¿Y la Facultad Haravatat se dedicaba a...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "En líneas generales, se dedica al lenguaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "Eso es lo que investigamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "¿Qué piensas? ¿No te parece que vaya acorde al ambiente festivo y relajado de la feria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "Muchos compañeros de la facultad y yo también lo pensamos. Todos se lo están pasando genial con juegos divertidos, así que no íbamos a arruinar la diversión poniendo las típicas adivinanzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "Además, es imposible captar el interés de la gente con ellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "Tras discutirlo “amistosamente” durante varios días, elaboramos este pequeño juego llamado “En busca de la verdad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "Este juego no requiere de muchas herramientas. Tan solo necesitas tener la mente clara y organizar tus ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "Al comienzo de este juego, te contaré una historia. A lo mejor te parece que no tiene ni pies ni cabeza e incluso que va en contra del sentido común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "Tú me podrás hacer preguntas, las cuales yo solo puedo responder con “<color=#00E1FFFF>sí</color>”, “<color=#00E1FFFF>no</color>” o “<color=#00E1FFFF>es irrelevante</color>”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "Lo que tienes que hacer es llegar a la verdad con las preguntas que me vayas haciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "No te preocupes, la verdad que se esconde detrás de las historias no es muy complicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "#¿Y bien? Si estás preparad{F#a}{M#o}, ¿empezamos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "Cuando quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "#Muy bien. Atent{F#a}{M#o} a la primera historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "Tengo otras cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Estaré aquí durante la feria. Puedes venir cuando quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}