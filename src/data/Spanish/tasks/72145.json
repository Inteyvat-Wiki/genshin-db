			"dialogs": [
				{
					"id": 721450101,
					"content": "“... Se dice que el emisario de Omikami tiene tres ojos: uno es el alma, otro un espejo, y el último la verdad...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Estela antigua"
				},
				{
					"id": 721450102,
					"content": "“... Surgió de las profundidades, cruzó del <color=#00E1FFFF>sur</color>, al <color=#00E1FFFF>norte</color>, y por toda la elevación del <color=#00E1FFFF>oeste</color>...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Estela antigua"
				},
				{
					"id": 721450103,
					"content": "“... Los tres ojos relucieron sin piedad para repeler al dragón...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Estela antigua"
				},
				{
					"id": 721450104,
					"content": "Paimon no tiene ni idea de qué quiere decir todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Parece que no hay ninguna pista por aquí... ¿Por qué no pruebas usando tu <color=#00E1FFFF>Visión Elemental</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
