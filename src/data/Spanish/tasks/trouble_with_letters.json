						411260803
					]
				},
				{
					"id": 411260803,
					"content": "Una carta de papá... Bah, ya sé lo que pone en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260804,
					"content": "Seguro que dice que no ha podido venir por trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260805,
					"content": "Cuando esos soldados de la Geoarmada vinieron, pensé que papá también vendría, pero ya veo que no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260806,
					"content": "Supongo que no es tan malo. Sería muy peligroso si esas piedras gigantes hubieran caído mientras papá está en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260807,
					"content": "¿No tienes miedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "Bueno... un poco. Pero con la Geoarmada por aquí, no puede ocurrir nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260811,
					"content": "¡Cierto! ¿Podrías llevarle esta carta a mi papá? Seguro que está preocupado por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260812,
					"content": "Qué extraño... Siempre que papá se quiere tomar un día libre para venir a verme, algo ocurre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 411260809,
					"content": "No deberías estar por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
					"content": "Ya lo sé. Los soldados de la Geoarmada ya me lo dijeron mil veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Pequeña Liu"
				}
			]
