			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "*Suspira*, no sé qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "¿Qué pasó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "Tú también viste esos meteoritos que cayeron del cielo, ¿verdad? Por suerte, no cayeron en la ciudad, pero han causado un gran desastre en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "No solo bloquean los caminos, sino que parece que han afectado a los monstruos que había cerca. Se han vuelto más violentos y peligrosos, y están atacando a transeúntes y comerciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "El Ministerio de Asuntos Civiles ha enviado a casi todos los soldados de la Geoarmada disponibles, pero Liyue es demasiado grande. Solo podemos garantizar la seguridad de los caminos principales y algunos pueblos clave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "Solicité ir a la Aldea Chingtsé para hacer guardia allí, pero por alguna razón me reasignaron aquí hasta nueva orden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "#Viajer{F#a}{M#o}, ¿podrías llevar esta carta hasta la Aldea Chingtsé? Es para una niña llamada Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "Es mi hija. Le dije que iría a pasar unos días con ella, pero ha surgido algo urgente y no creo que pueda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "Muchas gracias. *Suspira*, qué mala suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "Dicho esto, algunos soldados que volvieron de patrullar dijeron que hay bastantes monstruos cerca de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "#No quiero sonar entrometido, pero... por tu forma de vestir, debes ser {F#una aventurera}{M#un aventurero}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Cuando lleves mi carta, ¿podrías despejar los alrededores de la Aldea Chingtsé primero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "La Geoarmada suele proteger los caminos y pasos principales. Las cosas podrían ponerse muy mal si esos monstruos entraran en la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Muchas gracias, en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Eso cuenta como encargo extra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Sí... Pero no te preocupes, tendré preparada una buena recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "No es tu culpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Lo sé, pero... *Suspira*, no lo entiendo. Siempre vez que quiero tomarme un día libre, ocurren estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "Es demasiado extraño para ser una coincidencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Muchas gracias. Entonces, llévale esta carta a la pequeña Liu, en la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
