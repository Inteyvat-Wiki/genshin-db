				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#Cuánto tiempo, {NICKNAME} y Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130102,
					"content": "¿Fréminet? ¿Por qué llevas puesto el casco de buceo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130103,
					"content": "¿Acabas de salir del agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "Ajá... Las cosas por allá abajo han estado un poco agitadas últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130105,
					"content": "Hay muchos más buzos que de costumbre, todos frenéticos intentando recuperar mercancías hundidas. Lo único que puedo hacer es echar una mano como sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130106,
					"content": "Cuanto antes terminemos de limpiar, antes podrán retornar a sus trabajos y antes volverá el mar a su habitual paz y tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130107,
					"content": "Así que es eso... Debe ser muy difícil para ti adaptarte a tanto alboroto, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130108,
					"content": "Gracias por preocuparte, Paimon. Aunque tampoco ha sido tan malo. De hecho, he conseguido algunas cosas... como joyas y antigüedades sin dueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130109,
					"content": "Padre dijo que si rescataba cosas bonitas o valiosas, debía traerlas aquí. Dijo que tú sabrías darles un buen uso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130110,
					"content": "¡Qué considerada que es Arlecchino! Si tienes algún adorno bonito que no quieras, podríamos usarlo para decorar el acuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130111,
					"content": "O mejor aún, ¿por qué no vamos a buscar tesoros contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130112,
					"content": "#¿Están segur{F#a}{M#o}s? No me gustaría quitarles demasiado tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130113,
					"content": "¡No te preocupes por eso! Ya has dicho que podremos quedarnos con cualquier objeto sin dueño que encontremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130114,
					"content": "¡Pero no podemos dejarte hacer todo el trabajo solo! ¡A Paimon no le parece bien quedarse aquí de brazos cruzados mientras otros hacen el esfuerzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130115,
					"content": "Además, ¡encontrar las cosas ya es entretenido en sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "En ese caso... Les contaré todo lo que me han dicho los otros buzos. Con suerte, eso les ayudará a acotar la búsqueda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130118,
					"content": "Si encuentran algo que les llame la atención, pueden quedárselo... Aunque hay cosas que tienen dueño, así que si dan con algo así, tendrán que devolverlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130119,
					"content": "¡Entendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130120,
					"content": "Por favor, tengan cuidado y no se aventuren por aguas desconocidas. Si se encuentran en peligro, asegúrense de salir a la superficie lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747130116,
					"content": "#¡A nosotr{F#a}{M#o}s también nos encanta buscar tesoros bajo el agua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}