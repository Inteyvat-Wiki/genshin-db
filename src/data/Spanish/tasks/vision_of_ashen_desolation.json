						401720203
					]
				},
				{
					"id": 401720203,
					"content": "Muy bien, vamos allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401720204,
					"content": "Necesito un momento.",
