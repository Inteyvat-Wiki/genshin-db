			"dialogs": [
				{
					"id": 220330601,
					"content": "¿Eh? Este plato tiene un sabor... interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Bueno, más que interesante... la palabra es... único, o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "¿Cómo se te ocurrió este plato? Tus habilidades culinarias son... de otro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "#¡Gracias, viajer{F#a}{M#o}! Toma esto, por favor. ¡Mmm! Me lo guardaré para degustarlo más tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
