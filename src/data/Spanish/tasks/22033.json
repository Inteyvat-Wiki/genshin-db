			},
			"dialogs": [
				{
					"id": 220330801,
					"content": "Ah, me encantaría comer algo de comida de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330802,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330803
					]
				},
				{
					"id": 220330803,
					"content": "#La ropa que llevas... Eres {F#la}{M#el} viajer{F#a}{M#o}, ¿verdad? Disculpa, siento un poco de nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330804,
						220330805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330804,
					"content": "¿Acabas de decir que querías comer algo de comida de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				},
				{
					"id": 220330818,
					"content": "¿Eh? Será que... ¿Sabes hacer comida de Liyue? ¡Eso es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330819,
					"content": "E-entonces, ¡por favor, ayúdame! ¡Prepárame algunos platos auténticos de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330820,
					"content": "Déjame pensar... Lo que más me gustaría comer ahora es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330821,
					"content": "Quiero comer algo dulce. Sí, algo de Liyue que sea simple y dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330822,
					"content": "Últimamente, cuando duermo, sueño con un apuesto y encantador caballero hecho de dulces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330823,
					"content": "Sus botas están hechas de arroz, su corona está hecha de tofu, lleva una capa de bolitas de arroz y sostiene un abanico hecho de una exquisita masa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330824,
						220330825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330824,
					"content": "Me parece que algo así solo atraería ratones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330826,
					"content": "Caminaba entre las tiendas de dulces de la calle con una suave fragancia mientras pasaba junto a mí. Nunca podré olvidar ese aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330827
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330827,
					"content": "Por favor, tráeme al caballero del dulce, ¡cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330825,
					"content": "Qué malgasto de arroz y harina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330826
					]
				},
				{
					"id": 220330805,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330806
					]
				},
				{
					"id": 220330806,
					"content": "Deja que me presente. Soy Tang Wen, una historiadora de Liyue. Estaba haciendo una investigación de campo sobre las costumbres y el folclore únicos de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330807,
					"content": "Estaba a punto de regresar a Liyue, ya que casi he terminado de recopilar la información que necesitaba. Pero últimamente sucedieron demasiadas cosas en Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330808,
					"content": "Siento que estoy viviendo un momento histórico para Inazuma, ¿saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330809,
					"content": "Este periodo en particular pasará a los anales de la historia de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330810,
					"content": "Ser testigo de esa historia y registrarla de una manera real, completa y clara para la posteridad es lo que debe hacer un historiador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330811,
					"content": "Pero... por muy emocionante que me resulte, esta causa no me llena el estómago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330812,
					"content": "¿Tienes hambre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330813
					]
				},
				{
					"id": 220330813,
					"content": "No exactamente, es solo que... la comida de Inazuma es bastante sabrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330814,
					"content": "Me encanta la tempura, aunque, bueno... me da la sensación de que solo es comida rebozada y frita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330815,
					"content": "Pero después de comer la cocina de Inazuma durante un tiempo, empecé a extrañar los platos de Liyue. Lamentablemente, no pude encontrar un restaurante que pudiera hacer auténtica cocina de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330816,
					"content": "Finalmente, decidí publicar un encargo culinario en el Gremio de Aventureros hace unos pocos días, pero aún no recibí respuesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330817,
					"content": "Tal vez yo podría intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330818
					]
				}
			]
		}
	]
