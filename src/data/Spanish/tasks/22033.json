				{
					"id": 220330701,
					"content": "¿Cuál de todos preparamos? Deberíamos elegir uno por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Veamos... Últimamente, los dulces favoritos de Paimon son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330703,
					"content": "¡Las baratas, pero deliciosas, bolitas de harina de arroz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330704,
					"content": "¡Las deliciosas y hermosas estrellitas de loto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330705,
					"content": "¡Y el suave y glutinoso dango tricolor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330706,
					"content": "¿Esos no son tus platos favoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Jeje, ¡confía en los gustos de Paimon! Vamos, elige uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330708,
					"content": "Bolitas de harina de arroz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "¡Me parece genial! ¡Preparemos unas bolitas de harina de arroz para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330710,
					"content": "Hummm... estrellitas de loto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "¡Sí! ¡Preparemos unas estrellitas de loto para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330712,
					"content": "Creo que el dango tricolor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "¡Bien! ¡Preparemos dango tricolor para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330714,
					"content": "Déjame pensarlo...",
