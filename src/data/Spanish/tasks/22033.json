			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "¿Eh? Creo que esto sigue siendo un plato de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330502,
					"content": "No creo que sea el plato que pedí... Bueno, no importa, también llena el estómago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330503,
					"content": "#Gracias de todos modos, viajer{F#a}{M#o}. Toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203306,
