			"dialogs": [
				{
					"id": 220330301,
					"content": "¡Ah! ¡Eso es! Este es el sabor que estaba buscando... Es tan... *Snif*, estoy conmovida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "¡Muchas gracias! Toda esta buena comida me llena de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "Esto es para ti, ¡te deseo un buen viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203304,
