			"dialogs": [
				{
					"id": 760241501,
					"content": "¡Guau! ¡Mira, es la familia Topo! El abuelo, los papás, el pequeño Topo y el pequeñín Topo... ¡Todos están aquí! ¡No falta ninguno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "¡Conque eran topos olfateadores! Pero Auni, ¿cómo los diferencias? ¡Se ven todos igualitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Cada uno tiene su personalidad. Lo sabrás con el tiempo cuando los vayas conociendo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Aunque todos tienen el mismo mal hábito de mendigar comida. *Suspira*, pobres animalitos... Si los humanos se extinguieran, ¿qué harían ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "¿Si se extinguieran? ¿Y los topos olfateadores sobrevivieran? Paimon no cree que vaya a pasar eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Linnéa dijo que los animales pueden extinguirse por muchas razones. Así que los humanos también podríamos extinguirnos. ¿Por qué piensas que eso no puede pasar, pequeña Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "Diría que voy a vivir más que un topo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Bueno, pero sigues sin responder realmente a la pregunta de Auni... Ahora que Paimon lo piensa, ¡los humanos sí que están en peligro constante! Hay tantas cosas que podrían amenazar su existencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Pero bueno, ahora que ya dimos con toda la familia de los topos olfateadores, ¿qué vamos a hacer con estos tres hurones ladrones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Si no saben qué hacer con ellos, dejen que los del Buque Insignia se encarguen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "#¡Un cofre! O... ¿deberíamos llamarlo soborno en este contexto? Bueno, lo que sea, como es para nosotr{F#as}{M#os}, ¡lo aceptamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Parece que saben que se portaron mal. {NICKNAME}, dejémoslo pasar esta vez. Qu-que quede claro que Paimon no lo dice por el cofre, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Dicen que hay insectos que ya existían mucho antes de que los humanos aparecieran en el mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Y seguramente seguirán aquí cuando ya no quede ni rastro de nosotros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "¿Estás diciendo que los insectos son más fuertes? ¡Paimon no lo puede aceptar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
