			"dialogs": [
				{
					"id": 760240101,
					"content": "¡Ja! ¡Ahora sí que no tienen escapatoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Es la primera vez que veo al hurón ladrón jefe tan de cerca... Deberías tratarlo con respeto, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "¡¿Qu-qué?! ¡Ni de broma Paimon va a mostrarle respeto a un hurón ladrón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Sí, tienes razón. Los niños malos no deberían ser tratados con respeto. Tampoco creo que alguien fuera a su funeral... De hecho, dudo que alguien organice uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Ah, cierto. Una vez oí a Helka decir que había gente rara que comía carne extraña, como, por ejemplo, hurones ladrones. También hay tipos que coleccionan especímenes disecados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Ahora que lo pienso, ya sea como espécimen o como comida, no haría falta organizar ningún funeral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Puaj, Auni... ¿Cómo dices algo tan espeluznante como si nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Parece que está muerto de miedo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Hurón ladrón jefe"
				},
				{
					"id": 760240136,
					"content": "¡Espera! ¡A dónde vas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "¿Eh? No estaban huyendo... ¿Nos están esperando? Vayamos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
