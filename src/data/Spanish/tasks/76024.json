							9700.62
						],
						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "¿Sabes? Paimon se ha dado cuenta de que todos los hurones que escaparon huyeron hacia esa colina de allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Sí. Es algo que trajeron esos grandullones que entrenaron a los hurones. El hurón jefe lo usó para atacarlos, y los grandullones acabaron rodando por el suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Me cuesta imaginármelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#En fin, vayamos a investigar la colina. Aunque, conociendo a los hurones ladrones, puede que nos estén esperando para emboscarnos. {NICKNAME}, ¡ten cuidado de no acabar rodando tú también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "¡Arg! Si yo hubiera estado ahí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "¿Habrías ido a ayudarlos? Espera... ¿o solo querías ver el desastre en vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602405,
			"completionStepIds": [
				7602414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
