					"Auni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760240801,
					"content": "Ah, cierto... Todavía tengo que organizar el funeral. ¿Debería invitar al resto de la Banda Caracola...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "¿La Banda Caracola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "¿Quieres unirte? Entonces ve a buscar a Jurva, está en el Speranza. Ehmm... Aunque si hay que votar, Helka no está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Pero no importa, seguro que Jurva sabrá qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "¿Qué opinas del comportamiento de los topos olfateadores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Yo creo que es porque llevan mucho tiempo viviendo con humanos. Por eso hacen cosas como nosotros. Igual que los hurones ladrones. Incluso dicen que en Natlan hay saurios que actúan así también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Aunque... no sé si eso es algo bueno o malo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "¡Cuídense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
