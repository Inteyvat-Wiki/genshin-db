						"pointId": 360700068
					}
				]
			},
			"dialogs": [
				{
					"id": 760240501,
					"content": "No sabes lo qué está pasando, pero te aproximas a la niña...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "#Tengan cuidado con los hurones ladrones. Llevan ocupando el Desfiladero de los Topos desde hace tiempo. Si l{F#as}{M#os} golpean, también se convertirán en personas sin sombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "¿Hurones ladrones? ¿Dónde? ¿Qué es eso de personas sin sombra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "¡Aaah! ¿Qué pasa con esa máquina? ¿Será que los hurones ladrones la están controlando para atacarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "#Estos fueron criados por humanos. Puede que incluso sean más inteligentes que nosotr{F#a}{M#o}s. Quizá por eso lograron ahuyentar a los grandullones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "Los grandullones también lo intentaron, pero fracasaron. Decían que bastaba con <color=#00E1FFFF>sacar el núcleo de energía</color>, pero no parece que sea algo fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Humm... Así que si sacamos ese núcleo de energía, el hurón ladrón ya no podrá hacer nada, ¿verdad? ¿Qué dices, {NICKNAME}? ¿Lo intentamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "No podemos dejarlo pasar. Es peligroso, y más aún si hay niños por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Si me lo pides tú, Paimon, ¡por supuesto que no hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Jeje, entonces, pequeña, quédate escondida por aquí mientras tanto... Ah, por cierto, ¿cómo te llamas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Pero... ¿por qué me estás llamando pequeña? No entiendo... Me llamo Auni, y creo que deberías tratarme como a una niña mayor que tú. Eso es lo adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#Eh... ¡dejemos el asunto de los tratos a un lado! {NICKNAME}, ¡vamos a detener a los hurones ladrones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
