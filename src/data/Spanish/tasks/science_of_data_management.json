						],
						"pointId": 6694
					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Y eso es prácticamente todo... Espero que la información les resulte útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "¿Todavía estás aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#¡Vaya! Me alegro mucho de verte, investigad{F#ora}{M#or} sénior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Efectivamente, según las instrucciones del Sr. Raimundo, sigo aquí, organizando la información y los expedientes... Oye, ¿no había dicho eso ya antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Este lugar es muy grande, y hay demasiado trabajo para que lo hagas sola. ¿Cómo es que Raimundo no ha enviado a nadie para ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "En el Instituto de Ciencias están muy ocupados, es natural que no les sobre nadie que puedan enviar a echarme una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Pero eres la jefa, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Ah, ¿te refieres al título de “Jefa del Equipo de Recuperación Bibliográfica”? Vamos, no te burles de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "No soy una directora en sentido estricto. Desde el principio, he sido simplemente una empleada más a cargo de la organización del expediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Cuando el Sr. Raimundo me encomendó esta tarea, me dieron ese título, nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Por lo que me dijeron, fue idea del Sr. Choiseul. Decía que estábamos esforzándonos mucho y que lo del título era una forma de que pudiésemos cobrar un poco más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "¡Ah! No le digas a nadie que dije eso, por favor, yo... Ay, ¿por qué habré abierto la boca...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "No se lo voy a decir a nadie, no te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "No suena nada mal. Está muy bien que la gente que trabaja mucho reciba una buena remuneración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Pero... ¿por qué tienen que hacerlo de una forma tan complicada? ¿No sería más sencillo que les subieran el sueldo directamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "En el Instituto de Ciencias es algo habitual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "No sé, me veo incapaz de comprender la forma de pensar del Sr. Choiseul y el Sr. Raimundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "En cualquier caso, lo que tengo que hacer es seguir trabajando. Aún tengo muchas cosas pendientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "#Investigad{F#ora}{M#or} sénior, si no te importa, ¿me puedes echar una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "El deber me llama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Bien, ayúdame a limpiar toda esta suciedad que hay alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Y mientras limpias, procura <color=#00E1FFFF>no tocar los expedientes que hay al lado</color>. Sería una catástrofe que se ensuciasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Lo dejo en tus manos, que tengo que seguir organizando los expedientes por aquí. Ay, no me imaginaba que hubiera tantos en el despacho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "¡Una tarea más que añadir a mi honorable historial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Jajaja... Claro que sí. Si hace falta corroborar tus buenas intenciones, aquí me tienes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "¿Qué importa? Siempre que acabe en el bolsillo de uno, está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
		{
