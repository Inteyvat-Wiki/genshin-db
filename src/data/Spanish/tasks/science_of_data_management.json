				"points": []
			},
			"dialogs": [
				{
					"id": 240160301,
					"content": "Oh... Mil gracias por tu ayuda. Si no fuera por ti, no sé durante cuánto tiempo tendría que haber estado limpiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "#De verdad eres dign{F#a}{M#o} del título de investigad{F#ora}{M#or} sénior honorífic{F#a}{M#o}: siempre sacas a relucir tu destreza, sea para lo que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "No soy una persona común y corriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "#Te agradezco de nuevo tu ayuda, investigad{F#ora}{M#or} sénior. Toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Tengo un talento especial para la limpieza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#¿Ah? Realmente eres una persona de muchos talentos. ¡Como cabría esperar de {F#una}{M#un} investigad{F#ora}{M#or} sénior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
