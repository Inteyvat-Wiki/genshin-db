			"dialogs": [
				{
					"id": 240160401,
					"content": "Oh... Mil gracias por tu ayuda. Si no fuera por ti, no sé durante cuánto tiempo tendría que haber estado limpiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Sin embargo, habría estado muy bien que me hubieses ayudado con un poquitín más de cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "¡No me malinterpretes! No quiero culparte de nada, has sido de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "#Ten, toma esto. Muchísimas gracias por tu ayuda, investigad{F#ora}{M#or} sénior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "#La próxima vez seré más cuidados{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
