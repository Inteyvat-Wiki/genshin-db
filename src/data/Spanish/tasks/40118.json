			"dialogs": [
				{
					"id": 401181101,
					"content": "Es la primera vez que tomo un té con este sabor. Parece que el té de Inazuma es muy diferente del que tenemos en Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah, sí. Creo que la gente de Sumeru suele ponerle especias al té, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Así es, pero no estoy acostumbrada a tomarlo así. Si me dieran a elegir, prefiero el café, pero es que me quita el sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
