				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "A mí me encantaría subir en el Chitty-Chitty Volador con la Srta. Gran Estratega, pero parece que suele marearse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Klee, eres muy perspicaz. ¿Cómo te diste cuenta? ¿Viste un montón de estrellas bailando en sus ojos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Hoy hay unas cuantas menos. ¡Pero ayer había un montóóón de ellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Si mamá estuviese aquí, probablemente diría que las estrellas son peces que cayeron en las nubes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
