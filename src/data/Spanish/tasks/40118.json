					"Lessig",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Yo, el noble descendiente de la familia Lawrence, aprendí a hacer unas cuantas cosas por el camino... ¡Como hornear pastelillos, por ejemplo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Con esta temperatura debería bastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Nunca habría pensado que serías capaz de hornear unos pastelillos. Pensé que eras de esas personas que nunca se acercan a la cocina siquiera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Llegas justo a tiempo. ¿Tienes un momento? ¿Me puedes enseñar a preparar unos aperitivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "¿Cómo? Pero eso lleva mucho tiempo. Además, no estamos aquí para hacer actividades en familia, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Ya veo. Entonces, ¿todavía te preocupan estas cosas? Dijiste que somos gente corriente. Pues entonces, enséñame cosas como hacen los primos normales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
