			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Unas pesadas cajas, viejas y rotas, cubiertas de una gruesa capa de polvo. Las han abandonado en este lugar de repente, casi arruinando la brillante limpieza de las calles de la Corte de Fontaine.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Cajas extrañas"
				},
				{
					"id": 741500702,
					"content": "(En la parte inferior de las cajas hay unas manchas de agua de hace tiempo, como si las hubieran dejado alguna vez en un lugar con mucha humedad.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Cajas extrañas"
				},
				{
					"id": 741500703,
					"content": "(Parece incluso más apremiante tirar estas cajas mugrientas que limpiar las manchas de la entrada.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cajas extrañas"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415001",
