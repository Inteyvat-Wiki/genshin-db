				]
			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Gracias, Moli. Tu amabilidad resalta tus hermosos ojos de color calavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Jeje, ¿de verdad? ¿De verdad que le gustó la muñeca que le traje la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500103,
					"content": "Oh, claro. Por supuesto. Era muy adorable. Incluso le hice un hueco especial en la mesa para cenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "¡Eso seguro que la hace muy feliz! ¿Y hoy, necesita que le lleve a dar un paseo o le recoja el periódico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500105,
					"content": "Y si le cuesta leerlo, también puedo hacerlo por usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500106,
					"content": "Mi mamá dice que todos los días debo hacer una buena acción, y mi tutora me ha pedido que esta semana le entregue una redacción sobre buenas personas y buenas acciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500107,
					"content": "Eh... No digo que quiera ayudarle porque tengo que escribir una redacción, pero si fuera posible, me gustaría ayudarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500108,
					"content": "Jaja, no es necesario. La mejor ayuda que podrías darme es decirle a tus padres que vienes a jugar conmigo a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Lo sé, Sr. Leroy, ya se lo he dicho, pero no parece que les haga mucha gracia la idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500110,
					"content": "Entonces, ¿vas a seguir viniendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Por supuesto, aunque no me dejen. Tenemos un trato, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500112,
					"content": "Jaja, eres una niña de palabra. Buena chica. El abuelo Leroy te aprecia mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "#Ah, son ustedes. Bienvenid{F#a}{M#o}s, amables amig{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "*Ejem*... No queríamos interrumpir su conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "¿Los hemos interrumpido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "No, no. No han interrumpido nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Mi pequeña amiga Moli iba de un lado a otro intentando hacer sus tareas, y casualmente acabó en mi casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Ella quiere ayudarme haciendo una buena acción, y así tener algo sobre lo que poder escribir una redacción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "¡No estoy ayudando para hacer mis deberes! Bueno, al menos, no solo por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500120,
					"content": "Claro, claro. Sé que eres una buena niña, y que tu amabilidad no se debe a tus tareas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "#Al igual que est{F#a}{M#o}s dos jóvenes invitad{F#a}{M#o}s, que tampoco han venido a visitarme porque necesiten trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "#Bueno... Nosotr{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "No se preocupen, solo era una pequeña broma. Espero que no se hayan enfadado con este anciano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "#Los jóvenes tienen mucho tiempo para gastar libremente, y ustedes están dispuest{F#a}{M#o}s a invertirlo aquí, conmigo. Y como yo disfruto de la compañía de gente joven... No tiene nada malo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Les daré algo que hacer. La gente va y viene por este barrio, el polvo se amontona rápidamente delante de mi casa, y la parte detrás de mi casa no se barre desde hace unos días, así que voy a pedirles que me ayuden de nuevo a limpiarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "Ah, de acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Moli, ¿quieres jugar un rato con mi gata? Ah, y de paso dale un poco de pescado. Por cierto, se llama Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Heredó el nombre de una perrita que tuve. Es una pena, pero mi hija anterior se la llevó cuando se casó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "De acuerdo, Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500131,
					"content": "Bueno, vayan, jóvenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
