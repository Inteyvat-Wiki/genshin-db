			"dialogs": [
				{
					"id": 741500301,
					"content": "¿Han terminado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Sí, terminamos de limpiar, y Moli dio de comer a la gata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Por cierto, Benoit. Hay un montón de cajas viejas y sucias cerca de tu casa. ¿Quieres que nos encarguemos de ellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "¿Cajas? Ah, no se preocupen. Las uso para guardar cosas antiguas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Contienen muebles y otros objetos pequeños de mi antigua casa que me ha dado pena tirar... Pero, al mismo tiempo, no encajan en mi casa actual, así que han acabado apiladas allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "No suelo tocarlas, pero como aquí todo el mundo es muy decente, nadie ha robado nada, así que pueden quedarse donde están.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Sr. Leroy, Sr. Leroy, ¿le he sido de ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500309,
					"content": "Claro que sí, Moli. No olvides saludar a tus padres de mi parte. Te estaría muy agradecido si pudieras hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "#Por aquí tengo los postres y el dinero, niñ{F#a}{M#o}s. Tomen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "No, no hace falta que me dé dinero, solo me gustaría acariciar a Nana un poco más. ¿Puedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500312,
					"content": "Claro, por supuesto. Cuidado con sus uñas, y recuerda venir a tomar el postre cuando termines de jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "¿Por qué has salido, papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500314,
					"content": "Bueno, me sentía solo sin tener a mis niños cerca, así que salí a respirar un poco de aire fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "¿Ves? Morticia. Nos hemos ido solo unos días, y papá ya está disgustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500316,
					"content": "Aunque si supiera el regalo que le hemos traído esta vez, seguro que nos perdonaría, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500317,
					"content": "Mhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "¿Un regalo? ¿Qué han traído?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Algo bueno, por supuesto. En cuanto lo veas lo sabrás. Morticia sabe que te gustan las cosas caras y bonitas, así que lo escogió especialmente para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500320,
					"content": "Gracias, hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "No hay de qué, padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "#Ah, sí. Est{F#a}{M#o}s dos pequeñ{F#a}{M#o}s invitad{F#a}{M#o}s son un{F#a}{M#o}s jóvenes que vinieron a jugar conmigo mientras estaban fuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Hola. Mi suegro es un buen hombre al que le encantan los niños, así que gracias por hacerle compañía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500324,
					"content": "Pero ahora que mi mujer y yo estamos de vuelta, nos encargaremos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500325,
					"content": "Me alegro de que estén de vuelta. Echémosle un vistazo a ese regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "Claro, papá. Volvamos a casa, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "De acuerdo. Atos, recuerda darles unos postres y una recompensa. Me han ayudado a limpiar y a darle de comer a Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "Ah, y a esa pequeña de ahí, dale también un postre. Voy adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Sr. Leroy, Nana me ha dejado rascarle la barriguita... ¿Eh? ¿A dónde ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500330,
					"content": "¿Estás buscando al Sr. Leroy, pequeña? Soy su yerno, aunque me trata como si fuera su hijo. Me llamo Atos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500331,
					"content": "Sé lo que significa yerno. Quiere decir que eres el marido de su hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500332,
					"content": "Jaja, qué niña más lista. Gracias por hacer compañía a mi suegro. Él está dentro ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500333,
					"content": "Estos postres son para ti. Ahora, nos encargaremos mi mujer y yo de cuidarlo. No te preocupes si no vienes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500334,
					"content": "Deberías volver pronto a casa. Tu familia estará preocupada si estás mucho tiempo fuera jugando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500335,
					"content": "Ah, no te preocupes. No es ninguna molestia. Además, el Sr. Leroy y yo tenemos un trato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500336,
					"content": "Creo que aún va a necesitar mi ayuda. Ya sabes, para darle de comer a la gata, regar las plantas y esas cosas. Ayudar a la gente también me hace feliz, ¡así que seguro que volveré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500338,
					"content": "*Tch*, ese es precisamente el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500339,
					"content": "¿Eh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500340,
					"content": "No es nada, jovencita. Hay algo importante que quiero discutir contigo. Bueno, más que discutir, que quiero pedirte que hagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500341,
					"content": "Claro. ¿En qué puedo ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500342,
					"content": "Te voy a dar los postres y tu recompensa, pero después de eso, no vuelvas más. ¿De acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500343,
					"content": "¿Eh? ¿Por qué? ¿He hecho algo mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500344,
					"content": "No, claro que no. Es solo que la salud de mi suegro siempre ha sido algo delicada, y su insomnio últimamente ha empeorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500345,
					"content": "Por su salud, mi mujer y yo esperamos que tenga un ambiente tranquilo para descansar. Lo entiendes, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500346,
					"content": "Oh, así que el Sr. Leroy no se encuentra bien... Entiendo. La próxima vez le traeré unas burburanjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500347,
					"content": "Cada vez que como demasiados pasteles y me duele la barriga, papá me dice que debería comer menos dulces y más fruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500348,
					"content": "Si el Sr. Leroy come más fruta, seguro que se pone bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500349,
					"content": "... *Suspira*. En fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500350,
					"content": "En cuanto a ustedes dos, aquí están sus postres y su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500351,
					"content": "Ahora, se lo diré con claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500352,
					"content": "En nombre de la familia Leroy, espero que no vuelvan a molestarnos en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500353,
					"content": "Creo que, aunque sean jóvenes, son capaces de entender lo que digo. Así que, por favor, no vuelvan por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500354,
					"content": "Eso es todo. Me voy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500355,
					"content": "Hum, ¿por qué no podemos volver? ¡Es muy extraño! El Sr. Leroy es muy amable, pero este señor... ¿por qué no quiere que volvamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500356,
					"content": "Sí, este tipo es muy educado, pero es más frío que el hielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Pues me da igual lo que diga. Pienso volver mañana a ver al Sr. Leroy. ¿Ustedes también vendrán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500358,
					"content": "¡Tienen que venir! Nana es muy adorable y me gustaría acariciarla más. Además, el Sr. Leroy nos dará postres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500359,
					"content": "Vendremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "#Nada de echarse atrás, ¿eh? Tenemos que acariciar junt{F#a}{M#o}s a la gatita y jugar con el Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500361,
					"content": "Veremos cuando tengamos tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "De acuerdo. Entonces, ¡hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				}
			]
		},
