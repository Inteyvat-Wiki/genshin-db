			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Oh, no te molestes en llamar a esta hora. Morticia y Atos no están en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500802,
					"content": "Dijeron que regresarían hoy, pero parece que se han retrasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500803,
					"content": "Ese es el problema con los niños que se hacen adultos. Siempre tienen sus propios asuntos de los que encargarse, y no suelen estar cuando los necesitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		}
	]
}