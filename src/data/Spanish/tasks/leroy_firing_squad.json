			"dialogs": [
				{
					"id": 741490601,
					"content": "¿Es el periódico? Déjalo en la entrada, gracias. Lo recogeré más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Hoy ya has ayudado a Benoit. No sería apropiado molestarlo durante su descanso. Ya que acordaron verse de nuevo al día siguiente, lo mejor será hacerlo así.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Llamar una vez"
				}
			]
		},
