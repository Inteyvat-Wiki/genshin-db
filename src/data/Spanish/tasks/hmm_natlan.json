			"dialogs": [
				{
					"id": 250360101,
					"content": "... ¿Tan sencilla es esta pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Oh, lo siento, estaba perdido en mis pensamientos y no me había dado cuenta de que estabas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Saludos. Soy Keita, de los Augures Vientonocturno. Estoy aquí como aprendiz, y me encargo de la gestión de documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "¿En qué estabas pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... Solo cavilaba sobre algunas preguntas sencillas del pasado, presente y futuro de Natlan. Nada que merezca la pena mencionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "Parece que provienes de tierras lejanas. Puedo detectar que posees vastos conocimientos y contactos importantes en múltiples lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Si tienes un momento, prueba a contestar las preguntas que tengo aquí registradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "La respuesta a tales preguntas se encuentra en tus viajes... Ya sean pasados, presentes o futuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
