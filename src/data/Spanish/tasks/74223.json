			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veniero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Ciento treinta y seis... Bien, ¡unas catorce veces más y podré descansar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230202,
					"content": "¿Quieres que te ayude?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "¿Ayudarme? No, no. No es necesario. ¿De qué serviría un entrenamiento si se hace con ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230204,
					"content": "¡Solo los más fuertes pueden llegar a ser como este oficial y convertirse en uno de los soldados de la gloriosa Legión Inmortal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230206,
					"content": "Ah, sí, olvidé presentarte a mi instructor. Solo podré ascender si supero las pruebas que él me pone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230207,
					"content": "Eh... Pero ¿esto no es una estatua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#¿De qué estás hablando, ciudadan{F#a}{M#o}? ¿No se supone que todos los remurianos se ven así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230209,
					"content": "En fin, ¿tú querrías intentarlo? La prueba inicial a superar consiste en romper estos pilares de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230213,
					"content": "No subestimes estos pilares. He estado mucho tiempo entrenando, pero solo he conseguido llegar a romper uno de un golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230210,
					"content": "¿Pruebas? ¿De qué pruebas hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Pruebas de combate, ¿qué otras pruebas podrían ser? Por más que uno obtenga un cuerpo inmortal tras haber ascendido, las habilidades de combate solo se pueden adquirir con entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230212,
					"content": "En fin, ¿tú querrías intentarlo? La prueba inicial a superar consiste en romper estos pilares de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Veniero"
				}
			]
		},
