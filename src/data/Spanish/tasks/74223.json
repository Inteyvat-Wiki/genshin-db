			"dialogs": [
				{
					"id": 742230401,
					"content": "Guau... No sabía que también podía hacerse así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230402,
					"content": "#¡Cuánto poderío, ciudadan{F#a}{M#o}! Por casualidad, ¿no será que has servido antes en la armada del rey divino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Veniero"
				},
				{
					"id": 742230404,
					"content": "Nuestro capitán también siente admiración por tu destreza de combate. ¡Creo que tendré que aplicarme más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veniero"
				}
			]
		},
