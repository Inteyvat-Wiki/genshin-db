				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborn",
					"Souffache",
					"Ciruela"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "#Hola, {F#paladina}{M#paladín}. En nombre del Reino Brisacampana, te doy la bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700102,
					"content": "¿Qué van a hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Humm... Primero, anunciaré a todo el reino que la reliquia ya ha tomado una decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700104,
					"content": "El guardián... será Faurobert, el llegado de tierras lejanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700105,
					"content": "¡¿Eh?! ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Explicar lo que hemos vivido es demasiado complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700107,
					"content": "Además, la gente no entenderá tan fácilmente por qué yo soy tanto la princesa como la guardiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700108,
					"content": "Llegado el momento adecuado, lo escribiré todo con detalle y se lo comunicaré a todos los ciudadanos por escrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700109,
					"content": "Hasta entonces, seguiré encargándome de los asuntos del reino en calidad de princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700110,
					"content": "Y entonces, emprenderé mi viaje una vez que esos lugares de prueba sean oficialmente lugares de entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700111,
					"content": "¿Su viaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Su Alteza, ¿recuerda para quién exactamente se iluminó la reliquia en la cueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "¿Eh? ¿Para quién se iluminó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700115,
					"content": "Sí, en ese momento todos estábamos al lado de la reliquia. Por supuesto que merece su reconocimiento, princesa, pero yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Tú eres un campeón reconocido por otro campeón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Sí. Ese campeón vino específicamente a pedirte ayuda, ¿cómo no vas a ser digno de reconocimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "¡Quizás es porque el brillo de la princesa es tan deslumbrante que los confundió a todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Entonces, campeón, ¿estás dispuesto a aceptar otra prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700120,
					"content": "Yo, la princesa Ciruela del Reino Brisacampana, seré personalmente testigo de tus hazañas con esta reliquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700121,
					"content": "¡Sí, claro que estoy dispuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "No te emociones tanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Jeje, Faurobert, cómo te emocionas solo con escuchar el nombre de la princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "¡No me malinterpreten! Yo... ¡lo hago por la misión del Estanque Cantopluvial! Si he entrenado tanto, ha sido para salvar... quiero decir, para proteger a su alteza la princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "Al ser una misión tan importante, tengo que asegurarme de que todo sea perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "¿Estás dispuesto a acompañar a la princesa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "S-sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Jeje, ¡muy bien! Entonces, campeón Faurobert, ¿estás listo para enfrentarte a mi prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700130,
					"content": "¡Sí, alteza! ¡Cuando usted quiera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "¡Guau! ¡La reliquia se iluminó de nuevo! ¡Y brilla un montón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Ay, qué grito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "¿Qué va a hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Faurobert",
					"Horellou",
					"Estampe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "¡Estampe! ¡¿Dónde estabas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Eh... fui a dar una vuelta y probé esa prueba. Fue bastante interesante, solo que tuve que usar otro método para superarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "El Sr. Horellou me lo ha contado todo. No está nada mal, “señor guardián”. Al final, sí que eras bastante fuerte, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "S-si hubieras estado conmigo, ¡te habría empujado una y diez veces si hubiera hecho falta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Por eso fui a la prueba. Faurobert, amigo mío, confiaba en que lo lograrías, y mira, lo lograste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Jajajaja, buenos señores, hoy es realmente un día de suerte para el Estanque Cantopluvial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Finalmente tenemos a un auténtico campeón, y aunque el señor Faurobert aún no ha tenido la oportunidad de salvar a la princesa, creo que tendrá su momento para demostrar su valía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "¿Eh? Pero si yo no hice nada, Sr. Horellou, solo estuve mirando desde un lado. Todo el mérito es de su alteza la princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "¿Y no es eso aún mejor? ¿O querías que Su Alteza estuviera en peligro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Basta de dudas, Faurobert. ¡Aceptaste la misión de Cibrélus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "¡No sé si realmente era Cibrélus! Solo he oído hablar de él, ¡pero nunca he escuchado su voz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Hasta aceptaste someterte a la prueba de la princesa. Sin duda, eres todo un campeón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "¿Podemos no hablar de eso por ahora? Por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "En fin, el futuro del Estanque Cantopluvial está en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Ahora podemos saltar sin ninguna presión. Le sugeriré al comité organizador que añadamos más elementos divertidos a la competición de salto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "Es una idea que yo mismo estaría dispuesto a llevar a cabo. En fin, regresemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "¡No me dejen aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ciruela",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "¡¿Esa rana de papel y usted han sido reconocidas como guardianes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Increíble, ¡inaudito! No contamos con ningún registro de que algo así haya ocurrido en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "Y además quiere cambiar la prueba... No, ¡no puede ser! ¡Su Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Su Alteza, ¡no puede cambiar una tradición tan antigua así como así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Está bien, bajen la voz, me están haciendo daño en los oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700306,
					"content": "Ya está todo decidido. Ahora soy tanto la princesa como la guardiana reconocida por la reliquia, así que no podrán detenerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700307,
					"content": "Pero, Su Alteza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "No se preocupen. Yo misma supervisaré la ceremonia de entrenamiento y entrenaré a muchas ardillas voladoras para proteger el reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700309,
					"content": "Y después, me marcharé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700310,
					"content": "Su Alteza, nosotros... *Suspira*, usted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Tranquilos, sé cuidar de mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700312,
					"content": "Como princesa, ya es hora de que me enfrente a los vientos salvajes por mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Ciruela"
				},
				{
					"id": 790700313,
					"content": "A sus órdenes, alteza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborn"
				}
			]
		}
	]
}