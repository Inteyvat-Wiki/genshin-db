			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "Excelente calidad a precios asequibles. La tienda de especias de Yut está siempre a tu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960602,
					"content": "¡Compra ahora y llévate un regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319607",
							"2"
						],
						"stepId": 7319607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
