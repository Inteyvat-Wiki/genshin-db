			"dialogs": [
				{
					"id": 731961101,
					"content": "La Tintorería Ani dará nuevo color a tus prendas aplicando la técnica más depurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961102,
					"content": "“¿Cuándo podré recibir las telas que mandé lavar y teñir el mes pasado?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961103,
					"content": "“¡Mil disculpas! Mi esposa dio a luz a nuestro bebé ayer, así que no tuve tiempo de trabajar. Por favor, vuelva mañana. Le garantizo que las tendré listas para usted a tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961104,
					"content": "“Ya han pasado tres meses. Por favor, devuélvame mis telas. Ya no las quiero teñidas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961105,
					"content": "“¡Lo siento mucho! Ya había teñido sus telas, pero algún ladrón las robó mientras se secaban. Si quiere recuperarlas, capture al ladrón que las robó”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
