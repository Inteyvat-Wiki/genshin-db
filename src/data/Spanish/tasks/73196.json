			},
			"dialogs": [
				{
					"id": 731960101,
					"content": "Este es el tablón de anuncios que Transacciones Kalimi ha dispuesto para que los comerciantes locales y foráneos publiquen anuncios comerciales. Por favor, no publique otra información irrelevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Transacciones Kalimi hace todo lo posible para garantizar que la información de mercado proporcionada sea precisa y confiable, pero no garantiza su veracidad o integridad de ninguna manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960202,
					"content": "Cualquier usuario de la información de mercado publicada en el tablón de anuncios no podrá reclamar, ya sea en parte o en su totalidad, pérdidas derivadas del uso de dicha información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "¿Alguna vez has oído hablar de la levitación? ¿O has visto a un trapecista? ¿Quieres conocer cuál es el secreto del animal de carga volador? ¡Ven a la primera actuación del Circo Volador de Fontaine en Sumeru y descúbrelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960302,
					"content": "¡Sean bienvenidos y no se pierdan esta oportunidad! ¡El espectáculo les espera por solo cinco Moras la entrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960303,
					"content": "A raíz de los reportes del público, hemos comprobado que este espectáculo no cuenta con la aprobación de la Academia, por lo que retiraremos inmediatamente este anuncio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "¡Nuestro banco está a punto de abrir una oficina en Sumeru! ¡Permanezcan atentos, estimados futuros clientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960402,
					"content": "Pueden ponerse en contacto con Viktor, de nuestra sucursal en Liyue, para cualquier asunto que quieran tramitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960403,
					"content": "Si están pensando en sacar un préstamo, ¡pregunten a uno de nuestros Recaudadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319605",
							"2"
						],
						"stepId": 7319605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Alfombras tejidas a mano, ¡una obra maestra del arte de Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960502,
					"content": "¡Todos los habitantes de Sumeru deberían tener una alfombra así en su vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960503,
					"content": "Las alfombras tienen precio, ¡pero el arte, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
				7319606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
