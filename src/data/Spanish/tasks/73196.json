			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Nuestra tienda ofrece todo tipo de artículos cotidianos. La calidad de nuestros artículos ha sido inspeccionada personalmente por el propietario, le aseguramos que quedará satisfecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960702,
					"content": "“Padre, ¿puedes prestarme algo más de dinero? Escuché que el precio de los dátiles va a subir como la espuma, así que estoy seguro de que esta vez haré una fortuna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
				7319608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
