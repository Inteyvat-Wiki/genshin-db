			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Nos especializamos en servicios de comercio exterior y tenemos un largo historial de cooperación con poderosas flotas como la Flota Crux Meridianam para transportar sus mercancías de manera segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961202,
					"content": "Este verano se abrirán otras cuatro rutas para seda, especias, minerales y otros productos básicos. Nuestros buques mercantes recién adquiridos tienen una gran capacidad de carga, sean bienvenidos a cooperar con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961203,
					"content": "Si desea reservar la ruta completa, le invitamos a una reunión individual con el Sr. Farzaneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319613,
			"completionStepIds": [
				7319613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
