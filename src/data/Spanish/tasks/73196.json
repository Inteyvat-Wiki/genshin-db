			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "“Alguna vez poseí una riqueza inagotable, pero mi corazón nunca estuvo en calma por mucho que despilfarrara”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961002,
					"content": "“Después de este viaje no me queda ni un Mora en el bolsillo, pero me siento tranquilo como nunca”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961003,
					"content": "“Si quieres escuchar mi historia, ven a verme a la tienda de verduras. Sería bueno que compraras algunas también”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
