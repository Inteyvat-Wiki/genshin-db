			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "¡Busca la felicidad en la vida! ¡Sal de casa y explora el mundo! ¡Únete a la Liga de Aventureros ahora y conviértete en uno de nuestros miembros! ¡Solo cinco Moras por tu primer mes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961602,
					"content": "El verdadero conocimiento solo se puede obtener de la práctica. ¡Perder la vida en una ardua travesía es mucho más significativo que pasar una vida anodina sin hacer nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961603,
					"content": "“Por favor, presten atención, este no es el Gremio de Aventureros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961604,
					"content": "“¡¿Qué?! Ya pagué las cuotas de todo un año, ¿puedo recuperar mi dinero?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
