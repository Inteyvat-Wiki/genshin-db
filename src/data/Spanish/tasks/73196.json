			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "Según las quejas de los consumidores, la Tintorería Ani ha sido clausurada bajo sospecha de robar las telas de los clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961302,
					"content": "Tras ser investigada, se ha hallado que esta tintorería ha sido completamente vaciada. Estamos trabajando para recuperar los bienes perdidos de los denunciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
