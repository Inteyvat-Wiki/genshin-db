			"dialogs": [
				{
					"id": 731961401,
					"content": "Sobre la propiedad del Café Puspa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961402,
					"content": "Después de la investigación pertinente, se descubrió que el propietario original desapareció durante una expedición al desierto hace tres años. De acuerdo con la normativa vigente, la gestión del café pasará a manos de una autoridad superior, en este caso, la Facultad Vahumana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961403,
					"content": "Dictamen: debido a que el demandante desiste de la demanda, el caso se suspende indefinidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
