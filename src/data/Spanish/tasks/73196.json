			"dialogs": [
				{
					"id": 731961701,
					"content": "“Todo el mundo ha oído hablar de la magnate Sangemah Bay, así que no creo que haya necesidad de hacer presentaciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961702,
					"content": "“En fin, ha llegado un nuevo lote de alfombras. No son alfombras voladoras, pero son mejores que las de Sulaika. ¡Dense prisa, que me las quitan de las manos! El canal de ventas es el mismo de siempre, jeje”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961703,
					"content": "¡Oye, Dori! ¡No seas así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
