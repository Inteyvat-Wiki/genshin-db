			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "“Al hablar del Gran Bazar, el Teatro Zubayr es un lugar que no se puede pasar por alto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961502,
					"content": "“¡Y la actuación en el Teatro Zubayr que no puedes perderte es el baile de Nilou!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731961503,
					"content": "“Si no has visto a Nilou bailar la danza Sabzeruz, tu viaje a Sumeru habrá sido en vano”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
