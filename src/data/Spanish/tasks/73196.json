			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960901,
					"content": "¡La auténtica barbacoa del desierto! ¡Barbacoa con la salsa secreta del Rey Deshret y especias locales del mar de arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960902,
					"content": "¡Buena comida y excelentes bebidas para que todos disfruten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
