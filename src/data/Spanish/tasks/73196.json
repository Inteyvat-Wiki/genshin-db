			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "Deseamos adquirir las estatuillas doradas perdidas de Kazeni. Puede ponerse en contacto con el propietario de la tienda para negociar el precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731960802,
					"content": "Cualquiera que tenga información útil sobre ellas también puede pasar por la Joyería Minakari y hablar con el coleccionista Jalid. ¡Le recompensaremos por las molestias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319609,
			"completionStepIds": [
				7319609
			],
