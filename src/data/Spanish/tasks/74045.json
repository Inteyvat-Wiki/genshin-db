						],
						"pointId": 340300142
					}
				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "#¡Bienvenid{F#a}{M#o}s! ¡Esta es la tienda donde encontrarán la mayor variedad de minerales de toda Fontaine! También vendemos todo tipo de productos artesanales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "¿Hay alguna cosa que les guste? Si no hay nada que les guste pero tienen cualquier duda, ¡pueden preguntarme lo que quieran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Traemos un mineral que jamás has visto en tu vida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "¡Eso! Tú que vendes tantos tipos diferentes de piedras preciosas, ¡seguro que sabes calcular el valor de este mineral que te hemos traído!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Ooh, ¿han venido a regatear para venderme un mineral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "Hablan ustedes con la persona correcta. Aquí ofrecemos buenos precios, nunca se nos ocurriría estafar a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Díganme, ¿qué mineral traen ahí?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Le muestras a Chesil el mineral extraño que encontraron...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "D-de veras es un mineral que no había visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "#Tiene un lustre de lo más particular, y su superficie es tan reluciente... ¡Pueden estar segur{F#a}{M#o}s de que encontraron un mineral valioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Quizá alguien como yo no debería preguntar esto, pero... ¿podrían decirme de qué mineral se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "#Nosotr{F#a}{M#o}s tampoco lo sabemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "#¿Vinieron para que yo l{F#a}{M#o}s ayudase a identificarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "Pero sería una pena que solo existiera un ejemplar de este mineral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Si tuviéramos material suficiente, podríamos producir joyas que serían tendencia en toda Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Paimon recuerda haber escuchado a Pucca mencionar que este tipo de mineral se halla en todas las vetas de minerales de su zona. Si le preguntáramos a ella...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Tenemos montones de ejemplares como este.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "¡¿De veras?! ¡Qué buena noticia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "Llegados a este punto, estoy dispuesto a comprar el mineral que han traído. Además, me gustaría adquirir los minerales que transporten hasta aquí para elaborar productos artesanales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "#Y para que estén segur{F#a}{M#o}s de que pueden confiar en mí, les pagaré los minerales con antelación. Solo tendrán que traerme más minerales cuando vuelvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "¿Qué les parece? Yo lo considero un trato justo, no sé qué opinan ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "#Jeje, a nosotr{F#a}{M#o}s también nos gusta la idea. ¡Trato hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Eso es estupendo. Aquí tienen su dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "¿Qué joyas podría diseñar con estas piedras preciosas? Jaja, ¡estoy deseando ponerme a trabajar en ello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Bueno, aquí estaré esperando a que regresen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "Pero su ubicación es un secreto comercial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Oh, claro, por supuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Bastará con que dispongan de un método para transportarlos hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "En realidad, podríamos encontrar muchos como este por la zona de Elynas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "Eh, ¡¿por qué se lo has contado así como así?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "¿Los encontraron donde Elynas? La verdad es que nadie querría adentrarse allí para buscar minerales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "¿Quizá se trate de una paimondrita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "¿Cómo? ¡Qué nombre tan extraño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "Hay quien lo llama “oro cristalino”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "Eh... ¿Ese nombre te lo acabas de inventar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "Con un nombre tan potente como ese, ¡nadie pondría en duda que se trata de un mineral especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
