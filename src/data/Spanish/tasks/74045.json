			"dialogs": [
				{
					"id": 740450601,
					"content": "¡Aquí están de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450602,
					"content": "¿Tienen alguna duda sobre minerales? ¡Pueden preguntarme lo que se les ocurra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450603,
					"content": "Aunque tal vez no sea capaz de responderles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450604,
					"content": "¿Qué sabes de las gemas preciosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Hay muchísimas piedras preciosas y brillantes en las vetas de minerales de por aquí, pero para mí no hay piedras más bonitas que las que recojo yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450606,
					"content": "Si yo también lograse encontrar piedras preciosas auténticas, quizá hasta podría abrir mi propio taller, ¡como mi hermana Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450607,
					"content": "¿Para qué usas los minerales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "¿Eh? Nunca me había hecho esa pregunta antes... Simplemente recojo todo tipo de piedras que me parecen bonitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450609,
					"content": "No tengo más dudas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "Jeje, ¡gracias por venir a visitarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pucca"
				}
			]
		}
