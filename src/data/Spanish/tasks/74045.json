				]
			},
			"dialogs": [
				{
					"id": 740450101,
					"content": "Pucca, ¡¿qué haces aquí otra vez?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Paimon no cree que vayan a aparecer más monstruos por aquí, pero quizá haya otros peligros inminentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Sería mejor que no fueras por ahí corriendo solita de un lado a otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Paimon y {NICKNAME}, ¡no estaba corriendo! Solo he venido un pelín acelerada en busca de mi amuleto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450105,
					"content": "¿Eh? ¿Has perdido tu amuleto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Humm... Seguramente se me cayó en aquel lugar donde estuve recogiendo piedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450107,
					"content": "Oh... ¿Se te cayó en un descuido cuando te quedaste atrapada allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*Solloza*... Sí, seguro que fue en ese momento cuando se me cayó... Estaba tan aterrada que no pude fijarme en nada más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450109,
					"content": "Y ahora siento miedo con tan solo recordarlo, pero ese amuleto es muy importante, tengo que recuperarlo sea como sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450110,
					"content": "Oh... Pero sería demasiado peligroso si fueses tú sola a buscarlo. Ya que así son las cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, ¿qué te parece si nos damos un viajecito hacia allí y ayudamos a Pucca a recuperar su amuleto? ¡Tú vuelve a casa, pequeña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "#Nosotr{F#a}{M#o}s lo recuperaremos en un santiamén.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#¡Gracias, {NICKNAME} y Paimon! Yo esperaré en casa a que vuelvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450113,
					"content": "De todas formas, yo ya tenía ganas de conocer esos lares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
