			"dialogs": [
				{
					"id": 740450201,
					"content": "Pucca, ¡ya estamos de vuelta! ¡Encontramos tu amuleto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Le entregas a Pucca el amuleto que han encontrado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Aaah, ¡este es! ¡Mil gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450204,
					"content": "También nos encontramos esto mientras buscábamos el amuleto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "Es un mineral que no habíamos visto nunca antes. Pensamos que podría tratarse de una piedra preciosa, así que decidimos traerla también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Paimon recuerda que mencionaste que solías recoger piedras por esta zona. Por casualidad, ¿no habrás visto antes otras piedras como esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "A ver, a ver... ¡Es cierto que es hermosa! Pero... no creo que sea una piedra preciosa, tiene pinta de ser un mineral común...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450208,
					"content": "Aunque este tipo de mineral no sea típico de otras zonas, ¡aquí se encuentra por todas partes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450209,
					"content": "¡¿Que qué?! Conque no es más que una piedra normal y corriente... ¡Paimon creyó que por fin podría hacerse rica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Al parecer no tiene nada de especial, será mejor que pensemos en un sitio donde tirarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Pero quizá los forasteros no la hayan visto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Ooh, ¿te refieres a que podríamos hacer una buena fortuna si la vendemos fuera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Paimon no cree que a nadie más se le ocurra ir a la aldea de las melusinas solo para extraer minerales. ¡Seguro que ni siquiera saben de la existencia de este tipo de mineral! ¡Qué list{F#a}{M#o} eres, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "#Ya que nosotr{F#a}{M#o}s la descubrimos, ¡podríamos llevársela a los comerciantes de Fontaine para que la vean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Oh, si hay algo más que quieran saber sobre los minerales de nuestra zona, pueden venir a buscarme siempre que quieran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450217,
					"content": "Aunque yo no tenga mi propio taller de piedras preciosas como mi hermana, ni tampoco tenga claro cómo identificarlas o procesarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450218,
					"content": "Más que piedras preciosas, a mí me gusta más recoger toda una variedad de piedras interesantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450219,
					"content": "¡Por eso conozco muy bien las vetas de minerales de los alrededores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740450220,
					"content": "Gracias, Pucca, lo tendremos en cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Pero si solo es posible encontrarla aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
