			"dialogs": [
				{
					"id": 706580101,
					"content": "Hola. ¿Has estado disfrutando del Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580102,
					"content": "Sí, gracias por tu recomendación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "¡Jiji! Hay otra actividad; una muy relajante esta vez. Se llama Baladas del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580105,
					"content": "¡En esta actividad podrás tocar canciones, igual que los bardos de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580106,
					"content": "En lo alto de las montañas, junto al lago, sintiendo el viento y tocando una canción a plena concentración. Seguramente te hará olvidar todos tus problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580107,
					"content": "No tengo experiencia en ese ámbito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "No te preocupes. Esta actividad es para darle la oportunidad a gente sin experiencia de disfrutar de la alegría de la música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580110,
					"content": "Si se siguen las indicaciones y el ritmo, con el resto no habrá problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580111,
					"content": "#Eso me deja más tranquil{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "¡Que disfrutes del festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580112,
					"content": "Entonces voy a probar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "¿De verdad se oirá bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
