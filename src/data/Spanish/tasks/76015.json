				},
				{
					"id": 760150207,
					"content": "¿Te sabes la canción? ¡Ojú, vamos! Nosotros cantamos una estrofa, y tú, la siguiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150208,
					"content": "“¡La música del vecino me hace querer bailar!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150209,
					"content": "“¡La lira voy a tocar y ustedes sonreirán!”",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "“¡Todos brincamos, todos bailamos!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150211,
					"content": "“¡Aquí estamos, aquí nos juntamos!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "¡Ajá, exacto, así es la canción! Aprendes rápido, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150213,
					"content": "Me llamo ███. Listo, ya nos conocemos. Si quieres sentarte, adelante. Después de todo, soy un tipo muy generoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150214,
					"content": "Tú también eres un soldado ratnik, ¿verdad? No te preocupes, a esta cerveza invito yo. Tal vez volvamos a vernos durante algún entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150215,
					"content": "Gracias, aunque no creo que pueda acabármela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Bueno, tengo que ir a patrullar. Hasta la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150216,
					"content": "Encantado, yo me llamo Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "¿Qué pasa si quiero sentarme aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
