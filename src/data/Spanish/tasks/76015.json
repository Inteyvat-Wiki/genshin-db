			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma ruidoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Eh, ¿quién eres? Esta es mi silla. Todo el mundo en la taberna sabe que esta es la silla de ███.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150102,
					"content": "¿Has venido a la isla para dar tu informe o para qué? ¡No robes el asiento de los demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150103,
					"content": "¿Dónde está mi cerveza? Vamos, que alguien me la traiga ya, tengo que patrullar esta noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150104,
					"content": "¿Taberna? ¿Cerveza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Bueno, si tanto insistes... Pero primero, ven a beber y cantar con nosotros. Una vez que seamos amigos, puedes sentarte donde te plazca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150107,
					"content": "¿Te sabes la canción? ¡Ojú, vamos! Nosotros cantamos una estrofa, y tú, la siguiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150108,
					"content": "“¡La música del vecino me hace querer bailar!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "No, no, no. La letra no es así, no seas aguafiestas. Todo el mundo en Nod Krai se sabe esta canción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150113,
					"content": "Si no sabes ni cantar ni pasártelo bien, no vas a poder formar parte del grupo. Y las cosas no les van nada bien a los que no tienen a nadie con quien luchar cuando llega la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150114,
					"content": "No vuelvas a la taberna hasta que hayas aprendido a cantar. ¡Ojú, otra cerveza más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma ruidoso"
				},
				{
					"id": 760150110,
					"content": "“¡Mi amiga Paimon me hace de risa llorar!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "“¡Los fantasmas de la isla en torno a la silla van a bailar y cantar!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "¿Puedes prestarme el asiento durante un rato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
