		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Este es el último cofre, no hay que escribir ningún acertijo para este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Pero ¿qué se puede dejar dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Algo de suficiente valor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Es cierto. Qué menos que el cofre contenga algo digno de la ardua reflexión que necesitaron hacer los viajeros para resolver los acertijos durante el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Si hablamos de algo de valor, lo más lógico sería dejar Mora. Humm... pondré algunos Moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "#Bien, este acertijo quedó terminado. Gracias por tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Estas cosas son para ti, son tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "Oh, quería contarte más detalles sobre el acertijo, pero tengo que regresar a la Academia de Sumeru para resolver unos asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Si descubres en el futuro acertijos extraños durante tu viaje, o no logras resolver alguno, recuerda venir a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Podemos hablarlo en detalle juntos, y luego... ¡Crear nuevos acertijos para aventureros! ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "#Hasta pronto, viajer{F#a}{M#o}. Te deseo un buen viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Espero que la ladrona de tesoros llamada Narzam no cause ningún problema grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Algo que sea de utilidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "¿De utilidad? Humm... Algo muy práctico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "¡Ah, sí! Alguien me dio una receta hace unos días, podemos dejarla en el cofre como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "En realidad, el mejor tesoro es experimentar todo el proceso de reflexión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Jajaja. ¡Tienes razón, toda la razón! ¡Esta ardua reflexión es de hecho una experiencia de valor incalculable! Comparado con esto, el resto de las cosas tiene un valor prácticamente insignificante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "¡Eso no es cierto! ¡Pon Moras o una receta! O por lo menos, ofrece algo de fruta y verdura, ¡el cofre no puede quedarse vacío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Estoy bromeando, estoy bromeando. Pues claro que pondré algo como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
