			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "Humm, este es un buen lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030102,
					"content": "¿Estás investigando sobre acertijos otra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "#¡Viajer{F#a}{M#o}! ¡Has venido en el momento justo! Estoy a punto de diseñar una nueva serie de acertijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030104,
					"content": "El terreno aquí es un poco complicado. Mira, a un lado del puerto hay un enorme sistema radicular del Árbol Sagrado que se adentró en el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030105,
					"content": "Al otro lado hay una enorme hoja de loto y muchos barcos esperando para salir del puerto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030106,
					"content": "#Viajer{F#a}{M#o}, ¿qué escenario crees que es mejor como tema para este acertijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030107,
					"content": "Es mejor comenzar con el sistema radicular.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "¿De verdad? El gran sistema radicular del Árbol Sagrado es bastante llamativo y se ve fácilmente que es el punto de partida del acertijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030109,
					"content": "¡Bien! Escribiré un acertijo con el sistema radicular como tema principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030115,
					"content": "Jejeje, deja que yo escriba uno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "Jejeje, yo me encargo de esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "Oye, ¿de qué te ríes tanto tú?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030118,
					"content": "Listo, mira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "“Cuando el conocimiento regresa al mar, el tesoro yace en las velas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030120,
					"content": "¡Qué bien queda! Y este acertijo también hace que la gente piense muy fácilmente en el puerto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030121,
					"content": "Y en la parte donde dice “cuando el conocimiento regresa al mar”, es fácil ver que dicha ubicación está relacionada con la Academia de Sumeru o con la Ciudad de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030122,
					"content": "No sabía que tenías tanto talento para esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030123,
					"content": "Espera un momento, pegaré este acertijo en un lugar que sea fácil de encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030124,
					"content": "¿Eh? ¿Pegarlo en un sitio cerca? Pero la ubicación que dice el acertijo no está lejos. Puede que lo encuentren enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030125,
					"content": "Jajaja, estoy delineando el alcance del acertijo para quienes lo resuelvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030126,
					"content": "Si no lo hago, entonces el alcance de la solución del acertijo será demasiado grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030127,
					"content": "Drusus comienza a preparar el acertijo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "Está bien, este acertijo está listo. Vamos al siguiente lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030129,
					"content": "¿Eh? ¿Hay otro lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030110,
					"content": "La hoja de loto y el barco son interesantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "Efectivamente... Podría ser divertido si conectamos las dos cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030112,
					"content": "No hay problema, escribiré un acertijo basado en este tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030113,
					"content": "¡Son todos demasiado fáciles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "¿Demasiado fáciles? ¿Tienes alguna idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "¡Bien! Preparemos el segundo acertijo aquí. Una vez que se resuelve el acertijo, se encontrará el último cofre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030202,
					"content": "Colocaré el último tesoro... allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030203,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030204,
					"content": "Eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "¿Acaso esto no es solo una pequeña y ordinaria colina con una pequeña y ordinaria cascada al lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030206,
					"content": "¡Así es! Pero pronto serán de todo menos ordinarias gracias a nuestros acertijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030207,
					"content": "#Bien, viajer{F#a}{M#o}, ¿qué sugieres para este acertijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030208,
					"content": "No te andes por las ramas y céntrate en el meollo del acertijo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "¿Eh? ¿Eso crees? Humm... Es cierto, las personas que resuelven los acertijos estarán cansadas después de atravesar la montaña para poder llegar hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030210,
					"content": "Bien, hagámoslo más sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030219,
					"content": "En ninguna parte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "Solo puedo decir que la práctica hace al maestro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "#Ya veo. ¡Como se esperaba {F#de la}{M#del} viajer{F#a}{M#o}! Cuántos conocimientos... Bien, ahora prepararé el acertijo que has escrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030222,
					"content": "Drusus comienza a preparar el acertijo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "¡Hecho! Este pequeño tablón de anuncios debería ser fácil de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030224,
					"content": "Vayamos a preparar el último cofre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030211,
					"content": "La temática será la cascada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "Humm... La cascada es una temática muy clara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030213,
					"content": "No hay problema, será la temática. En cuanto a la dificultad de este último acertijo... Deberíamos reducirla un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030214,
					"content": "Jejeje, deja que lo escriba yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "¡Oye! ¡Otra vez te estás riendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030216,
					"content": "Terminé de escribir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "“El paraguas esmeralda que alberga el tesoro contempla la cortina de perlas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030218,
					"content": "Humm... Este acertijo suena un tanto especial... ¿Dónde has aprendido estas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350303,
