			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najib",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "¿El Gran Rey Bestia? ¿Se refieren a ese animal de carga gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760502,
					"content": "Hace dos días me encontraba de camino a Liyue y lo vi al pasar por la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760503,
					"content": "La bestia estaba durmiendo, así que me di la vuelta de la manera más silenciosa que pude y me alejé de ahí. Parecía una montaña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760504,
					"content": "¿Que dónde lo vi? Estaba al sur de aquí en dirección a Liyue. Debe estar en algún lugar al sur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760505,
					"content": "¿Eh? Pero la ruta de Sumeru a Liyue es por agua. ¿Por qué fuiste a la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760506,
					"content": "Eso es personal. ¡No tiene nada que ver con lo que están preguntando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760507,
					"content": "Bueno, eso es todo lo que sé. Tengo otras cosas que hacer. ¡Déjenme en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najib"
				}
			]
		},
		{
