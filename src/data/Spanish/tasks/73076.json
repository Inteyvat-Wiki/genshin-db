			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "¿El Gran Rey Bestia? Hace unos días me desvié del camino de la montaña cuando me encontraba buscando minerales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760402,
					"content": "De pronto, vi a un enorme animal de carga. Era gigantesco. Nunca había visto uno tan grande en mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760403,
					"content": "Se lanzó hacia mí en cuanto me vio. Por suerte, corrí lo más rápido que pude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760404,
					"content": "¿De qué lado de la montaña? Podría ser al oeste de esa montaña que está allí. No recuerdo bien pero estoy seguro de que era al oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hong"
				}
			]
		},
		{
			"id": 7307605,
			"completionStepIds": [
				7307609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
