			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"¿?",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "Ay, solo en Sumeru se puede sentir el aire puro de la naturaleza. El aire en Fontaine apesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760102,
					"content": "¿Eh? ¿Qué pasa? ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760103,
					"content": "Solo por curiosidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "¿Vives en esta tienda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760105,
					"content": "Sí. Llevo un tiempo viviendo aquí. Jaja, sí, lo sé. Es raro ver a alguien de Fontaine vivir en una tienda en medio del bosque de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760106,
					"content": "Lo que pasa es que... ¿Cómo les explico? En primer lugar, ¿cuáles son sus nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760107,
					"content": "Paimon se llama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760108,
					"content": "#Yo soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#Así que {NICKNAME} y Paimon. De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760110,
					"content": "Soy Santón, y como pueden ver, soy de Fontaine. ¡El motivo por el que vine a Sumeru es porque me encanta la selva de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760111,
					"content": "Vivir demasiado tiempo en la ciudad debilita el cuerpo por la falta de ejercicio, y la mente puede volverse lenta y cansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760112,
					"content": "Solo en la inmensidad de la naturaleza se puede volver a conectar con todos los seres vivos. El bosque es el mejor lugar para acercarse a ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760113,
					"content": "Así que vine a Sumeru. Después de todo, este debe ser el mejor bosque en Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760114,
					"content": "Paimon cree entender. O tal vez Paimon no entienda por completo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760115,
					"content": "Pero el bosque de Sumeru es muy peligroso, hay todo tipo de monstruos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760116,
					"content": "¡Por supuesto! ¡Tiene que ser peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760117,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760118,
					"content": "¡Si no fuera peligroso, no sería capaz de sentir esa sensación de supervivencia! No se preocupen, soy un cazador famoso en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760119,
					"content": "¡¿Qué?! ¡Dijiste que te gustaba el bosque pero en realidad lo que te gusta es cazar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760120,
					"content": "¡Eres un cazador furtivo de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760121,
					"content": "¡En ese caso tendremos que intervenir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "¡Esperen, esperen! Me han entendido mal. No soy un cazador furtivo. La caza furtiva es un delito muy grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760124,
					"content": "Si te atrapan cazando furtivamente en Fontaine, serás condenado de por vida. Yo no me atrevería a hacerlo. Lo que hacemos los cazadores de Fontaine, de hecho, es simplemente lidiar con animales salvajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760125,
					"content": "¿Lidiar... con animales salvajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760126,
					"content": "Piénsalo. Si un animal salvaje se acerca demasiado a un pueblo, podría lastimar a alguien... Por eso hay que mantenerlos lejos de donde viven los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760127,
					"content": "Así que eso es lo que haces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760128,
					"content": "De este modo, los animales salvajes no molestan a los pobladores. Y las actividades humanas no afectan la vida de estas criaturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760129,
					"content": "A decir verdad, me dijeron que hay algunos animales salvajes en los alrededores, y me pidieron que los ahuyente. ¡Como cazador, no podía quedarme con los brazos cruzados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760130,
					"content": "Por supuesto, yo también tengo cierto interés en estos animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760131,
					"content": "Mira, este es bastante impresionante. Un cocodrilo gigantesco conocido por los niños como el Rey Caimán. Parece un personaje sacado de alguna leyenda urbana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760132,
					"content": "Dicen que se encuentra en aguas cercanas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760133,
					"content": "También están el Caracal Rajá Patilludo que roba niños y un enorme animal de carga que bloquea el camino a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760134,
					"content": "El Caracal Rajá Patilludo parece estar en lo profundo del bosque, al oeste de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760135,
					"content": "En cuanto al Gran Rey Bestia... Oh, ese es el enorme animal de carga que mencioné antes, varios testigos que lo han visto dicen que merodea por el este y ataca a los transeúntes cuando los ve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760136,
					"content": "Suenan peligrosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760137,
					"content": "#Sí. Si se encuentran con ellos, tengan cuidado... Bueno, aunque creo que estoy hablando con cazador{F#as}{M#es} experimentad{F#as}{M#os}. Tal vez no tenga sentido que me preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760138,
					"content": "Si se encuentran con ellos en el camino, ¡desháganse de ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760139,
					"content": "¡Así los pobladores estarán a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760140,
					"content": "Claro, si es que los vemos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "¡Les estaría muy agradecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760142,
					"content": "Asegúrense de velar por la seguridad de los pobladores, por la de los animales, ¡y por supuesto, por la de ustedes también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 730760143,
					"content": "Claro, lo tendremos en cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760122,
					"content": "¡La caza furtiva destruye el ecosistema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
