			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anaya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "¿El Gran Rey Bestia? Lo vi la otra noche que estuve en el bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760602,
					"content": "Era una noche oscura y nublada. Estaba a mitad de camino cuando de pronto una sombra del tamaño de una montaña se precipitó hacia mí con un estruendo similar al de un terremoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760603,
					"content": "Me desmayé y recuperé la consciencia al día siguiente. La persona que me trajo de vuelta dijo que estaba desmayada al pie de la montaña. Por suerte no tenía heridas graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760604,
					"content": "Bueno, no estoy segura de la ubicación exacta. Tal vez fuera al este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anaya"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307607",
							"2"
						],
						"stepId": 7307607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santón",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "¿Eh? ¿Ahuyentaron a los animales salvajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760702,
					"content": "Yo todavía no he visto ninguno... ¿Tú qué piensas? ¿Son realmente salvajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760703,
					"content": "Eso parece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Jaja, parece que fue pan comido para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760707,
					"content": "Me alegra saber que esos animales salvajes han sido expulsados. Aunque, es una lástima no haberme encargado de ellos con mis propias manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760708,
					"content": "Bueno, en la naturaleza, no es raro que un cazador más fuerte le arrebate la presa a otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760709,
					"content": "Jaja, ¡no perderé contra ti la próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760710,
					"content": "¡Nosotros tampoco perderemos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "¡Así es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760712,
					"content": "¿Pero no se supone que lidiar con animales salvajes es el trabajo de los guardabosques de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760713,
					"content": "Sí, bueno... En realidad acepté el encargo de un guardabosques que conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760714,
					"content": "No estoy seguro, pero parece que han invertido muchos recursos en investigar los problemas en la zona marchita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760715,
					"content": "Por eso, me asignaron ese trabajo a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760716,
					"content": "Así que fue por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760717,
					"content": "¡Gracias por su ayuda! Aquí está su recompensa, tomen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760705,
					"content": "¡Son increíbles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "¿De verdad? Me gustaría poder verlos yo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santón"
				}
			]
		},
