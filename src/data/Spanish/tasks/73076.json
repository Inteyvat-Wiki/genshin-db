			},
			"dialogs": [
				{
					"id": 730761001,
					"content": "“Sobre los recientes avistamientos de un gran caracal patilludo:”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "Cartel"
				},
				{
					"id": 730761002,
					"content": "“Por favor, no paseen por los alrededores después del anochecer. Según nuestras investigaciones, este caracal suele merodear durante la noche”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "Cartel"
				},
				{
					"id": 730761003,
					"content": "“Tampoco dejen carne en los alrededores. Y recuerden que lanzarle carne al caracal para huir no es una forma de ponerse a salvo. Por el contrario, hará que el caracal se quede en ese sitio durante más tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cartel"
				}
			]
		}
	]
}