			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santón"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "¿Encontraron a alguno de esos animales salvajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760302,
					"content": "Si se encuentran con algún animal en el camino, por favor, háganse cargo de él. Mantener a los animales salvajes bajo control es beneficioso tanto para los pobladores como para ellos mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760303,
					"content": "Sobre el Rey Caimán...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Dicen que ronda las aguas al este de la ciudad, pero he estado ahí varias veces y no lo he visto. Parece muy astuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760305,
					"content": "Sobre el Caracal Rajá Patilludo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "La historia cuenta que el Caracal Rajá Patilludo salía del bosque del oeste a medianoche y secuestraba a los niños traviesos que no querían dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760307,
					"content": "Lo del secuestro podría ser una invención de los padres o algo así, pero se dice que los caracales patilludos son más activos durante la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760308,
					"content": "Cuentan que un viajero se cruzó con un caracal patilludo a medianoche y este lo persiguió. Por suerte, no hubo ninguna víctima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760309,
					"content": "Sobre el Gran Rey Bestia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "He oído que algunas bestias salvajes son muy territoriales y atacan a los extraños que entran en su territorio. Me temo que el Gran Rey Bestia es así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760311,
					"content": "Su territorio se encuentra en algún lugar del este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760312,
					"content": "Me pregunto qué tan grande debe ser un animal para que lo llamen “Gran Rey Bestia”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santón"
				},
				{
					"id": 730760313,
					"content": "Lo estamos investigando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "De acuerdo, ¡sigan trabajando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santón"
				}
			]
		},
		{
			"id": 7307604,
