			"dialogs": [
				{
					"id": 752570101,
					"content": "Muchacha, el lugar está en perfectas condiciones. ¿Por qué hoy no abren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Lo siento mucho, señora, pero nuestro escenógrafo se emborrachó anoche y hoy no puede venir a trabajar. Venga mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Cielo, estoy muy mayor como para volver a hacer este viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Exacto. Además, todos tenemos nuestros planes mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Lo siento mucho, de verdad. La idea de este daguerromatón de verano es precisamente crear un fondo personalizado para cada cliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Pero sin el escenógrafo presente, es imposible que se lleve a cabo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "¿En serio? ¿Me podrían echar una mano? Me harían un gran favor, de verdad. No es muy complicado, solo tienen que decorar la escena según los requisitos de los clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
