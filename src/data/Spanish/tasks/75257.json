			"dialogs": [
				{
					"id": 752570701,
					"content": "*Fiu*, por fin hemos terminado. Muchas gracias por su ayuda. Si no fuera por ustedes, habría recibido un montón de quejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "#No te preocupes, jeje. ¡Somos l{F#a}{M#o}s aventurer{F#a}{M#o}s más entusiastas en ayudar a la gente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#Oh, ¿son aventurer{F#a}{M#o}s? ¿Qué les parece si les tomo una imagen? Que se quede grabado ese entusiasmo que tienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "¡Vamos, sonrían! ¡Por la brisa de Natlan y un verano apacible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "#Muchas gracias a l{F#as}{M#os} dos. Tomen esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
