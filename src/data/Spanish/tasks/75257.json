			"dialogs": [
				{
					"id": 752570801,
					"content": "La sesión anterior quedó muy bien. Finalmente, le toca a este apuesto caballero. Dígame, caballero, ¿qué tipo de imagen le gustaría tomarse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "¡Qué observadora! Siempre he considerado que la elegancia y el porte son de suma importancia en la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Quien carece de porte está privado de elegancia, y sin elegancia, un hombre no prospera. ¿Entiendes lo que quiero decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Humm... Déjame pensar... ¡Está bien, empecemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
