				]
			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "La sesión anterior quedó muy bien. El siguiente es usted, señor Fatui, ¿cómo quiere que le tomemos las imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Quiero que me vean como un mosquetero legendario, de esos que no falla ninguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Así no tendré que preocuparme por quedar entre los últimos en el concurso de tiro de la armada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "No hay problema. ¡Manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
