			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yiztli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "Parece divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "¡Magnífico! ¿Quién quiere ser el primero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "Las damas primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "Por mí bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "Mira qué caballerosos... ¿Saben qué? Me encantaría tomarme imágenes con muchachos como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "¿Eh? B-bueno, está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "*Ejem*, por mí bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Humm... No es suficiente. ¿Me podrían traer a tres muchachos más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Emm... Y si añadimos algunos fuegos artificiales, mejor aún. Me encantaba ese tipo de ambiente cuando era joven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "No hay problema. ¡Empecemos, pues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
