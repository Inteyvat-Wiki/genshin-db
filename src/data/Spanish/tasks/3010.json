			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "¡Paimon ya lo recuerda todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "Bien, esta vez se adaptaron rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "Ayer, al final de la noche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "Anoche nos quitamos los conmutadores Akasha, pero aun así oímos un pitido. ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "¿Nos han implantado conmutadores mediante una forma distinta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "#Al menos podemos confirmar una cosa: el Akasha está relacionado con lo que nos tiene atrapad{F#as}{M#os} en este bucle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Paimon no lo entiende. ¿Por qué iría tan lejos el Akasha si lo único que quiere es la sabiduría de todo el mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "Bueno, las ratas de laboratorio no saben por qué experimentan con ellas de esa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Si somos ratas de laboratorio, ¿entonces qué eres tú? Nahida, nunca nos has contado nada sobre ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Humm... Digamos que soy “la luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "¿La luna? ¿No fue ese el resultado de la adivinación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "En fin, aunque supieran quién soy, no estarían más cerca de la verdad, así que deberían concentrarse en otras cosas. ¡No se distraigan y no dejen pasar ninguna pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Está bien... Dehya nos ayudó un montón ayer, ¡vamos con ella! Si Paimon está en lo correcto, esos secuestradores aparecerán pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "¿Solo creímos que nos los habíamos quitado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Ah, aquí están. Ya me encargué de esos secuestradores. Señorita, ¿está herida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Un momento, algo no va bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "¿Eh? ¡¿Dehya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "¿Qué pasa? ¿Por qué me miran así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "¡Esta vez no te han herido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "¿Eh? ¿Cómo que “esta vez”? Además, ¿por qué se sorprenden tanto de que haya salido ilesa? Esos tipos no eran más que unos novatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "¿No estabas todavía acostumbrándote a tu nuevo mandoble?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Shh, ¿cómo saben lo de mi mandoble si no se lo he contado a nadie? Por favor, ¡no le digan nada a la Srta. Dunyarzad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Así que Dehya no lo recuerda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "¿Ocurrió algo extraño durante la batalla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "¿Algo extraño? Ya saben que tengo un nuevo mandoble. Aunque debo decir que es raro lo familiar que me resulta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "Es como... Es como si ya hubiera luchado con él en incontables batallas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "¿Quieres decir que, aunque no recuerdas haber luchado antes con él, tu cuerpo está acostumbrado a él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "Sí. Tanto los mercenarios como los guerreros dependen en gran medida de su memoria muscular. Si solo conoces la teoría del combate, no llegarás muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "#{NICKNAME}, ¿qué opinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "¿Será por habernos quitado los conmutadores Akasha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Sí, ¡Paimon tiene esperanzas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "¿Nos hemos liberado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "#Oh, ¡tienes razón! Cuando estábamos inmers{F#as}{M#os} en el samsara, algo como esto no habría ocurrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "Lo sabremos cuando termine el día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "No tengo ni idea de qué están hablando, pero es muy peligroso si nos quedamos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "Como aún estamos en peligro, quieres que llevemos a Dunyarzad a descansar a otro sitio mientras tú compruebas si sigue habiendo secuestradores cerca, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "¿Cómo supiste lo que iba a decir? ¿Puedes leer la mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Olvídalo, ve a hacer lo que tienes que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Es la primera vez que ocurre algo así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "¿Sentiste algo extraño durante la batalla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Al no manejar del todo bien tu arma, podrían haberte herido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "Uf, por fin es de noche. Aparte de que Dehya no resultó herida, parece que todo sigue igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "¡Nahida, escucha a Paimon! Al parecer, Dehya acabó sana y salva hoy, aunque antes salía herida al pelear contra los secuestradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "¿Crees que hemos roto el samsara? ¿Salvamos a Dunyarzad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "¿En serio? ¡Han progresado mucho! Duerman bien esta noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "¡Oye! ¿Qué clase de respuesta es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "“Mañana será otro día”... Todo el mundo asume que eso es de sentido común, pero la única manera de saberlo de verdad es viviendo el mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "¿Cuántas veces ha habido un “hoy”? ¿Es posible que al mañana le siga el ayer? ¿Realmente existe un “mañana” que no sea un constructo artificial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "Incluso es probable que el mundo entero sea una mentira y que toda la historia del mundo no haya sido más que un Festival Sabzeruz sin fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Está bien, ¡déjalo ya! A Paimon ya no le funciona el cerebro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Jeje, por eso no tiene sentido malgastar la energía pensando en cosas que ya averiguarán mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "¡Descansen bien! Y ya saben, ¡vayan al baño y arrojen su ansiedad por el inodoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "¿Eh? Un momento, ¿qué dijiste? ¿Paimon te oyó bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "¿Eh? La gente siempre dice que se siente aliviada después de ir al baño, por eso lo sugerí. ¿Tan extraño es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Ehmm... Es tan extraño y va tan en contra del sentido común que Paimon no sabe ni qué decir. ¡Hace solo un momento estabas hablando de cosas supermísticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "Vamos a descansar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "Sí... Aunque todos los días son muy alegres y animados en el Festival Sabzeruz, Paimon siente que hace mucho tiempo que no descansamos. Volvamos a nuestra habitación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
					"content": "*Bip*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100318,
					"content": "Hay que seguir con la cosecha. Comparado con lo que queremos conseguir, estos sacrificios son nimios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azar"
				}
			]
		},
		{
			"id": 301005,
