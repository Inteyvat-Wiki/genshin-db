			"dialogs": [
				{
					"id": 230260401,
					"content": "Mire hacia arriba. ¿Puede ver ese gran árbol que sostiene la Academia de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260402,
					"content": "La siguiente pregunta es muy sencilla, pero mucha gente se confía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260403,
					"content": "Esta es la pregunta. ¿Cómo se llama este árbol donde se apoya la Academia de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260404,
					"content": "Gran árbol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "#Jajaja, es un nombre muy sencillo, pero es una pena, está equivocad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260406,
					"content": "Árbol Sagrado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
					"content": "Jajaja, ¡fenomenal! ¡Fenomenal! ¡Es correcto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260408,
					"content": "¡Árbol gigante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260409
					]
				},
				{
					"id": 230260409,
					"content": "Bueno, suena poderoso, pero es incorrecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
		{
