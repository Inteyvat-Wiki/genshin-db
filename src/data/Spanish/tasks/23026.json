			"dialogs": [
				{
					"id": 230260301,
					"content": "Tal vez en sus viajes se haya encontrado con muchos eruditos itinerantes que se hacen llamar “driyosh”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "En realidad, hay un gran número de driyosh en una de las facultades de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Esta facultad se centra en el estudio de los elementos, por lo que estudia todo aquello que esté estrechamente relacionado con la energía elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Mi pregunta es: ¿cómo se llama esta facultad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Facultad Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Correcto. La Facultad Spantamad es donde se reúnen los eruditos de la Escuela de Elementalismo, y consideran los siete elementos como la esencia de toda la materia y la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Facultad Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Jaja, incorrecto. Los eruditos de la Escuela de Semiótica de la Facultad Haravatat se centran en la investigación del lenguaje, la semiótica y la lógica... Créame, es muy complejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Facultad Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Oh, qué pena. Respuesta incorrecta. La Facultad Rtawahist es la base de los eruditos de la Escuela de Iluminacionismo, quienes se centran en la investigación del firmamento... Jeje, ¿verdad que suena interesante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
