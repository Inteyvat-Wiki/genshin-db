			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "¡Alto ahí! Está prohibido el paso a la Sima. Si son gente de fuera... ¡Ah, eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "¡Oh, no! ¡A correr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Tranquila, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "#Jajaja, siento haberl{F#as}{M#os} asustado. ¿Cómo podría olvidar a mis salvador{F#as}{M#es}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Acaban de transferirme aquí. No imaginé que nos encontraríamos en este lugar. ¡Supongo que tengo suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "#¿Salvador{F#as}{M#es}? ¿En serio hicimos algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "¿Pero qué dices? ¡Yo estaba en la Cámara de Jade cuando nos enfrentamos a ese monstruo marino! Salí ligeramente herido, ¡pero ya estoy de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "#Quizás no me recuerden, pero yo no l{F#as}{M#os} olvidaré. Todos mis hermanos de armas son testigos de lo que has hecho por Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Sobre la Sima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Hace dos años ocurrió un incidente extraño en las minas, así que las Siete Estrellas ordenaron su clausura y evacuaron a los mineros a un lugar seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Es una pena que una mina tan grande haya tenido que detener su producción. Los mineros tomaron su compensación y se marcharon a tomar toda clase de trabajos varios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "#Ay, pero me estoy desviando del tema. Tengo la seguridad de que deben tener un asunto para venir hasta aquí, así que no l{F#as}{M#os} molestaré más. Si tienen alguna duda, pueden consultar directamente con Muning, está en la entrada del campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Ehmm... No es que desconfíe de ustedes, solo cumplo con mi deber. Una última advertencia: ¡no hagan nada ilegal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "#Tranquilo, ¡puedes confiar en nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "¿Me conoces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "¡Nos reconoció! ¡A correr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}