			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Qué bien, sabía que vendrías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820402,
					"content": "Me dijeron que querías verme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Siempre me ha gustado el desierto a esta hora del día, es precioso. Me encanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820405,
					"content": "Pero... es una pena que nunca haya podido ver el atardecer, aquí, junto a mis amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820406,
					"content": "Sí... El desierto se tiñó de color escarlata... Qué bonito se ve y qué tranquilo está todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Pero, Tadla, ¿nos llamaste solo para ver esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820409,
					"content": "#Para los Tanit, eres {F#una invitada}{M#un invitado}, pero para un halcón, una presa potencial... Aunque, a decir verdad, espero que sobrevivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Así que... lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732820403,
					"content": "¿Cómo estás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328206",
							"2"
						],
						"stepId": 7328206,
						"stateName": "QUEST_STATE_UNFINISHED"
