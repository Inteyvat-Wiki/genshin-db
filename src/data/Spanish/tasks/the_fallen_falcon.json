				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lilúpar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Arg... ¡Masseira ha desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Ha dejado una nota... Hum, audaz zorro viejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Lilúpar"
				},
				{
					"id": 732820603,
					"content": "Si estás leyendo esta nota, entonces ya estaré en las profundidades de un refugio en el desfiladero.\\nSi tu cabeza sigue en su sitio, no sufras por la elección de Tadla.\\nEsta cacería aún no ha terminado. Esto es solo el principio de la tormenta que se avecina.\\nYo, Masseira, cazador y anciano de los Tanit, te doy este aviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 732820604,
					"content": "¿Eh? Paimon no entiende bien qué quiere decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Parece que abandonó la tribu bajo presión y os dejó esta nota. Hum, los Tanit... A la vista está que no son tan pacíficos como aparentan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lilúpar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadla desvía la mirada y baja la cabeza nerviosa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822802,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Lo siento, se acabó la cacería. Yo soy la halcón de mi padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822804,
					"content": "Pero estoy bien, no te preocupes por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822808,
					"content": "Eso es un poco extremo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "¿Extremo? No lo sé. Desde pequeña es así como he vivido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822814,
					"content": "Pero... Por otro lado, las historias de Paimon y tuyas, sus viajes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822815,
					"content": "De tener la oportunidad, me gustaría oír más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822816,
					"content": "¡No hay problema! ¡Tenemos muchas historias que contar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Claro, te las contaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "*Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822820,
					"content": "*Ejem*, no es nada. Es solo que estoy muy feliz... Ah, quiero decir... bueno, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822818,
					"content": "Si estás interesada, puedo contártelas cuando quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "¿Nunca has pensado en vivir para ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822812,
					"content": "No, nunca lo he pensado ni he tenido ese tipo de expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822813,
					"content": "El desierto es un lugar cruel en el que no hay tiempo para pensar en uno mismo. Sin mí, la tribu seguiría adelante, pero sin la tribu, yo no podría sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822805,
					"content": "Cuéntame cómo es tu relación con Masseira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Como dije, es mi padre, y yo soy su halcón. Sigo sus instrucciones, cazo para él y arriesgo mi vida por él... Pues él representa la voluntad de los Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadla"
				},
				{
					"id": 732822807,
					"content": "Si llegara el día en el que no pudiera cumplir con las órdenes de mi padre, mi vida como halcón terminaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadla"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "#Ah, ha venido, venerad{F#a}{M#o} maestr{F#a}{M#o} de genios. ¿Qué puedo hacer por usted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822902,
					"content": "Me gustaría saber más sobre Tadla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822903
					]
				},
				{
					"id": 732822903,
					"content": "#Ella l{F#a}{M#o} aprecia, se nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822904
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822904,
					"content": "No se preocupe, no me pienso entrometer. Cosas de jóvenes... ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822905
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822905,
					"content": "Quiero animarla para que exprese más sus sentimientos. Es mi deber como adulto, y como padre... Así que, por favor, no se preocupe por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822906,
