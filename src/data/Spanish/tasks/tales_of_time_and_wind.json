			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, parece que nuestra música ha conmovido tanto a nuestro público que algunos han decidido entrar en escena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Pero eso va contra las normas de un concierto, así que pidámosles que se retiren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
