			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#Bueno, eso será suficiente. Una actuación exquisita, {NICKNAME}. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Ese poder que acabas de liberar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, no te preocupes. Ese poder procede de mí. No he tenido ninguna ayuda externa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Puedes pensar en ello como si... hubiera afinado un instrumento musical para que pudiera tocar melodías aún más hermosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "¡Vaya, Paimon ve que tenías más trucos bajo la manga! ¿Qué más estás ocultando, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Ay, Paimon. ¿Cuántos trucos más crees que puedo guardar? Solo tengo dos mangas, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "¡Eso no es a lo que se refería Paimon, bardo de pacotilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Jajaja, parece que hoy habrá mucho viento. Será mejor que regresemos a Mondstadt para avisar a todos de que recojan la ropa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
