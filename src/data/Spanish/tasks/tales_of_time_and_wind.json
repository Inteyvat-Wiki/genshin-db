					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "¿Es alguna isla especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "¿Este lugar es especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "No siempre lo fue. Solía ser una isla como cualquier otra, una acumulación de arena y roca normal y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Hasta que las semillas de las historias fueron arrastradas hasta aquí por el viento y cultivadas por el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Más tarde, las ráfagas trajeron nuevas historias y el tiempo las convirtió en leyendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "Así que... Permítanme darles la bienvenida realmente a esta isla en la que el Tiempo ha fijado su mirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Este es el lugar en el que el Tiempo y el Viento se encontraron en un pasado lejano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Oh, vaya... Qué serio te has puesto de repente, bardo de pacotilla. Paimon no está segura de si está entendiendo todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Jeje, no te preocupes, pequeña Paimon, las mejores historias siempre comienzan a lo grande y dejan un poco de intriga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
