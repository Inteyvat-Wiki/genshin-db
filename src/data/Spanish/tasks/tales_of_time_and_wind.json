			"dialogs": [
				{
					"id": 100070101,
					"content": "... Me lo tomaré como un sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070102,
					"content": "¿Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#¡Ah, por fin estás aquí, {NICKNAME}! ¿Tienes un mensaje para mí, por casualidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070104,
					"content": "¿Un mensaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "“No hay ni una sola profecía sobre ti en este diccionario”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070107,
					"content": "Eso es lo que ibas a decir, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070108,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#¿Eh? Un momento, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070111,
					"content": "Humm... Parece que la curiosidad de Barbeloth es tan ávida como siempre. Pero me temo que mi “futuro” tendrá que seguir estando ausente en su diccionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070112,
					"content": "Puede que al viento no le importe que los dientes de león tracen su forma y que los poetas canten versos sobre él, pero no forma parte de su naturaleza quedar contenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070113,
					"content": "Por eso, querida Barbeloth, deja tu pluma a un lado. Las palabras que arrastra el viento no están destinadas a quedar plasmadas en el papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070114,
					"content": "Si realmente te interesa tal leyenda, permíteme darle forma de poema. Me aseguraré de compartirlo con ustedes en nuestra próxima hora del té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070115,
					"content": "¿Barbeloth? Ella...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "Jajaja, Barbeloth siempre ha sido una persona razonable, y creo que ha escuchado mi petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070117,
					"content": "Por lo tanto, nuestra conversación debería estar libre de interrupciones por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070118,
					"content": "¿Qué? ¿Barbeloth estaba escuchándonos? ¡P-Paimon no se había dado cuenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070119,
					"content": "Bueno, al fin y al cabo es una bruja del Aquelarre. Todas ellas esconden trucos bajo la manga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070120,
					"content": "Aun así, te diste cuenta de inmediato e incluso lograste que nos dejara en paz. ¿No te convierte eso en el verdadero maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070121,
					"content": "Humm... Teniendo en cuenta los diversos factores prácticos en juego, me consideraría un maestro... con sus límites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070122,
					"content": "Tan misterioso como siempre. Bueno, sea como sea, no había nada sobre ti en el diccionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070123,
					"content": "Sí, ella solo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "Eso ya es suficiente. La profecía de Barbeloth en lo que a mí se refiere puede resultar bastante incompleta. Pero no incorrecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070126,
					"content": "Hay algo que debo hacer, y tu ayuda no me vendría mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070127,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "#Oh, qué dispuest{F#a}{M#o}. Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070130,
					"content": "#¿Te importaría tocar una canción conmigo más tarde, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070131,
					"content": "¿Eh? Claro, supongo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "Sí. Eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070134,
					"content": "Pero no te preocupes. No se trata de una actuación que decidirá el destino de algún evento trascendental... Es solo un dueto entre amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070135,
					"content": "La última vez que toqué esta canción, mi único público fue el viento aullador, y las notas se dispersaron en todas direcciones, dejando solo fragmentos de la melodía tras de sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070136,
					"content": "#Pero ahora, con un{F#a} amig{F#a}{M#o} como tú a mi lado, ¿por qué debería ser el viento el único testigo de mi música?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070137,
					"content": "#Además, seguro que mis manos se vuelven más firmes al tocar junto a un{F#a} amig{F#a}{M#o} tan buen{F#a}{M#o} como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070138,
					"content": "Tocaré lo mejor que pueda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "Está bien. Dirijámonos pues al lugar de la actuación. Sigamos el viento y llegaremos enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070132,
					"content": "¿Pero eso es todo lo que necesitas que haga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "Puedes contar conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "Me dijo que viniera aquí y esperara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "Pero la bruja me pidió que te buscara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "En realidad, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
