					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071001,
					"content": "Antaño, yo convoqué los primeros vientos de la libertad por Mondstadt. Con su ayuda, pude devolvérsela a todos aquellos que debían ser libres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Ya te hablé de eso antes, ¿recuerdas? Sobre cómo me encontré con el Tiempo en el Templo de los Mil Vientos y recibí ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Bueno, que aquellos primeros vientos de la libertad pudieran soplar con tanta fuerza fue gracias a la ayuda del Tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Pero vientos impetuosos como aquellos son más aptos para arrasar que para ayudar a crecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Por eso, tras resolver unas cuantas crisis en Mondstadt, hice que los vientos soplaran con más suavidad, manteniendo la fuerza suficiente como para armar de valor a las gentes en tiempos de necesidad sin tener que derribarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Así que, aquí estamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "#Las sombras se están reuniendo en la distancia. Seguro que tú también lo percibes, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Los vientos me trajeron noticias del enfrentamiento entre la Arconte Pyro y la Soberana de la Muerte, Ronova, y de lo que ocurrió con Capitano de Los Once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Y eso sin mencionar que la actividad del Abismo no ha dejado de acercarse a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Me temo que la resolución de la crisis que se avecina podría estar fuera del alcance de los humanos... Teniendo eso en cuenta, debo prepararme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "Es el deber del Arconte Anemo intervenir en tiempos de necesidad. Por eso yo, Barbatos, convocaré un viento lo suficientemente fuerte como para disipar cualquier tormenta que se avecine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Pero si levanto un vendaval de tal magnitud en Mondstadt, todo quedaría patas arriba: la ropa, los sombreros, las flores que adornan los balcones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Por eso elegí hacerlo aquí, en el lugar donde una vez ofrecí una oda al Tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "¿Quién sabe? Puede que el Tiempo muestre predilección por esta isla precisamente por mi hermosa música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Un momento... ¿Tan especial es este lugar? No lo parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "La marea sube y baja, los pájaros se posan en ella de vez en cuando... Parece tan normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "El impacto del Tiempo sobre las cosas no se limita solo a aquello que se puede ver. Piensa en ello como si fuera... una solsettia madura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Si la cáscara exterior permanece intacta, es casi imposible que una persona común sepa si la fruta está madura en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Pero incluso el agujero más pequeño en dicha cáscara hará que la fruta se pudra, comenzando desde ese lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Acunada entre los brazos del Tiempo, ni una sola imperfección marca la “cáscara” de esta isla. Por tanto, la influencia del Tiempo sobre su misma esencia permanece oculta para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Fundamentalmente, todas las cosas que no tengan el favor del Tiempo acabarán siendo borradas en algún momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Pero gracias al poder que permanece aquí, puedo hacer que el Tiempo trace un límite alrededor del Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "De esta forma, el mundo exterior no llegará a percibir nada sin importar cuán poderoso sea el vendaval que convoque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Pero, como es lógico, al pedir ayuda se debe ofrecer algo a cambio. Por eso te he invitado aquí, {NICKNAME}, para que podamos tocar una oda al Tiempo juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Avísame cuando estés list{F#a}{M#o} para tocar. Si no tienes un instrumento, puedo prestarte uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "¿Qué quieres hacer exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
