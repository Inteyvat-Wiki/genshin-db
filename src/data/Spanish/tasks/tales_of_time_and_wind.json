			},
			"dialogs": [
				{
					"id": 100070301,
					"content": "Paimon pensó que tendríamos que volar muy lejos, pero parece que tan solo estamos a las afueras de la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
