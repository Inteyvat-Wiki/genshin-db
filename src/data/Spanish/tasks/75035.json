					"nextDialogs": [
						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "#Parece que a {REALNAME[ID(2)|SHOWHOST(true)]} le gusta mucho este sitio. Es lógico, seguro que antes de conocernos, habías pasado un largo tiempo aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351204,
					"content": "Paimon no está segura de si esos pilares brillantes de ahí fuera desaparecerán después de que salgamos... ¡pero limpiemos y descansemos aquí un rato primero!",
					"roleType": "TALK_ROLE_NPC",
