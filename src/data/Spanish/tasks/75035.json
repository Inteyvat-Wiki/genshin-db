			"dialogs": [
				{
					"id": 750350801,
					"content": "¡Guau! ¡He recuperado mis herramientas! ¡Qué bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Ahora que me fijo, es una gema tan bonita, como la garra de un pájaro que transparenta un color carne tirando a amarillo... ¡Bah! ¡No debería compararla con esos malditos pájaros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Quiero decir... es como el cielo al amanecer, cuando el sol apenas comienza a salir... Esta descripción me gusta más...",
