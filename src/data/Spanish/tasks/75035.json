			"dialogs": [
				{
					"id": 750350101,
					"content": "Disculpa... ¿Eres el maestro Kulahaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Así es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Oh, ¡entonces tú eres el maestro joyero que está recolectando inspiración! Venimos por la recomendación de Imix. Justo ahora Paimon te vio mirando a los árboles, ¿eso forma parte de tu proceso de recolección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Eh... en realidad... Da igual, ya no es importante. Bueno, ¿me buscaban por algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Trajimos una gema preciosa, ¡queríamos pedirte que la tallaras para {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Jeje, {REALNAME[ID(2)|SHOWHOST(true)]}, vamos, ¡saca la gema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "¡Grrr! ¡Grrr...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#El aleteo de un pájaro llega a tus oídos...\\nCuando reaccionas para echar un vistazo, la gema que tenía {REALNAME[ID(2)|SHOWHOST(true)]} en las garras ya había desaparecido.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "¡Grrr, grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Un momento, ¿y la gema? ¿Dónde se fue una gema tan grande?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Creo que el pájaro se la llevó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "¡¿Cómo?! ¿Los pájaros de aquí roban cosas? ¡Qué poco educados son!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "¡GRRR! ¡GRRR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "#Lo que les iba a decir es que aunque no les hubieran robado la gema, tampoco puedo ayudarl{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "¡Porque esos malditos pájaros también me robaron todas las herramientas! Y lo que estaba haciendo era buscar cuál de los pájaros las tenía en sus garras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#No puede ser... ¡Qué pájaros más malos! {NICKNAME}, ¡vámonos a recuperar la gema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "Y mis herramientas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
