					"nextDialogs": [
						750351206
					]
				},
				{
					"id": 750351206,
					"content": "Jeje, este sitio no está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351207,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} está muy emocionado desde que llegamos a este sitio, ¿será que quiere decirnos algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "Mmm, grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "¿Eh? ¿Quieres que nos demos media vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "¿Habrá preparado alguna sorpresa? Jaja, ¡su mente es tan transparente como las burbujas! ¡No es nada difícil de adivinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "¡Pues tenemos que cooperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Paimon y tú se dan media vuelta, escuchan algunos ruidos sin parar.\\nNo saben lo que {REALNAME[ID(2)|SHOWHOST(true)]} está haciendo...\\nUn momento después, {REALNAME[ID(2)|SHOWHOST(true)]} dice “¡Grrr!”. Parece que es hora de girarse...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "¡Cuántas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Veamos, una rama extremadamente recta, una piedra redonda... y una comida con un color y un olor extraño de quién sabe cuándo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "#¿Todo esto lo has estado guardando cuidadosamente para regalárselo a {NICKNAME} y Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Pero la comida que lleva mucho tiempo fuera no se puede comer. Nos sentará mal si la comemos, así que tenemos que deshacernos de esto primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "¡Qué rama tan afilada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Sí, ¡da la sensación de que es tan poderosa como una espada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "¡Pues Paimon se lo quedará todo! Jeje, lo guardará con sus tesoros, ¡a lo mejor nos sirven en alguna ocasión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Ya que {REALNAME[ID(2)|SHOWHOST(true)]} nos ha regalado tantas cosas, tenemos que regalarle algo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Paimon va a ver qué tiene en su tesorería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Qué generosa estás hoy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#Al fin y al cabo es un detalle de {REALNAME[ID(2)|SHOWHOST(true)]}, ¡Paimon tiene que apreciarlo! Además, Paimon lleva tantas cosas que ya le cuesta volar, esta es la oportunidad perfecta para aliviar un poco su carga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#¡Tachán! Es una gema brillante. {REALNAME[ID(2)|SHOWHOST(true)]}, ¿te gusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "¡Guau! Qué contento te pusiste, parece que Paimon dio con el regalo... Oye, cuidado, no la rompas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "#Paimon tiene el presentimiento de que pronto {REALNAME[ID(2)|SHOWHOST(true)]} la perderá si la agarra de esa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "¿Y si vamos a los Vástagos del Eco para que un artesano profesional la talle a su medida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Paimon, ¿qué has estado guardando ahí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#¡Es un secreto! Eres {F#la}{M#el} mejor amig{F#a}{M#o} de Paimon, pero Paimon no te lo puede decir. En cualquier caso, Paimon tiene suficientes cosas como para elegir un regalo para {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "¡Qué piedra más redonda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "#Es redonda y brillante. Paimon y {NICKNAME} hemos recorrido innumerables ríos, pero rara vez hemos visto una piedra tan redonda, ¡realmente es una piedra muy especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				}
			]
		}
