					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Qué metáforas más normalillas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Eh, no soy narrador, yo solo me centro en recordar los bellos colores de la naturaleza... El cómo describirlos bellamente no es mi especialidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "Dame la gema. Como dije antes, la procesaré gratis como agradecimiento por recuperar mis herramientas. En cuanto al tiempo... ¡esperen dos días para ir a recogerla a la joyería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "¿Ese es el sentido de recolectar inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "¿Has oído hablar de la recolección de inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
