						],
						"pointId": 8840
					}
				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "#Hola, chic{F#as}{M#os}. El maestro Kulahaw ya dejó la gema terminada en la tienda, y me dijo que se la entregara en persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "¿Eh? ¿Hoy tampoco se encuentra en la tienda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "No, salió a buscar inspiración, y de paso, elaboró un juego de candados para llevar las herramientas encima. Dice que es para evitar que le roben. Qué extraño... ¿quién querría robarnos las herramientas de tallado para venderlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "¡Claro que no! ¡Lo que pasa es que...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(Al parecer Imix no sabe que los pájaros son los ladrones... ¡Mejor no revelarlo para no hacer quedar mal al maestro!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Lo que pasa es que alguien se piensa que robando las herramientas puede quedarse también con las técnicas... jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Olvídalo... ¡Gracias por la gema! ¡A Paimon le encanta la forma que tiene! ¡Qué manos más hábiles las del maestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#¡Parece que a {REALNAME[ID(2)|SHOWHOST(true)]} también le gusta mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Se lo agradecemos por {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Jaja, nos alegra que le guste al pequeño saurio. Transmitiré sus cumplidos al maestro Kulahaw. ¡Pasen a menudo a visitarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
