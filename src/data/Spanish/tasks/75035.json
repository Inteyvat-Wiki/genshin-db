					}
				]
			},
			"dialogs": [
				{
					"id": 750350401,
					"content": "#¡Bienvenid{F#as}{M#os}! ¡Si desean tallar piedras preciosas, están en el lugar más indicado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "¡Hola! Efectivamente queremos tallar una gema para regalársela a este pequeño Tepetlisaurio. Mira, es esta gema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "¡Oh! ¡Es una gema magnífica y poco vista! Miren el tamaño, y lo cristalina que es... Aunque si la quieren hecha a medida, va a ser más complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "A Paimon le suenan esas palabras... ¿Qué dirás a continuación? ¿Que hay que pagar un coste adicional?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "¡Claro que no! ¡¿Por qué clase de persona me toman?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Nuestra tienda se especializa en la artesanía de piedras preciosas, y si nos encontramos con una buena piedra, estamos dispuestos a pulirla gratis para que su belleza perdure con nuestro nombre. Nunca haríamos eso de aprovecharnos de nuestros clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Así como un buen artesano necesita encontrar materias primas asombrosas, una buena piedra preciosa necesita al artesano adecuado. Conozco a un maestro joyero que es perfecto para trabajar esta gema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "¿Tan bueno es? ¿Dónde está ese maestro joyero? ¡Llámalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Peeero tienen que pedir cita para verlo. Si no vienen con cita, por lo general está fuera recolectando inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "¿Recolectando inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "¡Así es! El maestro Kulahaw es muy especial entre los artesanos, ya que considera que un gemólogo no debe limitarse a pulir un dibujo, sino que debe ser bueno observando todas las bellezas de la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Por ejemplo, aprender técnicas de pulido basándose en las pequeñas ondas de un lago; aprender patrones calados basándose en las variaciones de las nubes... ¡Él dice que a esto se le llama recolectar inspiración!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Humm... Qué complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "Si tienen mucha prisa, pueden ir a buscarlo aquí, dijo que iría a este sitio para recolectar inspiración, ¡se lo indicaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
