				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Zhichiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#¡Hola, {NICKNAME}! ¿Cómo estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360202,
					"content": "Estoy bien, ¿y tú? ¿Estás mejor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "#Estoy perfectamente, gracias por preguntar. Siento mucho haberl{F#as}{M#os} preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360206,
					"content": "¡Zhichiong, no te alejes demasiado! Será mejor que no pase como la última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360207,
					"content": "No te preocupes. Gracias a sus esfuerzos, la Sima es un lugar mucho más seguro ahora. Y la situación del terreno también se ha vuelto mucho más... estable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360208,
					"content": "Aunque Jinwu y Khedive aún tienen que seguir investigando las características de ese misterioso cristal, como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360209,
					"content": "Humm, ¿su longitud de onda? Eso es lo que dijo Khedive. Supongo que será algún término extraño procedente de Sumeru. Sea como sea, lo primero es instalar las balizas para poder recopilar datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360210,
					"content": "Jinwu por fin encontró tiempo para ensamblar todas las balizas. Ahora tengo que colocarlas en distintos puntos para reunir datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360211,
					"content": "Después de un rato, podremos recogerlas y Khedive se encargará de hacer los cálculos pertinentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360212,
					"content": "Antes había muchas zonas que no eran seguras, así que solo podíamos realizar lecturas dentro del campamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360213,
					"content": "Pero ahora que has despejado el camino, podemos usar las balizas en estudios de campo y obtener datos más precisos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360214,
					"content": "*Suspira*... Es mejor mantenerse ocupado que estar ocioso. ¡Si no tienes nada que hacer, puedes echarme una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360215,
					"content": "Entonces, ¡en marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "Bien, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360217,
					"content": "#¿Y nosotr{F#as}{M#os} qué ganamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "#¡Qué direct{F#a}{M#o} eres, {NICKNAME}! Aunque la verdad es que Paimon también se lo estaba preguntando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360219,
					"content": "Jaja, solo es un viajecito, pero supongo que Jinwu te lo agradecerá de alguna forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360204,
					"content": "No me va mal, al menos sigo con vida. ¿Y tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "¡Estoy perfectamente! Vaya... parece que tanta aventura te está pasando factura, ¿eh? Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhichiong"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhichiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "#Gracias por tu ayuda, {NICKNAME}. ¡Por favor, acepta esto como muestra de agradecimiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360302,
					"content": "Eres muy amable, Zhichiong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "Hum... Parece que últimamente ya no se producen cambios topográficos en la Sima. Eso quiere decir que solo tengo que hacer unas pequeñas modificaciones al mapa que ya tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360304,
					"content": "Gracias a tus aventuras, ahora mi trabajo es mucho más sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360305,
					"content": "Ah, no te entretengo más. Ve a descansar un rato o sigue explorando, ¡lo que prefieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360306,
					"content": "Humm... Aún es pronto para recuperar las balizas. Si fuera necesario, espero poder contar con tu ayuda de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhichiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411202,
					"content": "Sobre los mapas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "¿Los mapas? No hay mucho que contar sobre ellos. Antes de unirme al Gremio de Aventureros, fui la cartógrafa de la mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411204,
					"content": "Naturalmente, no era una de esas chicas que solo se dedican a dibujar sentadas en un escritorio... Ni de lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411234,
					"content": "Hace tiempo, recibí un encargo para cartografiar el terreno de la Aldea Chiaoying... Pero al final cancelaron el plan de construcción de repente, sin ninguna explicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411205,
					"content": "Dijeron que solo necesitaban ayudantes para explorar el terreno y recabar información cartográfica, y que luego la gente de la aldea haría el resto del trabajo... Pero los cartógrafos no somos así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411206,
					"content": "Como minera a tiempo parcial, hace mucho que me acostumbré a atravesar peligrosos pasajes subterráneos. Así funciona este trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411207,
					"content": "Además, tras la incidencia de las anomalías, los niveles más inferiores de la Sima se volvieron cada vez más... inestables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411208,
					"content": "¿Eh? ¿Inestables? ¿Tan peligroso es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411209,
					"content": "Lo es. El terreno cambia de forma progresiva. Donde hoy ves un camino, quizás sea un muro de roca dentro de un mes. Es como si... ¿Cómo explicarlo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411210,
					"content": "Es como si la Sima cambiase de forma a su antojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411211,
					"content": "Eh... Suena espeluznante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411212,
					"content": "Háblame sobre tu carrera como aventurera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "Jaja, ¿cómo? ¿Mi “carrera”? No tienes por qué ensalzarlo tanto. Todavía soy una novata. Apenas acabo de comenzar mi viaje. Aún me queda mucho camino por delante, no como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411214,
					"content": "Completé varios encargos del Gremio, claro, pero todavía no tengo mucha experiencia, así que he salido mucho a explorar en solitario. Tampoco he plasmado mis historias en ninguna parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411215,
					"content": "Así que siempre he pensado que la Sima es el lugar donde podré dejar huella para que lo recuerden las generaciones futuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411216,
					"content": "La Sima será como dijo la aventurera Alice: “¡mi Rubicón!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411217,
					"content": "¿“Rubiocón”? ¿Eso es hilichurlio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "Paimon nunca lo había oído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411219,
					"content": "Oh... Yo tampoco sé muy bien lo que es, pero ya que Alice es una gran aventurera de muchos mundos, debe ser algún lugar donde ella haya estado... ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411220,
					"content": "Oh... Así que tu “Rubitokun”... ¡Espléndido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "Un momento, ¡pero si ni siquiera sabes lo que es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411222,
					"content": "Jaja, no importa, gracias de todas formas por tus ánimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411223,
					"content": "En cuanto a Clitofo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "¿Ese? No me fío de él. No sé durante cuánto tiempo habremos lidiado con los ladrones de tesoros en la superficie, pero te aseguro que nunca traman nada bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411225,
					"content": "No te creas ni una palabra de lo que diga Clitofo. Que si “dame una segunda oportunidad”, que si “borrón y cuenta nueva”... Lo único que hace es lavarse las manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710411226,
					"content": "Y mientras dice esas palabras tan bonitas, estará metiendo la mano en tu bolsillo...",
					"roleType": "TALK_ROLE_NPC",
