			"dialogs": [
				{
					"id": 220100916,
					"content": "Creo que las ideas de Junkichi no están nada mal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "¿Nada mal? ¡Si sigue así, al final él mismo se confundirá con todo lo que ha inventado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "#¡Jajaja! ¿Ves? ¡{F#La viajera}{M#El viajero} me apoya! ¡Eso quiere decir que mis ideas atraen a la gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100919,
					"content": "Lo más importante en una novela es que la trama sea interesante y atraiga a la gente. ¡Seguiré desarrollando este argumento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "No te preocupes, yo no me confundiré con las cosas que escribo. Si continúo así, las críticas serán buenas, ya verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
