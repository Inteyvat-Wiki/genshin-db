			"dialogs": [
				{
					"id": 220100801,
					"content": "Los guardias garantizan el orden en Hanamizaka y descubren de un vistazo a las personas sospechosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Los guerreros enemigos tienen las mismas responsabilidades que estos guardias. Pero, para que sea más interesante, les pondré... ¡Una fuerza diez veces mayor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "¡¿Diez veces?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "¡Sí, así quedará más clara la grandeza del protagonista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "En cuanto a eso... ¡Ya sé! El protagonista tendrá la capacidad de camuflarse y podrá modificar su forma física y su voz a su antojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "¿Otro superpoder nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Es un poder oculto que tenía el protagonista, y obviamente no se manifiesta hasta que lo necesita para derrotar a unos enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Tú escribes sobre la marcha, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "¡No! ¿Cómo se te ocurre? Ya lo tenía todo pensado de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Bueno, pues ya está decidido. Regresamos para contarle mi idea a Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "¿Y cómo resolverá el protagonista este problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
