			"dialogs": [
				{
					"id": 220100401,
					"content": "En el capítulo que tengo en mente ahora mismo, el protagonista va en solitario al territorio enemigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100402,
					"content": "¿Cómo puede derrotarlos y reunir la información que necesita de manera fácil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
