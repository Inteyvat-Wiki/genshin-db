			"dialogs": [
				{
					"id": 220100901,
					"content": "¡Fuimos a la Herrería Amenoma y encontré la inspiración para una nueva trama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100902,
					"content": "¿En serio? ¡Estupendo! ¡Cuéntamelo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100903,
					"content": "En una noche oscura, el protagonista descubre de repente que posee una técnica de forjado alquímico: ¡la “Reaparición de la hoja legendaria”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100904,
					"content": "¡Incluso si lo que tiene en la mano es un cuchillo oxidado, solo tiene que recitar el nombre correspondiente y se transformará en una espada divina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100905,
					"content": "De esta forma, podrá... ¿Eh? ¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100906,
					"content": "¿Otra vez vas a empezar así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100907,
					"content": "¿Otra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "¡Me refiero a ti! ¿Otra vez vas a inventarte nuevos poderes para avanzar en la historia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100910,
					"content": "Y después tienes que inventarte unas características aún más complicadas para esos poderes, y así escribes un capítulo nuevo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100911,
					"content": "¡Por mucho que te guste este personaje, no puedes añadirle tantos elementos! ¡Los lectores se van a hartar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100912,
					"content": "¡Mi estilo ha sido así desde siempre! ¡Opino que un argumento así es muy atractivo y estoy seguro de que a los lectores les gustará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100913,
					"content": "¿Sí? ¿Estás seguro? ¡Pues que sepas que muchos lectores ya están cansados de todas esas palabras que te inventas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100914,
					"content": "#¡No quiero discutir eso contigo! ¡Tus ideas son demasiado conservadoras! Preguntemos a est{F#a}{M#e} viajer{F#a}{M#o} su opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100915,
					"content": "#Viajer{F#a}{M#o}, ¿quién crees que tiene la razón, Shigeru o yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100908,
