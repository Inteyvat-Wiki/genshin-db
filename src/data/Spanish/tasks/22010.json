			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "La opinión de Shigeru es más razonable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "¿Más razonable? ¡La razón es aburrida y no atrae a los lectores! ¡Lo que necesitamos es un argumento interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "Este hombre... ¡Si sigues añadiendo cosas así, cuando tengas que escribir el final no serás capaz de atar todos los cabos sueltos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "¡Lo tengo todo anotado! ¡Cuando escriba el final no habrá ningún problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "¡Si incluso tú necesitas anotarlo para acordarte! ¿Es que esperas que los lectores vayan tomando notas mientras leen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "¡No es que no te deje usar esos recursos literarios, pero tienes que utilizarlos con mesura y de la manera adecuada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Escribir una novela es como una carrera de fondo; si utilizas toda tu energía al principio, llegarás al final muy debilitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "Para que una novela tenga éxito, es necesario avanzar con seguridad y paso a paso. ¡Confía en mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
