			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "El Bazar Tsukumomono tiene artículos de todas clases, como el botín que se obtiene al estar de aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "La Srta. Aoi siempre dice, “la basura de uno es el tesoro de otro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Para lograr un precio de venta elevado, es crucial descubrir por qué factores se interesará el comprador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Pero, si lo escribo así, tendré que emplear bastante tiempo para describir las motivaciones psicológicas, y no pega mucho con el tema principal de «El espíritu marcial»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "¡Lo mejor será que el protagonista pueda leer las mentes! Así podrá comprender directamente las necesidades de los compradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "¡No puedes añadir poderes así como así!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "No importa, es el desarrollo del personaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "¡He obtenido mi inspiración! ¡Ya sé cómo continuar la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "#Regresemos, viajer{F#a}{M#o}. Le contaré mi idea a Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Pero no tiene un argumento en el que apoyarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Un argumento en el que apoyarse... Sí, lo pensaré mientras lo escriba. ¡No habrá ningún problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
