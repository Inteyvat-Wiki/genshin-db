				"points": []
			},
			"dialogs": [
				{
					"id": 761830201,
					"content": "Es importante encontrar tiempo para relajarse de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830204,
					"content": "Muy bien. Nos vemos en Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
