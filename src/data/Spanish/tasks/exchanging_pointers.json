			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elzer",
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Bien hecho, Connor. Si sigues así, ¡seguro que podremos invitar a Diona para que sea cantinera permanente del Viñedo del Amanecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Espero que lo consigamos. Tras varias semanas seguidas vigilándola, por fin tenemos esta rara oportunidad que no debemos dejar pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Muchas gracias, Connor. Mientras consigamos que Diona venga, todos nuestros esfuerzos habrán valido la pena. Esto es el primer paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Recuerda: ¡debemos hacer que Diona sienta nuestra buena fe y hospitalidad! Así que, por favor, no seas maleducado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "No se preocupe, Sr. Elzer. Lo hemos ensayado muchas veces, así que seguro que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "¿De qué hablan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "¡¿Eh?! D-de nada, estábamos discutiendo... sobre unos asuntos de negocios relacionados con el viñedo, jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Sí, eso. Estábamos hablando de negocios. Bueno, Sr. Elzer, sigamos con lo de los gastos del viñedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
