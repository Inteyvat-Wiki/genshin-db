					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 1910798,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
