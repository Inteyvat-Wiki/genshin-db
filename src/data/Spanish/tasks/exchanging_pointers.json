			"dialogs": [
				{
					"id": 191079701,
					"content": "Sr. Elzer, pero si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079702,
					"content": "Connor, ahora lo más importante es hacer que Diona pueda sentir nuestra buena fe, ¿entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079703,
					"content": "¡E-entiendo, Sr. Elzer!",
