			"dialogs": [
				{
					"id": 221071301,
					"content": "Un gato y un pez se hicieron amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "¡Debes tener los ojos bien puestos para encontrar esas señales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "Una amistad tan inusual es grandiosa, no importa que sea entre gatos y peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "¡Tiene que ser amor! ¡El poder del amor puede superarlo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "Si pudiera, me gustaría mostrarles mi aprecio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Esta debe ser una señal de que en el amor no hay que temer ante las adversidades, solo así Chiming podrá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "*Ejem* ¡Gracias! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
