				"points": []
			},
			"dialogs": [
				{
					"id": 221071701,
					"content": "¿Y esas hojas caídas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "Humm... Paimon no cree que unas cuantas hojas tenga algo que ver con el amor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "¿Unas hojas caídas? ¡Por supuesto que tienen que ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "Aunque aparentemente están marchitas y no tienen ninguna utilidad, estas hojas tendrán su momento de brillar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "Con una chispa pueden arder e iluminar. Con un soplo de viento, pueden volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "Básicamente es una señal de que si resguardo mi amor, llegará la oportunidad de que Chiming y yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "¡Ay! Pero nadie sabe cómo, cuándo o dónde, solo depende de los cielos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "Bueno, no hay de qué preocuparse, todas las cosas pasan por algo, solo hay que ser paciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "El destino de estas hojas es como el mío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Un momento... Quieres decir que... No me digas que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "No, no. Si me adelanto a mi oportunidad, ¡será un desastre para mi vida amorosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "¿Quién crees que eres, jugando a ser dios con el destino de estas hojas? Tal vez estabas tratando de ayudar, pero te aseguro que has hecho más daño del que crees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "¿Ahora qué debo hacer? Pueden ocuparse de sus asuntos, necesito un tiempo a solas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
