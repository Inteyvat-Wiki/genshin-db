			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "Vi un par de tórtolas en un tejado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "¡Oh! Bien, muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Dos palomas enamoradas que, cuando dejan el nido solo cuentan la una con la otra y solo desean volar juntas hacia el firmamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "Esta debe ser una señal... ¡Quiere decir que pronto encontraré a alguien que me amará a mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "Y cuando ella supere todos los obstáculos y logre escapar del bullicio de la gente, volaremos juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "*Ejem* Les agradezco mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Quién sabe... Por alguna circunstancia se llegan a conocer, a reconocerse, a amarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "¡Qué lástima que no nací paloma! Podría saborear el amor de tórtolos. Es una verdadera pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Puedes saborear una paloma asada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Una paloma asada... Un momento... ¿Qué insinúas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "¡Qué tonterías dices! ¡Es una metáfora! ¡Me-tá-fo-ra! ¡No es que puedas saborear el amor literalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "¡No tienes que ser tan insensible! En ese caso, mi suerte en el amor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "Olvídenlo, no dije nada. Necesito tiempo para reflexionar... Pueden irse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
