			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "“El amor está allá lejos, en el cielo, y justo debajo de nuestras narices. Sin tener que forzarlo, algún día llegará a ti”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070102,
					"content": "¿De qué hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "¿Es que no lo ves? De mi suerte en el amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070104,
					"content": "Esas palabras fueron escritas para mí. “Allá lejos, en el cielo, y justo debajo de nuestras narices...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070105,
					"content": "Obviamente tiene un mensaje oculto, pero ¿cuál?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070106,
					"content": "He leído en varios libros que cuando la suerte toca a tu puerta, puedes ver señales en todos lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070107,
					"content": "¡Y creo que mi suerte en el amor está a punto de llegar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070108,
					"content": "¿Puedes ayudarme a buscar “señales” en los alrededores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070109,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070110,
					"content": "¿Por qué no vas tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "El espectador ve más que el jugador. Si fuera yo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070113,
					"content": "Vería todo como señales de mi amada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070114,
					"content": "¡Así que cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
