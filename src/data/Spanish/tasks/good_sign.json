				}
			]
		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
