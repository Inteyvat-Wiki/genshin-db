				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "He de decir que las personas como tú son las más adecuadas para hacer investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030402,
					"content": "Ustedes tienen mucha experiencia de aventura y están en buena forma física...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030403,
					"content": "Y lo más importante: no tienes una Visión, pero puedes controlar los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030404,
					"content": "Los elementos... ¿Hay alguna investigación en este mundo que realmente pueda revelar sus secretos? Para los investigadores, poder controlarlos sería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030405,
					"content": "Oh, lo siento. Otra vez me anduve por las ramas... No te lo tomes como algo personal, por favor. Siempre lo hago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		},
		{
			"id": 2070305,
