			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "¿Descubriste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030502,
					"content": "Encontré unas hojas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "¿Hojas? Déjame ver. Oh, hasta las pusiste en una cajita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030504,
					"content": "Puedo sentir el viento con solo ponérmelas en las manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030505,
					"content": "Así que este es el poder del árbol... Si tuviera una Visión, no habría malgastado tanto tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030506,
					"content": "Gracias. Este material es muy valioso. Ten por seguro que lo usaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030507,
					"content": "Aunque, ahora que lo pienso, no sé dónde voy a guardar estas hojas... Su viento podría disiparse de un momento a otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030508,
					"content": "Toma, esta es tu recompensa. Es posible que en un futuro vuelva a necesitar tu ayuda para reunir más material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		}
	]
