					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "¡Maravilloso! Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030303,
					"content": "Tú puedes ver los elementos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030304,
					"content": "Según mi teoría, bastará con que sigas el rastro del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030305,
					"content": "Yo te esperaré bajo el árbol. Si encuentras algo, tráemelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		},
