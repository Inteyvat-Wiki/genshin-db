					"nextDialogs": [
						4860512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860512,
					"content": "Supongo que podemos ayudarte a buscar a tu gato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860513
					]
				},
				{
					"id": 4860513,
					"content": "#Oh, {NICKNAME}, tú siempre tan bondados{F#a}{M#o}. Pero ¿no tenemos algo más que hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Sara y Charles también necesitan nuestra ayuda con urgencia. Vamos a ver a Jean primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "¿Vas a ver a Jean? Qué casualidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Pensé que estabas buscando un gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860517,
					"content": "Sí, quería ver si Jean podía ayudarme a buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860518,
					"content": "¿En serio? ¿Quieres que Jean... te ayude a buscar a tu gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860519,
					"content": "¿Qué hay de malo en eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860520
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860520,
					"content": "Jean es una muy buena persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860521
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860521,
					"content": "¿Y esa es tu explicación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860522
					]
				},
				{
					"id": 4860522,
					"content": "Un caso clásico de “a las buenas personas siempre las engañan”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860523
					]
				},
				{
					"id": 4860523,
					"content": "Por favor, díselo a Jean por mí. Te invitaré una cerveza en Cola de Gato más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860524
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860524,
					"content": "Oye, vamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860525,
					"content": "¡Hum! ¡Increíble! Supongo que tendremos que agregar el caso de Príncipe, el gato desaparecido, a la agenda de nuestra reunión con Jean.",
