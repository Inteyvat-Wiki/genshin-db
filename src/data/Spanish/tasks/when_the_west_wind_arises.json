				{
					"id": 4861003,
					"content": "Me han informado que Jean se enfermó. En nombre de todos los Caballeros de Favonius, permítanme expresar mi más sincero agradecimiento por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "Muy cortés y educado. Este no es el Kaeya que conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Jaja... Bueno, las circunstancias lo ameritan. Estamos hablando de la Gran Maestra Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Además de ese mensaje de agradecimiento, hay algo más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "#¿Tienes un trabajo para nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "¡Es como si leyeras mi mente! Tenemos una buena conexión, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "¿Es esta la parte en la que nos das nuestra recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Jajaja. Lo admito, me gusta tu estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "Pero antes de que podamos discutir la recompensa, hay algunas cosas con las que espero que puedan ayudar a los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "¿Cosas como ayudar a reemplazar a Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Exacto. Aunque los casos de los que informaron a Jean ya le fueron encargados a otra persona,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "me preocupa que no se hagan con el debido cuidado sin el toque personal de Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "Así que espero que puedan ayudar como mejor les parezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "#Me sentiré mucho más tranquilo sabiendo que {F#la misma Caballera Honoraria}{M#el mismo Caballero Honorario} supervisará personalmente estos casos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#Puedes halagar a {NICKNAME} todo lo que quieras, pero dime, ¿por qué no lo haces tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Jaja... Oh, tengo asuntos mucho más importantes que atender. Hay tantas cosas que... preparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "¡Hum! De acuerdo. Así que necesitas que te ayudemos con las cosas de <color=#00E1FFFF>Sara, Charles y Margaret</color>, ¿correcto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Correcto. Agradezco mucho su ayuda. ¡Nos vemos luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
