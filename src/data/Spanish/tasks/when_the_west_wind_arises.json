			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "¿Pasa algo, Sara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "Lo siento, ya comí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "#¡Ah, finalmente {F#las}{M#los} atrapé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860205,
					"content": "No estoy aquí para hacer promoción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860206,
					"content": "Hay algo que me gustaría que los Caballeros de Favonius hicieran por mí, y quiero que le pases mi solicitud a la Gran Maestra Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860207,
					"content": "Oh, entonces es Jean a quien realmente buscabas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860209,
					"content": "Somos como uña y carne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "Nos conocimos una vez, pero muy brevemente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "#Soy su leal {F#sirvienta}{M#sirviente}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "#¿Eres cercan{F#a}{M#o} a la Maestra Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860210,
					"content": "¿De verdad? Debe ser una buena sensación saber que Jean cuida tus espaldas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860212,
					"content": "Bueno, escuché que ella te tiene mucho respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860214,
					"content": "#¿{F#Sirvienta}{M#Sirviente}? ¡Nunca imaginé que existían tales prácticas anticuadas y aristocráticas entre los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860215,
					"content": "#No le hagas caso a {NICKNAME}, solo tiene un extraño sentido del humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860216,
					"content": "... En fin, ¿qué querías que le contáramos a Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860217,
					"content": "Ah, sí... Debo disculparme por no poder visitar a los Caballeros en persona, pero el restaurante ha estado muy ocupado últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860218,
					"content": "Desafortunadamente, estamos justo en la temporada alta para la ruta entre aquí y Aguaclara, y parece que el camino fue ocupado por los Hilichurls. Es la ruta que se utiliza para las entregas de nuestros ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860220,
					"content": "Y, entonces, quieres que los Caballeros despejen el camino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Entonces, quieres que alguien les enseñe una lección a esos cazadores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "Pero a los cazadores de Aguaclara parece no importarles, solo se preocupan por la cacería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860221,
					"content": "¡Exacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860223,
					"content": "¿Qué? ¡No! ¡¿Eso en qué ayudaría?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860225,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "<color=#00E1FFFF>Pídele a la Maestra Jean</color> que envíe un escuadrón para ahuyentar a los Hilichurls del camino a Aguaclara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860226,
					"content": "¡Uf! Ayuda, por fin. Con el caso en manos de Jean, se resolverá en poco tiempo. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860227,
					"content": "Parece que todos realmente confían en Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860228,
					"content": "Oh, casi lo olvido. <color=#00E1FFFF>Charles el cantinero</color> dijo que él también ha tenido algunos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860229,
					"content": "¿Por qué no pasan a verlo en el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860230,
					"content": "Bien. Llegaremos hasta las últimas consecuencias, es lo que siempre dice Paimon... Aunque a decir verdad, no es que nos quede de paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "#¿Qué crees que es esto, niñit{F#a}{M#o}? ¿Una tienda de jugos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "¡Hum! ¡Qué grosero! ¡Y pensar que venimos a ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "#¿Ayuda? ¡Oh! Eres {F#la nueva}{M#el nuevo} ayudante estrella de la Gran Maestra Intendente, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Pues, si lo dices de esa manera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Excelente. Dile a Jean que necesito mi declaración de impuestos trimestral, ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Es hora de buscar a Elzer y hacer la contabilidad de nuevo... Aunque tengo que admitir que la tasa de impuesto sobre el alcohol en Mondstadt es bastante elevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
					"content": "¿Realmente necesitas involucrar a Jean en cosas como esta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "Y, aun así, el Viñedo del Amanecer sigue ganando mucho dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "Eso se debe principalmente al exitoso modelo de negocio de Sr. Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860310,
					"content": "¿Por qué hacer las cuentas con Jean? ¿Ella también hace contabilidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860311,
					"content": "La Gran Maestra Intendente Jean revisa personalmente todas las cuentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860312,
					"content": "Después de todo, la industria vitivinícola es la principal fuente de ingresos de Mondstadt. Jean se esfuerza para asegurarse de que no se pase por alto ningún detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860313,
					"content": "No tenía idea. El trabajo de Jean es aún más difícil de lo que pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860314,
					"content": "Sí, el arduo trabajo de la Gran Maestra Intendente hace que nuestras vidas sean mucho más fáciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860315
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860315,
					"content": "Ciertamente tenemos mucha suerte, pero... para decirlo sin rodeos, simplemente damos por sentado que esa es la norma ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860316
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860316,
					"content": "Guau... ¿Cómo duermes por la noche sabiendo cuánta presión tiene Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860317,
					"content": "*Suspira*, dicho así, me hace sentir muy avergonzado... Supongo que debería invitarle un trago la próxima vez que esté aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860318
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860318,
					"content": "Aunque... Dudo mucho que la Gran Maestra Intendente tenga tiempo de sobra para eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860319
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860319,
					"content": "Eso suena a una excusa para negarle a Jean una bebida gratis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860320,
					"content": "#Vamos {NICKNAME}, vamos a <color=#00E1FFFF>ver a Jean</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
