					"nextDialogs": [
						4860507
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860507,
					"content": "Me refiero a Príncipe. Estaba en casa hace un momento, pero ahora ya no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860508
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860508,
					"content": "¿En serio pensaste que Diona era una gata doméstica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860509,
					"content": "Esto es un poco preocupante, ¿qué pasa si Príncipe no puede encontrar el camino a casa?",
