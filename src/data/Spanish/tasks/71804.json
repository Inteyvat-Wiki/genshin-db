						718040402
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 718040402,
					"content": "Ivánovich necesita una nueva licencia de negocio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivánovich... Ah, sí, lo recuerdo. Ha venido un par de veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 718040404,
					"content": "Así que quiere solicitar una nueva licencia de negocio, ¿eh? Jaja, imagino que estará muy ocupado con ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 718040405,
					"content": "Viniste a hacer los trámites en su lugar, ¿cierto? Bueno, ¿y trajiste la <color=#00E1FFFF>copia del Permiso de salida a ultramar</color>? Cuando vino, ya le dije que su documentación estaba incompleta, y que se la tenían que rellenar en otro sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Nervioso An"
				}
			]
		},
