			"dialogs": [
				{
					"id": 718040501,
					"content": "¡En orden, por favor! ¡En orden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Ivánovich necesita una nueva licencia de negocio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "¿Eh? Viniste a hacer los trámites en su lugar, ¿cierto? ¿Y trajiste el Permiso de uso del local y... esa otra cosa? ¿Cómo se llamaba? Ah, sí, la Garantía de seguridad del negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "¿Estás a cargo de las licencias de negocio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "No, no, solo vine para ayudar, igual que tú. La Recepcionista Zhao está muy ocupada en este momento, así que vine para ayudar a archivar algunas solicitudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "*Suspira*, es un trabajo realmente agotador... Bueno, ¿trajiste el Permiso de uso del local y la Garantía de seguridad del negocio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
