					"nextDialogs": [
						718045107
					]
				},
				{
					"id": 718045107,
					"content": "¿Te refieres al modo en que hacemos estas cosas? Bueno, es un poco diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045108
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718045108,
					"content": "No sabría explicarte los detalles concretos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045109
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718045109,
					"content": "Entenderás lo que quiero decir si alguna vez vas a Snezhnaya.",
