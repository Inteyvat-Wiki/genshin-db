					"nextDialogs": [
						718045105
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718045105,
					"content": "Aunque, sinceramente, tengo tantos papeles y documentos que me mareo con solo pensar en ellos.",
