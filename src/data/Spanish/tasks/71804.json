				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivánovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "¿Encontraste el aviso sobre la nueva licencia de negocio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040302,
					"content": "Sí, lo copié.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "¡Genial! A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040304,
					"content": "Necesito una copia del permiso de salida a ultramar, el permiso de uso del local, la garantía de seguridad del negocio y la antigua licencia de negocio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040305,
					"content": "Ah, está bien. Me costó mucho, pero conseguí que me firmaran todos esos documentos hace unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040306,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a entregar cada uno de estos documentos a sus respectivos destinos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040307,
					"content": "Es posible que... *ejem*, haya mucha gente entregando los suyos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040308,
					"content": "En primer lugar, entrega la <color=#00E1FFFF>copia del Permiso de salida a ultramar</color> al Nervioso An, y el <color=#00E1FFFF>Permiso de uso del local y la Garantía de seguridad del negocio</color> al soldado de la Geoarmada Jiayi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040309,
					"content": "Después, la <color=#00E1FFFF>antigua licencia de negocio</color> entrégasela a la Recepcionista Zhao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040310,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a entregar esto, por favor? Te aseguro que tendrás una buena recompensa cuando regreses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040311,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Espero que esto sea lo último que hay que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040313,
					"content": "Yo también lo espero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Bueno, no creo que tú tengas que volver a hacerlo, pero en cuanto a mí... tendré que hacerlo de nuevo en algún momento si quiero seguir haciendo negocios aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 718040315,
					"content": "*Suspira*, aunque tener todos los papeles en regla me da cierta sensación de seguridad, me gustaría que pudieran simplificar el proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivánovich"
				}
			]
		},
