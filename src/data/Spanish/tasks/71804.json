			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "Este es el tablón de anuncios de la Pendiente Feiyun. Pueden colgar aquí noticias de la ciudad, publicidad de sus negocios y todo lo que quieran. Transeúntes absténganse de colgar nada salvo que sea un asunto de vital importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 718040202,
					"content": "Información sobre los traslados de personal del Ministerio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "“Los traslados de personal del Ministerio de Asuntos Civiles son los siguientes...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 718040204,
					"content": "Espera, Paimon cree que los traslados de personal no tienen nada que ver con las licencias de negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Boletín sobre la contaminación del agua de la Pendiente Feiyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "“Las últimas noticias sobre la contaminación del agua de la Pendiente Feiyun son...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 718040207,
					"content": "Ivánovich tiene cosas que hacer. No tenemos tiempo para preocuparnos por esto ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Solicitud de nueva licencia de negocio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "“Si desea solicitar una nueva licencia de negocio, deberá seguir los siguientes pasos...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 718040210,
					"content": "Esta debe ser la nueva licencia de negocio que Ivánovich quiere solicitar. Vamos, copiemos lo que dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
