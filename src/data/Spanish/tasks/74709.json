						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Ahora tengo una idea bastante clara de la condición de nuestros pacientes, así que les he preparado una medicina especial de las melusinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Si añadimos estas hierbas especiales al tanque de agua, deberían ayudar a calmarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "¿O sea que básicamente vas a convertir todo el tanque en un enorme balneario de la salud?",
