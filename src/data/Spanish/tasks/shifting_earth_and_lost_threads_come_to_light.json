			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "¡Espera, allí hay una pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "¡Los mineros debieron haberla dejado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Vayamos hasta la salida del Paso Lingju. Si no hay más huellas, quiere decir que los mineros están todavía dentro. Si encontramos nuevas huellas, podemos seguirlas a donde nos lleven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "¡Miren! ¡Huellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Parece que atravesaron el Paso Lingju y continuaron su recorrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Si seguimos sus huellas, ¡podremos averiguar a dónde fueron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Hola, ¿has visto a algún minero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "... Debe haber sido hace unos cuatro o cinco días. Unos hombres pasaron por aquí cargando cestas y picos... Supongo que eran ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "¡Sí! ¡Son ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "¿Hace cuatro o cinco días? Al parecer, no fueron tan lejos como pensábamos. Quizás las condiciones del terreno en el Paso Lingju los retrasaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "¡Fue muy extraño! Eran cuatro sujetos fornidos con rostros inexpresivos... ¡Era como si estuvieran en una especie de trance! Y había un niño avanzando a tumbos frente a ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Ese niño... ¿qué aspecto tenía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Solo lo vi de reojo... Tenía cabello azul y corto. En realidad... ¡Creo que era una niña! Además, no sonreía. De hecho, se veía muy seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "¿Y tomaron este camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Así es. Caminaron en línea recta todo el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "¡Vamos tras ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Esos monstruos eran demasiado agresivos, ¡seguramente me descubrieron mientras pasaba por aquí! Antes de darme cuenta, ya me habían rodeado... Gracias por salvarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Mi nombre es Wanyu, soy miembro del Salón Shenglu, en Liyue. Dirijo nuestra investigación sobre la cultura humana y la civilización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "¿Eh? ¿Seguro que no eres... una minera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "¿Minera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Sí, ¡estamos buscando mineros! Un grupo de cuatro tipos fortachones que llevan equipo de minería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "Creo... creo haberlos visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Sí. Salí de Nantianmen anteayer rumbo al Paso Lingju. Aproximadamente a la mitad del camino me encontré con algunas personas. Eran unos hombres y una niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "¿Puedes ser un poco más específica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Tenía prisa, así que no le presté mucha atención. Me temo que ni siquiera estoy segura de su apariencia... Lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Creo que con eso es suficiente. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "¡Espero que les sirva de algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Será mejor que me vaya, hay una conferencia a la que debo asistir. De nuevo, les agradezco su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Según esa erudita, los mineros se dirigían a Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "¿Estamos absolutamente seguros de que son los hombres que buscamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "¡Una niña con un grupo de adultos! ¡No es algo que se vea todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Pudo haber sido otro grupo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "P-pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "¡Oigan, quizás esa piedra de allí pueda decirnos más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "¡Ajá! Paimon casi olvida nuestra arma secreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Parece prometedor, me esforzaré al máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Sí, es el mismo grupo. Siguieron este camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Sr. Kun Jun, por más que sea testigo de su memoria pétrea, no deja de sorprenderme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Supongo que es un talento, aunque raras veces le encuentro un uso. Pero un cumplido del Sr. Zhongli es un gran elogio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "¡Kun Jun es como una brújula! Sin ti, hace tiempo que nos habríamos perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Jajaja, ¿eso crees? Entonces, supongo que este viaje no ha sido en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "Es como... como si estuviéramos resolviendo un crimen. Es muy divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Sea como fuere, haríamos bien en no bajar la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Cuatro adultos en un estado de trance... caminando sin cesar día y noche a través de colinas y montañas, dirigidos por una niña... No es un incidente común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "¡Oh! Tiene toda la razón, Sr. Zhongli. Deberíamos tener precaución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Eso no es todo. Nuestra erudita fue atacada por Crías de Dragarto Geo, pero su nivel de agresividad era... inusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Hemos encontrado muchas pistas en el camino. Hasta ahora, nos han apuntado en la dirección correcta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Anteayer, los mineros iban en dirección a Nantianmen. Si partieron desde aquí, debieron haber cruzado caminos peligrosos en la montaña. Si su destino es realmente Nantianmen, seguramente podremos alcanzarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "¡Genial! ¡No hay tiempo que perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Dejé una marca en las cercanías hace un momento. Si el Sr. Dai pasa por aquí, lo guiará hasta nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "¡Bien pensado! Un movimiento clásico de Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "También hay una canasta... debe ser uno de los mineros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220803,
					"content": "¡Oye! ¿Hola? ¿Puedes oírnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220804,
					"content": "A juzgar por su apariencia, debe haberse desmayado del agotamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220805,
					"content": "¿Deberíamos despertarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220806,
					"content": "Todavía... todavía puedo cavar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Minero"
				},
				{
					"id": 111220807,
					"content": "¿Eh? Parece que está susurrando algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220808,
					"content": "Parece que está luchando con algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "Al parecer, cree que aún le queda trabajo por hacer. Algo no está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220811,
					"content": "Hay un campamento cerca. Deberíamos llevarlo allí y observar su estado antes de decidir nuestro próximo movimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220809,
					"content": "Creo que quiere ponerse de pie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "¿Cómo está? N-no morirá, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Solo perdió el conocimiento por el agotamiento. Afortunadamente, no está en grave peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "¿Cómo se cansó tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Paimon lo escuchó decir que estaba cavando en busca de algo. ¿Habrá cavado su propia fosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "Es una posibilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Qué raro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "¿Eh? Parece que tiene algo en el bolsillo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "¿Son... fragmentos de mineral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Acabo de ver los recuerdos dentro de estos fragmentos de mineral. Esta persona sacó estos fragmentos de la mina. Es uno de los cuatro que estamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Lo que necesitamos averiguar es: ¿cómo llegó aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Así que lo secuestraron y luego... ¿lo abandonaron aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Pero si no era indispensable, ¿por qué lo traerían hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "A menos que sucediera algo... algo que lo llevó a quedarse atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "¡Es suficiente para Paimon! ¡Es demasiado misterioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "¡Oh! ¡Espera un momento! Ver estos fragmentos me ha refrescado la memoria. Tengo algo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "¿Qué es? ¡Oh! ¿Es un obsequio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "¿Algo para... nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Como les dije, antes de conocer al Sr. Dai, estaba en un estado de trance. Después de investigar este caso con ustedes, parece que la niebla se está disipando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Me alegré mucho cuando el Sr. Dai les pidió ayuda. Nunca hubiera logrado rastrear estas pistas por mí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Estos son unos cristales que compré en el mercado. No son cualquier cristal antiguo, ¡su pureza es extraordinariamente rara! Le daré uno a cada uno de ustedes. Tómenlo como un recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Es hermoso... ¡Oh, y los colores cambian a medida que lo giras! Es como un cristal diferente desde cada ángulo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Parecen costosos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Toma este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Y este es para el Sr. Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "¿Eh? ¿Ocurre algo? ¿No es de su agrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Al contrario... Simplemente no esperaba recibir un regalo en las circunstancias actuales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Gracias, lo atesoraré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Me alegro. Es bueno poder dar un regalo que otros puedan apreciar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Veo más rocas por allá. Deberían descansar un poco, iré a dar un paseo. Quizás haya más recuerdos por descubrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Sí que te gustan las rocas, Kun Jun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Los minerales son los cristales de la tierra, el sedimento del tiempo mismo. Estar con ellos me da tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Descansen un poco y llámenme cuando estén listos para partir. No estaré lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Estará bien a solas, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Puedes estar tranquilo. Inspeccioné el área, no hay ningún peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Ah, sí, hay algo que quería discutir contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "¿Eh? ¿Por qué de repente tan serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "#Viajer{F#a}{M#o}... ¿Qué piensas de la dragonita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "No tengo ni idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "¿Te refieres al mineral que está buscando Kun Jun? ¿Qué tiene de especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "La dragonita es un mineral increíblemente raro que se utiliza en la forja. La mayoría de los cristales normales se forman en entornos con altas temperaturas. La dragonita, por otro lado, se forma como producto de reacciones elementales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "¿Las reacciones elementales pueden producir objetos físicos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Efectivamente. Sin embargo, solo una pequeña parte puede sobrevivir durante largos periodos de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "La dragonita surgió por primera vez en medio de una gran batalla, hace miles de años. Poderosos choques de energía elemental dieron origen a cristales elementales. Milagrosamente, los restos geológicos lograron conservarse tras la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Genial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Y, sin embargo, siguen siendo formaciones de cristal sumamente escasas y relativamente desconocidas. Hace cientos de años, fueron prácticamente minados hasta agotarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Entonces, ¿por qué un ciudadano de Liyue desea encontrar un mineral que hace tiempo que desapareció de la tierra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "¡Sí! Si sabe de su existencia, seguramente sabe que ya se agotó, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Qué extraño... Paimon no lo entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "En el comercio de minerales, hay quienes tienen un gran interés en la dragonita, pero en el caso del señor Kun Jun, quien ni siquiera sabe con qué fin lo está buscando, es... totalmente inaudito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Quizás tenga motivos ocultos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "¿Motivos ocultos? ¡Ay! ¿Es una mala persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Es una conclusión a la que actualmente es imposible llegar. Debemos observarlo... y esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "No olviden que rescatar a esos mineros es el objetivo principal. En cuanto a lo demás... tarde o temprano la verdad saldrá a la luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Nos acercamos a nuestro objetivo. Creo que deberíamos seguir por este camino. Ya encontramos a uno de los mineros, los demás no deberían estar muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Cuando hayan descansado lo suficiente, llamen al Sr. Kun Jun. Hay más asuntos por investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Debemos asegurarnos de que este minero esté bien establecido aquí en el campamento. Una vez que hayamos cerrado este asunto, podremos regresar y atenderlo. Sugiero que dejemos una nota para el Sr. Dai. Si encuentra el campamento, sabrá qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "¿De verdad puedo quedármelo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "¿No se supone que lo trajeron aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
