			"dialogs": [
				{
					"id": 740760501,
					"content": "¿Es ese el fragmento de las personalidades?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740760502,
					"content": "No logro analizar la densidad del material que tenemos ante nosotros. Según mis resultados... la densidad es cero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "¡Logramos recoger el último fragmento! Al menos ahora podemos negociar un poco con nuestros oponentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Si pensamos en las ventajas de todo esto, al menos podemos impedir que la Comunidad Cruz de los Narcisos forje la Sacroespada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "No es eso, Paimon. Nuestra meta es forjar la Sacroespada y utilizarla para desbaratar su plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Además, Anne, no he olvidado lo que significa esa espada para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "Una Sacroespada capaz de destruir la voluntad es tu llave para resolver el acertijo. En realidad, para mí también es muy importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "Es solo que tenemos otros asuntos todavía más importantes entre manos. ¿Estarías conforme con buscar la respuesta del acertijo más tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Sí, no tengo ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740760510,
					"content": "#En ese caso, {NICKNAME}, ve a recoger “las personalidades”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		}
