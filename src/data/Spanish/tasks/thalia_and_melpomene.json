			"dialogs": [
				{
					"id": 740760101,
					"content": "Este es último lugar que nos queda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760102,
					"content": "Menos mal que esta entrada aún está sellada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740760103,
					"content": "Parece que Jakob no ha encontrado una respuesta para este acertijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740760104,
					"content": "Quizá haya encontrado una respuesta, pero no la correcta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "Deja que Paimon piense... Las respuestas anteriores fueron “sombras”, “vida”, y “amor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Según el patrón ocurrido hasta ahora, lo más lógico sería que esta fuera la inscripción de la estela de piedra:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "“Siempre unidos”... “Nacido en un instante, a menudo enfrentados, te acompañaré en tu eterno descanso”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Además de eso, en la última línea habla de una “gota primigenia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, ¿alguno de ustedes sabe la respuesta de este acertijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
