			"dialogs": [
				{
					"id": 700650101,
					"content": "No hay forma de convencer a los necios que buscan la muerte. Ya dije que no subieran a la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Bueno, bueno, no se ponga así, Sr. Mann. No diga esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Sí, antes tuve una conversación agradable con este señor en El Néctar del Anochecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Pero, en cuanto le dije que quería ir al Monte Vientosuspiro, empezó a tirar de mí hasta arrastrarme hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "¿Eh? Pero si es Huffman. ¿Pasa algo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Como pueden ver, el Sr. Mann está intentando impedir que la gente vaya al Monte Vientosuspiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Permítanme presentarles a la aventurera Lipphart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "¡Lo que me aconteció es realmente aterrador! ¿Seguro que quieren oírlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Bueno, parece que hoy no iré a ningún lado. Escuchemos tu historia, pues. Será como seguir oyendo tus fanfarronerías mientras bebías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Ya juzgaré yo si de verdad es tan peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "¡El sanatorio está embrujado de verdad! ¡Yo mismo lo vi con mis propios ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "¿Embrujado? ¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Lo que ocurrió anoche fue lo siguiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
