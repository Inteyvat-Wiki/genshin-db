			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#Gracias, muchas gracias, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280102,
					"content": "Puede que sea cazador de oficio, pero estos Slimes han mostrado ser rivales formidables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280103,
					"content": "Por culpa de ellos no tengo nada que traer de vuelta de la cacería. No he atrapado nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280104,
					"content": "Espero que otros cazadores tengan mejor suerte que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280105,
					"content": "Hablando de Slimes, ¿podrías mirar alrededor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280106,
					"content": "Tal vez sea mi imaginación, pero parece que aparecen más y más cerca del pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280107,
					"content": "¿Podrías buscar Slimes en el camino? Si ves alguno... ya sabes qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280108,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Estás prestando un gran servicio. Bueno, será mejor que regrese e informe de todo esto a Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280111,
					"content": "¡Solo espero que no esté tan ebrio como para que le entre por un oído y salga por el otro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Cobarde Morrow"
				},
				{
					"id": 200280109,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "#Por favor, {F#señorita}{M#caballero}, si no es por mí, al menos hazlo por el bien de todos en Aguaclara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Cobarde Morrow"
				}
			]
		}
