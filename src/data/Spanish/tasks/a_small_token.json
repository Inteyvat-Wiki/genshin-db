			"dialogs": [
				{
					"id": 752380101,
					"content": "¿Te gusta el té? ¿O prefieres algo con un poco más de intensidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380102,
					"content": "El té está bien. Me siento culpable cuando bebo durante el día, así que prefiero no hacerlo muy a menudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380103,
					"content": "En fin, Srta. Guillotin, ¿qué te trae por Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380104,
					"content": "Solo estoy de viaje, visitando a viejos conocidos. Además, quería darte las gracias por haber aceptado echar una mano durante el Festival Fontinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380105,
					"content": "Estás siendo demasiado educada. ¿De verdad viniste hasta aquí solo por eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380106,
					"content": "Bueno... Aunque tuviste la amabilidad de no mencionarlo la última vez, soy muy consciente de que te he causado problemas en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380107,
					"content": "Ah... ¿Ese asunto con tu subordinado? El incidente relacionado con la robot Ineffa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380108,
					"content": "Je... ¿No es extraña la vida? Puede que, de repente, te encuentres entablando amistad con la jefa de tu antigua enemiga... O incluso puede que se convierta en tu propia jefa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380109,
					"content": "Espero que puedas aceptar esto como una pequeña muestra de disculpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380110,
					"content": "E-esto... ¿Es una edición limitada? No, ¡¿una edición de coleccionista!? ¡¿Y es mi género favorito?! ¿C-cómo lo supiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380111,
					"content": "#Le pedí consejo a {NICKNAME}. {F#Ella}{M#Él} conoce bastante bien tus gustos en cuanto a lectura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380112,
					"content": "#¡¿{NICKNAME}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380113,
					"content": "(¿Qué me pasa con estos sentimientos contradictorios? Es como si me alegrara, pero al mismo tiempo me diera vergüenza.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380114,
					"content": "#(Claro que me halaga que {F#ella}{M#él} sepa lo que me gusta, pero ¿de verdad tiene que ir por ahí contándoselo a todo el mundo? ¡Preferiría que me lo regalara {F#ella}{M#él} en persona!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380115,
					"content": "¿Te gusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380116,
					"content": "Ah... ¡G-gracias! Eres muy amable, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380117,
					"content": "#Si te gusta, la próxima vez te puedo traer algunos más. Aunque tendré que molestar a {NICKNAME} para que vaya conmigo a elegirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380118,
					"content": "#¿Contigo? ¿Quieres decir que... fueron junt{F#as}{M#os} a comprarlo a una librería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380119,
					"content": "#Sí, {F#ella}{M#él} eligió este libro para ti con mucho esmero. Quizá la próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380120,
					"content": "¡¡¡Más vale que no haya una próxima vez!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380121,
					"content": "Ah... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
