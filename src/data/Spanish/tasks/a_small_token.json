			"dialogs": [
				{
					"id": 752380201,
					"content": "Hum. ¡Ya verá cuando le ponga las manos encima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380204,
					"content": "¿Ya es tan tarde? Bueno, Srta. Guillotin, ten cuidado en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 752380203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}