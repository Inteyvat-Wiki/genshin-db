			"dialogs": [
				{
					"id": 3572301,
					"content": "Stormterror... ¡ha entrado en la ciudad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, llegan justo a tiempo. Tenemos que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Un momento, Amber. Me temo que no nos has presentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Oh, cierto. Este es Kaeya, es el Capitán de Caballería de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Y est{F#as}{M#os} son dos viajer{F#as}{M#os} que vienen de muy lejos, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(¿“Vienen de lejos”? ¿Es todo lo que sabes?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Para no hacer la historia tan larga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "#Ya veo. Bienvenid{F#as}{M#os} a Mondstadt. Lamento que vengan en un mal momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Entiendo el dolor de separarse de la familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Pero no entiendo por qué buscan al dios Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Supongo que todos tenemos nuestros secretos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "¡Jaja! No insistiré más en el tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "En primer lugar, en nombre de los Caballeros de Favonius, les estamos agradecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Bueno, no podíamos quedarnos de brazos cruzados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "Muchos habitantes de Mondstadt han sido testigos de tu combate contra el dragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "#La Gran Maestra Intendente de los Caballeros de Favonius también está muy interesada en conocerl{F#as}{M#os}, y les invita formalmente a <color=#00E1FFFF>nuestra sede</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "No fue nada. ¿Dónde está la recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Um... ¿qué tal la especialidad de Mondstadt, asado a la miel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "¡He oído hablar de ese plato!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
