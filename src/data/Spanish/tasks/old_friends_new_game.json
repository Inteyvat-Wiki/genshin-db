			"trigger": {
				"objectNames": [
					"Balfour",
					"Haniyyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "¿Qué te ha parecido, Meteoro Dorado? ¿Qué tal tu primer contacto con La Fungocopa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Por tu expresión, imagino que aún no has sacado una conclusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Bueno, solo he jugado una ronda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Cierto, con lo poco que has jugado, es difícil evaluar los puntos fuertes y débiles del juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Pero no te preocupes, durante este tiempo, Haniyyah y yo estaremos aquí para preparar cada día un nuevo desafío de La Fungocopa, hasta un total de siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "¡Ven a probarlos cuando tengas tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Aunque seas tú quien toma las decisiones finales en la organización, este juego lo desarrollamos entre Haniyyah y yo sin pedirte permiso y, al no estar entre tus planes, también te está robando tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "¡Por tanto, es justo y razonable que recibas algunos Moras a modo de compensación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Jaja, bueno, ¡no te diré que no!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "#¡Jaja, qué direct{F#a}{M#o}! ¡Así me gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "He solicitado los permisos de residencia pertinentes para los dos Hongos, así que podrán quedarse en Puerto Ormos mientras probamos el juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Así, Estrella Plateada también tendrá más tiempo para jugar con Cabezabombo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "¡Seguro que se alegra un montón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Jaja, anda, ve rápido a visitar a Cabezabombo. Él también te ha extrañado mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Llévate esto. Puedes dárselo de comer cuando juegues con él y con Chispitas. Les encanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "¡Yo también me muero de ganas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "¡Te lo compensaré en la paga del próximo torneo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Tendría que jugar más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
