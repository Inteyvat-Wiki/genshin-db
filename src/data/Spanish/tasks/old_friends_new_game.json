					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070510,
					"content": "¡Así que Haniyyah y los compihongos se quedarán aquí una temporada! ¡Es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070511,
					"content": "Si no, Paimon habría pedido que nos quedáramos un día entero en Puerto Ormos para pasar más tiempo y jugar con nuestros amiguitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "Pero parece que podremos matar dos pájaros de un tiro. Por un lado, podremos ayudar a Haniyyah y Balfour a probar La Fungocopa, y por otro, ¡podremos jugar cuanto queramos con los Hongos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "Juegas con Paimon, Cabezabombo y Chispitas, y les dan de comer agar mirífico.\\nTanto Paimon como los Hongos se ven muy contentos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "¡Jeje, esto es genial! ¡Es como si todas las preocupaciones se hubiesen ido volando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070515,
					"content": "¡Cabezabombo, Chispitas, hasta mañana!",
