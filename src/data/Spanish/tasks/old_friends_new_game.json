			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#¡{NICKNAME} Meteoro Dorado y Paimon Estrella Plateada, cuánto tiempo sin verl{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "¡Veo que siguen con tanta energía como siempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "¿Qué tal les ha ido últimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "¡Ha-Haniyyah! ¿Y tú también, Balfour?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "¡Qué casualidad encontrarlos juntos en Puerto Ormos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "En cualquier caso, ¿qué hacen ustedes dos aquí? Paimon recuerda que aquí estaba antes el puesto de venta de agar floral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "#Estimad{F#as}{M#os} {F#heroínas}{M#héroes}, mi corazón se llena de ánimo con solo escuchar su voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Y ahora, es el momento de que les cuente los resultados de nuestro trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "#Como campeon{F#as}{M#es} del Torneo Loto Nilotpala de Doma de Bestias, decidieron darle un respiro al torneo para que la Academia pudiese mejorar el diseño del Orbe de la sabiduría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Si no me equivoco, siguen esperando noticias al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "¡Así es! ¡De haber habido algún avance, Laila, Cyno o el erudito que sea responsable debería habernos dicho algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Paimon no es precisamente una erudita, no lo entendería de todos modos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Esa es la dura verdad. Si fuésemos a preguntar, no solo no ayudaríamos en nada, sino que hasta podríamos estorbarles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "¡Sí que saben tomarse las cosas con calma! A mí, en cambio, me puede la emoción cada vez que recuerdo lo magnífico que fue el torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Así que, no hace mucho, decidí ir a la Academia a preguntarle al responsable, y me dio una respuesta bien detallada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Dijo que la mejora del Orbe de la sabiduría aún se encontraba en fase de planificación teórica y que aún quedaba bastante para que el Orbe mejorado entrara en producción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Pero las discusiones sobre la primera edición del torneo han ido disminuyendo gradualmente, y parece que todos se han olvidado ya de él. No podemos permitir que el gran impacto que causó el torneo se desperdicie así como así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Por tanto, busqué a Haniyyah para preparar juntos un evento temático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "¿Un evento temático?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "¿Te refieres a... estas piezas con forma de Hongo que hay sobre la mesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Exacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Balfour siempre está ideando nuevas propuestas y recaudando fondos para la próxima edición del torneo. Hasta fue a Liyue a estudiar nuevas formas de hacer negocios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Mientras estudiaba el mercado, se topó con un juego llamado “Arena mecánica”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Balfour ha adquirido los derechos de agencia de la Arena mecánica para Sumeru y me ha pedido que le ayude a diseñar un juego completamente nuevo en calidad de asesora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Lo hemos llamado “La Fungocopa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "¿“La Fungocopa”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Deja que Paimon adivine... ¿Esta vez tenemos que dirigir a nuestros Hongos para que se enfrenten contra todo tipo de mecanismos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "¡Como era de esperar de Estrella Plateada, acertaste a la primera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Creo que este juego es fácil de comprender y, por tanto, de promover. Me parece que tiene un enorme potencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Si conseguimos popularizarlo como un juego derivado del Torneo de Doma de Bestias, la gente no se olvidará del torneo en mucho tiempo y aumentará su expectación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Así, cuando se celebre la próxima edición, habrá más participantes y más público para animarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Por supuesto, no haremos nada de esto sin contar con su aprobación. Después de todo, ustedes dos son quienes tienen la última palabra en lo relativo a la organización del torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "¡Creo que vale la pena intentarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#¡Eso es! Ningun{F#a}{M#o} de l{F#as}{M#os} dos entiende de mercadología y esas cosas. ¡Pero todo lo que has dicho tiene mucho sentido, Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Este es el resultado del esfuerzo de los dos. Paimon confía plenamente en su capacidad, ¡así que procedan sin dudarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Aunque Paimon aún no lo haya jugado, ¡seguro que a mucha gente le gustará este juego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Estupendo, ahora que tengo su aprobación, puedo dar rienda suelta a la campaña de promoción de La Fungocopa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "La Fungocopa se encuentra actualmente en fase de prueba, y es necesario invitar a jugadores a que prueben el juego y ofrezcan comentarios y sugerencias para mejorarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Tú tienes experiencia en más de una decena de juegos populares en Teyvat, Meteoro Dorado. ¡Si lo pruebas, seguro que podrías darnos muy buenas sugerencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#¿A qué esperas, {NICKNAME}? ¡Esta es una de las cosas que mejor se te dan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Siento como si me estuvieras mangoneando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Pero Paimon aún quiere preguntarte algo, Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "¿Es sobre Cabezabombo y los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "¡Exacto! Paimon echa mucho de menos a los compihongos. ¿Cómo les va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "No te preocupes. ¡Todos están sanos y llevan una vida tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Bamboleto y Silbido Atronador están en una <color=#00E1FFFF>residencia temporal que hay al norte de Puerto Ormos</color>. De momento, están a cargo de uno de los participantes de la anterior edición del torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Cabezabombo y Chispitas están aquí cerca. Puedes ir a jugar con ellos si quieres, Estrella Plateada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#¡Así que están cerca! Entonces, mientras tú pruebas el juego, {NICKNAME}, ¡Paimon quiere ir a ver a Cabezabombo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "¡Anda, ve!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "No hay tiempo que perder, Meteoro Dorado. ¡La versión beta de La Fungocopa te está esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "¡Yo iré más tarde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "¡De acuerdo! ¡Meteoro Dorado entra en acción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "¡Cómo no, con las molestias que te has tomado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Yo de tecnología no entiendo, no podría darles ninguna sugerencia útil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "¿Quiénes son ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#¿Estás de broma, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Nos lo pasamos genial participando en el Torneo Loto Nilotptala de Doma de Bestias junto a nuestros compihongos, ¿no te acuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Haniyyah es una buena amiga que hicimos en esa ocasión, y Balfour era el empleado más responsable de todo el evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "¿Ni siquiera te acuerdas de Cabezabombo, Bamboleto y los demás compihongos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "¡Oh, oh! ¡Ahora me acuerdo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "No le des esos sustos a Paimon. ¡Estaba a punto de llevarte a un médico para que te mirara la cabeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
					"content": "¡Jeje, era broma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				}
			]
		},
		{
