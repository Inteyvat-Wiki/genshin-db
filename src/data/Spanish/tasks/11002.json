					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020702,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "¡Sí, le falta un pequeño “bum”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020705,
					"content": "Sí, ahora que lo mencionas, le falta un poco de “bum”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020706,
					"content": "¿“Bum”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020709,
					"content": "Brook puede ser una fanática de lo convencional, pero, aun así, es una chef talentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020710,
					"content": "Seguramente utilizará sus mejores ingredientes. Si quiero ganar, necesitaré un plato refrescante para el paladar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020711,
					"content": "Algo como ensalada de serpiente de mar, flor chingxin salteada o champiñones silvestres en un rico jugo de Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020712,
					"content": "¡¿Jugo de Slime?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020713,
					"content": "Jaja, sé que suena raro, pero te garantizo que sabe increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020714,
					"content": "¡Te haré un poco en otra ocasión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020715,
					"content": "No puedo esperar a probarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "Jiji, no te decepcionará cuando lo pruebes, aunque su aspecto es un poco asqueroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020719,
					"content": "No importa, acabo de recordar que hay un lugar que no visité la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020720,
					"content": "Mi instinto me dice que ahí es donde encontraremos el premio gordo. ¡Vamos a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020717,
					"content": "Eh... Entonces, no hace falta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "¿Eh? Pensé que lo esperabas con ansias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
