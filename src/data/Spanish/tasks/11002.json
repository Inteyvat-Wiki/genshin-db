					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020202,
					"content": "¿Ya sabes lo que estás buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "¡Claro que no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Entonces, ¿cómo estás tan segura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "Así es mi estilo. Si decidiera de antemano exactamente cómo cocinar algo, el plato no sorprendería a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Además, si supiera lo que estoy buscando antes de encontrarlo, no sería una sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Suena muy arriesgado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Relájate. Así es como se me ocurrieron todos los platos estrella en el Restaurante Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Busquemos por aquí. Te avisaré cuando encuentre algo que me guste.",
					"roleType": "TALK_ROLE_NPC",
