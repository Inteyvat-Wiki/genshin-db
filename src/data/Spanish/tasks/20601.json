			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "¡Auch! Eso duele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Muchas gracias. Pensé que no volvería a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "¿Como te sientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "¡Ja! Es solo un rasguñ... ¡Auch! Rasguño. Estoy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Descubrí un grupo de Hilichurls que se reunían en el campamento ahí adelante, y sospeché que podrían estar tramando algo, así que los seguí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "Pero me acerqué demasiado y me descubrieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Pero olvida eso, no te preocupes por mí, por favor, ¡ayúdame a deshacerme de esos Hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Son cada vez más numerosos, no podemos dejar que cumplan con su cometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Yo puedo arreglármelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
