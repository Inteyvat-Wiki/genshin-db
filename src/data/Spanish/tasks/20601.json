			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "¿Ya despejaste el campamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "¡Qué fuerte eres! Ojalá yo pudiera ser tan extraordinario como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Me encantaría ser un legendario asesino de dragones y salvador del mundo, pero al final, ni siquiera pude vencer a un puñado de Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Eh... Yo... Me da un poco de vergüenza, pero hay algo que quería pedirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "En realidad, vine al Templo de los Mil Vientos a explorar la zona porque pronto haré una prueba de ascensión de Rango de Aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Si puedo demostrar lo fuerte que soy para entonces, creo que la prueba me irá muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Nunca imaginé que, además de no ser capaz de demostrarlo, por poco perdería la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "Así que, por favor, ¿podrías no contarle nada de esto a Cyrus? Estaré acabado si esto afecta mi prueba de ascensión de Rango de Aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "¡Mil gracias! La próxima vez no seré tan imprudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Eso no está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Lo sé. Cyrus siempre dice que los aventureros debemos ser sinceros con nosotros mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Pero bueno... *Suspira*, espero que Cyrus no esté muy enojado conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
