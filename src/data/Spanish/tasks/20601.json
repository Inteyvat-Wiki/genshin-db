					"nextDialogs": [
						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "*Suspira*, es bueno que sea tan valiente, pero prefiero que sea más precavido. Después de todo, no podrá ser un aventurero si no está vivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
