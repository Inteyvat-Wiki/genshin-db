			"dialogs": [
				{
					"id": 206010701,
					"content": "¡Ya estás aquí! Oh, y Jack también. Pero está cojeando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010702,
					"content": "¿Se puede saber que pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010703,
					"content": "Jack se descuidó y resultó herido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Lo que pensaba. *Suspira*, nunca me hace caso cuando le hablo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "Sé que quiere demostrar lo que vale, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Bueno, no importa. Entiendo lo que ocurrió. Hablaré con Jack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010707,
					"content": "Esto es para ti. Considéralo una recompensa por tu aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
