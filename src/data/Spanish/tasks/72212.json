			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "*Suspira*, ¿cuándo encontraré un trabajo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120302,
					"content": "¿Me buscaban? ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120303,
					"content": "¿Sabes esculpir piedra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "¿Eh? Bueno... Pues, ¡genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120306,
					"content": "Esperen, olvidé presentarme, lo siento. Soy Ooshima Junpei, antes trabajaba en Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120307,
					"content": "Pero después del accidente, nos evacuaron a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120308,
					"content": "Hasta ahora, nadie me ha dicho si podremos volver al trabajo o no, así que he estado ocioso aquí todo este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120309,
					"content": "Entonces, están buscando a alguien que pueda esculpir piedra, ¿cierto? Bueno, esa no es mi especialidad, pero sé una cosa o dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120310,
					"content": "¿Qué tipo de escultura necesitan que haga? ¿Pueden decírmelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120311,
					"content": "Verás...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Oh... A ver si lo entendí, ¿una gata parlante les pidió que encontraran a un artesano para que le hiciera una estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120313,
					"content": "No es que no les crea, pero suena un poco... descabellado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120314,
					"content": "Y, aunque aceptara ayudarles, ¿cómo se supone que... me va a pagar esa Suma Sacerdotisa suplente? No pienso trabajar gratis, por más que me lo pidan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120315,
					"content": "No te preocupes, todo irá bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(¿De verdad?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "¿En serio? Humm... siento como si me estuvieran estafando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120318,
					"content": "Pero ¿saben qué? Da igual. De todos modos, no tengo nada que hacer, así que no me hará daño ir con ustedes a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120319,
					"content": "Espero que me puedan pagar por esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				},
				{
					"id": 722120304,
					"content": "Estamos buscando un artesano que trabaje con piedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
