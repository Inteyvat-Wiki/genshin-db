			},
			"dialogs": [
				{
					"id": 722120601,
					"content": "Aun así, Neko tiene curiosidad... ¿Cómo puede algo tan duro como una roca adoptar su forma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "¿Tan poderoso es ese humano de las piedras? ¿Sabe usar magia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120603,
					"content": "Oh, sí, es muy poderoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Ah, ¡ahora lo entiende Neko! ¡Muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120605,
					"content": "Es como con la comida que hicimos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, ahora lo entiende Neko. La comida que hicieron Hibiki y tú era buena. Entonces, la piedra que haga el humano de las piedras también será buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120607,
					"content": "Veo que los humanos pueden ser hábiles a veces. Neko les da las gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
