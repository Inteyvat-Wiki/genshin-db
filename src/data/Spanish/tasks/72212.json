			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Llegan justo a tiempo. Neko necesita su ayuda una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "Neko quiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "... que coloquen una piedra grande con la forma de Neko al lado del santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "Eh... ¿Dónde se supone que vamos a encontrar algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Se refiere a una estatua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Sea lo que sea, Neko quiere algo parecido a esas piedras de zorro que hay en esa isla lejana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Hibiki solía decir que había muchas piedras de zorro en esa isla, y una vez preguntó a Neko si le gustaría tener una con su imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "Neko cree que, si Hibiki la quería, debe ser algo bueno. Por eso Neko les pide que consigan una piedra así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "No sé esculpir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Humm, ¿qué vamos a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "¿Por qué no le preguntamos a Taisuke? Como le gustan mucho los gatos, a lo mejor está dispuesto a hacer una escultura para ayudar a Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Podemos ir a buscar a Taisuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "¡Tienes razón! Como le gustan tanto los gatos, a lo mejor puede ayudarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
