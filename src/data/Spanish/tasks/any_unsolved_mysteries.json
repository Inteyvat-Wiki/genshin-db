			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "Pues a Paimon le parece un lugar como cualquier otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170102,
					"content": "Supongo que no encontraremos nada para comer aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170103,
					"content": "Se te ven las intenciones, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "*Ejem*, bueno, es que investigar misterios y todo eso da mucha hambre. ¡Todo el mundo lo sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170106,
					"content": "Además, últimamente no dejamos de comer cosas a la parrilla. ¿No te apetece algo distinto para variar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170107,
					"content": "Si encontramos algunas caracolas o almejas, podrías asarlas con algo de fruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170108,
					"content": "Seguro que están deliciosas, tan fresquitas y carnosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170109,
					"content": "Eso suena horriblemente mal. Yo paso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "¡Vamos, deberías probarlo! ¡A lo mejor Paimon te ayuda a descubrir todo un nuevo mundo de sabores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170113,
					"content": "#Oye, {NICKNAME}, mira eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170114,
					"content": "¡Qué raro! Ese dispositivo salió de la nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170115,
					"content": "Y hay un montón de maletas también. ¿Serán de los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170116,
					"content": "Nada mal, Paimon, diste en el clavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "Jeje, la intuición de Paimon es infalible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170118,
					"content": "¡Pero espera! ¡Este descubrimiento no tiene nada de bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170119,
					"content": "Si son cosas de los Fatui, ¡seguro que están tramando algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170120,
					"content": "No podemos fingir que no lo hemos visto. Las cosas podrían irse de las manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170121,
					"content": "En fin... Vayamos a ver ese dispositivo primero. Si crees que es necesario, ya revisaremos todas estas cosas después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}, vamos. Acabemos con esto, ¡y sigamos buscando cosas ricas para comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170111,
					"content": "Suena al sabor que tendrías tú, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "¡Oye! ¡Ni que Paimon fuera un marisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170104,
					"content": "Bueno, ahora ya entiendo tu repentino entusiasmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}