					"nextDialogs": [
						750870303
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870303,
					"content": "¿Acaso... acaso Oberón está aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870304,
					"content": "¡Aguuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870305,
					"content": "Oh, cuánto has crecido desde que nos vimos la última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870306,
					"content": "Taruka dijo que era propenso a engordar y al parecer no mentía. Por cierto, ¿dónde está? ¿No está contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Guuu... Guuuuuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870308,
					"content": "Bueno, ¡primero vamos a sacarte de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Hablando del tema, ahora que ya hemos encontrado a Oberón, no deberíamos seguir escondiéndonos, ¿no? Aunque es preocupante que aún no conozcamos el paradero de Taruka... ¡Tenemos que darnos prisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
