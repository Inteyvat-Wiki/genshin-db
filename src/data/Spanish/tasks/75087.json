				]
			},
			"dialogs": [
				{
					"id": 750870901,
					"content": "¿Otra vez las sauriogalletas? Y la carta que hay al lado es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "¡Así que era Killa la que manejaba los hilos! Aunque Paimon no se esperaba que esa fuera la razón... Qué mala suerte tiene Parán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870903,
					"content": "Con solo pensar que Taruka y Oberón podrían estar encerrados en el campamento de delante, Paimon se sentiría mal si no hacemos nada... Además, ellos no hicieron nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870904,
					"content": "#Eh... {NICKNAME}, pensemos en un plan para salvarlos, ¿sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870905,
					"content": "Si logramos <color=#00E1FFFF>mezclarnos entre la patrulla de Iktomisaurios</color> sin que nos descubran, ¡quizás podamos infiltrarnos fácilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7508759,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_B_OR_ETCAND",
