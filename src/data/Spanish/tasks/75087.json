			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875901,
					"content": "#Aún nos quedan más desafíos de vuelo. Pueden ver los detalles en el tablón. Si están interesad{F#a}{M#o}s, pueden intentarlo... Habrá premio, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875902,
						750875905,
						750875909
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875902,
					"content": "¿Qué sabes sobre la Academia de Vuelo Pakpaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875903
					]
				},
				{
					"id": 750875903,
					"content": "Verdaderamente desconozco por qué se llama así. Pero, hablando de Pakpaka... ¿Han oído alguna vez la historia de Kuntur y el brujo malvado Rumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875904
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875904,
					"content": "Ese brujo malvado derrotó a los guerreros de la tribu, quien los convirtió en Pakpaka... Eso no suena nada bien, ¿verdad? Tal vez los Pakpakas vuelen muy rápido, eso ya no lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875905,
					"content": "Me gustaría saber más de Lamizán...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875906
					]
				},
				{
					"id": 750875906,
					"content": "Jaja... Es un buen guerrero, pero no un gran maestro. Y como oponente en las competiciones de vuelo... supongo que sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875907
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875907,
					"content": "Aunque, ¿por qué vendría alguien aquí si no volara mal? Así que, si fuera demasiado exigente... *Suspira*, bueno, no es que algo así no haya sucedido en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875908
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875908,
					"content": "Por eso ahora me centro en animar a la gente. Estoy seguro de que ese enfoque también tendrá buenos resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875909,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875910
					]
				},
				{
					"id": 750875910,
					"content": "Adiós, vuelvan cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
