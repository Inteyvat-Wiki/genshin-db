			"dialogs": [
				{
					"id": 750870501,
					"content": "Ya que han encontrado este lugar, puedo dejar esta farsa de comerciante de buen corazón. Estaba harta de tratar con idiotas, es hora de quitarse la máscara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870502,
					"content": "#¡Maldita seas! ¡Cómo te atreves a culparnos de las maldades que hiciste tú misma! ¡Nos tomaron por mal{F#a}{M#o}s por tu culpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "#Sí, soy mala y me dedico a hacer cosas malas. Además, si esos tres idiotas creyeron que ustedes eran l{F#a}{M#o}s mal{F#a}{M#o}s, eso quiere decir que he hecho mi trabajo muy bien, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870504,
					"content": "Jeje, ahora es el momento de hacer algo aún peor. ¡Los quiero ahí quietecitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870505,
					"content": "¡Adelante, Bola de Plumas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870506,
					"content": "¡Grrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Bola de Plumas"
				},
				{
					"id": 750870507,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#¡Adelante, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#¡{REALNAME[ID(2)|SHOWHOST(true)]} va a enfrentarse a un oponente mucho más grande que él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Guuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870511,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberón parece desanimado. Paimon no sabe si es porque se ha separado de Taruka o simplemente porque comió demasiadas sauriogalletas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#¿Será que {REALNAME[ID(2)|SHOWHOST(true)]} quería animarlo y por eso salió a defendernos con tanta valentía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Hay muchas cosas en este mundo que la simple valentía no puede cambiar. Prefiero confiar en la fuerza absoluta que en algo tan ilusorio como eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870515,
					"content": "¡Al ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870516,
					"content": "#¡{REALNAME[ID(2)|SHOWHOST(true)]} ha esquivado el ataque! Esa es la especialidad de los Tepetlisaurios, ¡ni siquiera el mismísimo rey del cielo podría acertarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Atacar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#¡{REALNAME[ID(2)|SHOWHOST(true)]} está preparado para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "¡El ataque ha acertado! Ha infligido... ¿un pelín de daño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Está bien, ¡que no haya fallado ya es todo un logro! Uff, solo ha pasado un turno, pero Paimon ya está bastante cansada... ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "Entonces, ahora nos toca a nosotros, ¿no? ¡Al ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870535,
					"content": "#¡Ante el duro ataque de su adversario, {REALNAME[ID(2)|SHOWHOST(true)]} adopta una posición defensiva rápidamente! Y... ¡consigue defenderse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Ha adoptado una posición defensiva después de atacar... ¡Malditos tramposos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870537,
					"content": "Para ganar en un combate por turnos, ¡lo mejor es saltárselos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "¿Qué deberíamos hacer ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "¡Guuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870540,
					"content": "¿Eh? ¿Parece que Oberón se ha animado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Aunque Paimon no entiende lo que dice, tiene toda la pinta de que han llegado a cierto acuerdo mutuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Atacar de manera coordinada",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "¡Oh! ¡Enséñanos el verdadero poder de la estrella del mañana de la Academia de Vuelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#¡Oh! Oberón ha bloqueado la ruta de huida aérea de su adversario, y {REALNAME[ID(2)|SHOWHOST(true)]} está iniciando su ofensiva. ¡Esto sí que es un ataque coordinado bien hermoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "¡Ha sido muy efectivo contra Bola de Plumas! ¿Le ha acertado en las garras? ¡Ese dolor es como golpearse sin querer con la pata de la mesa! ¡El oponente se ha desestabilizado y no se puede mover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "Atacaré yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Eso es una opción... pero esta es la oportunidad perfecta para que {REALNAME[ID(2)|SHOWHOST(true)]} demuestre de lo que está hecho... ¡déjaselo a él! ¡No te comportes como {F#una}{M#un} niñ{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "¡Guuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870566,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#¿Eh? A Paimon le parece que {REALNAME[ID(2)|SHOWHOST(true)]} y Oberón están planeando algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "¡Sauriogalletas! ¡¿De dónde han salido las sauriogalletas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "¡Guuu, aguuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870570,
					"content": "¿A-acaso las tenía guardadas bajo las alas? Qué saurio más astuto... Seguro que le das muchos problemas a Taruka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Guuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870572,
					"content": "¡Aún no es el momento! ¡Oye! ¡Quieto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Killa"
				},
				{
					"id": 750870573,
					"content": "¿Hmm? ¡Bola de Plumas ha ignorado la indicación y ha ido directo hacia las sauriogalletas! ¡La tentación de recuperar 5 puntos de Aguante es demasiado poderosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "¡No ha caído en que lo único que hay servido en bandeja aquí es él mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#En resumen, la batalla continúa de la misma manera durante un buen rato.\\n{REALNAME[ID(2)|SHOWHOST(true)]} se comporta de forma heroica, como si quisiera demostrar que, aunque no pueda obtener un título de excelencia en la Academia de Vuelo, sus demás habilidades son más que suficientes para ayudar a su compañero.\\nSorprendentemente, el inesperado aumento de peso de Oberón surte efecto y, gracias a su tamaño ligeramente superior al de una cría de Qucusaurio normal, puede bloquear con éxito el campo de batalla desde el aire y asestar duros golpes a Bola de Plumas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Killa no parece capaz de luchar, por lo que, después de que Bola de Plumas pierde la voluntad de combate, se ve obligada a retirarse también.\\n“Malditos tramposos, la próxima vez... ¡la próxima vez no los dejaré ganar tan fácilmente! ¡Esperen y verán!”.\\nTras decir la típica frase de villano antes de retirarse, huye con Bola de Plumas, que está herido.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "¡Vaya! ¡A Paimon se le olvidó preguntarle dónde está Taruka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Guuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870579,
					"content": "Espera, espera, no llores. Taruka es muy listo, ¡seguro que no le pasará nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#¿A que {REALNAME[ID(2)|SHOWHOST(true)]} también está de acuerdo? ¡Ahora llevemos a Oberón de vuelta a la Academia de Vuelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Convencer al oponente para que se rinda",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Si las cosas pudieran resolverse solo hablando, ¿por qué hay tantos conflictos en el mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "*Ejem*... Paimon quiere decir que el porcentaje de éxito es muy bajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Usar un objeto mágico para capturarlo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "¡A correr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Gruuu... Gruuuuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#¡Vaya, {REALNAME[ID(2)|SHOWHOST(true)]} ya perdió el espíritu de lucha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Defenderse",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Elegiste la defensa en un combate de dos contra uno. El adversario no puede atacar a los dos a la vez... ¿No equivale eso a perder un turno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Usar un objeto",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "¡Has usado las sauriogalletas para recuperar 5 puntos de Aguante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "... ¡Eso no era necesario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Huir",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Tenemos la ventaja, ¡¿para qué quieres huir?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Defenderse",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#Parece que {REALNAME[ID(2)|SHOWHOST(true)]} piensa que la estrategia de defensa no es suficiente y no quiere desperdiciar esta gran oportunidad... ¡Por eso está listo para el ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Usar un objeto",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "¡No hay ningún objeto que podamos usar ahora mismo! Además, ¿no te parece un poco tarde para poner una trampa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#¡Vaya, {REALNAME[ID(2)|SHOWHOST(true)]} está preparado para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Huir",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "¡Oye, ahora no es momento de huir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#¡Hasta {REALNAME[ID(2)|SHOWHOST(true)]} lo sabe! ¡Mira, está listo para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
