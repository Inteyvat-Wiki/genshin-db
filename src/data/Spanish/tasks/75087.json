			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "¿Eh? ¡Taruka! ¡Si ya estás de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#¡{NICKNAME} y Paimon! Menos mal que están bien... Ya les expliqué a Lliwa y los demás lo que pasó. Bueno, y Lamizán es tan tonto como pensaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Aguuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870704,
					"content": "¡Sí, más tonto que tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Guuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870706,
					"content": "#Bueno, está muy triste por haberse separado de ti tanto tiempo. Además, ¡hizo un gran trabajo junto a {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Aún tiene mucho que aprender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Bueno, es que aún es una cría. Si consigues llevarte bien con él, ¡seguro que se convertirá en un Qucusaurio magnífico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "¡Guuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberón"
				},
				{
					"id": 750870710,
					"content": "Por cierto, ¿cómo volviste? ¿Te rescató alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Me escapé por mi cuenta. Quería llevarme a Oberón conmigo, pero no quería separarse de las sauriogalletas y no pude convencerlo, así que me enfadé tanto que me fui solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "¿Eh? ¿Así de fácil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Me fijé en las rutas de los guardias saurios y descubrí que había una oportunidad de escapar, así que eso hice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Va a ser que el más capaz aquí es Taruka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "¡¿Cómo es que están aquí?! Iba a buscar a esa mentirosa para darle su merecido... T-tengo que disculparme con ustedes... Fui demasiado tajante y acabé culpando a las personas equivocadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750870716,
					"content": "Demasiado tarde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "¡Eso! Apareces ahora que las cosas han terminado, no querrás adueñarte del mérito, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "#No tengo nada que decir. Les entregaré la recompensa que les prometieron y la que les debo sin problema. ¡Y pueden darme un puñetazo si así se quedan más tranquil{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750870721,
					"content": "Soy un hombre de verdad. No pienso eludir mis responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750870722,
					"content": "#Que {REALNAME[ID(2)|SHOWHOST(true)]} te dé un buen puñetazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "¡Ay, qué dolor! ¡Aún no he recibido el golpe, pero ya puedo sentir el dolor! ¡Espero que tengan piedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750870727,
					"content": "¿Quién decía que era un hombre y no eludiría responsabilidades? ¡Qué cobarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Da igual, no somos tan rencorosos, ¿verdad, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Agradezco su comprensión. Aunque la Academia de Vuelo no tiene puertas... que sepan que siempre las tendremos abiertas para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizán"
				},
				{
					"id": 750870731,
					"content": "#Bueno, al ver que se llevan tan bien con {REALNAME[ID(2)|SHOWHOST(true)]}, ¡me han entrado ganas de saber cuál es su truco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Jeje, está bien. Si tenemos tiempo algún día, ¡volveremos a enseñarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#Que {REALNAME[ID(2)|SHOWHOST(true)]} te dé una patada en los dedos de los pies.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "¡Reclamo una compensación! ¡Y mi premio de participación!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "Paimon pensaba que ya te habías olvidado de ese premio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
