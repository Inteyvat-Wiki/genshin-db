			"dialogs": [
				{
					"id": 710970101,
					"content": "Hai trovato le Pietre arcaiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970102,
					"content": "Eccole qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "Con queste tre, ora ne abbiamo nove. Dovrebbero bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970202,
					"content": "Avete recuperato ciò che serviva all'Unione di Huishan molto velocemente. Ecco perché parlano tutti così bene di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970203,
					"content": "È stato facile! Una \"camminata\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970204,
					"content": "Paimon, si dice \"passeggiata\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "Eh? Ehm, ma le passeggiate sono pur sempre delle camminate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970206,
					"content": "Oh, ma guarda come rigiri la frittata. Ammirevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Ahah... Abbiamo tutti assistito a come hai eroicamente lottato contro quel mostro marino. Non credo che quest'impresa sia stata difficile per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970208,
					"content": "Per niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Alla faccia del lavorare al Ministero degli Affari Civili! Continuano a chiedermi di fare cose come \"cercare una Pietra arcaica nella Voragine\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970211,
					"content": "A proposito, hai detto che in quel periodo litigavi spesso con tuo padre e che non avevi un lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970212,
					"content": "Ma allora come hai fatto a venire assunto dal Ministero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970213,
					"content": "Ho detto che ero gravemente indebitato, no? Non avevo nessuno a cui chiedere aiuto, e non volevo assolutamente tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970214,
					"content": "Alla fine, gli esattori andarono all'Unione di Shenglu a cercare il mio vecchio... Credevo che sarebbe venuto a spezzarmi le gambe appena scoperto cos'era successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970215,
					"content": "Ma le tue gambe sembrano a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970216,
					"content": "Già... Mi vergogno a dirlo, ma lui ripagò il mio debito e poi venne a cercarmi. Quando mi trovò, somigliavo a un cane randagio malconcio. Mi disse che aveva tutte le mie cambiali e che quindi ora ero indebitato con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970217,
					"content": "E mi costrinse a lavorare per risarcirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970218,
					"content": "Quindi ora devi dei soldi a tuo padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970219,
					"content": "Proprio così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970220,
					"content": "Quando avevo gli esattori alle calcagna, non riuscivo neanche a dormire. Quindi giurai che, se avessi avuto una seconda occasione, mi sarei rimesso in riga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970221,
					"content": "Ma non mi sarei mai aspettato che sarebbe stato mio padre a offrirmela, visto che non gli era mai piaciuto il mio comportamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970222,
					"content": "Inoltre, non mi urlò contro come faceva di solito. Anzi, parlammo in modo onesto e sincero. Quanto vorrei aver parlato così con lui prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970223,
					"content": "Però, anche se lui fosse stato aperto al dialogo, io non lo avrei ascoltato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970224,
					"content": "Tuo padre sembra trattarti bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970225,
					"content": "Già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970226,
					"content": "Quindi devo fare un ottimo lavoro, non importa quali siano le circostanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970227,
					"content": "Che si tratti dell'incidente nella Voragine o della ricerca delle Pietre arcaiche per l'Unione di Huishan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970228,
					"content": "Credo che questa volta il lavoro l'abbia fatto io al posto tuo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Conta anche far fare il lavoro a qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970230,
					"content": "In ogni caso, è solo grazie a voi se è andato tutto a gonfie vele... e molto più velocemente di quanto avessi previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970231,
					"content": "Oh, Paimon riesce finalmente a percepire un briciolo di gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970209,
					"content": "In realtà, è stata difficilotta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}