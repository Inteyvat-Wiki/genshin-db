						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570229,
					"content": "Facciamo una posa divertente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570230,
					"content": "Facciamo una posa naturale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570231,
					"content": "Fai una posa informale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570232,
					"content": "Sì, sì! Questa com'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570233,
						756570235,
						756570237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570233,
					"content": "Perfetto. Fai un bel sorriso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570234
					]
				},
				{
					"id": 756570235,
					"content": "Vediamo la posa naturale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570236
					]
				},
				{
					"id": 756570237,
					"content": "Proviamo una posa informale invece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570238
					]
				},
				{
					"id": 756570239,
					"content": "Sai che forse sarebbe meglio la posa divertente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570240
					]
				},
				{
					"id": 756570234,
					"content": "Paimon è pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570312,
					"content": "Va bene allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570314,
					"content": "Nessun problema!",
