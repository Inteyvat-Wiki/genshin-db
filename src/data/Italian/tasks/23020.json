			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200501,
					"content": "#Oh! Grazie, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Ma questi materiali sono davvero pesanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Inizierò a lavorare non appena possibile. Non ci vorrà molto, quindi la nave dovrebbe essere pronta per un test di navigabilità a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "...Dovrai avere i giubbotti di salvataggio pronti, quando eseguirai il test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Oh, andrà tutto bene, ne sono certo! Abbi un po' di fiducia in me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
