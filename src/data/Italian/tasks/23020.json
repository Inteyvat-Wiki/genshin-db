			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "...Ecco perché ritengo che non si possa lesinare sul materiale in quest'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Non preoccuparti, è abbastanza resistente. Ho fatto tutti i calcoli necessari svariate volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Argh, te l'ho già detto. Ci sono molti problemi che non possono essere risolti facendo dei calcoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Perché state discutendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Oh, sei tu. Stiamo discutendo dei problemi di progettazione della mia nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Ho fatto molti calcoli, e posso garantirti che ogni area è abbastanza resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Ma Qishan si ostina a sostenere che la resistenza calcolata non è necessariamente affidabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "La \"resistenza\" di cui parli esiste solo nella teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "La nave dovrà resistere alla pressione in acqua, che sarà molto più alta dei numeri riportati qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Capisco la logica, ma le mie finanze sono limitate, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Se comprerò altro materiale costoso, al massimo potrò completare la chiglia della nave... *tossisce*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "A ogni modo! Per ora seguiamo il mio piano per questa nave. Ho già acquistato tutti i materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "#Viaggiat{F#rice}{M#ore}, se sei disponibile, potresti aiutarmi a trasportare dei materiali? Da solo non ci riesco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Lascio fare a te allora, ho molti calcoli su cui lavorare. Prenderò il resto quando avrò finito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan è esperta di costruzioni navali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Oh, puoi dirlo forte! In realtà, è anche più veloce di me a fare certi calcoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Non ho idea del perché voglia fare l'aiutante, dico davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
