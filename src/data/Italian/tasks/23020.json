			"dialogs": [
				{
					"id": 230200201,
					"content": "La resistenza dei materiali richiesti per lo scafo, secondo i calcoli di Rafiq, è effettivamente corretta sulla base dei soli dati teorici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200202
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200202,
					"content": "Ma se vuoi davvero metterla in acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200203
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200203,
					"content": "Lasciamo perdere, tanto non mi darebbe retta comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
