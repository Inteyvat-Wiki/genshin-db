				]
			},
			"dialogs": [
				{
					"id": 40190301,
					"content": "I miei occhi m'ingannano od ho appena visto due detenuti tornare dalla superficie? Ultimamente soffiano strani venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "Volevamo vedere come va al Forte! È tutto a posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Per la maggior parte, sì. Neuvillette è sceso quaggiù e ha preso le redini della situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "I tal caso, perché non gli chiediamo di restare qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Oh, sì, che piano brillante! Andiamo a convincere lo Iudex in persona per scambiare la Corte di Fontaine con una pozza d'acqua nel bel mezzo del nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Non penso che funzionerà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "È venuto qui di fretta, e se n'è andato senza nemmeno bere una tazza di tè. Ma almeno si è ricordato di prendere il regalo di Mademoiselle Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Sembra super impegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Anche Mademoiselle Clorinde è andata via, anche lei con il regalo di Mademoiselle Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "I regali erano dei frullati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Neuvillette ha ricevuto un frullato, Clorinde un rossetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Eh? Non c'entrano assolutamente nulla l'uno con l'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Beh, è colpa di Neuvillette se lavora così tanto al punto da far preoccupare Sigewinne. Ma, anche ignorando la cosa, alla nostra caposala piace molto regalare prodotti di bellezza alle signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Oh, e ho qui dei regali anche per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "Sono da parte di Sigewinne anche questi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "No, sono da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Avete già completato il vostro lavoro al Forte, quindi potete tornare in superficie in qualsiasi momento. D'altra parte, non avete ancora scontato tutta la pena, quindi potete continuare a usare la vostra cella fino alla scadenza del periodo di detenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Sul serio? Allora possiamo rimanere qui per un sacco di tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "I pranzi sono sempre inclusi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Potete accedere al refettorio gratuitamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "Urrà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Ricordatevi solo di compilare tutte le scartoffie al momento della scarcerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
