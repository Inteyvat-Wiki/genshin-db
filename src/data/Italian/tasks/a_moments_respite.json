			},
			"dialogs": [
				{
					"id": 40190401,
					"content": "#Eh? Siete... tornat{F#e}{M#i}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot! Laverune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "#Non vi avranno per caso... beccat{F#e}{M#i} e rispedit{F#e}{M#i} quaggiù, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Eh? No, assolutamente no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "#Uff! E io che pensavo che foste riuscit{F#e}{M#i} a evadere durante quella confusione... Vi consideravo {F#delle}{M#degli} evas{F#e}{M#i} leggendar{F#ie}{M#i}, ma ora mi dite che... non siete mai andat{F#e}{M#i} via?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Ahahah... Uh, ci dispiace, ma noi... avevamo delle questioni di cui occuparci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Va bene, è lo stesso, non servono i dettagli. Siamo solo sollevati di vedervi, lui era estremamente in pensiero per voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "Ehi, non solo io! Non lo eri anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Qualcosa del genere, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "#Qualche giorno fa mi hanno trasferito in cucina. Riesco ancora a sentire Cuistot mormorare alle carote: \"Staranno bene? Saranno ancora viv{F#e}{M#i}?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Ogni volta che faceva così, gli dicevo: \"Sono certo che stanno bene! Ovunque si trovino si staranno sicuramente rilassando, sorseggiando una bibita e godendosi il panorama\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "#Ehi! Non c'è niente di male a preoccuparsi {F#delle proprie compagne}{M#dei propri compagni} di prigione, no? Cioè, se pensi a quanto gli piaceva ascoltare tutti i miei pettegolezzi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Questi due... sono decisamente più cordiali e amichevoli di quanto Paimon pensasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "#Sono sicur{F#a}{M#o} che la qualità dei pasti assistenziali è salita alle stelle, ultimamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "...Beh, se lo dici tu. Ti terrò d'occhio per assicurarmi che ripulisca il piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "I vostri piatti attireranno tutti i detenuti nel refettorio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
