			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME} e Paimon, siete tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "#State bene? Vi siete fatt{F#e}{M#i} male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Non temere, stiamo alla grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Stiamo bene! E voi? Con tutto il caos che è successo... Ci sono stati problemi gravi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Alcuni hanno riportato delle lesioni superficiali, ma nulla di più. Messire Neuvillette è venuto in visita. È solo grazie a lui se siamo riusciti ad arginare l'emergenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Naturalmente dobbiamo ringraziare anche voi per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Come faceva Neuvillette a sapere che ci sarebbe stato bisogno di lui qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "La risonanza di Messire Neuvillette con l'elemento di Hydro è molto forte. Quando il livello dell'acqua sale, lui riesce a sentire le onde che vengono generate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "#Mentre stavo medicando i feriti sono incappata nei Fratelli Bomba. Non facevano che farfugliare di come siete cors{F#e}{M#i} di sotto senza dire una parola... Sono così sollevata di vedere che state bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Se non siete troppo di fretta, sarei lieta se vi fermaste qualche altro giorno con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Se vi viene voglia di un piatto particolare, fatemelo sapere, così dirò a Monsieur Wolsey di prepararvelo. Oh, e venitemi pure a trovare in infermeria ogni volta che volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Vorrei anche approfittare dell'occasione per osservare i vostri muscoli facciali. I vostri sorrisi felici sono piuttosto contagiosi, sapete? Sono così memorabili, e mi sono mancati immensamente quando non c'eravate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
