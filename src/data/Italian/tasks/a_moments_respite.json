			"dialogs": [
				{
					"id": 40190201,
					"content": "Indovinate, quale sarà il seme della prossima carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Mmm... Un gatto ghignante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190203,
					"content": "Bene bene, guarda chi c'è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Ciao a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190206,
					"content": "Sembra che ti stia riprendendo piuttosto bene, Freminet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "Mm, è grazie al supporto di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190208,
					"content": "Oh, giusto! Sono... riuscito a trovare il coraggio di ringraziare Mademoiselle Clorinde di persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190209,
					"content": "Woah! E come ha reagito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "Mi ha detto che non c'era problema... Mi ha dato l'impressione che per lei salvare una vita non fosse niente di che. Mi ha anche detto di non preoccuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190211,
					"content": "Non voleva stressarti, tutto qua. Ha ragione, è meglio non starci a rimuginare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Già...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190213,
					"content": "#Ok, ma sentite qua! Siamo tornat{F#e}{M#i} al teatro e abbiamo incontrato la Fantesca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "Avete incontrato il \"Padre\"? Vi ha detto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Ha detto che alcune cose erano... ehm, un pochino difficili da comprendere, e che non vede l'ora di lavorare con noi in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "È stata una sorpresa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "Il suo atteggiamento nei vostri confronti è persino meglio di quanto avessimo immaginato... È fantastico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "#Dovreste fidarvi di lei. Ha un modo di agire tutto suo, ma farà ogni cosa in suo potere per aiutare le persone a cui si considera legata. E tra quelle persone ora siete inclus{F#e}{M#i} anche voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Mh-mh... Nostro \"Padre\" è molto capace e affidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "Oh, Paimon si è appena ricordata una cosa: lei ha detto che Lyney è anche un tantino troppo orgoglioso! Dice che dovresti imparare a fidarti più spesso degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Uh... Capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Sembra proprio qualcosa che direbbe il \"Padre\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190223,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Vi fermerete qui per i prossimi giorni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "Così sembrerebbe, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Eccellente. Organizzerò un tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Davvero? Allora Paimon vuole un'altra porzione di torta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "Questo vuol dire che hai già avuto modo di assaggiare delle torte deliziose lassù. Mh, molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "La prossima volta potrai gustare del tè e degli spuntini anche con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
