					}
				]
			},
			"dialogs": [
				{
					"id": 40190601,
					"content": "#E rieccoci nella nostra cella! Ma non siamo più prigionier{F#e}{M#i}, quindi la sensazione è diversa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "Ci siamo tolti un peso enorme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Già, la sensazione è quella... Ma, in fondo non abbiamo mai fatto nulla di male, quindi non capisco perché abbiamo finito col metterci così tanta pressione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "È come se avessimo riconquistato la nostra libertà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "Mm! Essere liberi fa sentire molto speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Paimon, vuoi dire qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Eh? Come hai fatto a capirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Perché di solito ti addormenti immediatamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Ehi, non è vero! Però... Ok, Paimon voleva soltanto dire che siamo un duo fantastico, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "#Vedi... Abbiamo visitato così tanti posti assieme, e fatto amicizia con così tante persone... Non ci siamo mai fermat{F#e}{M#i}, né abbiamo mai smesso d'incontrare nuovi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "#Ci sono così tante brutte cose nel mondo, e noi siamo solo in due, ma abbiamo comunque risolto problemi ovunque siamo andat{F#e}{M#i}... Non è grandioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "#Siamo {F#le avventuriere}{M#gli avventurieri} migliori in assoluto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "#Oggi conti anche Paimon? Non sei tu {F#la sola avventuriera}{M#il solo avventuriere} qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Anche fare da guida conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "Allora chiediamo a Katheryne di dare un Manuale dell'avventuriere anche a Paimon! Da oggi in poi, anche Paimon sarà un'avventuriera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "Ahh, al solo pensiero, Paimon sprizza gioia da tutti i pori... Paimon sta crollando dal sonno, dovresti andare a dormire anche tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "#L'ultima volta che ci siamo addormentat{F#e}{M#i} qui, al nostro risveglio c'era una confusione tremenda fuori dalla cella. C'è mancato poco che l'Acqua primordiale arrivasse fin qui. È stato paurosissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190618,
					"content": "Ora dovremmo essere al sicuro, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190619,
					"content": "Andrà tutto bene. Non preoccuparti, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190620
					]
				},
				{
					"id": 40190620,
					"content": "#Ok, allora buonanotte, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190621,
					"content": "Buonanotte a te, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
