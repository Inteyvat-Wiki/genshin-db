			"dialogs": [
				{
					"id": 40190501,
					"content": "Jurieu! Mademoiselle Sigewinne mi ha detto che non hai ancora mangiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "Ehm, mi stavo occupando di qualcosa e mi sono dimenticato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Non è un motivo valido per... Eh? Siete voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "#Jurieu, Lourvine, siamo tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "Ehilà. Ultimamente c'è stata parecchia confusione qui. Voi tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "Stiamo bene, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "E voi? Andate sempre a lavorare sulla nave percorrendo il passaggio segreto dall'infermeria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Già, ma è ancora top secret, quindi non dite niente a nessuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Può essere un tantino fastidioso quando nell'infermeria ci sono molte persone, ma preferisco comunque passare da lì che dall'ufficio del Duca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Cioè... Dall'infermeria ce la si può prendere più comoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Ah, sì? E allora perché vieni qui tanto spesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Voi due non starete mica usando il lavoro per nascondere la vostra relazione, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "Nient'affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
