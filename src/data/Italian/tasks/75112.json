					"Xiuhyo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751120301,
					"content": "#Mmmh... {F#Guerriera}{M#Guerriero} {F#giunta}{M#giunto} da lontano, ho un favore da chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120304
					],
					"speakerTitle": "Xiuhyo",
					"speakerSubtitle": "Capo allenatrice, Figli degli Echi"
				},
				{
					"id": 751120304,
					"content": "Anche se sono la \"Capo allenatrice\" della nostra tribù, le mie abilità non sono degne di un simile titolo. Non ho la certezza che la difficoltà della Sfida del guerriero che ho ideato sia adeguata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120305
					],
					"speakerTitle": "Xiuhyo",
					"speakerSubtitle": "Capo allenatrice, Figli degli Echi"
				},
				{
					"id": 751120305,
					"content": "Potresti aiutarmi a verificarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120302,
						751120303
					],
					"speakerTitle": "Xiuhyo",
					"speakerSubtitle": "Capo allenatrice, Figli degli Echi"
				},
				{
					"id": 751120302,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatrice, Figli degli Echi"
				},
				{
					"id": 751120303,
					"content": "Dammi un attimo per prepararmi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatrice, Figli degli Echi"
				}
			]
		},
		{
