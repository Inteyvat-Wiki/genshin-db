			},
			"dialogs": [
				{
					"id": 751120201,
					"content": "#Eheh, ho avvertito la tua presenza da lontano, {F#guerriera}{M#guerriero} {F#giunta}{M#giunto} da lontano. Davvero notevole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120204
					],
					"speakerTitle": "Centaca",
					"speakerSubtitle": "Capo allenatore, Figli degli Echi"
				},
				{
					"id": 751120204,
					"content": "Vuoi prendere parte alla Sfida del guerriero? Non per vantarmi, ma confido che questa prova ti sarà di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120202,
						751120203
					],
					"speakerTitle": "Centaca",
					"speakerSubtitle": "Capo allenatore, Figli degli Echi"
				},
				{
					"id": 751120202,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatore, Figli degli Echi"
				},
				{
