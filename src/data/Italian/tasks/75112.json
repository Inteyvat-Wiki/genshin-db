			"dialogs": [
				{
					"id": 751120401,
					"content": "Per noi Discendenti delle Vette, l'agilità e la destrezza sono qualità fondamentali, ed è su di esse che si basa la Sfida del guerriero che ho preparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120404
					],
					"speakerTitle": "Lirio",
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120404,
					"content": "#Allora, {F#guerriera}{M#guerriero} {F#venuta}{M#venuto} da lontano... Ti va di affrontarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120402,
						751120403
					],
					"speakerTitle": "Lirio",
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120402,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120403,
					"content": "Dammi un attimo per prepararmi...",
