			},
			"dialogs": [
				{
					"id": 751120501,
					"content": "#Uhm, {F#un'}{M#un }ospite proveniente da lontano. Beh, cosa ne dici di affrontare la mia Sfida del guerriero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120504
					],
					"speakerTitle": "Cima",
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120504,
					"content": "I nostri combattenti tribali devono affrontare un gran numero di Sfide del guerriero in tutta Natlan. In quanto a me, io sono una di quelli che le organizzano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120505
					],
					"speakerTitle": "Cima",
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120505,
					"content": "#Dal tuo aspetto, non sembri particolarmente tenace, {F#straniera}{M#straniero}. Ti va di affrontare la sfida che ho ideato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751120502,
						751120503
					],
					"speakerTitle": "Cima",
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
					"id": 751120502,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatrice, Discendenti delle Vette"
				},
				{
