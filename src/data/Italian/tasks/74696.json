					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Ti sta tornando in mente qualcosa, Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Ah... Ehm... Chiedo scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Non c'è bisogno di scusarsi. Abbiamo ancora molta strada da fare prima di raggiungere il Palais Mermonia. Continuiamo a camminare, per ora: sono sicura che presto ricorderai dov'è la tua casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "Guarda, c'è Qiqi! Ed è insieme a una Melusina. Ecco un duo che Paimon non si aspettava di vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah! {NICKNAME} e... Pai... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Conosci Qiqi? Fantastico! L'ho incontrata mentre indagavo nei pressi di Porto Lumidouce... A giudicare dalla sua statura, ho pensato che fosse una bambina umana... È una bambina, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Io... sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Una nostra cara amica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "#Giusto, giusto! Ci conosciamo da una vita. Siamo migliori {F#amiche}{M#amici}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Hihi! Che prontezza di spirito! Se Qiqi avesse detto di essere una zombi, l'avrebbe spaventata a morte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "#Sì... Migliori... {F#amiche}{M#amici}... Esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Beh, questa è sicuramente una felice coincidenza. A essere sincera, è la prima volta che mi trovo completamente spiazzata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Immagino che tu sia a conoscenza dei suoi problemi di memoria? Sembra riuscire a ricordare a malapena qualcosa oltre al proprio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Qiqi a volte si comporta così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Povera piccola. Volevo portarla allo Spettro Maréchaussée e lasciarla lì per un po', ma speravo che durante il viaggio potesse recuperare qualche ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "#Dal momento che siete così {F#buone amiche}{M#buoni amici}, immagino che sappiate dove abita? Se potessi portarla direttamente a casa, mi risparmierebbe un sacco di problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Sì, lo sappiamo... Ma è, ehm, molto lontano da qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Molto... lontano...? Mm... Ho seguito un Seelie fino a Porto Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Eh? Ti sei ricordata qualcosa? Cos'è successo prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Prima... Il dottor Baizhu mi ha portata con sé durante le sue visite a Yi... Ehm, Yi qualcosa... Sono andata a raccogliere erbe, e poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Ooh! Baizhu ti ha portato al Pontile Yilong, vero? Detective Paimon crede di sapere cos'è successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu ha portato Qiqi a visitare dei pazienti al Pontile Yilong. Si è persa mentre raccoglieva delle erbe medicinali, ha visto un Seelie e l'ha seguito fino a Porto Lumidouce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hihi, per fortuna Paimon e {NICKNAME} hanno letto Robben contro Chesterton! Deduzioni semplici come queste sono diventate un gioco da ragazzi per Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Sai che quel libro è un'opera di fantasia, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Ah! Bene, tutto torna! Riporterò subito Qiqi al Pontile Yilong. Il dottor Baizhu è il tutore di Qiqi, giusto? Dev'essere preoccupatissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Aspetta... Quelle persone nella profezia di Barbeloth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Oh, hai ragione! Paimon se n'era quasi dimenticata. Barbeloth... Ci sei? Riesci a sentirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Non c'è bisogno di gridare. Sono stata qui per tutto il tempo. Semplicemente non volevo interrompere la vostra conversazione. Ascoltare è il primissimo requisito di ogni cartomante che si rispetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "La cosiddetta guida di questo Seelie potrebbe anche essere considerata la guida del destino. Eheh... Dato che sei qui, Qiqi, perché non ti fai leggere le carte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Car... te...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Oh, cielo, Barbie, lascia che intervenga io. Non sei proprio adatta a parlare con i bambini, sai? Stai spaventando questa poverina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Lascia fare a me. Ora ascolta bene: ecco come si consegna un piccolo regalo a sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Ahem... Piccola Qiqi, membro dell'Hexenzirkel, sono la madre della tua alleata Klee: Zia Alice, la più grande strega del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Piacere di conoscerti, Zia Alice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Ah, che bambina dolce ed educata. Ora lascia che un'amica della Zia, un'altra grande strega, ti organizzi una meravigliosa festa di predizione del futuro a sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Una festa... di predizione del futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Esatto! Guarda le carte che hai davanti. Non sono belle? Ti piacciono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Mi... piacciono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Magnifico! Ora, puoi sceglierne una per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Uhm... Questa va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Ma certo. E dato che ti sei comportata così meravigliosamente bene, quella carta è tua, puoi tenerla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "Ehm... Grazie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Bene, Barbie, la pausa è finita. Vieni ad aiutare la piccola Qiqi con la lettura della carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Non c'è bisogno di scuotermi per svegliarmi... Ho ascoltato tutto il tempo. Ah, l'Appeso dritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Pochissime persone pescano questa carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Questo significa che sei molto speciale, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Simboleggia la trascendenza e l'attesa, ma anche il distacco dal mondo quotidiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Ci sono delle catene che ti legano, ma tu stessa non hai alcun desiderio di liberartene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Catene... Intendi... i miei ordini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Almeno in superficie, non avresti torto a interpretare le cose in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Per quanto riguarda il tuo futuro, tutto ciò che devi fare è aspettare. Certo, non è che ti manchi il tempo... Ma... Oh, che strano, davvero strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Aspetta un momento! Stai dicendo troppe cose tutte insieme! Concedi alla bambina il tempo di respirare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Lascia che Qiqi assapori prima il suo regalino. Dovresti davvero avere un po' più di pazienza con i bambini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Che ne pensi, Qiqi? Ti piace la tua sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Questa carta è carina... Grazie, Zia Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Oh, brava bambina... Hai fatto proprio un ottimo lavoro a ricordare il nome della Zia. La Zia vorrebbe tanto chiacchierare ancora un po' con te, ma è ora che tu torni a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Se Zia Barbie ha altro da dire, allora la prossima volta che l'Hexenzirkel si riunirà, potrà fare una profezia a ogni streghetta che vi prenderà parte! Non sarebbe meraviglioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "...Potresti evitare di aumentare il mio carico di lavoro senza chiedermelo prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "#Allora è deciso! Ci vediamo la prossima volta, Qiqi, e {F#tutte}{M#tutti} voi qui presenti, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "Ciao, ciao... Zia Alice... e... migliore amica di Zia Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Uff... È tutto finito, adesso? Quelle due voci provenivano davvero da questa bambola? Ma che tipo di giocattolo è? È così carino, dove posso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Uff! No, adesso questo non è importante. Qiqi, andiamo a cercare il tuo dottor Baizhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#...Mmh, è ora... Qiqi deve tornare a casa. Alla... prossima, {NICKNAME}... e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "Stammi bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Carta... Regalo... Mm... Carino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "Sii prudente.",
