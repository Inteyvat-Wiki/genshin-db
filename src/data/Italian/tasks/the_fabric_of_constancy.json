			},
			"dialogs": [
				{
					"id": 120170401,
					"content": "Quindi le foto sono rappresentazioni visive, come delle impronte... oppure delle ombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
					"content": "Affascinante. Oggi sto imparando molto. Procediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "Finito! Diamo un'occhiata alla tua foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Wow... È straordinaria. Si tratta di una magia di qualche tipo? Sembra una... copia di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "Una copia però incapace di muoversi e parlare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "È solo un'immagine di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "Pensavo non venisse bene, dal momento che mi sentivo impacciata. In realtà, è risultata più naturale del previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "La postura è identica alla mia, lo sfondo anche... Come è possibile realizzare qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "È ciò che rende le foto speciali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Un attimo, fatico ancora a capire. Temo che dovrete spiegarmi tutto da capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "#La persona nella foto... siete sicur{F#e}{M#i} che non si tratti di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "Se non sono io, allora perché è identica a me? E se invece sono io... allora io chi sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Ehm... Paimon alza bandiera bianca. Tocca a te, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "È simile al rapporto tra te e la Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Sì, esatto. Consideri la Shogun parte di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Naturalmente. Non ho mai avuto intenzione di lasciare Inazuma nelle mani di qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "Quindi, in questo preciso momento, tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "Beh, io sono io. Di questo non ho dubbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "Non esiste una sola te, quindi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "Una sola me? Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "Penso di aver capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "Io sono io. Sono unica, però posso esistere in tante forme differenti e non importa quale sia la forma, ciò che importa è che esista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "La Shogun, per esempio, è una delle forme in cui esisto. La domanda \"lei sono io?\" non è determinata da nessuno dei suoi componenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "Quindi anche questa immagine è una delle forme in cui esisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Mmmh... Quindi perfino chi ambisce all'eternità, come me, cambia costantemente forma alla propria esistenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Ma allora come posso chiedere a Inazuma, e a tutti i suoi abitanti, di rimanere sempre immutati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Inazuma sarà sempre Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Tutto quello che ho scoperto in questo viaggio con voi va oltre la mia conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "#*sospira* Oggi vi sarò sembrata piuttosto ignorante. Forse non ve ne siete accort{F#e}{M#i}, ma tutto ciò ha messo a dura prova la mia percezione delle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Sulla base delle mie esperienze odierne, devo accettare il fatto che Inazuma sia un luogo completamente diverso rispetto a quello che ricordavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "Allo stesso tempo, però, sarebbe sbagliato concludere che l'Inazuma dei giorni d'oggi non sia comunque Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Tanto il Decreto di caccia alle Visioni quanto la Statua della divinità onnipresente erano stati pensati per raggiungere l'eternità. Se l'eternità fosse stata davvero a portata di mano, però, nulla di tutto questo sarebbe mai accaduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Forse... Forse ho esagerato nei miei tentativi di impedire il cambiamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "A Paimon sembra che Ei abbia finalmente capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "#Quindi vuol dire che siamo stat{F#e}{M#i} delle guide fantastiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Maestro Kamaji! Maestro Kamaji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Mmmh? Come mai tutto quel baccano, laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "Sembrava la voce di Ippei. Forse c'è qualche problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Ippei? Appartiene alla Commissione Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Sì. Scopriamo cosa sta succedendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "Gli esseri umani resteranno sempre umani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "Non sei tu come persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ippei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "Ehi, Ippei, ci sono problemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170702,
					"content": "Ah, siete voi... Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170703,
					"content": "C-Come? La Shogun onnipotente?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170704,
					"content": "Starete sicuramente cercando il mio maestro, Kujou Kamaji. Non è qui al momento, mi spiace. Volete che gli consegni un messaggio da parte vostra? A disposizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170705,
					"content": "#No grazie, non sono qui per lui. Abbiamo sentito le tue grida e siamo venut{F#e}{M#i} a capire cosa sta succedendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170706,
					"content": "Stai cercando il tuo Maestro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "Sì. Il maestro Kamaji non è ancora tornato dalle trattative e inizio a preoccuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170708,
					"content": "A dire il vero, è sua consuetudine fare lunghe passeggiate e rientrare tardi. Quindi, è possibile che si sia soffermato da qualche parte e abbia perso la cognizione del tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170709,
					"content": "Ma per qualche motivo, oggi mi sento particolarmente nervoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170710,
					"content": "Kujou Kamaji... Un discendente del clan Kujou, deduco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170711,
					"content": "Esatto. Dato che il capo del clan gode di scarsa salute di recente e che il maestro Masahito è raramente a casa, il maestro Kamaji funge al momento da rappresentante dell'intero clan Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170712,
					"content": "Ho sentito dire che attualmente la situazione all'interno della Commissione Tenryou è tutt'altro che tranquilla. È dovuto forse a Kujou Kamaji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170713,
					"content": "Ci perdoni, Shogun onnipotente. Il clan Kujou è venuto meno al suo dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170714,
					"content": "La reputazione del clan Kujou si è macchiata e la sua autorità sulla Commissione Tenryou è in declino. Inoltre... ehm... deve ancora esprimere un verdetto sul futuro della Commissione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170715,
					"content": "Per questo il maestro Kamaji ha deciso di avviare delle trattative con il clan Takatsukasa, per chiedere loro di prendere il nostro posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170716,
					"content": "Di sicuro staranno discutendo di una cosa tanto importante al loro quartier generale, no? Perché li cerchi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170717,
					"content": "In realtà hanno deciso di incontrarsi altrove. Non ho ben capito perché onestamente, ma non spetta a me giudicare le decisioni dei miei superiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170718,
					"content": "Il luogo di ritrovo è nelle montagne vicino al Gran Santuario di Narukami. Credo che il clan Takatsukasa abbia una specie di base lassù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170719,
					"content": "Takatsukasa... Un altro nome familiare. Hanno servito fedelmente il clan Kujou per tutti questi anni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170720,
					"content": "Certo, ecco perché il maestro Kamaji ha deciso di interpellarli. Immagino avessero moltissimi argomenti di cui discutere, però è impossibile che non abbiano ancora terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170721,
					"content": "Ho perlustrato la città da cima a fondo, ma se non è ancora tornato temo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170722,
					"content": "Forse non hanno ancora finito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "Sì, ci ho pensato anche io... Una persona del mio rango, però, non può permettersi di entrare liberamente nel territorio del clan Takatsukasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170725,
					"content": "Possiamo andare noi a controllare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "Non ce n'è bisogno, grazie. Forse sono io che esagero. E poi, se stessero ancora negoziando, potrebbero incolpare me per l'interruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170727,
					"content": "Non sono che un umile servitore, però io e il maestro Kamaji siamo cresciuti insieme... Oh, spero non gli sia accaduto nulla di male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170728,
					"content": "Non sono intelligente come il Maestro, né posso davvero togliergli del peso di dosso. Ma, allo stesso tempo, non me ne starò con le mani in mano, sapendo che potrebbe essere in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170729,
					"content": "Uhm... Che ne pensi, Shogun onnipotente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170730,
					"content": "Andiamo a vedere cosa sta succedendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170731,
					"content": "Se sarò presente anche io, difficilmente ti incolperanno di aver interrotto le trattative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170732,
					"content": "Inoltre, tutto ciò è derivato dal fatto che non ho preso una decisione in tempo. Ho creato io il problema e io dovrò risolverlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170733,
					"content": "Questa sì che è dedizione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "La ringrazio di cuore, Shogun! Nel frattempo, continuerò a cercare anche nei dintorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170736,
					"content": "Lasciate che vi indichi la posizione della base. Spero vada tutto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170734,
					"content": "Ben detto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "Forse è successo qualcosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
