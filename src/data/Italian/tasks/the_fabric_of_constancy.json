				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "Quindi... cosa dobbiamo fare, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170202,
					"content": "Ti facciamo una foto. Lascia fare a noi, tu hai un compito facile facile: mettiti in posa laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170203,
					"content": "In pratica, le foto sono documenti visivi di te in un preciso istante. Dei souvenir perfetti, insomma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170204,
					"content": "Bene, ma che significa \"mettersi in posa\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170205,
					"content": "La foto è una rappresentazione visiva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Oh, capisco. In altre parole, devo scegliere una postura accattivante da esibire qui di fronte a voi, è corretto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170207,
					"content": "Più ci penso e più trovo tutto ciò imbarazzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170208,
					"content": "Che postura dovrei scegliere? Ne vorrei una apprezzabile, ma non esagerata. Oh, non mi sento proprio portata per queste cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170209,
					"content": "Provane una aggraziata e solenne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "D'accordo, ci proverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170215,
					"content": "Va benissimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Coraggio, cominciamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170219,
					"content": "Scegliamo una bella angolazione per la foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170216,
					"content": "Proviamone una diversa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "D'accordo. Beh, lascio a voi la decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170211,
					"content": "Provane una rigida e seria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "Non sento mi si addica molto... Così va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170213,
					"content": "Provane una rilassata e disinvolta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "Disinvolta... Che ne dici di questa? Mi viene abbastanza naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				}
			]
		},
		{
