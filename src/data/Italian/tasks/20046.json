				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460101,
					"content": "Bene, lavoriamo sodo anche oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460102,
					"content": "Ahah, ti vedo molto carica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "Ma certo! Essere un'avventuriera è così emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460104,
					"content": "Beh... ancora non so bene cosa fare quando mi occupo degli incarichi, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460105,
					"content": "#Viaggiat{F#rice}{M#ore}, ti spiace venire di nuovo con me? Ci sono ancora delle cose che vorrei chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460108,
					"content": "Allora partiamo. L'incarico di oggi è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460109,
					"content": "Ah... Dovremo scortare... un altro pallone aerotrasportatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460106,
					"content": "Vuoi che venga con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "Ti va? Eheh, certo! Avrei tantissimo da imparare da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004604",
							"2"
						],
						"stepId": 2004604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "#Abbiamo finito! Grazie, viaggiat{F#rice}{M#ore}. È andata molto bene, credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460202,
					"content": "Ma questa è la tariffa normale per gli avventurieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460203,
					"content": "Ce ne saranno altre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "Perché quel tono sconsolato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460207,
					"content": "Ah, è così... Bene! Allora continuerò a lavorarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460208,
					"content": "Quando avrò risparmiato abbastanza Mora, porterò mio fratello e i miei genitori in viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460209,
					"content": "Mio fratello avrebbe sempre voluto viaggiare... Ma mi sono ammalata, ed è dovuto restare per prendersi cura di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460210,
					"content": "Ma ora sto bene, sono persino diventata un'avventuriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460211,
					"content": "Eheh, quando arriverà il momento, aiuterò anche mio fratello a realizzare qualche suo sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460205,
					"content": "Lo capirai col tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "Ehi, non fare quella faccia così stanca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
