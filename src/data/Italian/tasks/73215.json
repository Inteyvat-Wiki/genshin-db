			},
			"dialogs": [
				{
					"id": 732150201,
					"content": "Ciao, ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "Ciao, piccolino! Ti ricordi ancora di noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "Diavolo, Bianchina volante! Non sono un piccolino! Ricordate ancora la canzone che vi ho insegnato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "Sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "Allora promettetemi che, anche se un giorno dovessi dimenticare la mia canzone... voi ve la ricorderete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
