					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "#Salve, amic{F#a}{M#o} Nara! Mmmh... Dovevo dirti una cosa, ma non ricordo cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "Non ti preoccupare. Siamo già felici di averti rivisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Beh, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "A proposito di Mawtiyima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Non parla più, ma sta bene. Riprendendosi anche, la foresta è... Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "A proposito del dimenticare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Dimenticare...? Oh, perché il potere è svanito, il Kusava. Per questo scorrerà via anche lei, la memoria. Goccia dopo goccia, come rugiada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
