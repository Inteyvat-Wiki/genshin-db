				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "#Ciao! E grazie, Nara dorat{F#a}{M#o} e Bianchina volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150302,
					"content": "Cosa ci fate voi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150303,
					"content": "Ci hai detto tu di ricordarci di tornare a giocare con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150304,
					"content": "Oh, davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150305,
					"content": "Sì, davvero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150309,
					"content": "A ogni modo, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150307,
					"content": "Che succede? C'è qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "Mmmh... No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				}
			]
		},
