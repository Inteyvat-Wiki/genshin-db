			"dialogs": [
				{
					"id": 732150601,
					"content": "#Nara dorat{F#a}{M#o}, Bianchina volante! Siete qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Già! Proprio qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Eheheh... Probabilmente ho dimenticato molte cose, quindi ho bisogno che mi aiutiate a ricordarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "È per via del Kusava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Sì... Aranaga forse ve l'ha detto... Potere sta nei ricordi. Niente ricordi, niente potere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Quindi... Dobbiamo aver vissuto qualcosa insieme, ma non lo ricordiamo più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Ahah, ma ad Aragaru non importa! Possiamo sempre creare dei nuovi ricordi insieme, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
