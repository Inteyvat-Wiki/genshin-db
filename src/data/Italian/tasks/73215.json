			"dialogs": [
				{
					"id": 732150401,
					"content": "#Ciao, Nara dorat{F#a}{M#o} e Bianchina volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150402,
					"content": "Ciao! Come va la vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150403,
					"content": "#Bene! Ma perché siete tornat{F#e}{M#i} qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150404,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150405,
					"content": "Beh... La cosa ci preoccupa. Dev'esserci un motivo, ma proprio non so perché siete qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150406,
					"content": "Dopo tutte le avventure che abbiamo vissuto con voi, volevamo rivedere questo posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150407,
					"content": "Oh... Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150408,
					"content": "Non si ricorda di quello che abbiamo passato insieme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
