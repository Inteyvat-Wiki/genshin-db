			"dialogs": [
				{
					"id": 752710101,
					"content": "Ti prego, non far scoppiare quei palloncini! Se proprio vuoi giocarci, ne ho altri che posso darti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "Questi palloncini sembrano speciali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Mi vergogno un po' a dirlo, ma sono davvero importanti per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "Se li guardi bene, indovinerai subito il loro scopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "Per una proposta di matrimonio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "In realtà, per una dichiarazione d'amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "Intendo usare questi palloncini per confessare il mio amore a Yopoyi! Beh? Che cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "Dovresti usare dei palloncini rossi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "Mmh... In effetti hai ragione. Accidenti, il mio romanticismo non è ancora all'altezza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "Ma Yopoyi sarà qui da un momento all'altro! Dove li trovo dei palloncini rossi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "Per una dichiarazione d'amore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "G-Già, esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
