			"dialogs": [
				{
					"id": 752710501,
					"content": "Grazie di cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "Ziki vi ha causato dei problemi? La sua mentalità è un po' fuori dagli schemi, ma è proprio questo che mi piace di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yopoyi"
