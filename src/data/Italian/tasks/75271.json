					"Ziki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Dei romantici palloncini rossi... Faranno di certo sussultare il cuore della mia amata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "#Non è così, {F#amica mia}{M#amico mio}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Non sono... la persona giusta a cui chiedere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#In ogni caso, ti ringrazio davvero tanto, {F#amica mia}{M#amico mio}. Per favore, resta un altro po'. Vorrei presentarti a Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Vista l'ora... Mmh, dovrebbe arrivare a minuti. Abbiamo un appuntamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Ne sarà estasiata, poco ma sicuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
