			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! Sei venuta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? Sei tu... Cosa ti sei messo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Sono un Nanasso, il tuo preferito! L'ho preso in prestito apposta per l'occasione. Che te ne pare? Ah, e questi palloncini li ho preparati per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "In realtà, c'è qualcosa che vorrei dirti da un po' di tempo... Esci con me, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "...Dici sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Sì! Mia adorata Yopoyi, per favore, esci con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Hai battuto la testa mentre ti mettevi quel costume? Oggi è il nostro terzo anniversario! Siamo SPOSATI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Lo so! Ma... mi hai sempre detto che non sono un tipo romantico, e non ti ho nemmeno mai fatto una dichiarazione effettiva prima di sposarci... Quindi, anche se è tardi, questa è la mia dichiarazione d'amore per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Ahah... Sei troppo strano. Ovvio che uscirò con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Dici davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Sì, dico davvero, razza di babbeo romanticone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Un alito di vento spira, e i due innamorati si stringono in un abbraccio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
