					"nextDialogs": [
						752710402
					]
				},
				{
					"id": 752710402,
					"content": "#Sì! Grazie, grazie infinite, {F#amica mia}{M#amico mio}! Sei davvero gentile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
