			"dialogs": [
				{
					"id": 762080101,
					"content": "Eh? Sembra che una cortina trasparente si stia alzando intorno a noi... È opera di quell'albero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Sembra che stia rilasciando resina... Paimon ha l'impressione che voglia trasformare questo posto in un pezzo d'ambra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "E noi saremmo i piccoli insetti intrappolati dentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "Un oggetto d'ambra con noi due dentro? Paimon scommette che sarebbe il pezzo forte di qualsiasi asta! Saremmo un tesoro unico nel suo genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Allora qual è la vera punta di diamante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Questo albero, ovviamente! È lui che produce tutta quest'ambra, dopotutto. Peccato che non possiamo portarcelo via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080107,
					"content": "Paimon si chiede se ci siano indizi nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
