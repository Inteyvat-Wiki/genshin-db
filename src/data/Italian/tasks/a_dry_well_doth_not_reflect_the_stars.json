					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Fiuu, questo mi ricorda l'estate. È quasi rinfrescante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "Quindi questa è la porta per l'antico regno di Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "Deve celare molti segreti e tragedie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Bene, apriamo la seconda lettera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Fammi vedere... Sì, è questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "\"Come dice l'antico detto di Sumeru: la conoscenza mnemonica non porta frutti finché non viene irrigata dalle piogge della saggezza. Con questo in mente, in questa terra si verifica un fenomeno noto come il 'Segno di Apaosha'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "È un segno celeste che brucia in risposta a un desiderio troppo ardente per la verità. In tal senso, forse sarebbe più appropriato chiamarlo 'Segno della verità'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "I registri di questo antico regno affermano che a Khaenri'ah ci sono diversi grandi laghi sotterranei, limpidi e calmi come specchi, le cui superfici riflettono le vere stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "Questo perché il 'Segno della verità' creato nell'acqua è in grado di oltrepassare il cielo falso e connettersi con l'universo esterno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "Non ne avevo idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "\"Per osservare le forze gravitazionali e l'influenza dei corpi celesti, bisogna essere in grado di vedere oltre il cielo falso. Soltanto ottenendo questi parametri cosmici si può prevedere il destino di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "Ora, ecco il tuo compito: apri un 'Segno della verità' davanti al portale di Khaenri'ah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "Il resto è un mucchio di informazioni sulla cerimonia che quella vecchia megera ha inventato per evocare questa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Sì, tutte queste traiettorie planetarie e... rune... Paimon non proverà nemmeno a dargli un senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "Allora, che ne dici, Mona? Ci proverai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Beh, odio ammetterlo, ma sembra che i parametri che ha elaborato potrebbero effettivamente funzionare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Francamente, è una prospettiva davvero emozionante... E tornare indietro ora mi costerebbe un'altra notte di alloggio. Quindi... non c'è momento migliore del presente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Emissari delle stelle eterne, viandanti sui piani eclittici ed equatoriali, compagni celesti radiosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Attraversate i sentieri contorti del vuoto cavernoso. Io, Mona Megistus, l'astrologa, invoco il potere di Hydro per riequilibrare la bilancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "Per la saggezza e la verità, che la sete sia placata. Io, Mona Megistus, l'astrologa, vi evoco, o stelle, presentatevi dinanzi a me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "H-Ha funzionato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Aaah! Mostri? Com'è potuto succedere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "Niente da fare. Il Segno della verità è rimasto aperto solo il tempo sufficiente per far passare i mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Accidenti! Non sono riuscita a vedere affatto le vere stelle. Non importa... Me la prenderò con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1000406,
