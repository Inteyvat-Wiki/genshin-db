					}
				]
			},
			"dialogs": [
				{
					"id": 100040601,
					"content": "Fiuu, è fatta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040602,
					"content": "Beh, la vecchia megera ha detto di aprire la terza lettera una volta finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040603,
					"content": "Ma non sono riuscita a farlo funzionare. Quindi... dovrei aprirla comunque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040604,
					"content": "Mmm. Sai, ora Paimon pensa di capire molto meglio la vostra dinamica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040605,
					"content": "Ascolta, non ha detto che dovevi riuscire a completare la cerimonia, quindi puoi aprirla. Andrà tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040606,
					"content": "Ah, immagino tu abbia ragione. In ogni caso, dubito che abbia qualcosa di carino da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040607,
					"content": "\"Se stai leggendo questa lettera, significa che hai tentato di aprire il Segno della verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040608,
					"content": "...Ahahah. Sul serio? Non riesco a credere che tu ci abbia davvero provato!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040609,
					"content": "Cosa c'è da ridere, vecchia megera?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040610,
					"content": "\"Khaenri'ah ospitava diversi laghi di stelle, rendendo il tessuto dello spazio in quell'area relativamente instabile. Di conseguenza, i tentativi di penetrare il firmamento con mezzi non fisici avevano maggiori probabilità di successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040611,
					"content": "In ogni caso, sapevo che questo posto era ben nascosto e non sarebbe stato frequentato da troppe persone. Pertanto, gli eventuali effetti negativi derivanti dalla mancata apertura del Segno della verità sarebbero rimasti di piccola entità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040612,
					"content": "E naturalmente, essendo tu mia studente, ero certa che saresti stata in grado di affrontare le creature abissali che vagano oltre il cielo falso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040613,
					"content": "Anche se non riuscissi a sconfiggerli, sono certa che potresti seminarli. Sei sempre stata veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040614,
					"content": "Ah, collegare l'idromanzia al tipo di saggezza che placa la 'sete'... Davvero, il mio genio non conosce limiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040615,
					"content": "L'applicazione pratica dell'astrolabio ha anche ridotto i disturbi causati dal cielo falso. Ah, vorrei proprio vedere Alice fare di meglio!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040616,
					"content": "Mona s'interrompe. A quanto pare, la vecchia megera continua a vantarsi per altre migliaia di parole.\\n\\nDopo aver esaminato i risultati delle osservazioni, tornate a Mondstadt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
