			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! Abbiamo una cosa per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Oh, {NICKNAME} e Paimon! Oggi siete {F#piene}{M#pieni} di energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Dicevate che avete qualcosa per me? Per caso... è un modo facile e veloce per guadagnare Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Beh, in realtà è una specie di \"compito\" da parte della tua maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Eh no, assolutamente no! Uhm, ma immagino di non avere scelta... Lo spirito d'iniziativa è importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "So già che sarà una tortura. Conosco fin troppo bene quella vecchia megera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Perché non dai prima un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Oh, questo libro... non mi sembra poi così speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Woah! Sono cadute delle lettere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Ah! Forse sta cercando di... riconciliarsi con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Non ne ho idea. In ogni caso, sembra che io debba aprire queste tre lettere in ordine. Beh, cominciamo dalla prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Se questo è il suo \"compito\", non credo sia un problema se le leggete anche voi. Dai, vediamo di cosa si tratta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "\"Ah, quanto tempo è passato, mia studente. Temo di doverti riferire che alzarmi e muovermi sta diventando sempre più difficile in questi giorni...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Eh, sta facendo leva sulla compassione. Avrebbe potuto almeno cercare di sembrare un po' più sincera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "\"Ti ricordi quando ti inseguivo e tu scappavi a gambe levate, cercando di utilizzare quel fantasma di Hydro per distrarmi? Ah, sembra ieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "Ora tu te ne vai per conto tuo, e io me ne sto tutto il giorno a oziare sulla mia sedia a dondolo. Dovrei davvero ricominciare a fare un po' di esercizio...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Beh, allora trovati un altro modo per farlo, vecchia megera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Ehm, ripensandoci, sembra una cosa piuttosto privata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "\"Ora, sono sicura che sei curiosa di sapere lo scopo di questa lettera. E a questo proposito, ti dico questo... Se vuoi imparare a predire il destino di un intero regno, o addirittura del mondo intero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "Recati a Sumeru e cerca la porta per un regno sotterraneo. Una volta lì, apri la seconda lettera.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Mah, sa di certo come attirare le persone. Sarà seria riguardo al tramandare la sua tecnica segreta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Immagino che stia davvero invecchiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "Tra voi due c'è una dinamica davvero strana. Quando parlate di cose sentimentali... litigate. Ma quando si tratta di argomenti accademici, diventate tutte emotive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Comunque sia, a Paimon questa \"porta per un regno sotterraneo\" suona familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Aspetta, ne avete già sentito parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Sì. Dev'essere proprio quella a cui stiamo pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Perfetto! Non ho nemmeno bisogno di indagare, allora! Questo significa niente guida da assumere, niente alloggio da prenotare, niente Mora da spendere a destra e a manca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "Forza, non c'è tempo da perdere. Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "E, dato che poco fa non hai menzionato i costi di trasporto, Paimon immagina che questo significhi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Esatto! Faremo come al solito! Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
