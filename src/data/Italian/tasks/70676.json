				]
			},
			"dialogs": [
				{
					"id": 706760101,
					"content": "Eh? Che ci fa un posto del genere in una biblioteca? Che sia la sezione riservata di cui parlava Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Mmm, in realtà Paimon non crede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "Non penserai che questo posto nasconda qualche terribile segreto, vero? Come quelle stanze di cui si parla sempre nelle storie spaventose? Quelle dove di solito è vietato entrare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "In quel caso sarebbe stato sicuramente chiuso a chiave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "#Non hai tutti i torti... Siamo {F#entrate}{M#entrati} senza difficoltà, e la serratura non sembrava rotta o manomessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "#Un attimo! Questa non è la porta da cui siamo {F#entrate}{M#entrati}! Siamo davvero ancora nella biblioteca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "Siamo sotto il Lago Sicerae, forse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "Dici? Wow. Aver costruito una struttura del genere sotto il lago è davvero incredibile... Incredibile? No, è ridicolo! Non è possibile che sia vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Uhm... Peccato che Lisa non sia in servizio oggi, avremmo potuto chiederlo a lei... Beh, ormai siamo qui, e questo posto non sembra essere pericoloso. Perché non diamo un'occhiata in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "I posti nuovi sono fatti per essere esplorati, dopotutto! Bisogna provare di tutto e fare esperienza per diventare una brava guida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "Ooh, guarda, un lupo peluche! Che carino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "È morbidissimo e sofficissimo! Chissà chi l'ha lasciato qui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "Per quanto ne sappiamo, quel giocattolo potrebbe essere il vero padrone di questa stanza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "#\"Auuu! {F#Stupida viaggiatrice}{M#Stupido viaggiatore}! Osi entrare in questa fortezza senza invito? Preparati a essere {F#mangiata viva}{M#mangiato vivo}!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "...Meglio lasciarlo qui, per ora. Questo posto è enorme, continuiamo a esplorarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "O magari è il guardiano di questa stanza misteriosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "Che razza di guardiano si appisolerebbe così sulla poltrona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "\"*russa* Se non vedi dei pericoli, allora non ce n'è... *russa*\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Forse abbiamo raggiunto un altro mondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "E che mondo sarebbe, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}