			"dialogs": [
				{
					"id": 760850601,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850602,
					"content": "È deliziosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850603,
					"content": "Questa è la mia preferita finora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850604,
					"content": "Wow! Finalmente, una bevanda che piace a Colombina! Paimon è al settimo cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Ehm... Mi dispiace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850606,
					"content": "Per riassumere: niente sapori amari percepibili, non aggiungere mai succo di frutta direttamente, e il latte va bene ma è meglio senza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850608,
					"content": "Quindi questa è una bevanda \"più leggera\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Capire cosa funziona è un bene! In futuro, sapremo come preparare le bevande proprio come piacciono a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "...In futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850611,
					"content": "#Certo, siamo {F#amiche}{M#amici}, dopotutto! Quando hai sete, faccelo sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Aspetta, è per questo che non finisci la tua bevanda? Non la starai mica conservando perché pensi che questo sarà il tuo ultimo bicchiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850614,
					"content": "Va tutto bene, non preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760850616,
					"content": "Grazie per il regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
