				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "#Ah, finalmente... {F#Eroina straniera}{M#Eroe straniero}, se non fosse stato per il tuo aiuto, saremmo stati da tempo sopraffatti dal nemico oscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				},
				{
					"id": 750761202,
					"content": "...Molto tempo fa, gli abitanti della tribù furono stregati, incantati dal nostro nemico e molte Anime della Notte si lasciarono intrappolare dall'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				},
				{
					"id": 750761203,
					"content": "Nel luogo del sigillo, persino il potere della manifestazione della Notte si sta lentamente dissolvendo... Questo sigillo ha spezzato tutti i legami con il mondo esterno, certo, ma con essi la fonte della fede della tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				},
				{
					"id": 750761204,
					"content": "Dev'essere spezzato se vogliamo avere anche la minima opportunità di combattere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				},
				{
					"id": 750761205,
					"content": "#Grazie, {F#eroina straniera}{M#eroe straniero}... Le Anime della Notte possono ritrovare la via verso la dimora dei sogni, evitando la piaga che affligge il regno della Signora della Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				},
				{
					"id": 750761206,
					"content": "Ah, finalmente, poter tornare alla quiete della Notte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manifestazione della Wayob indebolita"
				}
			]
		}
	]
}