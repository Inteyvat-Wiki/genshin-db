			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "La nebbia sul mare si è fatta più fitta. È preoccupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "E se quella leggenda fosse vera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Quale leggenda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "#Ehm... Dipende da quale leggenda vuoi sentire, {F#eroina straniera}{M#eroe straniero}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "Sono state date due spiegazioni per quell'isola fluttuante e l'enorme graffito: la prima è più una fiaba, la seconda una vera leggenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "Quale ti piacerebbe sentire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "Sentiamo la fiaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Mmh, le favole hanno sempre un tocco romantico... L'origine del graffito sull'isola fluttuante avvolta dalla nebbia fa parte de \"La storia di Qoyllor e Ukuku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "Si dice che una ragazza chiamata Qoyllor abbia lasciato un enorme graffito sulla spiaggia per contattare suo padre, il Sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Suo padre, il Sole, vide il graffito dal cielo e la portò via dalla terra... La fiaba dice più o meno così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "Si dice che la nebbia inquietante fosse una punizione che il Sole aveva scagliato contro il popolo della superficie, poiché questi avevano rubato i poteri di sua figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "*sospira* Che sia una leggenda o una fiaba, la nebbia non è mai stata un buon segno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "#{F#Eroina straniera}{M#Eroe straniero}... Quel posto probabilmente è pieno di pericoli, quindi fai attenzione a non avvicinarti troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "A proposito della vera leggenda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Sì, ecco... Si dice che, tanto tempo fa, uno stregone malvagio si camuffò da Wayob e stregò tutti gli eroi della tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "In seguito, gli eroi della tribù dovettero sigillare il malvagio stregone oscuro in quel graffito gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "Per quanto riguarda il motivo per cui la superficie del mare appare così... Dicono che sia il presagio del giorno in cui lo stregone malvagio si libererà dal sigillo, distruggendolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
