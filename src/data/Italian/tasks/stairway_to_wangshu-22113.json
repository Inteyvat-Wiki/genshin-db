			"dialogs": [
				{
					"id": 221130301,
					"content": "Hai portato le assi di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130302,
					"content": "Eccole qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Perfetto, finalmente! Questi mostri continuano a causare disastri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "Dovrebbero decisamente bastarmi. Grazie mille, inizio subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2211305,
			"completionStepIds": [
				2211305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
