			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Sinceramente, da queste parti il lavoro non finisce mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Stai ancora riparando le scale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "#Ah, sei arrivat{M#o}{F#a} al momento giusto! Grazie ancora per la volta scorsa, ma... ci risiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Questo buco è un po' più grosso e non ho abbastanza assi di legno. Ho chiesto a uno dei facchini di comprarne altre, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "È stato attaccato dai mostri sulla via del ritorno. Per la paura è fuggito via, abbandonando le assi di legno lungo la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Era terrorizzato, ma sono riuscito a farmi dire dove si trovano le assi di legno. Ma non vuole saperne di tornare indietro a riprenderle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Ho pensato e ripensato a una possibile soluzione, ma credo che solo tu possa aiutarmi. Recupereresti le assi di legno per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Perfetto. Ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "È un buco enorme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Che sguardo terrorizzato... Non penserai l'abbia fatta un mostro, vero? No, in quel caso si sarebbe trattato di un titano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Stavolta è andata così... Due ospiti sono giunti alla locanda, uno dopo l'altro. Non sembravano in buoni rapporti, perché il primo stava inseguendo il secondo che cercava di sfuggirgli... Per fortuna, però, non si sono incrociati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Ma in seguito... Entrambi hanno deciso di trascorrere la notte qui e, mentre salivano le scale, si sono visti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "In quell'esatto momento, hanno iniziato a volare ceffoni... e mentre se le davano di santa ragione, hanno rotto le scale. Ci ho messo una vita a separarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Ero furente, tanto che ho fatto pagare a entrambi tre notti extra di soggiorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Ma basta con le chiacchiere! Aiutami a recuperare le assi di legno, così potrò riparare questo disastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Se mai succedesse ancora qualcosa di simile, non penso che chiederei loro i soldi... Li costringerei a riparare tutto di persona, invece. E subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
