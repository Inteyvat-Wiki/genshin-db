			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Tutto cambia, prima o poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140102,
					"content": "Salve, come va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Mmm... Siete qui per ammirare i fiori, beata gioventù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140104,
					"content": "Che peccato: questi Splendigigli sono quasi avvizziti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140107,
					"content": "Cosa gli è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Ai miei tempi, si diceva che gli Splendigigli potessero percepire i sentimenti delle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140109,
					"content": "Sarebbero fioriti magnificamente grazie ai suoni più belli, come canti e risate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140110,
					"content": "Maldicenze e calunnie, invece, ne avrebbero causato un rapido avvizzimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140111,
					"content": "Quindi significa che questi fiori sentono cosa accade qui a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "È così. Le voci sulla morte di Rex Lapis non sono cosa da poco. Circolano ovunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140113,
					"content": "Alcuni dicono che sia stato un complotto dei Fatui, altri che siano state le Sette Stelle. Altri ancora, pensano che l'Entità delle profondità stia spezzando le sue catene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140114,
					"content": "Questo porto è come una montagna di legname: una scintilla... e il fuoco brucerà ogni cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140115,
					"content": "Comunque... meglio che non dica altro. Ormai sono anziana e un po' brontolona. Volevate dirmi qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140116,
					"content": "Vorremmo prendere in prestito la Campanella purificatrice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ah, quel vecchio ninnolo... Dovrei averla da qualche parte, ma sono invecchiata e non riesco a ricordarmi esattamente dove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140118,
					"content": "La indossava un mio caro amico, quand'ero giovane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140119,
					"content": "Si accorse che la guardavo spesso e allora me la donò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140120,
					"content": "Tuttavia, mi raccomandò di cederla senza averne a male qualora qualcuno me l'avesse chiesta in prestito, un giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140127,
					"content": "Sono passati tanti anni e chissà quante volte, da allora, mi è stata richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140128,
					"content": "Tuttavia, non ricordo quando tutto è cominciato. È passato tanto tempo dall'ultima volta che l'ho ceduta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140129,
					"content": "Ah, queste vecchie ossa sono lente a cercare. Dubito che possiate aspettare tanto a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140130,
					"content": "Possiamo cercarla noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Esatto, nonnina. Possiamo venire a casa con te e poi la cerchiamo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "E poi.. ehm, possiamo aiutarti con qualche faccenda domestica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Non avete motivo di preoccuparvi, beata gioventù. La campanella non dovrebbe essere molto lontana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140136,
					"content": "Eh? Vivi qui vicino, nonnina? Wow, questo è il Belvedere di Yujing, un posto carissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Ahah, un'anziana signora come me non può permettersi di comprare una casa in questa città. Vedete questa teiera di ceramica? Contiene tutti i miei averi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140138,
					"content": "Come può essere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "Le chiavi di casa sono lì dentro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Ohohoh, beata gioventù. Intendevo solo dire che la campanella è dentro la teiera e ve la presto volentieri... se riuscite a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140140,
					"content": "La campanella è tutto quello che hai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Ehi! Che maniere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "E anche se così fosse, dev'essere un oggetto molto costoso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Fila dentro, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Cosa!?! Come può Paimon entrare là dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "E poi perché Paimon dovrebbe entrarci? Non puoi semplicemente aprire il coperchio e dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "Recupero beni perduti per conto dei Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "Un po' strano come motivo d'orgoglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Vorremo prendere in prestito qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "In prestito? Ah, siete qui per prendere la Campanella purificatrice, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140123,
					"content": "A parte quella, non ho nulla di valore che possa interessare a persone della vostra età.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140124,
					"content": "Tuttavia, originariamente apparteneva a qualcun'altro. La indossava un mio caro amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140125,
					"content": "Quand'ero giovane ero bella e vanitosa, e continuavo a tormentarlo per quella campanella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140126,
					"content": "Non riuscì a farmi desistere, quindi me la diede. Tuttavia, mi raccomandò anche di cederla senza averne a male qualora qualcuno me l'avesse chiesta in prestito, un giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140105,
					"content": "Tutto ok?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Non è niente, non è niente. Stavo solo pensando quanto sia un peccato che così tanti Splendigigli siano avvizziti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "Non avevate fretta di trovare la campanella? Forza, al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140202,
					"content": "Fate attenzione, però: non sbrigo le pulizie da tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140203,
					"content": "Se doveste sporcare i vostri bei vestiti, sarebbe dura pulirli come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Ohoh, tutto fatto in un baleno. Beata gioventù... Che velocità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140302,
					"content": "Nonna, sei un'Adepta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Un'Adepta... Non sentivo pronunciare questa parola con tanta coscienza da molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140304,
					"content": "Che io la sia o meno, beata gioventù, non lo avete già capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140312,
					"content": "Ehm... Paimon capisce più o meno cosa intendi, ma è anche un po' confusa. Ci stai davvero dando la campanella, nonnina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Non credi che sia tutto un po' strano? Succede qualcosa a Rex Lapis e noi ci precipitiamo a chiederla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Oh, non diciamo sciocchezze. Il Porto di Liyue ha passato momenti difficili in passato. In quei tempi, tanti Adepti ci hanno lasciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140315,
					"content": "Nonostante tutto, abbiamo sempre dato la priorità al Rito dell'ascensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140316,
					"content": "\"Trovate l'assassino\" urlato a squarciagola, tralasciando però il Rito dell'ascensione... Ecco, per me, è tutto sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140317,
					"content": "Dato che siete qui per chiedere in prestito la campanella, immagino che una persona a me cara abbia finalmente deciso di risolvere la questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140318,
					"content": "Perché dunque dovrei rifiutarmi di prestarvi la campanella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140319,
					"content": "E se poi questa persona non dovesse restituirla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Oh, beh... Se dovesse arrivare a tanto... Ahah, un'anziana signora busserà senz'altro alla sua porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140321,
					"content": "Non ci siamo visti per tanto tempo. Sarebbe bello bere qualcosa e chiacchierare insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140326,
					"content": "Bene, immagino abbiate altre cose da fare. Ora che avete la campanella, potete avviarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140327,
					"content": "Ah, dite alla persona che vi ha mandato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140328,
					"content": "...che se ha del tempo libero, può venire qui per un po' di tè. Non ho molto da offrire, ma alle signore anziane non manca mai una teiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140329,
					"content": "Lo faremo! Grazie, nonnina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Posso tenerla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Ehi! È della nonnina! Le cose prese in prestito si ridanno sempre indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Lasciarla a te? Ahah, apprezzo la tua schiettezza. Se lo desideri, puoi tenerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140325,
					"content": "Tuttavia, alla campanella potrebbe venire nostalgia di casa. Chissà, magari troverà il modo di tornare nelle mie vecchie mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140305,
					"content": "Sei una delle Sette Stelle di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Le Sette Stelle... Quelle anime hanno smesso di dare consiglio a me e ai miei amici tanto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140307,
					"content": "Tuttavia, hanno fatto un buon lavoro di recente. Noi anziani amiamo oziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140308,
					"content": "Fai parte dei Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "#I Fatui? Ah! Cosa ti passa per la testa, figliol{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140310,
					"content": "Sono troppo anziana per cavillare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140311,
					"content": "Tuttavia, qualora esagerassero, farei il mio dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101404,
			"completionStepIds": [
				101407
			],
