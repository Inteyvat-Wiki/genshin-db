				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "È veramente la Campanella purificatrice. Mmm, è in buone condizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Mettiamo dentro il profumo che abbiamo preparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Conosci Madame Ping?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Certamente. Altrimenti come avrei fatto a sapere che aveva lei la campanella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Qui c'è sotto qualcosa! Ma se non vuoi parlarne, non ci impicceremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Ah, sì! La nonnina chi ha chiesto di dirti una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "\"Se hai del tempo libero, puoi andare da lei per un tè. Non ha tanto da offrire, ma a un'anziana signora non manca mai una teiera.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Ahah, quel tono non ti si addice, però è vero che la sua teiera è fantastica. La migliore per preparare il tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Quando arriverà il momento giusto, andrò a trovarla portando con me del buon tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Allora, qual è il nostro prossimo passo per i preparativi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Mmm... Ora dobbiamo acquistare degli <color=#00E1FFFF>aquiloni</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Oooh! Paimon adora gli aquiloni! Ci porti a farli volare un po'? Siamo in pausa dal lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Ahah, no, no. Gli aquiloni sono giocattoli per bambini, è vero, ma hanno anche importanti ruoli simbolici nei riti di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Più tardi vi spiegherò, ma come prima cosa sarebbe meglio andare a comprare gli aquiloni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Oh, certo... Ora sono ancora più curiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Sei anche tu un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Un Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
