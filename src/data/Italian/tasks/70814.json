			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "#S-Sei {M#un }{F#un'}avventurier{M#e}{F#a}? Sei qui per ricevere un incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Ehm, per favore... Aspetta un attimo, fammi vedere cosa posso offrirti... \"Planata rapida\", \"Guida per la sopravvivenza nella natura selvaggia\", \"Cercasi istruttore di arrampicata libera\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Non sembrano incarichi della Gilda degli avventurieri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Lo so, e lo dice anche Lan, ma tutte le avventure che ho letto nei libri erano cose di questo tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Se non assegno questi incarichi, quali dovrei assegnare allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Qualcosa come \"dagliene due ai mostri\", magari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "M-Ma non è pericoloso? Cioè, ce ne sono molti in giro per Lisha e sono un pericolo per chi dovesse avvicinarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "La gente comune, però, non ha nessuna possibilità di batterli, anzi potrebbe essere pericoloso per loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Allora lascia che ci pensi io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Ne sei davvero capace? Va bene, allora. L'incarico è tutto tuo. Torno subito da Lan per discutere un compenso adeguato per il tuo servizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Gli avventurieri sono tutto fuorché comuni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Ah, davvero? M-Molto bene, allora. Ti affido l'incarico. Andrò a discutere il tuo compenso con Lan più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
