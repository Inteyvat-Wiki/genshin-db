			},
			"dialogs": [
				{
					"id": 708140401,
					"content": "Ma tutti gli avventurieri fanno cose così pericolose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140402,
					"content": "E se venissero feriti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081405,
			"completionStepIds": [
				7081403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
