				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140701,
					"content": "Hai già svolto i tuoi incarichi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "Puoi scommetterci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Wow... Allora gli avventurieri sono davvero forti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Bene, ehm... Se non ti dispiace, potresti rispondere ad alcune domande sugli avventurieri e i loro incarichi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "Quali altri incarichi accettano gli avventurieri, oltre a sconfiggere i mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "Aiutiamo anche le persone a riparare i loro carri e le loro case.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Wow, vuoi dirmi che gli avventurieri fanno praticamente di tutto? Non lo sapevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Grazie! Ne terrò senz'altro conto. Ah sì, giusto. Ecco il tuo compenso, prego. È tutto quello che possiamo permetterci, sappilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "La prossima volta che verrai a richiedere nuovi incarichi, farò in modo di offrirti i migliori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "Aiutiamo le persone a raccogliere fiori e a pescare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "Portiamo cibo da asporto e giochiamo con i bambini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
	]
}