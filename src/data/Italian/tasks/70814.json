			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "#Eh? Sei già tornat{M#o}{F#a}? Hai completato l'incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Sì, e sì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Davvero... notevole. Sono tornata alla Gilda per riorganizzare i nostri incarichi a seguito di quello che ti ho affidato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Ne ho trovati una montagna riguardanti mostri da sconfiggere. Quindi, gli avventurieri si occupano regolarmente di questo genere di cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "Oltre ai mostri, abbiamo ricevuto anche segnalazioni riguardanti alcuni Cacciatori di tesori che sono stati avvistati lungo le strade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Davvero la Gilda degli avventurieri si occupa anche di queste cose? Sembra più un lavoro per i Milleliti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Sì, possiamo occuparcene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Oh, allora gli avventurieri sanno fare di tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "#Molto bene, mi assicurerò che tu sia ricompensat{M#o}{F#a} adeguatamente. Accetta anche questo incarico, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Cosa? Già un altro incarico? Ma il compenso non è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "Riceverai un compenso aggiuntivo! Ne ho già parlato con Lan: quindi, se porterai a termine anche il prossimo incarico, riceverai un ulteriore compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Così va molto meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Conto su di te, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Due incarichi già affidati. Bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "La tecnica segreta per fare accettare volentieri gli incarichi che Lan mi ha insegnato funziona davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Se il compenso è adeguato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Gli avventurieri sono proprio fenomenali... Pare che sappiano fare praticamente tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
