			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "Hai altre domande?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Hai ritrovato la tua spada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "Oh, te lo ricordi ancora. Purtroppo no, non ho neppure la minima idea di dove possa essere finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Sono di nuovo al punto di partenza, in attesa di nuovi sviluppi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Se ci saranno delle novità, magari verrò a cercarti. In quel caso, sappi che conterò sul tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081401",
							"2"
						],
						"stepId": 7081401,
