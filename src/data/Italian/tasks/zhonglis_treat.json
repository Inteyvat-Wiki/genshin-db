			"dialogs": [
				{
					"id": 10160301,
					"content": "Ningguang... Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Mi chiedo in che direzione navighino, in mezzo a queste correnti oscure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
