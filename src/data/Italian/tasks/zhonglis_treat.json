			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, eccoti qua. Non c'è bisogno di ordinare, ci ho già pensato io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "La taverna Le Tre ciotole non è come quelle di Mondstadt. Qui si fa sul serio e il padrone non accetta ordini poco convenzionali, come un succo di frutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Quindi posso ordinare del vino questa volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Ho ordinato delle polpette di riso al vino fermentato. Direi che contano come vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "#Me lo sarei dovut{M#o}{F#a} aspettare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "Se vi fa piacere, gentile clientela, proseguirò con la storia della Dimora di giada di Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160107,
					"content": "Ehi, ma c'è anche un cantastorie! Che bell'atmosfera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Al di là del vino, questo posto è davvero molto amato proprio per la sua meravigliosa atmosfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Quando parlo di atmosfera, mi riferisco a qualcosa di diverso rispetto ai criteri utilizzati dalla Guida di viaggio di Teyvat per valutare altri esercizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Come tutti voi sapete, nel cielo che sovrasta la terra di Liyue si erge, tra le nuvole, un palazzo avvolto dalla nebbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160111,
					"content": "Cosa significa avere occhi in ogni dove? È trovarsi su un ponte tra terra e cielo. E tale è il capolavoro di Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160112,
					"content": "Immaginate di essere lassù, il cielo è sereno e dal ponte osservate il mondo sottostante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160113,
					"content": "Ammirate la gloriosa vista del Porto di Liyue, che si estende in lungo e in largo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160201,
					"content": "Questi non sono che pezzi di carta, eppure guidano la mano di Lady Ningguang. Tale è il loro valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160202,
					"content": "Afferrarne anche solo uno o due vi donerebbe un frammento della sua saggezza, abbastanza da distinguervi dai vostri pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian Lingua di ferro"
				},
				{
					"id": 10160203,
					"content": "La Tianquan, Ningguang... lo stiamo sentendo spesso questo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "La gente di Liyue ne parla, i Fatui la detestano, probabilmente è lei che ha nascosto l'Exuvia, e l'abbiamo vista anche al Rito della discensione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Uh, Paimon si chiede che tipo di persona sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Finalmente vi ho trovato, voi che siete di ritorno dai Monti di Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Chi è là?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, dobbiamo andare...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Aspettate! Non faccio parte dei Milleliti, né voglio reclamare la vostra taglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Sono invece un'emissaria delle Sette Stelle di Liyue. Mi chiamo Ganyu, lavoro come segretaria al Padiglione Yuehai. Sono venuta qui appositamente per incontrarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Emissaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Beh, in parole povere, sono la segretaria aziendale delle Sette Stelle. Al momento, opero come emissaria speciale di Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Ti ha mandato Ningguang? Stavamo giusto parlando di lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Perdonatemi, voi che siete tornati dai Monti di Jueyun... Il dovere mi chiama e non posso trattarvi come sarebbe doveroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Tuttavia, ho con me una lettera da parte di Lady Ningguang. In qualità di Tianquan, porge un invito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Vorrebbe che la raggiungeste nel suo palazzo in cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Un invito ufficiale...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Lady Ningguang ha detto:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#\"Invita {F#la viaggiatrice}{M#il viaggiatore} alla mia dimora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#\"Desidero incontrarl{F#a}{M#o} di persona.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "\"Insieme, nella Dimora di giada, sbroglieremo uno a uno i fili di queste oscure matasse.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Segretaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
