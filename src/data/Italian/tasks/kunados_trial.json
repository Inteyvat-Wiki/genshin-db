				"objectNames": [
					"Daimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#Io sono Daimon dei Jibashiri. Ero{F#ina}{M#e} di Sangonomiya, riconosco che sei meritevole di affrontare questa sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Grazie al valore, potrai sconfiggere tutti i tuoi nemici, indipendentemente da come ci riuscirai. Sconfiggi tutti gli avversari, libera le fiamme dell'alta Porta, e potrai avanzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Occorre dire, però, che questi nemici sono mere illusioni, create dai Fantasmi del fuoco solare e dai nemici che tu, in cuor tuo, conosci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Nonostante ciò, ti consiglio di fare molta attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Attenderò che tu abbia completato la sfida alla torre dei tre regni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
