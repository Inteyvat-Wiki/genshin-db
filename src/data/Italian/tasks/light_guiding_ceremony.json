					"nextDialogs": [
						3900406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3900406,
					"content": "Per quale motivo Dvalin ha scelto un covo così pieno di rompicapi e sigilli? Come fa a non innervosirsi ogni volta che deve tornare a casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3900407,
					"content": "Non è entrato camminando, ma volando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3900408,
					"content": "...In effetti hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
