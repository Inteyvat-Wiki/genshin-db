			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "Parlami di quell'Adeptus",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Oh? Avete già incontrato Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "Niente male, di solito non è mai dell'umore giusto per le visite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "Quindi prima era di buon umore? Caspiterina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Sì, è difficile parlare con gli Adepti. Alcuni rivolgono loro preghiere per tutta la vita, senza mai riuscire a vederne uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "Quando l'Archon di Geo fondò Liyue, chiese l'aiuto degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Molti di loro, però, proteggono Liyue nel solo modo che conoscono: combattendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Per vari millenni è stata l'umanità a governare Liyue, mentre gli Adepti sono rimasti nascosti a debita distanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Tu sai un sacco di cose, signora capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "Capo e basta va più che bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "Comunque sia, avete il favore degli Adepti: dovrebbe essere tutto più semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Volete la mia opinione? Se l'umore di Xiao non peggiora, per voi andrà tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "Non riesco neanche a immaginare cosa sia il buonumore per il temibile \"Custode Yaksha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Ahah! Sarà interessante scoprirlo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(Ora che ci penso, non l'ho mai visto sorridere...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Facciamo così: chiedete al cuoco una ciotola di tofu di mandorle, poi preparate il piatto che vi riesce meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "Il tofu di mandorle è uno dei pochi cibi mortali che Xiao gradisce. Scegliete voi l'altra pietanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Scegliamo noi, eh...? {NICKNAME}, tu cosa sai cucinare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "Forse... un'Insalata nutriente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "Sarà difficile che riesca male, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Se dobbiamo cucinare per un Adeptus, però, con l'Insalata nutriente andremmo più sul sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Magari un Melmoso di Pyro piccante con Maha Manjusaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "Wow! Mai sentito, ma Paimon vuole provarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
