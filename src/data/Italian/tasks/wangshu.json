			"dialogs": [
				{
					"id": 10030601,
					"content": "Non vedete che sono in pausa? Filate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Perdono. Volevamo solo chiedere un tofu di...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Filate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Ehi, i modi di questo cuoco mi ricordano quelli di Wagner a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Ci manda Goldet, il capo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Capisco. Se è per il capo, immagino di non aver scelta allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030608,
					"content": "È che non riesco a dare il meglio di me, al momento. Un dessert che richiede una precisione simile, poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030609,
					"content": "In che senso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "La mano degli schermidori dev'essere ferma, ma questo vale anche per i cuochi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Le mie invece non... non sono affatto salde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Questo perché... un tempo mi dissero che questa locanda è... infestata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030613,
					"content": "Infatti ora... proprio ora in cucina ho visto qualcosa di... sinistro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(Il cuoco ha un aspetto minaccioso, ma dopo il riferimento ai fantasmi inizia a tremare.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "Penso che... perfino la Locanda Wangshu non sia sicura. I-in questo momento non riesco a preparare il tofu di mandorle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#D'accordo, {NICKNAME}. Diamo un'occhiata a questa cucina. Facciamolo per il tofu di mandorle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
