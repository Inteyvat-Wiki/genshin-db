			"dialogs": [
				{
					"id": 10031001,
					"content": "Eheh... Terrorizzato da una sciocchezza simile. E dire che un tempo era un temuto bandito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031002
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031002,
					"content": "Non sembri molto spaventata dai fantasmi, signora capo.",
