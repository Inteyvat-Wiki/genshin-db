					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "Gli Adepti non scappano dalle loro responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031714
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031714,
					"content": "Preferisco non immischiarmi nei problemi dei mortali per motivi... personali, ma non verrò meno alle mie responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031715
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031715,
					"content": "In fondo, stiamo parlando del Dio dei Contratti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031716
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031716,
					"content": "Un attimo, Paimon ha un'ultima domanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031717,
					"content": "Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031718
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031718,
					"content": "La Piccola Ming. Lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031719,
					"content": "Combattendo i demoni, a volte, ci s'imbatte in spiriti che non hanno mai fatto del male a nessuno, eppure... rimangono ancorati qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031720
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031720,
					"content": "Per questo ho chiesto al locandiere e al capo se fosse possibile \"ospitarla\" per un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031721
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031721,
					"content": "Quindi alla fine la Locanda Wangshu la stava proteggendo! Amano diversificare gli affari, eh?",
