			"dialogs": [
				{
					"id": 10039301,
					"content": "Parlami di tuo marito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "Eccolo lì. È il locandiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039303,
					"content": "Non farti ingannare da quel sorriso sfrontato. È un marzialista di un certo livello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039304,
					"content": "Pratico anche io le arti marziali, e lo stesso vale per lo staff in cucina: è uno dei criteri d'assunzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039305,
					"content": "Ci vogliono piedi e mani in grado di muoversi agilmente per servire gli ospiti, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
