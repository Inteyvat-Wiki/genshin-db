					"nextDialogs": [
						10031003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031003,
					"content": "Divinità, fantasmi... In vita mia, ho visto di tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031004
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031004,
					"content": "In effetti nessuno sembra sapere che un Adeptus risiede in questa locanda, tranne la signora capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031005,
					"content": "Shh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031006
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031006,
					"content": "Non raccontare ai quattro venti il mio segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031007,
					"content": "A ogni modo, prima di andare, perché non vi assicurate che quel fantasmino non dia fastidio ad altre persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031008,
					"content": "Non prendetelo come un ordine, eh? Solo che, come ha detto l'Adeptus, le anime dei mortali non sono molto tenaci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031009
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031009,
					"content": "Per non farvi troppo male quando avrete a che fare con gli Adepti, fareste meglio a esercitarvi con lo spettro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031010,
						10031012
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031010,
					"content": "Buona idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031011
					]
				},
				{
					"id": 10031011,
					"content": "Come facciamo a convincerlo, però?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031013,
					"content": "Il dipinto calligrafico nella locanda è chiamato Sigillo del testimone, ed esiste da oltre mille anni. Dategli un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031014
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031014,
					"content": "Fatto ciò, cercate un luogo all'esterno in cui sia riprodotta la stessa forma del Sigillo del testimone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031012,
