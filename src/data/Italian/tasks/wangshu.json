						10039402
					]
				},
				{
					"id": 10039402,
					"content": "Mi chiamo Goldet, sono di Mondstadt. La Locanda Wangshu è mia, sono il capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039403,
					"content": "Prima che pensiate che sia la moglie del capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039404,
					"content": "Sono io IL CAPO.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039405,
					"content": "Ho sentito delle voci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Ahahah! Beh, non sarebbe semplice gestire una locanda in questo posto senza qualche legame con le Sette Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039407,
					"content": "Intendo dire che mi serve il loro benestare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039408,
					"content": "Ma tutto il resto sono semplicemente chiacchiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039409,
					"content": "A proposito... Avete qualche notizia interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039410,
					"content": "Di chi è questo micio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "*sospira* Di nessuno, si è autoinvitato... Ma è carino e ho deciso di non cacciarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039412,
					"content": "L'abbiamo chiamato Wei, il primo nome che ci è venuto in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039413,
					"content": "Noterete che Wei combina qualche guaio ogni tanto, come tutti i gatti del resto. Vi pregherei di non imitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
