					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1731.516,
							309.11,
							-1602.524
						],
						"pointId": 300100573
					},
					{
						"sceneId": 3,
						"position": [
							1730.843,
							309.134,
							-1602.502
						],
