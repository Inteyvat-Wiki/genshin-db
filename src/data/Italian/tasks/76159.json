						],
						"pointId": 300100577
					}
				]
			},
			"dialogs": [
				{
					"id": 761590201,
					"content": "In un batter d'occhio, vi ritrovate sul bordo d'una rupe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590202
					]
				},
				{
					"id": 761590202,
					"content": "#Bene, siamo {F#arrivate}{M#arrivati}. Questo piedistallo dei Seelie gode di una vista fantastica, non trovate? Vedete quel luogo laggiù? È il punto di partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590203,
						761590204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590203,
					"content": "...Piedistallo dei Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				},
				{
					"id": 761590205,
					"content": "Per arrivare qui più velocemente, dici? Certo, ovvio! I piedistalli dei Seelie sono collegati alle linee geomantiche, e nessuno li usa davvero. Sono molto comodi quando si tratta di spostarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590206,
					"content": "Inoltre, io e i Seelie un tempo eravamo angeli, quindi siamo vecchi colleghi. Sono sicura che non avranno nulla in contrario se di tanto in tanto prendo in prestito le loro dimore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590207,
					"content": "Non sembra esserci nessun altro in giro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590208
					]
				},
				{
					"id": 761590208,
					"content": "Siamo in anticipo. Tra poco, un bardo verrà a cantare le odi del passato e a richiamare i mille venti che vagano tra le epoche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590209,
					"content": "Non è che questi compiti sono per...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590210
					]
				},
				{
					"id": 761590210,
					"content": "Shhh... Porta pazienza. Tutto sarà rivelato a tempo debito. Presto diventerai una dolce melodia incastonata in un'ode, e i mille venti vorticheranno attorno a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590211,
					"content": "Ma, prima che ciò accada, dovremo lasciarla dormire in pace... Andiamo, dirigiamoci verso la prossima destinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590212,
						761590213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590212,
					"content": "Ehi, ma non è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590214,
					"content": "Sì, l'ho letto nel Dizionario. A giudicare da come è andata a finire, tu e il Supremo Barbatos dovete aver suonato una melodia davvero splendida. Peccato che Barbie non sia riuscita a sentirne neanche una nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590215,
					"content": "Quando Alice l'ha saputo, ha riso così tanto che l'è quasi caduto il cappello dalla testa. Ahem! Che ne dite di raggiungere la prossima destinazione? Che dovrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590213,
					"content": "Io e Venti una volta abbiamo eseguito un duetto su quell'isola laggiù.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590204,
					"content": "L'hai usato per...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				}
			]
		},
