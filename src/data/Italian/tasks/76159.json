					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "Te ne vai di già? Ehi, Barbie! Non ti stai dimenticando qualcosa? Tipo un sacco di roba che dovevi dare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "...a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "È un brutto momento...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "#Sciocchezze, il vostro arrivo è più o meno in linea con la profezia di Barbie... Anche se, a dire il vero, pensavo che sareste {F#arrivate}{M#arrivati} un po' più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "A ogni modo... Prima di venire al dunque, forse sarebbe meglio se voi due... mangiaste qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "L-La profezia di Barbeloth diceva che avremmo avuto fame?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "No, certo che no! Ma il mio udito è piuttosto fine, e ho sentito lo stomaco di Paimon brontolare a un chilometro di distanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*gorgoglio*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#Woah! Lo stomaco di Paimon sta brontolando di brutto... Dobbiamo essere {F#entrambe}{M#entrambi} super {F#affamate}{M#affamati}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "Come potevo sapere che quel posto avrebbe finito le bistecche...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Non preoccuparti! Ho biscotti e torte in abbondanza... E, come saprete, non è mai successo niente di male ai viaggiatori affamati che hanno accettato cibo da una \"strega\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Tu e Paimon sgranocchiate felicemente biscotti e torta mentre sorseggiate del tè. Stranamente, non importa quanto mangiate o beviate, la teiera rimane sempre mezza piena, e c'è sempre un biscotto fresco o una fetta di torta sui vostri piatti...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Paimon è pienissima... Per quanto si riempia il pancino, sul suo piatto c'è sempre qualcos'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "Quindi è così che si svolgono i tè delle maghe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Certo! Non si può fare un tè senza un'abbondante scorta di cibo e bevande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Anche se, in effetti, è difficile mostrare un'appropriata grazia \"da maghe\" dopo essersi rimpinzati. Ecco perché la teiera viene sempre riempita solo a metà e su ogni piatto c'è solo un biscotto o un pezzetto di torta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Paimon non riesce a mangiare altro! Sta scoppiando... Possiamo passare al sodo, adesso? *rutta* Ops, scusate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Bene. Immagino siate qui per consegnare i miei \"compiti\"... Quelli profetizzati da Barbie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Lo sapevi fin dall'inizio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Niente del genere. Stavamo discutendo di tutt'altro. Il massiccio spostamento della luna ha mandato in tilt la sua idromanzia, quindi dovrà rientrare per un po' per sottoporsi a un periodo di meditazione silenziosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Durante la sua assenza, mi occuperò io dei compiti di tutte. Ho anche intenzione di aiutarla ad aggiungere la prossima tornata di compiti al Dizionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Eh? Davvero si può cambiare la responsabile così facilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Beh, se c'è qualcuno che può farlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Non che avessi molta scelta! Prima ancora che Barbie e Alice me ne parlassero, avevano già trascritto i miei \"compiti speciali\" nel Dizionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Per quanto mi piacerebbe cancellare tutto e continuare a osservare il mondo con tranquillità, Alice è impegnata a mantenere i confini di Teyvat e Barbie è via per riallineare la sua idromanzia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia non si è nemmeno presa la briga di tornare, e Rhinedottir possiamo anche dimenticarla... Le altre maghe hanno tutte i loro affari da sbrigare, quindi l'incarico di supervisionare i compiti è toccato a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Non sapevo che voi dell'Hexenzirkel foste così impegnate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Ebbene sì. Non so nemmeno quanto tempo sia passato dall'ultimo tè che abbiamo fatto tutte insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "In ogni caso, una volta completati i miei compiti, la mia storia sarà ufficialmente trascritta nel Dizionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Dopodiché, potrò tornare a osservare e guidare... Perciò, {NICKNAME}, Paimon, è il momento che consegniate il vostro messaggio... Quali sono i miei compiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Oh, e questa non conta come profezia... È solo una storiella inventata da Barbie e Alice una decina di minuti fa. Dubito che ci siano informazioni utili nel Dizionario che avete con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Hai ragione, Nicole! Abbiamo dato un'occhiata prima di venire qui, e non ci sono affatto istruzioni dettagliate. Ci sono solo queste due frasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole adempirà al suo dovere.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Va bene. La prima frase è stata chiaramente scritta da Barbie, ma scommetterei i miei ultimi Mora che è stata Alice ad aggiungere la seconda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Comunque, occupiamoci di questi compiti! Vediamo un po', da dove dovremmo cominciare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Aspetta, hai davvero capito cosa vogliono che tu faccia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Eh? Oh, Barbie mi ha appena fatto un resoconto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "In pratica devo solo recarmi in alcuni punti di rilevamento, assicurarmi che tutto sia in ordine e condurre un po' di lavoro sul campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Un momento! Paimon pensava che ti stesse dando una profezia! Come può un \"resoconto\" essere considerato una profezia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Ah, beh, vedete, io considero naturalmente qualsiasi cosa dica Barbie come una sorta di profezia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Inoltre, quando Barbie ha trascritto i miei compiti, tutto ciò che ha fatto è stato saltare direttamente all'ultima pagina della mia storia e rivelarmi il finale in anticipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Ma questo non è uno spoiler gigantesco?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Uhm... Hai ragione, ma in fondo che differenza c'è tra una profezia e uno spoiler? Bene, non indugiamo oltre. Su, seguitemi, andiamo a... Mmh, sì, lì mi sembra perfetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Così, senza preavviso? Aspetta, come dovremmo fare per prendere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "In un batter d'occhio, vi ritrovate sul bordo d'una rupe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "#Quindi sono {F#venuta}{M#venuto} qui per niente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "Che vuoi dire? Questi compiti andavano consegnati da te, è un passaggio molto importante. Certe formalità devono essere rispettate affinché i compiti siano considerati validi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Ma di questo possiamo parlare dopo. Comunque, basta indugiare. Su, seguitemi. Stiamo andando a... Mmh, sì, quel posto mi sembra perfetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Io non ho capito una parola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"Di sicuro non ti permetterà di lavorare gratis!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Tutto qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Ora che lo dici, siete davvero parecchie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "...Quella è Nicole!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Quindi prima Barbeloth stava...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "La prossima volta dovremo portare Varesa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "La campionessa mangiatrice della Comunità dell'Abbondanza di Natlan? Alice me ne ha parlato una volta... Pare sia una giovincella davvero interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Immagino che, se dovesse partecipare a uno dei nostri tè, dovremmo preparare tre... anzi, sette piatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "Abbiamo mangiato tutta quell'insalata, ma era come ingoiare una ciotola d'aria verde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Si può profetizzare anche l'appetito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Forse sarebbe meglio tornare più tardi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
		{
			"id": 7615902,
