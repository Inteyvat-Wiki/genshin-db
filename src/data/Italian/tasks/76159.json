			"dialogs": [
				{
					"id": 761590301,
					"content": "Questo è il Regno dei Lupi? Non mi sembra il posto migliore per fare i \"compiti\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "Questo è il piedistallo dei Seelie più vicino alla nostra destinazione. Non preoccupatevi, il punto di partenza non è lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "#Porca pupazza! Da dove sbucano tutti quei lupi?! Ehi... Non siamo qui per farvi del male! Siamo {F#amiche}{M#amici} di Razor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Branco di lupi"
				},
				{
					"id": 761590305,
					"content": "I lupi sono andati via...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "#Shhh! Quel piccolino non è ancora arrivato? Forse anche stavolta siamo {F#arrivate}{M#arrivati} troppo presto. Non preoccupatevi, finché rimarrà accanto al suo \"Lupical\", potrà superare qualsiasi avversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Branco di lupi"
				},
				{
					"id": 761590309,
					"content": "Perché sono tornati? Ci hanno sentito parlare? Se solo Razor fosse qui, saprebbe spiegarci cosa vogliono dirci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Non hai torto, Paimon, ma avrebbe bisogno di capire molto di più oltre al linguaggio dei lupi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Ehi, ma non è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "Esatto. Quel piccolino ha già ottenuto la vittoria nella battaglia che era destinato a combattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "Finché rimarrà accanto al suo \"Lupical\", potrà superare qualsiasi avversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Branco di lupi"
				},
				{
					"id": 761590316,
					"content": "...Sono sicura che anche il suo Lupical la pensi allo stesso modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Bene! Direi che qui abbiamo finito. Credo sia il momento di riposare un po'. Su, è ora di berci una bella tazza di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Woah! Quand'è comparsa questa porta?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "C'è un biglietto attaccato sopra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "Sembra la calligrafia di Alice. Diamo un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "\"Grazie per esserti occupata dei compiti! Ora corri a casa e goditi una buona tazza di tè caldo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "P.S. C'è una sorpresa che ti aspetta oltre questa porta!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "Correre a casa? Aspetta un attimo, perché questa porta mi sembra così familiare? Non è possibile che conduca a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole spalanca la porta e la attraversa con passo deciso mentre voi la seguite. Un istante dopo, vi ritrovate all'interno di una stanza...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Questo stile... Mi sembra familiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Io e Razor abbiamo combattuto qui insieme, una volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "Non è che questi compiti sono per...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
