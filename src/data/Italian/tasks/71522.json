			"trigger": {
				"objectNames": [
					"Buies"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "Questo tipo di gioco è sicuramente stimolante, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "Quale nuovo gioco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "#Viaggiat{F#rice}{M#ore}! Tempismo perfetto! Si dà il caso che mi serva qualcuno per testare il mio nuovo gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Guarda qui. Lo chiamerò \"Ispirazione eruttiva\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "Cattura perfettamente l'intero processo creativo di noi poeti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "Vuoi dire bere fino a svenire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Ah, sì? Illuminami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Ahahah... che divertente. Anche se in effetti il vino è ottimo per dare sfogo alla creatività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "Però, il vino da solo non basta a ispirare una poesia davvero straordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Prima di scrivere una poesia, dobbiamo cercare l'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Alcuni amano viaggiare, altri preferiscono la solitudine, altri ancora... preferiscono usare il vino per stimolare la creatività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "È la parte più difficile, perché non possiamo sapere dove troveremo l'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "Così la maggior parte del tempo abbiamo la sensazione di non riuscire a trovare la nostra musa... e diventiamo ansiosi e depressi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "In realtà, però, l'ispirazione ha già trovato noi e ha lasciato un segno nella nostra mente, senza che ce ne accorgessimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "Al momento giusto, esploderà e prenderà la forma di una grande poesia... o di un dipinto... o di qualcos'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "E hai deciso di trasformare tutto questo in un gioco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Ahahah! Ovvio! Il processo di creazione della poesia è chiaro e facile da capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "Si dà il caso che a Mondstadt ci siano alcuni inventori di giochi da tavolo interessati alle mie idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "Dopo varie discussioni e alcuni scambi di idee, abbiamo finalmente dato vita a \"Ispirazione eruttiva\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "Se ti interessa puoi provarlo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "#Magari dopo qualche partita potresti diventare anche tu {F#una poetessa}{M#un poeta}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
}