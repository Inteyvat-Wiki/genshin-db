						],
						"stepId": 7326703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "Che ansia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "Buon pomeriggio, Sania! Che cosa compri di bello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Atiyah, quante volte ti devo ripetere che Jabari non vuole unirsi a voi e che io non voglio che diventi un mercenario? Non ti aiuterò a convincerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Che peccato. Jabari è un ottimo cuoco, quindi con noi si troverebbe benissimo. Inoltre, migliorerebbe un sacco il vostro reddito familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "E poi, non diceva di voler cercare un lavoro? In tal caso, chi può consigliarlo meglio di un suo vecchio amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Non dare troppo peso a quello che dice. Il giorno dopo ha già cambiato idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Alla fine, lui non riesce a sopportare l'idea di lasciarmi da sola al villaggio... E io non sopporto l'idea di vederlo sgobbare da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "E, come se non bastasse, gli stai chiedendo di mettere a rischio la sua vita! Anche se volesse diventare un mercenario, glielo impedirei io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Lasciamo perdere. Ho un po' di cose da comprare: tu va' a infastidire qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "#Fiuuu... D'accordo. Vedi, viaggiat{F#rice}{M#ore}? È così il lavoro che svolgo ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Il prossimo sulla lista è Fodil. Un tempo era uno di noi... ma ci ha mollati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Non sarebbe male convincerlo a tornare da noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fodil",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah... Ancora tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Eheh, sai bene che l'ostinazione è una delle nostre virtù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Beh, allora dovresti sapere che tener fede ai princìpi è una delle mie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Suvvia, fratello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Non chiamarmi così. Non faccio più parte del vostro gruppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "D'accordo, Fodil, va bene. Non ci pensi proprio a tornare con noi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "So che alcuni di noi sanno essere un po'... incoscienti, ma in prevalenza siamo cittadini rispettosi della legge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Te l'ho già detto, Atiyah: non ho intenzione di tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "Ho già visto coi miei occhi tutto ciò che dici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Magari è vero che non tutti gli Eremiti si divertono a infrangere la legge o ad accanirsi sui deboli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Ma la cattiveria è contagiosa, Atiyah. Basta una singola persona che pensa che la legge sia arbitraria a influenzare tutti gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Gli individui si condizionano a vicenda, e se i membri di quel gruppo continuano a comportarsi così, finiranno per influenzare sempre più persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Di sicuro sai meglio di me cosa voglia dire, Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "In un ambiente del genere, è facilissimo fare del male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Tu vuoi che io tornassi a far parte degli Eremiti... Mentre io vorrei che tu li lasciassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "È probabile che dal tuo punto di vista gli Eremiti non siano così male, pur non essendo neanche degni di lode... Ma non si può sempre vivere nella zona grigia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "Ti sto solo dando un consiglio. Fanne ciò che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Lo so, capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "D'accordo. Se li lascerai e vorrai cambiare lavoro, ti darò una mano a trovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Beh, ecco... Suppongo che non riuscirò mai ad avere l'ultima parola con Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Ora cosa ci tocca fare? Oh, sì, giusto, riposiamoci un attimo. Devo ammettere che mi si sta seccando la gola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326706",
							"2"
						],
						"stepId": 7326706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Atiyah",
					"Karima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Ehi, zio Atiyah! Stai ancora cercando qualcuno che si unisca agli Eremiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ma guarda un po' chi c'è: Ayten! Hai detto a tua madre che venivi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Certo! Sta lavorando, quindi sono andato a giocare con Karima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Ciao, zio Atiyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Cosa pensi zio Atiyah delle cose che abbiamo discusso la volta scorsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Non ho fatto che allenarmi, e anche Karima si è allenata con me... Sai, ormai non riesce più a battermi nella corsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Quella volta non conta! Non avevo mangiato abbastanza, in quell'occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "...Comunque, ho seguito il programma d'allenamento che mi hai dato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "Quindi fammi riprovare! Vediamo se ora sono abbastanza brava da unirmi agli Eremiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "Ah, ecco cosa intendevi quando hai accennato a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Ehm! D'accordo, Ayten. In qualità di membro degli Eremiti, ti sottoporrò di nuovo al test!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Va bene! Dai, Karima, unisciti anche tu. Facciamolo insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Ma io non voglio unirmi agli Eremiti... Voglio rimanere al villaggio per proteggere tutti gli abitanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Però mi piacerebbe essere messa alla prova da zio Atiyah! Cioè, dopotutto ho già chiesto alla signorina Candace di darmi consigli sull'allenamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Aspetta... Cosa? Quando l'hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Ahahah! Ottimo, questo sì che è lo spirito giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Dai, Ayten, non mettere il broncio. Se capiterà l'occasione ti porterò da Dehya, e potrai chiederle di darti dei consigli. Che te ne pare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Lo faresti davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "Noi Eremiti non mentiamo mai, ragazzina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "#Tuttavia, prima di iniziare la prova, vorrei che quest{F#a}{M#o} viaggiat{F#rice}{M#ore} ci mostrasse gli standard richiesti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "Un attimo, e io che c'entro ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "#...Non ho mai avuto il tempo di dare una dimostrazione. Non posso andare in giro a darne e lasciare qui da soli i bambini... Sarebbe troppo pericoloso. Comunque, grazie dell'aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "#*tossisce* In ogni caso, quest{F#a}{M#o} viaggiat{F#rice}{M#ore} è {F#un'avventuriera}{M#un avventuriere} espertissim{F#a}{M#o}. Ho faticato un sacco per convincerl{F#a}{M#o} a darvi una dimostrazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Prestate molta attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "#{F#Un'avventuriera}{M#Un avventuriere}, eh? Tipo quelli della Gilda degli avventurieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "Che voi facciate i mercenari o le guardie, prima o poi vi ritroverete in situazioni dove la scelta più saggia sarà battere in ritirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "In un caso del genere, il nostro principio è quello di andarcene il più velocemente possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Diamo subito una dimostrazione su... come battere velocemente in ritirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "Partiamo da qui. Procedi pure con la dimostrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Non dai tu le dimostrazioni, di solito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Oh, ma dai, ti sembro uno che ha il tempo di dare dimostrazioni? Devo già lavorare e prendermi cura di questi bambini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "...Qualcuno che vuole unirsi a voi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
			"completionStepIds": [
				7326708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326708",
							"2"
						],
						"stepId": 7326708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Karima",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "Sei... veloce come il vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "#Ottimo! Sei stat{F#a}{M#o} molto veloce e, cosa ancora più importante, davvero costante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "Bambine, guardate e imparate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "Non insistete nell'affrontare tutte le situazioni pericolose in cui vi ritrovate. E, se dovete battere in ritirata, fatelo con fermezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Parlo soprattutto con te, Ayten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Lo so, lo so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Bene. E ora il passo successivo... Un bel combattimento dal vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Oooh, ma è fantastico! Ho con me la spada di legno che mi ha intagliato mio padre. E tu, Karima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Io ho un piccolo arco, anche se mia madre mi ha dato unicamente frecce spuntate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Ahahah! Non c'è problema! Avete una spada, un arco e il vostro infinito coraggio! Per iniziare un'avventura non serve altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "#Ma ricordatevi di non scorrazzare in giro quando siete fuori dal villaggio. Rimanete sempre con me e {F#la}{M#il} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Davvero vuoi portarli fuori dal villaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "Oh, non preoccuparti: ho già perlustrato l'area, e non c'è altro che qualche scorpione malaticcio e senza capacità offensive. Non dovremmo avere problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "E qualunque cosa accada, noi due ci saremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Ma quindi adesso mi stai includendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "Oh, ma dai, già che ci siamo! Sai come si dice, no? \"Abbiamo fatto trenta, facciamo trentuno!\" Mi assicurerò di darti un compenso in linea con le norme della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Bambine, allacciate le cinture di sicurezza! Si parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "Devo ammettere di essere... un po' in tensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Non mi sembra di averti detto che l'avrei fatto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "Stiamo per uscire dal villaggio con due bambini al seguito...",
					"roleType": "TALK_ROLE_PLAYER",
