			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "Unisciti agli Eremiti e adotta un nuovo, meraviglioso stile di vita! Dai, su, avvicinati! Non vuoi saperne di più sugli Eremiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Oh, suvvia, ascolta un po'. Stare con noi è bellissimo: siamo liberi, uniti e socievoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Unendoti a noi, avrai anche la possibilità di spennare quei riccastri che vivono sugli alberi! Non solo i ricercatori dell'Akademiya sono ricchi sfondati, ma sono anche precisissimi nei pagamenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Faccio già parte della Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Oh, fai parte della Gilda degli avventurieri? Beh... Nulla ti impedisce di unirti anche a noi, no? E dai, ormai tutti hanno un secondo lavoretto... Senza contare che mercenari e avventurieri non sono poi così diversi, no? Mi segui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Io penso che siano molto diversi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "Beh, abbiamo anche tanta roba buona da mangiare! Non mancano mai carne né pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "E con un po' di fortuna, potresti persino riuscire a incontrare Dehya Chiomardente! Ora... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Calmati e bevi un sorso d'acqua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "*tossisce* Scusa, ho parlato un po' troppo in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "È da tempo che nessuno mi ascolta, quindi mi sono gasato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "In ogni caso, davvero non vuoi unirti a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Per ora no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Va bene, se la metti così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Sei sempre qui ad arruolare gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Sì. Cioè, alla fine è il mio lavoro. Oggigiorno, qualsiasi campo è a corto di gente capace, e questo è ancor più vero tra noi mercenari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "*sospira* Beh, suppongo di potertelo dire. Di sicuro i membri non ci mancano, ma facciamo un lavoro molto pericoloso. Scortare gente è la parte facile del lavoro... Al massimo, risulta un po' stancante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Ma se invece il lavoro che svolgi ha a che fare con i ricercatori, allora è già tanto se riesci a tornare sulle tue gambe, quando hai finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "La maggior parte, dopo missioni del genere, ha bisogno di prendersi dieci o anche quindici giorni di riposo... Quindi abbiamo sempre bisogno di gente che rimpiazzi quelli che mancano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru è enorme e ospita tantissimi ricercatori, quindi abbiamo nuovi incarichi ogni giorno. In pratica, ormai lavoriamo ventiquattr'ore su ventiquattro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "In altre parole, sì: ci serve una mano extra, o finiremo per crollare dalla mole di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Ma sei riuscito a reclutare qualcuno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Qui, in questo villaggio? Ahah... No. Assolutamente nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Anzi, forse dovrei spiegarmi meglio. Mettiamola così: chi vorrei reclutare non vuole unirsi, ma non posso prendere chi vorrebbe farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "#Se non mi credi, perché non facciamo due passi assieme? Chissà, magari alla fine del giretto ti avrò convint{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "...Scherzo, scherzo. Mi hai già detto di non volerti unire, e non ho intenzione di costringerti a farlo. È solo che... Sai, mi piacerebbe un po' di compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Nessun problema, posso accompagnarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Eheh, grazie mille. Vediamo un po'... Prima di tutto, andiamo a cercare Sania. Di solito, è libera di giorno, mentre la notte... Beh, diciamo che solitamente discute di affari importanti con Jabari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "#Sono già impegnatissim{F#a}{M#o} con la Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Hai imparato il discorsetto a memoria, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "#Sono già oberat{F#a}{M#o} di incarichi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326703",
