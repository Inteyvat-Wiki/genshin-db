				"points": []
			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "Quegli scorpioni sono enormi! D-Dobbiamo proprio avvicinarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Gli ho tirato una freccia, ma non ha sortito alcun effetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "Tu però li hai... sconfitti come se niente fosse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Beh, mi alleno da tantissimi anni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Ma... la signorina Candace mi ha detto che ero migliorata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Non essere triste, Karima. Prima o poi diventerai fortissima... Ma devi impegnarti giorno dopo giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Lo stesso vale per te, Ayten. Continua ad allenarti così, e sarà solo questione di tempo prima che ti unisca a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Uff, se solo riuscissi a convincere Dehya a insegnarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "La prossima volta che vedrò la signorina Candace, le chiederò di insegnarmi di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Ahahah! Questo è lo spirito giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "E alla fin fine, non hai reclutato nessuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "*tossisce* Ehi, non ti hanno mai insegnato a non rigirare il dito nella piaga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Possiamo parlare di lavoro più tardi... E poi, non è che la pubblicità che faccio non abbia mai dato alcun risultato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Dopo avermi ascoltato, un sacco di ragazzi e ragazze del villaggio sono partiti per vedere il mondo esterno... pur non volendo davvero unirsi a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Beh, possiamo parlarne più tardi. Ora devo riportare i bambine al villaggio: sono fuori casa da un po', e i loro genitori staranno iniziando a preoccuparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "#Comunque sia, ecco una cosa per te. Grazie per essere venut{F#a}{M#o} fin qui con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*sospira* Ma come faccio a spiegare agli Eremiti ciò che è successo, al mio ritorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Ehm, zio Atiyah, non ci hai ancora esaminati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Ah, sì? Oh, giusto... Sì. Torniamo al villaggio: vi esaminerò lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "Ma il tuo lavoro, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Voi due siete ancora giovani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				}
			]
