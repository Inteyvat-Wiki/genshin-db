			"dialogs": [
				{
					"id": 740540801,
					"content": "Tira la leva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#Ehi! Cosa stai facendo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Tiri la leva senza la minima esitazione.\\nL'intera torre comincia subito a tremare, causando un potentissimo rimbombo assordante, come se il cielo crollasse e la terra tremasse...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Dopodiché, con un botto, il meccanismo sputa una pila di nastri di carta direttamente nelle tue mani.\\nTutto è di nuovo tranquillo.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Eh...? Tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Uhm... Paimon non ha idea di cosa sia questa roba, ma sembra abbastanza importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, perché non teniamo con noi questo nastro di carta per ora? Chissà, magari più avanti ci tornerà utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
