			"dialogs": [
				{
					"id": 750013301,
					"content": "Che strano... I motivi dorati sono volati via come prima, ma l'Incisione non è comparsa sotto il pilastro... Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Vuol dire che non solo l'Incisione è stata rimossa, ma si è anche frammentata... Non va bene. Dobbiamo trovare tutti i pezzi, e in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Quindi, dove li troviamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "...Temo di non saperlo neanch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Anche se frammentati, sono comunque tenuti insieme da una qualche forza, quindi dovrebbero essere ancora vicini. Forse dobbiamo solo guardarci intorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "Roar, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "Mmmh? Vuoi andare lì? Stiamo facendo qualcosa di importante ora, giocheremo con te più tardi, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "Mrrraaa... Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Vuoi dire che l'Incisione è laggiù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Mmmh. Ho sentito dire che ancora oggi ci sono Saurici in grado di percepire il potere di un'Incisione, ma ho sempre pensato che si trattasse di una diceria. Che sia vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#Immagino che tu non sia davvero un Tepetlisauro come gli altri, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Quindi sai fare anche questo, eh? Beh, hai ancora un sacco di strada da fare prima di diventare una buona guida come Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "Uhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon ti invidia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Chi lo dice? Paimon ha una mente bella aperta! Era solo il suo modo di elogiarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "Mmmh... Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "*sospira* Il piccoletto non ha capito niente. Se solo fosse un po' più intelligente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "So che un giorno lo capirà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Proprio così. I responsabili per la cura dei Saurici dicono sempre che ci vuole tempo per instaurare un vero rapporto con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "Il segreto del successo è il seguente: avere pazienza e comunicare costantemente. Che gli umani vogliano capire i Sauriani, o i Sauriani gli umani, in ogni caso serve... molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Vero. Neanche Paimon ha capito cosa stesse cercando di dirci {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Mi dispiace, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "Rrraa, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Però sei veloce a rispondere, Paimon te lo concede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "Bene, ti seguiremo. Vediamo se riusciamo a trovare qualche motivo dorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Paimon ti sta facendo un complimento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "Beh, era un complimento, ma ora non montarti la testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}