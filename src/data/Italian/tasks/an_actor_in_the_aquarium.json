			"dialogs": [
				{
					"id": 747070101,
					"content": "...Bene, perfetto! Facciamone solo un'altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Bene. Eee... Stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Oh, e anche Colombina e Chiori! Siete ancora qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Mh-mh, abbiamo appena finito di girare le inquadrature secondarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Ooh! Ti riferisci a quelle scene che stavate girando coi pesciolini? Com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Grazie a voi, abbiamo trovato un attore adatto per il ruolo e le riprese sono andate lisce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Voi due ci sapete davvero fare con questo acquario. Furina ci stava giusto dicendo che le avete fatto venire voglia di girare un documentario sottomarino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Troppo gentile!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Piace anche a me. Percepisco quanto siano felici i pesciolini mentre nuotano. Avete fatto un ottimo lavoro nel prendervi cura di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747070111,
					"content": "Vorrei tanto che questo acquario restasse qui per sempre, così potrei venire a visitarlo ogni volta che ne ho voglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Se le mancherà così tanto, perché non aggiunge qualche altra ripresa panoramica al film?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Hai ragione. Dovremmo assolutamente aggiungerne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Aggiungere altri pesci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747070115,
					"content": "No, aggiungere delle riprese! Forza, luci, cinepresa... Dov'è il supervisore alla sceneggiatura? Forza, tutti ai propri posti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon è pronta! Però dare indicazioni a dei pesci attori è... decisamente un'esperienza insolita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Siamo davvero felici che vi piaccia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}