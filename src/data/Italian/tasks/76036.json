			"dialogs": [
				{
					"id": 760360101,
					"content": "Non questo blu, quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "Colombina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Ah, siete voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360106,
					"content": "Potreste aiutarmi? Farò in modo di ricambiare il favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360107,
					"content": "Scherzi? Non c'è bisogno di offrirci nulla, sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Ci hai aiutato molto in passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Sì, ti aiuteremmo anche se non ci dessi niente in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Quindi, come possiamo aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Beh... A essere precisi, è questa creatura ad avere bisogno d'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "La Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Sì. Si è procurata un pennello da qualche parte e, quando è tornata da me, ha iniziato ad agitarlo tutta felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360116,
					"content": "Ho trovato delle tele e della pittura ma, anche se è passato un po' di tempo, i suoi tentativi di miscelare i colori che desidera non hanno avuto molto successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360117,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360118,
					"content": "Woah, guarda chi c'è!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360119,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360120,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360121,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360122,
					"content": "Uh... Stai giocando a fare il mimo? Scusa, non abbiamo capito niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360125,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360126,
					"content": "Ah, sembra che sia interessata al tuo zaino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360127,
					"content": "Avete per caso con voi dei colori adatti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360128,
					"content": "Uh, non è qualcosa che portiamo solitamente con noi... A proposito, dove hai trovato la pittura? Senza offesa, ma non sembri il tipo che dipinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360129,
					"content": "Questa piccolina era così impaziente che ho usato dei fiori colorati qui vicino per crearle della pittura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360130,
					"content": "Uh, forse Luonnotar sta cercando altri oggetti dai colori vivaci con cui fare della pittura, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360131,
					"content": "Dai, vediamo cosa abbiamo nei nostri zaini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360109,
					"content": "Siamo noi che dovremmo \"ricambiare il favore\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
		},
