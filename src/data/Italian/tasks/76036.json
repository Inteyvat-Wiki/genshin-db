			"dialogs": [
				{
					"id": 760360301,
					"content": "Questo va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Sì, la Kuuhenki sembra piuttosto soddisfatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360303,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Cavoli, Paimon non sapeva che le Kuuhenki fossero delle artiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Le Kuuhenki sono molto simili noi. Ognuna ha la sua personalità e i suoi hobby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360306,
					"content": "Aspetta, vuoi dire che sai distinguere le Kuuhenki di Nod-Krai tra loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Quelle che ho incontrato, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360308,
					"content": "Straordinario! Soprattutto perché, se escludiamo Luonnotar, tutte le altre Kuuhenki sembrano uguali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Qual è il nome di questa piccola pittrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Il nome...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360311,
					"content": "Aspetta... Hanno dei nomi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Io riconosco loro e loro riconoscono me. I nomi non sono necessari... E poi nemmeno io ho un nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360313,
					"content": "Ma non è un buon motivo per non spezzare il ciclo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Mmm... Allora... \"Luonnotar\" significa \"una creatura nata sotto la benedizione della Dea della Luna\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "...Come si dice \"pittura\" nella lingua degli Eredi della Luna gelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Credo... Maa... naus? Maalaus? Sì. Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360317,
					"content": "Oooh, che bello! Beh, allora \"Maalaus\" sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "Che c'è, Maalaus? Hai finito di dipingere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Oh! Vediamo un po'... Woah, ma è...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "È bellissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon si aspettava qualcosa di molto più infantile... Oppure sai, nello stile delle Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Le Kuuhenki sono molto abili nel percepire l'ambiente circostante e, quando ricreano ciò che hanno visto, tendono a cogliere le cose esattamente com'erano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360326,
					"content": "Quindi hai dipinto Colombina, Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "Mmh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360329,
					"content": "...Sembra proprio Colombina alla sua nascita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "Prego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360331,
					"content": "Lauma ha detto che la tua nascita è stata documentata dagli Eredi della Luna gelata... Ma questo dipinto sembra un po' diverso.",
