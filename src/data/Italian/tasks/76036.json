					"nextDialogs": [
						760360335
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760360335,
					"content": "Sembra che tu stia cercando di aiutarci a conoscere la tua dea, eh, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "!",
