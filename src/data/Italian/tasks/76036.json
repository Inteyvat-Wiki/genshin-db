						760360340
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360340,
					"content": "Wow, che velocità! Hai già finito un altro dipinto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Paimon"
