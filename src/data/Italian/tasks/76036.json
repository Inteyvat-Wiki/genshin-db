					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "E le Kuuhenki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Maalaus... è stata una delle prime Kuuhenki a nascere. Questa potrebbe essere la sua interpretazione di com'erano le cose a quel tempo.",
