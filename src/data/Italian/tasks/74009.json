			},
			"dialogs": [
				{
					"id": 740090301,
					"content": "Ora vi spiego, è tutto un malinteso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Signor Sonny... Ci pensi un attimo, siamo qui solo per guadagnare dei Mora, e dato che i capoccia non erano d'accordo... Abbiamo pensato di guadagnare prima, e poi consegnare i profitti, ecco come stanno le cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Oh, sta ignorando Paimon del tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Non ho di che lamentarmi contro l'organizzazione, figuriamoci... Oh, vero, anche io sono stato ingannato da quei \"poco di buono\"! È l'unico motivo per cui ho compiuto un'azione così sciocca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Notevole, davvero. {NICKNAME}, le storie che elogiano la tua forza sono tutte vere. Non sei d'accordo, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "#Fortissim{F#a}{M#o}, incredibile, formidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Se vi ricordate ancora dei bei momenti trascorsi insieme, allora vi prego... signor Sonny... signor Luca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "Ah! Vi prego, vi prego, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "Luca, i nostri ospiti sono ancora qui. Eventuali scortesie potrebbero renderli tristi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "Umpf! Ora sei cosciente dei tuoi errori, Virgil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Aaah, è stata colpa mia, tutta colpa mia... Per favore, abbiate pietà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "D'accordo, se non altro hai ammesso di aver sbagliato. Ora cerca solo di non cascarci di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Il mio Virgil non farà mai più cose del genere. {NICKNAME}, Paimon, ve lo giuro solennemente sull'onore di Sonny il Guanto bianco e su quello di mio padre e mio figlio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Andiamo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Mh! Grazie mille, Sonny e Luca. In fin dei conti, sembra che a Fontaine la gente perbene sia più di quella disonesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Addio, cara Paimon e {F#mia cara madama}{M#mio buon messere}. Spero verrà presto il giorno in cui potremo collaborare ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Urgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "Ora cosa farete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#Quando questo mondo non ha più segreti per te, la vita può essere assai noiosa. Non ho ragione, forse, {M#messere}{F#madama}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "#Se ci tieni a saperlo... faremo una bella e lunga chiacchierata con lui. Non vi ruberemo altro tempo, potete stare tranquill{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
		{
			"id": 7400904,
