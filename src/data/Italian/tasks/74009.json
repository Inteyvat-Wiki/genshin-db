			"dialogs": [
				{
					"id": 740090201,
					"content": "#Paimon e {M#messere}{F#madama}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Questa è la roccaforte da cui Virgil opera ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Seriamente, perché mai Virgil non è ancora tornato...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Persona dall'aria losca"
				},
				{
					"id": 740090204,
					"content": "Se ci vuole far perdere tempo e basta, potrei non farcela... e bermi tutto questo Sinthe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Persona dall'aria pericolosa"
				},
				{
					"id": 740090205,
					"content": "Ehi, smettila! Quel lotto di Sinthe ci è costato un braccio e una gamba. Se lo tocchi senza il suo permesso, Virgil ti spenna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Persona dall'aria disonesta"
				},
				{
					"id": 740090206,
					"content": "Ma che peccato, sembrerebbe che il mio caro amico Virgil non sia ancora tornato alla roccaforte. Possiamo comunque fare due chiacchiere con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Ehm, ma non sembra che questi abbiano tanta voglia di chiacchierare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Mmm, ma penso che cambieranno idea a breve. Che cosa pensi, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "Ehi! Sei sicuro che non ci sarà nessun problema? Paimon crede che probabilmente proveranno a dartele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Oh no! Sei troppo premurosa, cara Paimon. Sarebbe una bella sfortuna se accadesse qualcosa di simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "...Ovviamente per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		},
