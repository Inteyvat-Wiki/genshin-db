				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Ora, questa sì che è una coincidenza. Non sei d'accordo, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Chi siete voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Scusatemi, non è da me avviare una conversazione senza nemmeno presentarmi. Io sono Sonny, quello che a volte chiamano il \"Guanto bianco\". Questo è il mio amico Luca il Pescatore. È abbastanza conosciuto in certi ambiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Ah, salve! Paimon è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Ho capito, ho capito. Lo so che tu sei Paimon, e che {F#la bionda}{M#il biondo} viaggiat{F#rice}{M#ore} è {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Eh? Ci conosci già?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "Ovvio! È solo che prima di oggi, vi conoscevo come uno può conoscere il Giudice supremo. In altre parole, sapevo i vostri nomi, ma voi non sapevate il mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Con la vostra fama e le vostre gesta, è perfettamente naturale che la notizia del vostro arrivo vi precedesse qui a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "#Siamo così famos{F#e}{M#i}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Ah, quanta umiltà. Come ve la spiego... Mmm, per certe persone, il vostro arrivo a Fontaine equivale a una bomba piantata sul palco dell'Opéra Épiclèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "...Ovviamente, è una cosa assolutamente positiva. Non sei d'accordo, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Eh, ma come fa una bomba a essere una cosa bella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Mmm... Non sono molto bravo con le parole. Come diresti tu, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Lo show magico di Lyney e Lynette. Uno spettacolo esplosivo e da brividi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Precisamente! Vedi, io non ci avrei mai pensato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "S-Se lo dici tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Ma perché ti chiamano \"guanto bianco\"? Paimon non vede nessun guanto qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Oooh, questa sì che è una domanda difficile... Come spiegare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Immagina di avere in mano un guanto bianco... Se qualcosa di sporco dovesse finirti in mano, allora sul guanto si disegnerebbe un segno scuro. Il mio compito sarebbe... trovare il segno scuro e rimuoverlo dalla vista di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Oh... quindi sei, diciamo, uno spazzino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Esattamente, mia cara Paimon! Vedi, non sono mai stato in grado di riassumere in poche parole il lavoro che faccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Aah, quindi è grazie a gente come te che le strade della Corte di Fontaine sono sempre così linde e pinte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Ahahah, proprio quello che volevo sentire! Sì, diciamo di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Ok, per Paimon ha senso... ma perché mai uno spazzino ha bisogno del coltello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Beh, puoi considerarlo un piccolo attrezzo del mestiere che tiriamo fuori quando ci sono dei segni particolarmente difficili da rimuovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Capito, grazie! Allora... il tuo amico Luca qui è \"Luca il Pescatore\" perché è bravo nella pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Mmm, è solo una parte della storia, temo, Vedi, a Fontaine ci sono pesci di diversi tipi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "E Luca è un esperto nell'insegnare alla gente a trascorrere del tempo con i diversi tipi di pesce. Vero, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Eh? Paimon non capisce... e questo cosa comporta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Devo dire, cara Paimon, che sei proprio brava a fare le domande più difficili e affascinanti. Sarebbe fantastico se potessimo farci una lunga chiacchierata, per rispondere a tutte le domande che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, puoi anche smettere di fare domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Eh? E va bene... Sonny e Luca, c'è qualcosa che vorreste chiederci voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Vedi, per noi è molto intrigante tutto il mondo delle immersioni. Le acque di Fontaine sono piene di tesori inestimabili, lasciati dalla natura e dai nostri antenati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Abbiamo sentito che ultimamente hai stretto una nuova amicizia, e che hai perfino partecipato a delle immersioni con lui. Grazie ai tuoi poteri, non ti è servita nemmeno l'attrezzatura da immersione. Non è così, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Volete sapere di Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Sì. Vogliamo sapere qualcosa su Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil... Bugiardo e traditore! Ah, il solo pronunciarne il nome fa andare Paimon su tutte le furie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Raccontate la vostra esperienza con Virgil a Sonny il Guanto bianco e Luca il Pescatore.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "...Capisco, capisco. Grazie di averci raccontato tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Di niente! Umpf, Paimon non ha dimenticato niente di quello lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "Siamo estremamente grati del fatto che abbiate condiviso con noi l'intera storia; tuttavia, per come la vedo io, sono ancora più sollevato del fatto che non consideriate Virgil un amico. Non fosse stato così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Mmm, forse posso dire così: se l'aveste visto come un amico, le cose si sarebbero esacerbate non di poco. Non è così, mio caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Le cose potrebbero farsi difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Sono d'accordo, d'accordissimo. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Di che stai parlando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Sono nemici di Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Le tue parole mi feriscono {M#messere}{F#madama}. Ho tanti amici, e neanche un singolo nemico. Virgil è uno dei tanti amici... ah, parlando del caro Virgil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Penso sia arrivato il momento di farci una conversazione seria a tu per tu. Capisci cosa intendo, car{M#o}{F#a} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Certo, anche in modo tale da fargliela pagare per quello che ti ha fatto. È l'unica cosa che possiamo fare per i nostri ospiti, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Eh, Paimon non ha capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "È il Guanto bianco. È tutto quello che devi sapere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Ehm... Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Abbiamo già trovato la fortezza di Virgil e dei suoi amici. Perché non ci vediamo là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Ma perché dobbiamo andarci anche noi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#Ma {M#messere}{F#madama}! Con tutto quello che ti ha fatto Virgil, non possiamo fargliela passare... cioè non possiamo parlarci senza prima informare te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Vedi, anche Luca è d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Umpf! Anche Paimon vuole parlare con Virgil! Ci deve una scusa formale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Ahahah... sei troppo gentile. Allora vediamoci a destinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "E va bene. Andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Non devi per forza capire tutto, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#Quando questo mondo non ha più segreti per te, la vita può essere assai noiosa. Non ho ragione, forse, {M#messere}{F#madama}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Possiamo dare una mano in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
