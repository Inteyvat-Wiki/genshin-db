				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740090401,
					"content": "Bene, caro Virgil... Ci hai fatto passare un gran bel guaio. Di' un po', cosa credi che dovremmo fare con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090402
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090402,
					"content": "M-Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090403
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090403,
					"content": "Così non va affatto bene. Lo sai benissimo che il tempo vola, e adesso è troppo tardi per tirarsi indietro. La nostra organizzazione ha un codice di giustizia esclusivo, e una delle regole più importanti stabilisce che ci sono attività a cui non bisogna mai dedicarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090404
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090404,
					"content": "M-Ma... la prego, Monsieur Sonny, mi stia a sentire! I margini di profitto sono davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090405
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090405,
					"content": "Ah, ci risiamo. Mora, Mora, Mora... Possibile che non sai pensare ad altro? Cosa ne è del tuo orgoglio in quanto cittadino di Fontaine? Con quale coscienza riesci a vedere i tuoi compatrioti tramutarsi in gusci vuoti a causa di questa bevanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090406
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090406,
					"content": "Bah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090407
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090407,
					"content": "Oh! Da non credere, perfino Luca mostra una reazione intensa alle tue parole. Hai visto, caro Virgil? Hai davvero compiuto l'impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090408
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090408,
					"content": "Monsieur Sonny, io... La prego, deve credermi! È stata tutta colpa di quei tipi, mi hanno mentito... I-Io non avrei mai fatto nulla di simile se non fosse stato per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090409
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090409,
					"content": "Fa' silenzio, cervello di paramecio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090410
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090410,
					"content": "Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090411
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090411,
					"content": "Tu sei esattamente il tipo di miserabile con cui non ho tempo da perdere. Stai ancora tentando di raccontarmi fesserie? Ti credi davvero così furbo? Oppure hai preso me per un idiota? Che c'è, adesso non parli più?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090412
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090412,
					"content": "#Come se non bastasse, hai perfino tentato di ferire {NICKNAME}. Non avevi proprio la minima idea di con chi avresti avuto a che fare? Non pensavo che quello lì avrebbe avuto un allievo più inetto di così... Dovrò proprio andargliene a dire quattro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090413
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090413,
					"content": "Ma di questo non dovrai preoccuparti, caro il mio Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		}
	]
}