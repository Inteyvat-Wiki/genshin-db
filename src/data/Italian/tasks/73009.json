				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "Non potrò mai ringraziarti abbastanza per aver preparato il Festival di Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "È un peccato che non abbia potuto unirmi a voi come Arama e gli altri, e che non abbia potuto aiutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Detto ciò, se sentiste il peso delle vostre avventure, venite nel Vanarana. Questo sogno vi accoglierà sempre a braccia aperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
