				"points": []
			},
			"dialogs": [
				{
					"id": 730090901,
					"content": "A proposito di \"Marana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090902
					]
				},
				{
					"id": 730090902,
					"content": "È una storia di tanto tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090903
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090903,
					"content": "Tanto tempo fa, gli Aranara camminavano sulla terra e fecero amicizia con i Nara e con tutte le creature viventi. Allora non esisteva Marana. Fino a un disastro avvenuto molte, molte lune fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090904
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090904,
					"content": "Sua Eccellenza Maggiore Rukkhadevata tornò nel Sarva, e la furia di Marana sulla terra ebbe inizio. Quando la foresta recuperò la sua vitalità, gli Aranara nascosero il vero Vanarana in un sogno per proteggersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090905
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090905,
					"content": "La foresta non conosceva la morte, finché non arrivò un giorno in cui gli alberi si accorsero che i fiori appassiti e gli animali morti ricoprivano la terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090906
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090906,
					"content": "Lo stesso giorno, la terra si ricordò del sangue velenoso e nero come la notte che aveva divorato, o che stava per divorare e i fiumi pensarono al mondo rosso che sarebbe rimasto una volta che il sole fosse sceso e avesse fatto evaporare tutta l'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090907
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090907,
					"content": "Si resero conto che tutte le cose avrebbero incontrato la loro fine e così nacque Marana. È il nome della morte e coloro che lo conoscono moriranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090908
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090908,
					"content": "Marana conduce tutto verso la morte. Quanto a quegli esseri alti, oscuri e deformi, sono gli Avatar scelti da Marana, gli araldi della morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090909
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090909,
					"content": "Naturalmente, nelle mie storie gli Avatar di Marana assumono varie forme. A volte sono bestie, a volte uccelli, a volte Nara, altre volte sono causa di sventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090910
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090910,
					"content": "Ma questi non sono miei ricordi, sono solo storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
