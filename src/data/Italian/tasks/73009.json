			"dialogs": [
				{
					"id": 730091401,
					"content": "A proposito di Marana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091402
					]
				},
				{
					"id": 730091402,
					"content": "È una storia di tanto tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091403,
					"content": "Tanto tempo fa, gli Aranara camminavano sulla terra e fecero amicizia con i Nara e con tutte le creature viventi. Allora non esisteva Marana. Poi molte, molte lune fa, avvenne un disastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091404,
					"content": "Molti tornarono nel Sarva, e la furia di Marana sulla terra ebbe inizio. Quando la foresta recuperò la sua vitalità, gli Aranara nascosero il vero Vanarana in un sogno per proteggersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091405,
					"content": "La foresta non conosceva la morte, finché non arrivò un giorno in cui gli alberi si accorsero che i fiori appassiti e gli animali morti ricoprivano la terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091406,
					"content": "Quello stesso giorno, la terra ricordò il sangue scuro e velenoso che aveva divorato un tempo, o che stava per divorare. I fiumi pensarono alla discesa del sole, che faceva evaporare tutta l'acqua e lasciava dietro di sé un mondo tinto di rosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091407,
					"content": "Si resero conto che tutte le cose avrebbero incontrato la loro fine, e così nacque Marana. È il nome della morte, e coloro che lo conoscono moriranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091408,
					"content": "Marana conduce tutto verso la morte. Quanto a quegli esseri alti, oscuri e deformi, sono gli Avatar scelti da Marana, gli araldi della morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091409,
					"content": "Naturalmente, nelle mie storie gli Avatar di Marana assumono varie forme. A volte sono bestie, a volte uccelli, a volte Nara, altre volte sono causa di sventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091410,
					"content": "Ma questi non sono miei ricordi, sono solo storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
