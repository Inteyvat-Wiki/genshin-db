			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana si prenderà cura di lei. Lei è una carissima amica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, vai nel Vanarana e canta Melodia del Gran Sogno. Poi chiedi di aiutare a preparare Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Non so se ho capito bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Come nuvole sanno di dover rilasciare pioggia, pioggia sa di dover cadere su terreno e semi sanno di dover crescere e diventare grandi alberi con tanti grandi frutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "C-Certo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, sembra che tu non abbia capito. Nessun problema. Quando momento giusto arriva, Nara {NICKNAME} saprà cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
