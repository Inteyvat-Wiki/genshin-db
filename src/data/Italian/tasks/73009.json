			"dialogs": [
				{
					"id": 730091001,
					"content": "A proposito del frutto di Vasoma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "È un frutto ricco di energia. Cresce sui ricordi e sui sogni della terra e ha bisogno dell'aiuto degli Aranara e dei Nara per produrre frutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
					"content": "Il Bija può essere creato nutrendo l'albero di Ashvattha con un frutto di Vasoma. È un enorme albero piantato da Sua Eccellenza Maggiore Rukkhadevata ed è l'origine degli Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
