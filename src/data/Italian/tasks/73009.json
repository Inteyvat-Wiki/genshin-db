			"dialogs": [
				{
					"id": 730091101,
					"content": "A proposito dell'Aranyaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#Apparteneva a Nara Varuna. {F#Lui}{M#Lei} era {F#un}{M#una} Nara dorat{F#o}{M#a} gentile, audace e leale, proprio come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Ricordo ancora quanto gli Aranara amassero le sue storie e sentissero la sua mancanza a quel tempo. Ma dato che ora Nara {NICKNAME} è qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7300912,
