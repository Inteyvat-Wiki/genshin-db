			"dialogs": [
				{
					"id": 740390601,
					"content": "Mh-mh, quindi hai sconfitto quelle creature così facilmente grazie alla pozione super mega potente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390602,
					"content": "Esattamente! Potresti anche dire che mi ha dato dei super poteri super mega potenti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Che razza di slogan orrendo sarebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ah, grazie, grazie mille! Quindi è stato per via degli effetti della pozione. Beh, è la ricetta della maestra pozionista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390609,
					"content": "Questo è vero, sì. Abbiamo finito con la pozione super mega potente. Passiamo alla pozione della canicola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390610,
					"content": "Hai... Ehm... Hai inventato tu questi nomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "No, non sono brava a inventare nomi, quindi lascio che gli altri mi aiutino a inventarne di migliori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390612,
					"content": "Dai, non dire così... Davvero, e per qualcosa come le pozioni, il nome dovrebbe farti capire il suo effetto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Mmm... Non ci ho mai pensato... Ma hai ragione! La maestra pozionista sarebbe d'accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390614,
					"content": "#*tossisce* Bando alle ciance, sei pront{F#a}{M#o} a testare questa pozione, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390615,
					"content": "Certamente, cominciamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Oh, cielo.... Anche questa ha un odore tremendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "In teoria, questa pozione della canicola impedirà che senta freddo e ti terrà al caldo. Già. Credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390618,
					"content": "Prendi la pozione di Vérénata. Ha l'odore di vecchio cuoio polveroso e ammuffito...\\nEsiti un istante prima di berla in un sorso solo. Il sapore non è male, è speziato con un tocco di cannella e zenzero... Ti ricorda un caminetto scoppiettante in una giornata di pioggia.\\nCiononostante, ha un effetto molto blando sul tuo corpo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "In seguito, segui le istruzioni di Vernata e ti riposi per un momento.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Non ho avvertito molte sensazioni, ma era piuttosto dolce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Eh? Ma aveva un odore orribile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Mm... Davvero? Ho sbagliato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390608,
					"content": "Non buttarti giù. Almeno non era velenosa... Possiamo considerarlo un successo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
