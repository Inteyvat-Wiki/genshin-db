				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "Eccoci! Questo è il mio laboratorio, dove conduco i miei esperimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390802,
					"content": "#Va bene, e ora il mio prossimo esperimento: la pozione della rivelazione! Sei pront{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390803,
					"content": "#Sono pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Oooh... Fa' attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Prendi la pozione dalle mani di Vérénata, e l'odore sgradevole di masse di alghe morte lasciate a marcire sotto il sole tropicale ti assale le narici, provocandoti un conato involontario...\\nEsiti per un momento, e poi bevi giù tutto in un colpo solo. Il gusto della pozione non è poi così terribile, anzi, questa è più che altro insipida...\\nIl tuo corpo non presenta alcuna reazione.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "In seguito, segui le istruzioni di Vernata e ti riposi per un momento. Non è successo nessun cambiamento.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Ma poco dopo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Sembra che non sia cambiato niente... Fiuuu, Paimon può smetterla di preoccuparsi ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Sì, però... {NICKNAME}, sembravi in preda a uno stordimento. Cosa c'è che non va? Hai visto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390810,
					"content": "Ho visto... metà di una barca semi-trasparente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Davvero? Affascinante! Ma... ehm... puoi darmi una descrizione più dettagliata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390812,
					"content": "Era troppo lontana, non l'ho vista con chiarezza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "Che interessante, certo, certo!... Ma non costituisce una prova concreta degli effetti della pozione... Non puoi dimostrare di aver scambiato un qualche relitto o una barriera corallina per una \"nave fantasma\", dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390814,
					"content": "Per cui... *sospira* I risultati di questo esperimento sono inconclusivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390818,
					"content": "#Grazie a entramb{F#e}{M#i}, ho raccolto un sacco di appunti utilissimi! Sarò sicuramente in grado di usarli per il prossimo gruppo di pozioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390819,
					"content": "Mmm.... \"Anche se ho sentito qualcosa che sembrava familiare...\" certo, \"Ma c'è ancora tanto altro da osservare, e constatare se altri vedono lo stesso fenomeno\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390820,
					"content": "Oh? Significa che devi trovare ancora altra gente che ti dia una mano con la prova delle pozioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "Proprio così. Perché... ehm... devo avere due o più testimoni affidabili che vedono la stessa cosa, al fine di dimostrare che la pozione permette davvero di vedere la verità, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390822,
					"content": "Perché la \"verità\" non sarà limitata dagli occhi o dalle prospettive di chi osserva, e non verrà distorta da cosa si trova nel loro cuore... ma esiste oggettivamente e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390823,
					"content": "Mmmm... come... come dèi che vivono per migliaia di anni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390825,
					"content": "No. Come quella sabbia bianca, come gli ossi delle stelle marine, come le onde che si stagliano... sono loro la \"verità\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390826,
					"content": "Ma la maestra pozionista ha detto anche che... la \"verità\" può essere creata tramite sogni e ricordi. Non capisco ancora cosa significhi, dato che sembra una contraddizione... ma sto facendo del mio meglio per interiorizzare questo concetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390827,
					"content": "Wow... All'improvviso l'argomento sta diventando così profondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Ahah, e allora evitiamo l'argomento per ora! Comunque, vorrei ringraziarvi del vostro aiuto! Ecco, prendete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390829,
					"content": "Mmm... Mi raccomando, la prossima volta che faccio una pozione nuova venite a provarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390815,
					"content": "Sembrava esser stata tagliata in due da qualcosa di immenso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390817,
					"content": "Ah! Scusatemi... Devo essermi distratta un attimo. Ma... Ma ho scritto tutto qui. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				}
			]
		},
