					}
				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#Come ti senti, {NICKNAME}? Tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390702,
					"content": "Scusami... Non sapevo che la pozione avrebbe attirato quegli strani esseri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390703,
					"content": "È successo perché la pozione era calda, e ho sentito una grande afa sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Uff, è così che funziona? Puoi sentire caldo e afa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Capisco, capisco... Gli animali acquatici confondono le cose calde con il sole, da cui sono attratti. Il che vuol dire che... la pozione ha fatto effetto! Grazie, davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390706,
					"content": "Paimon non pensa che abbia funzionato come previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Animali acquatici...? Non erano Melmosi di Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Capisco... Mmm, effetti collaterali allucinogeni... Ok, me lo sono appuntato. Beh, almeno non è stata completamente inefficace, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390709,
					"content": "Ma i suoi effetti erano terribili! A confronto, i grandi granchi sembravano Melmosi di Pyro, ma se la prossima volta arriva un mostro più pericoloso?! Che si fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Vero... So di averti già dato molto disturbo, ma c'è un'ultima pozione da testare... Sei ancora disponibile a provarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390721,
					"content": "Sì, a patto che non sia tossica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Anche se questo si scoprirà solo una volta provata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Sì! Grazie mille! Beh, la prossima è la pozione della rivelazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390726,
					"content": "Eh? A-Aspetta un secondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "La prima era la pozione super mega potente, poi c'era la pozione della canicola, e ora questa è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "La pozione della rivelazione, che \"permette alle persone di vedere la verità\"... Cosa c'è che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390729,
					"content": "Oh... Non è niente... Paimon crede solo che il suo nome sia completamente diverso a paragone con gli altri! Come un giro di 360 gradi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Ma questo non significa che non è diverso affatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Oh...? Oh... Paimon non ha così tante dita! Ma tanto hai capito cos'è che intendeva Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Eheh, è perché la maestra pozionista ha dato il nome alle prime due, e io ho scelto il nome per quest'ultima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390734,
					"content": "Non sono molto brava a dare i nomi, quindi probabilmente non è bello come quelli della maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390735,
					"content": "Davvero? Paimon pensava che fosse l'opposto... E comunque, abbi un po' più di fiducia in te! Paimon crede che sia un nome appropriato per una pozione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Mm, grazie. A ogni modo... Questa pozione è diversa dalle altre due, perciò potrebbe essere molto pericolosa... Per piacere, venite nel mio laboratorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390737,
					"content": "Beh... L'aria di mare dovrebbe mitigare gli effetti della pozione, e il mio laboratorio è attrezzato con strumenti in grado di gestire i pericoli, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390738,
					"content": "Wow, sembra roba forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Cominciamo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Bene, seguitemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390731,
					"content": "Vuoi dire 180 gradi, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Beh, abbiamo fatto trenta, facciamo trentuno!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Esattamente! Che senso avrebbe tutto questo, se lasciassimo perdere a metà? Non che Paimon non sia preoccupata, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Non temere, i Melmosi di Pyro sono deboli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "Eh... Aspetta, no. È solo che sei troppo forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Mmm. Un momento... Hai appena detto \"Melmosi di Pyro\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390713,
					"content": "Oh! Esatto... Abbiamo visto un sacco di granchi giganti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Granchi? Sì, è normale vederli lungo la costa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Ma nemmeno tu eri normale proprio un momento fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Ma la sensazione ustionante era reale. Potevo addirittura sentire le loro ondate di calore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Capisco... Mmm... Effetti allucinogeni... Ok, me lo sono segnato. Beh, almeno non è stata completamente inefficace, ma... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390718,
					"content": "Comunque sia, sono lieta che tu stia bene! È solo che... Scusa, la pozione non ha funzionato di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390719,
					"content": "#Non c'è problema! E anche se aveva un odore nauseante, è stato comunque un mezzo successo. {NICKNAME} stava bene dopo averla bevuta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
