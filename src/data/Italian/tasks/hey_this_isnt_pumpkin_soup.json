				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Grazie! Proviamo con il primo tipo, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390502,
					"content": "#Non berne troppa, {NICKNAME}! Se senti che c'è qualcosa che non va sputala subito, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Non preoccuparti, Paimon, sto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Umpf. Paimon è solo in pensiero, sai com'è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "#Sono pront{F#a}{M#o}, passami la pozione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Questa si chiama pozione super mega potente, e ti farà diventare molto forte... In teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390507,
					"content": "Prendi la pozione di Vérénata e la bevi tutta d'un sorso.\\nHa un odore difficile da sopportare, ma il sapore è dolce e vischioso e non è difficile da mandar giù.\\nIl tuo corpo non sembra avere alcuna reazione all'intruglio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Seguendo le sue indicazioni, attendi che i Primoplasti della Faglia si attivino.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
