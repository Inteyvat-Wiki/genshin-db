				]
			},
			"dialogs": [
				{
					"id": 740390101,
					"content": "Mmm... Poltiglia di Algamarea, viscere tritate di una Lumitoile e un poco di... Un attimo, quant'è \"un poco\", con esattezza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390102,
					"content": "Ehi, stai preparando una zuppa? Bleah... Ha un odore stranissimo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Mm? Un odore strano, dici? Non può essere. Ho seguito la ricetta che mi ha dato Carabosse, quindi dovrebbe avere un odore normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390104,
					"content": "Puzza come se qualcuno avesse fermentato dei branzini per tre anni in una damigiana di rane morte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Urp, dovevi proprio dirlo così? Ora Paimon ha questa immagine in testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "C-Comunque sia... Che stai facendo? Hai... ehm... bisogno d'aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "È una pozione! Sto creando una pozione... Una pozione che aiuterà molte persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390110,
					"content": "Quindi sei una pozionista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Non ancora. Sono solo l'assistente di una maestra pozionista. Si chiama Carabosse. Io invece sono Vérénata, ho ancora molto da imparare da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390112,
					"content": "Eheh, beh, l'assistente di un grande dottore deve essere un grande assistente, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Eheh... Già... Anzi! Aspetta! Niente affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390114,
					"content": "Ecco... ci sono ancora molte cose che non so. Sto facendo del mio meglio per aiutarla con le pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390115,
					"content": "Inoltre... Mmm, vi ho detto il mio nome, ma non conosco ancora i vostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390116,
					"content": "#Paimon è Paimon, e {F#lei}{M#lui} è {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "\"Paimon\"... Che bel nome. Mi ricorda una medusa bianca sciabordante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}... Un nome alquanto bizzarro, ma brilla come l'oro ed è molto amichevole. Piacere di conoscervi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390119,
					"content": "Beh, avete chiesto se mi servisse aiuto, ed è così... Ma non so se abbiate voglia di darmi una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390120,
					"content": "Certamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Senz'altro! Se ti serve una mano, basta dirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Vorrei che... provaste le mie nuove pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390123,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "So che le pozioni hanno un pessimo sapore e un odore terribile... ma possono aiutare un sacco di gente e curare molte malattie. Sono molto efficaci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390125,
					"content": "Ma noi non ci ammaliamo, né ci piace bere strani intrugli. Nel tempo le persone hanno smesso di aiutarmi ad assaggiare le mie pozioni, ed è stato un grosso problema per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390126,
					"content": "Ehm... l'hai detto tu che questa roba è strana! Non è pericolosa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Non c'è problema. Siamo immuni all'avvelenamento, e dovreste esserlo anche voi... Beh, almeno in teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390128,
					"content": "Ci sono tre pozioni da testare. Una aiuterà le persone a diventare fortissime nel combattimento! L'altra le farà sentire al caldo. E l'ultima, mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390129,
					"content": "Non so bene come spiegarlo, ma Carabosse dice che può aiutare la gente a comprendere la verità. Almeno così ha detto... Sebbene non sappia esattamente cosa voglia dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390130,
					"content": "Sembra pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "No, no! Non è pericoloso... Allora? Vorreste aiutarmi? In tal caso, vi porterò subito dove fanno gli esperimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390106,
					"content": "Se calmerai il tuo cuore, riuscirai a sentire la fragranza dei Fiordolci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Ehi, neanche quello va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
