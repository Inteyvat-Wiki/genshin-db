					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490402
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490402,
					"content": "Magari uno dei suoi frutti preferiti lo tirerà su di morale.",
