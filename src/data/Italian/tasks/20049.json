			"dialogs": [
				{
					"id": 200490201,
					"content": "Mmmh... Tramontini o mele? Difficile decidere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490202,
					"content": "*sospira* Come vorrei che Nimrod fosse qui, sceglierei quello che vuole lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490203,
					"content": "Mi dispiace, Eury, abbiamo finito i Tramontini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Oh, capisco. Allora immagino che prenderò le mele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Oooh... Mi dispiace tanto, Eury, credo che queste mele stiano iniziando a rovinarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "Davvero? Mmmh... ma non c'è altra scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "Lascia fare a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490208,
					"content": "Eh? Lasciarvi fare... cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490209,
					"content": "Dare una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Rilassati, troveremo dei <color=#00E1FFFF>Tramontini</color> freschi per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "Davvero? Uhm... allora, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "Ma è fantastico, Nimrod preferisce i Tramontini alle mele. Allora aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
			]
		},
