			"dialogs": [
				{
					"id": 150400101,
					"content": "Eccoci qui! Secondo la mappa, questi dovrebbero essere i Campi Fiordispuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400102,
					"content": "Perché è tutto così... verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400103,
					"content": "Io li chiamerei più \"Campi Erbaspuma\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "Ahah, in effetti anch'io mi aspettavo qualcos'altro... Ma ci sono abituato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400105,
					"content": "Ti riferisci alle pubblicità ingannevoli? Già, quando si arriva a questi livelli, di solito tendo a sporgere reclamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400106,
					"content": "Se non lo facessi, sarebbero i miei gruppi turistici a lamentarsi di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400107,
					"content": "No, no. Scusate, dovevo essere più specifico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400108,
					"content": "Mi riferivo più... al divario tra le mie aspettative e la realtà. È una cosa che tende a succedermi spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400109,
					"content": "Oh, a causa della...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400110,
					"content": "Eh, già. Per esempio... Scali una montagna per ammirare un panorama e, una volta in cima, c'è una nebbia talmente fitta che rende difficile vedere anche a un palmo dal naso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400111,
					"content": "Oppure, raccogli un sacco di legna per accendere un fuoco, e quando torni alla tua tenda scopri che un Melmoso di Pyro ci si è intrufolato dentro e ha dato fuoco a tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400112,
					"content": "Oh, cavoli. Non sembra affatto facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400113,
					"content": "Eh, ormai ho smesso di darci peso: in fondo, che avventure sarebbero se non ci fosse qualche intoppo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400114,
					"content": "Quindi, se ci pensate, poterci godere questo immenso panorama e questa piacevole aria fresca, senza neanche un mostro in vista... è già di per sé una gran bella fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400115,
					"content": "Io sono molto più colpita dal tuo livello di ottimismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400116,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400117,
					"content": "Oh! Credo che l'Asha abbia trovato qualcosa. O almeno, è questa l'impressione che ho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400118,
					"content": "Accidenti, riuscite già a capirvi al volo? Dovete essere sulla stessa lunghezza d'onda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400119,
					"content": "(Continui a leggere fino alla fine.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "Wow. Il più acerrimo degli acerrimi nemici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400121,
					"content": "Se fossero entrambi persone, potrebbero sedersi e discuterne, ma... ma uno dei due è un Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400122,
					"content": "Dai, diamogli una mano! Sei pronto, Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400123,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400124,
					"content": "Woah, un attimo. Cos'è questa smania improvvisa? Paimon non sa nemmeno quale sia il piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400125,
					"content": "Beh, riflettici un po': se c'è una cosa che l'Asha adora fare, è dare colore a ciò che lo circonda, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400126,
					"content": "Sì... E quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400127,
					"content": "Sono creature semplici e dal cuore puro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400128,
					"content": "Perciò, dubito che l'Asha sia venuto qui per creare problemi. Forse non sopporta di vedere questo prato così spoglio e scolorito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400129,
					"content": "Già, e non è in grado di dircelo direttamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400130,
					"content": "Proprio così! Quindi, se lo aiutiamo a dare all'erba un aspetto colorato e vivace... cioè a trasformarlo in un vero prato fiorito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400131,
					"content": "...Potremo rendere felice l'Asha e al contempo aiutare il dipendente del resort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400132,
					"content": "Mi hai tolto le parole di bocca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400133,
					"content": "Uhm, una piccola mediazione, in pratica... Non male. Hai talento, come pacificatore, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400134,
					"content": "Puoi contare su di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400136,
					"content": "#Ahah, basta... Mi fai il solletico! Eh, dove mi stai portando? È lontano? Devo avvisare {F#le mie amiche}{M#i miei amici}, prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400137,
					"content": "Aspetta, dove state...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400138,
					"content": "Ehi, signorina interprete, tu c'hai capito qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400139,
					"content": "Forse c'è qualcosa da spostare... Oppure c'è qualcun altro nei paraggi che ha urgente bisogno d'aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400140,
					"content": "Sembrano due cose completamente scollegate! Tra l'altro, come fai a dirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400141,
					"content": "In realtà, più osservo gli Asha, più il loro linguaggio corporeo mi ricorda quello dei Saurici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400142,
					"content": "Mh... Spero che tu non stia scherzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400143,
					"content": "No, sono serissima. Nel linguaggio saurico, lo stesso movimento può significare più cose completamente diverse. Quando mia mamma saurica alzava le ali, poteva significare o \"torna presto per cena\" o \"sei nei guai fino al collo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400144,
					"content": "E come si fa a capire la differenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400145,
					"content": "Quand'ero piccola, non ci riuscivo. A volte tornavo a casa solo per prenderle di santa ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400146,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400147,
					"content": "Accidenti, non solo è super robusta, ma anche velocissima... Le mongolfiere di Natlan sono tutte così? È fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400148,
					"content": "Quassù! Guardate! Siamo tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
