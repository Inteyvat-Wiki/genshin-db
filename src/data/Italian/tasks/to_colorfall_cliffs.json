			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "Wow, pazzesco! Finalmente i Campi Fiordispuma sono degni del nome che portano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Ottimo lavoro, ragazzi! Ora dobbiamo solo informare il dipendente del resort, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Per favore, aspettate... *ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Che tempismo perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "È tutto a posto. Riprendi fiato, prima di tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*ansima* Fiuu, ok... Sono l'addetta all'evento principale delle Rupi di Acquatinta, la sfida dell'\"Asha volante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Poco fa, mentre osservavo dall'alto, ho visto il prato trasformarsi all'improvviso in un mare floreale. I colori erano davvero mozzafiato... C'è mancato poco che mi scivolasse il binocolo di mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "S-Siete davvero i salvatori delle Rupi di Acquatinta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Ah, una bazzecola, hihi... Dopotutto, è principalmente opera di questi due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "Magnanimi avventurieri, sareste disposti a partecipare alla nostra sfida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "O meglio... Vorreste farci l'onore di donare un po' di colore anche ai nostri luoghi d'interesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Sembra un'ottima idea... ma sei sicura che possiamo farlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Certo, naturalmente! Non chiedo di meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Siete stati preziosissimi per il mio collega, e ci tengo a ringraziarvi a nome suo. Ho pensato che un'esperienza del genere avrebbe avuto molto più valore di una semplice ricompensa monetaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Ahh, no. Noi in realtà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Saremmo lieti di aiutarti! Ahah... Allora, puoi dirci come ci si arriva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Seguitemi, prego. Saliamo sulla mongolfiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
