			"dialogs": [
				{
					"id": 150400701,
					"content": "Eccoci qui, signore e signori: vi presento l'\"Asha volante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "Woah, che forza! Non credevo fosse così enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Dopo che sarà dipinto, sarà ben visibile anche da lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Oh, certo che sì! Finché ci si trova in un'area aperta e con la visuale sgombra, sarà visibile da ovunque, che si tratti della piscina panoramica della Collina di Huha o dei fiordi dell'Isola di Tete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "Fenomenale! Il vostro lavoro potrà essere ammirato da tutti! Siete davvero fantastici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400706,
					"content": "Cavoli, mi sto già esaltando! Mi converrà indossare il mio colore portafortuna? O magari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400707,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400708,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400709,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Wow, sembra avesse parecchio da dire, stavolta, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Chasca, tu c'hai capito qualcosa? Potresti tradurre per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Mmmh, non è facile. Dovrò fare mente locale per capire cosa potrebbe aver detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#Tranquilla, credo di aver afferrato! L'Asha vuole fare squadra con me e competere contro {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "Gli piace aiutare la gente collaborando coi suoi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Ma è l'elemento competitivo che trasforma le comuni attività quotidiane in avventure entusiasmanti, ed è questa la cosa che ama di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "H-Ha davvero detto tutto questo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Ahah, pressappoco! C'è anche un po' d'interpretazione personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "Da come reagisce, pare che tu abbia colto nel segno. Il vostro legame cresce davvero a vista d'occhio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#D'accordo, Asha. La tua idea mi piace, ma dovremmo assicurarci che anche {NICKNAME} lo trovi divertente, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "Le opinioni e i sentimenti degli amici vanno sempre rispettati, è importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "Un'occasione per sfidare il nostro leader... Non aspettavo altro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "\"Allora, diamo inizio ai giochi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Ahah... Scusa, se mi guardi così, non ce la faccio a dirlo senza ridere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Bene! Se le squadre sono pronte, allora seguitemi! Io vi farò da arbitro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Purché voi due siate contenti, il resto non conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#Ehi, questo non è mica giusto! Voglio che anche tu ti diverta, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "Su, non stressiamoci! Pensiamo solo a divertirci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "Potete anche affrontarmi tutti e cinque, sarò comunque io a vincere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "Mi piace la tua sicurezza! Come vuoi, ti mostrerò quello che so fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "Ehi, davvero vuoi che anche Paimon ti affronti?! Noi siamo una squadra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
			]
		},
