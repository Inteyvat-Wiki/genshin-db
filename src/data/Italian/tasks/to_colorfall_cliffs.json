				{
					"id": 150401001,
					"content": "Perfetto! L'Asha volante ha un aspetto fantastico e nell'inquadratura ci siamo tutti. Chasca, avvicinati un altro pochino!",
					"roleType": "TALK_ROLE_NPC",
