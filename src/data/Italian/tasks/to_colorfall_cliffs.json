			"dialogs": [
				{
					"id": 150400601,
					"content": "#Ahah, è stato divertentissimo! Uno scontro memorabile, {NICKNAME}! Grazie, io e l'Asha ci siamo divertiti un sacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "È stata una battaglia ad armi pari, direi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "Ottimo lavoro, gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Congratulazioni a {NICKNAME} per la vittoria! E un ringraziamento speciale anche al nostro generoso benefattore e al suo compagno Asha per il loro brillante lavoro di squadra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Quando prima hai interpretato il linguaggio dell'Asha, stentavo a crederci; ma dopo la partita di oggi, ammetto di essere rimasta senza parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Stessa cosa io! Avevo i nervi letteralmente a fior di pelle! Sembrava quasi di assistere a una finale del Pellegrinaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Concordo. Più si andava avanti, più avevo voglia di volare anch'io fin lassù a sparare qualcuno dei miei proiettili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Stai dicendo che i tuoi proiettili sono delle palline di colore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Una specie... anche se il colore finale sarebbe stato un po' un'incognita. E non sono certa che quell'Asha sarebbe riuscito a restare in aria, dopo il mio intervento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Eheh! Comunque, ora siamo a un passo dal completare la sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "Vorrei invitare i nostri due eroi a illuminare i pennelli dell'Asha volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Riproduci la cronologia dei luoghi d'interesse degli Asha)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Stupendo, vero? Posso suggerirvi un luogo panoramico ideale dove scattare una foto di gruppo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "Tu e l'Asha siete una squadra davvero affiatata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Avrei fatto meglio a chiedere aiuto a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Ah! Quindi adesso ti ricordi di Paimon? Un po' tardi, non trovi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
