			},
			"dialogs": [
				{
					"id": 760020101,
					"content": "#Ehi, tu, {F#biondina}{M#biondino}! Tempismo perfetto. Questo teppistello è in cerca di guai. Dammi una mano e riceverai la tua parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#Ma che fai? Chiami rinforzi perché sai che non vincerai? Occhio per occhio, dente per dente, allora. Ascolta, {F#amica}{M#amico}, aiutami e ci divideremo i Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "A-Aspetta! Eravamo solo di passaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
