			"dialogs": [
				{
					"id": 760020501,
					"content": "Ah! E così ce ne siamo liberati. Certo che non smetteva di parlare, quel forestiero svitato. Continuava a parlare di liquidare la mia squadra... Ora che è un pezzo di ghiaccio solido, scommetto che liquidare sarà l'ultimo dei suoi pensieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Fiuu... Abbiamo evitato che Nasha venisse inondata di merce di contrabbando! Ah, non scordarti della nostra ricompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Umpf, una cosa per volta. Prima devo esaminare la merce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Aspetta, controllare... la m-merce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Certo! Se qualcosa non va, non guadagneremo un singolo Mora. E una parte di zero è zero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Tsk... Guarda questi graffi. E pure la ruggine! Certo che il Fleuve Cendre ultimamente è abbastanza negligente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Mmm, Paimon sbaglio o è un Mekautoma di Fontaine? Wow, la tecnologia di Fontaine è impressionante. Funziona anche dopo essere stato trasportato qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Funzionante? Ma per favore! Il suo sistema di alimentazione dovrebbe essere stato smantellato secoli fa. Come potrebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
