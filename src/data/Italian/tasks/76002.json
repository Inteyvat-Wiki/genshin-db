			"dialogs": [
				{
					"id": 760020301,
					"content": "Tsk... Lasciateli andare. Questi ratti non sanno stare al proprio posto, e cercano di infilarsi nel nostro territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Grazie per l'aiuto. Quando i miei ragazzi porteranno questa \"Mademoiselle Belleville\" a Nasha, la tua parte è assicurata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Sì, sì, il pagamento... Aspetta un attimo... Mademoiselle? siete dei trafficanti di esseri umani?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Non farti strane idee, piccoletta. Non ci occupiamo di rapimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "\"Mademoiselle Belleville\" è il nome di questo pezzo di metallo. Trasportato fin dal Fleuve Cendre, non è stato facile farlo arrivare qui. Se lo dovesse rubare qualcuno, saremmo rovinati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Oh, un Mekautoma di Fontaine? Wow, la tecnologia di Fontaine è impressionante. Funziona anche dopo essere stato trasportato qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Stai scherzando, spero. Il sistema di alimentazione di questa cosa è stato strappato via un sacco di tempo fa. Non può...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "ATTENZIONE. Modalità di avvio <color=#FF5E41FF>ANOMALA</color>. Modulo energetico <color=#FF5E41FF>Ax5F02&#5E38NORMALE</color>. Verifica non riuscita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020309,
					"content": "Verifica non riuscita. <color=#FF5E41FF>Verifica non riuscita</color>. <color=#FF5E41FF>Verifica non riuscita</color>. <color=#FF5E41FF>Annientamento</color>. <color=#FF5E41FF>Annientamento</color>. <color=#FF5E41FF>Annientamento</color>. <color=#FF5E41FF>Annientamento Annientamento Annientamento</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020310,
					"content": "#Eek! {NICKNAME}, attenzione!",
					"roleType": "TALK_ROLE_NPC",
