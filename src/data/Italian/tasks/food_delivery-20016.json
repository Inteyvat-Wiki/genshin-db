			},
			"dialogs": [
				{
					"id": 200160101,
					"content": "Ordina una consegna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "#Viaggiat{F#rice}{M#ore}! Che tempismo perfetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Scusami, so che stai morendo di fame, ma potresti farmi un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "C'è stato un regolare aumento di ordini per delle consegne recentemente. Cerco di dividerli per regione, poi etichetto ogni piatto con il nome della persona che l'ha ordinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Ma ho perso l'etichetta per questa <color=#00E1FFFF>zuppa ai gigli di calla e frutti di mare</color>. So solo che è per qualcuno al Villaggio Acquachiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Puoi portare questa <color=#00E1FFFF>zuppa ai gigli di calla e frutti di mare</color> al Villaggio Acquachiara e scoprire chi l'ha ordinata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Ok, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Ti assicuro che ci sarà un pasto fatto con amore ad aspettarti al tuo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Sono qui solo per mangiare, sto morendo di fame!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Quando avrai fatto quello che ti ho chiesto, ti offrirò qualcosa dal menù speciale del Buon Cacciatore! Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
