						200160202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160202,
					"content": "Eccoti di nuovo! Hai effettuato la consegna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160203,
					"content": "Ecco il pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160204
					]
				},
				{
					"id": 200160204,
					"content": "Mmh, fammi controllare... Perfetto! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160205,
					"content": "Ecco, questo <color=#00E1FFFF>tortino di granchio, prosciutto e verdure al forno</color> è per te. Mangialo finché è caldo, è stato appena sfornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
