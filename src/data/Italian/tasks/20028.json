			"trigger": {
				"objectNames": [
					"Morrow il Timido"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#G-Grazie mille, {F#signora}{M#signore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280102,
					"content": "Sarò pure un cacciatore di professione, ma di sicuro questi maledetti Melmosi ci sanno fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280103,
					"content": "A causa loro, ancora una volta non avrò nulla da mostrare di ritorno dalla caccia. Non ho catturato un bel niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280104,
					"content": "Spero proprio che gli altri cacciatori non abbiano avuto la mia stessa sfortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280105,
					"content": "A proposito di Melmosi e cose del genere... Potresti dare un'occhiata veloce qui intorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280106,
					"content": "Potrebbe essere solo la mia immaginazione, ma... ho l'impressione che intorno al villaggio ne sbuchino fuori sempre di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280107,
					"content": "Puoi controllare se sulla strada davanti ci sono altri Melmosi? Se ne vedi... sai cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280108,
					"content": "Certo, ho un po' di tempo libero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Mi fai un grande favore. Bene, è meglio che torni a fare rapporto a Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280111,
					"content": "Spero solo che non sia così ubriaco che tutto quello che gli dico gli entra da un orecchio e gli esce dall'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow il Timido"
				},
				{
					"id": 200280109,
					"content": "Scusami, ma devo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Ti prego, se non per me, almeno fallo per tutti gli abitanti del Villaggio Acquachiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow il Timido"
				}
			]
		}
	]
}