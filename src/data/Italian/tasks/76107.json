			"dialogs": [
				{
					"id": 761072001,
					"content": "#Scusa, mi sono {F#persa}{M#perso}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761072002
					]
				},
				{
					"id": 761072002,
					"content": "Puoi uscire sia dal porto che dal cancello principale. La comandante Azalea è molto rigida con la sicurezza da queste parti... Anche tu devi seguire le regole.",
					"roleType": "TALK_ROLE_NPC",
