			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "Sono il tuo Messaggero, la Marionetta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Eh? A-Aspetta, è così che ci facciamo chiamare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Umpf. Ammiro la tua audacia, ma se pensi che una bugia così sfacciata funzionerà, stai sottovalutando i Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "#Sono... {F#una ricercatrice nominata}{M#un ricercatore nominato} dalla Marionetta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "#Lady Marionetta ti ha nominato {F#sua ricercatrice}{M#suo ricercatore}? Ma ha già raggiunto l'apice sia della ricerca meccanica che del Kuuvahki. Perché mai avrebbe bisogno di assumere ricercatori esterni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Il progresso scientifico si fonda sulla collaborazione, sai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Mmh... vero. Io stesso ho aiutato a raccogliere diverse ricerche dell'Istituto di ricerca di Fontaine per lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "#Dal momento che sei {F#un'esperta}{M#un esperto} in questo campo, immagino che riparare questo Incrociatore terrestre non sia niente di difficile per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Umm... Purtroppo le mie ricerche sono più di natura teorica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Ah, capisco! La teoria del Kuuvahki è uno degli argomenti di studio più complessi... Davvero impressionante! In confronto, riparare un Incrociatore terrestre ha più a che fare con l'applicazione pratica. E, come dici tu, sono discipline completamente diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Comunque sia, Lady Marionetta non è qui al momento. Potresti chiedere alla comandante Azalea... magari saprà cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Certo, lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Dai qualche colpo all'Incrociatore terrestre. *clang clang clang*... Ora non si muove più.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Si è... rotto del tutto... E adesso che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "#Umpf, sapevo fossi una persona strana fin dall'inizio. Un vero ricercatore non farebbe mai affermazioni così assurde. Sei chiaramente {F#un'impostora}{M#un impostore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "#Sono praticamente {F#la}{M#il} suo mentore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Ah! A proposito, anch'io ho aiutato a raccogliere diverse ricerche dell'Istituto di ricerca di Fontaine per lei. Ha parlato molto bene delle scoperte del dottor Mosso. Aspetta... non dirmi che sei...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*tossisce* *tossisce*... Mm-mmh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "S-Sì! Non avrei mai pensato che fossi una persona rinomata anche qui, dottor Mosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Umpf. Per quanto ne sappia, dovresti essere morto da trent'anni. Beh, meglio tardi che mai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610717,
			"completionStepIds": [
				7610701
			],
