			"dialogs": [
				{
					"id": 761071701,
					"content": "Umpf, non gioco secondo le regole dei Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "Allora, se non vuoi seguire le regole... Sparisci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
