			"dialogs": [
				{
					"id": 761071901,
					"content": "In realtà qualcosa da fare l'avrei... Vorrei un duello con te, come allenamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "#Un duello? Ma avevi detto di essere {F#una ricercatrice esterna}{M#un ricercatore esterno}... Umpf, ora che ci penso, non mi pare Lady Marionetta abbia mai assunto dei ricercatori... Aspetta. Sei una spia, vero? Allora preparati a morire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
