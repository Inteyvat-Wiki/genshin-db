			"dialogs": [
				{
					"id": 761071001,
					"content": "Chi sei tu? E che ci fai qui? Gli addetti al trasporto delle merci dovrebbe essere al porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
