			"dialogs": [
				{
					"id": 20210101,
					"content": "Allora, cosa avete fatto nel Piano dell'eutimia della Shogun Raiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210102,
					"content": "Il Decreto di caccia alle Visioni è stato abolito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210103,
					"content": "È tutto merito di Yae Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "Oh, ho capito... Sai, Paimon era molto preoccupata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210106,
					"content": "Forse Yae Miko ci sta cercando perché vuole ringraziarci. Andiamo a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210104,
					"content": "Le abbiamo comunicato il volere del popolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
