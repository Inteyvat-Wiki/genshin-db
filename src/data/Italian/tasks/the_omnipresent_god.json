	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "#Toglimi una curiosità. Perché sei compars{F#a}{M#o} di nuovo davanti a me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200302,
					"content": "Speri che la tua incoscienza possa salvare quella gente? Oppure... volevi solo un'udienza con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200303,
					"content": "I Fatui hanno ingannato la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh! Di certo non mi hai svegliata dal mio stato di meditazione eterna solo per dirmi questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200306,
					"content": "Se è così, mi sottovaluti. Sono ben informata sul Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200307,
					"content": "Sai cosa sta succedendo là fuori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Non esattamente. Ho solo le informazioni che riguardano l'eternità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200309,
					"content": "Il Decreto di caccia alle Visioni ha la mia tacita approvazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200310,
					"content": "Le azioni dei Fatui non minacciano l'eternità, altrimenti... li avrei già eliminati da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200311,
					"content": "Ma il Decreto di caccia alle Visioni è deleterio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "L'ambizione personale non è compatibile con l'eternità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200314,
					"content": "Forse non ti è chiaro un concetto... Troppo spesso, coloro che inseguono i propri sogni hanno molto più da perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200315,
					"content": "Considera questo: nessuno perde la vita quando viene privato della Visione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200316,
					"content": "Al contrario, a morire sono proprio coloro che tentano di perseguire le proprie ambizioni. Non è forse così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#Viaggiat{F#rice}{M#ore}, ai miei occhi la tua esistenza è unica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200319,
					"content": "In te vedo un'incertezza senza limiti. Per spiegarmi meglio, sei la cosa più lontana che esista dall'eternità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200320,
					"content": "Quindi non insisterò per farti comprendere il significato delle mie azioni. Ciò che importa è che io percorra la strada per l'eternità per conto della mia gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200321,
					"content": "Questo è il tuo Piano dell'eutimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "È creato dalla tua coscienza, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Esatto. Sono sorpresa che tu lo capisca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200324,
					"content": "A ogni modo... Stai cercando un modo per farmi cambiare idea, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200325,
					"content": "Non sono qui per discutere delle tue idee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Sono qui per distruggerle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200328,
					"content": "Così sia. Bene, se hai deciso di sfidare l'eternità... questa è la tua occasione per illuminarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200312,
					"content": "È la gente di Inazuma a pagarne il prezzo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Il Decreto di caccia alle Visioni non sarebbe dovuto esistere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Hai perso, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200503,
					"content": "Sì... È così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200504,
					"content": "Perché non ti fidi del tuo popolo e della forza delle sue ambizioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Tali ambizioni hanno trasceso lo spazio e il tempo. Niente e nessuno è in grado di soffocarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Quando la gente si impegna con tutta la forza che possiede...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "È questa la lezione che hai imparato durante il tuo viaggio a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Esistono nazioni in cui gli esseri umani rigettano le divinità e riescono comunque a prosperare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "E noi dovremmo abbandonare la nozione di progresso... solo per inseguire una chimera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "...Noi due abbiamo già assistito alle grandi perdite che il progresso può causare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200514,
					"content": "L'eternità... è l'unica strada da percorrere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200515,
					"content": "I Princìpi celesti... sono assurdità irrilevanti, per quanto mi riguarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "In fin dei conti, quello che vuoi davvero è proteggere la tua amata Inazuma per sempre. Non è forse così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Direi che è una semplificazione eccessiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200518,
					"content": "Ma questa nazione merita davvero di esistere per l'eternità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Priva di ambizioni, senza possibilità di cambiamento, tutto ciò che può fare è... esistere, ridotta a un semplice guscio vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Se una nazione del genere venisse distrutta, sarebbe davvero una perdita per qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, rimangia quello che hai detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200522,
					"content": "Ho promesso al mio popolo un'eternità immutabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200523,
					"content": "Ma il tuo popolo non vuole promesse. Vuole le tue attenzioni... il tuo sguardo divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "...Parli delle Visioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200525,
					"content": "Gli esseri umani vivono cent'anni a malapena. Non possono permettersi di sostenere ulteriori perdite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200526,
					"content": "Io ho vissuto la cosa sulla mia pelle, ed è per questo che ho deciso di guidarli sulla strada dell'eternità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200527,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Ma l'eternità è una sorte troppo crudele per te, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Che vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200530,
					"content": "Non hai smesso di prenderti cura solo del mondo, ma anche di te stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "La solitudine che hai provato vivendo per secoli in questo luogo, in totale isolamento, sarà stata immensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Ma è necessaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200533,
					"content": "Rifiutando il progresso, rinuncerai a molto... Tu vuoi evitare le perdite, ma hai considerato ciò che stai perdendo restando confinata qui in eterno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "È ovvio che ti senti sola, ma per preservare l'eternità hai deciso di vivere per sempre in queste condizioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Dimmi una cosa. Perché questo cielo, che prima era buio, adesso sta brillando di nuovo? Perché proprio adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Questo è il tuo Piano dell'eutimia. È il tuo mondo interiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Può significare solo una cosa... Che sei felice di rivedermi. La solitudine che ti costringi a sopportare qui da ormai troppo tempo è diventata insostenibile, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Io... non ho niente da dire, in proposito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200539,
					"content": "Eheheh... Oh, ma io ho così tanto da dirti. Lascia che ti racconti tutto ciò che è successo durante questi ultimi secoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Quanto tempo ci vorrà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200541,
					"content": "Grazie al mio ruolo di volpe messaggera, ho un'ottima memoria. Ricordo con assoluta chiarezza ogni dettaglio di questi ultimi secoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Quindi, probabilmente ci vorranno altrettanti secoli per riferirti tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Eh... Eheheh... Miko, non credevo che avrei più avuto l'occasione di parlare con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200544,
					"content": "*sospira* Rivederti cambia questa condizione di eternità... ma è anche una bella sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200545,
					"content": "Eheh. Visto che lo hai ammesso, vuol dire che possiamo essere ancora amiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Che conversazione infantile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200547,
					"content": "Comunque. Visto che sono stata sconfitta da voi e dal vostro piano, rispetterò il vostro desiderio e abolirò il Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200548,
					"content": "Ma per quanto riguarda l'eternità e il destino di questa nazione, ho bisogno di rifletterci ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200549,
					"content": "Eheh, sei tu quella che si è comportata in maniera infantile fin dall'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "È in grado di superare le aspettative delle divinità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "E perfino prendere il loro posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
