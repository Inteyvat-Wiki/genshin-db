				"objectNames": [
					"Ragazzo in verde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3720101,
					"content": "Ehi, ma voi siete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Ragazzo in verde"
				},
				{
					"id": 3720102,
					"content": "Ah, giusto! Voi siete quelli che hanno spaventato Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Ragazzo in verde"
				},
				{
					"id": 3720103,
					"content": "Dvalin? Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720104,
					"content": "È il vero nome del Terrore alato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "Eh? Ah, sì, giusto. Ma sembra che lo chiamino tutti \"Terrore alato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720107,
					"content": "Perché lo chiami così? Siete forse amici, tu e lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720108,
					"content": "Sì, cari amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Ragazzo in verde"
				},
				{
					"id": 3720109,
					"content": "#Ehi, {NICKNAME}. Paimon crede che questo tipo sia un po' strambo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720110,
					"content": "Ahh... Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "#Salve, stranier{F#a}{M#o}. Le nostre strade si incrociano di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Ragazzo in verde"
				},
				{
					"id": 3720113,
					"content": "Sono un bardo, mi chiamo Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720114,
					"content": "Se vogliamo essere precisi, tre volte vincitore del premio \"Bardo più popolare di Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720115,
					"content": "Come vi posso aiutare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720116,
					"content": "Dato che sai già chi siamo, Paimon non crede ci sia altro da spiegare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720117,
					"content": "Volevo parlare di Terrore alato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720118,
					"content": "Terrore...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720119,
					"content": "Ehi! Basta con questa pantomima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, mostraglielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720121,
					"content": "Ah. Ma non è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720122,
					"content": "Cosa?! Il cristallo è stato purificato?! Quando è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720123,
					"content": "Non so proprio come sia potuto succedere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720126,
					"content": "Tutta quella angoscia... lo ha portato alle lacrime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720127,
					"content": "Lacrime...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720124,
					"content": "L'ultima volta che l'ho visto era coperto di impurità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Scusami, chi sei...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "Lisa ce l'aveva detto prima, non ti ricordi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
		{
			"id": 3720301,
