			},
			"dialogs": [
				{
					"id": 3720501,
					"content": "Cooooosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720502,
					"content": "Hai... delle abilità davvero straordinarie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720503,
					"content": "Una persona come te non può che finire nelle rime di un bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720504,
					"content": "#{F#Ella}{M#Egli} si erge in mezzo a noi, il più brillante tra gli eroi. Se nell'ombra sei appartato, rischi d'esser accoltellato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720505,
					"content": "Ahimè, al momento non ho proprio tempo di comporre una melodia in tuo onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720506,
					"content": "Comunque sia, anche se non dovessimo sconfiggere Dvalin, la sua vita si spegnerà comunque nel vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720508,
					"content": "Mi dispiace molto per Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Posso aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "In quanto cavaliere, ti consiglio di costituirti insieme al drago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "Verrà consumato dalle fiamme dell'ira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720509,
					"content": "Grazie dell'aiuto e per aver purificato la Lacrima di cristallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720510,
					"content": "Ma ho già altri piani, per questa faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720512,
					"content": "#Ti ringrazio davvero per aver purificato la Lacrima di cristallo, mi sei stat{F#a}{M#o} di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720513,
					"content": "Ma ho già progettato un mio piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720515,
					"content": "Credi davvero sia necessario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720516,
					"content": "Puoi scordartelo, per ora... Ho un piano ben diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720517,
					"content": "Ah, sì? E che piano sarebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720518,
					"content": "Quando la lacrima ho veduto, un caro amico nella mente è sovvenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720519,
					"content": "Amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720520,
					"content": "Eheh, adesso è ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720521,
					"content": "Ehi! Dove te ne scappi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720522,
					"content": "Al \"Simbolo dell'eroe di Mondstadt\". Ciao ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720524,
					"content": "Quello \"stramboide\", come l'hai chiamato tu... dobbiamo tenerlo d'occhio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Mmh... {NICKNAME}, che ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720526,
					"content": "Sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "#Se lo chiedessi a lui, ti direbbe che l{F#a}{M#o} stramboide sei tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720528,
					"content": "La sua voce mi è familiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}