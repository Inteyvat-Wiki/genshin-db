			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME} e Paimon! Salve! Posso fare qualcosa per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "#Beh, ultimamente siamo {F#state sommerse}{M#stati sommersi} dal lavoro, quindi Lisa ci ha consigliato di trovare dei modi per aumentare l'efficienza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "Ah, giusto! Ne ho parlato anche con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Al momento ci sono tre aspetti che potete migliorare: la produzione, la coltivazione e la vendita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Aumentare la vostra efficienza in questi aspetti renderà molto più facile gestire gli affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "#Wow, sembra proprio quello che ci serve! Proviamo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "Vorremmo migliorare l'efficienza operativa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Sembra che sia tutto pronto per questo miglioramento! Forza, provate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Vorremmo comprare dei rifornimenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "È il vostro giorno fortunato! Ho appena ricevuto un nuovo lotto di provviste! Prego, date un'occhiata e ditemi se c'è qualcosa di vostro interesse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "Buona fortuna per la vostra attività!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				}
			]
		}
	]
