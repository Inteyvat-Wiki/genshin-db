			"dialogs": [
				{
					"id": 401450101,
					"content": "Dopo un breve periodo di prova, il negozio di pozioni diventa molto popolare...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*sospira* I clienti continuano ad arrivare. Non c'è stato un momento di sosta, e Paimon comincia a sentirsi un tantino stordita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Gli affari vanno a gonfie vele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Abbiamo un sacco di ordini. Paimon non è sicura che riusciremo a completarli tutti da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Forse dovremmo assumere qualcuno che ci aiuti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "State facendo una pausa, tesorini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Stavo giusto guardando i dati sulle vendite, e sembra che abbiate un grande talento per gli affari. Le pozioni stanno andando a ruba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Oh, Lisa! Tempismo perfetto! Stavamo proprio dicendo che avremmo bisogno di una mano in più al negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Eh? Gli ordini si stanno già accumulando? Avete dei problemi a tenere il passo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "#Sì, siamo letteralmente {F#sommerse}{M#sommersi}! Paimon non avrebbe mai pensato che avremmo avuto tutti questi clienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Beh, non posso dire di esserne sorpresa. In realtà, mi aspettavo questo tipo di risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "#Mentre voi due eravate {F#impegnate}{M#impegnati} al negozio, io e Freda abbiamo discusso di come rendere gli affari più efficienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Dopo aver osservato il vostro lavoro, mi sono appuntata diverse migliorie che potremmo apportare alle attività di produzione, coltivazione e vendita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Aspetta, quindi ci sei stata a osservare per tutto questo tempo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon pensava che stessi bighellonando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Ora non esageriamo, sono piuttosto affidabile quando si tratta di cose importanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Allora? Come facciamo a mettere in pratica queste migliorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Beh, ne ho parlato con Freda e abbiamo pensato a un piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Lascerò che sia lei a fornirvi i dettagli. Perché non andate a cercarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "#Ci siamo {F#fatte}{M#fatti} un nome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
