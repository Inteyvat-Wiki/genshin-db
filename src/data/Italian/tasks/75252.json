				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "Piuttosto, hai per caso visto un tizio pelato, nei paraggi? Devo parlargli di una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Credo sia la persona che sto cercando anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Ah... Era qui poco fa? Immagino mi abbia visto arrivare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Umpf. Questa me la paghi, Icahua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Visto che ci siamo già incontrati e sembri essere una persona apposto, ti avverto di stare alla larga da me e da quello stupido farabutto, altrimenti ti ritroverai quel tuo bel faccino ricoperto di vernice rossa e bianca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Questi sono gli oggetti che ho trovato nel suo accampamento. Credo non abbia avuto il tempo di portarli con sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "Ora sono tuoi. Non preoccuparti, lui non ha alcun diritto di averli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Prima o poi, mi prenderò la sua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Purtroppo no, mi spiace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Non mi stai mentendo, vero? Hai un viso onesto, quindi sono incline a fidarmi di te... almeno per il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
		}
