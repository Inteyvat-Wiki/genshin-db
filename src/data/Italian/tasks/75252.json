			"dialogs": [
				{
					"id": 752520601,
					"content": "Eri un ospite della taverna. Ci siamo già visti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "Davvero? Ecco perché hai un aspetto familiare. Ho incontrato un sacco di gente, oggi, è difficile memorizzare i volti di tutti... Ma questo non conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
