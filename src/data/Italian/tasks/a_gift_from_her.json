					}
				]
			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "#Che profumino sopraffino! Siamo {F#arrivate}{M#arrivati} di nuovo in tempo per il pasto di Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Eh? Sono delle Kuuhenki... Che fanno? Sono in fila per la zuppa che sta servendo Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Solo un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Cavoli, è squisitissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Una zuppa di frutta rinfrescante e gustosa... Paimon non ha mai assaggiato niente di simile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Ne vuoi un'altra porzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230108,
					"content": "Facciamo anche due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Stai imparando a cucinare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Sì. Ho chiesto a Ineffa qualche ricetta semplice e sto provando a prepararle. Il riscontro dalle Kuuhenki e dagli animali che le hanno assaggiate sembra positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230112,
					"content": "Hai qualche problema in cucina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Beh... le maniche del mio vestito sono troppo larghe. Se non sto attenta, finiscono per sfiorare la pentola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230114,
					"content": "(Quindi, non è la cucina in sé a darti problemi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "E faccio un po' fatica con i dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230116,
					"content": "Bisogna calibrare alla perfezione la temperatura e le proporzioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230117,
					"content": "(Allora non deve aver cucinato molto per sé, in passato.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(D'altronde, è piuttosto difficile preparare dolci e spuntini senza l'assistenza di qualcuno...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Vuoi che ti aiuti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Certo. Iniziamo con i krumkake, che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230121,
					"content": "Più tardi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Vuoi assaggiarne uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230123,
					"content": "(Dai un morsetto.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230126,
					"content": "(Accidenti, quel primo morso era aspro da morire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Però, dopo averlo ingoiato, il retrogusto è piuttosto dolce... Forse è solo questione d'abitudine...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230129,
					"content": "Si lascia mangiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Paimon si è persa qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Prova questo, ti va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Argh, è troppo aspro! C-Che state cercando di fare a Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230136,
					"content": "Però il retrogusto non è affatto male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "La cosa più importante è il sapore iniziale! Potevate anche avvertire Paimon di prenderne un morso più piccolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Se tu non avessi detto niente, Paimon avrebbe pensato che fosse uno scherzo! Ad alcuni piace guardare l'espressione contorta delle altre persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Bene. Lasciatemi riprovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230140,
					"content": "Trascorre altro tempo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Ecco. Provate questi altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230142,
					"content": "(Caspita...! Questi sono molto meglio!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Buono!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Dici sul serio? Anche Paimon ne vuole un po'! Mmm...! È proprio quello che ci voleva! Che bontà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Pensate sia abbastanza buono da poterlo regalare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230147,
					"content": "Assolutamente sì! Aspetta, hai imparato a cucinare e a preparare i krumkake per poterli regalare a qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Sì... Ai miei amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230149,
					"content": "È un'ottima idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "#Vi ricordate ancora la prima volta che siete {F#venute}{M#venuti} qui insieme? Mi avevate preparato del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230151,
					"content": "Anche se non bastava a ricaricare il potere che avevo perso, mangiare quel cibo mi ha donato un po' di tranquillità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230152,
					"content": "In quel momento non ci avevo riflettuto più di tanto, ma ora ho capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230153,
					"content": "Il tempo e l'impegno dedicati alla preparazione del cibo sono ciò che gli conferisce un'anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230154,
					"content": "Ciò che ho apprezzato non era il cibo in sé, ma il calore e la gentilezza delle mani che lo hanno preparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230155,
					"content": "E meno quelle mani cercano reciprocità, maggiori saranno il calore e la gentilezza richiesti per poterla eguagliare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230156,
					"content": "Uhhh, stai facendo arrossire Paimon... A dirla tutta, all'inizio speravamo davvero di poter entrare nelle tue grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Ma ora le cose sono cambiate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Sì. Ma ora che ho capito tutto quanto, vorrei cercare di fare qualcosina di più... È una sensazione stupenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230160,
					"content": "Verreste con me a trovare i nostri amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230161,
					"content": "Oltre ai krumkake, ho preparato anche altri regali. Ah, ma devono essere recapitati in segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230162,
					"content": "Perché \"in segreto\"? Se Paimon può chiedere, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "#Beh, siete sempre {F#state}{M#stati} voi a farmi quelle \"piacevoli sorprese\". Vorrei vedere come reagiscono i miei amici trovandosi nella situazione opposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230164,
					"content": "Fiuu. Che sfacchinata! Finalmente abbiamo finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Hanno avuto delle reazioni piuttosto sorprendenti, però. Alcuni non si sono nemmeno resi conto che fossero regali da parte tua, Colombina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino si è messa subito a mangiucchiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Va bene così, me l'aspettavo. L'importante è che quei regali li abbiano resi felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230168,
					"content": "Se è per questo, Lauma ha capito di sicuro che i krumkake e la ghirlanda sulla sua scrivania erano da parte tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon può capire la sua esitazione nell'indossare la ghirlanda, ma seriamente, ha fissato i krumkake per dieci minuti buoni e ancora non se la sentiva neanche di assaggiarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Stavo iniziando a temere che volesse conservarli come delle reliquie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Jahoda invece sembra essersi presa un bello spavento... Forse non dovevamo lasciarle i regali proprio alle spalle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230172,
					"content": "Le è quasi venuto un colpo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Forse è solo circospetta di natura? Ma sembra essersi calmata, quando Ashru si è avvicinato e ha iniziato a farsi le unghie sul tiragraffi che gli hai mandato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Per gli altri nostri amici che non sono a Nod-Krai, conto su di voi per la consegna dei regali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 761230176,
					"content": "Devo dire che ci sai davvero fare nel preparare i regali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Ecco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230178,
					"content": "Oooh! Quindi adesso tocca a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Eh? Delle caramelle? Paimon pensava che avremmo ricevuto dei krumkake come tutti gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Beh, ne hai già mangiati un po' durante i vari assaggi. Un po' di varietà non fa male, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230181,
					"content": "Sì... E sono anche molto buone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Molto bene, mi fa piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230184,
					"content": "E c'è un altro regalo. Ecco, per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230185,
					"content": "Questo è... un aliante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Ho sentito dire che i cieli appartengono agli uccelli e la terra alle belve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230187,
					"content": "L'ampio spazio che c'è tra i due però è riservato agli avventurieri dotati di aliante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230188,
					"content": "Spero che con questo il tuo cammino sarà sempre luminoso come il chiaro di luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230189,
					"content": "È perfetto. Grazie infinite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Grazie a te, per la tua amicizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761230182,
					"content": "Persino più buone delle caramelle della Notte di Preghiera lunare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Se c'è qualcosa che vorresti mangiare, basta chiedere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "Impari in fretta, vedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230130,
					"content": "Ma c'è ancora margine di miglioramento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230124,
					"content": "(Ingozzati.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				}
			]
		}
	]
