			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Benvenut{M#o}{F#a}, {NICKNAME}, buon amic{M#o}{F#a} del Principe. Ti faccio le mie congratulazioni per il primo giorno della tua promettente carriera con i Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Il Principe non è mio amico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Le tue parole esprimono sicurezza... Ricorda però che siamo tutti comuni mortali, e che le nostre idee hanno la forma dell'acqua. Solo la volontà della Tsaritsa è solida quanto il permafrost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Ma torniamo a noi. Il Principe mi ha detto di aver rispettato la sua parte del vostro accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Che accordo? Il fatto che volesse aiutarci a trovare qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Esattamente. Il Principe ha promesso che avrebbe trovato qualcuno per superare lo stallo. E ti assicuro che i Messaggeri non tradiscono mai le loro promesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Capisco. E dove sarebbe quel tizio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Il Principe adesso si trova al <color=#00E1FFFF>Padiglione Liuli</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Il Padiglione Liuli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "Oooh, oooh Paimon sa che cos'è!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "*si schiarisce la voce* A Liyue esistono due stili culinari: Li e Yue. Anche se sono in concorrenza da secoli, nessuno dei due si è ancora affermato sull'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "Il Padiglione Liuli è il ristorante che rappresenta lo stile Li. Il proprietario ha scelto di aprirlo sul Pendio di Feiyun per competere in modo diretto con la Pagoda di Xinyue, il massimo rappresentante dello stile Yue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "È di sicuro il tuo argomento preferito... o forse l'unico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "Non dire queste cose di Paimon! E poi, ho fame! È ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Fai sempre così quando si parla di cibo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "E non ho nessuna intenzione di unirmi ai Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Ah, ce l'avete fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100302,
					"content": "Come promesso, ho trovato qualcuno che potrà aiutarvi. Sarà in grado di svelare la ragione per cui le Sette Stelle di Liyue nasconderebbero i resti dell'Archon di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100303,
					"content": "Dove sarebbe? Al <color=#00E1FFFF>Padiglione Liuli</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Certo. Venite, ve lo presenterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100305,
					"content": "Mi sono permesso di organizzare una cena d'affari, secondo l'usanza di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Permettetemi di presentarvi il signor Zhongli, consulente di un'organizzazione conosciuta come Wangsheng... nonché collaboratore di fiducia dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100502,
					"content": "Collaboratore dei Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Proprio così. Il settore professionale di Wangsheng può essere... delicato, in certe occasioni. Diciamo che loro sanno bene quando è il caso di essere discreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100505,
					"content": "E noi Fatui siamo sempre lieti di fare affari con amici che sanno muoversi nell'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100506,
					"content": "M-Muoversi nell'ombra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "È un onore fare la vostra conoscenza. Ho sentito delle vostre imprese a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Discrezione... Ombra... Non sarà che gli affari di Wangsheng riguardino... la \"dipartita\" della gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "È proprio come pensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "I Servizi Funebri Wangsheng organizzano sepolture. Facciamo in modo che chi ci lascia possa andarsene in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Eeeh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Ahah, pensavate si trattasse di un assassino prezzolato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100514,
					"content": "I Fatui hanno di quel genere di amici, ma i Servizi Funebri Wangsheng non trattano quel settore... Non apertamente, almeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100515,
					"content": "Apertamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Beh, sono comunque... No, non posso dire altro. Comunque sia, ho voluto presentarvi il signor Zhongli perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100517,
					"content": "Perché posso condurvi a trovare i resti di Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "Ma cosa c'entra?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Su, non stupitevi. È vero, il corpo dell'Archon di Geo è stato sottratto per ordine della Tianquan Ningguang... Ma ascoltiamo un attimo cos'ha da dire il signor Zhongli, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100520,
					"content": "Rex Lapis sarà anche il Primo degli Adepti, ma è pur sempre un Adeptus. Molti di loro ci hanno lasciati con il trascorrere dei millenni... È una tendenza inarrestabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "I tempi sono cambiati. Dovreste averlo capito, sui Monti di Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "È vero. Gli Adepti si tengono alla larga da Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Come avrete visto, mentre l'era degli Adepti sta tramontando, quella dell'umanità è ai suoi albori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Come da tradizione, in passato a Liyue si organizzava una sontuosa commemorazione ogni volta che un Adeptus veniva a mancare. Stavolta, tuttavia, le Sette Stelle hanno ignorato completamente questa tradizione, il che è un vero sacrilegio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Beh, hanno per le mani un deicidio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Già, e l'assassino è ancora a piede libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Che si tratti o meno di un deicidio, i Servizi Funebri Wangsheng hanno un solo pensiero: quando si organizza una cerimonia regale per accogliere una divinità, il massimo dell'oltraggio è che il commiato vada deserto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "#Viaggiat{M#ore}{F#rice}, il Principe mi ha parlato a lungo di te. Visto che hai avuto a che fare con l'Archon di Anemo, posso chiederti di aiutarmi a preparare l'estrema unzione dell'Archon di Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Ci devo riflettere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#Beh... Se ci pensi bene, {NICKNAME}, non abbiamo davvero scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Proprio così. Anche pensandoci, il risultato non cambierà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100539,
					"content": "La Tianquan Ningguang, ha proibito a chiunque di avvicinarsi ai resti di Rex Lapis... Tuttavia, voi non potrete farne a meno se volete portare a termine il vostro obiettivo di incontrare tutti i Sette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100540,
					"content": "Proprio così. È solo partecipando al Rito dell'ascensione che potrete vedere la forma di Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Sembra proprio che non abbiamo altra scelta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Se siamo d'accordo, seguitemi. Parleremo dei dettagli per strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Oscuramento. Zhongli esce di scena.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Bene, il mio compito di facilitatore è assolto. Mi sembra con buoni risultati, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100545,
					"content": "Non preoccupatevi per me, andate pure. Nel frattempo mi concederò ancora qualche sorso e proverò a familiarizzare con questi aggeggi che chiamano \"bacchette\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100534,
					"content": "Accetto la tua proposta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Mi pare una saggia decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100536,
					"content": "Il Principe parla troppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "È così? Nel nostro mondo questo vorrebbe dire che vuoi mettermi a tacere... Interessante. Sguaina la spada. Adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100538,
					"content": "Sto scherzando. Procediamo? Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10100523,
					"content": "Anche l'Archon di Geo è un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "Gli Archon tendono a collezionare un ventaglio di nomi. Dio dei Contratti, Dio del Commercio, Dio guerriero, Morax, Rex Lapis... Sarebbe davvero così strano se avesse anche il titolo di Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Wangsheng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101006",
							"2"
						],
						"stepId": 101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "Come ci si sente a sapere che il nostro Archon e gli Adepti sono sempre presenti a Liyue, dopo aver sperimentato come si sta nella terra dell'Archon assente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Preferisco l'atmosfera di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "Capisco, ognuno è fatto a modo proprio. Non c'è niente di male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "Ma penso che dobbiate ancora provare l'effetto dei tremila e settecento anni a stretto contatto con la divinità di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "L'organizzazione del Rito dell'ascensione dovrebbe essere una tappa illuminante nella vostra esperienza di viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Liyue è la più prospera delle sette nazioni, difesa dalle sue divinità e governata dalle Sette Stelle. Di conseguenza, gli stratagemmi diplomatici dei Fatui non hanno mai preso piede qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ningguang delle Sette Stelle è sempre stata in guardia nei confronti dei Fatui. Credo che sia per questo che il Principe vuole avvalersi dei contatti dei Servizi Funebri Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Ehm... Cosa ci guadagnerebbe il Principe dalla nostra partecipazione al Rito dell'ascensione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "Non lo so e credo di non volerlo sapere. Per quanto mi riguarda, i Fatui non hanno altro ruolo se non quello di sponsor. Spero solo che le tradizioni di Liyue siano mantenute nel tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli consegna un sacco di monete al giocatore.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "Questo è l'anticipo che ci ha dato il Principe. Nel caso doveste esaurirlo, potrete rivolgervi a lui per chiedere altri fondi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Bene, andiamo allora. Per prepararci adeguatamente, dobbiamo innanzitutto ottenere della <color=#00E1FFFF>Giada nottilucosa</color> degna di una divinità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Liyue mi piace di più.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Lo capisco. Tremila e settecento anni di storia sono una parte sostanziale della natura divina di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
