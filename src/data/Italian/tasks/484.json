			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Oh, guardate dove siamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Non ci sono altri marchi elementali più avanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Il potere elementale sul manufatto deve essersi esaurito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Raptor deve aver capito che i marchi avrebbero rivelato la sua posizione e ha mandato i suoi scagnozzi a rallentarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Così facendo, una volta esaurito l'effetto, può fuggire indisturbato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "Non la passerà liscia! Inseguiamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48432",
							"2"
						],
						"stepId": 48432,
						"stateName": "QUEST_STATE_UNFINISHED"
