					"nextDialogs": [
						4840402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840402,
					"content": "I Melmosi di Anemo sono creature aeree. Non lasciano tracce sul terreno, a meno che qualcuno non ne abbia schiacciato uno per decollare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840403,
					"content": "Aspetta... Stai dicendo che c'è qualcuno che lo fa davvero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840404
					],
					"speakerTitle": "Paimon"
				},
