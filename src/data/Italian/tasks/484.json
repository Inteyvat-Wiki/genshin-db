			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Grazie al cielo, sono arrivati i Cavalieri di Favonius! Gli Hilichurl non oseranno più inseguirmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Non riesco a crederci, ma... gli Hilichurl hanno attaccato i nostri carri. Per fortuna li ho seminati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "Gli Hilichurl? Pensavo che i Cavalieri di Favonius avessero sgombrato la maggior parte dei loro accampamenti in questa zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "È un accampamento piccolo, non troppo lontano dal villaggio. La strada che faccio per le mie consegne mi permette di starne alla larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Ma oggi... uno squinternato è piombato improvvisamente dal cielo ed è atterrato proprio nell'accampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Mmh... Questo mi ricorda qualcuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Si sono infuriati. Hanno inseguito quel tipo bizzarro mentre scappava, e così sono usciti allo scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Io sono riuscito ad allontanarmi, ma hanno ridotto in mille pezzi i miei carri di frutta. Non so cosa farò quando arriverà la carovana di mercanti domani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "...Un tipo bizzarro? In che senso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Portava qualcosa con sé. Doveva essere pesante, perché non riusciva proprio a volare in linea retta... Forse è per questo che è caduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Onestamente, gente del genere non dovrebbe proprio volare. Non ci vuole un genio per capire che non si possono trasportare oggetti pesanti in volo! Denuncerò quell'idiota e mi assicurerò che gli venga ritirata il brevetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Un oggetto pesante... Il manufatto? Potrebbe essere il nostro uomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Dimmi, hai visto da che parte è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Sono riuscito a intravederlo mentre scappavo dagli Hilichurl. Credo che sia andato... da quella parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Sembra una buona pista. {NICKNAME}, torniamo all'inseguimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Ah, e non preoccuparti: appena torno alla base dirò ai Cavalieri di eliminare il resto degli Hilichurl il più presto possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
