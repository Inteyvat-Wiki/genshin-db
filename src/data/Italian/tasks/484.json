			"dialogs": [
				{
					"id": 4840201,
					"content": "Questo è il Villaggio Acquachiara. Dovrebbero esserci indizi su Raptor in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840202,
					"content": "La sorella della cattedrale ha apposto dei marchi di Anemo segreti sul manufatto che ha rubato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840203,
					"content": "Usa la tua <color=#00E1FFFF>Vista Elementale</color> e fai attenzione agli indizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48409,
			"completionStepIds": [
				48409,
				48411,
				48424
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
