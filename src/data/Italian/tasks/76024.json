			"dialogs": [
				{
					"id": 760240101,
					"content": "Eheh. Questa è la fine della corsa per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Eh. È la prima volta che vedo la Donnoladra capo così da vicino... Ah, giusto. Paimon, devi chiamarla \"capo\" anche tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "Eh?! Paimon non chiamerà mai una Donnoladra, \"capo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Hai ragione. I bambini cattivi non possono diventare dei capi, vero? E nessuno andrà ai loro funerali... sempre che glieli facciano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Oh, giusto! Ho sentito Helka dire che ci sono persone particolari che mangiano carni strane, come quelle delle Donnoladre. E ci sono anche delle persone che amano collezionare esemplari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Mangiarli o raccoglierli non cambia nulla, non ci sarà bisogno di funerali dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Woah, Auni... Riesci davvero a dire tutte queste cose spaventose con un'espressione così seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Sembra terrorizzata...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Capo delle Donnoladre"
				},
				{
					"id": 760240136,
					"content": "Ferma! Non osare scappare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Eh? Non sembra voler scappare... ma ci sta aspettando? Beh, andiamo a vedere che succede, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
