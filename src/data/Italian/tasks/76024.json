					"Auni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760240801,
					"content": "Ah, giusto. Devo ancora organizzare quel funerale. Mi chiedo se dovrei invitare gli altri della Banda della Conchiglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "A proposito della Banda della Conchiglia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "Oh, ti piacerebbe unirti? Se vuoi farlo, devi parlare con Jurva. Si trova al \"Speranza\". Però Helka non c'è, quindi non potrà votare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Non importa. Sono sicuro che Jurva troverà una soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "A proposito delle Talpe fiutatrici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Immagino che abbiano iniziato ad adottare le abitudini umane vivendo al loro fianco per così tanto tempo. Anche le Donnoladre lo fanno, e mi dicono che anche i Saurici a Natlan facciano lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Non so se sia una cosa positiva o negativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "Buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
