			"dialogs": [
				{
					"id": 760241501,
					"content": "Oh, guarda! C'è tutta la famiglia Talpa. Nonno, Papà, Mamma, Talpino e Talpetta... e tutti gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Oh, quindi sono Talpe fiutatrici! Aspetta, come fai a distinguerle? A Paimon sembrano tutte uguali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Dalla loro personalità, ovviamente! Lo capirai se le conosci meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Ma hanno tutte la brutta abitudine di chiedere cose agli umani. *sospira* Povere creature. Se ci estinguessimo, cosa ne sarebbe di loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "...Gli umani? Estinguersi? Ma le Talpe fiutatrici sopravviverebbero? È i-impossibile, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Linnea dice che gli animali si estinguono per svariate ragioni. Questo significa che anche gli umani possono estinguersi. Come fai a non saperlo, Piccolissima Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "Voglio pensare che sopravviverei più a lungo di una Talpa fiutatrice, almeno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Questo non risponde davvero alla domanda di Auni, no? Mmmh... A pensarci bene, gli umani sono davvero in costante pericolo! Sono tante le cose che potrebbero minacciare la loro esistenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Comunque, tornando al punto... Che ne facciamo di queste Donnoladre ora che abbiamo trovato le nostre talpe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Se nessuno ha un'idea migliore, perché non li portiamo all'Ammiraglia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Un tesoro! O è più una tangente in questa situazione? Bah, a chi importa. Dal momento che ce lo stanno dando, tanto vale prenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Beh, almeno sembrano pentite. Lasciamole andare per questa volta, {NICKNAME}, ma non perché ci hanno dato il tesoro, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Si dice che gli insetti precedano gli umani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "E probabilmente saranno ancora qui anche quando noi non ci saremo più.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Aspetta, quindi gli insetti dureranno più degli umani? ... Ugh, Paimon non lo può accettare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
		}
