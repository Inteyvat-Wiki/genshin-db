						],
						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Sai, Paimon ha appena notato che tutte le Donnoladre sono scappate verso quella collinetta laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Sì. L'hanno portata quei tizi che hanno addestrato le Donnoladre. La Donnoladra capo gliel'ha usata contro. Li ha fatti rotolare e strisciare via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Una scena difficile da immaginare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Comunque, andiamo alla collina a indagare. Tieni gli occhi aperti per eventuali imboscate delle Donnoladre, {NICKNAME}. Paimon preferirebbe non rotolare... o strisciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "#Ah, se solo fossi {F#stata}{M#stato} lì in quel momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Aspetta, avresti voluto aiutare...? No, sicuramente volevi solo vedere il disastro in diretta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602405,
			"completionStepIds": [
				7602414
			],
