						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#Wow, sei molto più forte di quei ragazzoni, {NICKNAME}. A quanto pare le dimensioni non sono tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#Ihih, vero? {NICKNAME} non è la persona più alta del mondo, ma può fare a pezzi mostri dieci volte più grandi di {M#lui}{F#lei} senza problemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Oh, no, per carità. Mi ci diletto appena. La vera esperta è Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "Eh?! L'adulazione non ti farà avere... B-Beh, forse sì invece... metà della porzione di Paimon la prossima volta che mangeremo qualcosa di buono, che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#Allora puoi scacciare dalla Valletalpa le Donnoladre capo, vero, {NICKNAME}? Non è casa loro, ma fanno disastri come se lo fosse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Impediscono il corretto svolgimento dei funerali e nonno Talpa potrebbe essere stato ucciso per colpa loro. Ma se vogliamo organizzare nuovi funerali, prima dobbiamo trovarle tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Eh?! Hanno davvero... E poi, Paimon può chiederti... Quando parli di funerali, intendi che le persone li vogliono davvero organizzare qui? Perché proprio questo posto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "Certo. Ho fatto tutti i preparativi e ho anche pensato a quali canzoni cantare. Guardate, ma fate silenzio, per favore. Lasciamolo riposare in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni prende una piccola scatola di fiammiferi dalla tasca e la apre. All'interno, su un panno fiorato, giace uno scarabeo dai bellissimi colori. Ci sono persino alcuni petali bianchi che adornano la scena...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Il suo riposo è eterno, ora, ma dobbiamo organizzare il suo funerale. Ma tutti i luoghi che ho scelto sono delle collinette con delle macchine, e sono state tutte occupate dalle Donnoladre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Se la famiglia di nonno Talpa non è ancora fuggita, probabilmente è morta. È terribile il modo in cui le Donnoladre hanno distrutto la loro casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME}, pensi che questo \"nonno Talpa\" di cui parla sia in realtà...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Sospetto che sia una specie di animaletto.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(Sì, anche Paimon la pensa così. Probabilmente è un suo amico animale.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "Mmmh. Che ne dici se ti aiutiamo a catturare queste Donnoladre cattive? E per quanto riguarda la famiglia del nonno Talpa... Possiamo cercarla dopo aver consegnato quei ladri alla giustizia. Che ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "Eh. Siete davvero brave persone, voi due. Vi inviterò di sicuro al funerale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "Beh, non è proprio necessario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "Va bene. In questo caso, potete avere la scultura di zucchero che ho comprato prima... Oh. A quanto pare non c'è più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "Beh, ho ancora i soldi che mi ha dato Jurva. Potete prenderli e comprarvi delle sculture di zucchero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "Se chiedi aiuto alla gente, devi ripagarla e devi ringraziarla. È così che si fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Ah, Paimon. Chi l'avrebbe detto che avresti rubato le caramelle ai bambini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Aspetta un attimo! Perché fai passare Paimon per una cattiva? Comunque, Auni, sei davvero molto educata per essere così piccola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "Grazie! Ma ognuno di voi riceverà abbastanza Mora solo per una scultura di zucchero. Lusingarmi non vi farà ottenere ricompense aggiuntive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "E poi sei sorprendentemente pratica riguardo a queste cose... Comunque, sembra che abbiamo a che fare con una Donnoladra molto furba, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Sì, esatto. Quella che è scappata poco fa non è la stessa che avevo visto prima. In effetti, non ho idea di quante altre compagne possa avere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Ma è possibile trovare gli stessi roboartigli che sparano proiettili qui anche là, quindi potrebbero esserci altre Donnoladre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "D'accordo. Questa volta non lasceremo scappare le Donnoladre. Gli daremo una bella lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "Un'educazione impressionante, in effetti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Potrebbe essere qualcuno che viveva qui.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "(Eh? Ma questo posto non sembra essere stato la casa di qualcuno... Probabilmente è uno dei suoi amici animali! Dopotutto organizza funerali per gli scarabei!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Non sarò clemente neanche con i mostri più piccoli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
		{
			"id": 7602403,
