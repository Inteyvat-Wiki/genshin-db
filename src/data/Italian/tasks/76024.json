					}
				]
			},
			"dialogs": [
				{
					"id": 760240601,
					"content": "Scommetto che le Donnoladre capo stanno cercando di copiare quei tizi. Vogliono fare della famiglia Talpa i propri lacchè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Ma proprio come quei tizi hanno fallito, probabilmente anche loro non ci riusciranno. Hanno rovinato la Valletalpa, e adesso la famiglia Talpa si è nascosta da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "Meglio non aspettarsi troppo dalle talpe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "Sì, sono solo delle Talpe fiutatrici... e non è che le Donnoladre non abbiano già armi super pericolose! A pensarci bene... è davvero assurdo che le abbiano a prescindere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "La Valletalpa appartiene di nuovo al nonno Talpa e alla sua famiglia. Come concordato, ecco i vostri Mora. Grazie per l'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "Ah, sì. Tanto vale darvi anche questo. Helka ha detto che la narrativa non deve finire nel suo libretto, altrimenti diventerà difficile distinguere la verità dalla menzogna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Non sono sicura che sia importante... Anche le cose false contengono verità, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#Comunque, ci vediamo in giro, {NICKNAME}, Piccolissima Paimon. Tornerò a cercarvi se le Donnoladre capo dovessero fare qualche brutto scherzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#Ehehe, sembra che la nostra reputazione stia crescendo, {NICKNAME}! Paimon spera che quelle donnole non proveranno più a fare danni. Abbi cura di te, Auni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "Sì. Buon viaggio a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Si sono affidate agli umani anche per questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Beh, si tratta solo di Talpe fiutatrici... E se la guardiamo da un altro punto di vista, le Donnoladre hanno ottenuto quelle macchine pericolose solo per colpa degli umani. È solo giusto che siano gli umani a risolvere i problemi causati dagli umani stessi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
