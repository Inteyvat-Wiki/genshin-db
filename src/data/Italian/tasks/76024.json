						"pointId": 360700068
					}
				]
			},
			"dialogs": [
				{
					"id": 760240501,
					"content": "#Non sei {F#sicura}{M#sicuro} di cosa stia succedendo, ma ti avvicini alla bambina...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "Fate attenzione alle Donnoladre. Sono alla Valletalpa da un po'. Se vi prendono, diventerete anche voi delle persone senza ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "Donnoladre? Dove? E che intendi con \"persone senza ombra\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "Woah! Che succede con quella macchina? Le Donnoladre la stanno usando per attaccarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "Queste sono state allevate dagli umani... Potrebbero essere persino più intelligenti di loro. È così che hanno fatto scappare via tutti quei tizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "E i tizi ci hanno già provato e hanno fallito: tutto quello che bisogna fare è <color=#00E1FFFF>rimuovere il nucleo energetico</color>. Però non ci sono mai riusciti, quindi non dev'essere facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Mmmh, possiamo fermare le Donnoladre prendendo il nucleo energetico, giusto? Forza, {NICKNAME}, perché non ci provi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "Non possiamo mica lasciarlo qui con una bambina in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Se è questo che desidera, o grande Paimon, lo farò!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Tu rimani qui nascosta, ok, piccolina? Ah, giusto. Come ti chiami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Eh? Ma... non sei tu la \"piccolina\" qui? Non capisco... Ma comunque, mi chiamo Auni, e dovresti trattarmi come se fossi la tua sorella maggiore. È solo giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#Ehm... Lasciamo perdere questi titoli per ora... Dai, {NICKNAME}. Dobbiamo dare una bella lezione alle Donnoladre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
