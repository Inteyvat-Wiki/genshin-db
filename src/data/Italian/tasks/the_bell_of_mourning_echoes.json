			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Un momento, per favore! Paimon vorrebbe chiedervi una cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Mostri l'oggetto che hai ottenuto in precedenza ai due Guardaluce. Racconti loro anche di come una strana figura, con indosso gli abiti dei Guardaluce, abbia combattuto al tuo fianco per fermare la Caccia selvaggia...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "Che si tratti di Sigurd...? A quanto pare, non è riuscito a trovare pace neanche adesso. Se solo potessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Smettila, Lushne. Non è un fardello che devi portare da solo. Finché esisterà la Caccia, lui continuerà a combatterli. Tutto ciò che possiamo fare è compiere la nostra missione al meglio delle nostre capacità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Allora... questo Sigurd, era un Guardaluce anche lui, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Sì. Era uno Starsina formidabile, e quando la Caccia selvaggia si abbatté su Nod-Krai, combatté valorosamente fino alla fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "Si dice che le bestie feroci tremino quando sentono la campane d'allarme, rimanendo così terrorizzate da non voler più proseguire... Eppure voi due avete trovato le sue reliquie. Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Se potete, portate le reliquie sulla sua tomba. Si trova vicino alle rovine del campo di battaglia orientale sull'Isola di Lempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Sarà fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Grazie. Che il giorno in cui il suo spirito potrà riposare giunga presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
