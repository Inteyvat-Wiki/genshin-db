					"Granmaestro Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Stupendo, stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727360102,
					"content": "Non mi aspettavo che la Banda di Arataki sconfiggesse così tanti forti combattenti. Pare che siate esperti in quest'arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727360103,
					"content": "Ritiro quello che ho detto. Siete degli avversari degni e rispettabili, e devo affrontarvi impegnandomi al massimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727360104,
					"content": "Bene, bene! Toro sdraiato, sei il nostro leader. È il tuo momento di brillare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "E, uff, non prendere seriamente quello che ho detto prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Tocca a te, Re Combattente Stercorario Supremo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Ahahahahahah! Oh, si comincia! La battaglia finale, nonché la mia imminente vittoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Non so come tu abbia addestrato la tua squadra, ma i risultati parlano da soli: la Banda di Arataki spacca di brutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Granmaestro Hanakado, preparati a combattere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Il Re contro il Granmaestro! Sarà epico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
