			"dialogs": [
				{
					"id": 721280401,
					"content": "Perfetto! Proprio quelle che mi servivano. Coraggio, scegli un baule e aprilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280402,
					"content": "Un baule solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "No, no... Uno alla volta. Mi spiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Bene, scegli pure quello che preferisci. Buona fortuna, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280403,
					"content": "Non posso aprirli tutti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				}
			]
		},
		{
			"id": 7212805,
