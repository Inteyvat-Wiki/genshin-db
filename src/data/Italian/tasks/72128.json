			"dialogs": [
				{
					"id": 721280501,
					"content": "Deduco tu abbia aperto un baule, eh? Ahahah, spero ti sia andata bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280502,
					"content": "Quindi stai collezionando queste conchiglie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Puoi dirlo forte. Altroché se le colleziono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Ma al momento non posso dirti il perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "Hanno qualcosa di speciale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "Dal punto di vista commerciale direi proprio di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "\"Le conchiglie un tempo influenzate dal Tatarigami\"... Ahahah, si venderanno a peso d'oro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "Ehm... A ogni modo, tu continua a procurarmele e io ti farò aprire i bauli. Facile, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "#Comunque sia, per stavolta ti sei giocat{F#a}{M#o} un'opportunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Se vuoi aprire un altro baule, torna in seguito con altre conchiglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "Sei un tipo sospetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
					"id": 721280510,
					"content": "#Stiamo parlando di banali conchiglie, accidenti. Non essere così paranoic{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				}
			]
		},
