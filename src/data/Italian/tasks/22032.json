					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "Eh? Credo che questo sia un piatto di Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320502,
					"content": "Non penso sia il piatto che ti avevo chiesto... Beh, non importa, anche questo sazia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320503,
					"content": "#Ti ringrazio comunque, viaggiat{F#rice}{M#ore}. Tieni, per sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203206,
			"completionStepIds": [
				2203206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
