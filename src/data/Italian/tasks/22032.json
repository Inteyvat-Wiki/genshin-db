				"points": []
			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "Ah! È proprio questo! Questo è il sapore di casa che sognavo... È... *piange* Sono così commossa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320302,
					"content": "Grazie davvero! Mi sento rinata grazie a tutto questo buon cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320303,
					"content": "Questi sono per te. Ti auguro un viaggio sereno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203204,
