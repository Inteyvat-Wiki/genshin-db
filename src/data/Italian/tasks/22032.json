			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Ahhh, sarebbe così bello poter mangiare qualche piatto di Liyue adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "#Ah, quei vestiti... Tu sei {F#la}{M#il} viaggiat{F#rice}{M#ore}, giusto? Scusa, è che mi manca un po' casa mia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Hai detto che hai voglia di mangiare qualche piatto di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Eh? Vuoi dirmi che... sai come preparare i piatti di Liyue? Ma è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "A-Allora aiutami, ti prego! Preparami qualche delizia tipica di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Fammi pensare... Quello che vorrei davvero mangiare al momento è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Mmmh... Vorrei del pesce! Mi manca il pesce che mi preparava la mia mamma quando ero piccola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "Lavava il pesce, lo tagliava da entrambe le parti e lo riempiva con spezie e vino invecchiato per poi marinarlo leggermente, dopodiché lo friggeva in una padella per farlo imbrunire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Poi aggiungeva acqua calda e salsa e lo lasciava cuocere a fuoco lento. Infine, lo condiva a fuoco alto per far addensare la salsa, lo impiattava e lo serviva... Ah, era delizioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "Mio fratello minore saltava e gridava felice: \"È pronto! Il cibo è pronto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "*singhiozza* Mia mamma è davvero brava a cuocere il pesce, ma quando potrò tornare a mangiarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Posso aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Ah, giusto! Lascia che mi presenti. Sono Tang Wen, una storica di Liyue. In passato, ho svolto alcune ricerche sui costumi e sul folklore unici di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "Avevo appena finito di procurarmi tutto il materiale che mi serviva e stavo per ripartire per Liyue. Ma di recente sono successe un sacco di cose importanti a Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "Mi sembra di vivere in un periodo davvero importante a livello storico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "Sono certa che questi avvenimenti lasceranno un'impronta profonda negli annali della storia di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "Osservare la storia con i propri occhi e prendere nota di tutto in maniera veritiera, completa e chiara per i posteri è ciò che dovrebbe fare uno storico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "Ma... questa causa non riuscirà a soddisfare il mio stomaco, per quanto l'abbia a cuore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Abbiamo fame, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Beh, non esattamente... Il cibo qui a Inazuma è molto saporito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "Mi piace molto come preparano la tempura, anche se, beh... Impanano tutto, lo friggono e basta, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "Ma dopo tanto tempo a gustare le prelibatezze di Inazuma, comincia a mancarmi la cucina del mio paese natale. Purtroppo non sono riuscita a trovare un ristorante qui che prepari piatti autentici della tradizione di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "Ho così deciso di pubblicare un \"incarico culinario\" presso la Gilda degli avventurieri qualche giorno fa, ma non ho ancora ricevuto nessuna risposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "Posso provarci io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
