			"dialogs": [
				{
					"id": 220320201,
					"content": "#Già di ritorno? Sei per caso un{F#a}{M#o} chef sotto mentite spoglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "Mmmh... Non riesco più a resistere, fammi assaggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Buon appetito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Vediamo... Di che piatti stavamo parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Oh, giusto... Pesce scoiattolo, stufato di persico a dorso scuro e pesce alla griglia di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Scegliamone uno e diamolo alla signorina Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203203,
