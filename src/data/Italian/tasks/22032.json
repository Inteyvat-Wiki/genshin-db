			"dialogs": [
				{
					"id": 220320701,
					"content": "Allora, che piatto a base di pesce dovremmo preparare? Che ne dici di sceglierne uno per lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320702,
					"content": "Vediamo... I piatti a base di pesce preferiti di Paimon negli ultimi tempi sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320703,
					"content": "Stufato di persico a dorso scuro piccante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320704,
					"content": "Pesce scoiattolo in agrodolce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320705,
					"content": "E il potente pesce alla griglia di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320706,
					"content": "Non sono tutti i tuoi piatti preferiti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "Hihi, fidati dei gusti di Paimon! Dai, scegline uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320708,
					"content": "Vada per lo stufato di persico a dorso scuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "Benissimo! Dai, prepariamo subito un po' di stufato di persico a dorso scuro per la signorina Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320710,
					"content": "Vada per il pesce scoiattolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "Evviva! Dai, prepariamo subito del pesce scoiattolo per la signorina Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320712,
					"content": "Vada per il pesce alla griglia di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "Ottimo! Dai, prepariamo subito del pesce alla griglia di Mondstadt per la signorina Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320714,
					"content": "Fammici pensare di nuovo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "Uhm, allora decidiamo e poi prepariamo il piatto per la signorina Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
