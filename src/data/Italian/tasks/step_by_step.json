			"dialogs": [
				{
					"id": 200470201,
					"content": "Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "Ti prego, dipende tutto da te! Le tue scoperte saranno decisive per tutta la mia avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
