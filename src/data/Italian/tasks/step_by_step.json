			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Non c'è NIENTE di meglio di un piano perfetto quando sei all'avventura! Come si può sperare di compiere progressi, continuando ad agire alla rinfusa in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200470102,
					"content": "Se il piano non è perfetto, bisogna essere pronti a tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Perché state discutendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Ah, ecco, stiamo pianificando un'esplorazione all'interno del <color=#00E1FFFF>Tempio dei Mille Venti</color>. Ma la signorina Patchi qui presente non ha alcuna esperienza da avventuriera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "L'interno del tempio pullula di mostri, per non parlare della terrificante Guardia delle rovine all'ingresso... Se saremo troppo avventati, non faremo altro che mettere a rischio le nostre vite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Sto solo cercando di garantire la sicurezza della signorina Patchi... Beh, la nostra sicurezza in genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Sto cercando di farle comprendere i vantaggi dello stilare un piano scrupoloso e a prova di stupido per quest'avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Ma temo che, se inizieremo con una semplice ricognizione intorno al tempio, Patchi si emozionerà troppo e vorrà entrare a capofitto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Devo stare qui e tenerla d'occhio. Potresti farmi il favore di perlustrare l'area?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Splendido! Ma assicurati di osservare tutto molto attentamente. Un unico dettaglio tralasciato potrebbe comportare il fallimento della nostra avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Qualsiasi cosa succeda, devi raccontarmi tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Perché non posso rimanere io a tenere d'occhio Patchi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "N-No, non puoi! Ci... ehm, sono tantissimi dettagli del piano attuale di cui ho bisogno di discutere con lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Aiutarmi a cercare indizi. Ti prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
