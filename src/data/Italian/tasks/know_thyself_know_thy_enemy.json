		},
		{
			"id": 1200102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200102",
							"2"
						],
						"stepId": 1200102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "Quindi, come facciamo a scoprire se il borghese Maocai è effettivamente colluso con i Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "Dobbiamo trovare una prova inequivocabile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "Quindi... andiamo semplicemente a cercarlo? Se abbiamo fortuna, lo coglieremo in flagrante; in caso contrario, possiamo provare a minacciarlo e vedere se canta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Parliamo prima con le guardie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "Va bene, capo! Agli ordini, capo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "Dobbiamo coglierlo in flagrante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wu il Robusto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Chi va là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010302,
					"content": "#{F#Una}{M#Un} mercante di Mondstadt. Sono qui per incontrare il borghese Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Davvero? Non me ne aveva parlato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010306,
					"content": "Oggi il maestro è impegnato in affari urgenti. Tutti gli appuntamenti sono stati cancellati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010307,
					"content": "Affari urgenti? Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Il maestro ha lavorato a un affare molto importante, ultimamente. È uscito presto questa mattina per incontrare un cliente di alto profilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010309,
					"content": "Quindi, adesso dov'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Mi dispiace, il maestro si è raccomandato di non divulgare quest'informazione a nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010311,
					"content": "\"Nessuno\"? Stai forse insinuando che non siamo clienti di alto profilo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "N-No! Voglio dire, sì, certo che lo siete! Ah... N-Non intendevo offendervi, vi prego di credermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010313,
					"content": "Portami dal borghese Maocai o ne pagherai le conseguenze!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Mi dispiace, davvero! Il maestro al momento è impegnato in certe trattative alla Pagoda di Xinyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010316,
					"content": "Imploro pietà! Per favore, il mio maestro non mostrerà alcuna clemenza, se scopre che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010317,
					"content": "#Beh, {F#la MIA padrona}{M#il MIO padrone} ha cose molto più importanti da fare che perdere tempo con guardie maleducate come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Per tua fortuna, non avremo tempo di pensare al tuo brutto atteggiamento quando il mio capo sarà impegnat{F#a}{M#o} a parlare d'affari con il tuo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "G-Grazie, grazie! Che i vostri affari siano per sempre benedetti dal Signore di Geo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Wu il Robusto"
				},
				{
					"id": 120010320,
					"content": "#Ottimo lavoro, {NICKNAME}! Paimon non sapeva fossi un osso così duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Stavo solo bluffando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Davvero? Ora Paimon sa che dovrà fare attenzione alla tua astuzia in futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Comunque sia, pare che il cliente d'alto profilo in questione sia uno dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Penso che tu abbia ragione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "In tal caso, andiamo alla Pagoda di Xinyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Potremmo sfruttare questa circostanza a nostro favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Sei stata grande anche tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Ihihih! Paimon adora i complimenti... Certo se offrissi a Paimon uno spuntino delizioso, dimostreresti che lo pensi davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Vuoi spiegare tu al tuo capo perché dovrà intascare meno del previsto, o ci devo pensare io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Sono {NICKNAME}, {F#una}{M#un} cliente d'alto profilo del tuo capo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Che strano, non sei nella lista degli invitati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu il Robusto"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Borghese Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Capisco. Davvero. Non preoccuparti, hai la mia parola che l'ordine sarà evaso come promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Borghese Maocai"
				},
				{
					"id": 120010702,
					"content": "Mmmh... Il subordinato che ho mandato a indagare non sembrava altrettanto ottimista. C'è forse qualcuno che non collabora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Agente"
				},
				{
					"id": 120010703,
					"content": "Ah... Ci siamo solo imbattuti in un piccolo problema di approvvigionamento, tutto qui. Non siamo ancora riusciti ad acquistare il Cor Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Borghese Maocai"
				},
				{
					"id": 120010704,
					"content": "Ma non c'è da preoccuparsi. Se Chang il Nono non vende, posso comprare da qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Borghese Maocai"
				},
				{
					"id": 120010705,
					"content": "Sarebbe la soluzione ideale. Ti ricordo ancora una volta che ai Fatui interessa solo il risultato finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Agente"
				},
				{
					"id": 120010706,
					"content": "Siamo disposti a offrire un certo grado di supporto per questa transazione. Ma se non venisse conclusa per tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Agente"
				},
				{
					"id": 120010707,
					"content": "...potresti scoprire tutto d'un tratto che la nostra buona volontà ha un prezzo che non puoi permetterti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Agente"
				},
				{
					"id": 120010708,
					"content": "Capisco... Vi sono debitore per la vostra protezione. Lo sai che non mi sognerei mai di deludervi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Borghese Maocai"
				},
				{
					"id": 120010709,
					"content": "Lo vedremo quando sarà il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Agente"
				},
				{
					"id": 120010710,
					"content": "*sospira* Accidenti a quel Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Borghese Maocai"
				},
				{
					"id": 610045701,
					"content": "Quindi, il signor borghese Maocai è in combutta con i Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Chissà se Secchioguhua avrà fatto progressi... Dovremmo andare a dirglielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Bah! Avevi detto di avere altre faccende da sbrigare, facevi tanto il misterioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Invece volevi solo cercare un posto dove parcheggiare il tuo deretano e leggere quel libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Adesso sappiamo cosa sta tramando il borghese Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Capisco. Immaginavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Lo immaginavi davvero o lo dici solo per sembrare intelligente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Adesso ho ben chiaro quello che dobbiamo fare. Per prima cosa, consegnate questa lettera alla Gilda dei commercianti di Feiyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "Per ragioni che non posso spiegare, non potrò unirmi a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "Non è necessario che leggiate il contenuto della lettera, quando sarà il momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Wow, questa lettera è super difficile da leggere! Paimon non ci capisce niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "È forse una lingua antica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Ecco perché ho detto che non è necessario che la leggiate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "Alla Gilda dei commercianti di Feiyun sapranno come decifrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Ma come mai vuoi coinvolgerla? È una delle gilde commerciali più potenti di Liyue... Perché dovrebbe aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "Cos'è la Gilda dei commercianti di Feiyun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Da quando siamo arrivati a Liyue, Paimon continua a sentirne parlare. Sembra gestiscano molti degli affari che si svolgono da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Avere il loro appoggio sarebbe fantastico, certo... ma sei sicuro che saranno disposti ad aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Non c'è bisogno di preoccuparsi per questo. Da quello che so, condividono i miei stessi valori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Una volta che avranno esaminato il caso che ho attentamente esposto e argomentato con passione in questa lettera, non esiteranno a intervenire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Come puoi esserne così sicuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Il borghese Maocai merita una bella lezione, ma non possiamo farcela da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Inoltre, non voglio che nessun altro sappia del mio coinvolgimento in questa vicenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Perché no? Lo stai facendo solo per aiutare Chang il Nono, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"Scomparire silenziosamente alla conclusione dell'impresa, celando il proprio nome e il proprio contributo\"... Questo fa un vero cavaliere. Assaporare il ricordo è una ricompensa sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Ho il dovere di ripagare ogni goccia di gentilezza che ricevo con una fonte zampillante di gratitudine. Non cerco lodi o ricompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Sembra tutto molto nobile, ma sii onesto: vuoi solo che se ne occupino loro, così potrai continuare a leggere quel tuo libro, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Grazie per aver accettato di consegnare la lettera. Qualcuno della Gilda dei commercianti di Feiyun dovrebbe essere in grado di ricevervi nei pressi della Padiglione Liuli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Ehi! Smettila di ignorare Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "A ogni modo, che motivo c'è di coinvolgerli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Un testo cifrato che necessita di una chiave di lettura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}