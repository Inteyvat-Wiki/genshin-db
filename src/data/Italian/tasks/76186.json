			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860103,
					"content": "...Allora, come se la cavano gli Eredi della Luna gelata, ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860104,
					"content": "Non c'è male. Il ritorno della Dea della Luna ci ha reso ancora più determinati a percorrere il cammino che ci è stato assegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Davvero? Beh, mi fa piacere sentirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Eh... Sembra che non abbiamo davvero nulla di cui parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860109,
					"content": "Temo che sia... perché tra gli Eredi della Luna gelata e i Fatui non c'è mai stato un rapporto idilliaco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Parlando a titolo puramente personale, ti sono grata per ciò che hai fatto per il bene di Nod-Krai e per averci ridonato la Dea della Luna, Sandrone. Ma per quanto riguarda i tuoi collaboratori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Ho capito. Per una ragione o l'altra, non siamo riusciti a stabilire relazioni amichevoli né reciprocamente vantaggiose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860112,
					"content": "Ma i Fatui non intendono sottrarre più nulla agli Eredi della Luna gelata, e ho ricordato ai miei subordinati di non creare difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860113,
					"content": "Dal mio punto di vista, dato che siamo vicini, anche se non possiamo coesistere in perfetta armonia, sarebbe bello se potessimo trattarci con rispetto reciproco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860114,
					"content": "Temo che per quello ci vorrà tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Senza dubbio, ma possiamo iniziare facendo un passetto alla volta. Vorresti assaggiare questa tisana che ho preparato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860116,
					"content": "Oh, una tisana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Mmm... Che sapore intenso. L'hai preparato seguendo il metodo degli Eredi della Luna gelata? La maggior parte degli stranieri che ho incontrato non apprezza il nostro tè. Come hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Con lo studio. E il rispetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860119,
					"content": "Ah... Non male, come primo passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Spero che sia di tuo gradimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860121,
					"content": "Mi piace molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Gli scambi amichevoli davanti a una tazza di tè caldo sono sempre stati un ottimo modo per instaurare rapporti cordiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Ho la sensazione che questa volta non farà eccezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
