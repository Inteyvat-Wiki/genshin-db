			},
			"dialogs": [
				{
					"id": 761860201,
					"content": "Una tisana davvero deliziosa, Sandrone. È come se riuscissi ad assaporare la tua sincerità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761860204,
					"content": "Bene. La prossima volta sarò io a ricambiare la cortesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
}