						200050402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050402,
					"content": "Ho trovato questa chiave. È tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200050403
					]
				},
				{
					"id": 200050403,
					"content": "Sì! È proprio lei. Non posso permettermi che accada di nuovo... Devo proprio darmi una regolata con l'alcol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050404
					],
					"speakerTitle": "Wyatt"
				},
				{
