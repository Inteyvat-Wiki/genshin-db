			"dialogs": [
				{
					"id": 200050201,
					"content": "Hai trovato la mia chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050202
					],
					"speakerTitle": "Wyatt"
				},
				{
