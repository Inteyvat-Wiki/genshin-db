			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Degui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Gli affari vanno proprio a rilento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Stavo dicendo che è sempre più dura far fruttare un minimo questa taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Per chi come me lavora nella ristorazione, avere una tradizione da rispettare è una benedizione e una maledizione allo stesso tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "Certo, il fatto che tutti ci conoscano è di grandissimo aiuto. Come dire, abbiamo una reputazione non indifferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "Il problema, però, è che la stessa minestra riscaldata viene a noia molto presto. I grossi ristoranti possono sempre variare, quindi la cosa non li tocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Io invece gestisco una piccola taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "I miei clienti abituali iniziano a stancarsi di ciò che offro, e uno dopo l'altro mi stanno abbandonando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "Pare che a Mondstadt l'industria del vino sia molto importante. In particolare quella del vino di denti di leone, teoricamente realizzato con questi fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Non sono sicuro che sia davvero possibile utilizzare denti di leone, però vorrei almeno fare un tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Potresti andare a Mondstadt e recuperare alcuni denti di leone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Fantastico! Ti ricompenserò per i tuoi sforzi, te l'assicuro. Qui a Liyue manteniamo sempre le promesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Vino di denti di leone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Pensi abbia uno strano sapore? È probabile, ma sembra molto popolare a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Ovviamente, se mi limitassi a copiare la ricetta originale non si venderebbe mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Comunque sia, intanto portami dei <color=#00E1FFFF>denti di leone</color>, per favore. Nel frattempo penserò a come aggiungere un \"pizzico di Liyue\" al processo di vinificazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
