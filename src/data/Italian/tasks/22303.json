					"Degui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030301,
					"content": "Per cominciare sperimenterò un pochino. Chissà se posso aggiungere i denti di leone al processo di vinificazione tipico di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Oh, dimenticavo. Ecco qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Non mi aspetto di azzeccare tutto al primo colpo, credo serviranno vari tentativi. Se finirò i denti di leone, potrei chiederti di portarmene ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		}
	]
