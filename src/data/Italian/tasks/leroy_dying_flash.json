			},
			"dialogs": [
				{
					"id": 741490701,
					"content": "Avete dimenticato quello che vi ho chiesto di fare? Ah, i bambini hanno sempre la memoria corta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490702,
					"content": "La prima cosa che vi ho chiesto è di aiutarmi a pulire l'entrata e il retro della casa. La seconda è di dare alla mia gatta Nana qualche pesciolino da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		}
	]
