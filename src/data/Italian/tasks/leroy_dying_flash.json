			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoît Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "La camicia di Athos, 1.000 Mora... La collana di Morticia... Tsk, tsk. I giovani d'oggi di sicuro sanno come spendere i soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490202,
					"content": "Salve, Monsieur Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Ehilà! Ci manda Euphrasie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "#Spiegate al Monsieur Leroy perché siete {F#venute}{M#venuti} da lui.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Ahahah, sono passati sei mesi, vero? Non pensavo che Euphrasie avrebbe conservato quell'incarico tanto a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490206,
					"content": "È vero, ho pensato di assumere dei lavoratori a ore. Dopotutto, anche i più abili di noi diventano vecchi e hanno bisogno degli altri per prendersi cura di sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490207,
					"content": "Ho lavorato tanti anni per avere questa casa, ma alla mia veneranda età, mi sono reso conto di non avere nessuno con cui condividerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490208,
					"content": "Questo mi ha rattristato per un bel pezzo. Tutto sommato è un bene che mia figlia e mio genero siano venuti qui per prendersi cura di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490209,
					"content": "Sono dei bravi ragazzi, si amano tanto e mi tengono compagnia. Non potrei chiedere di meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490210,
					"content": "#Quindi, per riassumere, {F#giovincella}{M#giovanotto}: non ho più bisogno di assumere qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490211,
					"content": "#Quindi siamo {F#venute}{M#venuti} qui per niente...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Beh, suvvia, niente musi lunghi, ora. I giovani non devono rattristarsi. Devono godersi la vita al massimo e vivere con il sorriso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490214,
					"content": "#Comunque, visto che siete {F#venute}{M#venuti} fin qui e che vi ha raccomandato Euphrasie, in effetti avrei una cosa da farvi fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490215,
					"content": "Al momento, mia figlia e mio genero non ci sono e non riesco a occuparmi di tutto quanto. Ovviamente vi pagherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490216,
					"content": "Ooh, bene! Sei proprio un brav'uomo, Monsieur Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Ahahah! E tu, mia cara, hai una bella parlantina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490218,
					"content": "Perfetto! Allora, aiutatemi a pulire le macchie di fianco alla porta e dietro la casa e date a Nana qualche pesciolino da mangiare, già che ci siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490219,
					"content": "Giusto, ho dimenticato di dirvelo: Nana è la mia gatta, quella lì vicino alla porta. Grazie in anticipo da parte sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490220,
					"content": "Beh, sembra semplice. Nessun problema! Lascia fare a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Ah, quella Euphrasie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
			],
