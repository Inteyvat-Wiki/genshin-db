			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoît Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "Finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490502,
					"content": "Esatto, Monsieur Leroy. Ah, comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Mh? Che c'è? Vuoi delle caramelle? O vuoi la tua paghetta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490504,
					"content": "Entrambe, eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Ahah, che bambina avida. Ma va bene lo stesso. È così che dovrebbero essere i bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490507,
					"content": "Specialmente le piccole bambine carine come te, Paimon. Macaron, bei vestiti e una bella casa: ecco cosa ti meriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490508,
					"content": "#Eheh, lo crede anche Paimon! Ehi, {NICKNAME}, non è che...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#Ueeeeh! Sei {F#una taccagna}{M#un taccagno}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "#Siamo {F#avventuriere}{M#avventurieri}, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Paimon comunque non capisce perché questo vada in conflitto con l'avere macaron, gonne o case grandi e belle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "#Ehi, ehi! Cos'è questa discussione, così all'improvviso? Tsk, i giovani d'oggi. Beh, qualche battibecco ogni tanto è una buona cosa, dimostra che siete ancora {F#bambine}{M#bambini}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490515,
					"content": "A proposito, io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Apprezzate la vostra giovinezza. Non durerà per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490518,
					"content": "...Comunque ecco qua: caramelle e monete. Ora comportatevi bene, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490519,
					"content": "Evviva, spuntini! Grazie, Monsieur Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Chiamami Benoît, piccola. Leroy è il mio cognome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490521,
					"content": "Sono l'ultimo Leroy dell'intera Corte di Fontaine. Sentirmi chiamare per cognome mi dà solo un gran senso di solitudine, per cui ti prego, chiamami per nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490522,
					"content": "Monsieur Le... Cioè... Benoît, ma quindi... tua figlia non ha il tuo cognome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia non è davvero mia figlia. L'ho presa con me sei mesi fa, ma nonostante questo la considero come sangue del mio sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490524,
					"content": "Venite domani, se non vi dispiace, per quell'ora lei e Athos dovrebbero essere già tornati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490525,
					"content": "#Sono sicuro che non le dispiacerà ospitare due adorabili {F#giovincelle}{M#giovincelli} come voi per uno spuntino, soprattutto dopo che mi avete aiutato con le faccende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490526,
					"content": "#Ogni tanto vengono anche altri bambini. Sentitevi {F#libere}{M#liberi} di giocare anche con loro. Adoro i bambini: più ce ne sono, più questa casa si riempie di gioia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490527,
					"content": "Se non mi vedete quando tornate, bussate e chiedete di me. Vi aprirà Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490528,
					"content": "Va bene! Ci vediamo domani, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "Bene, bene. Ora farò meglio a rientrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490530,
					"content": "A domani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "#Ci si vede, {F#bambine care}{M#bambini cari}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490516,
					"content": "È il nostro modo di andare d'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Non perdere di vista il motivo per cui viaggiamo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
		{
