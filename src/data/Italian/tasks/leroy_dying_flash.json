			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "C'è qualche nuovo lavoro da fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Mh? Immagino che gli incarichi qui ai Racconti di umanità non rappresentino una grossa sfida per te... Oppure hai bisogno di fare soldi velocemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Beh, i Mora non sono mai abbastanza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Mh-mh. Un pensiero comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Una cosa che non manca mai qui è il lavoro. In effetti, potremmo dire che l'Uccello a vapore è il più grande sportello per il lavoro sulla piazza, escludendo la Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Beh, dico così, ma in realtà non abbiamo bisogno di occuparci di servizi sociali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "In ogni caso, visto che ti servono Mora, posso consigliarti un certo lavoro a lungo termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Questa è una nota che Monsieur Leroy ha lasciato più di sei mesi fa. La maggior parte di quelli che vivono in questa strada lo conosce molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Sebbene da giovane avesse una reputazione non proprio encomiabile, non ho sentito nessuna voce disdicevole nei suoi confronti negli ultimi tempi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "È rimasto solo per la maggior parte della sua vita. La sua unica figlia è andata via, quindi non c'è nessuno a prendersi cura di lui... Direi che è una persona a cui farebbe comodo l'aiuto di un lavoratore a ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "#Da quel che so, non è assolutamente al verde, per cui sarai ben {F#ricompensata}{M#ricompensato}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Un lavoro ben pagato e praticamente privo di rischi. Io ci farei un pensierino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Quindi dovremmo solo aiutarlo con le faccende di casa? Per Paimon non è affatto male come lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Dammi il suo indirizzo, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Ma certo. Svolta l'angolo due volte, poi gira intorno a... Mmh, facciamo che ti do una mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Ricordati di dirgli che ti ho raccomandato io per questo lavoro, capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Un po' l'uno e un po' l'altro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#{F#Una}{M#Un} giovane molto diligente, vedo. Ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
