	"talks": [
		{
			"id": 2250101,
			"completionStepIds": [
				2250101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"2"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Mmm... No, questo verso non va bene. Proprio per niente. *sospira* Devo proprio andare a vedere di persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "#Come procede la sua giornata, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}? Mi chiamo Qingzhou e mi piace definirmi un poeta, se mi consente l'audacia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "Per un qualche scherzo del fato, di recente ho ricevuto una scintilla d'ispirazione poetica, che aspetta però ancora di ardere come merita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "In questo periodo, i cieli sono inconsueti... I meteoriti si schiantano al suolo con una pioggia di fuoco... Uno spettacolo raro, per questo mondo mortale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "Ho avuto un'illuminazione... Forse volgere lo sguardo verso un meteorite e osservarlo da vicino potrebbe far sbocciare la prossima, sfuggente frase della mia poesia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "P-Potrebbe non essere una grande idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Non una grande idea? Cosa intende dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"3"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"2"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "Quale parte della mia idea sarebbe \"non grande\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010202,
					"content": "Toccando quei meteoriti, perderai i sensi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ah, sì. Ne ho sentito parlare. Ma il solo osservarli da vicino non potrà certo nuocermi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010204,
					"content": "Prometti che non li toccherai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "B-Beh, cercherò di dar prova di moderazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250103,
			"completionStepIds": [
				2250103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
