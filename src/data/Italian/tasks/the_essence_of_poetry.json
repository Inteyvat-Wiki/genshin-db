				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010601,
					"content": "Non tutto quello che scrivi deve sconvolgere il mondo, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "Lei dice il vero... L'ispirazione migliore è quella divina... e le mani più abili sono guidate dal fato. Eppure, questo componimento mi affligge da troppo tempo, devo porre fine a questo tormento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
