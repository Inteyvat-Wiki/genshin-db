					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "#Ho riflettuto molto sulle sue parole, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}, e i suoi timori sono fondati. Non rischierò vanamente per cercare quei meteoriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "Meno male...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "So bene che non è un singolo tratto a dar vita a una buona poesia. È nei dettagli più fini che si scorge la qualità del tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "Potrei comporre un bel verso osservando un fiore o un altro piccolo oggetto. Tuttavia, le poesie scritte in lode alla flora sono davvero innumerevoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "#Mmm... Si dice che chi non è coinvolto veda con maggiore chiarezza, vero? Bene, allora, viaggiat{F#rice}{M#ore}, a quale fiore crede che dovrei dedicare la mia poesia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
