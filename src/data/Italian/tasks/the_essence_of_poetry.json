			},
			"dialogs": [
				{
					"id": 225010301,
					"content": "C'è un modo migliore per ammirare quei meteoriti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "Un modo migliore, dice? Mmm, non ha tutti i torti. Solo una mente poco aperta potrebbe perdersi nella fiamma della meteora, ignorando ciò che la circonda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250104,
			"completionStepIds": [
				2250104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
