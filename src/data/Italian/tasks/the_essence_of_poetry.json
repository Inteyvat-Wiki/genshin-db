					"nextDialogs": [
						225010803
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010803,
					"content": "Sì, molto interessante... Ehm! Era pura teoria. Non si preoccupi, non correrò un simile rischio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
