			"dialogs": [
				{
					"id": 225010501,
					"content": "Ci sono dei mostri vicino a quei meteoriti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010502
					]
				},
				{
					"id": 225010502,
					"content": "Ahah, ma naturalmente. Ho vagato in lungo e in largo per Liyue, e incontrato innumerevoli bestie immonde. Se il cammino è troppo periglioso, assolderò una guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250106,
