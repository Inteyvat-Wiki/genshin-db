			"dialogs": [
				{
					"id": 225010701,
					"content": "Credi davvero che troverai l'ispirazione guardando un meteorite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010702
					]
				},
				{
					"id": 225010702,
					"content": "#Ha così poca considerazione di me, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}? Se potessi posarvi sopra lo sguardo, scriverei di certo un bel verso.",
					"roleType": "TALK_ROLE_NPC",
