			},
			"dialogs": [
				{
					"id": 225011301,
					"content": "#Ho riflettuto molto sulle sue parole, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}, ma è un'occasione troppo rara per perderla. Ho deciso di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011302,
					"content": "Ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "Tuttavia, se dovessi avvicinarmi subito ai meteoriti, temo che potrei soccombere al loro fascino e perdere di vista il mondo circostante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011304,
					"content": "Il peggior crimine per un poeta è avere occhi per un solo soggetto. Se mi limitassi a osservare i meteoriti, dubito che la mia penna traccerebbe un'opera degna di quel nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011305,
					"content": "Quindi, prima di avvicinarmi, li osserverò da lontano per coglierne l'atmosfera circostante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011306,
					"content": "E poi... Mmm, però... Con tutti quei mostri sulla strada e nessuno che mi accompagni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011307,
					"content": "#Viaggiat{F#rice}{M#ore}, forse sarebbe tanto gentile da sconfiggere i mostri che ci sbarreranno il cammino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Meraviglioso! Splendido! Confiderò in lei, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Prometti solo che non toccherai quei meteoriti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "I-Io... Va bene, lo prometto. Perché mai dovrei gettarmi a capofitto nel pericolo, ben sapendo che con un sol tocco potrei cadere in un torpore eterno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Eppure, verrebbe da chiedersi quali sogni si vivano nel sonno dei meteoriti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011313,
					"content": "*tossisce* Stavo scherzando, ovviamente! Per favore, aiutami ad affrontare quei mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
