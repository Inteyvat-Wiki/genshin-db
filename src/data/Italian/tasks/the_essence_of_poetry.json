				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010401,
					"content": "Puoi scrivere poesie anche da qui, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "#Assolutamente no, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}. Con una vita trascorsa in sicurezza e clausura, cosa sarebbero le mie poesie, se non i lamenti di un sano di mente o le prediche di un folle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250105,
			"completionStepIds": [],
