				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Eh? Vuoi saperne di più sui miei occhi? Eheh, beh, nella sua vita, un uomo deve assolutamente avere tre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Prima cosa! Un corpo temprato dotato di almeno una cicatrice. In caso contrario, sarebbe impossibile conoscere le prove che l'uomo ha dovuto affrontare, e darebbe l'impressione di un individuo privo di sostanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Seconda cosa! Le cicatrici devono essere coperte da vestiti e accessori, ma solo parzialmente. In caso contrario, sarebbe impossibile far capire agli altri quanto quell'uomo sia speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "E la terza cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Aspetta. Io non ti ho chiesto niente sui tuoi occhi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Esattamente! Se nessuno nota ciò che lo rende speciale, l'uomo è OBBLIGATO a farglielo notare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
