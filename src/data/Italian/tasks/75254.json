					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Non ci siamo già incontrati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "#{F#Amica mia}{M#Amico mio}, questo è il segno di qualcosa di straordinario da parte del destino... Il nostro primo incontro sembra una riunione tra vite ormai trascorse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Avendo visto la mia benda sull'occhio da lupo, avrai sicuramente capito che sono un tipo straordinario, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
