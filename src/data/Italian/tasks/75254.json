			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "#Ehilà, {F#amica}{M#amico}! Ti do il benvenuto a Paititi e all'Isola di Tete, dove i sogni diventano realtà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Proseguendo più avanti troverai due delle nostre taverne: Una rugiada per due e Goccia di rugiada. Io sono Tecuhtli, e ti farò da guida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#{F#Cara amica}{M#Caro amico}, ora che hai assaggiato il mio succo di benvenuto, lascia che ti dia un consiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "Se sei una persona comune che vuole solo godersi le vacanze, stai alla larga dall'area settentrionale dell'Isola di Tete: non troverai nulla che ti aiuterà a rilassarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Grazie del consiglio. Cos'è successo al tuo occhio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Umpf, è tutta opera di un certo pelatone. Mi ha lasciato questo segno, ma so che lui è da qualche parte sull'isola... E ci tengo a \"ringraziarlo\" di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "Dopo aver ascoltato la mia storia, non ho dubbi che vorrai vendicarti per conto mio. Ma non serve, anche se ti ringrazio per la gentilezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "#{F#Amica mia}{M#Amico mio}, in un'estate così bella, nessuno merita di sentirsi triste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Gustati il succo di benvenuto che preparo per ciascun ospite, e pensa a goderti le vacanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "Troverai bevande su quello scaffale laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
