			"dialogs": [
				{
					"id": 752540409,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "Non mi hai chiesto degli occhi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
