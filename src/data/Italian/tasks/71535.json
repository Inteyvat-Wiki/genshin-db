			"dialogs": [
				{
					"id": 715350401,
					"content": "Oooh? Sembra che il fai da te sia il tuo forte! Questo biglietto è bellissimo, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "Suppongo che questo sia il tuo regalo per me! Non ho nulla con me al momento ma, una volta tornata a Sumeru, ti manderò sicuramente qualcosa in cambio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Ora devo solo realizzarne uno per Candace, così potrò donarglielo assieme alla collana. Sono sicura che le piacerà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Ah, ora che ci penso, mi chiedo se sia già arrivata... È passato un po' di tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
