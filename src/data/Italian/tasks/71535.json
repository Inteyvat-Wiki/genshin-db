			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Che bello vederti qui, {NICKNAME}. Sei {F#venuta}{M#venuto} per il Festival delle lanterne, immagino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Stai preparando un biglietto d'auguri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Sì, ne volevo fare uno per Candace, ma per il momento non mi piace molto. Stavo per ricominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace non è venuta con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "No, ma arriverà tra poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Inizialmente non ha accettato di venire con me a Liyue. Ha detto che doveva rimanere a proteggere il villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Le ho detto che tutti meritano di rilassarsi a fine anno. E poi dovevo scortare una carovana fino a Liyue, quindi tanto valeva che venisse con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Le ho pure offerto di lasciare alcuni dei miei compagni a proteggere il villaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Ma non sono riuscita a convincerla. Alla fine ha cambiato idea solo perché gli abitanti del villaggio continuavano a dirle di prendersi una vacanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "E anche a quel punto, ha voluto prima completare tutto il lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Ma la carovana non aspetta nessuno... Quindi per il momento sono qui da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "È stato davvero difficile scegliere un regalo... Ci sono così tante cose carine qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Alla fine ho optato per una collana, ma poi ho sentito parlare di tutta la tradizione dello scambio di biglietti d'auguri durante il Festival delle lanterne, quindi ho voluto provare a farne uno anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Ma, ecco... Come dicevo prima, i risultati non sono fantastici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Sono certa tu ne sappia più di me, {NICKNAME}. Puoi darmi qualche consiglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Nessun problema, fammi vedere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
