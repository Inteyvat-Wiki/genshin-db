				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Bah, adesso pure le sacerdotesse del Santuario si mettono in mezzo per non farci arricchire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "A voi ladruncoli interessano solo i soldi, vero? Come osate tramare ai danni dei Sakura del tuono? Lady Miko non vi perdonerà mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Sai che ci importa... Parli tanto, ma non sai con chi hai a che fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "#Maestro, que{F#lla}{M#l} viaggiat{F#rice}{M#ore} là ci ha già messo i bastoni tra le ruote. Se non ci darai una mano, l'accordo salterà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Eheh... A parole sono bravi tutti, scricciolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schermagliatore dei Fatui"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
