				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "S-Smettila di seguirmi, per favore... Non ce la faccio più, dopo tutti questi giri di corsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Farabutti, un complotto per denaro con quegli stranieri! Potremmo correre ancora per ore, non ci sarebbe comunque spazio per il perdono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "#Uff... Hai un aspetto decisamente più rilassato, viaggiat{F#rice}{M#ore}. Deduco tu abbia risolto il nostro problemino? Grazie infinite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "Il potere dei Sakura del tuono non può finire in mano a personaggi del genere, tantomeno se dietro ci sono i Fatui a tramare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "Intuire i piani dei Fatui non è mai semplice, ma dal momento che abbiamo catturato questo loro tirapiedi otterrò sicuramente qualche risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Lascia a me il resto. So dove si trova l'esercito della Shogun, il prigioniero non fuggirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
