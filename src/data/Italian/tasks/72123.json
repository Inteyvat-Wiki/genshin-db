					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "Anzi, sai dove si trovano i Sakura del tuono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "#Dalla tua espressione deduco di no... Beh, sei u{F#na}{M#n} viaggiat{F#rice}{M#ore} stranier{F#a}{M#o}, dovevo immaginarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "I cinque Sakura del tuono non sono difficili da trovare. Segui la <color=#00E1FFFF>costa occidentale</color> dal <color=#00E1FFFF>punto più a nord</color> dell'isola con l'Accampamento dei Kujou fino al <color=#00E1FFFF>punto più a nord di Tatarasuna</color>, e ne avvisterai tre lungo il percorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Ne vedrai un altro sulla montagna a <color=#00E1FFFF>nord-ovest di Tatarasuna</color>, e l'ultimo in cima a un'altra montagna, a <color=#00E1FFFF>sud-ovest</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "Queste indicazioni dovrebbero facilitarti il compito con i Sakura del tuono. Fai attenzione, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
	]
