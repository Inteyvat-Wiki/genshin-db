			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Ecco, la mia solita sfortuna... Proprio a me dovevano capitare avversari del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Sciocchi senza cervello, tramare nell'ombra con i Fatui... La Possente Narukami vi punirà, prima o poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Bah, non penserete di aver vinto solo perché avete mandato all'aria i miei affari? Ho ancora un asso nella manica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
