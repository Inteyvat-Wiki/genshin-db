					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "Com'è la situazione con i Sakura del tuono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "Ho risolto il problema delle \"mascalzonate\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Fantastico, se non altro le condizioni dei Sakura del tuono si stabilizzeranno. Anche Lady Miko sarà sollevata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "Quegli imbroglioni da quattro soldi hanno osato attingere al potere dei Sakura del tuono per il loro tornaconto. Un'azione imperdonabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "Avete anche detto che i Cacciatori di tesori possiedono una sorta di cubo di cristallo nell'accampamento, con cui cercano di assorbire il potere dei Sakura del tuono? Bisogna risolvere il problema al più presto, prima che vada fuori controllo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "Il tuo aiuto è già stato fondamentale, inoltre avrò ancora bisogno di te. Stavolta, però, verrò con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "Non c'è tempo da perdere. Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
