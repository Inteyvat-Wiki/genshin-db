	"talks": [
		{
			"id": 7212302,
			"completionStepIds": [
				7212305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "N-Non uccidermi! Non ho nulla a che fare con i Sakura del tuono, lo giuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "E come facevi a sapere che stavamo proprio per chiederti informazioni sui Sakura del tuono? Hai la coscienza sporca, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon scommette che hai trovato questa specie di Ipostasi di Electro in modo illegale, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "P-Perché la cosa ti riguarda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Ho un lavoro da portare a termine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "Esatto! Ci hanno chiesto di fare giustizia e punire chi ha sbagliato! Sputa il rospo: ora ci dirai cosa intendono fare i Cacciatori di tesori con i Sakura del tuono, e anche dove hai trovato questo coso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "#Se non parli, invece... Eheh, assaggerai la super affilatissima lama della spada de{F#lla}{M#l} viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "P-Parlerò! M-Ma a chi è che importa davvero di questi alberi, in fondo? Sfruttando il loro potere possiamo fare qualche soldo, non diamo fastidio a nessuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Avevamo un grosso acquirente interessato a questi alberi e ci ha anche fornito i mezzi e gli strumenti per estrarre il loro potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Ci bastava seguire gli ordini e aprire un varco nei tronchi, poi quegli arnesi ci avrebbero permesso di ottenere l'essenza dei Sakura del tuono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Una volta riversato il potere in questo cristallo, ci saremmo ritrovati in mano un oggetto del valore di... non so, tipo tre magioni della Commissione Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "#E ci hanno pure riempiti di quattrini! Voi straccion{F#e}{M#i} non li guadagnereste neanche in una vita di lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Sentite, lasciatemi andare e ve ne sgancio una bella fetta, eh? Dieci per cento a voi, novanta a noi. Equo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Troppo poco, amico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "Ah, sì? Sapete che vi dico, allora? Scordatevi la mia clemenza. Appena il compratore arriverà, sarete voi a implorare pietà dal qui presente Lord Hideaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Sei un bel chiacchierone, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Ascolta, nanetta presuntuosa, i miei fratelli stanno venendo a salvarmi... da un momento all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "#Puoi chiamare chi ti pare ad aiutarti, tanto non torcerai un capello a Paimon. {F#La}{M#Il} viaggiat{F#rice}{M#ore} darà a tutti una bella lezione prima che si avvicinino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Yamada, hai sentito? Questo moscerino dice che non riusciresti a metterle le mani addosso! Dimostrale il contrario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "#Yamada? E chi è? Viaggiat{F#rice}{M#ore}, intervieni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Ma... Qui non c'è nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Continua a sognare, bello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Hai scoperto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "A proposito di Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Ora capisco cosa sta succedendo... I Cacciatori di tesori non sono che ladruncoli, però. Davvero qualche loro \"mascalzonata\" avrebbe causato un disastro simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Sospetto possano essere altre le cause dell'indebolimento dei Sakura del tuono... Ho una teoria, ma non sono ancora sicura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "Cosa vuoi dire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Qui a Kannazuka, non hanno potere né Inazuma né Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Da quando è in vigore il Decreto di caccia alle Visioni, in questo luogo si sono affrontati spesso l'esercito della Shogun e i Ribelli. Credo che a nessuna delle due fazioni importi granché dei danni che i Sakura del tuono hanno subito in seguito agli scontri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Come dice sempre lady Miko: \"Ai militari interessano solo onori e riconoscimenti\". Non cambierebbero mai approccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "In realtà ci aspettavamo che potesse accadere, però non pensavamo che i Sakura del tuono versassero in condizioni tanto critiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "#A ogni modo, attualmente le \"mascalzonate\" dei Cacciatori di tesori sembrano essere il problema più urgente. Viaggiat{F#rice}{M#ore}, posso incaricarti di fermarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "Puoi contare su di me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Sii prudente, per favore. L'indebolimento dei Sakura del Tuono rende la situazione molto pericolosa. Dopo tutto, questi alberi servono a tenere sotto controllo ciò che si trova sotto di loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Ehm, temo di aver parlato troppo. I-Insomma, dimenticate le mie parole e... presta attenzione, ecco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "Ho anche bisogno di un po' di tempo per analizzare quanto ho scoperto. La domanda principale è: chi sta manovrando i Cacciatori di tesori da dietro le quinte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Questo caso continua a intricarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Non dovrei aver problemi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Forse no, ma non ne sarei così sicura. L'indebolimento dei Sakura del Tuono rende la situazione molto pericolosa. Dopotutto, questi alberi servono a tenere sotto controllo ciò che si trova sotto di loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
