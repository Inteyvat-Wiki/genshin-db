			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Vediamo, dov'è la persona di cui ci ha parlato Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Perché stai facendo questo? Perché partire all'improvviso, dopo tutti questi anni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Troppo all'improvviso, proprio così. Non abbiamo avuto tempo per prepararci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "I bambini non vedono l'ora che li porti fuori a giocare... Ti prego, ripensaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Dev'essere il ragazzo di cui ci ha parlato Ayaka. Andiamo a vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Sembra il diario di Tejima, bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Vediamo cosa abbiamo qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Oggi, mi sono riunito insieme agli abitanti del villaggio per cucinare degli ayu essiccati alla griglia. Ho sbagliato qualcosa e il mio si è un po' bruciato, quindi ho dovuto fingere che fosse un semplice pesce a testa di serpente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Oggi ho aiutato a salvare un bambino caduto in acqua. Dopo che l'ho tirato fuori, mi ha detto che il suo migliore amico, Banbu, era ancora in acqua. Ho cercato in acqua tutto il pomeriggio prima di scoprire che Banbu era il nome del suo granchio domestico\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"Oggi sono uscito con il mio aquilone. La cordicella si è rotta, quindi ho corso a perdifiato per inseguirlo. Ho capito presto che non l'avrei mai recuperato, quindi ho trovato un posto dove sedermi e sono rimasto a guardarlo mentre si allontanava nel cielo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Mmmh... Sembra un normale diario di un abitante del villaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Eh? Aspetta, c'è dell'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"Oggi sono andato di nuovo a pregare al santuario e ci sono rimasto un po'. L'omamori che mi hai dato è un po' sbiadito, ma rimane ancora la cosa più preziosa che ho...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "Questo è il tipo di informazioni che stiamo cercando! È ora di fare una visita al santuario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Quindi questo è l'omamori di cui parlava Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Interessante... Guardando il colore e l'aspetto, Paimon avrebbe pensato che appartenesse a un bambino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "Ma in ogni caso, se lo ha sempre tenuto con sé, può darsi che abbia mantenuto parte della sua energia elementale. Pensi che potrebbe tornare utile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "Eccoci qui! Sembra che Tejima venisse spesso in questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "Ci sono tracce di scavi nel terreno... Forse Tejima ha seppellito qui qualcosa di prezioso, qualcosa che lo ha tenuto nel villaggio per tutti questi anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "Dev'essere qualcosa di davvero sorprendente se lo ha fatto rimanere per 30 anni. Scaviamo e diamo un'occhiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "Sembra... una lettera? Il foglio è diventato giallo... Deve essere stata scritta molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "\"Villaggio di Konda\"... Suona familiare... Dove si trova questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "È qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Eh? Quindi il motivo per cui Tejima è venuto qui era per aspettare qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Ma è stato qui per trent'anni... Ah, chiunque fosse, immagino che non si sia fatto vedere, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Bene, restituiamo a Tejima la sua roba e diamoci da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Beh, io... Questa è sicuramente la mia calligrafia... e credo che anche l'omamori e la lettera appartengano a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "...Ma non ho memoria di nulla di ciò che è scritto in questo diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Eppure... è evidente che stavo aspettando una persona... e che ho scelto di aspettarla per trent'anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Con il passare del tempo, devo aver preso nota di qualsiasi cosa interessante... qualsiasi cosa che avrei potuto condividere con lei quando ci saremo finalmente riuniti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "E guarda tutto quello che è successo nel corso degli anni... Il tempo è volato così velocemente. Trent'anni sembrano passati in un batter d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Come ho potuto dimenticare qualcosa di così importante per me? Mmmh... Ora che ci penso, quando la Visione mi è stata portata via, mi è sembrato di essere stato improvvisamente... svuotato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Amore, rimpianto... tutto quello che ho provato per lei... è tutto scomparso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Ti fa sentire triste la cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "No... non particolarmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Dopotutto, ho dimenticato chi fosse. Il suo viso, la sua voce, le cose che abbiamo vissuto insieme... Non ricordo quasi nulla di tutto ciò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "È come se non fosse mai stata nella mia vita... come se tutti questi anni non fossero stati altro che un sogno confuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Quindi, hai ancora intenzione di partire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Mmmh... Forse... forse no. Se ho aspettato per la maggior parte della mia vita, forse dovrei continuare a farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Tuttavia, se alla fine dovesse presentarsi e scoprire che ho dimenticato il suo nome... La cosa la sconvolgerebbe, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Quando ci penso... Percepisco una lieve sensazione di tristezza nel mio cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Che strano... Perché mi sento così quando non ricordo nemmeno chi sia? È proprio come una sensazione di vuoto, la sensazione che manchi... qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "*sospira* Grazie per avermi aiutato a ricordare il motivo per cui sono ancora qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Resterò ancora qui e continuerò ad aspettarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima sembra che stia meglio... tuttavia... Paimon è davvero triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Sì, anche io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "È proprio come dicevano Ayaka e Thoma. Se perdi la tua Visione, perdi anche le tue speranze e i tuoi sogni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Questo spiega sicuramente lo stato in cui si trovava Tejima prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Almeno siamo riusciti ad aiutarlo... giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*sospira* ...Bene, andiamo a cercare il prossimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Forse non c'è cosa più triste che perdere il motivo stesso per sentirsi tristi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
						"stepId": 200406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Ah... Anche tu sei qui per cercare di convincere Tejima a restare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "Che è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "Tejima ha protetto questo posto da quando è arrivato qui trent'anni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Tenere alla larga i Cacciatori di tesori, respingere i mostri, risolvere le liti tra gli abitanti del villaggio... Ha lavorato duramente per prendersi cura di questo posto e gode di tutta la nostra stima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Ma ora, all'improvviso, dice che vuole lasciarci... Non possiamo che chiederci se è per via di qualcosa che abbiamo fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Se così fosse, ci scuseremmo volentieri... Noi vogliamo solo che rimanga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
						"stepId": 200407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kenjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "*sospira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "Ma allora, perché questo cambiamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Credo che abbia qualcosa a che fare con il Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "È chiaro che Tejima non avesse fatto nulla di male. Eppure, hanno confiscato la sua Visione. Dopodiché... è diventato una persona completamente diversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "Non posso dire di capirlo appieno, ma giurerei che abbia perso qualcosa di molto importante. È andato a fare una passeggiata, da solo, ha girato attorno al villaggio un paio di volte, e poi di punto in bianco ha annunciato che sarebbe partito e che sarebbe diventato un vagabondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "A dire il vero, non siamo sicuri che farlo restare qui sia la scelta migliore. Ma allo stesso tempo... non mi sembra giusto lasciarlo andare mentre si trova in quello stato. È un'anima in pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Sembra che goda di un certo rispetto da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200408",
							"2"
						],
						"stepId": 200408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Sei Tejima? Dunque, cosa ti ha fatto venir voglia di levare le tende così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Io...? Io... Il punto non è perché voglio partire... ma... per quale ragione dovrei restare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Hai vissuto qui per molto tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Tutti contano su di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Vero... ma non è per questo che ho scelto di restare qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "...cosa mi ha portato qui trent'anni fa? E perché, in tutto questo tempo, non ho mai voluto andarmene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "*sospira* Non ho risposte a queste domande, perché non ricordo più. Da quando mi hanno portato via la Visione, è come se... un tassello della mia memoria fosse sparito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Prima sapevo di voler restare qui... ma qualunque motivazione avessi allora, è scomparsa. Quindi mi sono detto... cosa mi trattiene? Il vuoto dentro di me rimarrà in ogni caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Va bene... Bene, in tal caso, se ti aiutassimo a scoprire il motivo per cui hai scelto di restare, non partirai più, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Mmmh... Ma se non ricordi nulla, non sarà facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Oh! Ma se ti sforzassi un po' di più, allora... forse tutto tornerebbe a galla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Oh, ora che ci penso... L'ultima volta che ho portato della frutta a Tejima, credo di averlo visto scrivere in un diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "...Ho un diario? Se lo dici tu... Davvero, non riesco a ricordare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Sì, sì, ce l'hai! E per di più, quella volta hai detto che volevi prendere nota di alcune cose interessanti, cose che si sarebbero rivelate molto importanti in un secondo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Perfetto! Quindi, se vogliamo convincere Tejima a rimanere, dobbiamo solo trovare il suo diario. Dev'essere qui da qualche parte, diamo un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Se non vi dispiace, lasciamo a voi la ricerca del diario... noi dovremmo tornare al villaggio per informare gli altri della questione riguardante Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
