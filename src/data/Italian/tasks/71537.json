			"dialogs": [
				{
					"id": 715370101,
					"content": "#Cavaliere {F#Onoraria}{M#Onorario}! Non mi aspettavo di incontrarti qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370102,
					"content": "Stai preparando dei biglietti d'auguri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Sì! Finalmente ho avuto la possibilità di venire qui in vacanza, e volevo portare dei regali ai Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Ho sentito dire che, durante il Festival delle lanterne, gli abitanti del posto aggiungono spesso uno di questi biglietti ai loro regali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Così ho deciso di seguire il loro esempio e di crearne qualcuno anch'io. Ma non mi sono venuti molto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "#Voglio che i miei biglietti d'auguri siano bellissimi! Puoi mostrarmi come fare, Cavaliere {F#Onoraria}{M#Onorario}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370107,
					"content": "Certo, lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
