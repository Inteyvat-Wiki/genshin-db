				"points": []
			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "È quasi ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Stai continuando a studiare le radici dell'Albero divino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#Ah, viaggiat{F#rice}{M#ore}, spunti sempre al momento giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Ti ringrazio molto per il tuo aiuto. L'Albero divino è in perfette condizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Dopo averne discusso con Ladep, riteniamo che dovrebbe essere in grado di rimanere in questo stato per un bel po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Ora avremo finalmente del tempo per preparare le nostre tesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Guarda, ho preso in prestito una Fotokamera da Pharez, e la userò per documentare le condizioni dell'Albero divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti scattare uno foto dell'Albero divino nella sua interezza? Ti ho segnato dei punti sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Perché non puoi farlo da sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Beh, è... troppo in alto per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Ho sempre avuto paura di trovarmi in luoghi troppo alti da sola... Sono terrorizzata dall'idea di essere spazzata via dal vento... Oppure che una folata faccia volare via il mio manoscritto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "#Solitamente è Pharez che si occupa di andarci, ma sembra che al momento abbia altre cose da fare. Sei l'unica persona su cui posso fare affidamento, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
