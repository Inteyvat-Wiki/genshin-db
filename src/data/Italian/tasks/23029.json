			"dialogs": [
				{
					"id": 230290401,
					"content": "Com'è andata? Hai scattato le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290402,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "Wow! Fammi vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290404,
					"content": "Ben fatto. Un'angolazione perfetta, e l'immagine è anche piuttosto nitida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290405,
					"content": "#Ecco il tuo compenso. Grazie dell'aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290406,
					"content": "Il fusto sta bene... E la forma dei rami circostanti non è cambiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290407,
					"content": "Ottimo, aspetterò che Ladep e Pharez finiscano di raccogliere i dati, così da poter passare al prossimo soggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
