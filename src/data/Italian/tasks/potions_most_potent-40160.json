					"speakerTitle": "Freda"
				},
				{
					"id": 401600102,
					"content": "#Effettuerò regolarmente dei rifornimenti. Sentitevi {F#libere}{M#liberi} di venire a dare un'occhiata quando avete un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401600103,
						401600105
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401600103,
					"content": "Vorremmo comprare dei rifornimenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401600104
					]
				},
				{
					"id": 401600104,
					"content": "È il vostro giorno fortunato! Ho appena ricevuto un nuovo lotto di provviste! Prego, date un'occhiata e ditemi se c'è qualcosa di vostro interesse!",
