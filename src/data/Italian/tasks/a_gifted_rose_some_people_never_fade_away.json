					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Se questi campioni cresceranno bene, potremo coltivare altre rose dorate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Ma, fino ad allora, penso che per essere più fiducioso dovrò veder fiorire queste rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Stavo per perdere la speranza, e non mi aspettavo che questo fiore sarebbe sbocciato davvero. Suppongo che nella vita possano sempre accadere cose straordinarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Piccola, sei ancora triste per zio Shafaqat? Non preoccuparti: noi che siamo ancora in vita dobbiamo esaudire i desideri di chi non c'è più. Non possiamo deludere i defunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Affan... Non sono più tanto giovane. Ormai i figli degli amici con cui sono cresciuta devono essere abbastanza grandi da riuscire a comprare le spezie da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Sono d'accordo, però. Siamo vivi, quindi tanto vale essere felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}