					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Oh, siete voi. Ottimo, noi e le rose vi stavamo aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Anche Sabbah è arrivata presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Di recente, sono venuta spesso qui e ho letto gli appunti lasciati da Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Al Villaggio di Aaru mi sentivo spesso sola, ma ora non più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "O almeno, ora non sono più del tutto sola: ho queste rose, e i ricordi dei momenti passati con voi e con Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Nella mia vita c'è ancora qualcosa di bello, e concentrarmi sugli aspetti positivi mi aiuta a sentirmi meno sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Ne ho parlato con Affan, e d'ora in poi l'aiuterò a prendersi cura delle rose dorate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Continueremo a coltivarle finché il vivaio non ne sarà pieno. Per ora, però, dobbiamo far sbocciare queste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Hai presente il metodo che hai usato per far sbocciare le rose di Sumeru? Utilizziamolo di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Lasciaci dare una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "D'accordo, lascio tutto nelle vostre mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320903,
