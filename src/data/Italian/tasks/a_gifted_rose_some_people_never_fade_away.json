				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090301,
					"content": "\"Rosa, oh rosa, esaudisci il mio desiderio.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "\"Sbocciando dalla pietra, la rosa dorata mi ha intonato un canto\".",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
