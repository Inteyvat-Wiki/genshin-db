				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah",
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "\"Rosa, oh rosa, esaudisci il mio desiderio.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "\"Sbocciando dalla pietra, la rosa dorata mi ha intonato un canto\".",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Le Rose dorate sono davvero splendide. Vederle fiorire ha rallegrato la giornata di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Questi giorni di duro lavoro non sono stati vani. Paimon è così felice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Il desiderio è stato finalmente esaudito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "Sono finalmente riuscito a fare qualcosa di buono. Zio Shafaqat, ti ho aiutato a esaudire il tuo desiderio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "È un peccato che non possa vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090407,
					"content": "Non dire così, Sabbah. Ricordi l'ultima strofa della canzone popolare sulle rose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "\"Non la terra mi è natia, lo è una melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "La sorte verrà sfidata, e cambierà ciò a cui sono destinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "Andrà oltre me, andrà oltre il tempo. Non sarà scalfita da vecchiaia o appassimento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "Le rose dorate, la vita di zio Shafaqat e la canzone popolare che compose egli stesso... sono ancora qui con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Sì, hai ragione. Lui ha superato il tempo e l'appassire della vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090413,
					"content": "Grazie per avermi parlato di lui. Significa molto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090414,
					"content": "È stato esiliato prima di me, e vedere tracce della sua vita mi dà la sensazione di aver viaggiato nel tempo e nello spazio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090415,
					"content": "È come se non guardassi soltanto lui, ma anche me stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090416,
					"content": "Non posso più parlare con lui, ma posso continuare la mia vita facendomi carico dei suoi rimpianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090417,
					"content": "Vivendo per lui, sicuramente riuscirò a redimermi, prima o poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090418,
					"content": "Spero che sarai felice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Non mi dispiace più vivere qui. Sono così... felice di avervi incontrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090421,
					"content": "È vero che le rose riescono a rendere felici le persone. Affan, in futuro dovremo lavorare sodo e piantarne altre qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090422,
					"content": "Ahah! D'accordo, affare fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "Mmmh, farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090419,
					"content": "Su col morale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Ne è valsa la pena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
