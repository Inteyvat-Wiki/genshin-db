				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "Ah, che mal di testa... Cosa dovrei fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530102,
					"content": "Cosa combini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Mi esercito per le prove dei Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530104,
					"content": "*sospira* Ma non sono neanche lontanamente forte come Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530105,
					"content": "Credo che sia meglio concentrarmi sulla tecnica, piuttosto che sulla potenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530106,
					"content": "Per esempio, stavo pensando a come spaccare tutti questi manichini di legno con un unico fendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530107,
					"content": "Se hai tempo, ti andrebbe di aiutarmi a trovare una soluzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530108,
					"content": "Ci penserò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Certo, prenditi il tempo che ti serve. Tanto, questi manichini non vanno da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530111,
					"content": "Così come la mia vita, dato che sono ancora bloccata qui a cercare una soluzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530114,
					"content": "A questa distanza, forse la soluzione migliore sarebbe che io mi occupi di un lato, e nel frattempo sganci una bomba per sistemare l'altro lato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530115,
					"content": "Ahah, scherzo. Non saprei neanche dove procurarmi una bomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530109,
					"content": "E se facessimo un tentativo insieme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Ti piace il combattimento di squadra, allora? Va bene per alcuni... C'è sempre qualcuno ad aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530113,
					"content": "Per persone come me, il meglio che posso fare è cercare di cavarmela come combattente solitaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
