			"dialogs": [
				{
					"id": 765100101,
					"content": "...Dovrebbe essere sufficiente per dimostrare che non si tratta di una specie di arma segreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Mmm... Decisamente. Ora devi solo renderlo un po' più difficile, e potrebbe rappresentare una sfida anche per gli adulti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Woah! L'atmosfera si sta facendo di nuovo tesa, non penserai mica che stiano per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Venire alle mani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Non hai tutti i torti... Ehi, {NICKNAME}, visto che sei qui, perché non ci aiuti ad arbitrare un combattimento leale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "*sospira* Non so da dove sia venuta fuori questa tua mania per l'allenamento. È forse perché ti ho battuto così facilmente l'ultima volta? Se è questo il punto, allora sbrighiamoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, tieni gli occhi aperti e vediamo chi chiude gli occhi per prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Umpf! Tutte quelle parole vuote non ti salveranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler sembra più forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Caspita! Ma non dovrebbero solo allenarsi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Non è troppo tardi per ammettere la sconfitta! Ti do tre secondi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Tre, due, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Woah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Si sente un forte rumore metallico, seguito da un silenzio calmo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "Va tutto bene, Paimon, puoi aprire gli occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "A quanto pare, la persona più \"tesa\" qui eri tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "C-Cosa? Wislawa, non sei ferita?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler ha sparato solo un colpo di avvertimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Certo. Non voglio finire bloccata in qualche prigione straniera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Non avevo altra scelta. Dovevo farle capire che non sono una mercante codarda che può trattare come vuole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "In questo modo, la prossima volta che ci incontreremo, ci penserà due volte prima di crearmi problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Ma, {NICKNAME}, come facevi a sapere cosa stava succedendo? Non sei affatto {F#tesa}{M#teso}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "L'espressione di Edler era troppo rilassata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "#Sei {F#sveglia}{M#sveglio}. Una minaccia ben posta è il modo più rapido per far arrendere qualcuno. È solo un peccato che le scorciatoie siano di rado così facili da prendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Senza contare che {NICKNAME} è qui... Comunque, sono ancora in piedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "Spero solo che la prossima volta che ci incontreremo, avrò l'occasione di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Non ricominciare. Quante possibilità pensi che avremo di incontrarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Se la prossima volta che ti vedrò sarai in servizio, sarò costretta a rispondere in modo appropriato a qualsiasi azione tu compia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Ma se sarai di nuovo in vacanza, faremo un altro Ludum Belli o due... per il bene dei miei affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "Edler stessa l'ha detto: \"vediamo chi chiude gli occhi per prima\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "Non c'erano proiettili nel moschetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa sembra più grande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}