			"dialogs": [
				{
					"id": 745260401,
					"content": "#Ah, {NICKNAME}, sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Ti stai esercitando, Nilou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "No, no, affatto. Sto solo mettendo insieme una nuova danza, ispirata ai Padisarah che si crogiolano al sole dopo la pioggia, con le goccioline di rugiada appese ai petali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Siamo ancora nelle prime fasi di pianificazione e molti dei movimenti sono ancora piuttosto grezzi. Sento che manca ancora qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Anche la descrizione sembra bella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Vuoi farmi una foto? Ehm, come ti dicevo, questi passi di danza non sono ancora pronti per il grande pubblico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Una sessione di prova prima che la coreografia prenda la sua forma definitiva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Perfetto, ho capito! Allora, darò il massimo in questi movimenti... Assicurati di immortalare il momento della fioritura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Anche questo fa parte dell'arte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Ti dispiacerebbe se ti scattassi una foto, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Non disturbo, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
