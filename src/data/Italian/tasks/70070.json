			"dialogs": [
				{
					"id": 706900301,
					"content": "Oh? Già finito di sistemare? È stato molto più veloce di quanto mi aspettassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Allora, cosa vorresti in cambio, tesorino? Mi avete liberato tutto il pomeriggio aiutandomi. Che ne dici di passarlo insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "#Vorrei essere {F#pagata}{M#pagato}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Oh, tutto qui? Beh, non preoccuparti. Non me lo dimenticherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, anche voi l'avete notato. Nomi così strani, e contenuti ancora più strani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Per non parlare del fatto che questa è la biblioteca più grande nel nord di Teyvat, e non ho riconosciuto nemmeno un titolo dell'elenco. Non riesco proprio a capire come sia possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "A meno che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "#In realtà, ci siamo appena {F#imbattute}{M#imbattuti} in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "In dei problemi, immagino? Penso che me ne terrò alla larga, se per voi fa lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "D'altronde, se un libro esiste in questo mondo, allora c'è un posto per lui in questa biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Meglio che rimanga qui, piuttosto che finire nelle mani di qualcuno più... sospetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "A ogni modo ecco il pagamento. Grazie ancora per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "Mi piacerebbe chiedere di questi libri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
}