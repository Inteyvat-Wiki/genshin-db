			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "Zero disciplina, eleganza, originalità e ispirazione... per non parlare della coordinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Auromago abbiente"
				},
				{
					"id": 727340102,
					"content": "Ehi, di che ti stai lamentando? Oh, capito... di tutti i tuoi compagni di squadra che abbiamo sconfitto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Auromago abbiente"
				},
				{
					"id": 727340104,
					"content": "Sto parlando del vostro stile di combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Auromago abbiente"
				},
				{
					"id": 727340105,
					"content": "Eh? Ti ha colpito in testa uno Spettro o cosa? Non siamo al circo, bello! Vuoi sapere quale sia il mio stile? Forza inarrestabile, volontà indistruttibile e scarabei imbattibili, ecco il mio stile! Posso darti una dimostrazione... Se hai coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Uff, mi riporti alla mente dei brutti ricordi... Non vado molto d'accordo con i tipi rozzi e molesti come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Auromago abbiente"
				},
				{
					"id": 727340107,
					"content": "#Ah, ma {F#questa biondina}{M#questo biondino} sembra una vittoria facile... Ok, {F#la}{M#lo} sfiderò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Auromago abbiente"
				},
				{
					"id": 727340108,
					"content": "Pfff! Ahahahahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "Ahahahah! Ehi, compadre, hai sentito cos'ha detto questo buffone? Pensa che tu sia una vittoria facile! Che ne dici di mostrargli un po' di ospitalità alla maniera della Banda di Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Ahah, con piacere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon è confusa... Queste persone non hanno studiato per niente i loro avversari! Presentandosi così uno ad uno non fanno che favorire la nostra vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "I membri della squadra del Granmaestro Hanakado sono un'accozzaglia mostruosa! La loro strategia non può competere con la nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Oh, nooo! Non fare il bullo con me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
}