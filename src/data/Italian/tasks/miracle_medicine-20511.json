			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Questa ricetta funzionerà davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#Viaggiat{F#rice}{M#ore}! Che tempismo perfetto, mi trovavo giusto in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Ora ti spiego. Ti ricordi di mia sorella minore, Anna? È sempre malaticcia e finora niente è riuscito a curarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Ma ho sentito che c'è un medico incredibile al Porto di Liyue, particolarmente esperto nel curare l'incurabile. Perciò, ho chiesto a qualcuno di ottenere una sua ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Gli ingredienti sono molto inusuali... ma immagino non mi resti altro che fare un tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Uhm, vediamo un po'... Puoi aiutarmi a trovare una bacca rigurgitata da un Melmoso di Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "Esiste una cosa simile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Neanche io ne avevo idea! I Melmosi di Dendro mangiano davvero le bacche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "In ogni caso, conto su di te! Conosco un posto dove poter trovare sia bacche che Melmosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Per favore, vai a dare uno sguardo per me. Spero che la troverai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Questo dottore è un ciarlatano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Anche tu lo pensi, vero? Ma non ho altre opzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Conosco un posto dove puoi trovare sia bacche che Melmosi. Andresti a dare un'occhiata per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Assaggerò io la medicina che prepariamo. Non posso assolutamente permettere che le condizioni di Anna peggiorino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Potrei semplicemente catturare un Melmoso di Dendro per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Ehm... Cosa? Mi stai dicendo che dovrei infilare personalmente la bacca nella bocca di un Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Ti prego, risparmiamelo! L'ultima volta che sono andato a raccogliere erbe per le medicine di Anna, un gruppo di Melmosi di Dendro mi ha inseguito fino al Villaggio Acquachiara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Conosco un posto dove puoi trovare sia bacche che Melmosi. Potresti andare a dare un'occhiata per me? Spero che riuscirai a trovare qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Ma... S-Se non riesci davvero a trovare nulla, allora... per il bene di Anna... c-cattura un Melmoso di Dendro e portalo qui. Posso farcela. Sì... Lo farò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
