				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "Puoi esercitare il potere di Dendro? Hai una Visione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Non incontravo qualcuno come te da tanto tempo. Che nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Dovrebbero andare bene ora, vero, Sabbah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Esatto, dovrebbero germogliare presto con il potere di Dendro. Aspettiamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "A poco a poco, i germogli iniziano a spuntare dal terreno.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Smettono di crescere dopo che sono spuntate alcune foglie.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Stanno germogliando! Paimon lo sa che sei in grado di fare tutto, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "I risultati sono immediati, proprio come pensavo... Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "Peccato che non ci siano ancora i fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Oh, è normale. Non si possono affrettare certe cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Le piante devono passare attraverso delle fasi di crescita. Il fatto che le abbia fatte già germogliare è davvero sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Date alle rose un altro po' di tempo per assorbire il nutrimento. Sarà meglio anche per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Vi sono già molto grata così. Non vorrei disturbarvi ulteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Passate di qui e venite a vederle quando avete tempo. Sarebbe sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}