				},
				{
					"id": 748000802,
					"content": "Hai sbattuto la testa? Ma poi dove? Non c'è l'ombra di uno spigolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000803,
					"content": "Shh! Da questa parte! Abbassatevi di fianco a me! Qui è pericoloso...",
