				]
			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "Ma perché ti nascondi ancora? Non c'è niente qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Non vedi quel Mekagarde! È proprio davanti a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Shh! Andiamocene, veloci! Se perde il controllo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "O magari... Il nucleo di alimentazione gli scoppia improvvisamente! O qualcuno lo telecomanderà per attaccarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "A me sembra completamente normale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "E per questo mi fa ancora più paura! Un Meka che funziona normalmente e perde il controllo all'improvviso, e qualche povero sciagurato perde la vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Nessuno può essere ritenuto responsabile di una cosa simile! Forse il vero colpevole è destinato a non essere mai trovato... No, è troppo pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "La via è libera, ora puoi uscire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Fiuuu... Non è andato fuori controllo, che sorpresa. Ci hanno nuovamente risparmiato la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Incidenti di questo tipo sono semplicemente impossibili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Quello a cui pensavo era più sulla falsariga di un \"incidente intenzionale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Un momento. Gli eventi criminali privi di un colpevole... sono crimini di cui nessuno verrà ritenuto responsabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "Esatto! L'ispirazione è arrivata! Dai, su, precipitiamoci alla caffetteria! Devo metter tutto per iscritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Ehi! Rallenta, non temi che qualcuno lanci una pietra e ti faccia cadere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Non avrebbe perso il controllo, comprende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "E... quindi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
