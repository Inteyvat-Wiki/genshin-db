					"nextDialogs": [
						748000804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000804,
					"content": "Ci risiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000805,
					"content": "Questo Acquabus non ha alcuna barriera sulla parte alta! Se metti due pali ai lati, e una lenza in mezzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000806,
					"content": "Quando l'Acquabus attraversa i pali, la lenza diventa un coltello che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000807,
					"content": "Aaaah! Basta! Smettila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000808,
					"content": "No, no, non hai bisogno neanche dei due pali! Ne basterebbe uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000809,
					"content": "E se ci appendessi una lenza, con l'amo che ondeggia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000810
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000810,
					"content": "Allora la gente sull'Acquabus verrebbe agganciata dall'amo, e rimarrebbe sospesa nell'aria, e poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000811,
					"content": "Paimon non sente, Paimon non sente... Paimon non sente niente, lalalala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000812,
					"content": "Dopo averla ascoltata così a lungo, anche Paimon inizia a trovarla un po' inquietante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000813,
					"content": "Scendiamo dall'Acquabus appena arriviamo alla stazione, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
