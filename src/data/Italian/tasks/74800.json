			"dialogs": [
				{
					"id": 748000501,
					"content": "Ah, vero...Proprio così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Il caffè si fredda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Abbiamo già finito di berlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Beh, grazie, {NICKNAME}. E grazie di avermi accompagnato qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "Dici \"accompagnare\", ma tutto quello che abbiamo fatto è stato camminare con te fin qui. Non abbiamo fatto niente di che!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Non è successo niente di male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "E non hai incontrato nessun pericolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Sì. A quanto pare ci stavo davvero pensando troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "Questo caffè è proprio buono, ahah... ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "...Secondo voi è avvelenato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "...*tossisce*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Ti farebbe così male smettere di dire cose del genere per almeno due secondi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Smettila con queste sciocchezze! Abbiamo già finito di bere, e stiamo tutti bene, non vedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "No no no, forse è un... avvelenamento speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "Prima di tutto, l'assassino può aver mischiato il caffè con qualche medicinale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Un medicinale che da solo non provoca nessun effetto collaterale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "Ma dopo aver finito il nostro bel caffè, ce ne andiamo a casa, seguiti dall'assassino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "E mentre dormiamo, quello entra in camera e mette un altro medicinale nella bottiglia d'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Il giorno dopo, mentre sei in giro, prendi un sorso dalla tua bottiglia, i due medicinali si mescolano e creano una reazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "E poi noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "Si sente un suono di passi che si avvicinano in fretta...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Cara cliente, ma che stai dicendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Caffè? Veleno? Non fare battute simili nel mio locale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Se gli altri clienti si spaventano, dovrò chiederti di allontanarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Signore, posso spiegare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "È una mia amica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Spieghi la situazione di Guijarro ad Arouet. Dopo aver sentito tutta la storia, quest'ultimo si allontana esasperato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "Per scusarsi, Guijarro compra altre tre tazze di caffè...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Questa volta l'hai visto fare il caffè con i tuoi occhi! È impossibile che la bevanda abbia qualcosa che non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000529,
					"content": "Smetti di inventarti cose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000530
					]
				},
				{
					"id": 748000530,
					"content": "Lo so, lo so, ma... mi è arrivata addosso un sacco di ispirazione mentre venivamo qui.",
