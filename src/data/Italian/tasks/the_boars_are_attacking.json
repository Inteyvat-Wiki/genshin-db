			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Ehi... Hai qualche messaggio da parte di mio figlio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "E tu saresti...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Io? Gli amici della cantina mi chiamano Vecchio Tunner. Lavoro come contadino qui nel Vigneto Prima Luce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "La mia famiglia coltiva queste terre da generazioni. La maggior parte dei deliziosi vini che avrai assaggiato è stata probabilmente fermentata con le uve di qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Tutti i proprietari del vigneto hanno sempre trattato la nostra famiglia molto generosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Tuttavia, non credo sia giusto che mio figlio erediti queste terre e faccia il contadino per il resto della sua vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Tuo figlio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Guy! Il nome del mio adorato figlio è Guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Cosa? Non hai mai sentito parlare di lui? Ahahah, va bene. Prima o poi lo conoscerai. Tutti a Mondstadt lo conosceranno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Mio figlio Guy mi ha detto che sarà il Cavaliere di Favonius più forte di tutti! Io credo in lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Ho speso tutto il denaro che mi sono duramente guadagnato per cercare di offrirgli un futuro migliore del mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Guy è determinato a realizzare il suo sogno! È diventato scudiere a 16 anni e da quel momento la nostra famiglia conta su di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Alla prossima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Alla prossima! Se incontri mio figlio, per favore, digli di tornare a casa ogni tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
