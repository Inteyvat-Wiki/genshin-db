				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Fatto? Come ti senti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "Abbastanza bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Benissimo. Mi auguro che in questo tempio rimanga sempre dell'incenso acceso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Rimarrò qui un altro po'. È un angolo molto tranquillo, perfetto per fare un po' di inventario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Devo mettere in ordine i materiali che ho accumulato e continuare ad aggiornare il mio libro sul Custode Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Se mai ti ritrovi del tempo libero, passa pure a vedere come vanno le cose al tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Se vuoi offrire altro incenso, passa pure da me a prenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "*sospira* Mi piacerebbe molto rimettere a posto anche le aree circostanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "Sarebbe bello poter pavimentare il sentiero, mettere uno steccato ai lati e una bella distesa di fiori nelle vicinanze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
