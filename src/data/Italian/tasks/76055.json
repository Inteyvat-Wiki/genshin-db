			"dialogs": [
				{
					"id": 760550101,
					"content": "(Sembra che <color=#FFCC33FF>Lauma</color> abbia sentito qualcosa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "...Che strano. Ero sicura di aver sentito qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Oh, dei visitatori! Venite, venite! Girate la ruota, fermatela, e ci sarà del cibo delizioso!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Oh? Perché non girate la ruota? Dai, provateci. Vi attende del buon cibo!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Mi sembra di sentire... un cucciolo? Gira la ruota per del cibo delizioso... Che cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Ehilà! Potete parlare con me! Molto bene, girate la ruota, o non avrò niente di buono da mangiare!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Hai fame? Se è così, ho portato dei biscotti. Ecco, prendine uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Mmh? Non vuoi girare la ruota, ma vuoi darmi del cibo... Mmh, va bene. Ne prendo un po'. Che male c'è?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Ti ringrazio. Il mio nome è Pavlov, e grazie per il biscotto. Era delizioso! Ma non hai ancora girato la ruota.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Non c'è di che... Ma se posso chiedere, cosa intendi con \"girare la ruota\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Se fai girare la ruota e poi la fermi, cadrà del cibo delizioso. È così che funziona.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Non vuoi girare la ruota, mia cara visitatrice? Sono tutti molto contenti dopo averlo fatto.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Non credo che lo farò. Sembra che tu stia bene qui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Certo che sì! La gente gioca con me, la ruota gioca con me e c'è tanto buon cibo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Bene, mi fa piacere. Saluta il tuo padrone da parte mia. Ora devo andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Ohh... Arrivederci! Torna presto!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
