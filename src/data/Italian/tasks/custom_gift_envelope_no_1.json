			"dialogs": [
				{
					"id": 715330101,
					"content": "Uhm, anche così non va bene... Questi biglietti d'auguri sono davvero difficili da realizzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, stai preparando dei biglietti d'auguri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME}! Ma che bella sorpresa! Non mi aspettavo di vederti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Sei venuto per celebrare il Festival delle lanterne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Oh, no, no. Sono venuto a consegnare una lettera, che sia anche il Festival delle lanterne è solo una coincidenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Klee ha detto che le sarebbe piaciuto tanto un biglietto d'auguri per il Festival delle lanterne, quindi ho pensato di comprargliene uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Immagina la mia sorpresa quando ho scoperto che avrei dovuto realizzarlo io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Ci ho passato sopra un sacco di tempo, ma c'è ancora qualcosa che non va. Però non so bene cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, tu conosci le usanze di Liyue meglio di me... Puoi darmi qualche consiglio per migliorarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Mmm, fammi pensare un secondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
