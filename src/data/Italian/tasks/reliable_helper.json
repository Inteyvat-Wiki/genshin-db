			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "È tutto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Trascini i piedi, proprio come i Cavalieri di Favonius. Ti ho concesso un minuto! L'hai dimenticato o non mi hai proprio ascoltato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "Non presti attenzione, nemmeno a dei dettagli così semplici... 1.000 Mora. Facci quello che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1.000 Mora? Così poco?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "Quanto ti aspettavi per un lavoro fatto in questo modo? È il pagamento che ti meriti, e ora te lo tieni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
