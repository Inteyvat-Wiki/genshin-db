						207004203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004203,
					"content": "Va bene, non dico più niente. Prendi questi 5.000 Mora. Noi mercanti di Snezhnaya diamo sempre quanto promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004204
					],
					"speakerTitle": "Tsarevich"
				},
				{
