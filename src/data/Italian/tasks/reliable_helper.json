			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Missione compiuta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "Così veloce? In meno di un minuto addirittura! Non male. Davvero non male, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Bene, bene. 5.000 Mora, e non uno di meno. Tieni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "\"Non male\", e poi ci dà solo 5.000 Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "#Su, non fare l{F#a}{M#o} schizzinos{F#a}{M#o}. Ho calcolato questo pagamento con molta accuratezza, ed è commisurato al lavoro fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Per ricevere ricompense grandiose, bisogna fare cose grandiose. Se un giorno ci incontreremo di nuovo, allora potrai ritentare la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070005,
