							"2070001",
							"2"
						],
						"stepId": 2070001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Che sfortuna incredibile! Questi Cavalieri di Favonius sono davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Tsk. I Cavalieri di Favonius non hanno alcun senso pratico. Hanno detto che c'erano dei mostri più avanti e non mi hanno lasciato passare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Ma non ho ancora ricevuto niente di più concreto da parte loro. Che banda di gente inaffidabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Ho ancora troppe cose da fare. Hanno un'idea di quanti soldi mi stanno facendo perdere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "#Comunque... Dai l'idea di essere {F#un'avventuriera}{M#un avventuriere}... Ti andrebbe di farmi un piccolo favore? Ti pagherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Fantastico. Mi piacciono le persone pratiche. Quando avrai finito, ti darò una bella ricompensa, te l'assicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Se gli occhi non mi ingannano, gli Hilichurl nei dintorni di Mondstadt sembrano essersi moltiplicati. Chissà cosa fanno tutto il giorno questi cosiddetti Cavalieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "Visto che hai accettato di aiutarmi, allora puoi cominciare scacciando gli Hilichurl. Anche se sei solo, mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Va bene, scegli una di queste aree da sgomberare: la cima, il fianco o i piedi della montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Gli Hilichurl sono dappertutto, quindi non cambia molto. Ora va', e non farmi perdere tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Quanto offri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Ah, dipende da come agirai. Se ti comporterai bene, farò in modo che tu riceva una ricca ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
