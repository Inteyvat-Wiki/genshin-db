					"nextDialogs": [
						207003302
					]
				},
				{
					"id": 207003302,
					"content": "Non hai sentito bene, o speri che lascerò correre? Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003303,
					"content": "Ti avevo detto di non danneggiare le casse, e ne hai distrutte così tante? Non so nemmeno se possano più essere vendute, in questo stato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003304,
					"content": "Non ho trovato le merci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003305
					]
				},
				{
					"id": 207003305,
					"content": "Erano le casse! Le casse erano le merci! Altrimenti perché le avrei impilate comunque di fuori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003306,
					"content": "Lasciamo perdere. Lasciamo perdere! Non ho nient'altro da dirti. Ecco 1.000 Mora... Prendili e smamma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003307,
					"content": "1.000 Mora? Ma è troppo poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003308,
					"content": "Troppo poco? Non puoi nemmeno portare a termine un semplice lavoro, e vuoi più soldi? Ecco la somma che ti meriti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
