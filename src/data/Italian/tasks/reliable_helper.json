			"dialogs": [
				{
					"id": 207003101,
					"content": "Scelgo il fianco della montagna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003102
					]
				},
				{
					"id": 207003102,
					"content": "Ah, sul fianco della montagna ci sono delle merci che volevo riportare indietro e vendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003103,
					"content": "Ora non solo le strade sono bloccate, ma l'area dove ho messo il carico è stata anche occupata dagli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003104,
					"content": "Fortunatamente, non hanno buon occhio per le cose di valore e non hanno toccato le mie merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003105,
					"content": "Ora va' e liberati di loro, e ricordati di non toccare il carico. Quelle casse si rompono facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003106,
					"content": "*sospira* Con le strade bloccate, probabilmente le merci non sono più vendibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
