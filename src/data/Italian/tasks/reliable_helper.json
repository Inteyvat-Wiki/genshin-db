					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003202
					]
				},
				{
					"id": 207003202,
					"content": "Niente male, niente male. E nessuna cassa è stata danneggiata... Sembri sapere quello che fai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003203,
					"content": "Ecco, prendi questi 5.000 Mora. Se l'occasione si ripresenterà, faremo ancora affari insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003204,
					"content": "Tutta questa fatica per 5.000 miseri Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003205,
					"content": "#Su, non fare l{F#a}{M#o} schizzinos{F#a}{M#o}. Ho calcolato questo pagamento con molta accuratezza, ed è commisurato al lavoro fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003206,
					"content": "Per ricevere ricompense grandiose, bisogna fare cose grandiose. Se un giorno ci incontreremo di nuovo, allora potrai ritentare la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
