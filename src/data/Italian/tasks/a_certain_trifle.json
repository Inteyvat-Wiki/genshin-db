					},
					{
						"sceneId": 1083,
						"position": [
							-4.946,
							0,
							4.838
						],
						"pointId": 29
					},
					{
						"sceneId": 1083,
						"position": [
							5.155,
							0,
							10.003
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "Salve, Monsieur Iaune. Posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Salve anche a te, Mademoiselle Cornelia. Abbiamo dei copritasti di ricambio per la macchina da scrivere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Alla mia macchina manca un copritasto, per cui vorrei fare domanda per il pezzo di ricambio. Se non ce n'è uno... andrebbe bene anche se si potesse rimborsare l'acquisto di uno nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Rimborsare un copritasto... In teoria non dovrebbe essere un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Firma qui, per favore. Scrivi solo \"Richiesta di rimborso per sostituzione copritasto dovuto a malfunzionamento macchina da scrivere\" e poi firma con il tuo nome e quello del tuo ufficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Molto bene. Posso avere il copritasto oggi stesso, vero? Devo assolutamente tornare al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Monsieur Iaune, hai mai fatto domanda per il rimborso dell'acquisto di un oggetto di proprietà pubblica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Essere rimborsati per le spese di lavoro non è assolutamente come immagini... Non è che semplicemente lo si compra e viene rimborsato. Dobbiamo stilare la lista di tutte le ricevute e documenti per il rimborso tutti i mesi, creare una relazione consuntiva e alla fine del mese dobbiamo inviare il tutto alla Maison Cardinalice affinché le approvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "Questo processo di approvazione è collegato all'approvazione e al pagamento degli stipendi di tutta la Maison Gestion. Se la somma per cui si chiede il rimborso è troppo elevata, la Maison Cardinalice dovrà addirittura inviarla a Messire Neuvillette stesso perché l'approvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "I pagamenti possono essere ufficialmente effettuati solo dopo che viene completata la revisione e che viene firmato tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Se ha una qualsiasi domanda su una certa relazione di una spesa, il membro del personale che ne ha fatto domanda dovrà inoltrare una relazione scritta... Ci stiamo preparando per inoltrare la prima serie di relazioni, che dovremmo completare nei prossimi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "Stai dicendo che, se ho sfortuna, per farmi rimborsare un copritasto sarà necessaria l'autorizzazione di Messire Neuvillette in persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Queste sono le regole, Monsieur Iaune. E le spese totali di questo mese sono parecchie. È molto probabile che poi lui dovrà revisionare le relazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Messire Neuvillette... Un attimo, ma non è il Giudice supremo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Ma è solo un copritasto... e lo stiamo facendo firmare apposta... Qui c'è qualquadra che non cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Non c'è un altro modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Lo penso anch'io. Dopotutto, è solo un copritasto e non abbiamo bisogno di disturbarlo per una cosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "È vero, ci sono altri modi. Potresti andare a comprare un copritasto tu stesso e poi potrei fornirti un riconoscimento di debito ufficiale nei conti pubblici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Dopo che saranno elaborati tutti i rimborsi e che saranno completate le procedure di pagamento, la quantità dovuta ti verrà pagata attingendo dai fondi pubblici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Eccellente! Facciamo così allora! Dopotutto, un copritasto non costa tanto, posso pagarlo di tasca mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Allora firma qui per favore e scrivi sempre \"Richiesta di rimborso per sostituzione copritasto dovuto a malfunzionamento macchina da scrivere\"... Comprerai il pezzo di ricambio da Mademoiselle Estelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Certo, non va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Allora porterò la cambiale a Monsieur Roialte affinché la firmi, poi la porterò a Mademoiselle Estelle per verificare l'ammontare acquistato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Ma tu non ti preoccupare di questo. Sbrigati e vai a comprare il copritasto, io mi occupo del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "#Grazie mille! Sei veramente la migliore, Mademoiselle Cornelia. Vado a comprarlo subito... Vieni, viaggiat{F#rice}{M#ore}, è ora di andare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Proviamo con qualcos'altro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
