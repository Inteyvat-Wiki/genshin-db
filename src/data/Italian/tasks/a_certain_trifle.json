			"dialogs": [
				{
					"id": 740350601,
					"content": "Che c'è, Iaune? Sembri senza fiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle! Ti prego, ho bisogno di un copritasto per una macchina da scrivere! Ce l'hai, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Certo, ma le macchine da scrivere hanno molti tasti diversi! Dai un'occhiata e vedi per quale hai bisogno di un copritasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune inizia a rovistare alla velocità della luce alla ricerca del copritasto di cui ha bisogno...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Questo! È lui! Ecco i soldi. Grazie, Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "L'ultima volta avevi detto che ti sarebbe piaciuto venire in barca con me... Iaune! EHI! Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
