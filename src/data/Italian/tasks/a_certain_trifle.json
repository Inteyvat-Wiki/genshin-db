			},
			"dialogs": [
				{
					"id": 740350301,
					"content": "Un copritasto per una macchina da scrivere... Ehi, Semaine, si possono rimborsare delle cose del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Non ne sono sicuro. Ma se le macchine da scrivere possono essere rimborsate... logica vuole che possano esserlo anche i copritasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
