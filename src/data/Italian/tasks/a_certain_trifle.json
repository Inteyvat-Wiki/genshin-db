			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#Ah, viaggiat{F#rice}{M#ore}... È bello vederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Come vanno le cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Hai le occhiaie e sembra che tu riesca a malapena a parlare. Dovresti riposarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "Non... Non posso riposarmi. Sono stato sveglio tutta la notte a scrivere bozze, ma nessuna mi piaceva davvero! Torniamo a scrivere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Se hai degli affari ufficiali per i quali hai bisogno della mia assistenza, attendi un momento... Prendi posto vicino a Monsieur Roialte, dovrebbe avere ancora del caffè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "De... Devo tornare a scrivere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Argh! No, \"Cari colleghi\" non è abbastanza formale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Non hai un bell'aspetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
