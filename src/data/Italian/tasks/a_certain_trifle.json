						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#Viaggiat{F#rice}{M#ore}, che piacere rivederti qui. Ti va un caffè?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Ora che mi ci fai pensare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Esatto! Anche Paimon voleva chiederlo, ma... ma quei tipi facevano così tanto chiasso, e Paimon non si azzardava a parlare di nient'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "#E io che pensavo che sarei stat{F#a}{M#o} buttat{F#a}{M#o} fuori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Perché? Ahahah, non c'è da preoccuparsi! Le guardie ti hanno fatto entrare, quindi perché dovremmo prenderci la responsabilità di cacciarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "#Questo è anche un esempio di delegazione dell'autorità e delle responsabilità. Ciao, viaggiat{F#rice}{M#ore}, mi chiamo Semaine ed è un piacere fare la tua conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Salve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine ha lavorato nei tribunali come assistente segretario, ma a causa di alcune... complicate circostanze è stato ritrasferito alla Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Grazie alle sue deduzioni logiche e precise, siamo riusciti a trovare una soluzione a molti problemi prima irrisolvibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Suvvia, così è un po' troppo. Non ho fatto che portare con me la mia esperienza lavorativa pregressa e usare il valore di certe cose per dedurre l'importanza delle questioni a esse collegate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "Anche se, in pratica, nel corso del lavoro salteranno fuori infinite questioni che non possono essere valutate in modo preciso. In questi casi, è di grande aiuto applicare gli assiomi ben sviluppati di Roialte sulle interazioni umane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "E questo cosa vorrebbe dire...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "In poche parole, quando si ha a che fare con il lavoro, Semaine è molto abile nel considerare tutte le parti e la loro situazione, facendo sentire loro la propria importanza. È come l'ago di una bilancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "E se l'atto di equilibrare è semplicemente impossibile, posso usare il \"peso delle parole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Di sicuro Iaune sta lavorando sodo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "È vero! Sembra che stia per svenire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "È una strada che dobbiamo percorrere tutti prima o poi. Se dovessi aiutare Iaune a scrivere il documento, lui non imparerebbe la lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Ha la testa e il cuore pieni di fantasie idealistiche su ciò che è lavorare nella Maison Gestion. Ma le fantasie sono per i giovani, non per il personale della Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "E io semplicemente non so come scrivere quei documenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Sei piuttosto diretto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "D'accordo, allora... quali affari ti portano qui? Dimmi e vedrò se posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune viene preso improvvisamente dal panico...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Ahimè! È la fine! ...Monsieur Roialte, ha dei copritasti per la macchina da scrivere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Mentre battevo, a un certo punto mi sono accorto che mancava un copritasto. Non ho idea di quando sia potuto saltare via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "Hai già guardato in giro? Magari è solo caduto a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "O forse è finito dentro a un libro, o in mezzo a dei documenti... Hai controllato bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "O magari è finito in un portapenne. O ti è finito in una manica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "O tra i capelli, o nella tazza del tè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "Ho guardato dappertutto! Perfino nelle tasche e nelle scarpe. Ho cercato ovunque, non è da nessuna parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Molto bene. Allora vai a chiedere a Cornelia. Se abbiamo dei copritasti di ricambio, devi inoltrare una richiesta a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Dovrei andare semplicemente a comprarmene uno! Non dovrebbe servire molto tempo a Estelle per farmi un copritasto nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Mio caro Iaune, vuoi davvero spenderci dei soldi tuoi? La macchina da scrivere e i suoi copritasti sono proprietà pubblica e proprietà della Maison Gestion. La procedura corretta sarebbe inoltrare domanda a Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "In fondo non costa molto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Non è una questione di quanto costa. È una questione di autorità e responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "La riparazione di una proprietà pubblica della Maison Gestion dovrebbe essere pagata dai conti pubblici della stessa Maison!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Se lo paghi di tasca tua e non fai domanda di rimborso, quando verrà fatto il controllo delle spese a fine anno, non si saprà da dove sono venuti i soldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "Va bene! Va bene! Vado a cercare Cornelia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Anche comprare qualcosa è una scocciatura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "In realtà qui è abbastanza normale. Da questa parte, prego. Andiamo a cercare Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Anche pagare per delle cose è una tale seccatura...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Potete aiutarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "E tu saresti...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Perché nessuno di voi era sorpreso di vedermi qui prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
		{
			"id": 7403503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
