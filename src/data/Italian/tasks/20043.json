			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quinn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430501,
					"content": "Mi avete trovato dei Tramontini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430502,
					"content": "Eccoli qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "Ottimo, dovrebbero bastare per la signorina Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430504,
					"content": "*sospira* Ma sembra che molti dei miei clienti se ne siano andati. A quanto pare, non è un lavoro per una persona sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430505,
					"content": "Oh... dovrei darvi qualcosa per il disturbo. Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430506,
					"content": "Non abbiamo bisogno di regali, ma abbiamo una richiesta per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430507,
					"content": "Si tratta di Michelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Michelle? L'avete vista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430509,
					"content": "Dovrei darle un incarico meno pesante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430510,
					"content": "Le ho semplicemente chiesto di badare alla bancarella di frutta per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430511,
					"content": "Oh, è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430512,
					"content": "Ma, senza altri clienti, pare che non avrò bisogno neanche di quello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430513,
					"content": "Per piacere, ditele di tornare a casa e riposarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430514,
					"content": "Andrò a recuperare quella consegna tra un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
			"id": 2004306,
