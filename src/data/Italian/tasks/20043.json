					"Michelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "Ahi, la schiena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430102,
					"content": "Stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "Mi stavo preparando per andare al lavoro, ma poi, tutto a un tratto, ha iniziato a farmi male la schiena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430104,
					"content": "Ho promesso a Quinn che gli avrei dato una mano alla sua bancarella di frutta, ma credo sia meglio se prima resto qui a riposare un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430105,
					"content": "Ma non posso fermare tutto per colpa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430106,
					"content": "Potresti andare da Quinn e chiedergli cosa vuole che faccia per lui? Così potrò preparare il necessario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Grazie, dopo un piccolo riposo dovrei stare meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430109,
					"content": "Non è lontano, puoi farcela, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Dai, è davvero così tanto da chiedere? Dai una mano a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2004302,
			"completionStepIds": [],
