					"Quinn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "Dov'è la mia consegna? Ma è possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "*sospira* La mia bancarella di frutta è rimasta a corto di Tramontini. Ho fatto un ordine un po' di tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Ma non sono mai arrivati. E i miei clienti non possono aspettare in eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "Eury è già venuta tre volte, chiedendo solo <color=#00E1FFFF>tre Tramontini</color>. È una cliente abituale da tanto tempo e ora ho paura che potrei perderla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Io devo rimanere alla bancarella... Ah, se solo qualcuno potesse raccogliere dei Tramontini selvatici per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Se è così urgente, posso andare io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Davvero? Ma è meraviglioso! Ti ringrazio tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "Michelle sta arrivando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Un momento! Perché Michelle sta andando a cogliere frutta in quelle condizioni?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Possiamo dare una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
