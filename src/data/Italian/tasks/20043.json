			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "Hai parlato con Quinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Sì, dice che dovresti riposarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Oggi non c'è nulla da fare per lui, vai a casa e goditi un po' di riposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Davvero? *sospira* Sembra che dovrò trovarmi qualcos'altro da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Cosa? Non ti prendi neanche un giorno di riposo?! Approfittane finché puoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Fermatevi e percepite ciò che sta accadendo intorno a voi. Sono i venti del Supremo Barbatos, che lavorano alacremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Siamo benedetti da Barbatos. Non è un privilegio che dovremmo prendere alla leggera... Tutti dovremmo fare la nostra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Quanto alla tua parte... cosa stavi facendo? Perché stai sudando così tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "Sembra che ti dai un gran daffare. Ma non è una cosa negativa, perché più fatichiamo, più sudiamo e più troveremo piacevoli i venti di Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Ecco, tieni questa bottiglia di latte. Bevi e torna ai tuoi compiti: il lavoro in questo mondo non manca mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
