			},
			"dialogs": [
				{
					"id": 200430401,
					"content": "Avete trovato dei <color=#00E1FFFF>Tramontini</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Dovrebbe essere pieno di <color=#00E1FFFF>Tramontini</color> appena fuori dalla città. Vi prego, io devo stare qui... Potete andare a prenderne velocemente qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
			"id": 2004305,
