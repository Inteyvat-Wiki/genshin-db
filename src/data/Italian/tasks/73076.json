			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "Allora, avete incontrato qualcuna di quelle creature feroci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760302,
					"content": "Se vi capita di incontrare quelle creature, allontanatele, per favore. Sarebbe una buona cosa, sia per le persone che per gli animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760303,
					"content": "A proposito del Raja alligatore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Dicono che il Raja alligatore infesti le acque sul versante orientale della città. Ma ho controllato diverse volte e non ho mai visto quella bestia astuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760305,
					"content": "A proposito del Raja Chiomalunga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "Da queste parti si racconta che il Raja Chiomalunga esca dai boschi a ovest a mezzanotte e rapisca i bambini cattivi che non vogliono andare a letto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760307,
					"content": "Dei genitori si saranno inventati la parte del rapimento per spaventare i bambini capricciosi, ma le Tigri Chiomalunga sono davvero più attive di notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760308,
					"content": "Si dice che alcuni viandanti che viaggiavano di notte siano stati inseguiti da un'enorme Tigre Chiomalunga, anche se, per fortuna, finora non ci sono state vittime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760309,
					"content": "A proposito del Re delle bestie da soma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "Ho sentito dire che alcune bestie da soma selvatiche sono territoriali e attaccano gli intrusi. Non ho dubbi che anche il Re delle bestie da soma faccia così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760311,
					"content": "Il suo territorio è da qualche parte a est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760312,
					"content": "Mi chiedo quanto debba essere grande il Re delle bestie da soma per essersi guadagnato questo appellativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760313,
					"content": "Stiamo ancora indagando al riguardo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "Bene, continuate così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				}
			]
		},
		{
			"id": 7307604,
