			"dialogs": [
				{
					"id": 730761001,
					"content": "\"A proposito dei recenti avvistamenti di grosse Tigri Chiomalunga:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "Avviso"
				},
				{
					"id": 730761002,
					"content": "\"Si prega di non restare all'aperto dopo il tramonto. Le Tigri Chiomalunga sono attive soprattutto di notte.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "Avviso"
				},
				{
					"id": 730761003,
					"content": "\"Si prega di non lasciare della carne in giro in questa zona. Dare da mangiare alle tigri non è il modo corretto di stare al sicuro. Al contrario, potrebbe incoraggiare le tigri a restare.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avviso"
				}
			]
		}
