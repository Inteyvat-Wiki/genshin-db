					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "In effetti, è solo a Sumeru che si può veramente percepire la natura. L'aria di Fontaine, invece, è composta quasi solo da fumi tossici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760102,
					"content": "Che c'è? Posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760103,
					"content": "#Siamo solo un po' curios{F#e}{M#i}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "Vivi in questa tenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760105,
					"content": "Sì, vivo qui da un po' ormai. Oh, capisco... È strano vedere qualcuno di Fontaine che vive in una tenda nelle terre selvagge di Sumeru, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760106,
					"content": "Quanto al perché... vi spiegherò tutto. Ma prima, come vi chiamate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760107,
					"content": "Paimon si chiama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760108,
					"content": "#Io sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#{NICKNAME} e Paimon. Capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760110,
					"content": "Io sono Santon. Come potete vedere, vengo da Fontaine, e sono qui a Sumeru per la foresta, naturalmente! Adoro le foreste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760111,
					"content": "Se si vive in città troppo a lungo, il corpo diventa debole per la mancanza di esercizio e la mente si impigrisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760112,
					"content": "Solo nell'immensa distesa degli spazi aperti si può ritrovare l'armonia. Le foreste sono il luogo migliore per rientrare in sintonia con la natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760113,
					"content": "Ecco perché sono venuto a Sumeru. Dopotutto, le foreste di qui sono probabilmente le migliori in tutta Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760114,
					"content": "Paimon ha capito, ma non del tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760115,
					"content": "Ma con tutti i tipi di mostri che ci abitano, le foreste di Sumeru possono essere un po' pericolose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760116,
					"content": "È questo il punto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760117,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760118,
					"content": "Non mi sentirei davvero vivo se non corressi alcun pericolo! Non preoccupatevi, sono un famoso cacciatore di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760119,
					"content": "Quindi il tuo vero amore è la caccia nelle foreste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760120,
					"content": "Non sei altro che un bracconiere di Fontaine, non è così?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760121,
					"content": "Credo sia meglio intervenire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "No, avete capito male. Non sono un bracconiere! Il bracconaggio è un reato grave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760124,
					"content": "Se ti beccano a cacciare illegalmente a Fontaine, la tua vita è finita. Non oserei mai farlo. Noi cacciatori di Fontaine ci occupiamo soprattutto di \"animali feroci\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760125,
					"content": "Animali feroci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760126,
					"content": "Pensaci. Gli animali feroci che si avvicinano troppo agli insediamenti umani danneggiano entrambe le parti, quindi devono essere tenuti a distanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760127,
					"content": "Allora è questo che fai...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760128,
					"content": "Sì. Così facendo, chi vive nelle vicinanze non verrà più disturbato da animali feroci, e allo stesso modo le attività umane non daranno più fastidio agli animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760129,
					"content": "In realtà, avevo sentito dire che c'erano degli animali feroci qui vicino, e mi avevano ingaggiato per cacciarli via. Insomma, sono un cacciatore! Avrei dovuto starmene con le mani in mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760130,
					"content": "Naturalmente, io stesso sono interessato a quelle creature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760131,
					"content": "Come quell'Alligatore ipertrofico, che è davvero impressionante. I bambini lo chiamano il \"Raja alligatore\", sembra uscito direttamente da una leggenda metropolitana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760132,
					"content": "Dicono che si trovi nelle acque qui vicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760133,
					"content": "E poi c'è il Raja Chiomalunga che rapisce i bambini, e la bestia da soma gigante che blocca il passaggio per Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760134,
					"content": "Il Raja Chiomalunga dovrebbe trovarsi nella giungla a ovest di qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760135,
					"content": "Invece il Re delle bestie da soma... Oh, chiamano così la bestia da soma gigante. Alcuni testimoni spaventati dicono che infesti la zona orientale e aggredisca i passanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760136,
					"content": "Sembra piuttosto pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760137,
					"content": "#Sì. Fate attenzione se le vedete. Ma percepisco in voi uno spirito da cacciat{F#rici}{M#ori} espert{F#e}{M#i}, quindi forse le mie preoccupazioni sono infondate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760138,
					"content": "Se vi capitasse di incontrare le bestie, allontanatele, ve ne prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760139,
					"content": "Così la gente di qui resterà al sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760140,
					"content": "Certo, se ne incontreremo qualcuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "Ve ne sarei molto grato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760142,
					"content": "#Fate attenzione alla sicurezza delle persone, degli animali feroci, e di voi stess{F#e}{M#i}, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760143,
					"content": "Puoi scommetterci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760122,
					"content": "Il bracconaggio sconvolge l'ecosistema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
