			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anaya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "Il \"Re delle bestie da soma\"? L'ho visto l'altra sera mentre ero nella foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760602,
					"content": "Era una notte nuvolosa. Stavo camminando, quando un'ombra grande come una collina si è precipitata verso di me con un verso rimbombante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760603,
					"content": "Ho perso i sensi, rinvenendo solo il giorno dopo. Il ragazzo che mi ha riportato indietro ha detto che mi ha trovato ai piedi della montagna. Per fortuna non avevo ferite gravi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760604,
					"content": "Beh, non conosco la posizione esatta... Forse è a est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anaya"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307607",
							"2"
						],
						"stepId": 7307607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "Avete scacciato le creature selvagge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760702,
					"content": "Io non ne ho ancora vista nessuna. Allora, quanto erano temibili quelle bestie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760703,
					"content": "Non erano poi così minacciose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Sembra che per voi sia stata una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760707,
					"content": "Sono sollevato di sapere che quelle creature sono scomparse, ma mi rattrista non averle viste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760708,
					"content": "In natura è normale vedere animali che si arrendono ad altri più forti di loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760709,
					"content": "Ahah, ma la prossima volta non perderò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760710,
					"content": "E nemmeno noi perderemo contro di te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "Proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760712,
					"content": "Ma \"affrontare animali feroci\" non è forse il compito dei guardaboschi qui a Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760713,
					"content": "Eh? Non l'ho detto prima? Si tratta di un incarico che ho accettato... da parte di un guardaboschi che conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760714,
					"content": "I recenti problemi legati all'Avvizzimento hanno coinvolto molto personale, anche se non conosco i dettagli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760715,
					"content": "Così mi sono toccati lavori come \"affrontare animali feroci\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760716,
					"content": "Quindi ecco perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760717,
					"content": "Grazie mille per il tuo aiuto. Ecco il tuo pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760705,
					"content": "Oh, terrificante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "Davvero? Quanto avrei voluto vederlo di persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				}
			]
		},
