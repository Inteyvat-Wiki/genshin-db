			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "Il \"Re delle bestie da soma\"? È successo qualche giorno fa. Stavo cercando un minerale speciale quando in qualche modo sono uscito dalla montagna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760402,
					"content": "E lì c'era l'enorme bestia da soma. Cavolo, era gigantesca. Non ne ho mai vista una così grande in vita mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760403,
					"content": "Mi ha caricato non appena mi ha visto. Per fortuna, ho corso abbastanza veloce da riuscire a scappare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760404,
					"content": "L'altro lato di quale montagna? Ah, è una delle montagne verso occidente. Non ricordo bene i dettagli... Ma dev'essere sul lato ovest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hong"
				}
			]
		},
		{
			"id": 7307605,
			"completionStepIds": [
				7307609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
