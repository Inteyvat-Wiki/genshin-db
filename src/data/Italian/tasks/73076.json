			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najib",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "Il Re delle bestie da soma? Intendi la gigantesca bestia da soma, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760502,
					"content": "Stavo andando a Liyue due giorni fa, quando l'ho vista vicino alla Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760503,
					"content": "Fortunatamente per me, stava dormendo. Mi sono allontanato in punta di piedi e sono scappato. Era grande come una collina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760504,
					"content": "Dove l'ho visto? Liyue è a sud di qui, quindi dev'essere stato da qualche parte in quella direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760505,
					"content": "Ma di solito le persone non raggiungono Liyue da Sumeru via acqua? Che senso ha avvicinarsi alla Voragine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760506,
					"content": "È una cosa.. personale. Credo che non vi riguardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760507,
					"content": "E questo è tutto quello che so. Ho altre cose da fare, quindi lasciatemi in pace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najib"
				}
			]
		},
		{
