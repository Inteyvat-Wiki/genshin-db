			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "Grazie, Javan. Dev'essere stato difficile viaggiare con questo vecchio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Ecco... Non è un oggetto di valore, ma consideratelo come un ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Wow, di che si tratta? Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Dovreste averlo già visto prima, questo fiorellino essiccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Questo è...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Sì, se non mi sbaglio... Devono avertene donato uno anche loro, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Eheh... Lo sapevo, il nostro incontro non è affatto una coincidenza... Non credo nel destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "Vi affido questo fiore. Per favore, portatelo ai nostri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Certo, lo faremo. Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "Potrebbero avermi dimenticato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "Non posso neppure vederli... Non riesco nemmeno a credere alla loro esistenza. Forse... sono solo una mia fantasia d'infanzia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "#Ma non mi arrendo. Portateglielo, ragazz{F#e}{M#i}... Prima che giunga il giorno in cui non potrete più incontrarvi, prima che la possibilità di un miracolo svanisca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
