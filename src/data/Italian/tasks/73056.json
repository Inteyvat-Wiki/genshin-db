			"dialogs": [
				{
					"id": 730560501,
					"content": "Guardate, guardate qui... Le piante sono rigogliose! Sembra che il terreno devastato da Marana possa ancora dare vita a piante vivaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560502,
					"content": "Ahah, Mawtiyima, vecchia mia! Ancora operativa, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560503,
					"content": "Wow, Khayyam sembra essersi ringiovanito all'improvviso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "E sembra che all'improvviso Paimon sappia cosa dire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Ehi! Come sarebbe a dire?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "#Mmh... Dovrebbero bastare. Grazie per essere venut{F#e}{M#i} fin qui con me. Visto che abbiamo fatto tutto quello che dovevamo, ora dovremmo tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Ahah, fantastico... Questi campioni potrebbero davvero aiutare la ricerca sui segreti e le debolezze dell'Avvizzimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Grazie per il vostro impegno, prendiamo la stessa strada per tornare indietro... Ho qualcosa per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Evviva! Ricompense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Eheh, forse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon non è sicura di ciò che intendi, ma evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
