			"dialogs": [
				{
					"id": 730560301,
					"content": "Interessante... Le piante qui sembrano... rianimarsi. Quindi Mawtiyima è di nuovo in vigore... Fantastico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560302,
					"content": "Eh... Quindi anche Khayyam conosce Mawtiyima? Paimon pensava che solo gli Aranara lo sapessero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560303,
					"content": "Paimon, chiudi la bocca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "Aranara, giusto? Quindi anche voi li avete visti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560306,
					"content": "Eh...? Mmm... S-Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "Che succede, Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "\"Iram se n'è andato con le rose, dove finirà la coppa del re?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560310,
					"content": "Raggiungiamo il luogo successivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560308,
					"content": "Anche tu hai visto gli Aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "Paimon...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305610",
							"2"
						],
						"stepId": 7305610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ah! Qui! Guardate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Eh? Un'altra pianta? Perché sei così emozionato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "No, non è per quello! Guardate, il nostro castello segreto! Ah! È ridotto davvero male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Eh...? \"Castello segreto\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Ahah! Ecco di ritorno lo studioso Omar! Con i segreti celesti! Irfan, Siman, dove siete? Non venite a darmi il benvenuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "#Ah... Ehm, le mie scuse, ragazz{F#e}{M#i}. Io... mi sono lasciato trasportare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "È l'età a farmi questo, offuscando il presente e facendo prevalere il passato, sempre di più... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan e Siman erano miei amici. Abbiamo costruito il castello insieme, noi tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Al tempo, Irfan era il grande musicista, Siman il comandante supremo e io lo studioso di astrologia. A volte ci scambiavamo i ruoli... Come quando i bambini si annoiano e decidono di cambiare gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan aveva del talento per la musica, Siman era alto e forte... E io? Ahah, io ero solo un avido lettore nato in una famiglia con un po' di Mora in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "È qui che giocavi durante la tua infanzia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "No, questo è il nostro mondo segreto. Abbiamo fatto una promessa: non ci saremmo mai dimenticati gli uni degli altri e avremmo guidato l'Armata della riconquista per riprenderci il castello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Eheh, sono passati vent'anni e potrebbero aver dimenticato la nostra promessa... È diventato il mio accampamento di ricerca nella foresta, rimasto in funzione fino a trent'anni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Poi è arrivato persino Marana, ma l'Armata della riconquista non si è mai palesata. Eheh, è piuttosto comprensibile... Cosa poteva mai fare una promessa d'infanzia contro la morte?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Ma... Visto che li ricordi ancora, anche per loro sarà lo stesso! Non scoraggiarti, Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Scoraggiarmi? Neanche per sogno! I ricordi d'infanzia, gli \"amici immaginari\" condivisi e il mondo nascosto agli adulti. Probabilmente è un peccato, ma... il tempo non torna indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Amici immaginari\"... Intendi gli Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon, chiudi la bocca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Ahah, quasi dimenticavo: vi avevo chiesto di aiutarmi a campionare queste piante appena cresciute, non a fare due chiacchiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Vi prego di perdonare questo vecchio per tutte le chiacchiere inutili. Continuiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Parli troppo, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Siete stati tu e i tuoi amici a fare tutto questo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "No, non tutto. Abbiamo promesso che avremo guidato l'Armata della riconquista per riprenderci il castello... Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Sono diventato un ricercatore botanico dell'Akademiya, e sono tornato in questo posto per occuparmi di alcune ricostruzioni. Sono stato qui più volte per portare dentro e fuori un sacco di rifiuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
