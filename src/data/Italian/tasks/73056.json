					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "#Siamo amic{F#he}{M#i}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560709
					]
				},
				{
