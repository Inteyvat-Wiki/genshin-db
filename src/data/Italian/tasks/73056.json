			"dialogs": [
				{
					"id": 730560701,
					"content": "Cosa ci fate voi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560702,
					"content": "Ehi!!! H-Hai spaventato Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560703,
					"content": "#Conoscete il mio nome. Ma Aranaga non vi ha mai vist{F#e}{M#i} prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Quindi... Perché siete qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560705,
					"content": "È difficile da spiegare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Anche se hai dimenticato molte cose, dovresti sapere che non vogliamo fare nulla di male! Siamo sempre dalla vostra parte e aiuteremo per sempre Mawtiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "Mawtiyima... La conoscete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "Umpf, non sembrate cattive persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "Ma, per favore, non rimanete qui. Andate via presto. Si sta ancora riprendendo, la foresta... Quindi, non è il caso di restare qui, gentili ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "Ehi, aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "Abbiamo una cosa per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Una cosa? Per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560715,
					"content": "Dammi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560716,
					"content": "Tieni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "Vedi? Ricordi? Ci hai dato lo stesso fiore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560719,
					"content": "#Davvero... Voi... {F#Mie}{M#Miei} amic{F#he}{M#i}...? Fiore molto importante, perché qui, con voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560720,
						730560721
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560720,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560722,
					"content": "Spieghi tutte le avventure in dettaglio ad Aranaga, anche come avete salvato Mawtiyima dall'Avvizzimento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560723
					]
				},
				{
					"id": 730560723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560724
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560724,
					"content": "Allora? Ricordi qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560725,
					"content": "Non capisco, non ricordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560726
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560726,
					"content": "Cooosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560727,
						730560728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560727,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560729,
					"content": "Però grazie. Il mio giardino, se ricordo. Venite, prego.",
