					"nextDialogs": [
						730560732
					]
				},
				{
					"id": 730560732,
					"content": "Aranaga se n'è... andato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560733,
						730560735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560733,
					"content": "Già, se n'è andato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560734
					]
				},
				{
					"id": 730560734,
					"content": "#Beh, Aranaga ci ha invitat{F#e}{M#i} nel suo giardino, però... Significa che non ha rifiutato la nostra amicizia, giusto? Facciamogli visita, ogni tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560735,
					"content": "#Ma ci ha invitat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560736
					]
				},
				{
					"id": 730560736,
					"content": "Mmh... È vero. Facciamo visita ad Aranaga ogni tanto, che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560728,
					"content": "Non è una sorpresa...",
