			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Ahah, interessante... è davvero curioso. Si sta rianimando, la foresta si sta... rianimando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Ciao, nonno! Ti sei perso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Mmh... Mmh? Ah, stai parlando con me? Ahah, perso, hai detto così? No, no, non mi sono perso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "#Buongiorno, ragazz{F#e}{M#i}. Sono Giyath Khayyam, un Dastur dell'Amu{RUBY#[S]Biologia}rta, ahah... Chiamatemi pure Khayyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Mmh... Salve, Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "No... Fai come me, abbassa la punta della lingua e inarca la parte centrale... Khaaa. Poi arrotonda le labbra.... Yyaaa. Infine, serra le labbra in modo naturale... Mmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Mmh... Khaaa... Yyaaa... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "#Così! Ben fatto! Nara dorat{F#a}{M#o}, ora ripetilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Khaaa... Yyaaa... Mmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "#Ahah, bene! Sei stat{F#a}{M#o} molto più brav{F#a}{M#o} di questa creaturina! Ve l'avevo detto che potevo insegnare la fonetica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Quindi, Khayyam... Se non ti sei perso, cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "Cosa ci faccio? Eheh... Sono un ricercatore forestale. Per noi la foresta è la nostra città natale. Come potrei essermi perso nella mia città, in cui sono finalmente tornato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "La foresta è stata profondamente afflitta dall'Avvizzimento. Negli ultimi tre decenni, le piante sono diminuite rapidamente in termini di specie e di numero, mentre il Fungoide maligno ha continuato a crescere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Tuttavia, di recente l'Avvizzimento nelle vicinanze è sparito. Le piante che una volta erano scomparse hanno ricominciato a crescere e, per qualche motivo, la riproduzione del Fungoide ha subito un rallentamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "Non vedo nulla del genere da sessant'anni... Quindi sono venuto qui per convalidare la mia ipotesi amatoriale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Paimon ha capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "A proposito del convalidare la tua ipotesi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Ahah, è successo sessant'anni fa... Abbassa le aspettative, un vecchio come me potrebbe non ricordarselo bene. Ma sono convinto che la scomparsa dell'Avvizzimento sia legata in particolare a quella cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "Pertanto, sto entrando in questa grotta per raccogliere alcuni campioni, al fine di dimostrare la mia ipotesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Paimon ha capito... Ma è comunque un luogo pericoloso, anche senza un Marana nella grotta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Ahah, non è un problema per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Mmh, aspetta... Cos'hai detto? Cosa c'è nella grotta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "Il Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Mmh... Ripensandoci, forse ho bisogno del vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Mmh, Paimon te l'aveva detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Eheh, scusatemi... Non vi ho ancora chiesto come vi chiamate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Chiamami pure {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "E Paimon... Si pronuncia Paimon! Paiii...monnn...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon? Paimon... Ahah, che nome interessante... Sei la prima umana... Ehm, fata che conosco con questo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "Oh, scusa, scusa. Non volevo offenderti... Volevo dire \"creaturina\", non fata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Beh, non è che \"creaturina\" sia molto meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Beh, ora basta con le chiacchiere. Seguitemi, Javan, è ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "\"Javan\"...? Cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "È una parola antica nel dialetto della mia città natale, significa \"giovani coraggiosi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Più precisamente, significa \"giovani che non trascurano mai il male immenso, né si tirano indietro di fronte alla disparità infinita\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Hihi, sembriamo proprio noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "Oh? Pensate che vi si addica? Ahah, seguitemi, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "Eh? Nonno Khayyam, riesci a tenere il nostro passo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Ahah... Ho studiato la foresta per quasi trent'anni, quindi non sottovalutate il vigore di questo vecchio! Andate avanti, io vi raggiungerò a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "L'Avvizzimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Ti serve il nostro aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Ahah... Grazie mille, siete proprio gentili. Il mio corpo sarà anche quello di un uomo anziano, ma non la mia mente. Non sottovalutatemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Dopotutto, so come rendere felice la foresta in modo che non mi ferisca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "Cosa ci fai qui, Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Mmh... La pronuncia era troppo veloce, troppo rapida. Non è male... Ma se lo articolassi più lentamente sarebbe perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Sto concentrando la mia indagine principalmente su tre aree. Ahah, spero che i miei ricordi di trent'anni fa non siano del tutto svaniti... Dovrei essere ancora in grado di identificare i luoghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560202,
					"content": "A ogni modo, grazie per la compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Khayyam"
				},
				{
