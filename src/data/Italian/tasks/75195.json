			"dialogs": [
				{
					"id": 751950201,
					"content": "Per tutte le Wayob, di certo non può essere... un'anima gentile comparsa all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Avevo in programma di fare venire un Tatankasauro per aiutarmi a distruggere e rimuovere le pietre in questo campo arido. Così, se fosse apparso qualche mostro, il Tatankasauro avrebbe potuto anche aiutarmi a sbarazzarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Non avevo nemmeno iniziato quando ho visto che qualcuno aveva già fatto tutto il lavoro per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ah... Ho concimato gli alberi da frutto davanti alla mia porta ogni mattina da che ho memoria. Dev'essere il modo degli dèi per ricompensarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "#Anima gentile, {F#emissaria}{M#emissario} degli dèi! Io, Dutta, ti ringrazio vivamente per la tua generosità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Non ho nulla di speciale da donarti, ma ho un po' di Mora e qualche ninnolo. Accettali, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
