			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "\"Compescio\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Come procede la statua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Quell'uomo della pietra è molto abile, miao miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "Ha finito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "No, ma in men che non si dica, ha portato una grande, grande pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Poi ha cominciato a batterla, bonk bonk bonk, il tutto mentre borbottava cose su \"commiaottente\" e \"compescio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "A proposito, volevo chiedere: cosa sono un \"commiaottente\" e un \"compescio\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "Penso che tu intenda \"committente\" e \"compenso\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Fondamentalmente, dato che gli hai chiesto di fare un lavoro, dovresti dargli qualcosa in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah, è così? Gli umani sono davvero strani... Va bene, gli permetterò di grattarmi le orecchie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Ehm... Paimon non pensa che sia sufficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Ah no? Allora forse dovrei dargli qualcosa da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Penso che quello che vuole siano dei Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Mora? Non sono cose da infilare nella cassetta delle offerte? Che strano, pensare che gli umani si preoccupino di queste cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "Beh, un compenso è molto importante, in realtà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Umpf. Mi fiderò delle vostre parole, visto l'aiuto che mi avete dato finora. Parlerò con l'uomo della pietra al nostro ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "Tuttavia, l'uomo della pietra non sta più facendo bonk bonk bonk. Sembra che stia portando in giro un corto palo di legno, chissà perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Un palo di legno? Per scolpire non si usano martello, scalpello e così via?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Gli si saranno rotti gli attrezzi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#Oh mamma. {NICKNAME}, andiamo a cercare il signor Ooshima. Sembra che abbia bisogno di aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221302,
