			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Ottimo! Dovrebbero andare benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Andrò a cercare un posto adatto all'esterno per allestire una fornace, e poi comincerò a costruire i miei attrezzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Potreste avvisare la Somma Sacerdotessa? Io inizio a prepararmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miao miao miao. C'è qualcosa che non va? Non preoccupatevi, preparerò un \"compescio\" adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "È \"compenso\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Ehm, non importa. In pratica, l'uomo della pietra ha... Gli strumenti del signor Ooshima sono rotti, ma gli abbiamo dato i materiali necessari per ripararli, quindi non dovrebbero esserci problemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Mmmh? Problemi, dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Meraviglioso. Non vedo l'ora di ammirare quel sasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki ha detto che una volta che la pietra a mia immagine e somiglianza sarà pronta, potrebbe succedere qualcosa di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, sono piena di aspettative! Che tipo di cose buone potrebbero accadere? Forse Hibiki potrebbe anche tornare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "No, non ci sono problemi, va tutto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Beh, quanto sarà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
				},
				{
					"id": 722130604,
					"content": "Mmmh? Cosa vuol dire \"quanto\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130605
					],
					"speakerTitle": "Neko"
				}
			]
		}
	]
}