					"Balfour",
					"Haniyyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Com'è andata, Cometa d'oro? Come ti è sembrato questo primo assaggio del Teatro Micomeccanico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Dalla tua espressione, suppongo tu non abbia ancora raggiunto una conclusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Ho giocato per un solo round, dopotutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Non hai tutti i torti. Con così pochi contenuti da testare è difficile valutare pregi e difetti del Teatro Micomeccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Non preoccuparti. Io e la signorina Haniyyah ti prepareremo un nuovo livello di gioco ogni giorno per sette giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Vieni quando hai tempo e potrai provare i nuovi livelli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Sebbene in queste occasioni sia tu ad avere l'ultima parola, questo gioco l'abbiamo inventato io e la signorina Haniyyah per conto nostro, per cui è una spesa temporale che si trova al di fuori dei tuoi piani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "#Quindi, verrai ricompensat{F#a}{M#o} per il tuo servizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Ahah, non posso rifiutare un'offerta del genere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "#Ahah, molto dirett{F#a}{M#o}, mi piace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "Ho richiesto che ai due Miconoidi vengano concessi abbastanza privilegi da residenti, per cui saranno qui a Porto Ormos per tutta la fase di prova del Teatro Micomeccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "E anche la tua Partner d'argento può passare altro tempo con Tamburino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "#Sono content{F#a}{M#o} per lei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Eheh, sì, dovresti andare anche tu a trovare Tamburino. Gli manchi molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Porta questo con te e dallo da mangiare a Tamburino e Fuocallegro, è il loro cibo preferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Nemmeno io vedo l'ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Rivedrai quei Mora durante il prossimo torneo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Devo fare altre prove.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
