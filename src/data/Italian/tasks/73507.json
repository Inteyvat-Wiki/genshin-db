					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070508,
						735070509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070508,
					"content": "Il periodo di prova durerà ancora un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070510,
					"content": "Oh, e quindi Haniyyah e i nostri Micoamici saranno qui per un po' eh? Ottimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070511,
					"content": "Paimon voleva chiederti di restare qui ancora un giorno per passare più tempo coi Miconoidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "Ma sembra che abbiamo preso due piccioni con una fava: testare il Teatro Micomeccanico e contemporaneamente giocare con i Micoamici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "Passi del tempo spensierato con Paimon, Tamburino e Fuocallegro, offrendogli delle Gelatine meravigliose.\\nPaimon e i vostri Micoamici si sono divertiti un sacco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "Eheh, che spasso! Tutte le preoccupazioni di Paimon sono volate via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070515,
					"content": "Tamburino, Fuocallegro... Allora ci vediamo domani!",
					"roleType": "TALK_ROLE_NPC",
