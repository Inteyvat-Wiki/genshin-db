			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "Cometa d'oro e Partner d'argento... Ci rivediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Sempre con grande energia, vedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Anche tu non sembri in cattiva forma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "H-Haniyyah! E c'è anche Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Che bello incontrarvi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Bene, torniamo al punto principale. Cosa ci fate voi due qui? Se Paimon si ricorda ancora bene, era qui che si prendevano le Gelatine floreali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "Ah, i nostri due grandi eroi! Bastano le vostre voci a gonfiare la mia autostima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Bene, allora procederò a fare rapporto sui risultati del nostro lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "In precedenza foste voi due a dichiarare che il Torneo Coppa Nilotpala dei Domatori di bestie doveva essere sospeso per un periodo di tempo, necessario affinché l'Akademiya migliorasse le fattezze del Globo della saggezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Credo che voi due stiate ancora aspettando un avviso a riguardo, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Sì, proprio così! Layla, Cyno, o i ricercatori di dovere dovrebbero informarci di qualsiasi progresso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Anche se non penso capirai tanto del loro linguaggio tecnico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Beh, ma le cose stanno così. Non aiuteremmo tantissimo, anzi saremmo probabilmente d'intralcio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Ah, quanta premura e che indulgenza. Io praticamente mi accendo d'entusiasmo, quando ripenso alle scene del torneo precedente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Quindi ho provato a chiedere i dettagli ad alcuni membri del personale dell'Akademiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Al momento, le migliorie al Globo della saggezza esistono ancora solo su carta. In altre parole, qualsiasi messa in pratica necessiterà di altro tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Tuttavia, le discussioni una volta molto accese sulla prima edizione del torneo vanno affievolendosi giorno dopo giorno, e fra poco non se ne ricorderà più nessuno. Non possiamo permettere all'impatto dell'evento precedente di essere sprecato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Intanto ho fatto comunella con la signorina Haniyyah per organizzare un \"evento a tema\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "Cosa significa esattamente \"evento a tema\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "E quindi è per questo che sul tavolo ci sono questi pezzi di gioco a forma di Miconoide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Il signor Balfour è alla ricerca di sponsor per organizzare il prossimo torneo, e ha perfino cercato di imparare delle abilità di marketing da Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Mentre era alle prese con questo, ha scoperto un nuovo gioco chiamato Teatro meccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "In seguito, ha comprato i diritti del franchising per il gioco a Sumeru, e ha assemblato un nuovo gioco, tenendo me come consulente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Qui lo chiamiamo \"Teatro Micomeccanico\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Teatro Micomeccanico, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Adesso Paimon tira a indovinare... Prenderemo il comando di vari Miconoidi per fare a gara con delle macchine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Ahah! Che intelligenza, Partner d'argento. Hai indovinato all'istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Credo che questo gioco sia facile da capire e promuovere, e ha un gran potenziale che vale la pena esplorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Se riusciamo a promuoverlo con successo come spin-off del torneo Domatori di bestie, possiamo permettergli di rimanere impresso in testa alla gente a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "In questo modo, nel prossimo torneo che organizziamo potremmo attrarre un pubblico maggiore, e molti più partecipanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Ovviamente, questo può accadere solo con il tuo permesso. Dopotutto sei tu ad avere l'ultima parola sull'organizzazione del torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Penso valga la pena provare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Mmh, beh, né {NICKNAME} né Paimon capiscono tanto di affari, ma Paimon crede che tu abbia ragione, Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Tu e Haniyyah ci avete lavorato insieme, e Paimon crede in voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Non abbiamo ancora provato il gioco, ma Paimon scommette che piacerà a tante persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Favoloso! Visto che siete d'accordo, posso promuovere il Teatro Micomeccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Il gioco è ancora nelle fasi di test, dobbiamo ancora invitare persone per provarlo e raccogliere i loro feedback, in modo da apportare altri miglioramenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Voi che avete sicuramente incontrato miriadi di giochi popolari a Teyvat, avrete i migliori suggerimenti in assoluto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Ci sto, {NICKNAME}! Questo è uno dei tuoi punti forti, d'altronde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Ho la sensazione che tu stia per ordinarmi di...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Eheh! Ma prima, Paimon ha una domanda per te, Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Riguarda Tamburino e gli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Proprio così! A Paimon mancano i nostri Micoamici. Come stanno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Non preoccuparti, stanno benone, e vivono in piena libertà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Ghirigori e Tifone attualmente vivono nella mia <color=#00E1FFFF>residenza temporanea nell'area nord di Porto Ormos</color>. Uno dei partecipanti precedenti si sta prendendo cura di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Tamburino e Fuocallegro sono qui vicino. Se vuoi, Partner d'argento, puoi andare a giocare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Qui vicino hai detto?? {NICKNAME}, più tardi, mentre giochi, Paimon va a cercare Tamburino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Vai, vai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Va bene allora. Forza, Cometa d'oro, la versione di prova del Teatro Micomeccanico è pronta per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Ti raggiungo a breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Bene! La Cometa d'oro sta per colpire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Ci hai lavorato duramente, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "E nemmeno io avrei dei suggerimenti da avanzare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "E voi chi sareste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#Oh, dai, {NICKNAME}, non è divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Abbiamo partecipato al Torneo Coppa Nilotpala dei Domatori di bestie, vero? È stato molto divertente trascorrere del tempo con i nostri Micoamici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Fu lì che incontrammo Haniyyah, e Balfour era il membro dello staff più diligente di tutti durante lo scorso evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Un momento, hai dimenticato di Tamburino e Ghirigori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Ooh, mi ricordo ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Cosa? Ma dai! Paimon stava quasi per chiamare un dottore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
					"content": "Eh, vi stavo solo prendendo in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
