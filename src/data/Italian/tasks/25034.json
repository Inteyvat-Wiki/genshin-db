			"dialogs": [
				{
					"id": 250340501,
					"content": "#Grazie per averci salvati, {F#sorellona}{M#fratellone}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "Huooo, ruooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "#Questo posto era troppo distante dalla tribù... Non sarei mai riuscito ad allertare Illapa prima che Qica venisse rapito, per fortuna che sei {F#arrivata}{M#arrivato} tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "A ogni modo, cosa ci fate qui voi due?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Ci stiamo esercitando ad arrampicarci, come sempre... Ma a un certo punto ci è venuta fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "Quindi ci siamo messi a cercare del cibo, ma ci siamo allontanati troppo senza rendercene conto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "Ci siamo riempiti per bene la pancia ma, a quel punto, eravamo molto, molto distanti. Quando rientreremo, di sicuro la mamma mi sgriderà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "Grazie ancora per averci salvati. Prendi questi cacahuatl, li ho appena raccolti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "Torneremo il prima possibile. Vieni, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "Roar! Roarrr! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				}
			]
		}
