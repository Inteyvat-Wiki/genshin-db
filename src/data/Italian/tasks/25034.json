			"dialogs": [
				{
					"id": 250340101,
					"content": "Non gli piacete, quindi smammate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Mezzacartuccia... Cosa c'è tra te e il Saurico? Lo conosci o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340103,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Oh, guardate, sta perdendo la pazienza. D'accordo allora, piccola peste, fatti da parte. Non picchiamo i bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340105,
					"content": "Portate la borsa, ragazzi. Scommetto che questo Saurico ci farà guadagnare un bel gruzzolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340106,
					"content": "Non avvicinatevi! E non datemi la colpa se finite per farvi male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "A-Aspetta, quindi vorresti picchiarci? Ahahahah! Avete sentito, ragazzi? Vuole combattere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340108,
					"content": "Oh no, sto tremando per la paura. Ma come hai appena detto tu... Non darmi la colpa se finisci per farti male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340109,
					"content": "Roar! Roarrr! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Tsk... Questo Saurico è davvero rumoroso. D'accordo, mezza calzetta, è ora di fare un sonnellino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340111,
					"content": "Siete voi ad avere bisogno di un sonnellino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{F#Sorellona}{M#Fratellone}! Stanno cercando di rapire Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "Ehi, tu. Che ne dici di farti da parte? Non ti faremo del male. Ti daremo una parte del bottino. Siamo d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340116,
					"content": "Non fare del male a Qica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Oh, allora non c'è possibilità di scelta. Beh, di sicuro conosci le regole. Diamoci dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340119,
					"content": "Andiamo, ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladro impaziente"
				},
				{
					"id": 250340117,
					"content": "Chi ti credi di essere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Spero che non vi dispiaccia se mi intrometto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
