					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Perfetto. Tra poco andrò a prendere il bambù. Provvederò a consegnare gli ornamenti direttamente al Padiglione Yuehai, non appena saranno pronti.",
					"roleType": "TALK_ROLE_NPC",
