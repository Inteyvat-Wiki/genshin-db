			"dialogs": [
				{
					"id": 718130401,
					"content": "Or bene... Come principiava \"Distesa di gemme\"? Ah, sì... \"Il commercio e gli affari, così come i fiumi e le sorgenti, nascono su tra le montagne per poi giungere fino ai mari...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "\"Questo gran disegno traccia la rotta che, un passo alla volta, ci condurrà alla lunga vita di Liyue e alla prosperità della sua gente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "#Oh, bentornat{F#a}{M#o}. Ancora un momento, sto scrivendo le ultime righe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Mmmh... Ecco fatto, finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Ecco il tuo consommé ai tre sapori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Ah! Quello può aspettare. Prima verifichi che il libro la soddisfi. Confido che apprezzerà non poco la mia arte dello scrivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "Un lavoro davvero notevole...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "#Ahahah, lei mi lusinga troppo, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}. Questo libro è suo. Non lo perda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maestro Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Oh... Ti serve qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130602,
					"content": "Vorrei ordinare dei piccoli ornamenti fatti di bambù.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Degli ornamenti fatti di bambù? Certo, si può fare, ma potrei sapere da chi proviene quest'ordine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130604,
					"content": "Viene da Baiwen. Ho una lista con delle cose da procurarle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Ohoh... Un ordine dal Padiglione Yuehai, vero? Molto bene, allora, immagino che debba occuparmene il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130606,
					"content": "C'è solo un piccolo problema: la foresta di bambù dove vado spesso a prendere i materiali è stata occupata all'improvviso da un gran numero di cinghiali. Non ho idea del perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130607,
					"content": "Sebbene non sia un grosso problema, mi ritrovo spesso a doverli evitare per raccogliere il bambù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130608,
					"content": "Se tu potessi mandare via quei cinghiali, potrei andare adesso e cominciare immediatamente il lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Maestro Lu"
				},
				{
					"id": 718130609,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Ti aspetterò qui. Torna ad avvisarmi non appena avrai mandato via i cinghiali.",
					"roleType": "TALK_ROLE_NPC",
