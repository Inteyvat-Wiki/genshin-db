						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "Riguardo a quei preparativi di cui ti stai occupando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Ma è... \"Distesa di gemme\"? Come hai fatto a procurarti questo libro? L'ho cercato in tutta Liyue e non ne ho trovata neanche una copia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Qingzhou ne ha trascritta una per me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Parli del poeta? Mmmh, pare che la sua fama sia più che meritata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Ti ringrazio per avermi dato una mano a recuperare questi oggetti. Non appena riceverò gli ornamenti dal maestro Lu, farò in modo che anche lui sia pagato adeguatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Quindi state ricostruendo la Dimora di giada, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Esatto, l'intenzione è proprio questa. Tuttavia, le cose da preparare sono talmente tante che abbiamo già un sacco di lavoro da fare. Non credo proprio che finiremo in poco tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Per non parlare poi del problema più grosso, che non abbiamo ancora risolto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Non preoccuparti, non ho intenzione di coinvolgerti. Grazie ancora dell'aiuto. Ecco, accetta questi come segno di riconoscimento. Perdonami, ma ora devo tornare ai miei impegni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
