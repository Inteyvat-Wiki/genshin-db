			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Ciao, c'è qualcosa che vorresti acquistare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Vorrei una copia di \"Distesa di gemme\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "\"Distesa di gemme\"? Purtroppo al momento non è disponibile. Ti serve in tempi brevi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Beh, stanno ricostruendo la Dimora di giada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Ah, davvero? Allora sì, è necessario prepararsi adeguatamente. Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Potresti rivolgerti a Qingzhou. È una persona molto colta. Forse può indicarti dove trovare una copia di \"Distesa di gemme\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Se ricordo bene, Qingzhou si alloggia spesso alla Locanda Wangshu. Prova a cercarlo là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Un dilemma. Alquanto seccante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Salve, ehm... Hai mai sentito parlare di un libro intitolato \"Distesa di gemme\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "#\"Distesa di gemme\", mi{F#a}{M#o} buon{F#a}{M#o} signor{F#a}{M#e}? Sì, ricordo quel libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Una volta mi ritrovai dinanzi a quel titolo, mentre vagavo alla ricerca di fonti per scrivere un poema sui mercanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Non ho padronanza dei contenuti del testo, ma alcuni aneddoti in esso citati si rivelarono una grande fonte di ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Vediamo se riesco a rammentare il titolo di quel poema. La prego, mi conceda un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Ricordi dove posso trovare quel libro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Ah, quindi vorrebbe acquisirne una copia? Devo ammettere che non mi viene in mente alcun posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "#Tuttavia, se ne ha urgentemente bisogno, potrei trascrivere una copia per lei, mi{F#a}{M#o} buon{F#a}{M#o} signor{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Trascrivere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Ah, non era certo un testo voluminoso. Memorizzarlo non fu certo un'impresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Comunque, per essere precisi, il collezionista che lo possedeva non fu disposto a prestarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Poiché la poesia non è certo un'arte che si esercita con la fretta, decisi semplicemente di trascriverne a memoria una copia per continuarne la lettura. Non era neppure un testo troppo lungo, quindi l'ho memorizzato pressoché nella sua interezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Notevole, dico davvero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "#Ah! Una quisquilia, una pinzillacchera, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}. A ogni buon conto, lei potrebbe farmi un favore in cambio della mia trascrizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Per quanto imbarazzante possa essere... oggi sono rimasto talmente rapito dalla mia ricerca d'ispirazione che solo adesso realizzo di aver dimenticato di mangiare. Improvvisamente, i morsi della fame mi attanagliano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Potrebbe procurarmi una porzione di consommé ai tre sapori? In cambio, trascriverò per lei una copia della \"Distesa di gemme\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Confido che, al suo ritorno, avrò praticamente finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "A memoria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
