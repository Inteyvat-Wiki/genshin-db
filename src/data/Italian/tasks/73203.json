			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Se non fosse stato per voi, non credo che avrei mai potuto vedere sbocciare delle rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "Se solo avessi saputo cosa sarebbe successo... invece dei semi, avrei portato qualche libro in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "Non sei di queste parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Ti sorprende? Beh, vorrà dire che mi sono ambientata molto bene, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "Quando sono arrivata qui, non mi ero ancora abituata a nulla... Né al cibo, né all'alloggio, né ad altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "Ma mi ci sono abituata con il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "Ciò però non significa che io abbia pienamente accettato l'ambiente attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "Immagino sia impossibile far sbocciare qui delle rose della Città di Sumeru, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Sei una ricercatrice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Una volta avrei potuto definirmi tale, ma ora non più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "Ho detto qualcosa che va oltre la mia posizione e ho scoperto qualcosa che non avrei dovuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "Ho infranto i tabù dell'Akademiya e sono stata allontanata dai loro ranghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "Cos'hai detto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "La curiosità è l'impulso a cercare la saggezza, ma anche la causa del peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "L'ho capito solo dopo essere stata esiliata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "Per ragioni di sicurezza, non penso che dovrei scendere nei dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Ehm, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "Pensavo che gli avventurieri andassero e venissero, e che non tornassero mai a chiacchierare dopo aver finito il loro lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "Non mi sarei aspettato di avere un'altra lunga conversazione con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "In realtà, non ho molti amici con cui parlare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Pensi che... prima o poi... riuscirai a venire a fertilizzare di nuovo le mie piante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "...D'accordo allora, vi aspetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Perché far crescere delle rose di Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Probabilmente non sapete molte cose su di loro... ma sono davvero versatili e hanno diversi utilizzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "Si possono mangiare, usare come medicinali o regali, e se le vendi fruttano un bel gruzzoletto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "E questi sono solo alcuni degli usi più comuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "Il fiore, le foglie e il gambo di una rosa di Sumeru non hanno avuto sempre questo aspetto. Un tempo avevano un aspetto diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "Credo che i cambiamenti geografici abbiano portato a cambiamenti nei tratti delle rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "Uno studio sulle sue caratteristiche potrebbe aiutarci a ricavare informazioni geografiche e storiche del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "Non sarei in grado di spiegare il meccanismo con una semplice chiacchierata, e condividere tali informazioni con degli avventurieri è probabilmente contro le regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "Se vi interessa l'evoluzione botanica, dovreste visitare l'Akademiya. Avranno ulteriori informazioni sull'argomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "Quindi... stai facendo tutto questo per la tua ricerca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Non sono più una ricercatrice, quindi non ho più il diritto o i mezzi per perseguire qualsiasi ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "#Se dovete proprio avere una motivazione... *sospira* Siete davvero curios{F#e}{M#i}, sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "Coltivavo molte rose di Sumeru nella mia vecchia casa. I fiori erano spettacolari e li vedevo ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "Se fosse possibile, vorrei vederli quotidianamente come facevo prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "...Ecco tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "Ti capisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
