						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Eccovi qua. Che puntualità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "Ho preparato del pollo al burro. Se volete, sarei felice di avervi con me a cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Pollo al burro? Come potremmo rifiutare?!? Paimon ne vuole un bel piattone, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Paimon, ti sei dimenticata le buone maniere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Okay, Paimon chiede scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "Va tutto bene, non devi chiedere scusa. È del tutto naturale amare il cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "Ne riscalderò un po' in modo che possiate portarlo con voi. È il minimo che possa fare per ringraziarvi per il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "Sei così gentile, Sabbah! Paimon è sicura che le tue rose cresceranno e fioriranno proprio come desideri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Beh, ho mantenuto il terreno umido, quindi i germogli stanno crescendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "La mia unica preoccupazione è che stiano crescendo piuttosto lentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Di solito, se un seme è sano, dovrebbe crescere abbastanza velocemente, ma finora non stanno germogliando come dovrebbero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "Non so se sia perché il terreno non è abbastanza fertile. Se la situazione dovesse continuare così, forse sarà il caso di aggiungere altro fertilizzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Aggiungiamo altro fertilizzante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Allora, potreste farmi questo favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "Ci pensiamo noi! Sarà un gioco da ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Possiamo provare a utilizzare di nuovo il potere di Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Chiedo scusa, Paimon si è lasciata prendere dall'emozione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Grazie di nuovo. Il mio cuore si rallegra alla vista delle rose di Sumeru che crescono qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "Mentre parli con Sabbah, iniziano a spuntare delle foglie...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Le foglie si aprono, rivelando dei boccioli di fiori.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "I boccioli si schiudono lentamente e diventano rose di Sumeru.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Sabbah ne raccoglie una e la porge a te e a Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Non avresti dovuto... Hai già così poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "Non c'è problema. D'altronde, tutto questo non sarebbe stato possibile senza il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "Abbiamo solo dato una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Un roseto ha un fascino unico, ma anche una singola rosa vanta una bellezza tutta sua. Le rose mi hanno sempre interessata, fin da quando ero una ricercatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "Cosa? Eri una ricercatrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Giusto, non ve l'ho ancora detto... Non sono nata al Villaggio di Aaru. Mi sono \"trasferita\" qui dall'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "Vedi? Paimon non ti aveva forse detto che Sabbah possiede la stessa eloquenza di un ricercatore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Hai piantato queste rose perché volevi continuare a studiarle, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "Non direi. Anzi, a dire il vero, non credo che i ricercatori debbano coltivare i propri interessi unicamente ai fini della ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "L'ho fatto perché amo il mondo in cui vivo e desidero comprendere il ciclo vitale delle piante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "Tempo fa ho studiato l'impatto dei cambi geografici sull'evoluzione delle rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Rifletteteci: se le condizioni ambientali di Sumeru fossero totalmente diverse, come si sarebbero adattate le rose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Si sarebbero arrampicate sui muri come l'edera? Se così fosse, l'Akademiya sarebbe ricoperta di rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Avrebbero formato dei grappoli come un vero e proprio bouquet? Sarebbe stato davvero incantevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Forse potrebbero aver anche sviluppato uno spettro di colori... Bianco, rosso, oro... Una nuova specie a tutti gli effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Naturalmente, poche persone al giorno d'oggi scoprono nuove varietà, e ancor meno ne sviluppano di nuove come facevano i migliori ricercatori di un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "Ciò che voglio dire è che ogni rosa ha un grande potenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Trovo molto interessante esplorare ogni possibilità. A quei tempi, ero felice di raccoglierne dei campioni ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Ripensandoci adesso, sono stati tempi semplici e felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "A ogni modo, accettate questa rosa. È un piacere per me condividere la mia felicità con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "Se vi doveste sentire nuovamente a disagio, venite a trovarmi più spesso e portate con voi delle rose di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "Quando parlo con voi, mi sento a mio agio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "Qualsiasi cosa io dicessi non mi avete mai interrota e mi prendete sul serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "Vi darò anche dei piccoli regali, credo che vi piaceranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "Torneremo presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Lo spero davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
