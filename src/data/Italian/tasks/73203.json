					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "#Non sembra che tu abbia una Visione, eppure riesci a controllare il potere di Dendro. Non sei {F#un'avventuriera}{M#un avventuriere} qualunque, suppongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "A quanto pare, esistono persone in grado di controllare gli elementi senza una Visione, ma di solito queste hanno una pessima reputazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "#Tu, invece, hai un cuore d'oro. Stai lontan{F#a}{M#o} dalla cattiva strada, mi raccomando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}