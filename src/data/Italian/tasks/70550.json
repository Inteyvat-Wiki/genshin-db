						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Ecco il tuo Baldoria del bel tempo. Su, assaggialo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Wow, quindi è questo il colore di un Baldoria del bel tempo? Il cielo viola... simboleggia una notte luminosa e splendente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Forse dovrebbe rappresentare un cielo limpido al tramonto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Klee ne berrà prima un sorso... Poi potrai pensarci con più calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Ahhh, finito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Buonissimo! È dolce e aspro allo stesso tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Se Klee l'avesse bevuto mentre mangiava del pesce alla griglia, ne avrei potuti trangugiare due, tre, quattro o persino... cinque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "Ma un bicchiere non basta. Klee vuole provare... una bevanda che sappia di torta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Ricevuto. Che ne dici di un \"Sorso di torta\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Mm... Klee non sa quale scegliere. Perché non decidiamo insieme, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "Le caramelle che hai portato con te sembrano davvero speciali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Queste? Eheh... La mamma mi ha insegnato a prepararle usando il banco alchemico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Un pizzico di zucchero... Poi ancora zucchero, dei fiori dall'amica di Fontaine della mamma, del miele stellare di zia Barbie, e infine della marmellata magica di zia Tavia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Metti tutto insieme sul banco alchemico, esprimi un desiderio per la forma che vuoi, poi recita la formula magica della mamma e... puff! Caramelle a forma di Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "È un procedimento piuttosto elaborato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "Klee può dare anche a te delle caramelle Dodoco, se vuoi! E, se ti piacciono davvero tanto, posso anche insegnarti la formula magica della mamma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "Così potrai fartele ogni volta che vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Grazie per aver condiviso la tua fantastica ricetta, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Eheh, se non capisci qualcosa, ricordati di venire da Klee! Quando si tratta di caramelle magiche, sono un'esperta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Hai altri programmi per oggi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Sì! La mamma mi ha regalato un libro fantastico. Ha detto che devo leggerne un capitolo ogni sera, imparare qualcosa di utile e poi andare a letto presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "Quel libro ha insegnato a Klee come fare una cosa chiamata \"carica esplosiva\". Adesso il Coniglio Bumbum potrà fare \"BOING!\" e rimbalzare ancora più in alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "M-Ma è davvero qualcosa che dovresti imparare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Non è affatto difficile... In realtà, è molto simile a realizzare delle bombe. Basta solo fare attenzione quando le si modella... È come temperare una matita che potrebbe fare BOOM all'improvviso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "Anche il momento della buonanotte è una parte importante della giornata! La mamma si siede accanto a me e mi racconta un sacco di storie meravigliose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Ha una lampada fatta di pietre preziose e, quando l'accende, fa \"cling\" e illumina tutto il soffitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Il soffitto mostra le scene delle storie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Sì! Quando succede qualcosa nella storia, le luci sul soffitto creano delle belle immagini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "A volte la mamma si addormenta prima che la storia finisca, quindi tocca a me rimboccarle le coperte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#Non appena Klee imparerà a usare la lampada, potrò venire a raccontarti delle storie, prode {F#Cavaliere Onoraria}{M#Cavaliere Onorario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "Sembra fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Eheh, Klee ha memorizzato tantissime storie meravigliose, abbastanza da rendere tutti felici ogni giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Hai intenzione di mangiare qualcos'altro, oggi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Sì! Quando Klee tornerà a casa, mangerò delle noccioline salate leggendo il mio libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Prima Klee aveva l'abitudine di mangiare una torta dopo cena, ma la maestra Jean ha detto che è troppo zuccherata, e non fa bene mangiare cose dolci prima di dormire! A quanto pare, ti fanno ingrassare e venire il mal di denti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "Così la mamma ha chiesto consiglio a zia Barbie, e adesso mi dà le noccioline al posto della torta. Dice che aiutano il cervello a ricordare meglio le cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Le noci non hanno molto sapore... È come masticare dell'erba... Ma non sono male se ci aggiungi un po' di sale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "Sembra un'ottima soluzione: nutriente e salutare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Ci devono essere degli ingredienti che siano sia sani che dolci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Oh, sì... Klee vuole ancora mangiare cose dolci, come una torta, per esempio... Magari potremmo metterci meno panna... O aggiungerci più frutta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Ah, giusto! Quell'amica della mamma che porta sempre gli occhiali le ha dato un sacco di Bulle di Fontaine; sono così tondi e rotolosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Klee ne ha mangiati un sacco, erano dolcissimi... Ma la maestra Jean ha detto che andava bene perché... \"La frutta dolce non è come lo zucchero!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Quindi, se Klee deve proprio mangiare le noci, forse posso prima metterle a bagno nel succo di frutta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "A proposito di cibo, tu consumi sempre i tuoi tre pasti completi ogni giorno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Tre? Eheheh, spesso Klee ne consuma cinque... A volte anche sette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Sul serio?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Le avventure richiedono molta energia e, se mangio troppo tutto insieme, non riesco a correre bene... Quindi è meglio fare tanti piccoli pasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Prima era Albedo a preparare tutti i miei pasti, e il mio cestino del pranzo era sempre disposto così ordinatamente, proprio come un bel dipinto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Sì, è proprio da Albedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Quando Albedo è impegnato al Picco del Drago, Klee va a mangiare con gli altri Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "L'accampamento di Kaeya è sempre il più ordinato, mentre Amber a volte si accampa sugli alberi. È così divertente! Ah, e zia Hertha prepara dell'ottimo cibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "Quando la mia mamma tornerà, ci sarà del cibo ancora più buono da mangiare. C'è un piatto per cui prende un sacco di pesci diversi e li trasforma in cubetti di budino. Si chiama Gelatina di pesce arcobaleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Mi stai facendo venire fame...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "Anche le sue Fette Croccocioccolatose sono fantastiche! È la sua ultima creazione, preparata con cioccolato e biscotti! Sono un po' amare, ma sono croccanti, hanno un profumo delizioso e un retrogusto davvero dolce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Ogni volta che le mangio, mi sento pieeena d'energia... La prossima volta, te ne porterò un po' da assaggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Bene, credo di sapere come migliorare quella bevanda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Lascia che te ne prepari un'altra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Sì! Che velocità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Klee non vede l'ora di assaggiare la tua prossima creazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Una grande avventuriera, nonché un'ottima cuoca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Un giorno mi piacerebbe provare la cucina di Albedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "Non vedo l'ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "È-È davvero così facile da fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "M'impegnerò tantissimo per imparare a farle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Che delizia incredibile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Perfetto, preparati per un'altra bevanda super deliziosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Ti preparerò qualsiasi gusto tu voglia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "Non è il colore più adatto... Che ne dici se apporto qualche modifica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
