						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500301,
					"content": "#Tadà! È pronta. Sono {F#sicura}{M#sicuro} che adorerai questa nuova creazione!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Wow! In cima c'è una caramella Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "In questo bicchiere c'è così tanto arancione, e Dodoco sembra sdraiato su morbide nuvole bianche... E il clima al suo interno sembra decisamente migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "Ti va di assaggiarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Mmm... È così deliziosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Klee deve berla piano piano... Non posso mandar giù tutto d'un fiato, altrimenti mi perdo tutto il gusto buono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#Prode {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, è fantastica... È come se avessi mescolato il sole con il succo di frutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "Ero così stanca dopo aver giocato, ma ora mi sento rinvigorita... Al calduccio... E in pace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#*sbadiglia* Sei {F#la}{M#il} migliore, prode {F#Cavaliere Onoraria}{M#Cavaliere Onorario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "Che ne dici di scegliere tu un nome per questa bevanda, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Davvero? Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Mmm... Quando c'è il sole e Dodoco è felice, Dodoco vorrà cantare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "E quando Dodoco canta, anche Klee vuole cantare... Quindi... Chiamiamola... Duetto di Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "Che nome meraviglioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "Eheh, grazie. E grazie per aver preparato a Klee una bevanda così buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500318,
					"content": "Klee andrà a dire alla mamma che la bevanda più buona di Mondstadt in questo momento è il Duetto di Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500319,
					"content": "Sono felice che ti piaccia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#Eheheh! Scriverò l'incantesimo della mamma e te ne darò una copia, prode {F#Cavaliere Onoraria}{M#Cavaliere Onorario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500322,
					"content": "Quindi dovrai imparare anche tu la magia, così potrai creare tutte le caramelle che vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500323,
					"content": "Alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500320,
					"content": "Ho superato il tuo test, signorina Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "I tuoi nomi sono sempre i migliori!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "Ti verrà sicuramente in mente qualcosa di fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
	]
