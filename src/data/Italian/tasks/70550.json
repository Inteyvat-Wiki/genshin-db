			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Eh? {F#La}{M#Il} prode {F#Cavaliere Onoraria}{M#Cavaliere Onorario}?! Evviva, sei proprio tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "Ehi, c'è Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Ahah, zia Eula ha detto a Klee che Hertha aveva trovato qualcuno di fantastico per dare una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "#Vedendoti qui, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, ora Klee sa che questo è il miglior chiosco di bevande di tutta Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "Troppo gentile, Klee... Quello è l'obiettivo finale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "C-Come sarebbe? Questo chiosco NON è già il migliore di tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Beh... Di tutti i chioschi di bevande che Klee ha visitato, quello {F#della}{M#del} prode Cavaliere {F#Onoraria}{M#Onorario} è sicuramente il migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "#Inoltre... Qualunque bevanda prepari {F#la}{M#il} prode Cavaliere {F#Onoraria}{M#Onorario}, Klee penserà sicuramente che sia buonissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "Questa volta, cara Klee, ho bisogno che tu sia un po' più severa con me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Oh! V-Vuoi che sia cattiva? M-Ma... Klee non potrebbe mai esserlo con te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Mm, fammi pensare... Trovato! Farò finta di essere Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Ogni volta che esamina il lavoro di Timaeus, Albedo assume un'espressione super seria, e riesco a sentire ogni parola che dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Fantastico, allora potrai farmi da maestra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Ehehe... Preparati per l'ordine super fantastico di Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "Presto andrò a fare un po' di pesca esplosiva con la mamma... Ma non dirlo alla maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Oggi io e la mamma abbiamo fatto saltare in aria tanti pesci... Però non dirlo alla maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "In questi ultimi giorni mi sono divertita un sacco a giocare con la mamma! È stato così divertente! Neanche finire in cella d'isolamento mi ha tolto il sorriso dalla faccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Allora... Klee vorrebbe ordinare un Baldoria del bel tempo. Qualsiasi cosa che ricordi una bella giornata di sole la metterà sicuramente di ottimo umore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Capito, signorina Klee, arriva subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Eheheh, chissà che sapore avrà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Ricevuto, maestra alchimista Klee, me ne occupo subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Fantastico, allora sarai la maestra alchimista Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Stavolta potrai criticarmi quanto vuoi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "#Sei molto gentile a dirlo, Klee. Mi sto impegnando al massimo per diventare {F#la}{M#il} migliore!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Ehi, la mia nuova cliente Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
