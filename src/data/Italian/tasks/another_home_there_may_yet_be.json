			"dialogs": [
				{
					"id": 130280113,
					"content": "Sono rimasti qui ad aspettare molto molto a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280101,
					"content": "Voglio proprio fare qualcosa per loro, affinché abbiano un'occasione di rincontrarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280102,
					"content": "Sì, e a parte questi due Miconoidi, Paimon è anche un po' preoccupata per l'accampamento dei Miconoidi fluttuanti di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Mmh, anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "Ho un'idea: perché non li portiamo qui a vivere assieme agli altri Miconoidi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "Entrambe le parti hanno vissuto in presenza di una forma di vita elementale, quindi le loro abitudini dovrebbero essere simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Sì, affinché possano prendersi cura gli uni degli altri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280107,
					"content": "Vi andrebbe di venire con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280108,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "Miconoide fluttuante di Hydro"
				},
				{
					"id": 130280109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "Miconoide fluttuante di Hydro"
				},
				{
					"id": 130280110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "Miconoide fluttuante di Hydro"
				},
				{
					"id": 130280111,
					"content": "Sembra che si sia convinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280112,
					"content": "Va bene, andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
