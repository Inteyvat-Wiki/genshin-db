			"dialogs": [
				{
					"id": 130280201,
					"content": "Dopo essere arrivati all'accampamento, i due Miconoidi ricevono un caloroso benvenuto.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "Ooh, sembra che i Miconoidi qui ci riconoscano. Sono molto amichevoli e gentili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Quella forma di vita elementale dev'essere stata tenuta in grande considerazione da chiunque abbia vissuto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "Uh? Volete giocare insieme a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩~♩~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Miconoide fluttuante di Anemo"
				},
				{
					"id": 130280206,
					"content": "#Beh, va bene! {NICKNAME}, se cerchi Paimon, sarà laggiù a giocare con i Miconoidi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "Via, sciò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Ti devo una scusa. Quando il Seme di fuoco si è frantumato mentre eravamo all'interno di Apep... Avevo in programma di sacrificare il mio potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "Paimon te l'ha detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "#Sì, ed ero un po' preoccupat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Non ero abbastanza calma. Avrei dovuto pensarci un po' di più, al fine di valutare la situazione in maniera più corretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Quando mi sono accorta che il Drago di Dendro era in pericolo e che la sicurezza di Sumeru era in minaccia, non potevo che sentirmi angosciata e spaventata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Se avessi deciso di non passare all'azione mentre ero ancora in tempo, o se il tempo fosse esaurito prima che riuscissi a usare tutta la mia energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "L'uso dei miei poteri potrebbe essere la via d'uscita più facile, ma è anche la più difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Hai ancora spazio per \"crescere\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Sì, e penso di aver imparato molto da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Capisco cosa significhi vedere i propri desideri avverarsi, ma ancora non riesco ad accettarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "Perché mai la sua voce sembrava così pacifica e soddisfatta, mentre faceva qualcosa che... ti fa venire da piangere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "Sembra che non abbia ancora compreso il concetto di \"empatia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "Non è colpa tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Grazie per le tue parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "I sentimenti sono una cosa complessa, e ho ancora molto da imparare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Miconoide fluttuante di Hydro"
				},
				{
					"id": 130280228,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Miconoide fluttuante di Hydro"
				},
				{
					"id": 130280229,
					"content": "Si prendono perfino cura dei raccolti... Che stiano imitando i comportamenti umani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Ma dato che quel Miconoide ha perfino imparato a parlare, tutto questo potrebbe essere a causa degli effetti a lungo termine del potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "Il tempo è una cosa potente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Proprio così. E ora, non dobbiamo preoccuparci della sicurezza di questi due Miconoidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "D'ora in avanti, terrò lo sguardo su questo accampamento di Miconoidi e verrò a dare un'occhiata a loro ogni tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Voglio conservare le tracce che hanno lasciato dietro al fine di creare un'opportunità di incontro nel futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "Dopotutto, quel Miconoide ricordava il nome \"Nur\". I suoi ricordi sono tornati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Credo nel loro legame in quanto famiglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Mm. Allora consideriamolo un bellissimo desiderio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "Nahida, i Miconoidi hanno portato della frutta! Vieni a prenderne un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "Va bene, arrivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Credo nei miracoli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Mi sento allo stesso modo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "#Sì, ed ero un po' arrabbiat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "Divertitevi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
}