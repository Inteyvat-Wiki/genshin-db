			"dialogs": [
				{
					"id": 750530101,
					"content": "#Ehi, {F#forestiera}{M#forestiero}. Hai una buona vista... Ti andrebbe di metterla alla prova con \"Occhio alla piuma\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530102
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530102,
					"content": "Affina la vista e ricevi una ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530103
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530103,
					"content": "Beh, è una spiegazione molto concisa. Forse troppo. Sembra quasi che tu non abbia detto niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530104,
					"content": "Le regole più dettagliate le rimandiamo a dopo, se volete provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530105
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530105,
					"content": "Sentiamo un po' queste regole, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530106
					]
				},
				{
					"id": 750530106,
					"content": "Tre Qucusauri voleranno via. Tieni lo sguardo su quello centrale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530107
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530107,
					"content": "Quando torneranno indietro,<color=#00E1FFFF> riconosci... quello che in origine era nel mezzo</color>. Tutto qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530108
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530108,
					"content": "Ehm, quindi si scambiano di posto a mezz'aria e dobbiamo capire chi era originariamente al centro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530109,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530110
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530110,
					"content": "Uh... Ecco perché lo chiami \"addestramento per la vista\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750530111,
					"content": "Iniziamo da qualcosa di semplice per saggiare il terreno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530112
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530112,
					"content": "E se non ci sono problemi, poi giochiamo sul serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530113
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530113,
					"content": "Le ricompense saranno tue se avrai successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530114,
						750530116
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530114,
					"content": "Ho altro da fare, tornerò più tardi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530115
					]
				},
				{
					"id": 750530115,
					"content": "Va bene. Io sarò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530116,
					"content": "D'accordo, farò un tentativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530117
					]
				},
				{
					"id": 750530117,
					"content": "#Quando sei {F#pronta}{M#pronto}, colpisci il bersaglio e inizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		},
