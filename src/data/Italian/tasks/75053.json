			"dialogs": [
				{
					"id": 750530301,
					"content": "Le ricompense sono finite. Niente ricompense, niente sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530302,
					"content": "Altre domande?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530303,
					"content": "Puoi dirmi di più su Occhio alla piuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "È una sfida tramandata da tempi antichi nella tribù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530305,
					"content": "Un occhio attento è essenziale per noi del Clan Piumafiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530306,
					"content": "In questa generazione, sono io il capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530307,
					"content": "C'è un motivo per cui parli così lentamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "Infortunio precedente. Sono caduto da un luogo molto alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530309,
					"content": "Gola e petto... Non posso parlare come prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530310,
					"content": "Ma non credo sia... così terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530311,
					"content": "Non preoccuparti, non ho domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "Ti auguro il meglio. Alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		}
