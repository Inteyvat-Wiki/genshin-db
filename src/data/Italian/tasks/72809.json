			"dialogs": [
				{
					"id": 728090108,
					"content": "Beh, finalmente la roba è arrivata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090109,
					"content": "Ce ne hanno messo di tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090110,
					"content": "Argh, e questa cassa è pure rotta su un lato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090111,
					"content": "Non è possibile! Gli avevo detto di fare attenzione. Speriamo che dentro non si sia rotto nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090112,
					"content": "Fiuuu, le bottiglie sembrano tutte intere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090113,
					"content": "Eh? Perché questo tappo è lento? Bisogna svitarlo per poterlo chiudere bene, cavolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090114,
					"content": "*tossisce* E questi ingredienti per bevande alcoliche sono troppo forti, togliamoli prima di tutto il resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090115,
					"content": "Eh?! Cosa ci fanno tutti questi Melmosi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "#Grazie davvero per il tuo aiuto, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "Se non fosse stato per te, questo posto sarebbe diventato la mia tomba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "Hai preparato tu quest'accampamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Uhm, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Voglio dire, sai quanto sia difficile fare affari qui a Ritou. Quest'accampamento è... beh, un mio trucchetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Qualche giorno fa, ho incaricato un... amico di inviarmi da Mondstadt degli ingredienti per preparare bevande alcoliche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Si è poi procurato un lotto di prova di un nuovo prodotto al Vigneto Prima Luce, che mi ha così mandato qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Ma non è stato per niente attento, quindi alcune casse si sono rotte e il tappo di una bottiglia di ingredienti per alcol era lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "Ho deciso di svitarlo così da poterlo chiudere bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "Ma non mi sarei mai aspettato che dopo aver svitato il tappo sarebbero saltati fuori così tanti Melmosi. Che strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Degli ingredienti dal Vigneto Prima Luce, eh...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Ah, non importa in questo momento. Per quanto riguarda gli ingredienti, me la sbrigherò io con quel tipo la prossima volta che lo vedrò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Mi hai salvato la vita, e te ne sono debitore. Ecco, prendi, tanto per cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "A parte questo, vedi quella piccola imbarcazione? Si tratta di un altro dei miei trucchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Con quella barca potrai infiltrarti sull'Isola di Narukami. Comodo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "E perché dovrei \"infiltrarmi\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Ah, ecco, è questo che si intende quando si dice \"aspettarsi l'inaspettato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "#Beh, devo andare a fare il punto della situazione, non posso restare qui a lungo. Di nuovo mille grazie, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "A quanto pare dovrò cambiare il mio punto di raccolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "Cosa stai combinando qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Sto... Ah! Spostando della merce! Spostando della merce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}