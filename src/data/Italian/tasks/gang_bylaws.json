			},
			"dialogs": [
				{
					"id": 191430901,
					"content": "Stavo facendo le pulizie e a un certo punto ho sentito un rumore forte provenire da fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430902,
					"content": "Sono arrivato alla porta appena in tempo e ho visto <color=#00E1FFFF>una figura indistinta sparire su per quell'albero</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430903,
					"content": "Questa è una strada trafficata... Probabilmente non si tratta di un ladro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aikawa Susumu"
				}
			]
		},
