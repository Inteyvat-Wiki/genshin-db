			"dialogs": [
				{
					"id": 191431101,
					"content": "Va bene, voi due restate qui, chiaro? Non sgattaiolate via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431102
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431102,
					"content": "Ci puoi contare... Non ce ne andiamo da nessuna parte adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "Sì, lo vedo. Ma sarà meglio che non cambiate idea quando riprenderete fiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431104,
					"content": "Non lo faremo! Mai più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
