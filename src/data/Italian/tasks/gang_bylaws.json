				"points": []
			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "Che cosa possiamo fare? Dobbiamo proprio smettere di giocare a Invokazione del genio oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Magari possiamo provare a giocare da un'altra parte. Ma dove potremmo evitare i grandi, a parte sotto il ponte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Eh, lo so! Possiamo chiedere a Yoimiya di far scoppiare dei fuochi d'artificio per spaventare il tipo che ci ha rubato il posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Che cattiveria... Però in effetti ha iniziato lui, cacciandoci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Sì, quindi è colpa sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Credo che... forse dovremmo tornarcene a casa a fare i compiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Quelli che non fanno altro che giocare senza studiare mai diventano <color=#00E1FFFF>adulti che poi passano il tempo sotto i ponti</color>, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
