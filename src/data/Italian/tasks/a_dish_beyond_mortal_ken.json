				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290701,
					"content": "Molto bene, ora abbiamo tutti gli ingredienti. Mettiamoci al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290702,
						718290703
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290702,
					"content": "Da dove comincio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290704
					]
				},
				{
					"id": 718290704,
					"content": "Beh... non è che il nostro amico scroccone può darci qualche indicazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290705,
					"content": "Va bene. Per prima cosa, usa la spada per dividere la carne sul tavolo in più porzioni, poi tagliala in pezzi piccoli. Dopodiché, tritala fino a farne pian piano una poltiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290703,
					"content": "Allora... cosa vuoi che faccia per iniziare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290704
					]
				}
			]
		},
