			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "#Eh? Vedo che oggi abbiamo {F#un'}{M#un }ospite speciale. Di solito mangio solo in compagnia del cuoco. Magari la tua presenza ravviverà un po' il pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Peccato, però, che il cuoco sembri molto preoccupato, oggi. Chissà perché ha il muso lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Queste polpette non sono niente male: la carne si scioglie in bocca e il brodo dona molto sapore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Eh? Ci sono le uova di granchio nella carne. Ecco perché il sapore è così sorprendentemente fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "#Vieni, viaggiat{F#rice}{M#ore}. Ti mostro come si fa. Per prima cosa, usa le bacchette per aprire la polpetta, poi intingila nel brodo e infine mangiala con un po' di riso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Molto gentile, grazie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Meglio che vi godiate il vostro pasto, perché potrebbe essere l'ultima volta che cucino qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290410,
					"content": "L'ultima volta? E chi l'ha detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Oh, no, è colpa mia? Il locandiere si è spazientito perché mi hai dato da mangiare per tutto questo tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Mi sembra un po' ingiusto, visto che ho donato alla locanda una selezione del mio miglior pescato gratuitamente. Dovrebbe almeno coprire una parte del conto. Oltretutto, il locandiere non è certo noto per essere uno spilorcio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Ma smettila! Erano solo un paio di pesci, e sono finiti quasi tutti nel tuo stomaco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Quindi... come stanno le cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "*sospira* E va bene, ora ti spiego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Gustoso, accattivante, elegante e al contempo artigianale, e pieno di carattere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Ahahah, dubito proprio che a questo mondo esista un piatto capace di soddisfare le richieste del locandiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Ti sembra divertente? Vedremo se riderai quando tornerai la prossima volta e non ci sarà nessuno a darti da mangiare gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Va bene, va bene. Non è divertente, in effetti. Ecco perché eri così preoccupato, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "È difficile rimanere di buon umore quando il tuo capo improvvisamente si aspetta che tu faccia dei miracoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Uhm, potrebbe esserci una soluzione... Pur non essendo un cuoco, conosco la ricetta di una specialità davvero unica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Ho avuto modo di assaggiarla durante un viaggio all'estero, quando ero ospite a casa di un pezzo grosso di quelle parti. Il piatto si chiamava \"pollo al tofu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Dall'aspetto, non si direbbe neanche che è un piatto di carne. È delicato come un budino di tofu, ma con un forte sapore di carne ed erbe. Un raro piatto di carne che imita la cucina vegetariana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Quel piatto mi aveva incuriosito così tanto che ne chiesi la ricetta al mio ospite. Tuttavia... dato che sono una frana a cucinare, è rimasta a prendere polvere nel mio baule da allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Mi stupisce che tu sia riuscito a mettere le mani su una tale ricetta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Oh, è una storia lunga... Ho aiutato una persona e questa mi ha invitato a un banchetto per ringraziarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Il cuoco che ha ideato questa ricetta non si è fatto problemi a condividerla con me. Sapeva bene che i cuochi in grado di preparare alla perfezione un piatto simile si contano sulle dita di una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Senza dubbio. Secondo quel cuoco, per riuscire a preparare quel piatto occorre non solo avere esperienza nell'arte culinaria, ma anche in quella della spada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Mmmh, che razza di piatto può richiedere di saper usare una spada? Posso benissimo tagliare la carne con il mio coltello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290431,
					"content": "Con quel coltello, temo che sarebbe più facile dividere in due il tagliere che tritare la carne nel modo giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "Mi è stato detto che la carne tritata è il punto di forza della ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Pertanto, la precisione con la spada è la chiave di tutto. Per prima cosa, è necessario dividere la carne in porzioni e tagliarla finemente con il filo della spada. Poi, la si trita sfruttando la parte posteriore dell'arma. Dopodiché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Aspetta un attimo. Questa ricetta è totalmente inutile, nelle nostre mani: io non so usare la spada e tu in cucina sei una frana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Dove lo troviamo un guerriero spadaccino che abbia anche esperienza in cucina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Magari quella persona... è più vicina di quanto pensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "P-Parli di me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Esatto. Non è forse un fortunato scherzo del destino che tu sappia usare sia la spada che i fornelli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "#Perché non chiedere allora a{F#lla}{M#l} viaggiat{F#rice}{M#ore} di preparare una specialità tanto unica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Ma il locandiere vuole che sia Yanxiao a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Beh, il locandiere ha solo detto a Yanxiao di creare un nuovo piatto, non ha specificato chi dovesse cucinarlo... quindi l'interpretazione è libera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Non è vero, cuoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Ehm... giusto! Mi sembra logico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290446,
					"content": "Quali ingredienti ci servono per preparare il pollo al tofu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Niente di speciale, a dire il vero. Solo pollame, prosciutto, un uovo d'uccello e una bocca di leone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "In cucina ho ancora un po' di prosciutto e del pollame, ma le scorte di uova d'uccello e bocche di leone sono esaurite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Se l'avessi saputo prima, non avrei preparato quelle uova strapazzate ai matsutake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290450,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti portarmi gli ingredienti mancanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Non appena li avrai trovati, prepareremo insieme il pollo al tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Oh... E naturalmente ti ripagherò per il tuo aiuto. Grazie in anticipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290439,
					"content": "In cucina me la cavo bene, questo è vero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "#E sei anche {F#un'}{M#un }abile spadaccin{F#a}{M#o}, o sbaglio? Ho assistito di persona ad alcune delle tue imprese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Dev'essere una ricetta molto difficile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Caspita, parli come un vero esperto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Ahahah, anche uno sciocco finirebbe per imparare qualcosa, avendo la possibilità di gustare ogni giorno prelibatezze come questa. Lascia che ti insegni come si gusta questo pesce in umido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Non mangi con noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Io? No, direi che sono già sazio, visto che... il locandiere mi ha riempito d'ansia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Yanxiao"
				}
			]
		},
