			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao",
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Mmm, che sapore... È così pieno e fresco, mentre la consistenza ricorda quella di un budino di tofu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291403,
					"content": "Ha anche un ottimo aspetto e richiede una preparazione veramente raffinata. Trovo interessante pure la premessa: un piatto di carne che imita la cucina vegetariana. Sono sicuro che saranno in molti a volerlo provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291404,
					"content": "Niente male! Niente male davvero! Sono sicuro che il locandiere sarà soddisfatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Che sorpresa! A quanto pare, sei più in gamba di quanto pensassi. Chi avrebbe mai detto che uno scroccone come te si sarebbe ricordato una ricetta simile così bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Ahah, ora posso anche dirtelo: quando ho ricevuto la ricetta, pensavo che nascondesse una sorta di tecnica segreta con la spada, quindi l'ho studiata giorno e notte senza sosta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Ora che ci penso, dovevo essere davvero impazzito. Era solo una ricetta. Perché mai avrebbe dovuto avere qualcosa a che fare con l'abilità da spadaccino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "E allora perché tutto quell'allenamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Per cercare qualcuno e chiedere giustizia, ecco tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Ah! Un gesto davvero magnifico! E ora eccoti qui, a parlarne come se fosse una cosa da niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Ahah. Comunque, una volta ottenuta giustizia, sono venuto qui. Per fortuna, il locandiere era disposto a farmi restare e a lasciarmi cincischiare qui in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Ormai ho perso ogni aspirazione. Non voglio più maneggiare la spada e non ho altre abilità... Ahahah, suppongo che restarmene qui per il resto della vita non sarebbe così male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Bene, immagino che adesso io debba darti una copia della ricetta, così potrai preparare questa specialità quando ne avrai il tempo. Ci vuole un po' di lavoro, ma ha un ottimo sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Mmmh... Bene, ora mettiamo via il piatto. Lo presenteremo al locandiere quando sarà tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291418,
					"content": "E dopo... Ehi, ehi, signor Fannullone, non te ne andare. Vieni qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Oh, che cosa c'è? Per la cronaca, non ho altre ricette da darti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Prima non hai detto che non sai fare altro che brandire la spada? Bene, allora tirala fuori. Ti insegno a tagliare la carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291421,
					"content": "Tagliare la carne? Beh... non so se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "Ci metterai poco a imparare. Oggi tagli la carne e domani prepari un piatto. Poi ne prepari ancora un paio, ed ecco che avrai appreso una nuova arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291423,
					"content": "Che stai facendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "Umpf. Ti insegno a cucinare un po' di piatti. In questo modo, non dovrei più vederti qui a scroccare da mangiare, poco ma sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Yanxiao"
				},
				{
