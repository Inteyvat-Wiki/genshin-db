		{
			"id": 7182914,
			"completionStepIds": [
				7182909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182909",
							"2"
						],
						"stepId": 7182909,
