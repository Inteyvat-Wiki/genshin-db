			},
			"dialogs": [
				{
					"id": 718291201,
					"content": "Adesso accendi il fuoco e cuoci la poltiglia di carne a fuoco lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291202,
					"content": "Tieni bene d'occhio la fiamma: se è troppo bassa, la carne non si cuocerà; se è troppo alta, si sfalderà e perderà consistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291203,
					"content": "Un piatto a base di carne cotta a fuoco lento in un brodo speciale... Non è certo economico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
