			"dialogs": [
				{
					"id": 747060101,
					"content": "Uhm... E questo qua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747060102,
					"content": "Uhm, ho ancora la sensazione che manchi qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Colombina? Furina? Che state confabulando, voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Io e Furina stiamo... facendo un \"casting\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747060105,
					"content": "Che modo meraviglioso di esprimerlo! Ma gli \"attori\" che stiamo cercando... guarda caso sono pesci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "...I pesci sanno recitare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Al giorno d'oggi, gli animali attori sono tutt'altro che una rarità: stiamo cercando d'ingaggiare un pesce dotato dello spirito giusto per girare alcune riprese secondarie... È essenziale per creare l'atmosfera adatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Ma credo che abbiamo visto tutti i pesci dell'acquario, e nessuno di loro sembra essere quello giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#E se provassimo a chiedere aiuto a {NICKNAME} e Paimon? Hanno talento nel risolvere i problemi più complicati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747060110,
					"content": "A Paimon fa piacere che voi abbiate così tanta fiducia in noi, ma... quando si tratta di fare un \"casting\" tra i pesci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Potremmo provare a radunare più \"candidati\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "#Ottima idea! Dopotutto, siete voi {F#le esperte}{M#gli esperti} nel gestire l'acquario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Quindi, dobbiamo aguzzare la vista e cercare talenti ogni volta che andiamo a nuotare? Beh, Paimon non vede perché no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Allora è deciso! Più tardi vi spiegherò che tipo di atteggiamento stiamo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "#Quindi questo fa di voi {F#delle}{M#dei} \"talent scout\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747060117,
					"content": "Stai già imparando il gergo dello spettacolo, da quando frequenti Furina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Oppure a fare un casting sul campo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
