			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Spesso bazzica da queste parti, ma oggi non si è fatto vivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Dopo quello spavento, dev'essere andato a nascondersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "Dobbiamo andare a cercarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "No. Diamogli un po' di tempo per calmarsi. Lasciamo qui i funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Vedo che ci sai fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "A prendermi cura di quel piccoletto? È normale. Me ne occupo da tempo, quindi so che è un tipo sensibile. Basta la vista di estranei a spaventarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "L'ho nutrito per molto tempo, prima che si decidesse ad avvicinarsi a me... Ma dopo quello che hanno combinato quei furfanti, chissà quando tornerà a farsi vivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "Dobbiamo lasciarlo in pace per qualche tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Grazie per la compagnia. Ecco la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Peccato che non siamo riusciti a vederlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Non preoccuparti, non dimentica chi si comporta bene con lui. Quando sarà il momento giusto, verrà sicuramente a trovarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Mi sarebbe piaciuto conoscere quel piccolo Yumkasauro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
