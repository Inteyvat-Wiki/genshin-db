			"dialogs": [
				{
					"id": 250260401,
					"content": "È ora di dare una lezione a quei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#Vuoi venire anche tu? Grazie! Saresti sicuramente di grande aiuto: si vede subito che sei {F#un'avventuriera esperta}{M#un avventuriere esperto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Ti ricompenserò come previsto dalle regole della Gilda degli avventurieri. Forza, andiamo a dare una lezione a quei furfanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502605,
