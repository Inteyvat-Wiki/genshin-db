			"dialogs": [
				{
					"id": 250260601,
					"content": "Shhh. Guarda là. Ci sta aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260602,
					"content": "...Woo? Moo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Piccolo Yumkasauro timido"
				},
				{
					"id": 250260603,
					"content": "Vieni qui, piccolino. Non ti faremo niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260604,
					"content": "Moo? Mmmmroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260605
					],
					"speakerTitle": "Piccolo Yumkasauro timido"
				},
