				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "Umpf. Vediamo se si azzarderanno ancora a fare del male al mio piccolo Yumkasauro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Sembra che ci sia stato un malinteso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Non farti abbindolare dalle loro belle parole. Li ho visti con i miei occhi mentre legavano la coda di quel povero Yumkasauro con una corda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Chissà cosa sarebbe successo se non fossi intervenuto per tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Comunque sia, grazie per l'aiuto. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Peccato solo che siano fuggiti così in fretta. Se fossimo riusciti a catturarli, avremmo potuto porre fine alle loro attività criminali una volta per tutte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
