			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Ah, splendido! Le prove di collaudo sono andate lisce come l'olio. Gli Onikabuto sono stati perfettamente purificati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "Molto bene, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Ora non dobbiamo fare altro che pianificare il percorso da seguire, e poi potremo iniziare sul serio. Tuttavia, dobbiamo evitare i Fatui, quindi saremo costretti a prendere la via più lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Questo coso è piuttosto ingombrante, perciò, prima di trasportarlo all'interno, dobbiamo essere sicuri che non ci saranno intoppi sul nostro cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Pertanto, ti chiederei di rientrare nella Fornace Mikage per indagare. Qualora notassi dei ponti non percorribili, ti pregherei di ripararli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Devo ancora decidere quale percorso prenderemo, ma ovviamente avere più opzioni non guasta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "#Non sono {F#un'esperta}{M#un esperto} di riparazioni, sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Non devi riparare ogni cosa alla... perfezione. Basterà anche solo piazzare delle assi di legno su cui muoverci trasportando il dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, puoi prendere le assi di legno che trovi nelle vicinanze. Nel frattempo, io rimango qui e cerco di migliorare più che posso l'affidabilità del dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
