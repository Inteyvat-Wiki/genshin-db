			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "Speriamo che vada tutto bene. Prima risolviamo questa faccenda, meglio è. Se tardassimo ancora, chissà cosa potrebbe succederci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212009",
							"2"
						],
						"stepId": 7212009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Allora? Hai dato un'occhiata ai ponti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Ora sono più percorribili che mai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Molto bene. A-Allora avviamoci dopo una breve attesa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "Ehi, ma stai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "S-Sto pensando! Sto pensando a tutte le cose che potrebbero accadere, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Per esempio, cosa faremo se quei pazzi mascherati dovessero avere già estratto il nucleo quando entreremo là dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Potrebbero scagliarlo contro una Guardia delle rovine, che s'infurierebbe e ci spazzerebbe via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "O magari, mentre purifichiamo la Fornace Mikage, potrebbe emergere una sorta di creatura elementale capace di divorare il nucleo in un sol boccone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "Nel peggiore dei casi, quel serpente leggendario potrebbe cogliere l'occasione per risorgere. Se così fosse, sarebbe la fine! La fine! Saremmo spacciati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Mantieni la calma, Xavier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "Ah! Ehm, scusami... Non riesco a liberarmi di certe vecchie abitudini. Tendo sempre a pensare al peggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Elaborerò qualche piano e, quando sarà il momento, andremo a mettere fine a tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Fa' che vada bene, fa' che vada bene, fa' che vada bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "#Io non sarei così drammatic{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
