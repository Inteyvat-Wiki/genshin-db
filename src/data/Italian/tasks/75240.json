					"Nahuatlalli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "#{F#Benvenuta}{M#Benvenuto} alla Coppa degli Eroi di Ayar, {F#amica mia}{M#amico mio}. Io sono l'organizzatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Oggi è l'ultimo giorno della competizione. Se vuoi vincere, dovrai sconfiggere i nostri tre migliori guerrieri uno dopo l'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "Coppa degli Eroi di Ayar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "È una battaglia per la gloria di Ayar! Puoi usare i pugni, le armi o qualsiasi altro stratagemma per affrontare e sconfiggere il tuo avversario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "Questo Ayar è una persona o...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "#{F#Amica mia}{M#Amico mio}, gli unici a poter fare domande, qui, sono i campioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "Sali sul ring! Vediamo se hai la stoffa per guadagnarti un simile privilegio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
