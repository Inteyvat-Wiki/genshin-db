			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Cosa stai cucinando lì dentro? A Paimon viene l'acquolina in bocca solo a sentirne il profumo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210102,
					"content": "Sembra una specie di zuppa. Mm... Paimon non riesce a capire cosa ci sia dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210103,
					"content": "#Ehi, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210104,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "La persona che lo sta cucinando non è qui, e il profumo è davvero delizioso. Mangiamone un boccone finché non c'è nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210106,
					"content": "Ci sto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210112,
					"content": "La pentola era più piccola di quanto non sembrasse.\\nLa zuppa al suo interno è finita in un attimo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Aaah... Eh? Il profumo è buono, ma perché Paimon non sente alcun sapore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210114,
					"content": "#Grande Aramuhukunda! Cosa ci fa u{F#na}{M#n} Nara qui?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210115,
					"content": "Un Ar-Aranara? E tu da dove spunti fuori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210116,
					"content": "Da sottoterra! Perché stai bevendo la mia zuppa? Arapas si è impegnato tantissimo per prepararla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210117,
					"content": "Chiedo scusa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Chiedo scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210119,
					"content": "Tsk! Hai finito la mia zuppa! Le scuse non bastano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210123,
					"content": "Sapete quanto è difficile preparare una zuppa da queste parti? Un minuto piove, un minuto dopo c'è il sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210124,
					"content": "Per me è stato davvero difficile cucinare questa zuppa, ma mentre ero via a raccogliere frutti di Harra freschi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210125,
					"content": "Non abbiamo resistito... C'era un profumo delizioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210126,
					"content": "Ma se è così difficile, perché cucini qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210127,
					"content": "Tsk! La cosa più importante in cucina, e che bisogna acquisire ogni giorno, è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210128,
					"content": "Il tuo orgoglio da chef?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "L'acqua! È l'acqua! L'acqua ha un impatto enorme sull'aroma di una zuppa. Per questo va preparata con l'acqua migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210131,
					"content": "Ho raccolto acqua dappertutto nei Boschi di Apam per poter preparare una zuppa. Dopo aver selezionato così tanti campioni come le foglie di un albero, ho finalmente trovato la migliore \"acqua di sorgente viva\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210132,
					"content": "#È l'unica fonte d'acqua adatta alla Prelibatezza suprema del Festival di Utsava! Non lo capireste neanche se ve lo spiegassi... Solo {F#il}{M#la} Nara del passato era in grado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210133,
					"content": "A tal proposito, ci manda Arapacati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210134,
					"content": "Informi Arapas di quanto accaduto finora...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "#Ah, siete {F#le amiche}{M#gli amici} Nara di mia sorella! E il Festival di Utsava sta per iniziare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210136,
					"content": "Va bene. Ho trovato l'acqua di sorgente viva e la mia Prelibatezza suprema è pronta. È in questa pentola... Oh, giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210138,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Eheh... Non essere triste, almeno la tua zuppa era molto aromatica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210140,
					"content": "Ah! L'acqua di sorgente viva! Alla sua fonte vivono gli Apshvaana. Ho aspettato così tanto che se ne andassero e ne ho raccolto solo una pentola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210141,
					"content": "No! Dovete procurarmi un'altra pentola d'acqua di sorgente viva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210142,
					"content": "\"Apshvaana\"? Che cosa sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210143,
					"content": "Tsk! Voi Nara non sapete davvero nulla della foresta! Gli Apshvaana vivono nell'acqua, hanno quattro zampe, una coda e mordono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210144,
					"content": "...Cani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210145,
					"content": "I cani non vivono nell'acqua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "Ah, giusto. Allora cos'è un Apshvaana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210148,
					"content": "Lascia perdere! Voglio la mia acqua! Voglio la mia acqua di sorgente viva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210149,
					"content": "#Va bene, va bene... {NICKNAME}, non abbiamo scelta. Andiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210150,
					"content": "Giusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Voglio solo l'acqua di sorgente viva, nient'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210151,
					"content": "Andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "Magari dei cani oceanidi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "La volontà di non dimenticare mai i propri sogni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "È stata... È stata Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#Ehi! {NICKNAME}, come puoi tradire Paimon in questo modo?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210122,
					"content": "Non mi interessa chi l'ha bevuta! La zuppa adesso è finita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210108,
					"content": "Non dovremmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Paimon è davvero curiosa. Paimon ne assaggerà solo un boccone, solo uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210110,
					"content": "E se poi ti viene il mal di pancia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "Tsk! Non sottovalutare Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
