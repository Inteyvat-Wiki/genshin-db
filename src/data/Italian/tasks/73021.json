			"dialogs": [
				{
					"id": 730210701,
					"content": "(Una foglia enorme, su cui qualcuno ha scritto con una grafia disordinata...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210702
					],
					"speakerTitle": "Foglia con grafia approssimativa"
				},
				{
					"id": 730210702,
					"content": "\"...La diciassettesima volta il gelo ha coperto le foglie. Dopo alcune prove, ho notato che l'acqua degli affluenti è piena di sabbia e fango. Sa di terra. Inaccettabile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210703
					],
					"speakerTitle": "Foglia con grafia approssimativa"
				},
				{
					"id": 730210703,
					"content": "\"...La trentesima volta la brina ha ricoperto le foglie. Sta piovendo di nuovo. Inaccettabile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210704
					],
					"speakerTitle": "Foglia con grafia approssimativa"
				},
				{
					"id": 730210704,
					"content": "\"...La sessantesima volta il gelo ha coperto le foglie. Dopo alcune prove, ho notato che l'acqua del corso principale di un fiume produce una zuppa molto più aromatica, ma non è ancora sufficiente. Inaccettabile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210705
					],
					"speakerTitle": "Foglia con grafia approssimativa"
				},
				{
					"id": 730210705,
					"content": "\"...L'ottantesima volta la brina ha ricoperto le foglie. Non appena ho finito la zuppa, ha iniziato a piovere. Per fortuna indossavo un cappello. La qualità di quest'acqua non è male.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foglia con grafia approssimativa"
				}
			]
		}
