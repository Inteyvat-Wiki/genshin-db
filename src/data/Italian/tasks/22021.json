			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Preparatevi, questo piatto sarà succulento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Il mio piatto sarà altrettanto fantastico, quindi occhio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Cosa state facendo voi due?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#Ciao, viaggiat{F#rice}{M#ore}. Parvaneh e Julie stanno raccogliendo ingredienti e in teoria dovevamo preparare un piatto per loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Ma zio Munehisa e io abbiamo avuto una differenza di opinioni su cosa preparare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Quindi abbiamo deciso di preparare un piatto a testa e gareggiare. Il vincitore stabilirà il tema dei pasti di oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Io sto preparando una specialità di Liyue, la zuppa di gemme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "E io invece sto preparando il mio cavallo di battaglia, gli spiedini ai tre sapori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Posso essere d'aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Beh, se hai tempo, ci servirebbe qualcuno che faccia da giudice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Ma dal momento che entrambi dobbiamo preparare quattro porzioni di ogni piatto, pur avendo solo due mani, siamo un po' oberati di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Potresti aiutarci a preparare il cibo prima di giudicarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "E ovviamente puoi scegliere per quale piatto dare una mano, visto che sei solo una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, ce la faresti da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Non preoccuparti per me. Gestivo un ristorante a Liyue, quindi non ho difficoltà a preparare un pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Detto questo, con un po' di aiuto potrei cucinare anche meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Comunque scegli il piatto che ti interessa di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, aiuterò te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Ah, fantastico! Zio Munehisa, preparati ad essere sconfitto dal mio piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Non sono un tipo che si arrende facilmente. Fai del tuo meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Zio Munehisa, darò una mano a te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Grazie. Xudong, preparati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Nessun problema. Fai pure del tuo meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Zio Munehisa, ce la faresti da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Non preoccuparti. Scegli chi preferisci. Quando lavoravo per lo Shogunato, preparavo tanti pasti per molte persone, oltre a me stesso. Qui devo preparare solo quattro porzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "Ma se vorrai aiutarmi, sicuramente il piatto riuscirà ancora meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "In effetti manca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Ahahah, esattamente. Dovrà assaggiare tutti e due i piatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "#Finito. Grazie, viaggiat{M#ore}{F#rice}. Ha un profumino incredibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Lo voglio provare... Wow, è buonissimo. Gli ingredienti sono cotti a puntino e ha un profumo perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Si potrebbe anche ribattezzare \"zuppa di gemme perfetta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "#Allora, zio Munehisa, come va in cucina? Sei pronto a mostrare il tuo piatto {M#al viaggiatore}{F#alla viaggiatrice}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Beh... ho commesso un errore. Mi sono accorto di non avere abbastanza uova d'uccello subito dopo aver iniziato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Anche se sono andato immediatamente a cercare altre uova d'uccello nei boschi, quando sono tornato gli altri ingredienti ormai non erano più freschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Gli spiedini ai tre sapori cucinati con ingredienti poco freschi non sono un buon piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Mi vergogno di essere stato così disattento. Dovrò affinare le mie capacità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Stavolta hai vinto tu. Ma la prossima volta, caro Xudong, ti batterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Questo è lo spirito giusto, zio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Ahah, prometto che non sarò un avversario facile da battere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "#Comunque, viaggiat{M#ore}{F#rice}, questo è per te. Grazie mille per aver passato tutto quel tempo ad aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Mi raccomando, torna anche per la nostra prossima gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "A dire il vero, secondo me ha un sapore accettabile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Accettabile non basta. Bisogna avere il coraggio di perseguire la perfezione anche in cucina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "Solo così si può diventare maestri nell'arte culinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Ah, capisco. Esattamente... è proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "L'arte della spada e quella culinaria sono simili, in questo aspetto, e per me fanno entrambe parte dell'arte della vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Grande! Ehm, complimenti zio Munehisa... credo in te. Già...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Ehm, non ho la più pallida idea di come comportarmi con una persona così... seria. Immagino che solo Julie lo sappia, ma non è qui adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "#Onestamente, anche io sono abbastanza scioccat{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "#*tossisce* Beh, grazie per il tuo duro lavoro viaggiat{M#ore}{F#rice}. Prendi questi. Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Xudong, vorrei farti qualche altra domanda di cucina. Hai un attimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Eh? Oh, certo, sì! Arrivo! Arrivo subito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
							"2"
						],
						"stepId": 2202110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Mmmh. Il profumo e l'aspetto... Questi spiedini ai tre sapori dovrebbero chiamarsi spiedini estremi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "Spiedini... estremi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Eheh, intendo solo che si tratta di un piatto perfetto... Beh, guarda che ora si è fatta. La zuppa di gemme di Xudong dovrebbe essere già pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Certamente! Ecco la mia zuppa di gemme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Potrebbe essere un po' troppo cotta perché non ho gestito bene il tempo, ma il sapore dovrebbe essere a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Fammi assaggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Ha un leggero sapore di bruciato. Non è così forte da rovinare tutto, ma è comunque un difetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Ahahah, stavolta avevo fretta. La prossima volta preparerò tutti gli ingredienti in anticipo, così non succederà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Che dire, hai vinto, ma stai certo che non commetterò lo stesso errore la prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Eri troppo distratto, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Ahahah... Sì, ero distratto. La prossima volta starò più attento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "#Comunque, viaggiat{M#ore}{F#rice}, questo è per te. Grazie mille per aver passato tutto quel tempo ad aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Mi raccomando, torna anche per la nostra prossima gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Gli spiedini estremi dello zio Munehisa hanno avuto la meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Spiedini estremi? Cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Significa che questi spiedini ai tre sapori sono perfetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "Avere un obiettivo estremo significa che non si è mai soddisfatti di qualcosa di accettabile. Anzi, la meta è la perfezione massima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Anche in cucina è necessario perseguire la perfezione. Solo così si diventa maestri nell'arte culinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Ah, capisco. Esattamente... è proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "L'arte della spada e quella culinaria sono simili, in questo aspetto, e per me fanno entrambe parte dell'arte della vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Vieni, Xudong. Lascia che ti racconti del percorso verso il cosiddetto \"estremo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "#Eh? O-Ok, dammi solo un attimo. Viaggiat{M#ore}{F#rice}, ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Ehm, non ho la più pallida idea di come comportarmi con una persona così... seria. Immagino che solo Julie lo sappia, ma non è qui adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Vai a provare l'esperienza culinaria estrema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Eh? Arrivo. Solo un attimo! Arrivo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
