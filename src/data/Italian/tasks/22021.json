			},
			"dialogs": [
				{
					"id": 220210601,
					"content": "Allora cominciamo. Per la zuppa di gemme sono necessari bocche di leone, tofu e frutto di loto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210602
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210602,
					"content": "Frutto di loto e tofu... Fortunatamente ne sono rimasti ancora un po'. Ma non ci sono abbastanza bocche di leone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210603
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210603,
					"content": "#Viaggiat{M#ore}{F#rice}, io mi occupo degli ingredienti. Per sicurezza potresti portarmi altre tre porzioni di bocche di leone fresche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
