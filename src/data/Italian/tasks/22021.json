				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210701,
					"content": "Grazie per il tuo aiuto. Gli spiedini ai tre sapori sono facili da preparare, ma servono un'attenzione particolare e ingredienti freschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Ho abbastanza ingredienti, mancano solo delle uova d'uccello. Potresti andare a prendermi due uova d'uccello, per sicurezza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Come hai imparato a preparare questo piatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Quando servivo sotto lo Shogunato, preparavo questi assaggi da servire con il vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Ma ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Non parliamo del passato. Conto su di te per le uova d'uccello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Nel frattempo mi occuperò degli altri ingredienti. Per piacere, portami le uova d'uccello appena le trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		}
