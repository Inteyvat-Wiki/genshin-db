	"talks": [
		{
			"id": 1101001,
			"completionStepIds": [
				1101001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101001",
							"2"
						],
						"stepId": 1101001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "#Stai in guardia, viaggiat{M#ore}{F#rice}, non siamo in gita turistica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Ah... e perché? È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Sì. Per quanto insolito possa sembrare, diversi testimoni oculari hanno confermato la presenza di una Guardia delle rovine in questa zona, anche se siamo molto lontani dalla loro normale area di attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "Il sergente ha mandato qualcuno a scoprire da dove siano arrivate queste antiche macchine. Sembra che abbiano semplicemente lasciato le loro rovine e si siano allontanate all'improvviso, senza una ragione apparente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Qualcuno le ha risvegliate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Come ho detto, il motivo non è ancora chiaro, per ora abbiamo pochissime informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Non finisce qui... Le rovine in questione sono particolarmente inquietanti. Si sentono spesso strani rumori provenire da esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Per questo motivo, non siamo autorizzati a indagare fino a un nuovo ordine dal quartier generale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "La prudenza non è mai troppa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "In ogni caso, l'unica strategia sensata per ora è aumentare le pattuglie di Milleliti. Non possiamo lasciare che dei civili innocenti si trovino in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Hai ragione... La gente normale non penso vada molto d'accordo con le Guardie delle rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Possiamo essere d'aiuto in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Wow, ehm... Sono davvero grato per l'offerta, ma... temo che sia troppo rischioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#Oh, non ti preoccupare! Le Guardie delle rovine, {NICKNAME} se le mangia a colazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Me la cavicchio con l'autodifesa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Beh, vista la vostra spassionata offerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "Ho visto le impronte di una Guardia delle rovine sulla <color=#00E1FFFF>collina</color>, ma finora sono stato troppo occupato ad avvertire i passanti per indagare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Impronte? Interessante... Beh, il caso è nostro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "#Il male non trionferà sotto lo sguardo dei Milleliti! A nome dei Milleliti ti saluto, viaggiat{M#ore}{F#rice}. Hai la mia gratitudine. Ci rivedremo al termine del mio giro di pattuglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Non per vantarmi, ma potrei sconfiggere dieci di voi in combattimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Ahahah! L'autostima è sicuramente un valore aggiunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "I Milleliti... sempre così inefficienti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Come? Non ho capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "Questa sarebbe la tua imitazione di patron Diluc che parla dei Cavalieri di Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "Ehi, voi! Venite a dare un'occhiata, non è fantastico?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "Ma com'è vestito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "Non ne ho mai visto uno così da vicino! E voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Sì, è una Guardia delle rovine disattivata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Eh? Cosa? Si chiama signor Ciclope, in realtà! Che razza di nome stupido sarebbe Guardia delle rovine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "\"Signor Ciclope\"? Oh, che carino... Aspetta, cosa? La gente li chiama davvero così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Sì, l'ha detto mio fratello, il miglior venditore di giocattoli del mondo! Per lavoro vende proprio questo genere di cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Ora si trova all'Istituto di ricerca sui giocattoli di Liyue. Il signor Ciclope viene proprio da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "È sempre bello incontrare qualcun altro a cui piacciono i giocattoli. Allora dimmi, dove hai preso il tuo? Dev'essere un modello piuttosto nuovo, non ne ho mai visto uno che vola e parla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon non è un giocattolo, e non lo sono neppure le Guardie delle rovine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Già! Paimon non è un giocattolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Eccovi... avete trovato qualcosa... Oh, un bambino? C-Che sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Mah, guarda... l'abbiamo appena incontrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Ehm, non dovresti trovarti qui, ragazzino. In questa zona si aggirano macchine assassine, è molto pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "\"Macchine assassine\"? Vuoi dire... macchine che assomigliano a questa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Esatto, questa inclusa. Ora non si muove, ma se dovesse svegliarsi, le conseguenze sarebbero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "Rimangiati quello che hai detto! Il signor Ciclope non è una macchina assassina, anzi è uno dei buoni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Ehm... \"signor Ciclope\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "Non dovremmo ascoltare questo tizio. Dice delle cattiverie sul signor Ciclope, è sicuramente un uomo cattivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "S-Sto solo cercando di aiutare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Ormai non ti darà più retta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Uff, sono sempre stato pessimo con i bambini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "#Bene, allora perché non torni al lavoro e lasci fare {M#i}{F#le} babysitter a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Non ho altra scelta, a quanto pare... Molto bene, continuerò il mio giro di pattuglia. Per favore, scortate il bambino in un posto sicuro, è troppo pericoloso qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Ahahahah, il potente signor Ciclope ha messo in fuga i cattivi ancora una volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "Come ti chiami, ragazzino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "Mi chiamo Teucer! Sono venuto fin qui da Snezhnaya per cercare mio fratello a Liyue, ma sono da solo e non so dove trovarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "Sei arrivato fin qui da Snezhnaya?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Oh, credo che sia arrivato il momento di darvi questa... Ecco qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "Una borsa? Sembra pesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "Ma che...?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "Oooh, quanti Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "\"Prendili, Teucer, trova una brava persona a cui darli e vedrai che si prenderà cura di te\". Così ha detto mio fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Tuo fratello ha ragione... Però è difficile credere che tu abbia fatto tutta questa strada in compagnia solo di qualche sacchetto di Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "La tua famiglia dev'essere ricca sfondata! Paimon non sapeva che si potessero guadagnare così tanti Mora vendendo giocattoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "Li prendo volentieri!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "Sììì! Grazie, siete proprio delle brave persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Bene, ora dobbiamo stringerci il mignolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "Se fai una promessa con il mignolo, devi mantenerla per tutta la vita. E se la infrangi, ti butto nel ghiaccio! Il freddo ti farà cadere il mignolo con cui hai tradito il tuo amico, e il gelo ti congelerà la lingua così non mentirai mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Wow... questa filastrocca dice tutto quello che c'è da sapere sulla cultura di Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "#Beh, se prima non eravamo {M#i tuoi}{F#le tue} babysitter, ora lo siamo di sicuro... Ma dove dobbiamo cercare tuo fratello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "In qualche luogo che abbia forti legami con Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Snezhnaya... Oooh, che ne dici della <color=#00E1FFFF>Banca del Nord</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Evviva! Finalmente potrò rivedere mio fratello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "La <color=#00E1FFFF>Banca del Nord</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Ottima idea. Va bene, si parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Li prendo volentieri (e li darò a tuo fratello quando lo troveremo)!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Wow! È una montagna di Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Dov'è la tua famiglia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Magari lascia che me ne occupi io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Edizione limitata! Sei invidioso, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Ehi! Solo perché giochi con Paimon tutto il giorno non significa che Paimon sia un giocattolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Attento ragazzino, questi mostri sono davvero tosti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "Ci puoi scommettere! Non conosco un signor Ciclope che non sia fortissimo! Nessun cattivo può sfuggirgli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Mi sembra un po' inappropriato, non crede? Come può...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Rilassati, una volta ogni tanto non può certo far male, andrà tutto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100303,
					"content": "Eh? Cosa ci fa lui qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Sììì! Fratello, ti ho trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Conosco questa voce... Ma guarda un po' se non è il mio fratellino Teucer! Oh, cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100306,
					"content": "Ahah... che bella sorpresa, Teucer! Pensavo che ti avrei rivisto solo una volta tornato a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100307,
					"content": "Come stanno gli altri, nostra sorella Tonia e nostro fratello Anthon? Tutti bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100308,
					"content": "Manchi tanto a tutti! Tonia prega per te ogni giorno a cena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "Aspetta un attimo... Cosa ci fai qui a Liyue, Teucer? Come mai non ne sapevo niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100310,
					"content": "Beh... è successo che... ho visto una barca che sembrava vendere giocattoli, quindi ho pensato che tu fossi a bordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "E quando sono sbarcato ho iniziato a camminare e camminare... e poi, ho trovato un signor Ciclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "Il signor Ciclope ha spaventato un cattivo, e poi ho trovato queste persone gentili che mi hanno aiutato a cercarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Quindi Teucer è un clandestino!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "E non finisce qui... Teucer è il fratello del Principe?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Forte! Improvvisamente Paimon non si sente più così in colpa per aver preso i soldi di Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, quello che hai fatto è estremamente pericoloso... Sono felice di vederti, davvero, ma ti prego... Promettimi che non farai mai più una cosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100318,
					"content": "Ok, te lo prometto... Per favore, non ti arrabbiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "Non sono arrabbiato con te, mi preoccupo solo della tua sicurezza, tutto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100320,
					"content": "Poteva capitarti qualcosa di molto brutto, Teucer, ma per fortuna hai incontrato queste brave persone. Spero che tu le abbia ringraziate come si deve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100321,
					"content": "Certo, mi ricordo sempre di dire \"grazie\" e \"per favore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Oh, quindi ti eri accorto di noi, ci stavi solo ignorando... Capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Ahahah! Perdonatemi, dalle mie parti la famiglia viene prima di tutto, non prendetela sul personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100324,
					"content": "So che non siamo andati molto d'accordo finora... ma a parte qualche piccolo dettaglio direi che abbiamo un buon rapporto, non trovate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100325,
					"content": "Dici sul serio o cerchi solo di salvare le apparenze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Dai, lo sapete che sono solo una pedina. Faccio la mia parte, nient'altro. E per quanto riguarda chi vince, chi perde e le conseguenze per le due parti... beh, lascio che se ne occupi chi muove i pezzi della scacchiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100328,
					"content": "Quando ci scontriamo per allenarci, allora sì che m'interessa chi vince e chi perde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100329,
					"content": "Uhm... vuoi dire che sei pronto a farti prendere di nuovo a calci nel sedere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Ahah! Vi dimenticate che io, Tartaglia, dedico ogni secondo a diventare più forte. La prossima volta non finirà allo stesso modo, fidatevi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100331,
					"content": "Anche io ho fatto molta strada dall'ultima volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Ehi, ehi, ehi! Non vorrete mica mettervi a combattere adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Ahahah... Magari non ora, non davanti al mio fratellino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100335,
					"content": "Perché vuoi combattere con queste brave persone? Siete nemici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#No, niente affatto! {NICKNAME}, permettimi di esprimere formalmente la più sincera gratitudine per esserti pres{M#o}{F#a} cura del mio caro fratellino. La sua sicurezza mi sta molto a cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100337,
					"content": "Comunque sia, continuo a tenerti d'occhio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "Ehm, comunque, Paimon ha una domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer ha detto che sei un venditore di giocattoli... Cos'è questa storia? Non dovresti essere uno dei Messaggeri Fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "Ehm... sì, a proposito di quello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100342,
					"content": "Beh, gliel'ho detto solo perché fosse orgoglioso di me. Agli occhi di un bambino, vendere giocattoli è il miglior lavoro del mondo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100343,
					"content": "Non voglio che la mia famiglia abbia nulla a che fare con il lato oscuro dei Fatui... o dovrei dire di Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100344,
					"content": "I più grandi sanno già che servo la Tsaritsa, ma Teucer è ancora così giovane e per lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100345,
					"content": "Ehm... come dicevo... sono sempre il più grande venditore di giocattoli di Snezhnaya, attualmente assegnato alla filiale di Liyue del nostro Istituto di ricerca sui giocattoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100346,
					"content": "Esatto! Mio fratello è il numero uno! È il miglior amico del signor Ciclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Per favore, mi fareste la cortesia di reggermi il gioco con Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100348,
					"content": "Ah, sì, Ekaterina. Mi occuperò subito di quel pagamento in sospeso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100349,
					"content": "Ehi, che fai, te la svigni così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Ma, nobile Principe, non sarebbe inappropriato chiederle di occuparsi di... recupero crediti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "Una scommessa è una scommessa, no? E se si perde una scommessa con un Agente... beh, tanto vale approfittarne per un po' di esercizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100352,
					"content": "Stai uscendo a vendere dei giocattoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "Proprio così! Per quanto mi piacerebbe passare un po' più di tempo insieme, Teucer, il dovere chiama! Sono sicuro, però, che questa brava gente sarà felice di tenerti compagnia mentre sono fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100354,
					"content": "#Ugh, quindi dobbiamo continuare a fare {M#i}{F#le} babysitter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "#Sììì! Mi piacete un sacco! E comunque avete promesso col mignolo che vi sareste pres{M#i}{F#e} cura di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "Oh, beh... Teucer si trova molto bene con voi, e se avete promesso col mignolo non potete certo tirarvi indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100357,
					"content": "(Eccoli che si coalizzano contro di me...) Ok, va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Allora sono in debito con voi. Ecco, tenete questo come... fondo divertimento per Teucer. Voglio che se la spassi mentre è a Liyue, quindi portatelo dove vuole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100360,
					"content": "Se c'è bisogno, mi trovate al fiume vicino al <color=#00E1FFFF>Lago Qingxu</color>. Ci vediamo in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110100358,
					"content": "Ok, lo faremo... per Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Beh, la preoccupazione per il benessere della tua famiglia posso capirla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "Quando vuoi, basta dirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Certo che hai una bella faccia tosta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "Teucer è il fratello del Principe?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
