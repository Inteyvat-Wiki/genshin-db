			"dialogs": [
				{
					"id": 120480101,
					"content": "Salve, chiedo scusa! Prego, venite qui a registrarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120480102,
					"content": "Che sta succedendo? Che sono tutti questi clienti? A saperlo, ne avrei mandato a casa qualcuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120480103,
					"content": "Woah! Senza più Emura Ichigensai, pare che siano tornati in carreggiata! Ed è bello vedere che Murasaki e Shion si stanno già riprendendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480104,
					"content": "#Buongiorno, {NICKNAME} e Paimon. Siete qui per prendere un appuntamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480105,
					"content": "Sì, grazie! Possibilmente per oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480106,
					"content": "#Allora è meglio che vi procuri un altro pass VIP. Siete {F#le nostre}{M#i nostri} clienti più importanti, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480107,
					"content": "Hihi, perfetto! Allora, stavolta la Paimon VIP vuole provare per prima cosa la ristorazione d'alta classe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480108,
					"content": "Oh, cielo... Immagina se avessi seguito il mio consiglio dell'altro giorno e avessi già venduto le tue azioni. Ti sarebbero costate un patrimonio, ora che l'attività è di nuovo esplosa. Spero che tu non ce l'abbia con me, vecchia mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480109,
					"content": "Perché mai dovrei? Non ti avevo neanche presa sul serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480110,
					"content": "Ah, mi mancava parlare con te. Sei sempre così cordiale e affettuosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480111,
					"content": "Guarda che non muore nessuno se la smetti di comparire sempre dal nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480112,
					"content": "#Buongiorno, {F#piccole}{M#piccoli}! Vi siete {F#godute}{M#goduti} il panorama, ieri sera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480113,
					"content": "Cosa? Ci stavi... spiando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Per nulla. Ma quell'albero era proprio sotto al Gran Santuario di Narukami. Non potevo di certo spostare il santuario per darvi un po' di privacy, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480115,
					"content": "A cosa dobbiamo la tua presenza, Lady Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480116,
					"content": "Eheh... In verità, ero venuta solo a fare due passi; ma si dà il caso che abbia un messaggio da parte della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480117,
					"content": "L'individuo che le tue compagne yumekui-baku hanno ripescato dall'acqua ieri sera non è più in condizioni critiche. Di contro, la sua mente sembra essere regredita a quando era un ragazzino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480118,
					"content": "Beh, ci è andata di lusso... Lady Guuji, ti sono grata. Senza il tuo aiuto, le cose avrebbero potuto mettersi molto peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480119,
					"content": "Mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480120,
					"content": "Io non ho detto niente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Andiamo, Miko. Sei sempre stata peggio di me a mantenere i segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480122,
					"content": "Ammetto di sentirmi inferiore a te e di avere il bisogno di dimostrare il mio valore. Puoi forse darmi torto? Ma forse questi sentimenti sono ciò che mi hanno spinta a portare così lontano quest'attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480123,
					"content": "Il mio complesso d'inferiorità tiene a bada il mio ego, e il mio desiderio di mettermi alla prova mi dà la forza per perseverare. Sono in grado di accettare questi lati di me per quello che sono, non serve che tu ricorra a espedienti del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480124,
					"content": "#*sospira* Potevi dirmelo prima... Ho costretto {F#la povera}{M#il povero} {NICKNAME} a scapicollarsi al posto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480125,
					"content": "#Questo è vero ma, d'altronde, senza l'aiuto di {NICKNAME} ti saresti trovata in una posizione scomoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480126,
					"content": "Emura Ichigensai aveva raccolto un numero impressionante di proseliti. Per la Guuji del Gran Santuario di Narukami, affrontare pubblicamente un personaggio del genere sarebbe stata una mossa pericolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480127,
					"content": "Un simile branco di fanatici avrebbe potuto danneggiare gravemente la reputazione del santuario... Meglio che la Guuji non sia intervenuta direttamente, è stata la decisione giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480128,
					"content": "Questo è vero, ma la mia preoccupazione principale era di non offendere una vecchia amica. Altrimenti, avrei potuto applicare un approccio decisamente più diretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480129,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480130,
					"content": "Dimentico sempre che sei più scaltra e meno adorabile di quel che sembra... Pare che i miei timori fossero del tutto infondati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480131,
					"content": "...Non fraintendere: non è che io non mi offenda. Ognuno ha i suoi problemi... ma per ogni pena esiste sempre una cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480132,
					"content": "Ecco il tuo nuovo pass VIP. Conservalo con cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
