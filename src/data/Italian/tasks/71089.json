				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, guarda cos'abbiamo trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "D'accordo, va bene, calmatevi. Cos'avete trovato? Ha a che fare con il luogo in cui si trova Zhiqiong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "È una sua lettera. Dice di essersi addentrata ancor più in profondità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "Grazie. Datemela un attimo per leggerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu legge la lettera con attenzione.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Caspita... Non pensavo che la situazione fosse così seria, quindi non posso biasimarla per questa sua scelta di vita. Ma forse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Forse non l'ho ringraziata per le sue scoperte quando avrei dovuto, o non le ho dato il rispetto e la comprensione che meritava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Senza le sue mappe, sarebbe stato incredibilmente più difficile portare a termine l'esplorazione... Eppure, invece di concentrarmi su quanto stesse lavorando sodo e sui suoi successi, non ho fatto che mostrarmi preoccupata per la sua salute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Uff, come ho fatto a non capire che il suo lavoro è sempre stato molto diverso rispetto a quello di noi minatori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Non vuole essere dimenticata, tutto qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Beh, è il desiderio di chiunque non sia un prediletto degli dèi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Lo desideriamo tutti... Ma nessuno era ossessionato quanto lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Eppure, quando ricordo il momento in cui ho rinunciato al voler diventare importante... e mi accorgo di essermi abituata alla vita quotidiana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Sento di non avere alcun diritto di giudicare Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}