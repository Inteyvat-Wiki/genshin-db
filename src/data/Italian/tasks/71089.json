					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Wow, che lettera lunga! Sembra che l'abbia lasciata qui Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "Sì, è sua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Uff, ma che fine avrà fatto?! Prima di tutto, andiamo a riferire a Jinwu cos'è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
