				{
					"id": 4861003,
					"content": "Mi hanno informato delle condizioni di salute di Jean. A nome di tutti i Cavalieri di Favonius, lasciate che io esprima la mia sincera gratitudine per il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "Così cortese ed educato. Questo non è il Kaeya che Paimon conosce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Ahah... Beh, sono le circostanze a richiederlo. Stiamo parlando della Gran Maestra Reggente in persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Ora, oltre al succitato ringraziamento, ci sarebbe ancora un'altra cosuccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "Hai un incarico per noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Mi hai letto nel pensiero! Ci intendiamo proprio bene noi due, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Siamo arrivati al momento in cui ci dai la nostra ricompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Ahahah! Devo dire che il tuo umorismo mi piace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "Ma prima di parlare di ricompense, spero che possiate assistere i Cavalieri in alcune faccende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Tipo aiutarti con gli oneri di Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Esatto. Benché gli incarichi che avete segnalato a Jean siano già stati affidati a qualcun altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "...temo che non saranno portati a termine con la cura necessaria, senza il tocco di Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "Pertanto, spero che possiate metterci del vostro, nei casi che riterrete opportuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "#Mi sentirei più tranquillo se sapessi che {F#la}{M#il} Cavaliere Onorari{F#a}{M#o} sta supervisionando personalmente questi casi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#Invece di fare il leccapiedi con {NICKNAME}, rispondi a questa domanda di Paimon: perché non lo fai TU?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Ahah! Oh, io ho questioni ben più importanti da seguire. Ci sono talmente tante cose... da preparare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "Bah, d'accordo. Quindi vuoi che diamo una mano con le richieste di <color=#00E1FFFF>Sara, Charles e Margaret</color>, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Esatto. Vi ringrazio per l'aiuto. A dopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
