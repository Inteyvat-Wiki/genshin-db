						4860812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860812,
					"content": "#...Comunque sia, tu sei {F#una}{M#un} Cavaliere Onorari{F#a}{M#o}, giusto {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860813
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860813,
					"content": "Quando la maestra è fuori servizio, dovrebbero essere i cavalieri ad aiutarla, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860814
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860814,
					"content": "Hai ragione, ma... Non sarebbe meglio che se ne occupasse qualcuno di più qualificato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860815,
					"content": "Jean ha tantissime cose da fare, una mano in più torna sempre utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860816,
					"content": "Fareste meglio a presentarvi al <color=#00E1FFFF>quartier generale</color>. Mi prenderò io cura di Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860817
					],
					"speakerTitle": "Barbara"
				},
