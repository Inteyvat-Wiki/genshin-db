					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860318
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860318,
					"content": "Anche se... dubito che la Gran Maestra Reggente abbia del tempo da perdere per una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860319
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860319,
					"content": "A me sembra solo una scusa patetica per non offrirle neanche una bevanda...",
