						4860806
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860806,
					"content": "Questa non è la prima volta che le succede una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860807
					],
					"speakerTitle": "Barbara"
				},
