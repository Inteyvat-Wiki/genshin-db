					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860513
					]
				},
				{
					"id": 4860513,
					"content": "#Ooh, {NICKNAME}, come sei dolce. Ma abbiamo qualcos'altro di cui dobbiamo occuparci, ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Anche Sara e Charles hanno bisogno del nostro aiuto, e subito! Andiamo prima da Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "State andando da Jean? Che coincidenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Paimon pensava che tu stessi cercando un gatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860517,
					"content": "Sì, volevo vedere se Jean potesse aiutarmi a cercare il mio gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860518,
					"content": "Dici sul serio? Vorresti che Jean... ti aiutasse a cercare il gatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860519,
					"content": "Cosa c'è di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860520
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860520,
					"content": "Jean è una bravissima persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860521
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860521,
					"content": "Il tuo ragionamento non fa una piega...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860522
					]
				},
				{
					"id": 4860522,
					"content": "Penso che la frase \"a esser troppo buoni, la gente se ne approfitta\" calzi a pennello in questa situazione.",
