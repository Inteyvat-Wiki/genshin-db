			"dialogs": [
				{
					"id": 710501401,
					"content": "Veniamo all'argomento importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Negli ultimi giorni mi hai fatto un favore enorme. Non so davvero come ripagarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Considerata la nostra piacevole collaborazione finora, ripagarti in Mora non sarebbe sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Beh, se insisti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "#Sii seri{F#a}{M#o}! Potrei mai essere così rozzo da umiliarti con del banalissimo oro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Non sarebbe forse un insulto nei tuoi confronti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Tieni, prendi questa lettera. Se ti troverai mai nei guai o avrai bisogno di aiuto nel tuo futuro percorso a Sumeru, portala alla Casa di Purbiruni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Faremo ogni sforzo per aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "\"I contatti sono più preziosi dell'oro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501410,
					"content": "Questo detto di Sumeru è alquanto vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		}
