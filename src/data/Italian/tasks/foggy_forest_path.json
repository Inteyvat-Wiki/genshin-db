			"dialogs": [
				{
					"id": 740820901,
					"content": "Sull'altare appare una perla d'acqua luccicante.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820902
					]
				},
				{
					"id": 740820902,
					"content": "Fantastico! Ora abbiamo anche la terza chiave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820903,
					"content": "Chiave, chiave, chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820904
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820904,
					"content": "Scomparsa, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820905
					]
				},
				{
					"id": 740820905,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Chiave, chiave, chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820906
					],
