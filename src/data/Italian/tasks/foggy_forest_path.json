			"dialogs": [
				{
					"id": 740820101,
					"content": "(Gran parte dell'iscrizione è stata cancellata, ma alcune parole sono ancora leggibili: \"...limpida rugiada... canta lungo il sentiero della Foresta nebbiosa)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Stele di pietra incisa"
				},
				{
					"id": 740820102,
					"content": "Woah! Hanno cancellato tante parole! Si direbbe che sia la descrizione dell'attrazione, vero? Bah, alcuni turisti sono davvero sconsiderati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Di solito i turisti si limitano a scrivere, non si mettono a cancellare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Uhm... È vero, cose come \"{NICKNAME} e Paimon sono stat{F#e}{M#i} qui\" e messaggi simili... Noi no, però! Siamo persone educate e non faremmo mai una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Comunque sia, è strano, vero? Perché cancellare gran parte del testo e lasciare solo alcune parole...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Anche questa frase è piena di cancellature! Paimon scommette che non sono riusciti a togliere tutto! Caro sentiero della Foresta nebbiosa, ti è andata bene. L'hai scampata per un pelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Cosa sarà questo sentiero della Foresta nebbiosa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Uhm... Vuol dire che i sentieri della foresta sono super nebbiosissimi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Paimon vorrebbe dare un'occhiata! Sembra proprio una di quelle situazioni che porta a un tesoro nascosto, vero? Almeno, nei libri succede sempre così, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "E in quale bancarella li avresti trovati questi libri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Ehi! Paimon non pensa solo a mangiare tutto il giorno! Paimon ha un forte presentimento che il sentiero della Foresta nebbiosa nasconda un tesoro. Ecco perché hanno cancellato ogni indizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#Ma non preoccuparti, {NICKNAME}! È il momento di iniziare una caccia al tesoro con Paimon, la tua migliore amica dal fiuto eccezionale per i tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "E in quale biblioteca li avresti trovati questi libri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
