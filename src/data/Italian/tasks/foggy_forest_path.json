			"dialogs": [
				{
					"id": 740820401,
					"content": "(Gran parte dell'iscrizione è stata cancellata, ma qualche parola è ancora leggibile: \"...limpida rugiada... tre...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Altare misterioso"
				},
				{
					"id": 740820402,
					"content": "Ah! Anche qui il testo è stato cancellato! Qualcuno vuole nascondere qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "\"Limpida rugiada\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Cosa sarebbe questa limpida riguada? Della rugiada cristallina? Ma qui c'è acqua dappertutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Quanto a \"tre\", indica forse tre gocce d'acqua? Uffa, che roba complicata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Forza, Paimon, affidati al tuo fiuto eccezionale per i tesori!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Paimon l'ha già fatto! C-Comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Comunque sia, dice che la risposta è legata a quel \"tre\" e all'acqua, quindi andiamo a dare un'occhiata in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Tre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Che indichi tre cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "E per quanto riguarda la limpida rugiada, sarà forse la rugiada cristallina? Ma qui c'è acqua dappertutto! Uffa, che roba complicata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
