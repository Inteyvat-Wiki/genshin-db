				]
			},
			"dialogs": [
				{
					"id": 740820701,
					"content": "Sull'altare appare una perla d'acqua luccicante.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Ah, quella goccia d'acqua... Non è quello il tesoro, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "Non ha l'aspetto di un tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "Proprio quello che pensava Paimon. Non può essere così facile. Ma allora cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "Forse è la chiave per tenere prigioniero il Re demone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "Cosa? Ma sarebbe una catastrofe! Presto, rimettila a posto. Paimon spera che non sia troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "Oh, no! È il Re demone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "Re demone? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "Fiuuu... Hai fatto venire a Paimon uno spavento... Una Melusina, eh? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "Chiave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "Chiave? Quale chiave? Questa goccia d'acqua è una chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "Ehm... Questa goccia d'acqua sarebbe Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "Ehm, cosa vuoi dire? Che questa goccia d'acqua sarebbe una Melusina? A Paimon comincia a girare la testa. Cosa cavoletti sta succedendo? Ma non sei tu la Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "Ehm... Sei una Pahsiv...? Oppure, ti chiami Pahsiv? No, no, aspetta... Non rispondere, altrimenti Paimon starà ancora peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "In ogni caso, Paimon ha deciso che ti chiamerà Pahsiv. Va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... Cosa facciamo? Paimon non capisce nulla di ciò che dice. Cosa starà cercando di comunicarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "Riesci a capire quello che diciamo, non è vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "Questa goccia d'acqua è una chiave, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "Non sei un essere umano, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "Ehm... Moderiamo le parole, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "Non sono un essere umano, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "M-Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "Ah! Aspetta! Paimon crede di avere capito. \"Pahsiv\" vuole dire \"sì\" e \"Melusina\" \"no\". Può essere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "Allora non ti chiami Pahsiv. Scusa, ma Paimon prima non ha capito il tuo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv... piace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "Ti piace questo nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#Meraviglioso! Allora è così che ti chiamerà Paimon, eheh. Quest{F#a}{M#o} è {NICKNAME}. È un piacere conoscerti, Pahsiv. Paimon non ha mai incontrato una Melusina come te prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Érinnyes... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "Érinnyes non va bene? Oppure... ehm",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "C'è qualcosa che non va con Érinnyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Érinnyes... Melusina, ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv, Érinnyes, proteggere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "Quindi sta accadendo qualcosa di brutto a Érinnyes e vuoi proteggerla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon, {NICKNAME}, Érinnyes, bum, sbam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#Ehm... Bene, siamo arrivati a ben cinque parole. Allora, vuoi che Paimon e {NICKNAME} prendano a pugni Érinnyes? Proprio BUM, SBAM?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "Vuoi il nostro aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "OK, vuole che la aiutiamo. Benissimo. Paimon però non ha alcuna idea di come prendere a pugni Érinnyes... è letteralmente un'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "Bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "Riceveremo una ricompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Ricom... pensa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#Ma che dici, {NICKNAME}! Pahsiv riesce a malapena a parlare! Non riuscirà a trovare nessun altro che la aiuti, quindi dobbiamo farlo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "Cosa dobbiamo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Chiave, chiave, chiave, numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "E poi? A quante chiavi siamo in tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "Chiave! Chiave! Chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "Tre chiavi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! Chiave, via nebbiosa, sud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "Chiave, sorgente, nord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "Chiave, salice, est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "Ah, ecco cosa vuoi dire... Meglio prendere subito appunti. Ci sono in tutto tre chiavi. Una è nella strada nebbiosa verso sud, una nei pressi della sorgente a nord e una vicino ai salici a est... Paimon ha capito bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "Chiave, chiave, chiave, piazza, ovest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "Ci sono anche tre chiavi nella piazza verso ovest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "Dobbiamo trovare le tre chiavi e poi raggiungere la piazza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon, Melusina! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#Ehi, Pahsiv, ma devi sempre fare in modo che {NICKNAME} sembri più intelligente di Paimon? Siamo chiaramente più o meno alla pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "Comunque sia, abbiamo già una chiave, quindi non ci rimane che prendere le altre due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Érinnyes, Melusina... Pahsiv, proteggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "Rilassati. Paimon non sa cosa sia successo, ma ti aiuteremo sicuramente a proteggere Érinnyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "In più, Pahsiv, se lo permetti, Paimon vorrebbe aggiungere una piccola precisazione: se per caso ti capitasse di trovare oggetti luccicanti e tondi, per te poco interessanti, oppure un baule dall'aspetto costoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "Beh, sarebbe fantastico se ce lo facessi sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Nel cercare di capire, Pahsiv si gratta un po' la testa, dopodiché fa altri due salti di gioia e se ne va in tutta fretta.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Ah, è scappata via. Avrà sicuramente qualcosa di molto urgente da fare. {NICKNAME}, andiamo alla ricerca delle altre due chiavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "Cosa dobbiamo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Forse l'ha messa qui qualcuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "#Cosa? Oh no, allora questo ci rende {F#delle}{M#dei} ladr{F#e}{M#i}. Oh, Paimon è dispiaciuta... Presto, rimettiamola a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "Oh no! È tornato il padrone di casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "Padrone di casa? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
		},
