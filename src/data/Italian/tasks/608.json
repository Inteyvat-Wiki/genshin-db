			"dialogs": [
				{
					"id": 6080101,
					"content": "Fiuu, è passato un po' da quando ho scatenato i miei fulmini durante il Festival del Florvento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "Succedeva spesso, in passato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "Scatenare i fulmini sulla gente? Ahah, no, assolutamente. Tranne una volta o due. È una gran bella sensazione potersi sfogare così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Ahah, qualche giorno fa ho giusto ricevuto una lettera in proposito da parte del mio vecchio insegnante. Ovviamente, mi sono premurata di specificare che \"tratto sempre tutti col massimo della gentilezza\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "In fondo, è più che naturale per un allievo ereditare i metodi del proprio insegnante. E il mio era un amabile vecchietto della Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "Vedi, dunque? Questa volta, ho usato solo i metodi di elettrocuzione più gentili che conosco. Talmente gentili da non richiedere nemmeno l'intervento di Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "Ah... Elettrocuzione gentile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "Sembri essere di buon umore, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Ah, beh, è bello cambiare aria una volta tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
