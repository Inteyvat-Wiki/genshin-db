					}
				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "...La spada è integra? Ma non riesco a percepire lo Spirito del lupo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(...A quanto pare non mi trovo più nella realtà. Questo dev'essere uno spazio creato dalle coscienze intrecciate di Boreas e Roland.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Non posso tornare indietro, e ciò che mi attende sono le fauci del lupo... Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Ah, immagino che l'unico modo sia andare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
