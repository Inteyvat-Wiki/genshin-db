					},
					{
						"sceneId": 3,
						"position": [
							1901.932,
							200.526,
							-1275.205
						],
						"pointId": 15700
					},
					{
						"sceneId": 3,
						"position": [
							1902.579,
							200.345,
							-1275.58
						],
						"pointId": 15701
					}
				]
			},
			"dialogs": [
				{
					"id": 160111201,
					"content": "Ahhh... Era da un po' che non sentivo questo vento sul viso... È proprio come lo ricordavo. Allora, c'è qualcosa di cui vorresti parlare? È la tua occasione, prima che mi trascinino in ufficio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111202,
						160111215,
						160111219,
						160111231
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111202,
					"content": "A proposito del tuo piano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111203
					]
				},
				{
					"id": 160111203,
					"content": "La spada era solo un diversivo... La sua anima la portavo nel mio cuore... Era il piano di cui ero più sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111204,
					"content": "Ma per quanto riguarda la seconda parte... Cioè usare i pensieri di tutti per guidarmi fuori dalle linee geomantiche... Non ero molto sicuro che avrebbe funzionato, ahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111205,
					"content": "#Scherzi a parte, cos'avresti fatto se {NICKNAME} non fosse {F#riuscita}{M#riuscito} a separare lo Spirito del lupo dall'influenza di Roland?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111206,
					"content": "#Mmm... Inizialmente avevo intenzione di far compiere quel passo a Barbatos. Ma quando l'ho interpellato al riguardo, mi ha detto che c'era {F#una}{M#un} {F#candidata}{M#candidato} ben più {F#adatta}{M#adatto}... {F#La}{M#Lo} {F#straniera}{M#straniero} che catturò il vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111207,
					"content": "#A quanto pare, la nostra fiducia era ben riposta. Grazie, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111208,
					"content": "E se avessi fallito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "Allora... Immagino che avremmo dovuto chiedere a Barbatos di mandare un vento capace di riportarmi a casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111210,
					"content": "...Ma avrebbe avuto un prezzo molto alto, e senza alcuna garanzia di successo. E poi, preferirei che non usasse quel tipo di potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111211,
					"content": "...Invocare il potere di un Archon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "Mm, bella domanda... Magari un bicchiere del miglior vino di denti di leone? Dovrei sicuramente pagarlo con la riserva segreta di Mora che tengo in ufficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111214,
					"content": "Sei fuori come un balcone se pensi che sarebbe costato così poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111212,
					"content": "...Di che prezzo stiamo parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "A proposito della spedizione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "Beh, ora che l'ombra di Roland è stata sconfitta, la Caccia selvaggia non sarà in grado di consolidare le proprie forze per il prossimo futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111217,
					"content": "Alcuni Cavalieri resteranno di stanza alla roccaforte di Nod-Krai a turno, ma tutti gli altri saranno mandati a casa a scaglioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111218,
					"content": "Albedo e Durin partiranno con il primo scaglione, quindi avrete presto modo di rivederli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111219,
					"content": "A proposito del tuo futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "Il mio futuro, eh... Potresti averlo già saputo da Barbatos o dall'Hexenzirkel, ma ho intravisto un riflesso del futuro nell'astrolabio di Barbeloth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111221,
					"content": "Hai visto una calamità dell'Abisso a nord, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "Esatto. Tuttavia, per come stanno le cose ora... credo che potremmo aver cambiato il corso del futuro, e in gran parte grazie a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111223,
					"content": "Comunque, dopo aver sistemato alcune questioni in sospeso con i Cavalieri di Favonius, dovrò fare un altro viaggio a nord... C'è ancora molto lavoro da sbrigare alla roccaforte di Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111224,
					"content": "E poi, il primo gruppo di Cavalieri che si sono offerti volontari per rimanere lì non ha ancora ricevuto il cambio. Come potrei abbandonarli così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111225,
					"content": "Oh, che animo nobile... Ma sii onesto, la vera ragione per cui torni a Nod-Krai è per poter di nuovo scaricare tutto il tuo lavoro su Jean, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111227,
					"content": "Un momento... Sul serio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111228,
					"content": "Non hai niente da dire in tua difesa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "Ahah, vi sto solo prendendo in giro. D'ora in poi mi vedrete molto più spesso a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111229,
					"content": "Non startene lì a ghignare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "Non ho altre domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "Va bene, allora. Resterò qui ancora un po' a godermi la brezza... Anche con tutto il vino del mondo, non c'è niente di più inebriante del vento della propria terra dopo tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
