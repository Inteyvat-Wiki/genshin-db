			"dialogs": [
				{
					"id": 160111101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "...Vai avanti, e non guardarti indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "\"Varka... Ora conosco significato di mio nome.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "\"...E dopo tutto quello che abbiamo fatto per lei, farà meglio a ringraziarci come si deve, quando tornerà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "\"Sa, avrei un sacco di cose da dirle... Ma tutto ciò può aspettare fino al suo ritorno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "\"Non ho alcuna intenzione di tornare dai Cavalieri di Favonius... Ma confido che troverai un modo per cavartela.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "\"...Gran Maestro, la stiamo tutti aspettando.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Mmm? Oh... Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Non... me la sto cavando poi così male come Gran Maestro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "Eheh... Prenderò questo silenzio come un segno della vostra approvazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Tutto ciò che avete giurato di proteggere con la vostra vita... è ancora qui, sano e salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "I Cavalieri di Favonius, Mondstadt... E il giuramento prestato da ogni Cavaliere. Li proteggerò a costo della mia vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Perciò... consegnerò quella lettera per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "...So che non è che un'ombra del vero Roland, ma... Se hai tempo, potresti leggergliela, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam e Arundolyn... non ti hanno mai dimenticato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Uff... È stata una spedizione davvero lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "D'ora in poi, credo che seguirò il consiglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "...Lasciati guidare dal vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "...Salve a tutti. Ne è passato di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Sono... entusiasta di rivedervi tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Bentornato, Gran Maestro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "Già. Sono a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111124,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
