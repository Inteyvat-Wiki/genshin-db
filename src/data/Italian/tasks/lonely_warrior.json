				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "Questo è... il cuore del lupo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "...! Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "...Farò come desideri, Cavaliere di Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Uh... Non sei esattamente come t'immaginavo. Non sembri neanche lontanamente folle come nei ricordi presenti nello Spirito del lupo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Io non ho mai deviato dal sentiero della rettitudine. Ma quando ti guardo... non vedo un eroe in grado di uccidere i draghi. Solo un'anima perduta che ha vagato fin troppo a lungo. L'ombra del Cavaliere che eri un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Suppongo che almeno in questo siamo simili. Nessuno di noi due è al massimo della forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Le forze del Vindice di Solnari sono state sconfitte, e il Roland che vedi non è che un'immagine imperfetta proiettata dall'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Detengo lo stesso potere che Roland aveva al suo apice, ma il mio cuore e la mia mente restano congelati in quel momento insanguinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Pertanto, nella mia forma attuale sono imperfetto... Un Cavaliere non può tollerare la propria stagnazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Dopo averti riscattato dall'ingiustizia e aver guidato la tua resa all'Abisso, sanerò me stesso e continuerò a seguire la via del Cavaliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Ah! Il mondo là fuori non può più sopportare il tuo tormento. La tua ossessione, chiaramente, è rimasta esattamente come l'avevo immaginata. Suppongo non ci sia alcuna possibilità di farti vedere la luce, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Nessuna parola può far dubitare un Cavaliere delle sue convinzioni, per quanto nobili possano sembrare. Nessuno di noi due farà cambiare idea all'altro... Ma tu questa verità la conosci da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Altrimenti, perché riporre tutte le tue speranze in un singolo pensiero di Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Ma ora la lama che un tempo ospitava lo Spirito del lupo è andata in frantumi, e tutto ciò che hai è un'illusione che ne porta la forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Non hai più modo di cambiare la situazione, e nessuno verrà in tuo soccorso... Questo luogo sarà la tua tomba, guerriero solitario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Mm, forse non hai tutti i torti... Ma credo di avere una possibilità di salvarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "...Cosa vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "C'è solo una persona a cui devo far cambiare idea, e non sei tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Ti sei forse dimenticato dove siamo? Questo è il cuore di Andrius, il Dio del Vento del Nord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Andrius! Riesci a sentirmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Svegliati! Sei il grande Dio del Vento del Nord! Per quanto tempo ancora ti lascerai dominare dall'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "...Se questa è la tua ultima mossa, sono profondamente deluso, Cavaliere di Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Le grandi manifestazioni di desideri sinceri non possono evocare miracoli. Questo mondo non mostra una tale pietà per i suoi abitanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "...Tornare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "...Tornare... alle... linee geomantiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "...Questa è la mia scelta... I miei ricordi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "...È questa la risposta che ho trovato... alla fine del mio viaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Boreas}rius... Finalmente ho riportato il pegno nel tuo cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Eh... Un Cavaliere di Boreas? Continua a guardare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "...Questo è tutto ciò che un lu{RUBY#[S]io}po può sperare di fare per l'uma{RUBY#[S]voi}nità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "...A nome di tutta l'umanità, ti ringrazio, Signore dei lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas... sta tornando alle linee geomantiche? Ma perché? La tua spada è spezzata... Non hai più modo di accogliere la sua anima... A meno che... No, non può essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Implorare un miracolo è un'impresa futile. Ne so qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "...Ma una spada è solo un tipo di ricettacolo. Esistono altri modi per custodire un'anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Un tempo, il Signore dei lupi conferì il potere della sua anima al suo branco, rinvigorendone i cuori e affilandone zanne e artigli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "...Anche se non è mia intenzione, l'anima di Lupus Boreas finirà inevitabilmente per devastare, divorare e assimilare un cuore mortale... Come se un umano e un lupo venissero uniti forzatamente in un unico essere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "...Se un cuore mortale deve accogliere l'anima di un dio... Questo è un sentiero senza ritorno. Eppure, non dissuaderò un Cavaliere dall'intraprendere la missione che ha scelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "Il Condottiero"
				},
				{
					"id": 160110939,
					"content": "Il tuo cuore, la tua anima... stanno collassando? Ah... Ora capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Ti stavi chiedendo come un agnello potesse domare il cuore di un lupo... Non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Ecco la mia risposta: fai in modo che il lupo inghiottisca il cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "Lo Spirito del lupo nella spada era solo un'esca... I pensieri e i ricordi veri erano custoditi nel tuo cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Per non destare i miei sospetti, hai permesso all'anima di Lupus Boreas di assimilare la tua, per poi essere divorata da me... Ma... come hai trovato la forza di combattere sopportando un fardello simile...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "In confronto alla decisione di Lupus Boreas... il mio sacrificio non è niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Possiedi una volontà ostinata e hai impiegato una strategia eccezionale... Ma non è così che combatte un vero Cavaliere. La scelta che hai fatto è sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "La tua anima ora è fusa con quella di Andrius. Quando si unirà completamente alle linee geomantiche, anche tu farai la stessa fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "#Né Barbatos né {F#la viaggiatrice}{M#il viaggiatore} saranno in grado di ancorare la tua anima dall'interno delle linee geomantiche, figuriamoci di salvarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Tu hai perso, così come me. Purtroppo non posso più offrirti la salvezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "...Che la tua anima possa riposare in pace con Boreas, guerriero solitario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "...Ahah, solitario...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Mi dispiace deluderti, ma... Per quanto sembrasse il finale perfetto, tornare entrambi alle linee geomantiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Il fatto è che, a differenza del vero Roland del passato, io ho ancora del buon vino e dei cari amici da cui tornare. Stanno aspettando con ansia il mio ritorno trionfale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Perciò non sono ancora pronto ad accettare il mio destino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ding-dong! C'è posta per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
			"completionStepIds": [
				1601111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
