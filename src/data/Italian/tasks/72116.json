			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Ci vorrà ancora un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Hai raccolto tutti i dati necessari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Oh, eccoti qua! Splendido. Non abbiamo ancora tutti i dati che ci servono. Credo che ci occorra ancora un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Detto questo, ho colto l'occasione per riflettere sulla struttura del purificatore d'emergenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "Sarebbe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Si tratta di un piccolo asso che ho appena tirato fuori dalla mia manica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "In linea con quanto abbiamo discusso prima, dobbiamo risolvere allo stesso tempo un duplice problema: i Fatui e il Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Poiché sono certo che sarai in grado di sconfiggere i Fatui, io mi occuperò dell'energia del Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Il purificatore d'emergenza è un dispositivo che avevo fatto costruire appositamente a tale scopo. Tuttavia, ho bisogno del tuo aiuto per completarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "Cosa dovrei fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Per far sì che il dispositivo funzioni perfettamente all'interno della Fornace Mikage, ci serviranno dei materiali speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "Il candidato ideale per questo scopo è il Midollo cristallino, in quanto contiene una forma inerte di energia del Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "In verità, il segreto del famoso Acciaio di giada è che questo viene rinforzato proprio con l'aggiunta di Midollo cristallino, tramite un metodo speciale durante la forgiatura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Come potrai intuire, tale metodo speciale è un segreto commerciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Se ricordo bene, è possibile trovare questo minerale cristallino nelle vicinanze. Potresti raccoglierne 3 pezzi, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Molto bene, ti ringrazio. Ricorda: 3 pezzi di Midollo cristallino. Torna da me non appena li avrai recuperati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "E io che mi aspettavo un nome molto più ufficiale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Perché? Il nome ufficiale è proprio quello: purificatore d'emergenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "A meno che... Ti riferivi forse a numero di serie e alla data di produzione ufficiali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Beh, poiché si tratta esclusivamente di un dispositivo d'emergenza, in questo caso non ce n'è bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Si tratta di un'altra \"misura di sicurezza\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Suppongo di sì, sebbene esiterei a fornire questa sorta di aiuto in una normale procedura di assistenza ai clienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
