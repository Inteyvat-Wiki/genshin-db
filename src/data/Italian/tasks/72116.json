			"dialogs": [
				{
					"id": 721160401,
					"content": "Ti sono davvero grato! Li userò per creare la struttura di base del nostro dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Ora dobbiamo solo aspettare che i sensori raccolgano dati a sufficienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Non appena li avremo alla mano, modificherò il dispositivo in base alle informazioni ottenute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Una volta pronto, metteremo fine a questo problema una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
