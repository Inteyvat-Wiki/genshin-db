			"dialogs": [
				{
					"id": 50280501,
					"content": "Le vite dei Discendenti sono più preziose di quanto tu possa immaginare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280502,
					"content": "Hai distrutto la speranza di questo mondo con le tue stesse mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280503,
					"content": "Se davvero sono destinata a fallire, di che cosa hai paura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280505,
					"content": "(Intraprendiamo un pellegrinaggio per i desideri del popolo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280506,
					"content": "(Abbiamo scelto di combattere per ottenere un nome glorioso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280507,
					"content": "(E alla fine, diventiamo cenere per un sogno.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280508,
					"content": "(E così questo ciclo è continuato, più e più volte...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				}
			]
