				"points": []
			},
			"dialogs": [
				{
					"id": 722420401,
					"content": "Wow! Paimon non immaginava che potesse esserci un posto così grande al di sotto dell'Isola di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "Sembra che il posto che dobbiamo raggiungere sia lì, al centro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Ok, {NICKNAME}, entriamo. Facciamo piano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Quelle rovine sembrano più vicine. Cominciamo da lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Se c'è un edificio, significa che ci sono delle persone... o perlomeno, ci sono state tempo fa. E dove ci sono le persone, ci saranno delle scritte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "E dove ci sono le scritte, ci saranno quei... suggerimenti che non riusciamo nemmeno a leggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
