			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Meng",
					"Maestro Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Eh? Neanche questi due minerali sono uguali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300102,
					"content": "Certo che no! La qualità e il prezzo di qualsiasi cosa venisse forgiata con uno di questi due tipi di minerali sarebbero totalmente differenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300103,
					"content": "Ehm, ma... Questo è tutto quello che ci è rimasto di questi due tipi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300104,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300105,
					"content": "Cosa state facendo qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Ciao, viaggiat{F#rice}{M#ore}! Sto aiutando papà a controllare le ferramenta che ha ordinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300107,
					"content": "Il signor fabbro è la persona migliore che abbia mai conosciuto! Ha detto che mi forgerà una piccola spada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300108,
					"content": "Ma ha anche detto che ultimamente non hanno abbastanza materie prime per tutto il negozio, quindi il carico di ferramenta ordinato da papà potrebbe subire un ritardo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300109,
					"content": "E non si sa nemmeno quando la mia spada sarà pronta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300110,
					"content": "*sospira* Beh, era inevitabile: ultimamente siamo stati molto impegnati, quindi abbiamo quasi esaurito le scorte di minerali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300111,
					"content": "Inoltre, le aree più ricche di minerali sono invase dai mostri, e mi rifiuto di andare a estrarli lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300112,
					"content": "L'unica cosa che posso fare per superare questo momento critico è chiedere a qualcuno di accompagnarmi in un'area dove possa estrarre dei minerali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300113,
					"content": "Ma dove troverò mai qualcuno del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300114,
					"content": "#A dire il vero... Viaggiat{F#rice}{M#ore}, ho sentito che te la cavi piuttosto bene con i mostri. È vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300115,
					"content": "Se è così, potresti aiutarmi? Per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300116,
					"content": "Ahah, va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#Viaggiat{F#rice}{M#ore}, stai andando a controllare la situazione laggiù? In tal caso, lascia che segni sulla tua mappa i luoghi dove vado di solito a estrarre minerali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300119,
					"content": "Bene, questo è tutto. Fai attenzione, mi raccomando. Quei posti pullulano di mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300120,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300117,
					"content": "Vedrò cosa posso fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
		{
