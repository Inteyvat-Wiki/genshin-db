					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "#Come stanno andando le cose, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300202,
					"content": "Per ora, quei posti dovrebbero essere al sicuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "Wow, fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300204,
					"content": "Papà ha detto che assumerà delle persone per proteggerci durante il viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300205,
					"content": "#Spero solo che siano brave persone come te, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300206,
					"content": "Signor fabbro, ciò significa che ora potrai di nuovo estrarre i minerali e fare gli oggetti in ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210300207,
					"content": "Ahah, certo! Dammi solo un attimo per prepararmi, prenderò quei minerali e tornerò in tempo per continuare il mio lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Maestro Zhang"
				},
				{
					"id": 210300208,
					"content": "Detto ciò, non posso trasportare tutti i minerali da solo. Per fortuna, quell'area dovrebbe essere stata ripulita dai mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro Zhang"
				}
			]
		},
