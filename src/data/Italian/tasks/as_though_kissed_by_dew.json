			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma",
					"Arataki Itto"
				],
				"points": [
					{
						"sceneId": 1202,
						"position": [
							-11.715,
							2.036,
							-12.211
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "Di fronte all'assillante insistenza di Itto, vi dirigete nuovamente verso le Terme Aisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Ahahah! Questa dev'essere la più calda di tutte! Vediamo chi riesce a resistere più a lungo! Chi ci sta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Eheh, come potrei rifiutare davanti a un tale entusiasmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Ma... questa non è una sauna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Ahhh... Che bel calduccio... *russa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "Ehi, non puoi addormentarti nella vasca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Ah... La mia pelliccia è così pesante. Mi gira quasi la testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Ahahah! Se non riesci a sopportare il caldo, Gorou, esci dalla... vasca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "Ehi! Smettetela di fare tutto questo chiasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "Dall'altra parte...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Eheh, Itto è pieno d'energia come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "Distrarsi durante una partita non è un bene, fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#Woah! Questa partita sta entrando nel vivo! Quale sarà la tua prossima mossa, {NICKNAME}? Cosa ne pensate, voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Mm... La prenderei con calma, cercando di consolidare il mio vantaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Oppure partirei all'attacco... Rischiare non è una cattiva idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Procedi con calma e con passo deciso)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "#Eh? Molto intelligente, {NICKNAME}! Una pesante sconfitta... Mi arrendo! Ora, in base al sorteggio casuale di prima, il prossimo giocatore dovrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "Ayaka! Divertitevi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#Oh, ehm... Va bene! Vacci piano con me, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato deve aver perso contro di me di proposito per dare ad Ayaka più tempo per giocare... Trama sempre qualcosa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(Parti all'attacco!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
