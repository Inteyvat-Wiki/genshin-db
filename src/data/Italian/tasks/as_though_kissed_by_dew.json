			"dialogs": [
				{
					"id": 401930301,
					"content": "Capo! Il Festival floreale di Mikawa è stato un grande successo per noi! Abbiamo ricevuto tre volte più visitatori del solito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "In base a quello che abbiamo fatto finora, credo che riusciremo a ricavare... tanto così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "È una notizia fantastica! Potremmo persino battere la Casa editrice Yae, questo mese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Eh? Sembri compiaciuta per qualcosa... Hai organizzato una festa senza di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh, eheh... Nulla di che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "Mi ero dimenticata di condividere con te una buona notizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Il trenta per cento dei proventi del festival è stato trasferito alla Casa editrice Yae. Questo mese ci aspettiamo dei guadagni record... Non pensi che le congratulazioni siano d'obbligo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "B-Beh, capo... Immagino che le congratulazioni SIANO d'obbligo... Questa è la trecentotrentatreesima volta che competiamo con la Casa editrice Yae in termini di vendite, ed è il nostro risultato migliore finora: il secondo posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "...Che questa sia una notte di bei sogni per tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
