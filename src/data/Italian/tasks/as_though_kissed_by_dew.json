						],
						"pointId": 322001353
					}
				]
			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "#Ah, compadre! Un uccellino mi ha detto che ieri sera sei {F#andata}{M#andato} alle Terme Aisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Sto radunando la ciurma, e andremo lì a festeggiare! Ci sei anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Ma è da poco che ci abbiamo fatto visita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Uh, sì... Ma scommetto che mancavano alcune persone, giusto? Come Shinobu... e Gorou... e, beh... Ayato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "In parole povere, il capo ha saputo della vostra gita e ora vuole andarci a tutti i costi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "A-A ogni modo! Quando avrai finito di andare in giro, vieni a trovarmi e ci divertiremo un botto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
