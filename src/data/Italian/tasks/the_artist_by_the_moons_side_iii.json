			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Eh? Maalaus? È andata di nuovo in cerca d'ispirazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Sì. Ma la piccolina è così da quando è tornata... È persa nei suoi pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600104,
					"content": "Ehm, forse il tema di quest'opera è super profondo... Sai, come quando un grande artista si rende conto di una verità fondamentale sul mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Ora che Paimon ci pensa, Maalaus ci ha dato un sacco di dipinti. Di questo passo, potremmo tenere una mostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hihi, Paimon non vede l'ora di dire a tutti dell'ascesa artistica della nostra piccola pittrice! Ah, ma prima avremo bisogno del permesso di Colombina, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Mmmh? Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600108,
					"content": "Beh, perché sono quasi tutti dipinti su di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh... Va bene, per me non è un problema. Sembra interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Oh, sembra che Maalaus abbia deciso cosa dipingere! Presto, vediamo che tipo di pittura abbiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Questa volta... Optiamo per colori profondi e tranquilli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
