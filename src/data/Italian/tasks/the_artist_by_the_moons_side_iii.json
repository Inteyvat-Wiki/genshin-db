				]
			},
			"dialogs": [
				{
					"id": 760600301,
					"content": "Ok, questi dovrebbero andare bene. Che ne pensi, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Sì, a Paimon sembra una Kuuhenki felice! Hihi, chissà che tipo di dipinto otterremo questa volta...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Oh, già finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus sembra un po' triste. È a causa del dipinto? Fai dare un'occhiata a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Ok, è Colombina... che fa una passeggiata sotto il chiaro di luna, mentre guarda il cielo notturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Ah... Devo star guardando la vera luna oltre il cielo falso. Ero solita fare camminate di quel tipo tutto il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600310,
					"content": "Eri solita...? Ah, giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Colombina è praticamente confinata in questo giardino, ora... Anche se Nod-Krai è il luogo dove è nata...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Sì, guardavo il cielo e mi chiedevo... Cosa c'è davvero sulla vera Luna gelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600313,
					"content": "Forse è come qui, ed è piena di animaletti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600314,
					"content": "O forse... Non c'è niente di niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600315,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Potresti portarne un po' con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ah... Un pensiero interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600318,
					"content": "Ma... poiché la luna è al di là del cielo falso, preferirei evitargli un'avventura di questo tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600322,
					"content": "(Una è una \"casa\" in cui non può muoversi liberamente... l'altra è una \"casa\" di cui non sa nulla...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Mancherai un sacco a Maalaus e alle altre Kuuhenki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Anche a me mancheranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600327,
					"content": "Ma, alla fin fine, è un viaggio che posso compiere solo io, e la risposta che troverò alla fine sarà solo mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600328,
					"content": "E chissà? Qualunque sia la risposta... Forse sarà qualcosa di bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600329,
					"content": "B-Beh... Allora dovremo venirti a trovare! Con Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Va bene. Potremmo organizzare quella mostra d'arte sulla luna, forse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600331,
					"content": "Sì, ottima idea! È una promessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600333,
					"content": "Lo spero, lo spero davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600319,
					"content": "Potrebbero esserci altre creature carine lassù...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Mmmh, lo spero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760600321,
					"content": "E spero che... Se così fosse, le creature accoglierebbero il ritorno improvviso e inaspettato della loro \"dea\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "La Damigella"
				}
			]
		},
