			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "Che cosa dovrei cucinare dopo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "#Oh, anche voi siete viaggiat{F#rici}{M#ori} di queste parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "No, siamo solo di passaggio. *annusa* Cosa stai cucinando? Che buon odorino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "#Capisco. Benvenut{F#e}{M#i}, viaggiat{F#rici}{M#ori}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "Sono Lynn, l'esperta di sopravvivenza della Gilda degli avventurieri. Come potete vedere, sto provando alcune nuove ricette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "\"Mangia prima di partire\": la prima regola del \"Manuale di sopravvivenza nella natura\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "Un picnic! Oh, Paimon adora i picnic!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "#Anche {F#la mia compagna}{M#il mio compagno} di viaggio qui presente sa cucinare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "So preparare solo alcuni piatti semplici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "Bene. Vediamo cosa sai fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "Non vi capiterà spesso di avere la possibilità di imparare da un'esperta di sopravvivenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "In quel barile laggiù ci sono dei funghi e della carne. Prova a prepararmi uno <color=#00E1FFFF>spiedino di pollo e funghi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "È vero, anch'io amo cucinare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "Oh, qui c'è un pentolone. Fammi vedere cosa sai fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "È bello avere qualcuno con cui esercitarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				}
			]
		},
