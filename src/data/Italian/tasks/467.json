				},
				{
					"id": 4670305,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670306
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670306,
					"content": "Ah... Oh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Il sapore è... difficile da descrivere. Appena accettabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#Cosa? {NICKNAME} può fare di meglio. Questo non conta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Hai un grande potenziale. Ti basterà solo esercitarti di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Ho delle materie prime nella borsa. Prendetele in cambio di questo pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Possiamo davvero prenderle? Non finirai gli ingredienti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Non c'è problema! Quando <color=#00E1FFFF>si va in esplorazione nella natura</color>, bisogna essere in grado di trovare un sacco di ingredienti. Non dimenticate di cercare attentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "A Mondstadt c'è anche un ristorante conosciuto come il <color=#00E1FFFF>Buon Cacciatore</color> che vende cibo e ingredienti. Date un'occhiata, quando avete tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Ok, grazie per le informazioni. *sussulta* Ehi! Lascia qualche spiedino di pollo e funghi per Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
