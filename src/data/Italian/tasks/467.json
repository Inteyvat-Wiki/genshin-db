						4671206
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671206,
					"content": "Ah... Oh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671207,
					"content": "È molto gustoso! Ci sai davvero fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671208
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671208,
					"content": "Paimon te l'aveva detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671209,
					"content": "Con le tue abilità culinarie, dovresti provare dei piatti più complessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671210,
					"content": "Ho delle materie prime nella borsa. Prendetele in cambio di questo pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671211,
					"content": "Possiamo davvero prenderle? Non finirai gli ingredienti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671212,
					"content": "Non c'è problema! Quando <color=#00E1FFFF>si va in esplorazione nella natura</color>, bisogna essere in grado di trovare un sacco di ingredienti. Non dimenticate di cercare attentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671213,
					"content": "A Mondstadt c'è anche un ristorante conosciuto come il <color=#00E1FFFF>Buon Cacciatore</color> che vende cibo e ingredienti. Date un'occhiata, quando avete tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671214,
					"content": "Ok, grazie per le informazioni. *sussulta* Ehi! Lascia qualche spiedino di pollo e funghi per Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
