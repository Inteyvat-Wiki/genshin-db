			"dialogs": [
				{
					"id": 752630501,
					"content": "La gara è finita! Che colpo di scena spettacolare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#E {F#la vincitrice}{M#il vincitore} finale è... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Porca miseria! {F#Quella ragazza è pazzesca}{M#Quel ragazzo è pazzesco}! È {F#riuscita}{M#riuscito} a sconfiggere persino \"Come viene viene\" e \"Come va va\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#È {F#stata}{M#stato} come un fulmine dorato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Oh, ma dai! Perché non parlate anche del \"lampo argentato\"? Possibile che nessuno si sia accorto di lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Una sconfitta su tutta la linea... Dubito che raggiungerò mai una velocità del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "\"Uragan Nanasso\""
				},
				{
					"id": 752630507,
					"content": "Non arrenderti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Io... ti considererò... un modello da seguire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "\"Uragan Nanasso\""
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "E ora, accetta il premio che abbiamo preparato per il campione. È più che meritato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "Il tuo nome resterà impresso per sempre negli annali del Torneo di velocità Dolcebrezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
