			"dialogs": [
				{
					"id": 752630301,
					"content": "Allucinante! Qualcuno ha davvero sconfitto \"Uragan Nanasso\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "#{F#La}{M#Lo} sfidante di oggi ha conquistato il titolo di campione con le sue incredibili mosse fulminee. {F#Facciamole}{M#Facciamogli} un bell'applauso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "Ho perso?! Non è possibile... Non può essere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "\"Uragan Nanasso\""
				},
				{
					"id": 752630304,
					"content": "#È {F#stata}{M#stato} incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Ma i nostri fan storici sanno bene che Uragan Nanasso non è il corridore più forte ad aver percorso questo tracciato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Prima di lui, la scena era dominata da due assolute leggende locali. E oggi... quelle leggende sono di nuovo tra noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Diamo il benvenuto a... \"Come viene viene\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "E a... \"Come va va\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#{F#Cara}{M#Caro} sfidante, loro due sono dei veri fuoriclasse. Anche considerando ciò che hai compiuto poc'anzi... batterli sarà pressoché impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "#Sei {F#pronta}{M#pronto}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "#Sono {F#pronta}{M#pronto}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Il personale prepara il tracciato e la folla si raduna per guardare. Ti posizioni sulla linea di partenza...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
