				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Avvisiamo i nostri ospiti che sta per avere inizio il Torneo di velocità Dolcebrezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Chiunque batterà il nostro campione in carica \"Uragan Nanasso\", vincitore per tre giorni consecutivi, riceverà il premio a sorpresa di oggi! Questa è l'ultima occasione per iscriversi al torneo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Umpf! Non c'è nessun altro che vuole sfidare il grande \"Uragan Nanasso\"? Ma come? Avete tutti troppa paura di perdere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*sospira* Nessuno è in grado di battere \"Uragan Nanasso\". Ha vinto il premio per tre giorni di fila! Nessuno può superarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Roooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Oh? Ci vuoi provare tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Umpf. Ci siamo abbassati ad accettare i Saurici, ora? E va bene! Fate venire tutte le bestiacce che volete, gli farò vedere cosa vuol dire \"andare veloce\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Questo torneo è davvero unico nel suo genere! I poderosi compagni Saurici saranno in grado di detronizzare il nostro tre volte vincitore \"Uragan Nanasso\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Vorrei iscrivermi anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "#Colpo di scena! {F#Una coraggiosa}{M#Un coraggioso} sfidante ha deciso di farsi avanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Eh? Credi davvero di poter competere con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "La sfida di oggi si preannuncia emozionante... Chi dei due riuscirà a trionfare? Scopriamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Il personale prepara il tracciato e la folla si raduna per guardare. Ti posizioni sulla linea di partenza...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
