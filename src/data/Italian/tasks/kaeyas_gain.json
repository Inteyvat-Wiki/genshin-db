					"content": "Non c'è alcun tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "Ci hai mentito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "Se non avessero sbandierato ai quattro venti le nostre <color=#00E1FFFF>informazioni false</color>, non avremmo mai catturato i Cacciatori di tesori.",
