			"dialogs": [
				{
					"id": 4630101,
					"content": "Queste devono essere le Rovine di Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630102,
					"content": "È solo una mia impressione, o sembra troppo... semplice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630103,
					"content": "Ah, Paimon ha capito! Il posto migliore per nascondere qualcosa è sempre in piena vista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630104,
					"content": "Il nonno di Kaeya di certo la sapeva lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630105,
					"content": "*scalpiccio*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "Ascolta, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Oh! Topi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630108,
					"content": "Hai detto la prima cosa che ti è venuta in mente, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "Non è il momento di fare i sospettosi. Ci siamo quasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630110,
					"content": "Forza! Il tesoro ci sta aspettando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
