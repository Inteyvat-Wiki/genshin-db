						4630516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630516,
					"content": "Altrimenti mi avreste informato delle vostre intenzioni, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630517
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630517,
					"content": "Allora... Beh... Ah... Mmh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630518,
					"content": "#Andiamocene, {NICKNAME}. Paimon non ha più niente da dire a costui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "Paimon"
				},
				{
