					"content": "Questa è la \"Messaggera dell'alba trionfante che punta alla vittoria\". Come suggerisce il nome, simboleggia la luce e la vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Se non vi dispiace, vorrei regalarvela come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "Messaggera dell'alba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Esatto. È perfetta per una persona colta e rigorosa come te, non credi, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630524,
					"content": "Beh... Se la ricompensa è questa Messaggera dell'alba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Potresti perdonarmi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "È un onore avere un'amica così comprensiva.",
