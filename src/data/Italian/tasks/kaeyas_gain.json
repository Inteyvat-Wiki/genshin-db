			"dialogs": [
				{
					"id": 4630301,
					"content": "Ugh... Questa è la fine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630302,
					"content": "Dove sei, tesoro mio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630303,
					"content": "#Diamo un'occhiata in giro, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630304,
					"content": "Ahahah... Vi risparmiamo il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630305,
					"content": "Che ne dite se assumo io il comando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630306,
					"content": "I Cacciatori di tesori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "Occhio attento, ma troppo lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "Io sono Izzard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630312,
					"content": "Vi ringrazio a nome dei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630313,
					"content": "Urgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630314,
					"content": "Abbiamo sempre mantenuto un profilo basso, com'è possibile che si sia sparsa la voce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630315,
					"content": "Profilo... basso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Mmh! Paimon non ti lascerà il tesoro senza combattere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630317,
					"content": "Faresti bene a non sottovalutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630318,
					"content": "La mia banda è qui fuori e aspetta solo un mio comando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630319,
					"content": "Ma non sono... socievoli come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630320,
					"content": "(Entrano Kaeya e i Cavalieri di Favonius)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630321,
					"content": "Mi dispiace romperti le uova nel paniere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630322,
					"content": "Ma non credo che la tua banda potrà contribuire al tuo piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630323,
					"content": "Se vuoi scoprire il perché, puoi andare a trovarli... nella prigione di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630324,
					"content": "O forse preferisci unirti a loro in pianta stabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630325,
					"content": "I Cavalieri...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630326,
					"content": "Ehi, è Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630327,
					"content": "Kaeya, quello vuole rubare il tuo tesoro! Prendilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630328,
					"content": "Uff... L'avevo quasi in pugno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630329,
					"content": "Oh, intendi il tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630330,
					"content": "Mi dispiace, ma non c'è mai stato alcun tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630331,
					"content": "Sei arrivato fin qui... per niente. Lascia perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630332,
					"content": "Come, scusa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630333,
					"content": "Nessun... tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630334,
					"content": "Kaeya ha appena detto che non c'è alcun tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630335,
					"content": "Ahah! Me l'hai proprio fatta. Non pensavo che i Cavalieri usassero certi trucchetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630336,
					"content": "Un ladro non ha alcun diritto di criticare i metodi dei Cavalieri di Fav... Aspetta, cosa stai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630337,
					"content": "Non mi prenderai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630338,
					"content": "Bene... Oh, cielo... C-Cos'è questo? Non facevo sul serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630308,
					"content": "Il mercato nero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "Beh, ho avuto a che fare con quella gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
					],
