						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630535,
					"content": "#Mi sorprende che abbiate risolto tutti gli indovinelli da {F#sole}{M#soli} e siate {F#arrivate}{M#arrivati} qui prima di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630536,
					"content": "Quindi sei stato tu a lasciare tutti quegli indizi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630537,
					"content": "Proprio io. Tuttavia, credevo che fossero troppo vaghi per essere effettivamente d'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630538,
					"content": "Ero pronto a rispondere alle vostre domande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630539,
					"content": "Davvero impressionante. Questa è l'unica cosa che non mi sarei aspettato in tutta questa operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630541,
					"content": "È stata una passeggiata!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630542,
					"content": "Uh, in realtà, ho attinto ad altre fonti per chiedere aiuto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630540,
					"content": "Ah! Niente di che!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630543,
					"content": "Checché tu ne dica, riconosco la tua saggezza. D'altronde, la saggezza non inganna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630544,
					"content": "Ma alcune persone si divertono a ingannare gli altri con il loro ingegno!",
					"roleType": "TALK_ROLE_NPC",
