					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630514,
					"content": "Va bene, va bene... Piantala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630515,
					"content": "Anche se il tesoro non esiste, lo volevate tutto per voi, vero?",
