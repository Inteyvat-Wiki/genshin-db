			"dialogs": [
				{
					"id": 4630001,
					"content": "Questa volta i misteri sono stati tutti risolti. Sicuramente non è stato facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630014,
					"content": "Ma, in tutta franchezza, questa mappa del tesoro è davvero terribile... Sembra l'abbia disegnata un pirata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630002,
					"content": "Quindi, adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630003,
					"content": "Per prima cosa riferiamo tutto a Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Mmh? Paimon pensa che non ce ne sia bisogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "Mi hai letto nel pensiero! Paimon è così felice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630007,
					"content": "È deciso! Non vogliamo che qualcun altro arrivi lì prima di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630008,
					"content": "Come... Come i Cacciatori di tesori di cui ci aveva parlato Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "Comunque, Paimon vuole solo prendere in prestito la spada per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630010,
					"content": "No, come non detto! Paimon, ah... Paimon vuole solo darle un'occhiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630011,
					"content": "Assolutamente non per diventare super, mega potente e non far altro che giocare tutto il giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630012,
					"content": "Eheh... Va bene, Paimon si terrà le chiacchiere per dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630013,
					"content": "Caccia al tesoro di Arcadia, stiamo arrivando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630005,
					"content": "Andiamo direttamente dove si trova il tesoro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
