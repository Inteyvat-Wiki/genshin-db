					"nextDialogs": [
						4630527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630527,
					"content": "Sì... Sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630529,
					"content": "...Paimon è stata totalmente conquistata.",
