					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630531,
					"content": "Che giornata stupenda! Ora devo interrogare il mio sospettato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
