						221010302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010302,
					"content": "Tutto fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "Ottimo. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010304,
					"content": "Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010305,
					"content": "Di questi tempi, onestamente... se non avessi fatto arti marziali fin da bambino, non mi sognerei mai di lavorare nel settore alberghiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
