			"dialogs": [
				{
					"id": 221010201,
					"content": "Come sta andando? Hai risolto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Capisco... Beh, prenditi il tempo che ti serve. Questi mostri possono creare parecchi problemi ai viaggiatori di passaggio, ma non oserebbero mai mettere piede nella locanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "E nell'improbabile caso in cui dovessero tentarci... sono sicuro che potrei, ehm, persuaderli ad andarsene. La sicurezza dei miei ospiti non sarebbe mai a rischio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Nessuno gestisce una locanda così fuori mano senza conoscere un po' di autodifesa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
