			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "Ehi, ehi, ehi! Sono in vendita. Se non compri, non puoi toccare... Ehi, tu! Sì, tu, con i capelli dorati... Aspetta un attimo, non andare via così in fretta. Lasciati guardare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Mmmh, proprio come pensavo. I tuoi capelli brillano come il sole, mentre i tuoi occhi sono profondi come il Regno della Notte... Ho la sensazione che... Anzi, è una certezza. Un giorno diventerai qualcuno di incredibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#Ecco, ho un set di meravigliosi ornamenti di giada, ognuno dei quali contiene una melodia diversa. Perfetti per {F#una vera eroina}{M#un vero eroe} come te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "Attenzione, questi sono dei tesori inestimabili. Se qualcun altro li volesse comprare, chiederei almeno dieci milioni di Mora. Ma sono fatti per te, quindi puoi averli per un decimo del prezzo. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Wow, un decimo?! Ma è un affare! Però aspetta... Non costano comunque... almeno un milione di Mora? È un po' troppo, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Sì, beh... È praticamente il prezzo di costo. I piccoli commercianti non guadagnano molto, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "Non dovresti guadagnare in questo modo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Ah, quindi hai sentito tutto, eh? Ahah, ho preso l'abitudine di parlare da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*sospira* Ok, visto che mi avete beccato, vi dirò la verità. Ho trovato questo ornamento di giada per caso. Non vale assolutamente così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Ma ecco, come avete sentito, siamo a corto di soldi... Così a corto che non possiamo neanche pagare qualcuno per andare a recuperare i dati dalle boe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "E allora lasciate perdere! Meglio che truffare le persone, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "No, non va bene... Le altre organizzazioni possono fermarsi quando sono a corto di fondi, ma il nostro lavoro volontario include anche il monitoraggio vulcanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Abbiamo posizionato quelle boe per misurare l'attività vulcanica raccogliendo dati sulla temperatura dell'acqua e altre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Con l'aumentare dell'attività vulcanica, dobbiamo recuperare le boe, e velocemente. Altrimenti potrebbero esserci gravi conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Nelle condizioni in cui sono, non posso distruggere le boe, figuriamoci recuperarne i dati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#Che ne pensi, {NICKNAME}? Perché non l'aiutiamo? Il vulcano ha un impatto su tutti quanti, non possiamo ignorarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "#D-Davvero? Se siete {F#disposte}{M#disposti} ad aiutare, questi ornamenti di giada sono vostri, e sono gratis! Considerateli come una ricompensa. Che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Non avevi detto un milione di Mora...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Non preoccuparti. Non abbiamo molto a disposizione, ma sicuramente possiamo darvi altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Eheh, per noi è sufficiente! Dopotutto, lo facciamo per la sicurezza di tutti coloro che vivono vicino al vulcano! Quindi non preoccuparti, ci pensiamo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Ah, beh, diamoci da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Ho bisogno di un attimo per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Quando vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Ah, quindi è questa la mia ricompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Non eri tu a dire che un aiutante vale un milione di Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Fiuu, che sollievo. Sembra che la situazione con il vulcano non sia così catastrofica come temevamo. Possiamo dormire tranquilli, stanotte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "#Naturalmente, è stato tutto merito vostro. Se voi non foste {F#intervenute}{M#intervenuti} e non ci aveste aiutato senza serbare rancore, le cose non sarebbero andate così lisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Vi prego, accettate questo come segno di gratitudine, e di scuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Ahah, beh, visto che dici così... Accettiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Cos'hai intenzione di fare, ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Ho ancora delle merci in magazzino. Le normali operazioni dovrebbero rimettere in carreggiata le nostre finanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Ovviamente, visto che questa volta non è un'emergenza, farò affari onesti. Non preoccupatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"3"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Dieci, venti... Ho venduto un po' di cose, quindi per ora le nostre finanze dovrebbero essere stabili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Non vuoi provare a guadagnare di più?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#Ahah, no! Ho smesso per ora! Se non fossi {F#stata}{M#stato} così {F#comprensiva}{M#comprensivo} e non mi avessi aiutato, mi sarei sicuramente cacciata nei guai con quegli ornamenti di giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "E poi, cercare sempre soldi è noioso. Per me è solo un hobby. Tenere d'occhio il vulcano è ciò che conta davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Possiamo sempre guadagnare di più, ma se per colpa nostra non venisse diramata l'allerta per l'eruzione... Sarebbe una perdita enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Non ricevi fondi dalla Camera del Consiglio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Non li abbiamo mai chiesti. Con tutte le cose di cui si occupano ogni giorno, dubito che abbiano bisogno di stress aggiuntivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Io e i miei compagni siamo diversi. Siamo abituati a finanziare i nostri viaggi accettando lavoretti diversi lungo la strada. È diventato uno stile di vita, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Pertanto, tenere d'occhio il vulcano mentre viaggiamo non è un problema. È proprio come il vostro aiutare le persone che ne hanno bisogno. Succede in modo naturale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Va bene allora, ci vediamo in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Fate attenzione, eheh. Alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
