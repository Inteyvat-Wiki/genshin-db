					],
					"speakerTitle": "Ur"
				},
				{
					"id": 750470202,
					"content": "È per questo che gli umani... mangiano erba e Granifrutti allo stesso tempo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ur"
