			"trigger": {
				"objectNames": [
					"Kusi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Beh, il mio peso è sotto controllo, ma... Mm? Che c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Posso chiederti come ti chiami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Ah, giusto. Sono una delle sentinelle di guardia qui, anche se al momento sono in modalità vacanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Quindi, se sta succedendo qualcosa, dillo al tizio al mio fianco, Yukom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "Qualcosa ti turba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Beh, vedi, ultimamente sto prendendo peso, quindi ho aggiunto un sacco di verdura alla mia solita dieta a base di Granifrutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "Ma, per qualche ragione, il mio amico Ur mi sta copiando e sta mangiando quintalate di erba... Niente di grave, visto che i Saurici sono onnivori, ma temo che tutta quell'erba non sia il massimo per la sua alimentazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Immagino che più tardi gli dovrò fare un discorsetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "Nulla di che, davvero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "Certo, buon viaggio, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
			]
		}
	]
