			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "Che sonno. Voglio dormire... Ma dobbiamo restare qui tutti assieme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Huruk"
				},
				{
					"id": 750470302,
					"content": "Perché gli umani vogliono starsene qui in piedi tutto il giorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huruk"
