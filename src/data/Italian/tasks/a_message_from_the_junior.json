			},
			"dialogs": [
				{
					"id": 706990101,
					"content": "#{F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Siamo così fortunati ad averti qui a provare le nostre bancarelle d'intrattenimento. Ora mi sento molto più tranquillo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "A dire il vero, è la prima volta che partecipo a un progetto di sviluppo, quindi sono un po' in ansia. Il mio cervello è fuso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Dovevo solo montare una custodia su un dispositivo già esistente. Ma le considerazioni progettuali da fare erano tantissime, così come i parametri da regolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Non invidio il capitano Albedo, che deve creare dispositivi appositi da zero... Dev'essere un compito davvero difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Penso che funzioni molto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "#Wow, ehm... G-Grazie! Grazie, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, detto da te significa molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Continuerò... a fare del mio meglio. Spero di arrivare al punto in cui potrò costruire qualcosa di utile per la compagnia di ricognizione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Oh, ho vinto dei giocattoli a uno dei giochi. Questo lo vorrei dare a te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "Ne ho un altro uguale. Così, ogni volta che lo guarderò, penserò a tutto l'incoraggiamento che mi hai dato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Non essere così duro con te stesso. Puoi solo migliorare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
