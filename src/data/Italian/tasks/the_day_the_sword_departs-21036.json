			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "#Viaggiat{F#rice}{M#ore}, chi si rivede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Ti stai ancora addestrando qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Altroché. È molto più difficile di quanto pensassi. Non capisco se sia perché sono davvero debole o se ho adottato il metodo sbagliato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Comunque sia, cambiamo argomento. L'ultima volta che abbiamo affrontato i mostri insieme, ho trovato le tue mosse davvero stimolanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti farmi un favore? Continueresti ad aiutarmi con l'addestramento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "Magari, proprio come la volta scorsa, concentrandoci sui combattimenti coi mostri o sulla corsa campestre? Decidi tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Que'er ti sta ancora ignorando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Beh... Ha detto che aveva delle cose da sbrigare in città, ma non è più tornata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Sono andato a trovarla un paio di volte, ma incarica sempre Zhiruo di dirmi di andarmene. Si rifiuta di vedermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*sospira* Sinceramente non so più cosa dirle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
