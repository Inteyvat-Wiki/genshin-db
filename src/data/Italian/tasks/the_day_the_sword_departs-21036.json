			},
			"dialogs": [
				{
					"id": 210360801,
					"content": "*ansima* *ansima* Come... Come puoi... correre così velocemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360802,
					"content": "Sei lento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "C-Ci rinuncio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360806,
					"content": "*ansima* Posso finalmente riprendere fiato. Ah, santo cielo, non avrei mai pensato che potesse essere così estenuante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360807,
					"content": "#Grazie per la dimostrazione, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360804,
					"content": "Hai ancora bisogno di addestramento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "*ansima* Hai assolutamente ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
