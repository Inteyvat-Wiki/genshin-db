				{
					"id": 210360701,
					"content": "*ansima* Che fatica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360702,
					"content": "Chiedo scusa. Guardami, non faccio che rendermi ridicolo. Non mi aspettavo che sarei stato tanto nervoso ad affrontare dei mostri veri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360703,
					"content": "#Inutile a dire, mi serve ulteriore addestramento. Comunque sia grazie, viaggiat{F#rice}{M#ore}, ti prego di accettare questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360704,
					"content": "Te ne stai davvero andando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "Non ho ancora preso la mia ultima decisione. Mi serve altro tempo per pensare. Nel frattempo vedrò se riesco a convincere Que'er a partire con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
