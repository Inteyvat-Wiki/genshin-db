			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "Corsa campestre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Fantastico! Ho chiesto a un'avventuriera di aiutarmi a tracciare un percorso sterrato... Sai, è stato solo grazie al suo aiuto che sono stato in grado di addestrarmi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Ha detto che devo solo raggiungere la destinazione il prima possibile. Ma pare che non sia molto veloce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Allora puoi dimostrarmi come farlo velocemente? Farò del mio meglio per starti dietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Allora conto su di te. Raggiungiamo il punto di partenza, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Cerca di non restare troppo indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "C-Ci proverò sicuramente. Ma, a dirla tutta, non sono mai stato un bravo corridore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103604,
			"completionStepIds": [
				2103604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
