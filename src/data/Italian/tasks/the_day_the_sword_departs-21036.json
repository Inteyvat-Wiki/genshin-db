					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "*ansima* Che fatica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Guardami, continuo a rendermi ridicolo. Immagino di non aver fatto molti progressi, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "#Inutile a dire, mi serve ulteriore addestramento. Grazie, viaggiat{F#rice}{M#ore}, ti prego di accettare questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Come farai a lasciare Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Beh... Attualmente il mio programma è di prendere la barca del mercante e viaggiare per mare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "La mia prima fermata... penso sarà Fontaine. Mi fermerò lì per un po' e programmerò altre tappe da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*sospira* Chissà se riuscirò a convincere Que'er a venire con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
