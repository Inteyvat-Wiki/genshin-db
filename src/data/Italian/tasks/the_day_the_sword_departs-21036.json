					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "Combattimento contro i mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Grandioso! Voglio proprio mettere in pratica quello che ho imparato con la spada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Temo che non riuscirai a vedere chiaramente le mie mosse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "#S-Sei davvero così brav{F#a}{M#o}? Ahah, beh, allora fammi un altro favore e rallenta un pochino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Vediamo... Più avanti c'è un posto dove si radunano i mostri. Andiamo prima lì, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
			],
			"beginWay": "TALK_BEGIN_NONE",
