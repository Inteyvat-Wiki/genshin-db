			"dialogs": [
				{
					"id": 210360901,
					"content": "Corsa campestre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "Eccellente! Rimaniamo nei sentieri fuori strada che usavamo prima per addestrarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "L'avventuriero mi ha detto che ho solo bisogno di raggiungere la destinazione nel modo più veloce possibile. Ma non sono mai stato abbastanza veloce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Puoi dimostrarmi come farlo velocemente? Farò del mio meglio per starti dietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Allora conto su di te. Raggiungiamo il punto di partenza, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Cerca di non restare troppo indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "C-Ci proverò sicuramente. Ma, a dirla tutta, non sono mai stato un bravo corridore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "Sun Yu"
				}
			]
