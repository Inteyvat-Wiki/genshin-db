			"dialogs": [
				{
					"id": 741570301,
					"content": "Questa casa è in vendita. Prezzo molto ragionevole! Comprala prima che sia troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Avviso di casa in vendita"
				},
				{
					"id": 741570302,
					"content": "#{NICKNAME}, e Paimon! Siete qui per parlare con Monsieur Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Benoît è in casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Non è in casa. Mio padre ha detto che il signor Leroy non abita più qui, se n'è andato nel sottosuolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Nel Fleuve Cendre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "È lo stesso Fleuve Cendre che abbiamo visitato in passato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "In tal caso no, non è lì. Mio padre ha detto che è molto più in profondità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "Secondo quanto riportato dall'Uccello a vapore, Monsieur Leroy è caduto da un punto molto alto mentre scalava una montagna, e si è fatto una bella ruzzolata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Anche se, onestamente, non so esattamente che rapporto ci sia tra farsi una ruzzolata e trasferirsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "A proposito, ho visto il genero di Monsieur Leroy! E con lui c'era anche una simpatica Madame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "Le sono proprio piaciuta, e tutt'e due abbiamo gli occhi color lavanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Mi ha chiesto dove vivessi, mi ha detto che sarebbe venuta a trovarmi, e che saremmo diventate amiche! I Leroy sono proprio brave persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "*sospira* Avevo perfino portato un po' di Bulle per Monsieur Leroy, ma dato che non c'è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "Posso darlo a voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Grazie, Molli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Non c'è problema! Mamma e papà dicono sempre che dovremmo essere generosi con i nostri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "Ho fatto un'altra buona azione oggi! Me la appunterò sul diario, evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Mentre guardi Molli allontanarsi lentamente, la storia della famiglia Leroy si avvia alla conclusione.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Passavamo di qui per caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Stavo giusto pensando se dirvi o meno che Monsieur Leroy si è trasferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Mio padre ha detto che Monsieur Leroy non abita più qui, se n'è andato nel sottosuolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
