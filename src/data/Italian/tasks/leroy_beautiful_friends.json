			"dialogs": [
				{
					"id": 741570201,
					"content": "Questa casa è in vendita. Prezzo molto ragionevole! Comprala prima che sia troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Avviso di casa in vendita"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}, Paimon, sembra che il signor Leroy non viva più qui! L'avete mica visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570203,
					"content": "(Ehi, vogliamo dirle la verità?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "L'abbiamo visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "Davvero l'avete visto? Gli avete detto che gli stuzzichini erano deliziosi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570206,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#Lo sapevo che {NICKNAME} era una persona affidabile! Siete davvero {F#le}{M#i} migliori! Ho portato dei Bulle, servitevi pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570214,
					"content": "Molli sospira e saluta ma, proprio quando sta per andarsene...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "La porta si apre, ed ecco uscire Autumn e Athos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Allora erano vostre le voci che abbiamo sentito fuori! Cercate qualcos'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Passavamo di qui per caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Davvero? Com'è piccolo il mondo. Autumn e io ce ne stavamo andando proprio ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570219,
					"content": "E Benoît?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "Oh, se n'è già andato. In un posto che raggiungeremo tra non prima di qualche decennio. Non penso lo vedrete molto presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570221,
					"content": "Anche se è difficile a dirsi. Oggi ci siamo, domani chissà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570225,
					"content": "Ah, non si tratta di quella piccola canaglia che veniva sempre a trovare Benoît?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Salve, signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570228,
					"content": "Tu mi somigli davvero tanto... Hai anche gli occhi color lavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "S-Signora, posso aiutarla...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570230,
					"content": "Quanti anni hai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "Nove!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570232,
					"content": "Come si chiamano i tuoi genitori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Uh... Si sente bene, signora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570234,
					"content": "La tua espressione... C'è qualcosa che non va con la ragazzina? Aspetta, non può essere una coincidenza, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570235,
					"content": "Sei stata adottata? Dimmelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#...{NICKNAME}, conosci questa signora? Cosa sta facendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570237,
					"content": "Che domande sono? Lascia fare a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570238,
					"content": "Signorinella, ricordo che sei molto legata a nostro padre, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570239,
					"content": "Certo! Il signor Leroy mi tratta molto bene. Per caso non abita più qui, signor genero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570240,
					"content": "Esatto, se n'è andato in un posto molto lontano, e non tornerà più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570241,
					"content": "Cosa ti racconta nostro padre di solito? Puoi condividerlo con me? Gli dirò che ti manca tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570242,
					"content": "Il signor Leroy mi offre sempre degli stuzzichini, mi fa accarezzare Nana e mi dice che ho gli occhi belli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570243,
					"content": "Nient'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570244,
					"content": "Mi dice di salutargli la mia mamma e il mio papà, ma loro non ne sono contentissimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570245,
					"content": "Papà va su tutte le furie, dice che il signor Leroy è una brutta persona e che li sta \"ricattando\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570246,
					"content": "Anche se mi hanno proibito di venire, ho fatto un patto con il signor Leroy, e perciò lo vengo a trovare di nascosto contro la loro volontà. Signore, non lo dica a mio padre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570247,
					"content": "Tipico, da parte sua. Non si ferma davanti a niente finché non ti ha spremuto fino all'ultima goccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "Che bastardo... Chiedo scusa. Stavamo parlando di qualcos'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570249,
					"content": "S-Signore, signora, c'è altro che vorreste sapere? Altrimenti... tornerei a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570250,
					"content": "...I tuoi genitori ti vogliono bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Sono i genitori migliori del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Meglio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "Ora torno a casa! Arrivederci, signora! Arrivederci, signore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570255,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Siamo sicuri che vada bene così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Questa scena l'ho immaginata un sacco di volte... Ma non desidero altro che saperla felice. Per me è sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Io... non sono mio padre. Non voglio seminare zizzania nella sua famiglia attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Non voglio infierire, ma non le hai appena comprato un carillon? E non glielo vuoi regalare più?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "No, non sarà necessario. Non... non sembra aver bisogno di una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Penserò a come continuare a farle visita. Troverò un modo per farle avere qualunque cosa di cui abbia bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "...E il carillon lo darò a qualcun altro. Dopotutto, è stato un acquisto ponderato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Scusami, ragazzina dai capelli bianchi... Ti piacciono i regali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Stai parlando con Paimon? Aspetta, vuoi darlo a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Certo che sì. È un dono, per cui accettalo di buon grado. Spero che per te valga ancora qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Scusami, Athos, penso che dovremo rimanere nella Corte di Fontaine ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Non preoccuparti, per me non fa differenza. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570270,
					"content": "Guardate i due allontanarsi, fino a sparire dalla vostra vista: la storia della famiglia Leroy si avvia a conclusione.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Non hai intenzione di dirglielo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Come sta Benoît?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Il mondo è pieno di disuguaglianze, estrema povertà ed eccessiva ingordigia. Saremo noi ad applicare le punizioni che le leggi di Fontaine non riescono a imporre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570224,
					"content": "Voglio dire... che è dove doveva essere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570208,
					"content": "Ce lo siamo dimenticato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Oh, davvero? Peccato. Quindi non avrò mai l'opportunità di dirlo al signor Leroy. Per quanto riguarda i Bulle che ho portato... Tanto vale che li dia a voi e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570210,
					"content": "Non l'abbiamo visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Ah, che peccato. Immagino che non vedrò più il signor Leroy, uh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570212,
					"content": "Avevo portato dei Bulle, che volevo dargli in caso l'avessi incontrato... Ma, visto che non vive più qui, perché non li prendete voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570213,
					"content": "In ogni caso, penso che mi ricorderò sempre del signor Leroy! Ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				}
			]
		},
