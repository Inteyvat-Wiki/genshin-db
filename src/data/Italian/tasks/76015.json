					]
				},
				{
					"id": 760150206,
					"content": "Ah, se insisti! Ma prima, vieni a bere e a cantare con noi. Quando saremo amici, potrai sederti dove vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150207
