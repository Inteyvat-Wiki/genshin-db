					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150207,
					"content": "Conosci la canzone, vero? Yo-ho, forza! Noi cantiamo una strofa e tu canti la prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150208,
					"content": "\"La musica del vicino mi fa ballare dal mio angolino, oh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150209,
					"content": "\"La lira suono e voi sorridete nel frastuono!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"E tutti insieme balliamo con abbandono!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150211,
					"content": "\"Forza gente, danziamo!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Ahah! Esatto, proprio così! Impari velocemente, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150213,
					"content": "Mi chiamo ███. E così, siamo amici. La sedia è tutta tua... Dopotutto, sono una persona generosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150214,
					"content": "Siamo colleghi Ratniki, eh? Non preoccuparti, questo lo offro io. Forse ci rivedremo durante l'addestramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150215,
					"content": "Grazie... Anche se non posso berlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Bene, vado in pattuglia. Ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150216,
					"content": "Il piacere è mio. Mi chiamo Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "E se ti dicessi che mi voglio sedere qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
