			"trigger": {
				"objectNames": [
					"Fantasma chiassoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Chi sei? È il mio posto, e tutti alla taverna lo sanno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150102,
					"content": "Anche se sei qui sull'isola da poco, non puoi mica rubare il posto agli altri così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150103,
					"content": "E poi, dov'è la mia birra? Muoviti, ok? Tra poco andrò in pattuglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150104,
					"content": "Taverna? Birra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Ah, se insisti! Ma prima, vieni a bere e a cantare con noi. Quando saremo amici, potrai sederti dove vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150107,
					"content": "Conosci la canzone, vero? Yo-ho, forza! Noi cantiamo una strofa e tu canti la prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150108,
					"content": "\"La musica del vicino mi fa ballare dal mio angolino, oh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "No, no, no! Ma fai sul serio? La conoscono tutti a Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150113,
					"content": "Se non canti e non ti diverti, non ti ambienterai mai. E quando la Caccia selvaggia attacca, non succedono cose molto belle ai soldati senza amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150114,
					"content": "Impara la canzone e torna qui, capito? Ehi! Un'altra birra, forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma chiassoso"
				},
				{
					"id": 760150110,
					"content": "\"La mia amica Paimon è divertente, mi fa ridere a crepapelle!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"I fantasmi dell'isola si riuniscono, cantano e ballano!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Lasciami il posto per un po', va bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
