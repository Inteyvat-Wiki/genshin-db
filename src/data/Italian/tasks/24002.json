			"dialogs": [
				{
					"id": 240020201,
					"content": "Mademoiselle Isadora, posso fare qualcosa per lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Agente Muirne, ho una domanda per lei. Si ricorda la pila di documenti che ho portato in ufficio questa mattina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Certamente. Ricordo anche che è stata attaccata da uno stormo di gabbiani pescatori violucenti, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "Esatto! E appena quei fastidiosi uccellacci se ne sono andati sono corsa in ufficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Per caso si ricorda se ho lasciato qualche documento a terra quando sono corsa via?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Um... Non ricordo. Anche io ero impegnata con altre faccende in quel momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Ma se le servono con urgenza, possiamo provare a \"ricostruire\" il suo percorso verso l'ufficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Eh? Davvero si può? Non... vorrei disturbare troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Si tratta solo di cercare qualcosa. È sicuramente più facile che lavorare al Palais Mermonia, poco ma sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Ricordo che aveva legato in pile i documenti che stava trasportando. Dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Esatto. Dopotutto, dobbiamo essere precisissimi con i nostri rapporti per la revisione dei costi. Ha buon occhio, uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Qualsiasi cosa deve essere registrata, dagli incarichi più grossi come quelli per gli operai che fanno manutenzione alle mura esterne del Palais, a quelli più piccoli come il cambio di una serratura di un cassetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "Ecco perché i documenti finiscono per essere così tanti che devono essere legati con una corda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Per farla breve, non è possibile che un singolo foglio sia volato via per proprio conto... Anche se avesse perso dei documenti, li avrebbe persi a blocchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Non è passato molto tempo da quando è arrivata in ufficio, partiamo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
