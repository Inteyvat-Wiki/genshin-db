			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Uh. Dov'è andato? Che sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Uff. Non sarò in grado di scrivere un'altra copia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Hai perso qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Beh, a essere ottimisti spero che l'abbia \"solo\" perso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "Questo è essere ottimisti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Beh... Potrebbe esserlo, se la cosa che si sta cercando è il registro delle spese semestrali dell'ufficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Doveva essere consegnato alla signorina Keiser... solo che improvvisamente ho scoperto che al registro mancavano cinque pagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Le cinque pagine sono di cinque diversi mesi e contengono un grande ammontare di spese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Ho scoperto della loro assenza solo durante la revisione finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Se non li avessi persi per sbaglio e non li avessi mai fatti... Come si è arrivati a questo importo finale per le nostre spese ufficiali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Ugh, non oso neanche pensarci. Se davvero mi fossi dimenticata di segnarle, la signorina Cadme mi costringerà a tirare fuori tutti i registri di contabilità degli ultimi dieci anni e me li farà rivedere uno per uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Sembra una questione seria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Lo è eccome! Se i documenti non sono stati redatti o sono andati perduti, il mese prossimo alcuni uffici avranno problemi di finanziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Che sfortuna nera... Ricordo solo di aver passato la notte in bianco a compilare il registro e di averlo portato oggi al Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Quando sono arrivata qua, sono stata spaventata da un gruppo di gabbiani e le mie mani hanno perso la presa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "*sospira* Potrei davvero aver perso i documenti in quel momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Ti aiuterò a cercarli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "#Sei dispost{F#a}{M#o} ad aiutare? Grandioso! Vieni, seguiamo prima questa strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Le informazioni contenute non sono segrete, quindi non preoccuparti se per caso vedi qualcosa mentre raccogli i fogli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Ah, giusto, in quel momento ho anche incontrato l'agente Muirne! Mi ha aiutata a scacciare i gabbiani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Potremmo chiedere a lei se ha visto il registro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "Cerchiamoli assieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Perdere qualcosa è una buona cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
		{
