				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, questi sono i documenti che mi servono! Oh, lode all'Archon, sono tutti qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Perché stavi facendo i conti in una caffetteria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "B-Beh, ho bisogno di un sacco di caffè per assicurarmi che faccia bene i conti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Si tratta delle spese di tutti gli uffici del Palais, sapete... contarle dovrebbe essere il lavoro di cinque persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Ma a parte me, tutti gli altri nell'ufficio vengono spesso \"presi in prestito\" da altri uffici, mandati fuori per lavoro o sono impegnati con altre visite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Quindi, quando arriva il momento di fare i conti, rimango solo io... Sono giorni che non dormo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Non solo mi è toccato fare revisione delle spese, ma persino sistemare i conti. I miei occhi vedono solo numeri ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "A ogni modo, è un bene aver trovato quei conti. Se me lo permette, signorina Isadora, l'accompagnerò al Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "#Grazie mille, agente Muirne. *sospira* Davvero, lei e {F#la}{M#il} viaggiat{F#rice}{M#ore} siete le uniche due persone di buon cuore che ho incontrato in questi tre mesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "Tutti gli altri mi sgridano o mi sollecitano perché mi metta al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "No, no, devo smetterla di lamentarmi. Devo tornare indietro o la signora Keiser mi sgriderà di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}