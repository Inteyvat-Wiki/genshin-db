			"dialogs": [
				{
					"id": 760690401,
					"content": "Uh, una manifestazione dello Spirito del lupo... Un tassello che non conoscevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690402,
					"content": "Chi ti ha lasciato qui? E cosa stai sorvegliando? Rispondimi... Dimmi di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690404,
					"content": "...Quante volte devo ripeterlo? Percorrere questo sentiero intriso di sangue spetta soltanto a me. Nessuno deve seguire le mie orme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690405,
					"content": "Beh, allora chiamiamolo \"destino\". Chi può dire che non stessimo seguendo il medesimo sentiero, da Mondstadt fino a Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "Un \"destino\" in cui riveriamo un certo cavaliere che innumerevoli volte ci ha salvato la vita. In simili circostanze, chi potrebbe biasimarci per aver intrapreso un percorso del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "Anche se non dovessimo comprendere appieno, noi rimarremmo comunque come testimoni... Anche a costo di restare da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "Auuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "Se è davvero così che la vedete... non ho il diritto di negarvi alcunché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690410,
					"content": "...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "Quei mostri maledetti... sono tutti morti? E i residenti qui vicino... sono al sicuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "*tossisce* Bene... È un peccato che ci manchino le forze per vederti arrivare fino in fondo... Una vera disdetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "Da qui in poi, dovrai percorrere questo sentiero da solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "Alla fine, la mia spada non è riuscita a proteggerli tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690415,
					"content": "Alla fine, solo uno è rimasto a percorrere il sentiero... Forse era scritto che andasse così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690416,
					"content": "Possano quantomeno queste spade e lo Spirito del lupo farvi da guardiani in questo posto, per impedire a quelle oscure aberrazioni di turbare il vostro eterno riposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690417,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690418,
					"content": "È così che è andata, dunque... I registri dei Cavalieri di Favonius dicono che, quando il Cavaliere insanguinato partì, alcuni di loro scelsero di seguirlo... ma nessuno ne ebbe più notizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690419,
					"content": "Alla fine, sono caduti qui lottando contro i mostri... Una fine degna, per dei veri Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690420,
					"content": "Ma era davvero questo il loro unico desiderio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690421,
					"content": "L'inestinguibile fiamma della battaglia, l'anelito che dimora nelle vostre spade... Parlatemi, Cavalieri. Mostratemi la vostra determinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690422,
					"content": "Userò il potere lasciato qui da Boreas per sigillare questo campo di battaglia... E quel piccolo lupo là fuori veglierà su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690423,
					"content": "Per non essere mai turbati, per godere della pace eterna e per non dover assistere alle ingiustizie di questo mondo... Se c'è qualcuno degno di una tale protezione, quelli siete voi, amici miei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690424,
					"content": "Ed eccoci qui... Addio, miei ultimi compagni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690425,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "...Combattiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "...Ancora una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "Questo è lo spirito giusto! I vostri desideri e le vostre ambizioni non possono svanire in un posto del genere, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690430,
					"content": "Unitevi a me! E fate ritorno ancora una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690431,
					"content": "Alla battaglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}