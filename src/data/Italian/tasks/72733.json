			"dialogs": [
				{
					"id": 727330101,
					"content": "Melonlavanda Biancoferro Squarciatrice dei cieli! Sono venuto per vendicare Elyctra! Sfodera il tuo Onikabuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330102
					],
					"speakerTitle": "Maestro delle gabbie"
				},
				{
					"id": 727330102,
					"content": "Dopo che ti avrò sconfitto, annienterò la Banda di Arataki al completo, un membro dopo l'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330103
					],
					"speakerTitle": "Maestro delle gabbie"
				},
				{
					"id": 727330103,
					"content": "Sembra che stavolta... affronteremo un adulto? E com'è che sembra più entusiasta di un bambino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330104,
						727330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727330104,
					"content": "Non devi avere paura, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727330106
					]
				},
				{
					"id": 727330106,
					"content": "Bene, Melonlavanda Biancoferro! Pare che questo tizio ti stia sfidando a duello... E non è possibile tirarsi indietro da una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727330107,
					"content": "Porta con te Bastone cremisi e scatenatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727330105,
					"content": "Solo un'altra piuma per il tuo cappello, Paimon.",
