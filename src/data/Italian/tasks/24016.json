			"dialogs": [
				{
					"id": 240160401,
					"content": "Fiuuu... Grazie per l'aiuto. Se non fosse stato per te, chissà quanto tempo ci sarebbe voluto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Anche se sarebbe stato ancora meglio se avessi pulito con maggiore delicatezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Chiedo scusa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Non fraintendere! Non ti sto rimproverando, mi hai davvero fatto un gran favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "#Ecco la tua ricompensa. Grazie per l'aiuto, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "La prossima volta ci andrò un po' più piano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
