							3944.917
						],
						"pointId": 6694
					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Ecco fatto... Spero che questa documentazione sarà di qualche utilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Stai ancora sistemando i fascicoli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#Oh! Piacere di vederti, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Proprio così! Sto ancora mettendo a posto i documenti e i fascicoli come da istruzioni di Monsieur Raimondo... Un momento, non l'avevo già detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Questo posto è enorme! Richiede decisamente troppo lavoro per una sola persona. Perché non ha incaricato qualcuno di aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "L'Istituto di ricerca deve gestire molte questioni urgenti. È normale che non ci sia nessuno disponibile ad aiutarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Eppure sei anche una direttrice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Ti riferisci al mio titolo di direttrice del progetto recupero materiali dell'Istituto di ricerca di Fontaine? *sospira* Ti prego, non prendermi in giro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "In che senso sarei una direttrice? Fin dal principio, non ho fatto altro che riordinare fascicoli come una qualsiasi impiegata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Sono improvvisamente venuta a conoscenza del mio nuovo titolo dopo che Monsieur Raimondo mi ha dato l'incarico di riordinare questi fascicoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Alcuni dicono che sia stata un'idea di Monsieur Choiseul. Secondo lui, grazie a questi titoli, sarà più facile ottenere un compenso extra per il nostro duro lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ah! Non dirlo a nessuno... Come ho potuto spifferarlo ai quattro venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Non preoccuparti, ho la bocca cucita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Non sembra niente male! Dopotutto, è giusto che chi si accolla tutto il lavoro riceva qualche soldo in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Ma perché inventarsi un sistema così macchinoso? Non possono semplicemente aumentare lo stipendio a tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "Pare che qui all'Istituto di ricerca sia la prassi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "#*sospira* Non riesco mai a capire cosa passi per la testa di que{M#i}{F#lle} due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Ma devo assolutamente continuare a lavorare! Ho un sacco di cose da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "#Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}, ti andrebbe di darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "È mio dovere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "In tal caso, ti chiedo di aiutarmi a fare un po' di pulizia qui intorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Evita assolutamente di <color=#00E1FFFF>toccare libri e fascicoli</color> mentre pulisci. Sarebbe un vero disastro se dovessero rovinarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Mi affido a te! Nel frattempo, continuerò a riordinare i fascicoli che ho qui. *sospira* Non mi ero mai accorta che l'Istituto custodisse così tanti documenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Non dimenticare di rendere ancora più onorevole il mio titolo \"onorario\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Ahahah, senz'altro! Non mancherò di elogiare la tua gentilezza e il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Purché tu riceva i Mora extra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
