				"points": []
			},
			"dialogs": [
				{
					"id": 240160301,
					"content": "Fiuuu... Grazie per l'aiuto. Se non fosse stato per te, chissà quanto tempo ci sarebbe voluto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "#Non mi stupisce che tu sia {F#una Ricercatrice senior onoraria}{M#un Ricercatore senior onorario}. Porti a termine ogni compito in modo impeccabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "#Sono sempre stat{M#o}{F#a} un po' fuori dal comune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "#Grazie ancora per il tuo aiuto, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}. Ti prego di accettare questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Ho già qualche esperienza nel settore delle pulizie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#Eh? Con tutti i tuoi talenti nascosti, sei davvero degn{M#o}{F#a} del tuo titolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
