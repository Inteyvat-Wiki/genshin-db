				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "A cosa ti servono tutti quei tubi e ingranaggi? Stai costruendo una casa di ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "All'incirca, signore! È una casa, una casa piena di ingranaggi... Ecco cosa sto costruendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Ho chiamato la zona con gli ingranaggi il \"deposito\", mentre i cuscinetti e il resto degli ingranaggi fanno parte del \"basamento numerico\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Gli ingranaggi nel deposito servono a registrare e a memorizzare i numeri, mentre quelli nel basamento numerico servono per i calcoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Uno schemino potrebbe essere d'aiuto. Hai per caso della carta? No? Non importa, disegnerò sui miei vestiti. Dovrebbe rendere le cose più chiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Mi passi il carbone, per favore? Grazie mille, osserva attentamente..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
