	"talks": [
		{
			"id": 7106402,
			"completionStepIds": [
				7106410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106408",
							"3"
						],
						"stepId": 7106408,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Su questa piccola stele di pietra è inciso quanto segue...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 710640202,
					"content": "...\"Durante la battaglia nella Voragine ho perso l'uso degli arti, quindi sto dettando queste parole a qualcuno che possa inciderle qui...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 710640203,
					"content": "...\"Pur essendo sopravvissuto a quello scontro feroce, quando penso ai miei compagni caduti non riesco a dormire. E considerando le condizioni del mio corpo, oh, come vorrei aver avuto la fortuna di cadere con loro!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 710640204,
					"content": "...\"Ho cercato di raggiungerli, ma Rex Lapis se n'è accorto e mi ha risvegliato da quello stato confusionale, impedendomelo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 710640205,
					"content": "...\"Ahimè, non potrò più far uso dell'armatura e dell'equipaggiamento da Millelite che mi ha donato. Rimanendo in mio possesso finiranno per prendere polvere, quindi li lascio qui nella speranza che qualcuno venga a prenderseli...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 710640206,
					"content": "...\"Non possiamo più essere compagni in questa vita, ma spero che potremo esserlo di nuovo nella prossima. Mi auguro che potremo condividere ancora una volta il vino della fratellanza, e proteggere Liyue dai suoi nemici!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stele di pietra"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Oh, wow, l'avete trovato davvero! Quindi questo sarebbe il \"tesoro del Millelite\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "Non ho idea di cosa contenga, ma sono sicuro che quel soldato sarebbe felice di sapere che qualcuno ha trovato il suo tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Sono passati cinquecento anni da quella catastrofe... Ogni volta che penso a come doveva essere questo luogo durante una battaglia così violenta, in cui si sono sacrificati innumerevoli nostri antenati, non posso fare a meno di chiedermi se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "...tutte quelle persone che sono andate in guerra al fianco del Signore di Geo sapessero che sarebbero state ricordate per secoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "Hanno mai vacillato o messo in dubbio i loro doveri? E come ha fatto chi non ha mai ottenuto una Visione a rimanere fedele a un dio che non è mai stato gentile nei suoi confronti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Il loro dio è sempre rimasto al loro fianco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Sì, hai ragione. Con o senza Visione, tutti abbiamo del potenziale illimitato con cui ci facciamo strada verso il futuro. È la cosiddetta \"determinazione\", no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Non ci sono differenze tra noi. Non siamo qui per ricordare i bei tempi andati o per raggiungere una qualche forma di autorealizzazione nel presente, ma facciamo ciò che dobbiamo per sostenerci l'un l'altro e per lasciare qualcosa di noi nel mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Forse un giorno la Voragine diventerà anche il nostro monumento commemorativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Le fosse, le valli e il sudore delle varie generazioni di minatori saranno una testimonianza della strada che abbiamo scelto di percorrere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Esattamente come questo monumento, questo luogo rimarrà qui per un altro centinaio d'anni, se non per un migliaio, dimostrando che nessun sacrificio avvenuto qui è stato vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Eheh, beh, ovviamente non vivrò abbastanza a lungo per vederlo succedere, ma per me sarà più che sufficiente se, in un futuro lontano, qualcuno verrà qui a brindare in nostro onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Sono anche rimasti fedeli a loro stessi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
