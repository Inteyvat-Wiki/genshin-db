			]
		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Eccoci all'ultimo baule. Non c'è bisogno di scrivere un rompicapo per questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Ma cosa sarà meglio mettere al suo interno...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Qualcosa di valore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Ha senso. Il contenuto di questo baule dovrebbe quantomeno ripagare lo sforzo intellettuale di chi ha risolto tutti i rompicapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "E, parlando di valore, la soluzione più logica sarebbero dei Mora, ovviamente. E Mora siano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "#Ok, questa serie di rompicapi è pronta. Grazie dell'aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Ecco, per ringraziarti del tuo impegno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "*sospira* Stavo pensando di discutere più approfonditamente con te in materia di rompicapi, ma prima devo tornare all'Akademiya per occuparmi di alcune questioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "#Se scoprirai degli strani nuovi rompicapi nei tuoi viaggi o ti bloccherai su uno di essi, sentiti liber{F#a}{M#o} di venirmi a trovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "In questo modo potremo discuterne in dettaglio insieme, e poi... inventare dei nuovi indovinelli per altri avventurieri! Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "#Addio, viaggiat{F#rice}{M#ore}. Abbi cura di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Spero che quella Cacciatrice di tesori, Narzam, non causerà nessun guaio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Qualcosa di utile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Utile? Mmmh... Cosa potrebbe essere sufficientemente utile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Oh, trovato! Qualche giorno fa qualcuno mi ha dato una ricetta. Mettiamola nel baule come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "La riflessione è il tesoro più grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Ahahahahah! Hai ragione! È proprio vero! Riflettere a fondo è davvero un'esperienza preziosa, senza prezzo! A confronto, tutto il resto non ha praticamente valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Non è per niente vero! Mettici dentro un po' di Mora, o magari una ricetta! Qualche ortaggio o un po' di frutta, almeno, ma non nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Scherzo, scherzo. È chiaro che ci metterò dentro qualcosa come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
