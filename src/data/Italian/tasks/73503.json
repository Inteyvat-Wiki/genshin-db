			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030301,
					"content": "\"Testa le acque salmastre meno profonde con questo ramo di saggezza.\"",
					"roleType": "TALK_ROLE_NPC",
