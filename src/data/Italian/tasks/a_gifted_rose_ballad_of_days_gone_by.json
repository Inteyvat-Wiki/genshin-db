				{
					"id": 732070401,
					"content": "Prova a sferrare degli <color=#00E1FFFF>attacchi contundenti</color> per rompere gli involucri pietrificati dei semi, poi usa il potere di <color=#00E1FFFF>Dendro</color> per risvegliarli.",
					"roleType": "TALK_ROLE_NPC",
