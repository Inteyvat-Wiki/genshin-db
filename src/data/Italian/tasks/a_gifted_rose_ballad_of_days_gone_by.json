			"dialogs": [
				{
					"id": 732060402,
					"content": "A proposito di Affan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "Eh? È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060404,
					"content": "Spieghi a Sabbah la situazione difficile che sta affrontando Affan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "Ora capisco perché vi occorra il mio aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060406,
					"content": "Sono onorata di essere stata la prima persona a cui abbiate pensato in una situazione del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060407,
					"content": "Detto questo, non essendo specializzata nella coltivazione di piante, ho poca esperienza al riguardo, quindi non sono sicura di poter essere d'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060408,
					"content": "Tuttavia, farò del mio meglio. E poi, la nuova varietà di rosa che sta coltivando questo signore mi interessa molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060409,
					"content": "Appena avrò un po' di tempo, andrò al vivaio di Affan. Mi troverete lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "Mi dispiace, zio Shafaqat. Non sono riuscito a esaudire il tuo ultimo desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "Chi è Shafaqat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "Ah, sì, siete voi che mi stavate assillando con le domande sul vecchio fantasma, dico bene? Beh, quello non è il suo vero nome. Voglio dire, nessuno si chiamerebbe davvero così, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "Gli anziani mi hanno detto che si chiamava Shafaqat. Quando era giovane, abbandonò la Città di Sumeru e giunse nel nostro villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "Dopo essere arrivato qui, costruì questa casa e ci visse da solo, e per decenni non uscì praticamente mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "Non l'ho mai visto quando era giovane, ma si dice che a quel tempo non disprezzasse ancora i bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "Coltivava molti alberi e fiori nel cortile di fronte e sul retro della sua casa. Ai bambini piaceva andarlo a trovare per chiedergli delle noci di Ajilenakh e per ascoltare le sue parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "Ma, quando lo incontrai, era già diventato vecchio. Era conosciuto come \"vecchio fantasma\", e aveva anche iniziato a disprezzare i bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "Dev'esserci un altro modo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "Quale altro modo potrebbe esserci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Zio Shafaqat... Se il vecchio fosse ancora vivo, potrei chiedergli se esistono dei metodi particolari per coltivare queste rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "Ma ora a chi potrei chiedere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "Conosco una ricercatrice della scuola di Amurta di nome Sabbah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "Oh, quella ragazza straniera. Può davvero aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "E poi, è già passata di qui una volta e l'ho cacciata via. Sarà ancora disposta ad aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "Perché non fare un tentativo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "Sei una brava persona. Non importa se non riesci a trovare qualcuno che possa aiutarmi. Basta il pensiero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "Perché ci tieni tanto a coltivare fiori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "Di tanto in tanto, dei forestieri sono obbligati a trasferirsi qui nel nostro villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Alcune persone non si abituano mai a vivere qui. Tuttavia, si sforzano di farlo, e così finiscono per rimanere sole per il resto della loro vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "Probabilmente sarà successo lo stesso al vecchio zio Shafaqat. Con il passare del tempo, tutti si sono abituati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "Ma, nonostante il passare degli anni, mi sono rifiutato di abituarmi a una cosa del genere. È davvero terribile quello che gli è successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "Se aveste potuto vedere il suo giardino, vi sarebbe piaciuto molto. Fiori incantevoli dai colori più disparati e alberi di varie altezze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "La persona che coltivava un giardino così meraviglioso se n'è andata senza lasciare un segno. L'unica cosa che la gente ricorda di lui è che \"il vecchio fantasma porta via i bambini cattivi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "Mi rifiuto di accettare una cosa del genere. Nei suoi appunti ha scritto che voleva che queste rose crescessero ovunque, e io voglio esaudire il suo desiderio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "Tanto sono già vecchio, quindi non mi interessa quello che gli altri pensano di me. Se ci riuscirò, la mia vita sarà stata degna di essere vissuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "Ho pulito la sua casa e ho sistemato la grande pila di libretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "Se vi interessa, posso mostrarvi qualche volume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "Metterò gli appunti <color=#00E1FFFF>davanti alla casa</color>, così che possa vedere la luce del sole che li attraversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "Eccovi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "Questa dev'essere la persona a cui avete chiesto di aiutarmi, giusto? Sono stato un po' brusco con lei qualche giorno fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "Mi dispiace... *sospira* Sono solo un uomo anziano e inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Beh, ora stiamo facendo una chiacchierata amichevole, no? Non prenderla così a cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070105,
					"content": "I semi sono germogliati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Il signor Affan e io siamo andati a dare un'occhiata. Purtroppo no, non ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070107,
					"content": "Stando a quanto ho potuto osservare, sembra che questi semi siano stati pietrificati, e le ragioni possono essere due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070108,
					"content": "La prima è che abbiano perso completamente la possibilità di crescere dopo un lungo periodo di erosione causata dagli agenti atmosferici, al punto da essersi pietrificati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070109,
					"content": "In tal caso, i semi non potranno germogliare. Tuttavia, le probabilità che questa ipotesi sia vera sono piuttosto basse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070110,
					"content": "Il processo di pietrificazione richiede tempi molto lunghi, e questi semi non soddisfano questo criterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070111,
					"content": "La seconda ragione è che questa varietà di rosa ha una forte affinità con Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070112,
					"content": "Ciò significa che, quando sono ancora dei semi, possono raccogliere sufficienti elementi di Geo per formare un guscio di pietra al loro esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070113,
					"content": "Se la suddetta ipotesi è vera, significa che questi semi possono essere conservati a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070114,
					"content": "Paimon... Paimon non riesce a capire. Intendi dire che i semi si sono trasformati in pietra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "Beh, allora suppongo che non abbiamo speranze: le rose dorate non possono sbocciare dalla pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "Rosa dorata? Ti riferisci alla rosa dorata di cui narra la canzone popolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070117,
					"content": "Oh, probabilmente voi non la conoscete. Nel villaggio è stata tramandata una canzone popolare sulla rosa, che fu originariamente composta dallo zio Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "Ha insegnato la sua canzone alla generazione precedente alla mia, che a sua volta l'ha insegnata ai propri figli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "Ci sono già persone della mia generazione che non hanno mai sentito parlare di questa canzone, e quando la nostra generazione non ci sarà più, nessuno si ricorderà più di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "\"Rosa, oh rosa, esaudisci il mio desiderio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "\"Sbocciando dalla pietra, la rosa dorata mi ha intonato un canto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "Proprio così... Possiamo far sbocciare la rosa dalla pietra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070123,
					"content": "Ti è venuto in mente qualcosa, Sabbah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "Come suggerisce la canzone, rompere il guscio di pietra farà germogliare i semi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070125,
					"content": "Di solito, bisogna creare un ambiente di coltivazione ideale per risvegliare i semi e permettere loro di rompere l'involucro da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070126,
					"content": "Ma questa varietà di rosa ha un involucro troppo resistente, e i germogli non riescono a romperlo da soli. Quindi possiamo provare a intervenire noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070127,
					"content": "Che ne pensi, Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070128,
					"content": "Intendi dire che dovremmo rompere gli involucri con la forza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Naturalmente faremo in modo di non distruggere completamente i semi. Occorre qualcuno di agile per fare una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, potresti farlo tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070131,
					"content": "Dovrò fare di nuovo il lavoro sporco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "Fai attenzione. Per prima cosa, sferra degli <color=#00E1FFFF>attacchi contundenti</color> per rompere gli involucri dei semi, poi usa il potere di <color=#00E1FFFF>Dendro</color> per risvegliarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070132,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Dopo aver atteso in silenzio per un po', dei giovani germogli spuntano lentamente dal terreno...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Wow, il metodo di Sabbah ha funzionato davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "Stanno germogliando! Finalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "A quanto pare, ora il desiderio di Shafaqat può finalmente essere esaudito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Affan, prima hai detto che lui coltivava questa varietà di rosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "Ma per poter coltivare una nuova specie, doveva essere un ricercatore in esilio qui, proprio come me, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "Sì... È stato esiliato in questo villaggio e ha vissuto tutta la sua vita in questa casa dietro di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Capisco. Probabilmente questo è il destino di tutti noi esiliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "A questo proposito, solo i migliori ricercatori possono coltivare nuove specie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "È un vero peccato che una persona come lui sia finita nel dimenticatoio, così lontano dall'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Stai pensando anche al tuo futuro, non è vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Su col morale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Già! Hai ancora molta strada e tantissime cose da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Non lasciarti sopraffare dalla malinconia, non vorrei trovarmi di fronte a un altro fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Hai ragione. È un bel momento, non dovrei essere triste. Ma ora torniamo a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "Queste rose dorate sono appena germogliate: vorrei osservarle finché non sbocciano. E voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Idem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Diamo loro il tempo di assorbire più sostanze nutritive. Rivediamoci qui dopo per guardarle sbocciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(Non so bene cosa dire per confortare Sabbah...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Non essere triste. Vedi, nonostante tutto, è riuscito comunque a lasciarci qualcosa: le rose dorate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Sono la prova che lo zio Shafaqat è davvero esistito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
