			"dialogs": [
				{
					"id": 732030619,
					"content": "Come vanno le cose al Villaggio di Aaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "Non mi lamento: ho da mangiare e un posto per dormire. Ho l'essenziale, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "Dopotutto sono stata esiliata, quindi non mi sognerei mai di avere libri e strumenti di ricerca qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "Questo posto è stato relegato agli studiosi esiliati già da un bel po'. La vita qui è dura e pragmatica, quindi, ovviamente, nessuno è interessato alla vita accademica o alla ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "Non sono di certo la prima esule e probabilmente non sarò nemmeno l'ultima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "Non posso far altro che accettare la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
