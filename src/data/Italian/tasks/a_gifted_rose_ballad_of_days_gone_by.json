				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Quanto mi manca questa vista... I tuoi regali sono pronti. Ecco a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900202,
					"content": "Sono dei semi di piante che non possono crescere qui. Se hai un giardino altrove, puoi piantarli lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900203,
					"content": "Ah, ho vagabondato a lungo... Ma mi sento bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900204,
					"content": "Prima che voi arrivaste qui, non avevo amici e mi sentivo così sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900207,
					"content": "Ci sono poche persone nel villaggio che si dedicano al giardinaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900208,
					"content": "...Anzi, non è del tutto vero. Un uomo anziano che vive a nord del villaggio ha arato un terreno per coltivare dei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900209,
					"content": "Gli ho fatto visita in passato. È un uomo anziano piuttosto eccentrico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900210,
					"content": "L'ho visto piantare delle pietre, ma lui insisteva che fossero dei fiori, e poi mi ha persino cacciata via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900211,
					"content": "Vive da solo, soffrirà sicuramente di solitudine. So cosa significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900212,
					"content": "Mi avete aiutato con le mie rose di Sumeru... Magari potreste aiutare anche lui con le sue piante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900213,
					"content": "Perché tu e Paimon non gli fate visita quando avete tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}