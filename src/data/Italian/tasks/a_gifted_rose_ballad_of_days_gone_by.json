			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030602,
					"content": "Ecco una rosa di Sumeru che ho raccolto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Quanto mi manca questa vista... I tuoi regali sono pronti. Ecco a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "Sono dei semi di piante che non possono crescere qui. Se hai un giardino altrove, puoi piantarli lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "Vuoi fare due chiacchiere? In effetti è da un po' che desidero parlare con qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "A proposito, quale darsana hai frequentato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Ah, potrei parlare per tre giorni interi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030607,
					"content": "Ero nell'Amurta e ho conseguito la specializzazione in evoluzione della flora, quindi il mio lavoro è di natura empirica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030608,
					"content": "Di conseguenza, in assenza di nuovi mezzi di prova, non è possibile neanche aspirare a raggiungere nuove conclusioni. Per dirla in parole povere, per esaminare le piante storiche occorre avere dei fossili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030609,
					"content": "Ma i campioni di fossili sono difficili da trovare, e l'Akademiya non fatica a procurarsene di nuovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030610,
					"content": "In circostanze così complicate, l'istituto pretendeva comunque che presentassimo dei risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030611,
					"content": "E così, alcune persone si limitavano quindi a rispolverare vecchi studi, ad arricchirli di qualche dettaglio e a consegnarli poco dopo. Piuttosto inutile, non credete anche voi??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030612,
					"content": "A dire il vero, se cercassimo informazioni nella storia e nella geografia, riusciremmo sicuramente a fare nuove scoperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030613,
					"content": "Inoltre sarebbe possibile sfruttare quei documenti che l'Amurta ha ignorato, anche se questo vorrebbe dire invadere il campo della Vahumana e dell'Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030614,
					"content": "Non ho mai brillato nei loro campi di specializzazione, e non è stato semplice richiederne i documenti... Per non parlare di una collaborazione con i loro ricercatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030615,
					"content": "Non riesco però a togliermi dalla testa l'idea che un lavoro di concerto darebbe risposta a molte domande del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030616,
					"content": "È un peccato che non si sia riuscito a continuare la nostra collaborazione. Anche se devo ammettere che quelli delle scuole di Vahumana e Haravatat hanno idee e punti di vista molto particolari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030617,
					"content": "Ogni volta che consegnavo loro un lavoro, dovevo prestare la massima attenzione al modo di esprimermi e alla scelta delle parole per evitare fraintendimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030618,
					"content": "Quando hanno deciso di espellermi dall'Akademiya, ero nel mezzo di una discussione con qualcuno dell'Haravatat. Ora non mi è più concesso neanche questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Ah, ho vagabondato a lungo... Ma mi sento bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Prima che voi arrivaste qui, non avevo amici e mi sentivo così sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Ci sono poche persone nel villaggio che si dedicano al giardinaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "...Anzi, non è del tutto vero. Un uomo anziano che vive a nord del villaggio ha arato un terreno per coltivare dei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Gli ho fatto visita in passato. È un uomo anziano piuttosto eccentrico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "L'ho visto piantare delle pietre, ma lui insisteva che fossero dei fiori, e poi mi ha persino cacciata via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "Vive da solo, soffrirà sicuramente di solitudine. So cosa significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Mi avete aiutato con le mie rose di Sumeru... Magari potreste aiutare anche lui con le sue piante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Perché tu e Paimon non gli fate visita quando avete tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
