			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Rosa, oh rosa, esaudisci il mio desiderio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Sbocciando dalla pietra, la rosa dorata mi ha intonato un canto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "Così ha cantato:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"Non la terra mi è natia, lo è una melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "La sorte verrà sfidata, e cambierà ciò a cui sono destinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "Andrà oltre me, andrà oltre il tempo. Non sarà scalfita da vecchiaia o appassimento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "Questa è la canzone che Shafaqat ci insegnò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
