	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Mitsunari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Perché ho abbandonato il dojo per diventare l'istruttore di Lord Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100102,
					"content": "Yanagiha, Okazaki e Mifune... perché mi hanno lasciato, tutti quanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Mitsunari"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "...Adesso ci manca soltanto la lama di Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "La spada ancestrale Hakuen Michimitsu Amenoma del clan Iwakura, uh... Di', ricordi quella volta poco dopo che tu e Kunihiko foste adottati, mentre il maestro Eiin non guardava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Siamo già stati espulsi. Non c'è bisogno di continuare a chiamarlo \"maestro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Ma Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "\"Tra l'affetto e la rettitudine, la bilancia del vero spadaccino penderà sempre dal lato della rettitudine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Queste sono state le parole del maestro, il che significa che non voleva espellerci. È solo che non ha avuto scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Certo che non voleva. Ma, avendo già deciso di diventare la lama della Shogun e di applicare il Decreto di caccia alle Visioni, possiamo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Possiamo solo incamminarci sulla nostra retta via. Dopotutto, un vero spadaccino sceglie sempre il sentiero della rettitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Eppure, infine la rettitudine del maestro è stata sconfitta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "È così. Dobbiamo vendicarli tutti. Kunihiko, gli altri... persino Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Tale è la rettitudine dei discepoli espulsi quali siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Deve anche essere la benedizione del maestro. Eccoci servito il nostro primo oggetto di vendetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Hai ragione. Tu devi essere {NICKNAME}. Ho sentito parlare della tua storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "#Nel mondo degli spadaccini, solo il sangue può lavare via altro sangue. Immagino che tu sia pront{F#a}{M#o} ad affrontare l'ex Menkyo Kaiden dell'Arte Iwakura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Mitsunari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Perché ho abbandonato il dojo per diventare l'istruttore di Lord Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100302,
					"content": "Yanagiha, Okazaki e Mifune... perché mi hanno lasciato, tutti quanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100303,
					"content": "Ho incontrato i discepoli dell'Arte Iwakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Ah, sì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100305,
					"content": "C'è ancora qualcuno che afferma di provenire da Iwakura? Il loro maestro era un tale incompetente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100306,
					"content": "Sono Iwakura Mitsunari. Puoi considerarmi un istruttore dell'arte della spada. E tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100307,
					"content": "#Sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... li hai visti? E i fratelli Okazaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100309,
					"content": "Ah, già, c'è anche Katayama. Gli è sempre piaciuto battezzare gli incontri prima di iniziare a duellare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100310,
					"content": "Così, diceva, \"potranno essere tramandati nelle storie, quando sarò uno spadaccino provetto\". Ahahah, quante stupidaggini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100311,
					"content": "Per non parlare di Shimada, che ha passato le intere ere \"Nagatane\" ed \"Eiib\" ad allenarsi senza mai riuscire a superare il grado di Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100312,
					"content": "Non hanno potuto nulla contro il Decreto di caccia alle Visioni della Shogun onnipotente, così sono fuggiti, diventando banditi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100313,
					"content": "Mi mancano i bei giorni andati in cui potevo insegnare loro come brandire la spada. Perché mai ho chiuso il dojo e mi sono unito all'esercito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, cosa pensi delle loro capacità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100315,
					"content": "Mi dispiace dirlo, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100318,
					"content": "#Ma, {NICKNAME}, chi è il tuo maestro? Domon? O Shousen? O forse la stessa Narukami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100319,
					"content": "#Considerami un{F#'}{M# }autodidatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100321,
					"content": "#Sembra che l'Arte Iwakura sia tramontata sotto il mio comando. Nessuno dei miei studenti è stato in grado di sconfiggere un{F#a}{M#o} spadaccin{F#a}{M#o} autodidatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "È così? Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100324,
					"content": "Qualunque sia stata la tua scuola, non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100325,
					"content": "#Sembra che l'Arte Iwakura sia tramontata sotto il mio comando. Nessuno dei miei studenti è stato in grado di sconfiggere un{F#a}{M#o} che non vuole neanche rivelare il nome della sua scuola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100326,
					"content": "Sono proprio un incompetente come maestro dell'Arte Iwakura. Da spadaccino sono conosciuto come Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100327,
					"content": "Anche se ho dimenticato la chiave della nostra tecnica segreta con la lama e la mia Visione è stata ceduta alla Shogun onnipotente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100328,
					"content": "Se mi chiedessi se voglio ancora vendicare i miei discepoli che non hanno sopportato di vedermi in ginocchio e sono finiti a inseguire fantasmi malvagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100329,
					"content": "Degli incompetenti che tu hai sconfitto... Allora sì, in me brilla ancora una fiamma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100330,
					"content": "#Non c'è abbastanza spazio. Nemmeno tu riusciresti a mostrare le tue doti di spadaccin{F#a}{M#o} qui. Vieni, seguimi quaggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100316,
					"content": "Ho imparato parecchio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}