			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "...Miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Polverino"
				},
				{
					"id": 705430103,
					"content": "...Oh, voi. Io parla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Parli... Razor, stai parlando con Polverino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Miao, miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Polverino"
				},
				{
					"id": 705430106,
					"content": "Sembra che Polverino stia dicendo... \"Esatto\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Odore familiare, cerca amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Bene. Felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Miao, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Polverino"
				},
				{
					"id": 705430110,
					"content": "Amici hanno fiutato traccia. Anche tu qui, felice. Su te, odore di vento e pioggia, molto familiare... Odore di gatti, anche familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, odore molto dolce. Piace molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Eh?! Dolce... Non sarà mica l'odore dei pancake che ci ha dato Valerina? Paimon ne ha mangiati così tanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "Ti ho dato metà della mia porzione, non ricordi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Davvero? Paimon non se n'è neanche accorta... Mmm, è colpa dei pancake che sono così deliziosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Eheh, e Paimon vuole anche mangiare del pollo ai Fiordolci, delle bistecche e delle frittelle di patate... Oh, e bere del sidro di mele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#Ok, questo sarà il menù per la prossima volta! Dai, {NICKNAME}, andiamo a ordinare qualcosa da Valerina! Vieni anche tu, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Grazie... Grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Polverino portato me tante... noci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "E scatole di carne... Io molto pieno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Sembra che Valerina abbia ordinato d'asporto. Razor, è stato Polverino a consegnarti il cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Miao miao. Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Polverino"
				},
				{
					"id": 705430123,
					"content": "Paimon non avrebbe mai immaginato che i gatti avrebbero finito col prendersi cura dei clienti, qui alla Rocca Gattosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "Sembra proprio che tu piaccia ai gatti, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "Potresti mangiarne il triplo di quelli che hai mangiato senza problemi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}