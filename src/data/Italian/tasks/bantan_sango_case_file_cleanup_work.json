			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada",
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#Mmmh? Tu sei... {F#la}{M#il} viaggiat{F#rice}{M#ore}, giusto? Amano mi ha parlato di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Volevi vedermi per qualche motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Questo è da parte di Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Oh, sono mochi ai fiori di sakura... Beh, allora non posso mangiarli come se niente fosse. Devo trovare un bel posto per gustarmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, per favore, prendi il mio posto per un po'. Se qualcuno viene a cercarmi, digli di aspettare un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Ma siamo in orario di lavoro, signor Owada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Ahahah, non importa. Esco solo a prendere un po' d'aria, torno subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "*sospira* Ok... ma torna presto. Se arrivasse qualcuno dei superiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Non preoccuparti, abbiamo appena risolto un caso. Perciò, se arriva qualcuno, sarà solo per lodarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Allora, lascio tutto nelle tue mani, Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "#Viaggiat{F#rice}{M#ore}, vieni con me. Conosco un posto perfetto per gustarci questi mochi ai fiori di sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202005",
							"2"
						],
						"stepId": 2202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Ah... Proprio un bel posto, non trovi? Vengo spesso qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "La vista è bella e l'aria è fresca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Se hai qualcosa da chiedermi, ora è il momento di farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Sei anche tu un ex collega di Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Te l'ha detto Ryuuji? Sì, Ryuuji e io abbiamo lavorato insieme, una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Non so se Ryuuji ti ha parlato di quello che è successo allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Per farla breve, Ryuuji è stato troppo impulsivo. È finito in una trappola ed è diventato il capro espiatorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Ho garantito per lui, ma il giudice ha insistito affinché venisse condannato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Ho chiesto a molte persone di aiutare con le indagini, ma finivano tutti per tornare a mani vuote o mi dicevano di lasciar perdere le indagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Eh. Allora... Come dire... ho dato ascolto agli avvertimenti e non ho indagato oltre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "È un \"segreto\" che tutti sanno, proprio come il fatto che Ryuuji è stato accusato ingiustamente, perciò non importa se te lo dico o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Però, dato che lo sanno tutti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Ah, è proprio perché lo sanno tutti che nessuno osa interferire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Per fortuna, un'investigatrice che era fuori dal giro è passata per caso dalla stazione di polizia per questioni lavorative e si è interessata al caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Grazie a quell'investigatrice, il caso è stato finalmente risolto e il nome di Ryuuji è stato riabilitato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Ryuuji ha lasciato la stazione di polizia e, da allora, lavora per quell'investigatrice. Ecco a voi la storia completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Perché mi stai raccontando tutto questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Chi ti ha chiesto di portarmi questo regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Sono certo che questo regalo sia opera di Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Dato il carattere di Ryuuji, se Sango gli avesse chiesto di consegnare personalmente il regalo, me lo avrebbe consegnato anche in condizioni estreme, persino se fossi stato intrappolato in un mare di fuoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Ma Ryuuji ti ha chiesto di consegnare il regalo a me, e ciò significa che è stata Sango a chiedergli di fartelo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Allora, Sango voleva che io lo sapessi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "#Ahahah, vedo che neanche tu sei una lumaca. La tua presenza qui significa che Sango vuole dirmi: \"ho {F#una}{M#un} {F#nuova}{M#nuovo} aiutante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "A quanto pare, non ha superato ciò che è successo allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Ma in realtà, non mi sorprende. Dopotutto... non ha ancora scoperto chi abbia posizionato quella trappola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Beh, ti ho detto tutto ciò che potevo. Decidi tu se vuoi unirti a Sango o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Oh, e ringrazia Ryuuji per i mochi ai fiori di sakura da parte mia. Mi sono sempre piaciuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Perché Ryuuji ha lasciato la polizia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "È stata una sua scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
			"completionStepIds": [
				2202006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202006",
							"2"
						],
						"stepId": 2202006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "#Scusa per il disturbo, viaggiat{F#rice}{M#ore}. Hai consegnato i regali a tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "È stata Sango a organizzare tutto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "L'hai scoperto? Mi dispiace... È stata un'idea di Sango farti consegnare quei dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Sango ha detto che sarai indispensabile per risolvere quel caso e scoprire il vero colpevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Il caso non è ancora stato risolto del tutto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Non ancora. Sango ha detto che, allora, tutto riconduceva in modo perfetto al \"colpevole\". Troppo perfetto, in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Quando Sango ha iniziato le sue indagini, tutti gli indizi, i moventi e le prove sono finiti dritti nelle sue mani e riconducevano a quel \"colpevole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Quella persona è stata detenuta come colpevole dalla polizia, ma Sango credeva che il vero colpevole fosse qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Credo che mi abbia portato a lavorare con lei per avere una possibilità di risolvere quel caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Ma cosa potrò fare mai io per aiutare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Non riesco... a interpretare le intenzioni di Sango. Ma mi ha accennato che l'essere rimasta a Inazuma per tanto tempo potrebbe finire per metterle il paraocchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Se ad aiutarci ci fosse qualcuno di esperto con un modo di vedere le cose del tutto nuovo, forse potrebbe portarci a una svolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "#Viaggiat{F#rice}{M#ore}, forse Sango crede che tu sia la persona giusta per aiutarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "#Quindi, suppongo di essere anch'io {F#un'investigatrice}{M#un investigatore} ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Se ti va di aiutarci, allora certo che lo sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "Hai aiutato tanto la nostra agenzia, perciò, ti chiedo di accettare il pagamento anticipato, stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Anche stavolta Sango ti ha detto cosa dire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "No, queste sono tutte parole mie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Grazie ancora del tuo aiuto. Vieni pure più spesso, se vuoi. Sono certo che anche Sango gradirà la tua presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Immagino che questo caso paghi bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Non posso darti una cifra, ma la paga sarà buona, ne sono sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "È questo il crimine perfetto di cui parlava Sango?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Esatto. Una volta, Sango mi ha detto che, allora, tutto riconduceva in modo perfetto al \"colpevole\". Troppo perfetto, in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Quando Sango ha iniziato le sue indagini, tutti gli indizi, i moventi e le prove sono finiti dritti nelle sue mani e riconducevano a quel \"colpevole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Quella persona è stata detenuta come colpevole dalla polizia, ma Sango credeva che il vero colpevole fosse qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Avresti potuto semplicemente dirmi cos'era successo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
