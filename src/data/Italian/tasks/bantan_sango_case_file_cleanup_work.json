				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#Oh, non pensavo di incontrarti qui, viaggiat{F#rice}{M#ore}. Sango aveva ragione sul fatto che ci saremmo incontrati ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Sango mi ha chiesto di finire il lavoro dell'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Che consiste solo nel portare dei dolci ai doushin per ringraziarli dell'assistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Dovrebbero essere loro a ringraziare noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "È vero. Beh, è solo una scusa per migliorare il nostro rapporto con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Dopotutto, la nostra agenzia investigativa potrebbe avere bisogno del loro aiuto, un giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Sembra proprio ciò che direbbe Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Ahah, sì. Il tuo intuito è eccellente come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Allora, cosa ne pensi di tutto questo, personalmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Io? Amano e Andou... Una volta eravamo colleghi, perciò è normale dimostrare loro gentilezza con dei dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Ma... Sango mi ha chiesto di indagare su un'altra questione, oggi, perciò sono un po' stretto coi tempi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarmi a consegnare questi dolci a tre persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Ecco i pacchetti con i dolci per Amano, Andou e Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Owada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Anche lui è... un mio ex collega. È stato gentile con me, prima che lasciassi il corpo di polizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Ci ha anche aiutati a collaborare con la polizia per il precedente caso di furti seriali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "#Allora ti lascio al tuo incarico, viaggiat{F#rice}{M#ore}. Dopo che avrai consegnato i dolci, ci ritroveremo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Credo sarebbe meglio se fossi tu a consegnarli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Ma... la richiesta di Sango è più importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Troverò il tempo per far visita a loro tre più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Dev'essere una cosa che ti ha insegnato Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Non siamo noi quelli che hanno aiutato loro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202002",
							"2"
						],
						"stepId": 2202002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amano",
					"Andou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "#Oh, sei tu, viaggiat{F#rice}{M#ore}... Come mai sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Questo è da parte di Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Oh? Vediamo... Oh, mochi ai fiori di sakura... Ah, quel Ryuuji, non doveva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "#Ehi, Andou. Smettila di essere così sospettoso. {F#La}{M#Il} viaggiat{F#rice}{M#ore} non sarà di qui, ma ci ha aiutati da poco, o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Mi sorprende che Ryuuji si ricordi ancora cosa ci piace. Essere suoi colleghi ha di certo i suoi vantaggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "Lavoravate insieme a Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "Mmmh? Non te l'ha mai detto? Siamo stati suoi colleghi per un breve periodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Ma poi, è stato improvvisamente coinvolto in un certo incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Grazie a Sango, il vero colpevole è stato acciuffato e Ryuuji è stato esonerato. Successivamente, ha lasciato la stazione di polizia ed è andato a lavorare per Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Questo è tutto quello che so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Ok, credo non ci sia altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "È vero. E comunque, si trova molto meglio con Sango piuttosto che con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "Se potessi, anche io vorrei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "Ehi, dai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "#Ehm! Comunque, grazie, viaggiat{F#rice}{M#ore}. Accetto questi dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Salutami Ryuuji e Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
