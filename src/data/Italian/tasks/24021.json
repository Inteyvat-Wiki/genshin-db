			"dialogs": [
				{
					"id": 240210501,
					"content": "#Ottimo! È proprio quello che volevo, grazie mille! Mi sei stat{M#o}{F#a} di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210502
