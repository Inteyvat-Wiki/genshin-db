				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Ahia... Perché questo scatolone è così pesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "#Ci incontriamo di nuovo, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}. Mi dispiace... Credo... Credo di essermi fatta male alla schiena, ho un dolore tremendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Volevo spostare lo scatolone qui per riordinare la documentazione che c'è dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "N-Non avrei mai immaginato che fosse così pesante. Ho perso l'equilibrio mentre lo sollevavo e tutto il peso mi è piombato sulla vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Credo di... essermi rotta qualcosa, ahi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Vuoi che ti accompagni dal dottore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "No, non c'è bisogno... Non è la prima volta che mi faccio male alla schiena, devo solo riposare un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Chissà quanti fascicoli dovrà contenere per essere così pesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Beh, immagino che ne contenga un sacco. Fino a qualche tempo fa, l'Istituto adottava la procedura del \"documenta tutto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "In pratica, qualsiasi cosa all'interno dell'Istituto doveva essere registrata su carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Dopo aver introdotto questa prassi, il consumo di carta dell'Istituto è quintuplicato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "I fascicoli erano così tanti che ogni ufficio ha dovuto creare una postazione di \"gestione documenti\" solo per classificare e ordinare tutta la documentazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Vuoi dire che bisognava scrivere tutto? Sembra un'enorme scocciatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "E lo era! Con il tempo, questo metodo di lavoro è stato abbandonato e ormai viene adottato solo in certi casi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "#Ma per ora lasciamo perdere questo argomento... Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}, potresti aiutarmi con lo scatolone? Anche se mi sono fatta male alla vita, i fascicoli vanno comunque riordinati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Tu cerca di riprenderti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Non preoccuparti, mi bastano le mani per sistemare i documenti, non corro più il rischio di farmi male ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Posso chiamare qualcuno che venga ad assisterti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
