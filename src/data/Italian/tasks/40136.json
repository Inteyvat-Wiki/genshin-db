			"dialogs": [
				{
					"id": 401360101,
					"content": "Passa un po' di tempo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "#Ehilà! Ciao, {F#ragazze}{M#ragazzi}. Scusate se non mi sono fatto granché vivo: da quando è finita la post-produzione, sono stato impegnatissimo con la campagna promozionale per l'uscita del film...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "La cerimonia di premiazione è oggi, vero? Chissà se vinceremo davvero noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "C'è una possibilità del novantanove per cento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Paimon non sapeva che fossi già qui. Sei venuta prima di tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Gli altri di certo non tarderanno ad arrivare. Uhm... Xavier, nel caso ci invitassero a salire sul palco, non credi che la nostra troupe dovrebbe avere un nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Eh?!? Ma non sappiamo neanche se vinceremo davvero. Non vorrei gufarcela, se iniziamo a fantasticare già da ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Suvvia, apri gli occhi! Hai visto la reazione del pubblico al nostro film, no? Siamo stati acclamati da chiunque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Hai anche parlato col personale del teatro, giusto? Non hanno detto di voler aumentare il numero di proiezioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Coi Mora che hai guadagnato al botteghino, ora hai la possibilità di aprire una compagnia cinematografica tutta tua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "M-Ma il merito è dell'intera troupe! Avete fatto tutti un lavoro eccezionale, non è giusto che sia io l'unico a dover pensare a un nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Beh, tu pensaci. La troupe rispetterà di sicuro la tua decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Va bene... Ma prima di questo, {NICKNAME} e Paimon, posso chiedervi di passare un attimo a Forte Méropide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Eh? Ma non dovremmo restare per la premiazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Volevo chiedervi di invitare Chevreuse a unirsi a noi. È pur sempre una delle attrici protagoniste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Ultimamente non sono riuscito a reperirla, e non ho avuto l'opportunità di invitarla di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Stando ai documenti, i colpevoli dell'omicidio con i moschetti saranno accompagnati a Forte Méropide oggi dalla capitana della Pattuglia speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Ah, ora Paimon capisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Sarà una passeggiata, per noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Esattamente! Aspettaci qui, Xavier, e intanto fatti venire in mente qualche bel nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Ottimo, allora mi affido a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
