					"nextDialogs": [
						401360303
					],
					"speakerTitle": "Presentatrice del Cinefestival"
				},
				{
					"id": 401360303,
					"content": "Abbiamo vinto! Abbiamo vinto per davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360304,
					"content": "Congratulazioni, signor Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360305,
					"content": "Abbiamo vinto... Non ci credo. Io... Io... non so proprio come ringraziarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360306,
					"content": "Visto? Non mi sono mai sbagliata sull'industria dell'intrattenimento di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360307,
					"content": "E ora diamo il benvenuto sul palco al produttore di \"Le due moschettiere\", Monsieur Xavier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Presentatrice del Cinefestival"
				},
				{
					"id": 401360308,
					"content": "Grazie... Grazie a tutti di cuore per la stima e il sostegno. Giacché sono quassù, ci tengo a fare un ringraziamento speciale a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360309,
					"content": "Il tempo vola, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360310,
					"content": "In effetti è così. Sembra ieri che mi stavi insegnando a maneggiare il moschetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360311,
					"content": "Tornerai a Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360312,
					"content": "Ma certo! Questa città mi è entrata nel cuore. Ho scoperto così tante cose nuove e interessanti che non riesco neanche a ricordarle tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360313,
					"content": "E tu, invece? Ti andrebbe di venire in visita a Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360314,
					"content": "Non posso dire che il pensiero mi sia mai passato per la testa ma... ora sarei disposta a prenderlo in considerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360315,
					"content": "Allora ti aspetterò con impazienza. Mi piacerebbe tanto ospitarti a casa mia e farti assaggiare il nostro tè e i nostri dolci tipici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360316,
					"content": "Certo, restiamo in contatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360317,
					"content": "Ha raggiunto lo scopo che si era prefissato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360318,
					"content": "Certo. E tu dovresti fare un salto a Inazuma, di tanto in tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360319,
					"content": "Come se la sta cavando Ogura con la sua attività?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360320,
					"content": "Piuttosto bene, a quanto ne so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360321,
					"content": "La saluti tanto da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360322,
					"content": "Non mancherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360323,
					"content": "Ho saputo che la tempesta è cessata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360324,
					"content": "Sì, e la guerra è finalmente giunta al termine. Le isole sono di nuovo in pace e prospere come un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360325,
					"content": "Mi fa davvero piacere, sembra il tempo perfetto per stendere i tessuti ad asciugare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360326,
					"content": "Ringrazio di nuovo tutto il cast e la troupe. Senza di loro, il film non sarebbe mai nato, e io non avrei avuto l'opportunità di salire su questo palco oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360327,
					"content": "Col sostegno della mia intera troupe, approfitterò di quest'occasione per annunciare il nome della nostra compagnia cinematografica: la \"Moschettieri Film\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360328,
					"content": "Ooh, suona proprio bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360329,
					"content": "Allora, in tal caso, diamo il benvenuto sul palco ai membri della Moschettieri Film per una foto commemorativa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Presentatrice del Cinefestival"
				},
				{
					"id": 401360330,
					"content": "Ah! Paimon non sapeva che avremmo fatto delle foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360331,
					"content": "Mademoiselle Furina, credo che nessuno più di lei meriti di alzare questo trofeo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360332,
					"content": "Eh? No, no, no... Non ce n'è bisogno... Che imbarazzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360333,
					"content": "È un onore riservato alla Regista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360334,
					"content": "Sì, concordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360335,
					"content": "Credo che nessuno più di te meriti un tale onore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Mi sa proprio che non ha altra scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360337,
					"content": "Tutti pronti? Tre, due, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Presentatrice del Cinefestival"
				},
				{
					"id": 401360338,
					"content": "Moschettieri Film!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
