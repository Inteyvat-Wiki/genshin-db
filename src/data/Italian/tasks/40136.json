				]
			},
			"dialogs": [
				{
					"id": 401360201,
					"content": "Io non posso accompagnarli oltre questo punto. Li affido a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360202,
					"content": "Qualche impegno impellente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360203,
					"content": "Diciamo così. Mi aspettano a una festa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360204,
					"content": "Questa è una cosa che non mi aspettavo di sentire. Hai trovato un nuovo passatempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360205,
					"content": "No, è solo un'occasione speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360206,
					"content": "Chevreuse, Wriothesley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360207,
					"content": "Allora è vero che le festività riuniscono le persone. Era un bel po' che non ricevevo così tante visite a Forte Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360208,
					"content": "È lo spirito della Festa di Fontinalia, suppongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360209,
					"content": "Sì, puoi dirlo forte. Perfino la nostra caposala è tutta presa dalla preparazione dei suoi frullati ad alto tasso nutrizionale... Ne basta un sorso e sei a posto per il resto della giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360210,
					"content": "Stavate parlando di lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360211,
					"content": "Avevamo appena finito di prendere accordi. Allora, che ne pensi del mio \"consiglio\", Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360212,
					"content": "Mmh. Non credo di aver promesso o garantito niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360213,
					"content": "Ma non hai nemmeno rifiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360214,
					"content": "Facciamo così: daremo a tutti una copia del giornale. Magari proprio il giorno in cui apparirà in prima pagina un articolo che parla... dei misfatti compiuti da una certa persona vent'anni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360215,
					"content": "Uhm. E, a quel punto, un tale di nostra conoscenza potrebbe diventare la persona più sfortunata di Forte Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360216,
					"content": "E, allo stesso tempo, altre due persone potrebbero essere accolte come eroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360217,
					"content": "#Parlando di eroi, siete {F#venute}{M#venuti} qui per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360218,
					"content": "Oh, ehm, a dire il vero noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360219,
					"content": "Siete qui per invitarmi alla festa, giusto? Non vi preoccupate, non me ne sono dimenticata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360220,
					"content": "Ooh, allora torniamo subito indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360221,
					"content": "Alla prossima, Wriothesley! Buona Festa di Fontinalia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360222,
					"content": "Altrettanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
