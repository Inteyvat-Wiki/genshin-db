			"dialogs": [
				{
					"id": 401360301,
					"content": "E il vincitore del Prix Furina della prima edizione del Cinefestival di Fontinalia è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
