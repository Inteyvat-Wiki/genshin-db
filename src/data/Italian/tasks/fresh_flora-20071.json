			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "In che stato sono i fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "Mi dispiace...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Eh? Che è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "Per sbaglio ho rovinato i fiori e il contenitore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "P-Per sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "Uff... Avevo scelto appositamente quei fiori. Fiori del genere non si trovano ovunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "#Il Picco del Drago è davvero pericoloso se neanche {F#un'avventuriera}{M#un avventuriere} come te è in grado di proteggere un contenitore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "Comunque, grazie per avermi aiutata. Ti prego di prendere questo in segno di riconoscenza. Ora, se vuoi scusarmi, devo prendermi cura dei miei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "*sospira* Forse dovrei provare il metodo suggerito da Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
