			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710101,
					"content": "In che stato sono i fiori che abbiamo conservato prima sul Picco del Drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "#Sono riuscit{F#a}{M#o} a recuperarne solo uno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "Gli altri non potevano essere recuperati? Mmh... Va bene, allora. Dopotutto, è piuttosto difficile prevedere le condizioni su quella montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Ma se abbiamo solo un contenitore, non possiamo fare alcun confronto. Suppongo che dovremo aspettare un'altra occasione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Grazie per il disturbo, comunque. Ecco, ho una ricompensa per te... Potrei aver bisogno nuovamente del tuo aiuto, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
			"completionStepIds": [
				2007109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
