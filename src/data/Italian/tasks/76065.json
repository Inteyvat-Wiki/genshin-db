					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Eccoti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650102,
					"content": "Colombina... Sei qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "Mh. E ora ci sei anche tu, perciò suppongo che siamo qui insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650104,
					"content": "#Parli come se sapessi che sarei {F#venuta}{M#venuto}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Non sapevo quando, ma sapevo che l'avresti fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650106,
					"content": "Proprio come c'è sempre un legame tra la luna e Teyvat, tu troverai sempre il modo di venire da me, non è forse così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650107,
					"content": "Vieni, siediti un po' vicino a me. Ti ho tenuto il posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650108,
					"content": "#L'ultima volta che ci siamo {F#sedute}{M#seduti} sulla tua astronave, stavamo guardando Teyvat. Questa volta guardiamo le stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650109,
					"content": "Ninnin e coloro che sono venuti prima di lei erano attratti da quegli astri. Dev'esserci un altro tipo di gravità laggiù. Riesco a percepirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650110,
					"content": "Ninnin e il messaggio che ha mandato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Non preoccuparti, non è in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650112,
					"content": "Ha viaggiato molto, molto lontano e in modo sicuro. È andata così lontano che non riesco più a percepire il potere che ho usato per guidarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650113,
					"content": "Ma... sono curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650114,
					"content": "Riguardo a cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "A tutto. Per esempio... Un messaggio dalla Miraluna verrebbe mai ricevuto da qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650116,
					"content": "Chiunque... o qualsiasi cosa lo riceva... chi potrebbe essere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650117,
					"content": "Cosa penserebbero? Conoscerebbero l'amore e l'odio come noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650118,
					"content": "Anche loro, come noi, sarebbero ancora attratti dal cielo stellato, bello e misterioso, pur essendo circondati dall'abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650119,
					"content": "Anche loro, come noi, vorrebbero cercare altre persone, salutarle e dire loro: \"Ciao, è un piacere conoscerti\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650121,
					"content": "Là fuori, nelle profondità di questo cielo trapunto di stelle... esistono ancora civiltà che non sono state toccate dall'oscurità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650122,
					"content": "Penso di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650124,
					"content": "Una volta la nostra astronave ha ricevuto un messaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Di che tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650126,
					"content": "Quasi tutto il suo contenuto effettivo è andato perduto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Ma doveva provenire da una civiltà intelligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Perduto... Forse perché aveva viaggiato troppo a lungo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650129,
					"content": "Comunque, anche solo questo è incoraggiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650130,
					"content": "#A proposito, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650131,
					"content": "Mh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "#Anche il luogo in cui sei {F#nata}{M#nato}... deve trovarsi là fuori, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650133,
					"content": "#Se un giorno decidessi di tornare al luogo da dove sei {F#partita}{M#partito}, per dargli una ripulita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650134,
					"content": "Sarei felice di darti una mano. Come tu hai aiutato me a ripulire la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650135,
					"content": "Allora farò in modo d'invitarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "E organizzeremo un'altra festa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650137,
					"content": "Organizzeremo un'altra festa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650139,
					"content": "Che ne pensi di chiamarla \"Notte del ritorno a casa\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650140,
					"content": "E se fosse di giorno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Allora festeggeremo tutto il giorno fino al cadere della notte. Possiamo invitare tutti i nostri più cari amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650142,
					"content": "Sembra che sarà molto divertente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Speriamo che quella notte arrivi sotto un cielo limpido... con gli amici riuniti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		}
	]
}