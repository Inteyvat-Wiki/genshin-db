					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "Ah, sei anche tu qui per scattare delle foto? Sono già venuti dei turisti stranieri che volevano fare lo stesso. Dopotutto, quell'isola fluttuante è uno spettacolo per gli occhi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "È un peccato che prima non avessimo una Fotokamera. Ho dovuto chiedere a un mercante straniero di procurarmene una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "#Che ne dici, {F#cara ospite}{M#caro ospite}? Ti va di scattare una foto? Ma dovrai farlo tu, dato che le mie mani non sono molto ferme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Strano, c'è la nebbia sul mare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "La nebbia? In che senso? Non può esserci la nebbia con una brezza così forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "In vita mia non ho mai visto il mare coperto dalla nebbia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Per caso hai confuso questo posto con la zona avvolta nella nebbia sulla quale si stagliano i Monti Tezcatepetonco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Forse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "#Eheh, secondo me sei solo troppo {F#tesa}{M#teso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "Dovresti rilassarti! Stai visitando Natlan, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				}
			]
		}
	]
