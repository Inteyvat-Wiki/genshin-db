			"dialogs": [
				{
					"id": 742230401,
					"content": "Uh... Non ho mai pensato che si potesse fare in questo modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "#Incredibile, davvero. Per caso sei mai {F#stata}{M#stato} al servizio del nostro Dio re?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Anche il nostro grande ufficiale elogia la tua prestazione! A quanto pare ho ancora tanta strada da fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
