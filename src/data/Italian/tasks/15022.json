					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220505,
					"content": "Perché non si è unita a noi e basta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220506
					]
				},
				{
					"id": 150220506,
					"content": "Probabilmente non vuole avvicinarsi troppo agli umani... O magari è per causa mia. Ma ora ci serve la sua potenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220507
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220507,
					"content": "Graooor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220508
					],
					"speakerTitle": "Coya"
				},
				{
					"id": 150220508,
					"content": "Woah! Non hai nemmeno dovuto chiamarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220509,
					"content": "...Graoor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220510
					],
					"speakerTitle": "Coya"
				},
				{
					"id": 150220510,
					"content": "Sì, lassù... Probabilmente è lì che tengono Chime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220511
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220511,
					"content": "Bene. Andiamo a fare una bella chiacchierata con questo Tepal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
