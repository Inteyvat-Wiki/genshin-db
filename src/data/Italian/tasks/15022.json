			"dialogs": [
				{
					"id": 150220501,
					"content": "#Ha funzionato davvero... Però, ora come fanno Paimon e {NICKNAME} a salire là sopra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220502,
					"content": "#Coya può darvi un passaggio. Ci ha {F#seguite}{M#seguiti} per tutto il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220503
					],
					"speakerTitle": "Chasca"
