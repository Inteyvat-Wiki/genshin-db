				]
			},
			"dialogs": [
				{
					"id": 150221101,
					"content": "Vi affrettate all'Arena delle prove e spiegate a Inkanak la situazione...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Perdinci... È un'idea decisamente ardita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Forse sì, ma dobbiamo agire in fretta. Qual è il modo più rapido per bloccare le bocchette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Da un punto di vista prettamente tecnico, consiglierei prima di tutto di effettuare delle adeguate misurazioni ed elaborare un piano dettagliato... Ma immagino che non sia questo ciò che volete sentire, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Vero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "...Allora dovremo applicare l'approccio più rozzo. Vedete quel Flogisto solido laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "Le ispezioni hanno rilevato che al suo interno si sono formate delle strutture stabili, il che lo rende estremamente resistente ai danni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Non è del tutto privo di punti deboli, ma questi vanno colpiti tutti allo stesso tempo per intaccarne le strutture interne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Quindi... Cosa succederà se li colpiremo tutti insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Il Flogisto precipiterà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "...Sì, credo di aver capito dove vuoi arrivare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "Sì, l'hai capito eccome! Vi basterà colpire tutti i punti deboli allo stesso tempo dall'angolazione giusta: il Flogisto solido precipiterà esattamente sopra la bocchetta e la bloccherà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Dicevi bene quando parlavi di \"approccio più rozzo\"... Lo approvo in pieno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
