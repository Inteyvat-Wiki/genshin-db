			"dialogs": [
				{
					"id": 150221301,
					"content": "Uff... Puff... È la prima volta che Paimon vola così veloce... Le viene quasi da vomitare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221302,
					"content": "#Almeno siamo {F#tutte intere}{M#tutti interi}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Ah-ha... Come pensavo. Da lontano può sembrare un comune pallone aerostatico, ma da vicino è palese che è stato pesantemente rimodellato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "E, come volevasi dimostrare, è sceso al di sotto delle nuvole per via di un guasto al suo apparato su misura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Sai qual è il problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221306
					]
				},
				{
					"id": 150221306,
					"content": "Dovrei riuscire a capirlo, grazie al taccuino di Tepal. Per fortuna ho fatto pratica col fai da te, dovendo aggiustare le mie pistole quando fanno le bizze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221307,
					"content": "Mh-mh... Dovremmo esserci. Ora basterà solo un bel calcio ben assestato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221308,
					"content": "Ehm... Questo forse funziona con le tue pistole, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221309,
					"content": "Cosa?! Ha funzionato davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
