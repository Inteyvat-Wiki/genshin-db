					]
				},
				{
					"id": 150220703,
					"content": "Sta tenendo duro... Sembra si sia calmata, adesso. Più tardi tornerò a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220704
