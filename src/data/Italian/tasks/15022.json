					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Allpa ha detto che Tepal appartiene ai Figli degli Echi. Come lo rintracciamo? Credi che basterà... chiedere in giro finché non lo troviamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Innanzitutto, parliamone con qualcuno che conosciamo. Sarà il modo più veloce. In questo momento e luogo, la persona più facile da trovare dovrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Svegliati, Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*sbadiglia* Ah, siete voi... Uff... Datemi un attimo che scendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*sbadiglia*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Sembra che salire sugli alberi sia uno dei vostri passatempi preferiti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Io salgo sugli alberi per volare e vedere più lontano. È raro che lo faccia per fare un pisolino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "#Beh, non tutti siamo come te, che sprizzi energia anche dopo una giornata di volo continuo... Dunque, posso chiedervi come mai siete {F#venute}{M#venuti} a interrompere la mia preziosa siesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Mi spiace, Xilonen, ma non potevamo aspettare. Il nome \"Tepal\" ti dice niente? Pare che sia un artigiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal? Sì, l'ho sentito... Credo sia il figlio di Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Si trova ancora qui con la tribù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "No, temo che siate in ritardo di qualche anno... Perché lo cercate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "È una lunga storia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Cercate di spiegare in breve quanto accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "\"Ali a Flogisto\"? Wow, ok. Quindi ce l'ha fatta per davvero... Beh, basta riposo per oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "In che senso, \"ce l'ha fatta per davvero\"? Vuoi dire che non è nuovo a cose del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Già. Appena ritornato dal Clan Piumafiore, iniziò a cercare un modo per costruire una macchina volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Subito dopo essere diventato un Senza Ali, quindi... Questa macchina volante era simile alla pistola che hai fatto per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Intendi la pistola che è più difficile da domare del più fiero dei Qucusauri? No, voleva creare qualcosa che gli permettesse di volare liberamente pur non essendoci portato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Ma... Non andò molto lontano all'epoca. Fece saltare in aria più volte la sua bottega, rischiando più volte di rimanerci secco. Da allora ho preferito mantenere le distanze da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Da giovani i suoi genitori viaggiavano molto, e sono tornati alla tribù solo dopo la sua nascita. Ma si sono stabiliti in un'area piuttosto fuorimano e tendono a starsene per conto proprio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "Per questo motivo, la maggior parte dei membri della tribù non li conosce molto bene... Quindi vi conviene rivolgervi direttamente a un membro della sua famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Andrò a prendere Puma. Potete aspettarmi davanti alla mia bottega, non ci vorrà molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
			"completionStepIds": [
				1502202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
