				]
			},
			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, finalmente sei tornata! Le cose si mettono molto male nella tribù. Le tue indagini hanno fatto progressi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Alcuni pensano che abbiamo arrestato i mercanti solo per supportare la squadra di volo e scoraggiare l'uso delle Ali a Flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Se la situazione continua a peggiorare pur avendo isolato i mercanti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Abbiamo trovato alcune piste promettenti, ma c'è un grosso ostacolo che ci impedisce di trovare le prove schiaccianti che ci servono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca spiega quanto avete scoperto su Tepal, e la vostra teoria sul laboratorio sospeso...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Una reliquia della Città di cenere? Ahhh... Och-Kan continua a seminare zizzania anche dopo tutti questi anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Un laboratorio sospeso... e un pallone aerostatico al di sopra dell'Arena delle prove... Quindi è lì che vorreste andare ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Avete qualche idea su come fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "#Le Ali a Flogisto e i Qucusauri non sono in grado di salire fin lassù. Siete davvero {F#sicure}{M#sicuri} che Tepal sia nascosto lì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Mmmh... Sapete... forse un modo per arrivarci c'è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Davvero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Ricordate le bocchette dell'arena? Quando erano bloccate, il Flogisto aeriforme restava intrappolato e non poteva circolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Ma ora che scorre liberamente, se le bloccassimo di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Vuoi dire... chiuderle tutte tranne quella in cima all'arena? Per creare abbastanza pressione in quel punto preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Proprio così. Se il Flogisto aeriforme fluisse da un'unica bocchetta, creerebbe una corrente d'aria ad alta pressione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "E noi potremmo sfruttarla per salire fino al cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Sì. È un piano rischioso, ma con le sue abilità penso che Chasca possa cavarsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "È un piano estremamente rischioso... Ma concordo che sia attuabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Se volete provarci, parlatene con Inkanak all'arena. Potrà spiegarvi come bloccare le bocchette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... Se c'è qualcuno che può recuperare da lassù le prove che ci occorrono, quella sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Forse qualcun altro sta gettando legna sul fuoco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
