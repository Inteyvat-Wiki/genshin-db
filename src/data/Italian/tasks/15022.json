						],
						"stepId": 1502202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Poco dopo, davanti alla bottega di Xilonen...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Eccomi qua. Faccio le presentazioni: questa è Puma, la madre di Tepal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Piacere! Noi siamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Saltiamo pure i convenevoli. Non voglio spendere un minuto di più a parlare di quel ragazzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "L'ho rinnegato da anni... Per quanto mi riguarda, non è più mio figlio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Non aveva altri interessi se non inseguire la chimera del volo... Ci abbiamo provato a farlo ragionare, ma la sua era una vera ossessione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Umpf... Quando ha deciso di lasciarci, ha blaterato di voler costruire un laboratorio nel cielo per non dover subire le critiche di noi \"terragni\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Ha lasciato il suo taccuino. Qualunque domanda abbiate, potete cercarne la risposta al suo interno... Per quanto mi riguarda, il discorso è chiuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Lui non è mio figlio... In fondo, non mi ha mai nemmeno chiamata \"mamma\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Porca pupazza, che situazione... Paimon non si aspettava che fossero in rapporti così cattivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Suo marito, il padre di Tepal... è morto di recente, e Tepal non si è neanche preso il disturbo di andare al suo funerale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Penso che quella, per Puma, sia stata l'ultima goccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Vado a farle compagnia. Se c'è altro che vi serve, venite a chiamarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Quindi, questo taccuino è l'unica pista che abbiamo, eh? Cosa c'è dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Uhm... Qualche progetto preliminare per le Ali a Flogisto... E qualche teoria su un ipotetico laboratorio sospeso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, la Città di cenere... Sembra che si sia ispirato a quella per la componente tecnologica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Quindi voleva davvero creare un laboratorio nel cielo? Ma è un progetto mastodontico per una persona sola... Davvero potrebbe riuscirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "In realtà, guardando lo schizzo del pallone aerostatico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "...Ah! Ma sì, era quello sopra l'Arena delle prove, quello sospeso ad altezza vertiginosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Quel pallone è rimasto lì per parecchio tempo, tutti si chiedevano da dove fosse saltato fuori. Ma... e se fosse stata la domanda sbagliata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Forse prima si trovava a un'altitudine ancora maggiore, nascosto al di sopra delle nuvole, ed è sceso alla sua posizione attuale a causa di un malfunzionamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "In pratica vuoi dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "Che è parte del laboratorio di Tepal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "È plausibile. Se la base di Tepal è rimasta nascosta finora al di là delle nuvole, spiegherebbe perché Isidore non è mai riuscito a trovarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon se l'aspettava... Però, ehm, come ci arriviamo lassù? Chasca, tu riesci a volare così in alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "Da sola... penso di sì. Ma con un passeggero è impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Dubito che anche le Ali a Flogisto possano portarci così in alto... Almeno, non senza la \"reliquia\" che Tepal menziona nel suo taccuino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Sì, e probabilmente ce l'ha lui... Dovremo trovare un'altra strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Tu puoi volare così in alto, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "No, è un'altitudine eccessiva pure per Paimon! E poi, pensi che Paimon potrebbe davvero andare lassù e vedersela contro Tepal tutta da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Non fasciamoci la testa. Solo perché non ci vengono in mente soluzioni, non significa che non ci sia qualcuno che possa riuscirci. Non sono l'unica esperta di volo della mia tribù, in fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Oh, effettivamente. Dovremmo chiedere all'Anziana Allpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "E anche a Mutota. Anche lui era un asso del volo, ai suoi tempi. Torniamo indietro e vediamo cos'hanno da dirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Ho l'impressione che l'abbiamo già visto da qualche parte, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
		{
			"id": 1502203,
			"completionStepIds": [
				1502203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
