					"content": "I-Io ovviamente voglio diventare una cavaliere! E... se dovessi affrontare qualche avventura con Jean in persona... Beh, ancora meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100715
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100715,
					"content": "Sembra che Ellin ammiri Jean proprio taaanto tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100716,
						101100717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100716,
					"content": "Non c'è niente di male in questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100718,
					"content": "Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100719
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100719,
					"content": "#Stavo pensando che non capita tutti i giorni d'incontrare {F#una}{M#un} Cavaliere Onorari{F#a}{M#o}... Ti uniresti a me per un <color=#00E1FFFF>allenamento con la spada</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100717,
					"content": "Credo che ce la farai, Ellin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100707,
					"content": "Ellin è davvero determinata a diventare una cavaliere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100708
					]
				},
				{
					"id": 101100708,
					"content": "Sì, è così coscienziosa da essere... preoccupante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
