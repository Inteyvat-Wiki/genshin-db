					"nextDialogs": [
						101100912
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100912,
					"content": "Stanley è un avventuriere leggendario, famoso in tutta Mondstadt. Una volta ha persino esplorato il Mare Jivari.",
