	"talks": [
		{
			"id": 1011001,
			"completionStepIds": [
				1011001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
