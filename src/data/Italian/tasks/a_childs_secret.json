			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#Ehi, {NICKNAME}... Guarda laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "È... tutta sola, o sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Perché si comporta come se stesse parlando e scherzando con qualcun altro... Brr! Paimon ha i brividi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "#Anch'io avevo un amico immaginario da bambin{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Cosa? Vuoi dire che anche tu facevi così, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Uh... quindi si tratta di... un amico invisibile che ogni tanto esce giocare con te? Oppure... esiste solo nella tua immaginazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "\"Immaginario\" significa \"nella tua immaginazione\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Immaginario... Immaginazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "... Oh, vuoi dire \"amico immaginario\", eh? Potevi dirlo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "Allora, questo tuo \"amico immaginario\"... Quando pensi di presentarlo a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Noi, ehm, non ci frequentiamo più.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Davvero? Quindi gli amici immaginari... spariscono quando si cresce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Esatto, sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Oh... Paimon non vedeva l'ora d'incontrare il tuo amico... Ehi, pensi che anche {F#tuo fratello}{M#tua sorella} abbia un amico immaginario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Certo che sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "Non ci credo! Come siete fortunati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "Perché c'è questo gioco a Liyue... Ne hai sentito parlare? Si gioca in quattro, ma a quanto pare voi potreste giocarci in due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "#{F#Viaggiatrice}{M#Viaggiatore}! Che coincidenza incontrarci qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Bardo stonato! Che ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Ahah, sono qui perché Lisa ha creato dei nuovi marchingegni interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Perché il pensiero dei marchingegni di Lisa rende Paimon così nervosa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Andiamo, non è questo il modo di parlare dell'elegante signorina Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Per questo particolare marchingegno, Lisa ha dovuto far arrivare certi materiali pericolosi da Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "P-Pericolosi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "Un monocolo dotato di una specie di... rilevatore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "Esatto! Sembra un monocolo, ma in realtà è un rilevatore di nirnama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Purtroppo Lisa non è in grado di usarlo, quindi l'ho preso in prestito per un po'... Lo sto collaudando per lei, per vedere se funziona davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Eh? Perché Lisa non è in grado di usarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Mmmh... Forse perché le manca un po' di quella capacità di meravigliarsi che hanno i bambini? O forse c'è qualche altra ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "Se vuoi saperlo con certezza, prova a chiederglielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "Quindi puoi vederlo? Avanti, dicci: che aspetto ha questo amico immaginario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Ahah... Questo è un segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "#A ogni modo, ora è tutto tuo, viaggiat{F#rice}{M#ore}. Dai un'occhiata, scopri se riesci a vedere l'amico immaginario di Nora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Lo vedi? Lo vedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Wow, funziona davvero!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Allora funziona anche con te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Paimon vuole vedere! Aspetta... ma questo coso non è di dimensioni adatte per Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#Va bene, allora, dovrai essere gli occhi di Paimon, {NICKNAME}! Andiamo a vedere che aspetto hanno gli amici immaginari di <color=#00E1FFFF>tutti</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "Eh, già! Sembrano proprio amici per la pelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "A me sembra un normalissimo monocolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Lo so, non credi anche tu? A quanto pare, però, si chiama rilevatore di nirnama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Purtroppo, sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Non si è... più fatto vedere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "\"Nella tua immaginazione\" significa \"immaginario\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Immaginazione... Immaginario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Eccolo lì. Guarda, l'amico immaginario di Flora: un Blubboflutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Aspetta, adesso gli amici immaginari possono anche essere piante?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "#Eheheh, ciao viaggiat{F#rice}{M#ore}! Ciao, bardo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Ciao, Flora. Posso farti una domanda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Certo. Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "Chi è... il tuo amico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Mmmh? Oh, intendi il signor Flutty? La maggior parte delle persone non può nemmeno vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "Il signor Flutty è il mio migliore amico. Siamo cresciuti insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(*borbotta* Non è giusto! Paimon odia sentirsi esclusa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora... Di preciso, per quale motivo sei amica di un Blubboflutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "Cosa c'è di strano? Ho sempre voluto essere amica di una pianta che sapesse anche volare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "Amica di una pianta volante? Perché mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Eheheh, perché quando c'è vento, tu e il tuo amico potete volare in cielo insieme! Devi ammettere che è piuttosto fico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "Intendi... essere spazzati via dal vento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Eheheh, forse qualcuno potrebbe vederla così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100223
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100223,
					"content": "Ho saputo dell'esistenza di questa pianta solo grazie a un esploratore che mi raccontava storie delle sue avventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100224
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100224,
					"content": "Penso che il suo nome fosse... Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100225,
						101100226
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100225,
					"content": "Oh, conosco Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100227,
					"content": "Stanley è un avventuriere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100228
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100228,
					"content": "E a giudicare dalle storie che racconta, ha anche una certa esperienza! Eheheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100229
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100229,
					"content": "Le mirabolanti avventure di Stanley sono famosissime a Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100230
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100230,
					"content": "È in città al momento. Dovreste chiedergli di raccontarvi una delle sue storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100231,
					"content": "Sembra un'idea interessante! Ma in questo momento abbiamo altre faccende di cui occuparci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100226,
					"content": "Non credo di conoscerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100212,
					"content": "Voi due siete parenti, o...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100213
					]
				},
				{
					"id": 101100213,
					"content": "Eheheh, intendi me e il signor Flutty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100214,
					"content": "Il signor Flutty è il mio migliore amico. Viviamo insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100215
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100215,
					"content": "Saluta, signor Flutty! Loro possono vederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100207,
					"content": "Ciao. Hai un minuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				}
			]
		},
