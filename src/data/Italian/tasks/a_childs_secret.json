			"dialogs": [
				{
					"id": 101100404,
					"content": "Sai come si dice del vino: se non lo bevi alla taverna, te lo godi a metà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100405
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100405,
					"content": "Ho l'impressione che troveresti il modo di divertirti anche bevendo da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100406,
					"content": "Ahah, se non ti conoscessi, direi che sei appena stato scortese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100407
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100407,
					"content": "Cerca solo di... non esagerare col bere qui da me, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100408
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100408,
					"content": "Eh? Perché, se bevessi un bicchierino di troppo cosa faresti? Mi butteresti via insieme alla spazzatura, è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100409
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100409,
					"content": "Buttarti via?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100410
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100410,
					"content": "Sai... proprio come hai buttato via l'eredità di papà. Hai venduto la sua villa o forse te ne sei scordato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100411
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100411,
					"content": "Non vedo alcun motivo per rimanere aggrappati a cose che ormai non servono più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100412,
					"content": "Davvero? Allora confido che ti sia separato molto rapidamente anche da un certo vaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100413
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100413,
					"content": "Mi dispiace, non ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100414
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100414,
					"content": "È strano. Patron Diluc, sono certo di aver visto un vaso simile a casa sua... Bellissimo, inconfondibile, in effetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100415
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 101100415,
					"content": "A quanto pare i nostri sospetti erano fondati... Gli adulti non sembrano avere amici immaginari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100416,
					"content": "Come ho detto, non hanno la capacità di meravigliarsi tipica dei bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100417,
					"content": "Sembra che gli adulti siano uguali dappertutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100418
					]
				},
				{
					"id": 101100418,
					"content": "Quindi la gente smette di sognare quando cresce? Ma bene, Paimon per quanto la riguarda non vuole mai crescere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100419,
					"content": "Mmmh... Questo solleva una domanda interessante: a che età, esattamente, gli amici immaginari spariscono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100420,
					"content": "Andiamo... a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
