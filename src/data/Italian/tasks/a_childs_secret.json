					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100910,
					"content": "Ci dovevamo incontrare stasera per pianificare le nostre avventure... Potresti fargli sapere che dovremo rimandare a un altro giorno?",
					"roleType": "TALK_ROLE_NPC",
