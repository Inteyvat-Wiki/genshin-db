						101100911
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100911,
					"content": "Se non sbaglio, dovresti trovarlo al <color=#00E1FFFF>Tempio del Leone</color>. Oggi è andato all'avventura con Stanley.",
