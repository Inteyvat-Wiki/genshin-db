			"dialogs": [
				{
					"id": 101100901,
					"content": "Wow! Grazie. È chiaro che ho ancora molta strada da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100902
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100902,
					"content": "Non essere modesta! Per quanto mi riguarda, credo tu sia già una professionista con la spada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100903
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100903,
					"content": "Beh, l'allenamento mi ha sfiancata, quindi la mia forma fisica ha ancora bisogno di un po' di lavoro. Un giorno, però... farò a pezzi tutti i manichini d'addestramento di Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100904
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100904,
					"content": "Ellin, Ellin, vai così! Spacca tutto... ehm, signorsì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100905,
					"content": "Grazie... Accidenti, mi sono fatta prendere così tanto qui da dimenticare che avevo una cosa da fare, oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100906,
					"content": "Ugh... Ma sono così dolorante per l'addestramento che riesco a malapena a muovermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100907,
					"content": "#Cavaliere Onorari{F#a}{M#o}, potresti consegnare un messaggio a Jack da parte mia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Ellin"
				},
