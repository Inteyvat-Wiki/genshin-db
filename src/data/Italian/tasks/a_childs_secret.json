						101100307,
						101100308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100307,
					"content": "Non è solo... una mia impressione... vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100309
					]
				},
				{
					"id": 101100309,
					"content": "Paimon sta per dare di matto... Quella cosa ci attaccherà sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100310,
					"content": "Ahah... Che ne dite se rimandiamo la nostra conversazione con Timmie, per il momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100311,
						101100312
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100311,
					"content": "Paimon, è ora di dire la tua battuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
