			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Mmh... Diamo un'occhiata. Sembra una nuova mappa del tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Non aiutiamo \"gli Aranara in trappola\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#Ahem! Non abbiamo trovato il padrone di casa. È preoccupante! Allora, {NICKNAME}, perché non diamo un'occhiata agli altri posti indicati dal dipinto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Una volta arrivati lì potremmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Trovare più tesori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Sì! Aspetta, Paimon voleva dire... No! Trovare gli Aranara in trappola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "E questa \"cassetta della posta\" è davvero particolare. In futuro potremmo trovarci dentro qualche nuovo dipinto. Teniamola d'occhio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Trovare \"gli Aranara in trappola\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Sì! E forse addirittura qualche tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
