				"points": []
			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "Fai vedere a Paimon... Mmh? È un dipinto degli Aranara...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "Non sta bene trafficare tra la roba altrui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "Mmh... Chissà quanti ne abbiamo rovistati di accampamenti e bauli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "#Mettiamola così: non abbiamo visto nessun Aranara vicino alla casa, ed eravamo preoccupat{F#e}{M#i}, così abbiamo preferito vedere se c'erano indizi di qualche tipo. Potremmo anche aiutare qualche Aranara in trappola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Hai ragione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Certamente! A ogni modo, sembra che il dipinto raffiguri alcuni panorami qui vicino, giusto? Ah, forse è una mappa del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, andiamo nel punto indicato nel dipinto! Forse troveremo qualche tesoro lasciato dagli Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Mmmh. Ha assolutamente senso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
