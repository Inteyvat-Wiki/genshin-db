			},
			"dialogs": [
				{
					"id": 721450101,
					"content": "\"Dicono che il messaggero dell'Omikami avesse tre occhi, uno per l'anima, uno che faceva da specchio, l'ultimo che vedeva solo la verità...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 721450102,
					"content": "\"Si levò dalle profondità, da <color=#00E1FFFF>sud</color>, da <color=#00E1FFFF>nord</color> e tutto intorno all'altura a <color=#00E1FFFF>ovest</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 721450103,
					"content": "\"I tre occhi lampeggiavano spietati per tenere lontani gli Eredi dei draghi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 721450104,
					"content": "Paimon conosce ognuna di queste parole... ma messe insieme non hanno senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Non sembrano esserci neanche indizi, qui intorno. E se usassimo la <color=#00E1FFFF>Vista elementale</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
