			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "Ehi, Ararycan, cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Ararycan vi stava aspettando da quando Ararycan ha finito di seminare i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Ma poi qualcosa è caduto dalla \"grande montagna di ferro\". Ha quasi colpito Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "Oh, no! Scusaci, Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Paimon non deve chiedere scusa. Ararycan sta bene, Ararycan corre in fretta, perciò Ararycan non si è fatto colpire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Sono felice che non ti sia fatto male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Il braccio caduto del robot deve aver aperto l'entrata alle rovine sotterranee. Beh, almeno non è stato del tutto inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Allora scendiamo a dare un'occhiata. Chissà quali orribili sorprese ci aspettano laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "Ararycan viene con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302705",
							"2"
						],
						"stepId": 7302705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "Quella cosa luccicante là dentro dev'essere il Nucleo del caos del Golem delle rovine. Sai, quello di cui parlava Jazari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "È protetto da rami e rampicanti, ma sembra che stia fuoriuscendo qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Oooh, è la robaccia maligna. Ararycan riesce a percepirla. È quello che ha fatto ammalare la foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Ah, sembra che dei Maghi dell'Abisso ne stiano combinando una delle loro intorno a quei grossi rami. Non promette bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Paimon ricorda che Jazari ha detto che il sigillo del nucleo è stato danneggiato. Forse questi Maghi dell'Abisso c'entrano qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Comunque sia, meglio che tu vada a cercarti un nascondiglio, Ararycan. Coraggio, fermiamoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
