			"dialogs": [
				{
					"id": 730270101,
					"content": "Le porte dello studio si apriranno a chiunque abbia a cuore la conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270102
					],
					"speakerTitle": "Jazari"
				},
				{
