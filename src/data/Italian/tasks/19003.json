			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "Sì? Dimmi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Riguardo al permesso di Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "#Oh, sì. Sorella Barbara ha richiesto un permesso di mezza giornata. Ha detto di avere dei programmi con {F#un'amica}{M#un amico}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Ammetto che questa richiesta di Barbara è piuttosto insolita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Ma non è questo il punto. Cos'è che volevi chiedermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Riguardo al \"Fantastico tè frizzante corallo di serendipità estiva\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Oh? Intendi forse che Barbara vuole accompagnarti a comprare questa... bevanda speciale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "#Quindi, immagino che tu sia l'{F#amica}{M#amico} di cui parlava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "#Mmm, visto che sei {F#la Cavaliere Onoraria}{M#il Cavaliere Onorario}, direi che può andare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Mi raccomando, prenditi cura di sorella Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Perché Barbara deve sempre rendere noti i suoi programmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Beh, come forse già saprai, sorella Barbara è piuttosto popolare a Mondstadt per vari motivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Sebbene la maggior parte degli abitanti abbia solo buone intenzioni, sono comunque tanti, e sorella Barbara fa fatica a stare dietro a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Se arrivano mentre lavora qui in chiesa, possiamo intervenire noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Ma se si fanno avanti durante il suo tempo libero, non ha nessuno che possa aiutarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "E poi... è troppo buona. Cerca sempre di esaudire le richieste degli abitanti di Mondstadt, anche quando esigono una grande fatica e la rendono ancora più stanca delle sue mansioni quotidiane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Pertanto, abbiamo pensato di chiedere a sorella Barbara di informarci sui suoi spostamenti, così da poter intervenire se si trovasse accerchiata da una folla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Spero tanto che la smetta di pretendere così tanto da sé stessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
