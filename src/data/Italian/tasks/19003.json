				},
				{
					"id": 190030702,
					"content": "Riguardo all'itinerario di Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "Oh? Sorella Barbara desidera andare alla Foresta dei Sussurri per raccogliere delle erbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030704,
					"content": "#Capisco... Sorella Barbara ha appena chiesto un permesso di mezza giornata per incontrare {F#un'amica}{M#un amico}. E ora, all'improvviso, vuole andare a raccogliere delle erbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030705,
					"content": "Di sicuro avrà i suoi motivi... L'accompagnerai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030706,
					"content": "Sì, l'accompagnerò io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "#Ah, allora confido che sia in buone mani. Prenditi cura di sorella Barbara, Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "Victoria"
