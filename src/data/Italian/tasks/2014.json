			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140801,
					"content": "Teppei!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "#Oh... *tossisce* Ciao, ragazz{F#e}{M#i}. Che ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Un attimo, ora mi alzo... Uff, che strano... mi sento privo di forze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei, dimmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Ah, già, non ho avuto tempo di raccontarvi tutti i dettagli. Beh, ultimamente ho dato un grande contributo alla nostra guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Ho combattuto l'esercito della Shogun in mare, ho affrontato da solo i samurai, ho salvato i miei compagni da... da un'imboscata... Cose che non immaginavo di poter fare, quando ci siamo conosciuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "*tossisce* Se solo fossi ancora più forte. Più sono forte, più posso contribuire alla Resistenza... Ehi, un momento, dov'è finita la mia arma segreta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Parlami di quest'arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "#*tossisce* Poco dopo che ti hanno nominat{F#a}{M#o} capitan{F#a}{M#o} della Pesce spada II, ho incontrato delle persone dall'aria enigmatica. Hanno detto di essere nostri sostenitori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Mi hanno dato l'arma dicendo che, se avessi voluto diventare più forte, questa mi avrebbe aiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Ahah... *tossisce* È come una Visione, no? Ovviamente non ho mai usato una Visione, perciò non conosco la differenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "È... un'Illusione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Un'Illusione? *tossisce* Santo cielo, il nome non promette niente di buono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "Dimmi... Qual è la differenza tra Illusione e Visione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "L'Illusione prosciuga la forza vitale di chi la usa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "*tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Caspita... Beh, avrei dovuto aspettarmi che un'arma misteriosa di origini sconosciute comportasse dei rischi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "Negli ultimi giorni, mi sento sempre più stanco e avverto... uno strano senso di terrore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "All'inizio, mi sentivo solo un po' più affaticato del solito, dopo ogni battaglia. Lì per lì non c'ho dato peso, ma oggi... tutt'a un tratto, mi si è annebbiata la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "Che gran peccato... C'ero quasi, pensavo che presto ti avrei raggiunto, ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Immagino di non aver ricevuto il favore degli dèi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#Ehi, {NICKNAME}, mi faresti un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "Quando le nostre uniformi saranno pronte, portami la mia... così potremo metterci entrambi in tenuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "#Perché mi guardi così? Non preoccuparti, amic{F#a}{M#o} mi{F#a}{M#o}. Dopo che mi sarò riposato, sarò fresco come una rosa. Come una rosa... vedrai... Devo solo... riposare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140829
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140829,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140830,
					"content": "I Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140831
					]
				},
				{
					"id": 20140831,
					"content": "#Ehi, {NICKNAME}, dove vai? Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140811,
					"content": "Da quanto tempo la usi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140805,
					"content": "Che ti è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				}
			]
