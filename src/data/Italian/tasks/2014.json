					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Il posto dovrebbe essere questo. Ma Sangonomiya aveva ragione, qui sembra tutto tranquillo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#Forse si sono nascosti? Diamo un'occhiata in giro, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "Quei <color=#00E1FFFF>monumenti di Electro</color> sono piuttosto sospetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Fiuuu... per fortuna è finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Per essere un mostro, era proprio forte. Ma che ci faceva qui quell'enorme Lawachurl Elmodituono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Non ha alcun senso... E poi, quest'atmosfera fa venire i brividi a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Comunque, fortuna che è finita. Direi che è meglio andare... Eh, Teppei? Che ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "*tossisce* Ehi... Che sorpresa! Non sapevo che avessero incaricato voi di indagare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Ho appena finito una consegna di rifornimenti alla prima linea e tornando ho pensato di passare di qui per eliminare ogni possibile minaccia... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "Stai bene, amico? Non hai una bella cera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Sto bene, non è niente. Devo essermi raffreddato mentre ero in mare, un paio di giorni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Lungo la strada, ho sentito dire che qualcuno era venuto sull'isola per indagare, così ho pensato di venire a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Se ci fosse stato un pericolo concreto, avrei potuto dimostrare di essere un eroe... Eh, peccato che ci siate solo voi. Sono venuto per niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, non trovi che questo posto sia strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Uhm... Ora che mi ci fai pensare, in effetti è un po' strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Forse dipende dal fatto che qui il Tatarigami è più palpabile... Non siamo molto lontani dai resti di Orobaxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Orobaxi? Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Un dio. Guardate, lì c'è il suo cadavere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "Aah! È lo scheletro di un serpente gigantesco! È terrificante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Orobaxi fu colui che portò in superficie i nostri antenati da Enkanomiya. Fu così che si originò l'Isola di Watatsumi come la conosciamo oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "I nostri antenati lo consideravano una divinità protettrice, ma durante la Guerra degli Archon, Orobaxi invase l'Isola di Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "Fu la Shogun Raiden in persona a ucciderlo con la Musou no Hitotachi. E con lo stesso fendente diede origine anche a ciò che venne poi chiamata la Valle di Musoujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "La Shogun Raiden ha creato la Valle di Musoujin con un fendente?! Caspita, è incredibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Sì. Ma la Guerra degli Archon fu devastante... *tossisce* In quella battaglia, l'Isola di Yashiori fu completamente distrutta. Si dice che in quell'occasione la Shogun perse qualcosa a lei molto caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Dalla morte di Orobaxi... *tossisce* c'è sempre stata una certa animosità tra l'Isola di Watatsumi e lo Shogunato. Ma le nostre divergenze non hanno niente a che fare con la nascita della Resistenza. Il nostro scopo è combattere il Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Quando Orobaxi attaccò la civiltà, la Shogun reagì e lo fermò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Ma adesso che la Shogun sta distruggendo le ambizioni della gente con il Decreto di caccia alle Visioni, è tempo che qualcuno fermi lei... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Bene, ora vado. Ho appena sistemato un gruppo di samurai della Shogun, quindi penso che farò una piccola pausa. Dopodiché passerò al prossimo incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Dovreste tornare subito da Sangonomiya. Non restate qui più a lungo del necessario, l'esposizione prolungata al Tatarigami non fa bene alla salute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*tossisce*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Abbi cura di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Ehi, non preoccuparti. Sono in forma smagliante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Certo che Teppei ha fatto grandi progressi se già combatte contro i samurai dello Shogunato. Paimon non riesce a crederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#Andiamo a fare rapporto a <color=#00E1FFFF>Kokomi</color>, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Fa' attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "#Kokomi, siamo tornat{F#e}{M#i}! Oh, guarda, c'è anche Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140602,
					"content": "Cosa sarà successo? Hanno l'aria preoccupata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140603,
					"content": "Quante persone manifestano questi sintomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140604,
					"content": "Non ho ancora avuto modo di contarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140605,
					"content": "Kokomi, Gorou... Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}! Ultimamente, i nostri soldati mostrano sintomi da invecchiamento precoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140607,
					"content": "Li ho fatto qualche domanda e ho scoperto che hanno ricevuto privatamente delle armi segrete dal nostro finanziatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140608,
					"content": "Quei ragazzi sono molto ambiziosi e si oppongono fermamente al Decreto di caccia alle Visioni. Da quando hanno ricevuto le nuove armi, le hanno usate di nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140609,
					"content": "Ecco perché la guerra sta andando stranamente bene... Ma le armi segrete sono un rischio e non una soluzione. Dobbiamo mettere fine questa faccenda, immediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140610,
					"content": "Gorou, sei riuscito a farti dare una di quelle armi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140611,
					"content": "Quasi tutti i soldati si sono rifiutati di consegnarmele, ma sono comunque riuscito a prenderne una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140612,
					"content": "Oh, cavolo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, tu sai di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140614,
					"content": "È un'Illusione dei Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "Significa che ad averci finanziato di nascosto finora sono stati i Fatui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140616,
					"content": "Perché i Fatui farebbero una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140617,
					"content": "No, non abbiamo tempo per pensarci. Dobbiamo dire ai soldati di smettere subito di usare quelle Illusioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140618,
					"content": "E bisogna curare tutti quelli che hanno manifestato sintomi. Spero solo che faremo in tempo a salvarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140619,
					"content": "#Un momento... {NICKNAME}, a proposito di quei sintomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140620,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "No, n-non è possibile che lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140622,
					"content": "Ohh, andiamo a vedere come sta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201408,
