			"dialogs": [
				{
					"id": 740911601,
					"content": "#Guarda guarda, chi avrebbe mai detto che voi due giovincell{M#i}{F#e} foste così talentuos{M#i}{F#e}? Balent, invece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911602
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911602,
					"content": "E cosa ti avevo detto? È un compito troppo pericoloso per te. Non hai voluto credermi, ma spero che adesso tu abbia imparato la lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911603
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911603,
					"content": "Ehm... ecco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911604
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911604,
					"content": "Come? Ancora non vuoi ammettere di aver sbagliato? Mi piacerebbe davvero sentire quale altro illuminato parere hai da condividere con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911605
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911605,
					"content": "Vorrei bere un po' d'acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911606
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911606,
					"content": "Balent trova una bottiglia d'acqua e ne beve a grandi sorsi, poi stacca un pezzo di pane secco e inizia a masticarlo.\\nÈ talmente concentrato a mangiare e bere che non presta orecchio alle parole dell'anziano, a prescindere da ciò che ha da dire.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740911607
					]
				},
				{
					"id": 740911607,
					"content": "Fiuuu... Almeno... Almeno sono ancora vivo. Grazie per avermi aiutato, se non fosse stato per voi due, temo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911608
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911608,
					"content": "...che probabilmente ai tuoi genitori non sarebbe rimasto altro che la pensione di reversibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911609
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911609,
					"content": "Umpf! Sempre meglio che venire licenziati per aver causato un grave incidente sul lavoro e trascurato i miei compiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911610
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911610,
					"content": "Razza di... *sospira* Non ascolti mai una parola di quello che ti dico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911611
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911611,
					"content": "Potrò sembrarvi un po' sfacciato, ma devo dirlo... Ne va della sicurezza di ognuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911612
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911612,
					"content": "Presumo che voi due sappiate immergervi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911613
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911613,
					"content": "Sì, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911614,
					"content": "Quando gli Hilichurl mi hanno catturato ho perso la mia tuta da immersione. Dalle ispezioni di routine abbiamo scoperto che i pezzi di ricambio erano difettosi e, pur avendone richiesti di nuovi, non sono ancora stati consegnati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911615
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911615,
					"content": "Ma non possiamo rimandare la manutenzione delle tubature. Se sapete immergervi, potreste farmi il favore di andare a ispezionare le tubature del Forte al posto mio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911616
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911616,
					"content": "#E non temete: ovviamente, sarete ben ricompensat{M#i}{F#e} per i vostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911617
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911617,
					"content": "Visto che è in gioco la sicurezza di tutti, non possiamo tirarci indietro. Ispezionare tubature però è un lavoro da professionisti. Sei sicuro di volerlo affidare a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911618,
					"content": "È un semplice controllo di routine. Credo che incontrerete qualche problemino, dato che durante la mia ultima ispezione ho rilevato quattro punti a rischio di perdite. Tuttavia, non dovreste avere difficoltà a porvi rimedio. Vi spiegherò come fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911619
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911619,
					"content": "Se nella tubatura notate una <color=#00E1FFFF>perdita di gas</color>, probabilmente è stata causata da una creatura acquatica... o dalla collisione con un oggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911620
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911620,
					"content": "L'intervento d'emergenza consiste nel <color=#00E1FFFF>controllare il flusso agendo sulla valvola di regolazione e interrompendo temporaneamente la perdita di gas</color>. Non serve fare altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911624
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911624,
					"content": "C'è una tecnica per intervenire sulla valvola di regolazione. <color=#00E1FFFF>Quando ruotate la manovella, dovete tenere d'occhio il volume del flusso di gas. Se diminuisce, allora siete sulla strada giusta</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911621
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911621,
					"content": "Ah... Adesso Paimon crede di aver capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911622,
					"content": "Rimango a vostra disposizione per qualsiasi domanda sul lavoro, fino al completamento della vostra ispezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911623
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911623,
					"content": "Ok! Proviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7409117,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7409115",
							"2"
						],
						"stepId": 7409115,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7409113",
							"2"
						],
						"stepId": 7409113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "Perché sprecare il proprio tempo su tutti quei lavori di manutenzione quando ci sono altri che possono aiutare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911702,
					"content": "A proposito del pontile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "Forte Méropide ha molte tubature. Qualcuno deve pur farci la manutenzione, no? È questo il nostro lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911704,
					"content": "La maggior parte delle volte si tratta solo di riparazioni minime, di rattoppare questo o quello. Dopotutto, se accadesse qualcosa di grave, che cosa si aspettano che faccia uno come me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911705,
					"content": "Io faccio solo quello che sono in grado di fare, tipo portare le lettere in città per le persone quando ho il giorno libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911706,
					"content": "Grazie del tuo tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Ah, il tempo non mi manca. Non ho poi tanto da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				}
			]
		}
	]
}