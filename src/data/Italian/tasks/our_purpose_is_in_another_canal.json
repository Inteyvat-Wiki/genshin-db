					"Balent"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911001,
					"content": "Rieccoci! In effetti c'erano alcuni problemini, ma non preoccuparti! Li abbiamo risolti tutti seguendo le tue istruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "#Grazie mille per il vostro aiuto. Se non foste intervenut{M#i}{F#e} tempestivamente, sarebbe stato troppo tardi e le perdite si sarebbero aggravate fino a provocare una vera e propria catastrofe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "E questo è il motivo per cui non vado molto d'accordo con Messire Aigouy, anche se so che si prende cura di me, a modo suo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Comunque sia, grazie ancora per avermi salvato la vita e aiutato con l'ispezione. Ecco la vostra ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Scusate se vi ho scomodato e ho rallentato il vostro viaggio. Vi auguro buon proseguimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
