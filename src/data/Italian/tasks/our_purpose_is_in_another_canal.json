			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Quel ragazzo... non sarà mica che gli Hilichurl l'hanno catturato e gettato nello stufato, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Quale ragazzo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Vedete quell'accampamento di Hilichurl laggiù, vicino all'acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "È come se fosse apparso dal nulla. Lavorano giorno e notte e non si riposano mai. *sospira* Proprio come quello stupido di Balent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "È un tipo fortunato, perciò dubito che stia bollendo in una pentola. Magari proprio in questo momento sta facendo una bella chiacchierata con gli Hilichurl. Chi lo sa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Eh? Qualcuno che conosci è stato catturato dagli Hilichurl? Come fai a essere così tranquillo? Se dici sul serio, allora dobbiamo andare subito a salvarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Salvarlo? Perché? Gli ho già detto che non deve strafare per un lavoro tanto pericoloso. Basterà fare rapporto a Éstienne e ci penserà lui a trovare qualcuno che se ne occupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Mi sono preso la briga di insegnare un sacco di cose a quel ragazzo, e lui come mi ha ripagato? Accusandomi di non prendere sul serio il lavoro e di trascurare i miei doveri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Ben gli sta, visto che non prende sul serio i consigli di chi ha più anni d'esperienza alle spalle. I giovani devono imparare sulla propria pelle. Altrimenti, come faranno a crescere senza subire qualche lezione di vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "È difficile dare un giudizio senza conoscere entrambe le versioni della storia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Esatto, sarà meglio andare a salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "#È pericoloso là fuori! Due giovincell{M#i}{F#e} come voi potrebbero finire in guai seri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Calma! {NICKNAME} è incredibilmente forte! Aspettaci qui, nonno! Torniamo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "E se fosse in pericolo? Sarebbe difficile crescere e maturare da morto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Quale stufato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Non è quello il punto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
