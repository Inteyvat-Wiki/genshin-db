				]
			},
			"dialogs": [
				{
					"id": 80200301,
					"content": "Ah, quindi è qui che l'hai nascosto! Di certo non è un luogo facile da scoprire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200302,
					"content": "Beh, andiamo a vedere se è al sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200303,
					"content": "#{NICKNAME}, aspetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200304,
					"content": "Mh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200306,
					"content": "...Non abbiamo tempo da perdere. Entriamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200307,
					"content": "(Che cosa mi stava per dire Dain poco fa...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "Ehi, aspettate Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 802004,
			"completionStepIds": [
				802009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"802009",
							"2"
						],
						"stepId": 802009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1138.109,
							201.003,
							2686.616
						],
						"pointId": 330400509
					},
					{
						"sceneId": 3,
						"position": [
							-1136.425,
							200.941,
							2686.6
						],
						"pointId": 330400545
					},
					{
						"sceneId": 3,
						"position": [
							-1136.996,
							201.048,
							2684.435
						],
						"pointId": 330400551
					}
				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Sulla base di quanto appreso, tornate al Villaggio di Vimara per raccogliere informazioni. Interrogate gli abitanti del villaggio fino all'imbrunire...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "#Ah, quindi è per quell'incarico che siete {F#venute}{M#venuti} al Villaggio di Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "\"Qualcuno che sembra esistere solo nei ricordi della gente\"... Intrigante, senza dubbio. Sono d'accordo che non si tratta di una mera sparizione. Tuttavia, qualsiasi possibile collegamento con l'Ordine dell'Abisso è ancora da confermare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "A quanto sembra, tutti gli indizi rimandano a un aumento delle attività da parte degli Hilichurl, il che può significare tutto e niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Bene, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#È vero! La voce misteriosa che {F#lei}{M#lui} ha sentito nel ricordo di {F#suo fratello}{M#sua sorella}... Quello che si è definito un Peccatore... Di chi si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, ora ti chiedo questo... Pensi che {F#tuo fratello}{M#tua sorella} ti abbia {F#tradita}{M#tradito}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "#Voglio fidarmi di {F#lui}{M#lei}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Uhm... C'è dell'esitazione nelle tue parole. Dopotutto, non hai ancora un quadro completo dell'accaduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "C'è ancora speranza per una riconciliazione. Nessun danno è ancora irreparabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "Riguardo al Peccatore di cui parlavi... La sua situazione è un po' diversa. Lui e i suoi compari hanno tradito me e la loro nazione ormai da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Si chiama Vedrfolnir, \"il Visionario\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "Mi duole ammetterlo, ma... ho un legame di sangue con lui. È mio fratello maggiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Tuo... fratello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Cosa è successo fra di voi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Erano in cinque... I Cinque Peccatori di Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "Hroptatyr \"il Saggio\", Vedrfolnir \"il Visionario\", Rhinedottir \"la Dorata\", Surtalogi \"l'Abominevole\", e Rerir \"il Vindice di Solnari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "La mia memoria non è più quella di un tempo, ma i loro nomi non li dimenticherò mai... Un giorno... avrò la mia vendetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "Aspetta, alcuni di questi nomi sembrano familiari... Rhinedottir è colei che ha creato Albedo, Surtalogi è il maestro di Skirk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "E poi quello di cui ci ha appena parlato Dain, suo fratello, Vedrfolnir... Se la voce del Peccatore era la sua, allora quello che ha ispirato Chlothar a creare l'Ordine dell'Abisso... è lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Ogni cosa è connessa, a quanto pare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(Se è vero, allora le tavole di pietra che abbiamo trovato in quelle rovine di Fontaine... quelle che descrivevano la profezia di Fontaine... Erano anche quelle opera di Vedrfolnir!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Erano persone molto stimate a Khaenri'ah, e portavano con sé le speranze della nazione. Erano i migliori fra i loro pari, delle eccellenze nei loro ambiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Noi sei, insieme... avremmo dovuto evitare il disastro, e impedire al Re Vinster di scuotere ulteriormente le fondamenta del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Eppure, nel profondo, loro cinque bramavano qualcosa di più. Non riuscirono a resistere all'attrazione dell'Abisso, e si divisero un potere in grado di distruggere il mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Così divennero Peccatori, ma anche esseri trascendenti, ciascuno di essi in possesso di poteri in grado di ridurre ogni cosa in polvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "E, quando il cataclisma si verificò, nessuno di loro si lanciò in difesa della propria nazione, nessuno si fece avanti per impedire la tragedia... Ecco perché non potrò mai perdonare nessuno di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "E poi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "...Proprio così. Se non li fermiamo, verrà il giorno in cui tradiranno il mondo intero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Dev'essere difficile parlare di tutto ciò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "Di nulla. Come dicevo, non avevo intenzione di nascondervi niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Allora, Dain, che cosa hai fatto per tutto questo tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "Ho continuato a indagare sulle domande circa il Telaio del fato. Sembra che l'operazione sia stata avviata già un bel po' di tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "Recuperando l'occhio del primo Zappaterra, siamo stati in grado di fermare l'avverarsi di parte del loro piano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Oh, Paimon si ricorda! Volevano servirsene per corrompere Osayal e creare un dio, o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "Proprio così... Però, è evidente che si trattasse solo di un esperimento tecnico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "L'occhio era parte integrante del piano, eppure, nonostante non siano riusciti a ottenerlo, hanno saltato la fase sperimentale e trovato un modo alternativo di procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Ci sono molte prove a conferma di questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "E allora cosa dobbiamo fare? Non è troppo tardi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "La nostra preoccupazione più pressante... è determinare lo scopo del Telaio del fato. Dopodiché, saremo in grado di dedurre il vero scopo dell'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Sulla base delle informazioni che ho raccolto finora, sospetto che esista un collegamento fra il Telaio del fato e le linee geomantiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Le linee geomantiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, tu sei {F#riuscita}{M#riuscito} a vedere i ricordi di {F#tuo fratello}{M#tua sorella}, dico bene? Credo che sia accaduto a causa dell'instabilità delle linee geomantiche in quella zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Le mie ultime indagini hanno mostrato che l'attività dell'Ordine dell'Abisso è di solito seguita da una serie di problemi legati alle linee geomantiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "E una delle cose che fluiscono tramite le linee geomantiche... sono i ricordi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Aspetta, ma quindi potrebbe esserci un legame col nostro incarico qui nel Villaggio di Vimara... La persona che sembra esistere solo nei ricordi della gente... No?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(I ricordi... Le linee geomantiche... Il Telaio del fato... La persona scomparsa che non sembra esistere...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Qual è il filo conduttore di tutti questi fenomeni?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Non è da escludere. Domani mi unirò alle vostre indagini. Il caso di questa persona scomparsa potrebbe rivelarsi la chiave per svelare alcuni misteri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Beh, se facciamo di nuovo squadra con Dain, avremo bisogno di tutta l'energia che possiamo accumulare! Proviamo a indagare un po' più lontano, domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*sbadiglia* Che stanchezza... Paimon ha spremuto troppo le meningi, ieri. È tutta colpa di Dain, coi suoi discorsi supercomplicati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Nemmeno io ho dormito bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Bene, andiamo da lui. Abbiamo un sacco da fare, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Ho la testa in confusione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Ma grazie di avermelo detto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "#{F#Mio fratello}{M#Mia sorella} ha contattato {F#il tuo}{M#tuo fratello}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "Cos'è accaduto davvero a Khaenri'ah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "Diciamo di sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "Dove sono le informazioni che mi hai promesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
