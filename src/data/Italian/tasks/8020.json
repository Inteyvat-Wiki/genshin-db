					}
				]
			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Proprio come sospettavo... I ricordi falsi erano una trappola. L'Ordine dell'Abisso voleva scoprire questo posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Ora che sono nelle vicinanze, dovremmo avere un'occasione di vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Argh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? Cos'hai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "La senti? C'è stata una perturbazione nelle linee geomantiche. Dev'essere opera dell'Abisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Wow, devi essere davvero sensibile. Paimon non sente niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "Fate come vi dico... Servitevi di quel meccanismo laggiù e andatevene da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Ma così resterai da solo, te la caverai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "L'Ordine dell'Abisso sta escogitando qualcosa. Se tornate al Villaggio di Vimara, sospetto che finalmente avrete l'opportunità di localizzare l'abitante del villaggio scomparso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "...È come una battaglia che si svolge su due fronti separati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Ho capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain ha ragione...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Ma c'è ancora qualcosa che non quadra... Ma cosa?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Umpf... Lo sapevo che l'unico modo per incontrarvi faccia a faccia sarebbe stato cadere nella vostra trappola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Hai rischiato la tua sicurezza e quella dell'occhio...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "#Una mossa azzardata, Dainsleif... Ma credo di essere {F#stato}{M#stata} io a cadere nella trappola tesa dalla Spada del crepuscolo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "#Quindi sei {F#venuto da solo}{M#venuta da sola}? E i tuoi seguaci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Quando la Spada del crepuscolo si prepara alla battaglia, qualsiasi esercito io possa inviare andrà incontro a morte certa... Preferisco affrontarti di persona.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Immagino tu abbia tanto da dire, lo so...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "Ma, se davvero vuoi parlare, prima dovrai sconfiggermi.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
