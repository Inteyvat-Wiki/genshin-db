			"dialogs": [
				{
					"id": 80200501,
					"content": "A quanto pare non possiamo andare oltre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "State all'erta. Percepisco la presenza dell'Abisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200503,
					"content": "È l'Ordine dell'Abisso! Sono qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
