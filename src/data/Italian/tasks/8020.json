			"dialogs": [
				{
					"id": 80200201,
					"content": "Eh, Dain? Teyvat chiama Dain! Cosa ci fai qui così assorto nei tuoi pensieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "Cosa c'è che non va, Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "La persona scomparsa del vostro incarico... Potreste descrivermela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "Oh, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "Un giovane sulla ventina... Sul serio, Dain... Che ti succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "Nella mia mente sembrano apparsi dei ricordi che prima non c'erano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "Ricordi... collegati a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "Eh? Forse... Forse ieri ne abbiamo parlato troppo e stanotte te lo sei sognato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "No. Non era un sogno. Sono ricordi... Ricordi apparsi all'improvviso nella mia mente dopo che mi sono svegliato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "E sono sicuro di non averla mai incontrata, questa persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "Beh, cosa ti \"ricordi\", esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Mi ricordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "...di avergli consegnato l'occhio del primo Zappaterra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "Cooosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "Beh, allora la sua sparizione ha di sicuro a che fare con l'Ordine dell'Abisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "Infatti. E a quanto pare possiede l'abilità di \"impiantare\" dei ricordi nelle menti altrui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "Ma com'è possibile...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Aspetta... Allora, tutti i ricordi che gli abitanti del villaggio hanno di lui... potrebbero essere fasulli? Forse non l'hanno mai conosciuto per davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "Che senso ha una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "Quali che siano i piani dell'Ordine dell'Abisso, stamani ci è stata svelata una verità importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "Sarebbe a dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "Che loro... vogliono ancora mettere le mani sull'occhio del primo Zappaterra. Non hanno rinunciato a cercarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "Io sono l'unico che ne conosce l'ubicazione. Forse impiantare quel ricordo in particolare era un qualche tentativo d'interferire con la mia mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "L'occhio è ancora al sicuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "È una preoccupazione giustificabile. Non credo che l'Ordine dell'Abisso sia in grado di alterare la realtà in questo modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "Eppure, considerando la loro instancabile ricerca dell'occhio, è necessario procedere con la medesima cautela da parte nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "Venite con me. Dobbiamo verificare che l'occhio sia ancora in nostro possesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "Oh, quindi ci porterai dove l'hai nascosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(...Ma potrebbero seguirci. Se andassimo direttamente lì e qualcuno ci stesse tallonando, non rischieremmo di rivelargli la posizione dell'occhio?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Forse è per questo che l'Ordine dell'Abisso ha impiantato quel ricordo nella mente di Dain... Per costringerlo ad assicurarsi della posizione dell'occhio...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(Conoscendolo, di sicuro Dain ha già pensato a questa possibilità... Immagino che abbia già un piano...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "...Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "Facci strada, Dain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "E se quel \"ricordo\" fosse reale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
		{
