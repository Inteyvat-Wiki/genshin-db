			"dialogs": [
				{
					"id": 80200101,
					"content": "Un momento... Quello là è... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Ah, siete voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "Oh, è un vostro amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Beh, allora io vado. Meglio che torni al villaggio a vedere come stanno il capo Amadhiah e gli altri. Ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Sì! Ci vediamo, Atossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Come fai a spuntare sempre così dal nulla?! Spaventarci è diventata la tua missione di vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Niente di personale... non lo faccio apposta. Finché andremo alla ricerca dell'Ordine dell'Abisso, continueremo a incontrarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Ah, sei qui per indagare sull'Ordine dell'Abisso! Ecco perché stavi combattendo contro quei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Naturalmente. Un momento... Voi non siete qui per lo stesso motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Anche noi gli stiamo alle calcagna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "#Mh, non ha importanza. Forse ci avete messo un po', ma immagino ve ne siate {F#accorte}{M#accorti} anche voi... C'è qualcosa di strano in questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "L'Ordine dell'Abisso ha sicuramente dei piani per questa zona... o peggio, forse li stanno già mettendo in atto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Quindi pensi che dietro l'attività degli Hilichurl ci sia l'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Date le circostanze, dubito che il loro obiettivo principale sia quello. Presumo che l'aumento delle attività degli Hilichurl sia solo un effetto collaterale di ciò che l'Ordine sta attuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Però, l'attività degli Hilichurl causa un sacco di problemi agli abitanti del posto. Dovremmo rimanere qui per un po' a proteggere il villaggio, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "Il modo migliore per proteggerli è capire i piani dell'Ordine dell'Abisso. È l'unico modo per impedire che la situazione precipiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Beh, vediamo se gli abitanti hanno altro da dirci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "E ve le darò. Non intendo nascondere niente a voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Non preoccupatevi... Avremo tutto il tempo per parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Inoltre... anche tu ci devi delle risposte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Però, lo ammetto, li abbiamo trovati per caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
