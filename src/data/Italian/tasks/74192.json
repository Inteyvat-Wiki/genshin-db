				"points": []
			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "Se i ricordi possono essere trasformati in un libro... funzionerà anche al contrario: possiamo scrivere il contenuto del libro direttamente nella memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, sei tu, {F#Mademoiselle}{M#Monsieur} {NICKNAME}, {F#quella strana}{M#quello strano}. Cosa c'è? Ti serve qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Di cosa stavi parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Uhm... Per quanto provi a pensarci, convertire i ricordi in un libro sembra un'impresa davvero stratosferica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Chi ha creato questo libro sarà riuscito a farlo perché considerava le emozioni nei suoi rico{RUBY#[D]illusioni}rdi come ciò di più prezioso al mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Ma ciò non ne rende più facile la lettura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "...E non so che impatto avrà sui lettori. È molto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
