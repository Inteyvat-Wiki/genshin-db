					"Canotila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "Capisco, le fiamme sul trono si sono estinte, e le ceneri si sono nuovamente tramutate in alberi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "I fiori sbocciano al tuo passaggio, portando cambiamento a un altrimenti inevitabile degrado nel futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Eh, si tratta di {F#Mademoiselle}{M#Monsieur} {NICKNAME}! Qual buon vento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Oh, certo! La farfalla dorata è tornata. Devo andare a vederla! Ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7419202,
			"completionStepIds": [
				7419202
