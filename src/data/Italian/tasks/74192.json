			"dialogs": [
				{
					"id": 741920401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920402,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "#Eh? Sei {F#tornata}{M#tornato}, finalmente! Non sparire così, ti rendi conto di che preoccupazione mi hai dato? Immagina cosa succederebbe se non tornassi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "Hai idea di quanto tempo hai passato lì dentro? Sembrava che l'attesa non sarebbe mai finita... Perfino le altre Melusine non sapevano cosa fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(Sembra che sia qui già da un bel po'.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Beh, ora devo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#Cosa? {NICKNAME}, dove vai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "Non preoccuparti, tornerò quando ti avrò trovata, Canotila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Aspettami qui ancora un po', va bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Lo so che queste parole non ti dicono niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Eppure, fidati di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920412,
					"content": "Non ti preoccupare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				}
			]
		}
	]
