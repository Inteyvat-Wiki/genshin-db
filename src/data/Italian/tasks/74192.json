						],
						"pointId": 7387
					}
				]
			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920202,
					"content": "Canotila...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#Eh? {F#Mademoiselle}{M#Monsieur} {NICKNAME}... E tu chi sei? Pensavo che nessuno potesse entrare qui a parte me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920204,
					"content": "Aspetta, come fai a conoscere il mio nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920205,
					"content": "Ci conosciamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "Non è vero! Devi essere proprio come quei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920207,
					"content": "(Bugia) Mi manda Serene, che vuole che ti trovi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "Oh... La faccio sempre preoccupare per niente, che bambino cattivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920209,
					"content": "#Sono {NICKNAME}. Ti ricordi ancora di me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#Certo, {F#Mademoiselle}{M#Monsieur} {NICKNAME}... Mi ricordo ora... Sei molto gentile per essere un mostro gigante in grado di divorare il mondo in un boccone solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920211,
					"content": "Ehi, che impudenza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "Mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920214,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "Ho visto della gente, che pian piano si è iniziata a sciogliere, tramutandosi in mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920216,
					"content": "Mm... Questo fa un po' paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920213,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
			"id": 7419203,
			"completionStepIds": [
				7419203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
