					}
				]
			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ah, è {NICKNAME}! Aspetta un attimo, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Eccoti qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Oh, ehi! Hai bisogno d'aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Ahah, non esattamente. Stavo solo passando di qui con un pacchetto per voi due, e mi stavo giusto chiedendo come rintracciarvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Guarda tu i casi della vita, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Un pacchetto! Da parte di chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Beh, ha fatto un lungo viaggio. All'inizio è arrivato alla Gilda degli avventurieri, poi, dopo essere passato di mano in mano svariate volte, è stato finalmente affidato ai fattorini dei Discendenti delle Vette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Vista la situazione attuale di Natlan, le carovane normali non viaggiano da un bel po'. Il mittente non ha scritto il suo nome sul pacchetto ma, a giudicare dalla firma... credo provenga da Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Pare che abbiate degli amici anche a Fontaine, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Lo accettiamo con piacere, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Evviva! Me lo prendo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Fiuu, il lavoro di oggi è iniziato col piede giusto. Sono riuscito a consegnarlo in tempo record. Lode all'Archon di Pyro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Bene, vado a occuparmi di altre consegne. Buona giornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Sì, buona fortuna col tuo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Proviene da Fontaine, eh... Lui l'ha definito un pacchetto, ma è veramente piccolissimo! A Paimon sembra più una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Apriamolo e vediamo cosa contiene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Oh, è da parte di Charlotte! È la foto che abbiamo scattato quando stavamo andando via da Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Non è passato molto tempo da quando l'abbiamo scattata, ma sembra già un'eternità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Hihi, conserviamola con cura da qualche parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}