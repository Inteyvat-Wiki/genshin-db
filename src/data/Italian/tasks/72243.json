			"dialogs": [
				{
					"id": 722430102,
					"content": "Vorrei vendere dei tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "Vuoi vendere dei tesori? Ah, questa non me l'aspettavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "#Immagino che {F#un'avventuriera}{M#un avventuriere} con molta esperienza come te sia in possesso di oggetti rarissimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Fammi dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "Racconti a Marjorie della Sfera d'osso di drago.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Mmm, i bardi lo chiamavano il Frutto della gioia, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "Non avrei mai immaginato che esistesse davvero... Quindi il suo vero nome è Sfera d'osso di drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "Se i suoi poteri sono davvero come li hai descritti, sono disposta a darti in cambio 80.000 Mora e alcuni piatti speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "Mmm... Che ne dici di 80.000 Mora e 5 torte di luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "...Cosa ci farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Eheh. Voglio dire, è un tesoro rarissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Ha dei poteri incredibili! Dubito che quegli alchimisti saranno contrari a separarsi dai loro Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "D'accordo, è un prezzo ragionevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "La prendo, allora. Grazie per la visita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Ah, sì. Queste gocce di condensa tendono a evaporare lentamente con il vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "Pertanto, sarebbe meglio coprirle o metterle in un contenitore a chiusura ermetica per preservarne la qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "Ti omaggio di questo consiglio, sperando che possa tornarti utile nelle tue avventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "Se in futuro dovessi incontrare dei tesori simili, ricorda che puoi sempre contare su di me per acquistarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Fammici pensare ancora un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Certo, nessun problema. Tuttavia, sono sicura del valore che ho stimato per questo oggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "Potrai tornare da me dopo che ci avrai riflettuto su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
