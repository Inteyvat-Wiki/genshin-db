					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220301,
					"content": "A Liyue c'è un piatto famoso che si chiama carne di Tianshu, vediamo... Ah, Xudong ha scribacchiato qualcosa anche qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "\"Cuocere al vapore le patate sbucciate, schiacciarle mentre sono ancora calde, aggiungere olio e sale. Mettere quindi il tutto in una ciotola e versarvi sopra una salsa densa. Il primo morso ricorda la carne tenera.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "Il primo morso... vuole forse dire che dopo qualche morso non si capisce? Andiamo, questa cosa fregherebbe solo chi non ha mai mangiato carne di Tianshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "#Lasciamo perdere... Viaggiat{F#rice}{M#ore}, volevo chiederti: \"oltre a carne cruda, zucchero e matsutake, cos'altro c'è nella ricetta della carne di Tianshu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Campaviola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Mmmh... davvero? Ora lo scrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220306,
					"content": "Qingxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220307
					]
				},
				{
					"id": 220220307,
					"content": "Mmmh... davvero? Ora lo scrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220308,
					"content": "Bocca di leone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
