				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "A Mondstadt c'è un piatto chiamato stufato di mele del Nord. Argh, Xudong ci ha di nuovo scritto sopra un sacco di cose senza senso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "\"Il burro è costoso e la carne cruda è difficile da conservare. Forse sarebbe meglio lavorare l'impasto, lavare via il glutine per poi cuocerlo al vapore e dargli sapore con frutta e verdura per creare un piatto delizioso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Che tipo... Il burro sarebbe costoso? E perché non acquistare carne fresca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "#Lasciamo perdere... Viaggiat{F#rice}{M#ore}, volevo chiederti, oltre a mela, burro e carne cruda, cos'altro c'è nello stufato di mele del Nord?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Mandorle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Mmmh... davvero? Ora lo scrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Pepe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Mmmh... davvero? Ora lo scrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Peperoncini di Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Prosciutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
