			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "La ricetta dovrebbe essere questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Sto riordinando le ricette. Sfortunatamente ce n'è qualcuna che non ricordo bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Perché non chiedi a Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Eh, Xudong... Lui e i suoi piatti creativi sono la ragione principale per cui non me le ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Ogni volta che scopre una nuova ricetta, la segue solo per uno o due giorni al massimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Poi... inizia a modificare varie cose per migliorarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Perché lo fa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Secondo lui per risparmiare... Ma non sono sicura che sia proprio quello il motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Comunque i risultati parlano da soli. Ha avuto successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Il sapore è simile all'originale, ma i costi di produzione sono incredibilmente bassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Le sue tecniche culinarie poco ortodosse sono il motivo per cui volevo lavorare con lui. E credo che mi abbia assunta per via delle mie capacità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Allora, cosa vuoi che faccia per te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ah già! Ero così occupata a parlare di Xudong che ho quasi dimenticato l'argomento principale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Xudong mi assilla perché vuole cambiare le ricette. Ogni volta ci scrive e disegna sopra... quindi alcune di queste sono diventate illeggibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "Voglio recuperare le ricette con precisione e conservarne una copia, nel caso in cui ci servisse la versione corretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "#Viaggiat{F#rice}{M#ore}, se te le ricordi ti andrebbe di aiutarmi a recuperarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Grazie. Rimetterò in ordine le ricette rovinate e tu potrai correggere le parti indecifrabili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Certo. Ho mangiato di tutto in giro per Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Le tue abilità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Non te ne ho parlato? Il mio argomento di ricerca all'Akademiya è il condimento supremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Per dirla semplice, voglio creare il condimento definitivo, in grado di rendere delizioso ogni piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "È il motivo per cui sono qui a raccogliere informazioni sulle varie cucine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Ehm, mi sono dilungata. Torniamo alle ricette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Migliorarla in che modo, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Beh... i suoi modi sono diversi da quelli degli altri. La maggior parte degli chef fa sì che le ricette siano più ricche per poter vendere i piatti a prezzi più alti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Ma Xudong sembra avere principi totalmente diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Per esempio, ha usato patate, funghi e altre verdure economiche per creare un piatto vegetariano, eppure chissà perché... sapeva di pollo al peperoncino di Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Inoltre c'è anche la versione modificata della Tentazione dell'Adeptus, con patate, riso, frutto di loto, peperoncino di Jueyun, pasta e carne cruda. La consistenza e il sapore raggiungono stranamente quelli della ricetta originale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Aspetta. Non siete gli Chef supremi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Per piacere, non ripetere quel nome. Queste parole non appariranno mai nella mia relazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Comunque, Xudong e i suoi piatti creativi sono la ragione principale per cui non mi ricordo queste ricette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
