			"dialogs": [
				{
					"id": 742510101,
					"content": "La ringrazio del gentile invito, Mademoiselle Guillotin. Suppongo che quest'acqua pura sia stata preparata appositamente per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Non c'è di che, Messire Neuvillette. È un onore che lo Iudex di Fontaine trovi il tempo, nella sua fitta agenda, per unirsi a me per una tazza di... acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510103,
					"content": "I Fatui hanno qualche questione ufficiale da discutere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Nient'affatto, si tratta di una visita strettamente personale. E non formalizziamoci troppo, volevo semplicemente chiederti di una vecchia conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510105,
					"content": "Una vecchia conoscenza... Ah, immagino stia parlando di Alain Guillotin, il sommo Re dei meccanismi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Esatto. Che tipo di persona era? Ho sentito dire che in gioventù era un tuo subordinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510107,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Monsieur Guillotin era un giovane fervido e realista. Anche dopo aver ricevuto il titolo di Bianco Cavaliere guardiano, non mostrò mai il benché minimo accenno d'arroganza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Trascorreva gran parte del suo tempo a studiare le macchine, non provava alcun interesse per il mondo al di fuori della sua piccola bolla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Ah... Quindi era così anche da giovane? Mi chiedo se fosse più saggio della sua età o solo ignorante dei modi del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510111,
					"content": "Sennonché... Cambiò radicalmente dopo aver perso la sua famiglia e i suoi sodali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "La Torre della Gestalt? Ed Elynas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510113,
					"content": "Esatto. Quando io e lui firmammo l'ordine d'ispezione della torre, mi sembrò... impotente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "È stato l'allontanamento e l'alienazione del passato a portare a tutto questo. Deve essersi sentito in colpa anche lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510115,
					"content": "Mmh... Dopo quell'episodio divenne ancora più taciturno, e le nostre interazioni si fecero man mano più saltuarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Alla cerimonia in cui gli fu conferito il titolo di Re dei meccanismi, il suo discorso fu di un'unica frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "\"Rispetto alla ricerca sfrenata di una perfezione senza fine, una vita tranquilla e umile è una via più sicura verso la felicità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Eheh... È esattamente così che ha vissuto i suoi ultimi anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510119,
					"content": "Immagino che non lo stesse dicendo solo alla folla, ma anche a sé stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510120,
					"content": "E lei cosa pensa di tutto ciò, Mademoiselle Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Io? Umpf. Non esprimerò giudizi sulla sua intuizione o sul suo stile di vita, così come lui non mi ha mai detto come dovrei vivere la mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510122,
					"content": "Ma non ho alcuna intenzione di seguire il suo percorso o imitare i suoi ideali. Ho la mia individualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510123,
					"content": "Beh... Ti ringrazio, mi hai aiutato a capirlo meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510124,
					"content": "Non c'è di che. Sono lieto di condividere storie del passato con un parente di un vecchio amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
