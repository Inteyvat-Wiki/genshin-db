				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "Sono lieto di condividere storie del passato con lei davanti a quest'acqua prelibata, Mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742510204,
					"content": "Bene. Ovunque lei sia diretta, le auguro buon viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
}