			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "*sospira* E ora che faccio...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "C'è qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Sì, questo posto... Gestire una locanda in un luogo del genere non è affatto semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "La Palude di Dihua è piena di eulalia, e dove c'è un tesoro non mancano i mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "Fortunatamente, i Milleliti ne hanno eliminato la maggior parte e, da allora, le cose sono andate meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Ma negli ultimi tempi, non si sa come, i mostri sembrano essere tornati alla carica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "So che non si avvicinerebbero mai alla locanda, ma sta di fatto che rovinano l'atmosfera. E se lo penso io, lo penseranno anche i miei clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Puoi aiutarmi? Mi faresti un gran favore se potessi occuparti dei mostri nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Ahah... Devo ammettere che la tua schiettezza è come una boccata d'aria fresca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "In ogni caso, chiedere agli ospiti di risolvere un problema del genere non mi entusiasma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "Ma sappi che ti ricompenserò adeguatamente per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Buona fortuna e grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "La tua preoccupazione principale è che rovinano l'atmosfera?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Francamente, sì. La loro presenza fastidiosa è il problema maggiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "Ci sono alcuni che la trovano intollerabile, come ad esempio un certo giovanotto ossessionato dalla pace e dalla tranquillità... Se qualcosa disturba lui, solitamente finisce per disturbare anche il resto della Palude di Dihua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2210002,
			"completionStepIds": [],
