			"dialogs": [
				{
					"id": 221000301,
					"content": "Come sta andando? Hai risolto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000302,
					"content": "Tutto fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Ottimo. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "Come promesso, ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Se tutto va bene, per un po' non avremo problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "Come? Chi è il giovanotto...? Questa è una domanda che devi rivolgere al capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
