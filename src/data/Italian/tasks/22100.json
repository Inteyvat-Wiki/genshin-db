				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000201,
					"content": "Come sta andando? Hai risolto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Va bene, non c'è fretta. Di solito si tengono a distanza, quindi non rappresentano una grande minaccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Ma se uno di quelli privi della vista dovesse smarrirsi e turbare la pace e la tranquillità di quel giovanotto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "...Getterebbe nel panico l'intera Palude di Dihua. Parlando schiettamente, la locanda non farebbe più affari per un bel po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
