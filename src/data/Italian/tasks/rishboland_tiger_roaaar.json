			"dialogs": [
				{
					"id": 730420101,
					"content": "#Nara dorat{F#a}{M#o}, Arakanta ha sentito molto parlare di te. Sei {F#una}{M#un} Nara buon{F#a}{M#o}. Vuoi giocare con Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Il gioco di Arakanta è facile e divertente! Ascolta le regole, Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta evocherà molte particelle di Dendro, che saranno degli \"Aranara\" nascosti nel cerchio. Nara sarà la grande e forte \"Tigre Chiomalunga\". Vieni a rincorrere gli \"Aranara\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "Se la \"Tigre Chiomalunga\" cattura tutti gli Aranara in poco tempo, allora Nara vince!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Ti piace? Nara vuole giocare con Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
