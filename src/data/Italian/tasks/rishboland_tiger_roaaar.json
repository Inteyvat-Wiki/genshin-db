					"Arakanta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730420601,
					"content": "#È stato molto divertente! Arakanta è molto felice di giocare con Nara dorat{F#a}{M#o}! E Nara è davvero veloce! Incredibile! Come una tigre vera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "#È divertente giocare con gli altri Aranara e le vere Tigri Chiomalunga, ma è ancora più divertente giocare con {F#la}{M#il} nostr{F#a}{M#o} nuov{F#a}{M#o} amic{F#a}{M#o} Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Perché la Tigre Chiomalunga dovrebbe inseguire gli Aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "La Tigre Chiomalunga e gli Aranara sono amici, e gli amici giocano insieme. Ma Arakanta ha notato che i Nara temono la Tigre Chiomalunga, quindi ha pensato a questo gioco per il Festival di Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "#Grazie, Nara. Ecco un fiore Aranara per Nara dorat{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
		}
