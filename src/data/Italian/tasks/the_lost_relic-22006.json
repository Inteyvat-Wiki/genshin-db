			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}! Che paura... i Cacciatori di tesori sono proprio dei selvaggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Sono Soraya, una studiosa in visita. Sto facendo delle ricerche proprio mentre parliamo, in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Qualche giorno fa, seguendo degli indizi che mi hanno portato a delle rovine, ho trovato una lastra di giada che riportava i dettagli della Guerra degli Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Ma, proprio quando stavo per andarmene, i Cacciatori di tesori mi hanno teso un'imboscata. Ho provato a scappare, ma mi hanno raggiunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Se non fosse stato per te, sia io che la lastra di giada saremmo stati nei guai. Quindi, grazie ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Anche tu sei una studiosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "Intendi dire che hai incontrato altri studiosi da queste parti? Mi sai dire qualche nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er? Aspetta un attimo... Poco fa, quando i Cacciatori di tesori mi hanno teso un'imboscata, ho sentito qualcuno che diceva che Bao'er si è impossessata di ogni tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Che strana coincidenza... Potresti dirmi di più sul tuo incontro con Bao'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Ecco ciò che ricordo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "Mmmh... I luoghi che Bao'er ti ha indicato sono gli stessi a cui puntavo io. Forse questa coincidenza non è poi così casuale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Se lei fa davvero parte dei Cacciatori di tesori, allora credo che mi stiano seguendo da un po' di tempo... Nella speranza di trovare qualche nuovo tesoro nascosto attraverso di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Bao'er lo voleva tutto per sé, così si è separata dal gruppo e ha provato ad andare avanti da sola. Ma quest'area è troppo grande, e aveva bisogno di un aiuto per cercarlo, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "#Sembra che si sia approfittata di te, viaggiat{F#rice}{M#ore}. E scommetto che aveva messo gli occhi su questo posto da molto tempo, solo che io e i suoi compagni ci siamo arrivati prima di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Ma non allarmarti, sono solo congetture le mie. Anche se... il suo nome sembra sospetto. Potrebbe essere un nome falso, o forse un nome in codice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti depistarla? Qualunque cosa accada, questa lastra di giada non può finire nelle mani sbagliate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Grazie. Anche se probabilmente si insospettirebbe se tu tornassi a mani vuote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Perché non le dai tu qualcosa, invece? Ecco, prendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "È a malapena sufficiente per farle guadagnare qualcosa, ma spero sia abbastanza per non farla insospettire, per il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Ok, sarà meglio che tu vada via. Potresti aver appena pestato a sangue i suoi compagni, ma se sta viaggiando da sola non dovrebbe venirlo a sapere immediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Oh, e se trovi qualcosa in una delle sue future cacce al tesoro, puoi portarmela. Mi troverai alla Locanda Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "*sospira* Potrei non essere brava in tante cose, ma sono in grado di tenere al sicuro una reliquia storica, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Se torno a mani vuote, si insospettirà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Giusto... Ecco, prendi. Non è un oggetto di valore, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "È a malapena sufficiente per farle guadagnare qualcosa, ma spero sia abbastanza per non farla insospettire, per il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
