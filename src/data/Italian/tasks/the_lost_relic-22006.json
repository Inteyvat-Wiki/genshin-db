					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "Non riesco a trovarlo da nessuna parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "Che cosa hai perso stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Oh, in realtà non ho ancora perso niente, la sto ancora cercando! Ma non riesco a trovarla da nessuna parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Dove potrà mai essere? Dopo tutti gli sforzi che ho fatto per sapere dove si trova...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Mi aiuteresti a cercarla? Un oggetto del genere non può assolutamente andare perduto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Ok, io la cercherò qui, tu vai a cercarla dall'altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "Dobbiamo trovarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "Che genere di reliquia è, questa volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "È... ehm... molto antica! Risale a un migliaio di... anzi, no, alla Guerra degli Archon, in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "In poche parole, è una reliquia molto preziosa e non può andare perduta! Quindi, aiutami a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
