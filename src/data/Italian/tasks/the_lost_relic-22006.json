					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Se riuscissi a decifrarla, forse potrei scoprire alcune informazioni mancanti nei registri dell'Akademiya di Sumeru.",
