					"nextDialogs": [
						220060707
					]
				},
				{
					"id": 220060707,
					"content": "Oh, ha suscitato il tuo interesse, vero? Come mai? Per il suo valore culturale o per quello monetario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060708
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060708,
					"content": "Scherzo. Questa lastra di giada registra un evento della Guerra degli Archon, uno scontro tra clan, se non mi sbaglio.",
