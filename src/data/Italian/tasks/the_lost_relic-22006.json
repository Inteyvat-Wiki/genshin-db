			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "Come mai ci hai messo così tanto? Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060602,
					"content": "Ho trovato questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Uhm... interessante, ma... non è quello che stavo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060605,
					"content": "Ma è pur sempre una reliquia, quindi me ne occuperò io. Non preoccuparti, vedrò di farne buon uso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060609,
					"content": "Ecco, prendi. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060610,
					"content": "*sospira* Per quanto riguarda l'altra reliquia perduta, spero vada tutto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060603,
					"content": "È questo l'oggetto che stavi cercando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
