					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "Una reliquia dovrebbe essere oggetto di studio per gli studiosi, fonte di ispirazione per gli artisti, un oggetto da ammirare in una mostra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "Non dovrebbe mai essere data a dei ladri che la vendono in cambio di qualche Mora. Non è una violazione solo nei confronti di una preziosa reliquia, ma anche nei confronti della storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "Mi rifiuto di arrendermi a persone che trattano la storia, e le sue reliquie, come spazzatura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "Voglio saperne di più sulla lastra di giada.",
