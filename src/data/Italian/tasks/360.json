			"dialogs": [
				{
					"id": 3600101,
					"content": "Ah, nulla di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600102,
					"content": "Ma devo dire che i vostri movimenti mi hanno stupita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600103,
					"content": "Grazie dell'aiuto. Come vi è sembrato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600104,
					"content": "Un gioco da ragazzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "Ora che mi ci fai pensare, come avranno fatto degli Hilichurl a finire qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600107,
					"content": "Non sembrano creature che si accampano così vicine a una città del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600108,
					"content": "Esatto. Solitamente restano molto più lontani, nella natura selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600109,
					"content": "Purtroppo, negli ultimi tempi quel drago, Terrore alato, è stato molto attivo: i nostri frutteti sono stati distrutti e il mercato locale ne ha risentito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600110,
					"content": "Quando le tempeste ci colpiscono, spesso ci sono dei feriti, e i Cavalieri di Favonius fanno quel che possono per difendere la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600111,
					"content": "Quindi queste creature così fastidiose si stanno spingendo sempre più vicino alla città?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600112,
					"content": "Proprio così. Ma ora che abbiamo sgombrato questo accampamento, l'intera zona si è fatta più sicura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600113,
					"content": "#Venite con me! Non sarei un cavaliere responsabile se non mi assicurassi che arriviate san{F#e}{M#i} e salv{F#e}{M#i} in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600105,
					"content": "Sono più forti di quanto sembrino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
	]
