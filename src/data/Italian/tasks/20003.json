			},
			"dialogs": [
				{
					"id": 200030501,
					"content": "Mona, ci sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030502,
					"content": "Mona, è arrivato il momento di pagare l'affitto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Ah, sembra davvero che Mona non sia a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Che strano. È quasi sempre rintanata in casa, no? Forse aveva da fare da qualche parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "...O magari non riesce venire ad aprire, indebolita dalla fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "Dubito che la situazione sia così grave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Ma dove potremmo andare a cercare Mona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Non aveva detto di aver trovato un modo di fare soldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
