				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "Grazie mille. Dovrebbero bastare. Ora spediscili al falegname... Oh, giusto! Devo anche riscuotere l'affitto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030302,
					"content": "*sospira* Mi chiedo se... As-Astronoma, o come si chiama, sarà in casa stavolta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030303,
					"content": "Si chiama Mona Megistus, l'astrologa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "Giusto! Sì, ecco come si chiamava... Mah, un po' lungo come nome, secondo me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030305,
					"content": "Hai detto che Mona non ha pagato l'affitto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030306,
					"content": "Ecco il problema, capisci? Tutti gli altri inquilini l'hanno già pagato. Lei è l'unica rimasta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030307,
					"content": "Sono passato a vedere già qualche volta, ma lei non c'era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030308,
					"content": "#Per piacere, viaggiat{F#rice}{M#ore}, aiutami ad andare laggiù e a sollecitarla a pagare in fretta. Ti va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
