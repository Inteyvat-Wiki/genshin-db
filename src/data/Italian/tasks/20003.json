					"nextDialogs": [
						200030602
					]
				},
				{
					"id": 200030602,
					"content": "La biblioteca... Ah, giusto! La biblioteca è davvero grande. Forse è là a cercare materiali di ricerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030603
					],
