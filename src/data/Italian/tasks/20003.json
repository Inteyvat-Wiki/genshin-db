			"dialogs": [
				{
					"id": 200030201,
					"content": "Hai trovato la legna? Mi basta un fascio di legno d'abete rosso e un altro di legno di betulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
