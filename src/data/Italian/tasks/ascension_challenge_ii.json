			"dialogs": [
				{
					"id": 706670201,
					"content": "Miao! (Favoloso! Congratulazioni per il completamento della sfida d'ascensione. Adesso sei un giocatore esperto!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670202,
					"content": "#(Adesso sei qualificat{F#a}{M#o} a sfidare più giocatori. A proposito, anche se potevi farlo già prima, ti ricordo che ti è permesso postare sulla bacheca degli inviti...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670203,
					"content": "Miao... (In questo modo, chiunque voglia sfidarti può lanciare il guanto. Un duello in cui non sai niente del tuo avversario può essere molto interessante a volte, non credi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670204,
					"content": "(Dopo tutto, incontrarsi per un duello è anch'essa un'opportunità per stare insieme.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680204,
					"content": "#Miao! (Ah! Scusa, sto divagando. Comunque, in quanto giocat{F#rice}{M#ore} espert{F#a}{M#o}, car{F#a}{M#o} {NICKNAME}, hai guadagnato il privilegio di acquistare delle carte dall'aspetto assolutamente favoloso...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670205,
					"content": "#({NICKNAME}, non dimenticare il motivo per cui hai iniziato a giocare, e che il divertimento sia con te nel mondo di Invokazione del genio!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
