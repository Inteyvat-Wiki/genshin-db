			"dialogs": [
				{
					"id": 722480101,
					"content": "#Ti sei armat{F#a}{M#o} di tutto punto, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
