				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "Ecco un altro di quegli spiriti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480302,
					"content": "Il mio nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480303,
					"content": "Aberaku, il Creatore di Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480304,
					"content": "Come avete osato colpirmi con le vostre vili calunnie e farmi imprigionare da uno dei vostri burattini?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480305,
					"content": "No, aspetta. Sono stato imprigionato per innumerevoli mesi e anni, vero? Allora... queste sono le mie sembianze del dopo vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480306,
					"content": "Sembianze del dopo vita? Vuoi dire che sei già morto, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480307,
					"content": "È raro che uno spirito se ne renda conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480308,
					"content": "Eppure, anche se mi vergogno a dirlo, non so come sia morto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480309,
					"content": "Ma ricordo che sono stato imprigionato su ordine di un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480310,
					"content": "Un bambino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480311,
					"content": "Proprio così. Ma ancora oggi, non riesco a provare alcun odio per quel bambino, solo pietà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480312,
					"content": "Lui non aveva nessuna colpa. La colpa dovrebbe ricadere su coloro che lo manovravano come un burattino... Lasciamo perdere. È meglio non dire certe cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480313,
					"content": "Dopodiché, sono stato imprigionato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480314,
					"content": "Imprigionato in un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480315,
					"content": "In un...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480316,
					"content": "In un posto molto in alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480317,
					"content": "Ma anche se era in alto, era cupo, senza luce e freddo come il ghiaccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480318,
					"content": "...Strano. Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480319,
					"content": "Perché ho la sensazione che un posto in alto avrebbe dovuto trasmettere calore e conforto a una persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480320,
					"content": "Perché... Perché non riesco a ricordare nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480321,
					"content": "Forse hai fame?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480322,
					"content": "Quando Paimon è affamata, non riesce più a pensare a niente, riesce a malapena a parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480323,
					"content": "Non credo che sia questo il problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "Dai, sicuramente è questo! Guardalo, non riesce nemmeno a esprimersi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480327,
					"content": "#Ora che ci penso, {NICKNAME}, potresti controllare se c'è qualcosa da mangiare tra le offerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480328,
					"content": "Aspettate! Ecco! Le offerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480329,
					"content": "Perché? Vuoi mangiarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480330,
					"content": "No, mi sono appena ricordato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480331,
					"content": "Quando sono morto in prigione, le mie vesti e il mio corpo sono stati custoditi in vari luoghi grazie al mio contributo alla creazione di Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480332,
					"content": "Ma questo ha anche causato la lacerazione del mio spirito, impedendogli di trovare pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480333,
					"content": "Questo luogo avrebbe dovuto essere la dimora della mia sacra corona, anche se ormai sarà sicuramente deteriorata. Questo dev'essere anche il motivo per cui i miei pensieri sono... bloccati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480334,
					"content": "Se questa situazione persiste, dubito che riuscirò a sopravvivere anche nel mio stato attuale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480335,
					"content": "Ma queste offerte possono essere usate per sostituire i resti del mio corpo e delle mie vesti nel conservare un briciolo dei miei pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480336,
					"content": "Per cui, prendetele e portatele con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480337,
					"content": "In ogni caso, molti pericoli vi attendono sul vostro cammino. Quindi, sebbene possa sembrare scortese, potreste prima affrontare una prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480338,
					"content": "Una prova? Quale prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480339,
					"content": "Sconfiggete i mostri qui intorno, coloro che hanno imprigionato il mio spirito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480340,
					"content": "#È molto rischioso. Dimmi quando sei pront{F#a}{M#o}, viaggiat{F#rice}{M#ore}, e inizieremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480325,
					"content": "Beh, si dà il caso che ora dobbiamo proprio anda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
