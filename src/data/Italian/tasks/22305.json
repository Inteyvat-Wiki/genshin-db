			"dialogs": [
				{
					"id": 223051001,
					"content": "Temo che questa pietra contenga davvero poca giada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051002
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051002,
					"content": "Poco importa. È comunque un'esperienza, no? A mio parere, un po' di Mora spesi per togliersi uno sfizio sono un buon investimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051003
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051003,
					"content": "Mi hai fatto credere che non ci fossero pietre di cattiva qualità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223051004
					]
				},
				{
					"id": 223051004,
					"content": "Proprio così! Tutte le nostre pietre sono raccolte in modo responsabile e selezionate accuratamente, in buona fede. Chiamarne una \"di cattiva qualità\" sarebbe quindi un grossolano travisamento dei fatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051005
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051005,
					"content": "Non si perda d'animo! Di tanto in tanto, capita a tutti di essere sviati da una pietra che sembra promettente, ma che alla fine delude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051006
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051006,
					"content": "Lasci a me la pietra. Se vuole provare ancora, possiamo continuare subito. Salderemo il conto alla fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051007
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051007,
					"content": "<color=#00E1FFFF>Calcolerò quanto le spetta</color> alla fine. Se lo facciamo un po' alla volta, finiremo solo per confonderci... e questo non serve a nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051008
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051008,
					"content": "Che ne dice? Facciamo un altro tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
