			"dialogs": [
				{
					"id": 223050601,
					"content": "Ogni persona ha il proprio metodo per valutare una pietra grezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050602
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050602,
					"content": "Alcuni si affidano al puro intuito, riconoscono la pietra che vogliono a prima vista, altri preferiscono esaminare attentamente ogni esemplare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050603
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050603,
					"content": "Lungi da me giudicare quale metodo faccia più al caso suo. Sta a lei decidere se <color=#00E1FFFF>dare un'occhiata più da vicino</color> o semplicemente <color=#00E1FFFF>affidarsi all'istinto</color>.",
					"roleType": "TALK_ROLE_NPC",
