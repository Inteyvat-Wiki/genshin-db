	"talks": [
		{
			"id": 2230501,
			"completionStepIds": [
				2230501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230501",
							"2"
						],
						"stepId": 2230501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "#Mi scusi, gentile {F#signora}{M#signore}! Vorrebbe tentare la sorte con una pietra? Potrebbe essere il suo giorno fortunato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Proviamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "#Ottima scelta, {F#signora}{M#signore}, non se ne pentirà! La fortuna aiuta gli audaci, e mi basta uno sguardo per capire che non avrà nulla di cui preoccuparsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "#Prego, {F#signora}{M#signore}, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "Che tipo di pietra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Il mio negozio offre solo pietre grezze selezionate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Lei acquista una pietra, ne controlla l'interno e, se contiene giada, la pagherò profumatamente per averla. Va da sé che niente giada, niente Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "#Per saperne di più sul funzionamento del gioco, non le resta che fare un tentativo, {F#signora}{M#signore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "Da dove provengono le pietre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "#Tutto ciò che troverà in questo negozio, {F#signora}{M#signore}, è altamente selezionato. Le pietre vengono dalla Voragine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "#Abbandoni ogni timore, {F#signora}{M#signore}! Il Mistero della giada vanta un'esperienza di svariate generazioni nella realizzazione di ornamenti in giada. Nessuno è al nostro livello, quando si parla di pietre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "In verità, però, da quando il Ministero degli Affari Civili ha chiuso la Voragine, gli affari non sono rosei come in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Senza nuovi carichi di pietre grezze, le scorte si stanno assottigliando... Ormai le pietre grezze sono così rare da risultare più preziose degli ornamenti in giada stessi! Da non credere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Quindi mi sono detto... Perché non vendere direttamente le pietre? Così risparmio i costi di produzione e aggiungo, al contempo, un pizzico di adrenalina a ogni acquisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "#Che ne dice, {F#signora}{M#signore}? Posso auspicare un suo interessamento al meraviglioso mondo delle pietre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Farò un tentativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
			"id": 2230502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230502",
							"2"
						],
						"stepId": 2230502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050201,
					"content": "Abbiamo una selezione straordinaria di pietre grezze, qui al Mistero della giada. La collezione è così vasta che è naturale sentirsi un po' spaesati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "Mi sono concesso quindi la libertà di raggrupparle, per facilitarle la scelta. Posso domandare che budget aveva in mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230503,
			"completionStepIds": [
				2230503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"202",
							"200"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050301,
					"content": "200 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "#Una scelta prudente, {F#signora}{M#signore}. Ecco qui, dunque, scelga pure la pietra che preferisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "La selezioni con cura, mi raccomando. Il ritorno di quell'investimento di 200 Mora è importante, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Una volta effettuata la scelta, me la comunichi e farò io gli onori di casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230504,
			"completionStepIds": [
				2230504
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"202",
							"400"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050401,
					"content": "400 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "#Esattamente la somma che sono solito consigliare ai nuovi clienti, {F#signora}{M#signore}. Né troppo grande, né troppo piccola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "#Prego, {F#signora}{M#signore}. Scelga pure la pietra che l'aggrada maggiormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Si prenda tutto il tempo che le occorre. Sarò lieto di fare gli onori di casa, una volta effettuata la scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230505,
			"completionStepIds": [
				2230505
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"202",
							"600"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050501,
					"content": "600 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "#Una scelta accorta, {F#signora}{M#signore}! Non tutti i nuovi clienti conoscono il vecchio adagio: \"Si raccoglie ciò che si semina\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Prego, da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "Si tratta delle pietre più raffinate della collezione. Le analizzi a piacimento, sono certo che il suo acuto sguardo le troverà impeccabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Una volta trovata la prescelta, le chiedo di comunicarmela, affinché io possa procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
