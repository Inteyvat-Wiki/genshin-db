						223051102
					]
				},
				{
					"id": 223051102,
					"content": "Un'idea eccellente! Molte storie di successo iniziano con queste esatte parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051103
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051103,
					"content": "C'è chi dice: \"Tornerò qui una volta al giorno per il resto della vita e, prima o poi, la fortuna mi bacerà\". Personalmente, preferisco il vostro approccio. Meglio fare più tentativi al giorno e restare con più anni per godersi le vincite! Prego, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
