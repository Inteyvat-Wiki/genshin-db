			"dialogs": [
				{
					"id": 223051401,
					"content": "#Per tutte le gemme! C'è della giada qui, abbiamo {F#una vincitrice}{M#un vincitore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051402
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051402,
					"content": "Lei sa certamente riconoscere un tesoro nascosto, quando ne vede uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051403,
					"content": "Mi dica... Come faceva a saperlo? Cos'ha visto che ad altri, ehm, clienti può essere sfuggito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051404,
					"content": "Vorrei riscuotere ora, grazie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223051405
					]
				},
				{
					"id": 223051405,
					"content": "Ehm? Oh... sì, certamente... Prego, ecco a lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051406
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051406,
					"content": "#Arrivederci, gentile {F#signora}{M#signore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051407
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051407,
					"content": "Argh! Che l'Archon mi aiuti... Come ho fatto a non accorgermene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
