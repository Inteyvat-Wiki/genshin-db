			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "Lady Nefer! Che coincidenza, arriva proprio al momento giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Allora, ha deciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Eh? Deciso...? C-Cosa intende? Per caso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "So che ha sempre voluto visitare gli Eredi della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Spera di conoscere prima Lyylikki e di usare quell'amicizia come rampa di lancio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Sapeva... Sapeva tutto sin dall'inizio? Ma l'ho tenuto nascosto nel mio cuore e non l'ho mai detto a nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Beh, signor Zompaynco, quando si custodisce un segreto, bisogna anche saper nascondere il fatto che lo si sta custodendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Altrimenti, non importa quanto alto sia il muro eretto intorno al proprio cuore, il vento lo scalfirà, prima o poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*sospira* Non sono mai stato bravo a controllare le mie emozioni, nemmeno quando ero ancora nella mia città natale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Beh, visto che sa già tutto, potrebbe presentarmela? Sono uno straniero, e non voglio disturbare la signorina Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Stia tranquillo. Gli Eredi della Luna gelata sono estremamente gentili. Sia gli estranei che chi ha non ha un aspetto del tutto umano riceveranno un caloroso e cordiale benvenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Oh? Davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Tuttavia, sarebbe inopportuno se ci presentassimo senza invito. Lady Nefer, potrebbe presentarmi a lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Va bene. Dovrebbero aver appena finito di distribuire i pasti, perciò è il momento perfetto per fare due chiacchiere. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "E non dovrai pagare nulla stavolta. Ero solo di passaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Oh, grazie infinite! Vado a prendere le mie cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
