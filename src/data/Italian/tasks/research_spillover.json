			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "Lady Nefer? E... il signor Zompaynco. Cosa vi porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Il nostra ospite di Natlan ha espresso interesse nell'incontrare gli Eredi della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Ma preferirebbe che qualcuno gli facesse la cortesia di presentarlo. Bene, allora, signor Zompaynco, a lei la parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "S-Salve, signorina Lyylikki! Che piacere incontrarla. Ehm... Ho portato questo esemplare di fossile da Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Grazie, ma signor Zompaynco... ehm... Ci siamo già incontrati, vero? Non c'è bisogno di essere così formali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Uh? Ma... come ha fatto a notarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "È sempre stato presente durante la distribuzione dei pasti, non è così? Si avvicinava alla fila camminando avanti e indietro, ma senza mai unirsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Pensavo che ne volesse uno, ma che si vergognasse a chiederlo, così ho tenuto da parte una porzione per lei in segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Ma non è mai venuto a ritirarlo. E se non fosse venuto qui oggi, avrei chiesto a qualcuno di andare a controllare se avesse bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Ah... M-Mi scuso. Ho continuato a esitare perché non sapevo come approcciarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Allora, signorina Lyylikki... Sarebbe possibile visitare gli Eredi della Luna gelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Certamente. Abbiamo ospitato già diversi visitatori stranieri, ma potrei chiederle il motivo di questa visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Vorrei scattare delle foto, prendere appunti, consultare degli archivi e, se possibile... chiedere in merito alle leggende locali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Sono un membro dell'Associazione delle Reliquie Sauriche di Natlan. Trovare dei materiali relativi alle mie ricerche sarebbe qualcosa di inestimabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Capisco... Quindi vorrebbe consultare gli archivi, ho capito bene? Vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Bene, ora che vi siete presentati, il mio lavoro qui è finito. Tolgo il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Grazie, Lady Nefer! Ma... devo proprio pagarla per il disturbo. Non sarebbe corretto averla fatta venire qui per nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Come desidera, signor Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "Allora vado. Buona conversazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}