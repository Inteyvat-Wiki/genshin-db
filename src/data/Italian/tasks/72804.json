			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kairagi",
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Argh! T-Ti prego, non uccidermi! Come hai fatto a trovare una persona così forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040207,
					"content": "Disgustoso criminale! Ridammi subito l'arma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Tu... Sei ancora fissato con quell'arma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040209,
					"content": "Sono qui solo per riprendere la mia arma. Se mi dici dov'è, ti risparmierò la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Tsk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040211,
					"content": "Non sprecare altro fiato con lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "N-No, per favore! Fermati, ti prego! Non ho detto che non avrei detto nulla! Non c'è bisogno d'usare la violenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040214,
					"content": "Q-Quell'arma è stata presa dal nostro capo per la sua collezione. Se la vuoi, puoi andare all'accampamento laggiù a riprendertela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040215,
					"content": "Beh, almeno hai un po' di buonsenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "V-Vi prego, vi ho detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040217,
					"content": "Fuori dai piedi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "Kairagi"
				},
				{
					"id": 728040219,
					"content": "Non è molto portato per il combattimento, ma sicuramente corre veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Ed è anche veloce a vendere i suoi compari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Alla fine i Kairagi sono una banda composta da gente che si è unita solo per il proprio tornaconto. Per loro non esistono né causa comune, né lealtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Non appena dei problemi iniziano a sorgere all'orizzonte, fanno le valigie e se ne vanno. Un classico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Ma per fortuna eri qui ad aiutarmi. Altrimenti non penso che avrebbero ceduto così facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Comunque, la prossima tappa è il loro accampamento principale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Seguiremo il piano originale. Io mi batto con il loro leader, e tu ti occupi dei pesci piccoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "Posso affrontarne dieci alla volta, nessun problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Forza, troviamo qualcun altro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leader dei Kairagi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Tu? Ah, ma non sei il moccioso di prima? Che c'è, sei qui per aggiungere qualcos'altro alla mia collezione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040302,
					"content": "No. Sono qui per la mia arma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "Eheh, beh, il fegato non ti manca di sicuro. Ma veramente siete solo in due? Mi stai prendendo in giro, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040304,
					"content": "Sai che c'è? Ti meriti almeno una chance per il coraggio dimostrato. Dai! Risolviamo la questione da qualche altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040305,
					"content": "Ma non va bene lasciare i miei uomini qui senza niente da fare, no? Ci sono! Perché non chiedi alla tua piccola aiutante di giocare un po' con loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040306,
					"content": "Quando sono pronti, io ci sono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Ahahah. Hai un bel caratterino, eh? Bene allora, ragazzi, avete sentito. All'attacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040309,
					"content": "Quanto a te, andiamo laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040310,
					"content": "Occupatene tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Davvero mille grazie. Mi occupo di lui in fretta e poi vengo ad aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Anche tu parli molto, eh? Provaci pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader dei Kairagi"
				},
				{
					"id": 728040307,
					"content": "Speriamo non siano troppo scarsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Dal tuo respiro regolare posso dedurre che i Kairagi non sono stati al tuo livello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "E sembra che anche tu abbia vinto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Esattamente. Anche se, purtroppo, devo ammettere che gli ho permesso di scappare. Sono riuscito a colpirlo una sola volta con la lancia, dopo una sua finta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Tuttavia, è ferito molto gravemente. Non credo che riuscirà a fare granché per almeno qualche anno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "E soprattutto, l'ho sconfitto da solo e ho reclamato la mia arma. L'umiliazione che ho dovuto sopportare è ormai terminata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Congratulazioni, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Ti devo davvero ringraziare, ma non posso ancora darmi pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "Tutta questa situazione è stata causata dalla mia mancanza d'addestramento. Continuerò quindi ad allenarmi e ad affinare le mie abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Perciò, spero continuerai ad aiutarmi nell'addestramento anche in futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Ah, sì. Ecco, prendi, in segno di ringraziamento. Non è molto, mi spiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Grazie ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}