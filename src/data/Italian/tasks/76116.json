			},
			"dialogs": [
				{
					"id": 761160101,
					"content": "#Ehi, sono {F#le amiche}{M#gli amici} di vecchia data {F#nostre}{M#nostri} e di Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Allora, quali sono i vostri piani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Rimarremo qui ancora per un po'. La porta del laboratorio di Drzislav è stata sfondata, quindi dobbiamo restare nei paraggi per impedire a quei criminali di intrufolarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Una volta riparata la porta, o quando Slava tornerà, seguiremo il tuo esempio e viaggeremo insieme a Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Riguardo a Drzislav...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Non ho idea di dove sia... Ma se lo incontri durante i tuoi viaggi, salutalo da parte nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Mi piacerebbe passare un'altra notte a bere con lui all'Ammiraglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Allora, come sta Bobik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Oh, ti manca già, eh? Non preoccuparti, puoi venire a giocare con lui in qualsiasi momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Sì. Non preoccuparti, sicuramente ci incontreremo di nuovo. Dopotutto, siamo migliori amici che hanno superato insieme gioie e dolori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
}