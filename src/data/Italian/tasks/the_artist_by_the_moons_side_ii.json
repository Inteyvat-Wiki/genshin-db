			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510102,
					"content": "Che succede, Colombina? Sembra che qualcosa ti stia turbando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510103,
					"content": "Avete della pittura con voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510105,
					"content": "Oh! Tu sei... Maalaus, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510106,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510107,
					"content": "Ti va di dipingere, eh? Sembra però che la pittura ti sia finita addosso... Com'è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510108,
					"content": "Maalaus se ne è andata per un po' ed è tornata così. Penso che per toglierla ci vorrà un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510109,
					"content": "Uhm, forse Maalaus è finita nei guai mentre cercava l'ispirazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510110,
					"content": "A dirla tutta, però, non è così drammatica come situazione! È un aspetto che si addice a un'artista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510111,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510112,
					"content": "Oh, e a proposito della pittura... Dobbiamo solo dare a Maalaus degli oggetti colorati, giusto? Come l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510113,
					"content": "~ ~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510114,
					"content": "Hihi, ecco una Kuuhenki felice! Maalaus deve aver avuto delle ottime idee... Qualcosa di allegro e divertente, Paimon ne è certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510115,
					"content": "Cerchiamo dei colori caldi e felici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
