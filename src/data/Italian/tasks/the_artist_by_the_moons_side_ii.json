				]
			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "Dovrebbe andar bene così, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~ ~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Ah! Ecco, se n'è già andata a dipingere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "#Ahem... {F#Care}{M#Cari} giudici, preparatevi a meravigliarvi! Quale capolavoro ci porterà la nostra talentuosa Kuuhenki artista oggi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Eh? Hai già finito?! Paimon non ha neanche finito la presentazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Vediamo un po'... Oh! Un altro ritratto di Colombina. Paimon non è sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "È molto bello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "È... una foresta da qualche parte qui a Nod-Krai? Ci sono così tanti animaletti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Temo... che dovresti tornare indietro a un tempo in cui non avevo ancora lasciato gli Eredi della Luna gelata per vedere una scena di questo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510312,
					"content": "Wow, Paimon è davvero invidiosa! Ma davvero ti si riunivano attorno in quel modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Sì, la maggior parte di loro era attratta dal Kuuvahki intorno a me. Si sentivano al sicuro accucciandosi al mio fianco in quel modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510314,
					"content": "Ma che bello! Potevi accarezzarli quanto volevi senza rischiare che scappassero via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Mmmh... Gli Elegantassi erano i più belli da accarezzare. Sono quelli con le code folte e morbide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510316,
					"content": "Anche la pelliccia sul collo dei Cervi Cornabrina è molto soffice. È un ottimo cuscino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510317,
					"content": "Voi quale preferite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510318,
					"content": "Ehm, non abbiamo molta esperienza in questo campo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Ma probabilmente Paimon sceglierebbe di accarezzare la coda di un Elegantasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Gli Elegantassi possono essere piuttosto timorosi. Se ne vuoi accarezzare uno, devono prima sentirsi al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510321,
					"content": "Ah... Però farei attenzione, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510322,
					"content": "Perché? Mordono? P-Paimon promette di essere super gentile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "No. Mi riferisco al pericolo proveniente dal cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510324,
					"content": "Un pericolo proveniente dal cielo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Sì... Gli Ibis Lungapiuma cacciano spesso animaletti come questi. Ho dovuto ordinargli di smetterla di cercare di cacciare le Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510326,
					"content": "Adesso lo dici?! È un miracolo che Paimon non sia ancora stata portata via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah... La prossima volta che ne vedrò uno, gli dirò di lasciare stare anche te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510328,
					"content": "\"La prossima volta\"? No, devi trovarne uno adesso, o Paimon avrà troppa paura per uscire da quella porta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, capisco. In tal caso, mi assicurerò di dire loro che Paimon è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510330,
					"content": "La miglior compagna di viaggio di sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Esatto! Non possono semplicemente andarsene in giro a rubare i compagni di viaggio delle persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "La piccolina... sembra abbastanza incuriosita dall'idea di Paimon che viene portata via da un Ibis Lungapiuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760510338,
					"content": "Non ti azzardare a dipingere una scena del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "La guida di viaggio migliore di Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Ehm... Paimon è felice che tu la veda così, ma... Probabilmente non sanno che cos'è una \"guida di viaggio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Una fonte di cibo che darebbe fastidio al loro stomaco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "No, non mettergli in testa neanche l'ombra di questo pensiero! E se ci provassero lo stesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Solo a guardarlo mi sento felice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
