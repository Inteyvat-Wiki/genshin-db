			"dialogs": [
				{
					"id": 750141201,
					"content": "Eh? Stai bene, piccolino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141202,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "Ma guardati, sei così allegro e vivace, e sul corno hai un motivo davvero speciale... Niente male davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141204,
					"content": "Però, come mai siete venuti qui insieme? I miei insegnamenti non sono stati chiari? Non credo proprio, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141205,
					"content": "Rooh? Roooarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "Eh? Cosa c'è che non va? Ti ha portato lui qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141207,
					"content": "(Non posso permettere che si accorga di me...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "Hooo... Hoooo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "Cosa sono questi rumori strani? Ti senti male? Ti comporti in modo diverso dal solito. Forse è il caso di farti visitare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141211,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "Sii paziente, piccolino. Presto sarà anche il tuo turno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141221,
					"content": "Tu sei il primo. Seguimi. Hai capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141213,
					"content": "(Annuisci.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "Dove hai imparato a fare così? Oh, cribbio, non mi dirai che riesci a capirmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141219,
					"content": "#All'improvviso, si sente un fracasso provenire dall'esterno...\\n\"Chi ha aperto la cassa.. Ehi! Lascialo! Smettetela di litigare! Quilla si arrabbierà!\"\\nNon c'è tempo per capire cosa sta succedendo. Approfitti della confusione per fuggire dall'accampamento insieme a {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "(Scuoti la testa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "Dove hai imparato a fare così? Oh, cribbio, non mi dirai che riesci a capirmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141217,
					"content": "(Seguila.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "Molto strano... Non ti ho dato nessuna istruzione. Capisci quello che dico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141209,
					"content": "Roar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				}
			]
		},
