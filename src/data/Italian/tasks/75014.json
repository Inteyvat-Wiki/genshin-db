			"dialogs": [
				{
					"id": 750141601,
					"content": "Ugh, si mette male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141602,
						750141605
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141602,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141603
					]
				},
				{
					"id": 750141603,
					"content": "Beh, sapete, ho un fratellino molto più giovane di me. Forse è perché è nell'età della ribellione, ma sembra non riesca ad andare d'accordo con nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141604
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141604,
					"content": "Bah, non posso addossarvi anche questo. Immagino che le cose si sistemeranno quando crescerà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141605,
					"content": "Scusa il disturbo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141606
					]
				},
				{
