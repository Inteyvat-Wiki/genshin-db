			},
			"dialogs": [
				{
					"id": 750141001,
					"content": "#{NICKNAME}! Meno male che stai bene. Ero in pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Sì, è stato davvero da brividi! Uh, ma ne parliamo dopo, è un po' difficile da descrivere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Raccontate a Taruka ciò che avete visto e sentito all'accampamento...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Sul serio? Avete visto Quilla, ma non Lamizana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Beh, stavano parlando di una gara aerea e di una transazione. Paimon non sa i dettagli, ma sembrava fosse qualcosa da usare durante la competizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Quilla è una mercante itinerante arrivata qui non molto tempo fa. Secondo quanto ha detto Paran, tratta un'ampia varietà di merci. Lamizana potrebbe aver acquistato qualcosa di pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Capisco. Quindi vuole attuare il suo piano nel corso della gara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Che genere di piano è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Non lo so... ma di certo sta escogitando qualcosa di pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Ah, siete qui. Splendido! Tu devi essere {NICKNAME}, giusto? Lamizana mi ha detto che hai provato il percorso di allenamento e che te la sei cavata piuttosto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Non è stato difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "La situazione è questa: la gara aerea sta per iniziare, ma i concorrenti che avrebbero dovuto competere con Lliwa si sono ritirati all'ultimo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "E beh... Conoscete Taruka, sapete quanto sa essere competitivo. Non sarà mai soddisfatto di una vittoria facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Tanto vale che si ritiri anche lei, a questo punto. Penso che andrò da lei per convincerla a farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "A-Aspetta, non possiamo! Si è preparata tanto per questa gara, la soluzione migliore sarebbe trovare qualcuno con cui farla gareggiare che sia al suo stesso livello, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#È per questo che vi siete rivolti a {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Sì. Se parteciperai, ti ricompenseremo a prescindere dalla tua posizione finale in classifica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Ecco, ora mi stai sottovalutando per davvero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Eh? Ah, hai ragione... Beh, allora, se finirai tra i primi classificati, ti conferiremo la relativa ricompensa più un bonus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Grazie per la tua decisione! Più tardi riceverai una lettera d'invito. Ora ho degli altri preparativi da ultimare, mi sa che ci vedremo direttamente il giorno della gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran si allontana, portando con sé Carrebau...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME}, hai accettato la proposta perché ci darebbe l'opportunità d'investigare più da vicino, giusto? Se succedesse qualcosa durante la gara, i concorrenti sarebbero i primi a saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Ho anche la sensazione che le cose siano meno semplici di come appaiono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "A proposito di voci, comunque, quella di Paran aveva qualcosa di familiare. Non l'abbiamo già sentita da qualche parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Lui si occupa di quasi tutto ciò che ha a che fare con la scuola di volo. Corre sempre a destra e a sinistra insieme a Carrebau, quindi è raro non aver mai sentito la sua voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "Logico! Ora che ci pensa, Paimon ha l'impressione di aver letto una cosa del genere all'interno di una storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Se qualcuno che si mimetizza con l'ambiente circostante commette un reato, la gente di solito non sospetta di lui perché sono tutti abituati alla sua presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Mmh... Meglio non dirglielo in faccia, però. La sua famiglia è stata esiliata perché uno dei membri è reo di un fatto gravissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "In molti l'hanno usato come scusa per rendergli le cose difficili... Sarà per questo che tende a essere così severo con sé stesso e al tempo stesso così ossequioso nei confronti degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Anche se è molto in confidenza con Lamizana, ammetto che è un tipo molto gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Questo Lamizana sembra un tipo piuttosto sgradevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Mettiamola così: chiamarlo \"sgradevole\" sarebbe fargli un complimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Paimon ti ringrazia per averglielo detto! Le sarebbe dispiaciuto ferirlo, anche inavvertitamente. Comunque, parlando della gara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Taruka, non preoccuparti per tua sorella. Ci penserà {NICKNAME} a vegliare su di lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Mmh... Vi aspetterò al traguardo. Io e Lamizana dovremmo arrivare per primi, quindi terrò gli occhi su di lui fino alla fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Hrrooo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Non è ancora il tuo momento, {REALNAME[ID(2)|SHOWHOST(true)]}. Per stavolta rimani a guardare insieme a Paimon, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "Wrrahr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
