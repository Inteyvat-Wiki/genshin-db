				},
				{
					"id": 750141040,
					"content": "Sembra se la passi male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "No, in realtà voglio solo il premio di partecipazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Eddai! Ti darà un'aria ancora più rispettabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Perfetto, un premio di partecipazione garantito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "#Eh? Ti facevo molto più {F#ambiziosa}{M#ambizioso}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Davvero? Mi sta sottovalutando, per caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "No, nient'affatto! Un attimo... Cosa direbbe Temach in una situazione simile? Ah, sì! Il percorso di allenamento sarà stato una noia mortale, per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141015
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141009,
					"content": "Che motivo ha per farlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				}
			]
