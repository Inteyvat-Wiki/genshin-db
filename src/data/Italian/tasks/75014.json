					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "Beh, nessuno può accusare un Iktomisauro... Cioè, te, ma non dire cose così spaventose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "C-Comunque, Paimon stava solo improvvisando! Non sareste riusciti a fuggire se lei non avesse fatto tutto quel chiasso là fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141327,
					"content": "Fortuna ha voluto che la cassa fosse piena di Saurocracker. Gli Iktomisauri ci si sono buttati a capofitto appena si è rovesciata per terra. Avresti dovuto vedere, che disastro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141328,
					"content": "Ma nemmeno Paimon ha visto Lamizana all'esterno, e neanche quelli che stavano facendo la transazione. Sembra che nessuno di loro fosse Lamizana, comunque, avevano delle voci diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141329,
					"content": "Uhm... In ogni caso, andiamo da Taruka a riferire ciò che abbiamo visto e sentito poco fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
