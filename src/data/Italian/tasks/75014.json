			},
			"dialogs": [
				{
					"id": 750140801,
					"content": "(Uhm... Paimon non vede granché bene da qui, ma pensa che potrebbero beccarci se ci avvicinassimo. Se vogliamo ascoltare, meglio restare dove siamo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "Siamo molto soddisfatti della qualità delle ultime forniture. Grazie, ci affideremo ancora a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "Non c'è di che. Seguiamo il solito protocollo, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Sì. La merce andrà consegnata prima della gara aerea. Alcuni ne avranno bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Non c'è problema. Anche lì dovrebbero aver già finito di discutere. Torniamo indietro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Eh? Se ne stanno già andando? Non è andata come Paimon si aspettava... Torniamo indietro anche noi, non facciamoci beccare!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
