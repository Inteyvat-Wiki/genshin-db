					}
				]
			},
			"dialogs": [
				{
					"id": 100090801,
					"content": "Ecco fatto... La tua esecuzione è stata perfetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Sì, non vedo alcun difetto nella preparazione... Lascia che ne estragga un po' per testarne la composizione. Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose estrae un po' della pozione e utilizza un dispositivo per esaminarne la composizione...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Sì, l'esecuzione è stata perfetta, e anche la pozione risultante lo è. È esattamente quello che mi aspettavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "Allora la settima volta è stata quella buona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Dopo l'analisi, sembra identica alle sei iterazioni precedenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Ah... Questo non renderebbe identici anche i risultati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Non necessariamente. I risultati degli esperimenti possono differire anche con variabili simili. Non si può mai sapere quale sarà il risultato. È proprio questo che rende gli esperimenti preziosi in primo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Forza, testiamo questa cosa. Ho piantato alcuni Fiordolci in anticipo che possiamo utilizzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Dobbiamo solo bagnarli con la pozione e vedere cosa succede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1000909,
			"completionStepIds": [
				1000909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
