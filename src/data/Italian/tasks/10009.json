						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1087.496,
							285.861,
							-441.246
						],
						"pointId": 14227
					},
					{
						"sceneId": 3,
						"position": [
							1087.191,
							285.861,
							-441.896
						],
						"pointId": 14228
					},
					{
						"sceneId": 3,
						"position": [
							1087.249,
							285.861,
							-440.176
						],
						"pointId": 14229
					}
				]
			},
			"dialogs": [
				{
					"id": 100090901,
					"content": "Bene, abbiamo versato il siero della crescita sui fiori... È tutto quello che dobbiamo fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090902,
					"content": "Sì. I fiori devono assorbire completamente la pozione, quindi potrebbe volerci del tempo prima di vedere una reazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090903
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090903,
					"content": "Che cosa succede dopo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090904,
					"content": "I fiori cresceranno di dimensione mantenendo il loro aspetto originale. Ma quando raggiungeranno dalle dodici alle quattordici volte le loro dimensioni normali, si rivelerà più di quanto possano sopportare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090905
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090905,
					"content": "Come se avessero raggiunto un limite massimo, appassiranno e marciranno, assumendo forme innaturali fino a quando ne rimarrà soltanto il liquido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090906
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090906,
					"content": "Aspetta, cosa? Quindi c'è un problema con il siero della crescita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090907,
					"content": "No. Ho modificato la formula più e più volte, risolvendo tutti i tipi di problemi che si presentano quando si induce una crescita delle piante piccole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090908
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090908,
					"content": "Problemi come... assicurarsi che le foglie non diventino troppo grandi, rafforzare il diametro delle radici e la capacità di carico, calcolare come l'aumento della superficie possa influenzare l'esposizione alla luce solare e la nutrizione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090909
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090909,
					"content": "Allora perché non funziona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090910,
					"content": "Perché i fiori non possono trascendere... \"Come sopra, così sotto\" è uno dei principi guida dell'alchimia. L'alchimia cerca di padroneggiare la materia, ma questo mondo ha i suoi limiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090911
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090911,
					"content": "È come... una \"specifica\" incisa nella legge che governa tutte le cose. Parte dello scopo di fare esperimenti multipli è determinare se questa \"specifica\" sia stabile o meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090912
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090912,
					"content": "Quindi, anche il \"fallimento\" è un risultato valido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090913
					]
				},
				{
					"id": 100090913,
					"content": "Esattamente. Dimostra che il limite \"continua a esistere\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090914
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090914,
					"content": "Ok, questo è un po' troppo complicato per Paimon, ma in pratica... Avevi bisogno che l'esperimento fallisse per dimostrare che i limiti e i confini in questo mondo sono stabili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090915,
					"content": "Che strano esperimento... Eh? Sembra che uno dei fiori stia reagendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090916,
					"content": "Aspetta un attimo... Quello non è affatto un Fiordolce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090917,
					"content": "Attenzione! È un Malefiore! Deve aver assorbito un po' della pozione. Aspetta. Ma è già successo prima, e non è mai diventato così grande. Che questo voglia dire che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090918
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090918,
					"content": "Ne parliamo dopo. Prima dobbiamo liberarcene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
