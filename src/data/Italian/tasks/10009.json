			"dialogs": [
				{
					"id": 100090101,
					"content": "Mmm... Considerando i risultati precedenti, dovrei apportare alcune modifiche all'esperimento e assicurarmi che i materiali e l'equipaggiamento siano tutti in ordine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#Per quanto riguarda la pozione che devo preparare... Oh, {NICKNAME} e Paimon! Cosa vi porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "Siamo qui per aiutarti con il tuo \"compito\". Volevamo vedere se ti serviva qualche mano in più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "Il mio \"compito\"... Ah, intendi quello di cui mi ha parlato il signor Albedo? Quello dell'Hexenzirkel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "#Beh, siete {F#arrivate}{M#arrivati} giusto in tempo. L'esperimento è in corso, e stavo proprio per mettermi al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "In corso? Quindi ci hai lavorato per tutto questo tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Sì. Si allinea con altri argomenti di ricerca su cui sto lavorando, quindi non è stato un gran lavoro aggiuntivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "Che c'è? Qualche problema con l'esperimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Finora non ho avuto \"successo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "Oh, quindi continua a fallire, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Non è semplicemente una questione di \"fallimento\". L'intero quadro teorico dietro questo compito è un po' più complicato di quanto immaginassi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "Quindi di che compito si tratta, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Ah, giusto! Non ci hai ancora detto di che tipo di esperimento si tratta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Un esperimento per sviluppare una pozione che può trasformare i Fiordolci in una variante sedici volte più grande del normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "In altre parole, la formulazione del \"Reagente di aumento botanico tipo IV, iterazione VII\"... Come probabilmente potrete immaginare, questa è la settima volta che conduco l'esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Wow! Quindi, in pratica, dobbiamo creare un siero della crescita! O meglio, la sua settima versione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "B-Beh, sì... È più o meno così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "Questo è il mio settimo tentativo, ma questa volta non ho apportato molte modifiche alla formula, perché sia i principi teorici alla base di questo esperimento che i prodotti del processo dimostrano che non c'è nulla di sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "Ma non hai ancora avuto \"successo\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Sì. Penso che non sia la mia formula attuale a essere sbagliata, di per sé, ma piuttosto... Manca qualche altro elemento chiave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Ohhh... Hihi, allora Paimon sa esattamente cosa fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Lasciaci dare una mano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "#Sì! Dopotutto, siamo {F#venute}{M#venuti} qui proprio per questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Ehm, potremmo provare, è solo che... dovrei modificare le proporzioni nella formula originale, e questo potrebbe rendere la pozione ancora più instabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "No, NON ci proveremo affatto! Mostraci solo l'originale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "Ecco qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "Detto questo, mi mancano ancora due ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "In questo possiamo aiutarti. Cosa dobbiamo procurarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "Ho bisogno dell'acqua di sorgente del Villaggio Acquachiara da utilizzare come base, e anche dei frammenti dell'Occhio del ciclone... Ma quest'ultimo potrebbe essere complicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "Ci pensiamo noi! Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Forse potremmo provare ad aggiungere un po' di essenza di Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Hihi, ecco perché stiamo aiutan... Aspetta un attimo, Paimon NON è un ingrediente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
