			},
			"dialogs": [
				{
					"id": 100091101,
					"content": "Fiuu, ce l'abbiamo fatta. Anche con quelle dimensioni, un Malefiore è sempre un Malefiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091102,
					"content": "...Mmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091103,
					"content": "Ma, ehm... Doveva diventare così grande?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Durante il combattimento ho potuto fare solo una stima approssimativa, ma sembrava almeno... sedici volte più grande delle sue dimensioni originali, forse anche di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091105,
					"content": "Questo significa che l'esperimento... è riuscito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "Aspetta... Non è una cosa positiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Non sono ancora sicura delle implicazioni... Ma se ulteriori tentativi riuscissero a riprodurre questo risultato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Significherebbe che c'è qualcosa di diverso... Forse i limiti e le leggi di questo mondo stanno cambiando a causa di qualche fattore ignoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Non so dire se questo sia un bene o un male ma, almeno da una prospettiva alchemica, l'ampliamento dei confini significa che ora ci si aprono più possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "In ogni caso, questo porta a termine il mio compito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091111,
					"content": "Sembra proprio così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Mmm. Detto questo, potrebbe anche essere un effetto della persona che ha preparato la pozione, o magari c'era qualcosa di speciale in questo particolare Malefiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "C'è ancora molto da confermare, quindi suppongo che questo compito apra la strada a ulteriori domande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "Beh, se mai avrai bisogno di aiuto, conta su di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Potremmo provare a usare quel siero della crescita su Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Hihi, pensaci un attimo... Se Paimon fosse sedici volte più grande, potrebbe probabilmente ridurre in poltiglia un'intera banda di Cacciatori di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Ho i miei dubbi. Il siero ha funzionato sul Malefiore solo perché la sua struttura interna era abbastanza simile a quella di un Fiordolce... Se tu ne bevessi un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "Potresti diventare sedici volte più grande, ma potresti anche trasformarti in una forma di vita vegetale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "No, no. Non se ne parla proprio, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Ah, a proposito, Paimon voleva chiedere... Perché tutte le tue ricerche sono incentrate su cose come i Fiordolci e i Tramontini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Oh, è semplice. Sia i Tramontini che il nettare dei Fiordolci hanno un sapore dolce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Quindi, in questo senso, rendere accidentalmente un Malefiore sedici volte più grande ha un vantaggio nascosto, perché il nettare del Malefiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "...Ha esattamente lo stesso sapore dei Fiordolci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Esatto! Una volta estratto lo zucchero dal nettare, ve ne darò un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091125,
					"content": "Hihi, affare fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}