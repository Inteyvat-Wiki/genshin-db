			},
			"dialogs": [
				{
					"id": 100090601,
					"content": "Bene, gli ingredienti sono pronti e il calderone è proprio lì, quindi dovremmo essere a posto. Ma, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "No, no. È solo che... Vi dispiace se osservo da qui? Solo per prendere nota accuratamente, intendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "So che a molte persone non piace essere osservate durante gli esperimenti, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Non è affatto un problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Grazie. Allora, sono pronta a partire quando vuoi. Mi assicurerò di prendere appunti dettagliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "#Allora, sei {F#pronta}{M#pronto} a iniziare l'esperimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
