					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "Cosa? Davvero hai rimosso la Matrice delle Sette Stelle? Uff, questa è una cosa che dovrò scrivere nel rapporto settimanale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Vedi di farlo sembrare pazzesco, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "*tossisce* Senti, è una faccenda piuttosto seria. È così seria che le Sette Stelle in persona dovranno sancirne la gravità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Vale a dire che, non appena avrò inviato il rapporto, qualcuno delle Sette Stelle potrebbe venire qui di persona a fermarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "E a quel punto nemmeno io potrò salvarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(È fin troppo scontato...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Hai paura, eh? Forza, allora, vattene! C'è ancora qualcuno che ti aspetta, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
