				"objectNames": [
					"Vaino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "#Magari si potrebbe pensare a una battaglia a squadre, oppure a un duello... Ah, siete voi! {F#Benvenute}{M#Benvenuti} al campo d'addestramento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "A proposito del campo d'addestramento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Ultimamente sta arrivando sempre più gente. Ed è grazie a voi. Anche se pure i bambini e le Manivuote hanno aiutato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Penso che il campo di allenamento sia il posto perfetto per incontrarsi. Quando incontri qualcuno che non vedi da tempo, è difficile sapere da dove cominciare la conversazione, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "A proposito delle Manivuote...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah... Non ho ancora trovato niente che funzioni meglio dei bersagli per i nidi delle talpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "I bambini ed io abbiamo provato ogni tipo di materiale, ma a loro piacciono davvero solo i bersagli. Quindi per ora, commerciare con loro rimane la nostra unica opzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Ma abbiamo più o meno capito i loro tassi di scambio, e stiamo facendo un bel profitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Passerò di nuovo qualche volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "#Sarai sempre {F#la benvenuta}{M#il benvenuto}! E ricordatevi che sarà sempre gratis per voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
			"id": 7605719,
