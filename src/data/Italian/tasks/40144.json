					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "Ah, sei tu, tesorino! A cosa devo l'onore di questa visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Siete qui per dare un'occhiata in biblioteca? O forse per visitare una certa persona...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Siamo qui per vedere te, naturalmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "#Eheh, {F#premurose}{M#premurosi} come sempre, vedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Ahimè, che sfortuna... Si dà il caso che mi abbiate beccato nel bel mezzo di un lavoro importante. Vi offrirò una tazza di tè, uno di questi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Aspetta, sei davvero impegnata... con il lavoro? Non è qualcosa che si vede tutti i giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Ahah, hai ragione. L'ultima volta che mi sono concentrata così tanto su una ricerca deve risalire ai tempi dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "È da un bel po' che non penso così tanto. È piuttosto estenuante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Stai scrivendo una tesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Eheh, se t'interessa così tanto, perché non ti unisci a me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Che ne pensi? Vuoi aiutarmi a rivivere i miei giorni da ricercatrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "Appioppare il tuo lavoro agli altri non è gentile, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Allora è un no, {NICKNAME}? Sarebbe un'opportunità rara per lavorare insieme... E, ovviamente, verresti generosamente {F#ricompensata}{M#ricompensato}. Ma se non vuoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Sono tutt'orecchi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Come probabilmente saprai, i Cavalieri di Favonius conducono ricerche sull'alchimia da diverso tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Ma gran parte di quelle ricerche è stata condotta in laboratorio. La conoscenza pubblica dell'alchimia è piuttosto limitata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Questo significa che, finora, molte delle ricerche e delle scoperte sono rimaste piuttosto distanti dalla vita quotidiana della gente. Abbiamo investito molti Mora nella ricerca, ma abbiamo molto poco da mostrare in rapporto ai nostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Notando questo distacco, Jean ha deciso di avviare un'iniziativa in cui condividere i frutti del nostro lavoro con la gente comune. Per ora, questo significa fargli conoscere diversi tipi di pozioni alchemiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Guarda caso, ho già un po' di esperienza in questo genere di attività. Anche se di solito lavoro in biblioteca, in passato ho aiutato a gestire la fornitura delle pozioni dei Cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Anche la pozionistica era una delle mie specialità accademiche di un tempo, quindi Jean ha pensato che fossi la persona più adatta per il lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Ma, per preparare pozioni abbastanza funzionali da soddisfare le necessità quotidiane della gente, sono state apportate svariate modifiche agli ingredienti che usiamo, e anche il processo alchemico complessivo ha dovuto essere semplificato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Tutto sommato, ciò che è iniziato come un progetto di ricerca relativamente semplice si è presto evoluto in qualcosa di estremamente complicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "#Quindi ci stai chiedendo di aiutarti nella tua ricerca? Perché, ehm, non stai parlando esattamente con due {F#esperte}{M#esperti} di alchimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Eheh, non preoccupatevi. Ho già in mente il lavoro perfetto per voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Le pratiche alchemiche sono sempre più avanzate, ma la nostra ricerca e l'opinione pubblica sono ancora scollegate tra loro. Quello che ci serve davvero è raccogliere il parere delle persone. Altrimenti, non sapremo veramente se stiamo soddisfacendo i loro bisogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Ma, se vogliamo condurre le ricerche e raccogliere i pareri della gente allo stesso tempo, dobbiamo fare le cose in modo più efficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Così ho pensato che il modo migliore per farlo fosse aprire un negozio di pozioni! In questo modo, potremmo continuare a occuparci di alchimia, ma al contempo saremmo in grado di interagire con il pubblico e comprenderne i bisogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Ah! È come prendere due piccioni con una fava! Che gran pensata, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Beh, certamente! E chi meglio potrebbe svolgere questo incarico se non {F#una}{M#uno} dei nostri Cavalieri più esperti... {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Quand'ero all'Akademiya, gli studenti si aiutavano spesso a vicenda nei progetti di ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Sono certa che i miei tesorini non vorrebbero perdersi l'occasione di sperimentare di persona quel tipo di entusiasmo giovanile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Sì, sì... Tutto molto bello, ma Paimon pensa ancora che tu stia solo cercando un modo per rifilarci il tuo lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Potremmo considerarlo semplicemente un favore a Lisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Eheh, sapevo di poter contare su di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "#Quando tutto il nostro lavoro sarà terminato, mi assicurerò personalmente che tu sia {F#ricompensata}{M#ricompensato} generosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Tutti i preparativi iniziali sono stati completati, possiamo recarci al negozio. Concluderemo la nostra discussione una volta lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "#Sono sempre {F#pronta}{M#pronto} ad accettare una sfida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Ahah, mi piace il tuo entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Sentiamo prima i dettagli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Stai lavorando a un progetto di ricerca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Passavamo di qui per caso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "E avete deciso di fermarvi per fare due chiacchiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
