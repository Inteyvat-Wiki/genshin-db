			"dialogs": [
				{
					"id": 401440401,
					"content": "Ooh, sembra che stia andando tutto magnificamente. Hai già venduto il tuo primo lotto di pozioni. Un inizio niente male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Per quanto riguarda le prossime pozioni da preparare, dovremo consultare le ultime novità del mercato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Il che significa tenerci aggiornati sulle tendenze del momento per cercare di anticipare i bisogni delle persone. È un'abilità essenziale negli affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Uh, sembra piuttosto difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Eheh... Non preoccupatevi. Mi sono già premurata di raccogliere tutte le ultime novità sul mercato per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Che ne pensate? Avete qualche idea sul prossimo tipo di pozioni da vendere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Provate a coltivare degli ingredienti, allora. La bioalchimia può conferire caratteristiche e proprietà diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Usare degli ingredienti diversi durante il processo di fermentazione, a sua volta, modificherà gli effetti della pozione. Ci sono un sacco di combinazioni da provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Va bene, tesorino, perché non cominci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
