			"dialogs": [
				{
					"id": 401440701,
					"content": "#Salve, Cavaliere {F#Onoraria}{M#Onorario} e Paimon! Sono Freda, una Cavaliere della divisione logistica. Incontrare {F#la famosa}{M#il famoso} {NICKNAME} e la sua fedele assistente è un vero privilegio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "Wow, la fama di Paimon la precede in tutta Teyvat, hihi! Solo una piccola correzione, però: Paimon è la sua partner, non la sua assistente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Ah, chiedo scusa. Dopo aver sentito parlare di tutte le vostre imprese, mi sono lasciata trasportare. Sembra quasi un romanzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Siete praticamente delle leggende. In realtà sono un pochino invidiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "Mi piacerebbe girovagare per il mondo alla ricerca di avventure come uno di quei Cavalieri di cui si legge nei libri! Sembra una vita davvero divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Magari un giorno ne avrai l'occasione!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Sì! O almeno è quello che spero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Comunque... Abbiamo dei preparativi da completare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "La Gran Maestra Reggente mi ha ordinato di supportare la vostra attività in ogni modo possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Se posso fare qualcosa, non esitate a dirmelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Vorremmo comprare dei rifornimenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "È il vostro giorno fortunato! Ho appena ricevuto un nuovo lotto di provviste! Prego, date un'occhiata e ditemi se c'è qualcosa di vostro interesse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "Buona fortuna per la vostra attività!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "A dire il vero, non è tutto rose e fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Immagino. I Cavalieri delle storie corrono sempre ogni genere di pericolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
		},
