					{
						"sceneId": 3,
						"position": [
							2518.407,
							203.41,
							-1139.256
						],
						"pointId": 300300753
					}
				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "Questo è il negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Wow! Sembra che tu abbia già completato molti preparativi! Hai fatto tutto da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "È stato un lavoro di squadra. Sono venuti dei Cavalieri a dare una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean ha ottenuto i fondi iniziali per aprire il negozio. Albedo e Sucrose hanno fornito gli ingredienti e le attrezzature necessari per preparare le pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "E la divisione di logistica si sta occupando della fornitura degli approvvigionamenti futuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Con il vostro aiuto, mi sento come se mi fossi tolta un ulteriore peso dalle spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Negli ultimi giorni, i Cavalieri sono stati impegnati a spargere la voce sul nostro negozio. Una volta finito con gli ultimi preparativi, dovremmo essere pronti ad aprire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Bene, non perdiamo altro tempo. Perché non prendi questi ingredienti e provi a preparare una pozione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
