			"dialogs": [
				{
					"id": 401440601,
					"content": "Sembra che te la stia cavando egregiamente nella coltivazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "A proposito... È arrivata una Cavaliere della divisione logistica. Si occuperà di tutti i futuri rifornimenti. Dovresti andare a parlare con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "Dopodiché potrai goderti il tuo momento di gloria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "Un momento, e tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "Sì! Non dovrebbe essere il nostro momento di gloria? Sai, di noi tre assieme? Cosa ne è del tuo ruolo in tutto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "Il mio ruolo? Ovviamente è stato quello di assicurarmi che i miei tesorini acquisissero le conoscenze alchemiche e gestionali necessarie ad avere successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Non smetterò di supportarvi! Buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon sapeva che sarebbe successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
