			"dialogs": [
				{
					"id": 200140201,
					"content": "Wow, li hai sconfitti tutti! E l'hai anche fatto sembrare facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Come dice il manuale, puoi sconfiggere i mostri in tanti modi diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Ma devo comunque ammettere che continuano a spaventarmi quando sono così vicini. Meno male che sei qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Hai ancora bisogno di addestramento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Sì, lo so. La strada per diventare un'avventuriera non è affatto semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}! Torno in città. Mio fratello dev'essere preoccupato da morire ormai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Devo allenarmi più duramente da ora in poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
