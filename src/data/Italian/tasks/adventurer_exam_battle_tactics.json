				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, ti prego, ripensaci. Dovremmo davvero pensare a lungo termine in questo caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Oh, su! Smettila di preoccuparti! Me la caverò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Tutto bene, Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#Viaggiat{F#rice}{M#ore}! Arrivi al momento giusto! Per favore, devi aiutarmi. Anna vuole diventare un'avventuriera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "E perché non posso essere un'avventuriera? Sono perfettamente in salute, e Cyrus dice che ho anche la mentalità giusta per questo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Non è nemmeno passato molto tempo da quando sei guarita! Come farai se ti ammali di nuovo? Senza contare che i nostri genitori non saranno mai d'accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Dai, ne ho già parlato con mamma e papà. Dicono che se passo gli esami di selezione della Gilda degli avventurieri me lo lasceranno fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "C-Cosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Calmati, ragazzo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Qualche giorno fa Cyrus mi ha aiutata a pianificare l'addestramento. Non ho smesso di allenarmi da allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Comunque, si è trattato soprattutto di ricognizioni, ricerche di cibo per razioni di emergenza, sopravvivenza all'aperto, roba del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Ma ho sentito dire che spesso gli avventurieri affrontano anche dei mostri nella natura selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Mi piacerebbe tanto imparare a farlo, ma non ho trovato nessuno che me lo insegni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "E come puoi vedere, mio fratello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Non lo accetterò! Quei mostri sono estremamente pericolosi! E anche se andassi per davvero, dovresti almeno assicurarti di essere accompagnata da un veterano con esperienza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Ma ho chiesto a Jack! Ha accettato di aiutarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Sei seria? Conosco Jack. Riesce a malapena badare a sé stesso là fuori, figuriamoci a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Beh, dubito che troveremo così facilmente altri avventurieri esperti alla Gilda, e non ho abbastanza soldi per pubblicare un annuncio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Mmh. Potrei venire con te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Eh? Davvero mi aiuteresti? Che bello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Bene. Allora puoi tranquillizzarti ora, Anthony!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#*sospira* Va bene, va bene. So quanto sia forte {F#la Cavaliere Onoraria}{M#il Cavaliere Onorario}. Con {F#lei}{M#lui} al tuo fianco, penso che potrò rilassarmi un pochino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "In ogni caso, devi comunque fare attenzione là fuori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "Ricordi tutto quello che ti ho detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Sì, sì, mi ricordo... Me lo hai ripetuto fino a farmi cadere le orecchie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "#Bene allora, viaggiat{F#rice}{M#ore}, partiamo adesso! Ho chiesto a Jack di controllare l'accampamento in cui stiamo andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Ho una certa fiducia nelle mie abilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Allora, come sta andando il tuo addestramento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, di cosa state parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
