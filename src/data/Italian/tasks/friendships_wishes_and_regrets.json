				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Con tutto quello che sta succedendo, Paimon è in confusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Nemmeno io mi aspettavo di imbattermi in Lang in questo modo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "In realtà, non sono affatto sorpresa. Ricordate cosa vi avevo detto? Ci sono tanti spiriti maligni in questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "È stato tutto uno scherzo del destino fin dall'inizio. Ora, per qualche motivo, non può più tornare sulla Collina di Wuwang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Paimon pensa che questa spiegazione sia un po' inverosimile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "In realtà... ha riassunto abbastanza bene la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120108,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Eheh, non mettere mai in dubbio il mio istinto professionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Volevo solo vedere come stavano i miei amici. Ecco perché sono venuto al Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120111,
					"content": "Giuro che non volevo fare niente di male! Non volevo spaventare nessuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120112,
					"content": "Qualche giorno fa, delle persone sono venute sulla Collina di Wuwang per una scommessa. Li ho sentiti dire che venivano dal Porto di Liyue, così ho seguito uno di loro e mi sono ritrovato qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120113,
					"content": "Ah, devi aver seguito il povero Luocheng. Anche se non ti ha visto, ha comunque percepito la tua presenza. Ora sappiamo perché aveva gli incubi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "S-sono stato scoperto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120115,
					"content": "Beh, suppongo di sì, altrimenti non si sarebbe spaventato a morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Perché non sei venuto a trovare Meng prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Già, Hu Tao e Meng ti stavano cercando dappertutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh, perché non riuscivo a trovarli. È la prima volta che vengo al Porto di Liyue e mi sono perso per la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120119,
					"content": "Ora che mi ci fai pensare, Lang ha sempre avuto un pessimo senso dell'orientamento. Quando eravamo bambini, non scendeva mai dalla collina da solo. Dovevamo sempre guidarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Quindi tutto questo è successo solo perché ti sei perso?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Non potevi volare? Come qualsiasi altro fantasma o spirito? Non credi che sia molto più facile ritrovare la strada dall'alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "Io... non ci riesco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120123,
					"content": "Mi fa paura stare così in alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120124,
					"content": "Giusto, mi ricordo! Aveva così tanta paura dell'altezza che non riusciva nemmeno a guardare giù dalla collina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Ahahah, non sei cambiato per niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Sapevo che non potevo farmi vedere dagli esseri viventi, e con così tante persone che andavano in giro per il Porto di Liyue, non avevo altra scelta che nascondermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120129,
					"content": "Non ti avrei mai trovato se non fosse stato per il richiamo del Monolite geomantico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120130,
					"content": "Sono così sollevato che tu non sia diventato uno spirito maligno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Come dicevo, non mettere mai in dubbio il mio istinto professionale. Ora, dobbiamo solo riportare questo bambino smarrito sulla Collina di Wuwang, e questa faccenda può considerarsi definitivamente archiviata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Ma ha appena detto che voleva andare a trovare i suoi amici. Oltre me, ci sono anche il Piccolo Wu, Mumu e Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Beh... se le cose stanno così, non possiamo deluderlo. Chiederemo a tutti loro di aiutarci a organizzare una cerimonia d'addio per Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Io e Meng riporteremo Lang sulla Collina di Wuwang. Voi andate da quei tre e chiedete di darvi dei souvenir che simboleggino ognuno di loro per eseguire il rituale, poi venite a cercarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Dato che sono amici, non possiamo andarci tutti insieme? Oppure possiamo portare noi Lang da loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Uhm... non credo sia una buona idea. Non voglio spaventarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Lang"
				},
				{
					"id": 111120137,
					"content": "Mmh, non voglio che la gente comune diventi superstiziosa... meno ne sanno, meglio è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Per cui, fate attenzione a quello che dite quando recuperate quei souvenir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Ha senso, dopotutto sei ancora un bambino!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Quindi Lang non è uno spirito maligno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Uhm... Salve... eheh... Ti ricordi di noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Uff, ancora voi... Mi dispiace, ma non credo di aver bisogno dei vostri servizi nell'immediato futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120203,
					"content": "Meng ci ha raccontato la sua storia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Sì, siamo cresciuti insieme. Ci teniamo ancora in contatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120206,
					"content": "Non so perché abbia iniziato a lavorare per i Servizi Funebri Wangsheng. A essere onesti, la sua direttrice sembra un individuo piuttosto singolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120207,
					"content": "Ma avrà avuto le sue ragioni. Dopotutto, ora deve cavarsela da solo, e non è ancora riuscito a superare ciò che è successo a Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120208,
					"content": "Te ne ha parlato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120209,
					"content": "Sì. Uhm, se potessi scegliere una cosa da dare a Lang come ricordo, cosa sceglieresti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Ovviamente, parlando in linea teorica. Si tratta solo di un'ipotesi, non vogliamo assolutamente organizzargli una cerimonia d'addio o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Non sa proprio tenere la lingua a freno.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120214,
					"content": "Gli cucinerei qualcosa. Non ho mai conosciuto qualcuno che mangiasse cibo piccante come lui. Il suo piatto preferito era il pollo al peperoncino di Jueyun extra piccante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120215,
					"content": "Posso cucinarglielo se mi portate dei peperoncini di Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120216,
					"content": "Sono sicuro che sarà contento di ritrovare il gusto dell'infanzia. Uso ancora questa vecchia ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120217,
					"content": "Affare fatto! Dacci solo un minuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Tipico di Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Meng ci ha detto che è un tuo vecchio amico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
