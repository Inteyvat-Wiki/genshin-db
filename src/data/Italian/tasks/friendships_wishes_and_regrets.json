			"dialogs": [
				{
					"id": 111120801,
					"content": "Grazie a entrambi, avete fatto un ottimo lavoro. Un attimo, questo è l'ultimo passaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120802,
					"content": "Ci siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "Ho scritto i nostri cinque nomi all'interno della lanterna. Durante il Festival delle lanterne, tutti noi liberiamo in cielo una lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "Qualunque cosa ci riservi il futuro, qualunque sia la strada che scegliamo di percorrere... Nessuno di noi cambierà, così come questa celebrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "Riguardo alla questione relativa a Lang... noi tre ne abbiamo parlato e abbiamo deciso che non ti faremo pressioni in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120806,
					"content": "Ma se ne hai la possibilità, digli che stiamo bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "E che le cose di cui parlavamo un tempo si sono avverate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "Potete contare su di noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Grazie, glielo riferiremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "Lang è fortunato ad avere amici come voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "E non insisterò nel sapere le cose di cui parlavate un tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
