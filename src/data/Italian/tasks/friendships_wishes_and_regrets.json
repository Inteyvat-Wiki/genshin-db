			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Uff... ancora voi. Ve l'ho già detto: non sono interessato alle questioni interne dei Servizi Funebri Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng ci ha parlato di te. Siete buoni amici, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "È vero, sì. Ora che ci penso, so che recentemente ha iniziato a lavorare per i Servizi Funebri Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "I suoi buoni amici hanno capito subito il motivo: l'incidente di Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Ma so che non possiamo fare niente per aiutarlo. Lasciarsi alle spalle il passato è un processo doloroso. Ne so qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Allora, è Lang il motivo per cui siete venuti a trovarmi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Come facevi a saperlo? Non abbiamo ancora detto nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Ahah, sono un uomo d'affari. Ho un sesto senso per questo genere di cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Quando le persone sentono il nome Mumu, pensano che io sia un idiota. Non so quando smetteranno di dirlo, ma... posso dire di aver già fatto ricredere un bel po' di gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Ecco, prendi questa. È una scatola di giocattoli di prima qualità che tutti noi desideravamo avere da bambini. A quei tempi, nessuno di noi poteva permettersela... non avevamo un soldo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Ora, invece, gli affari vanno a gonfie vele, e ho potuto comprarne tantissime. Un sogno diventato realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Wow, sarai super ricco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Ahahah... La considero come un ricordo di un'infanzia ormai lontana. Senza di essa, non saremmo dove siamo oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Quindi, dato che mi avete trovato, suppongo che ora andrete dal Piccolo Wu e Congzi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Esatto! Abbiamo già parlato con il Piccolo Wu, ora dobbiamo trovare Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Capisco. In questo caso, incontriamoci sul cavalcavia del Pendio di Feiyun. Si trova proprio sopra la scalinata che porta al molo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Ho una commissione da sbrigare. Verrò da voi non appena avrò finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
