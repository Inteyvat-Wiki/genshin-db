			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "Eh? Siete tutti qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Stiamo ricordando i vecchi tempi, ripensando agli eventi passati... quello che facciamo da anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120503,
					"content": "La nostra città natale è stata completamente distrutta, per cui non abbiamo nessun posto in cui tornare. Ora, la nostra casa è ovunque ci siano gli amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Mi hanno appena detto che volete dei souvenir, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "Io realizzo lanterne Xiao artigianali vicino al Porto di Liyue. Credo che mi rappresentino più di qualsiasi altra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "Qualche giorno fa ho comprato dei Frammenti di Plaustrite pregiati. Ora si trovano nel magazzino del porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "Ho già parlato con il direttore. Posso chiedervi di recuperarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "Sembra che tu sappia già cosa fare! Saremo velocissimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
