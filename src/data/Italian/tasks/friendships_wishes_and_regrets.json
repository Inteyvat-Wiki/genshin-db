					"Piccolo Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Bene, dovrebbero andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120302,
					"content": "Io inizio a preparare il pollo al peperoncino di Jueyun. Suppongo che abbiate altre persone da cercare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120303,
					"content": "Quando tutti avranno finito, ti porterò il piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Piccolo Wu"
				},
				{
					"id": 111120304,
					"content": "Fantastico! A dopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120305,
					"content": "(Uhm... come faceva a sapere che ci sono altre persone?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111204,
			"completionStepIds": [
				1111204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111204",
							"2"
						],
						"stepId": 1111204,
						"stateName": "QUEST_STATE_UNFINISHED"
