			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Changchang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "Sono Changchang, ho appena donato Dolly... è la mia bambola di pezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010902,
					"content": "Ieri notte ho sognato Dolly che diceva che avrebbe tanto voluto volare in cielo e vedere il panorama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010903,
					"content": "Così l'ho data a signora vicino alla grande lanterna a forma di cervo. Il desiderio di Dolly si avvererà ora, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010904,
					"content": "Ho fatto la cosa giusta, vero? Al Festival delle lanterne i desideri dovrebbero avverarsi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changchang"
				}
			]
		},
