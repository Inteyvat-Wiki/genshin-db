			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "La lanterna Mingxiao di quest'anno è dedicata a Pilastro dei cieli... È sempre stato un esibizionista, non dubito che avrebbe apprezzato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010602,
					"content": "Chi è Pilastro dei cieli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Quando sarà completata, la lanterna Mingxiao di quest'anno sarà davvero identica a lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010604,
					"content": "Beh, così è il piano. Spero che facciano le corna abbastanza grandi, dopotutto erano il suo più grande motivo d'orgoglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010605,
					"content": "Si dice che le corna fossero fatte dell'essenza stessa del potere divino di Rex Lapis... Non esisteva un materiale più resistente in tutta Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010606,
					"content": "Ma poi avvenne quella fatidica battaglia... Gli dèi si scambiavano colpi di tale forza da far crollare i monti... Per evitare che gli abitanti di un villaggio alle falde di una montagna venissero coinvolti, l'Adeptus chiese a un amico di tagliargli le corna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010607,
					"content": "Egli le usò come cuneo per sostenere la montagna... In più, come se quel sacrificio non fosse abbastanza, continuò a combattere strenuamente fino a prosciugarsi dell'ultima goccia di sangue... e della sua forza vitale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010608,
					"content": "È grazie a lui se oggi il Monte Tianheng si erge ancora alto e fiero... Inoltre, il sangue che ha perso nella battaglia ha dato vita al Fiume Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010609,
					"content": "Eheheh... Che crediate o meno alla storia, sono felice che abbiate voluto ascoltarmi mentre la raccontavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010610,
					"content": "Il motivo per cui esiste il Festival delle lanterne è che, nel corso dei secoli, le persone hanno scelto di riunirsi insieme in amicizia piuttosto che rimanere isolate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010611,
					"content": "A presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "A presto. Che le fiamme della saggezza si diffondano e ardano in eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
