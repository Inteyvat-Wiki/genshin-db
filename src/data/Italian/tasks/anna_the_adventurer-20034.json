					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "#Per favore, abbi cura di Anna, viaggiat{F#rice}{M#ore}. Il suo entusiasmo potrebbe averle dato alla testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340402,
					"content": "Non vuoi che diventi un'avventuriera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340404,
					"content": "Rispetto il volere di mia sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340405,
					"content": "Ora che sta di nuovo bene dopo aver combattuto tanto contro la sua malattia, si merita una possibilità di inseguire i suoi sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340406,
					"content": "In quanto suo fratello, la supporterò... in ogni modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340407,
					"content": "È tutto quello che ho da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}