			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "Bene, lavoriamo sodo anche oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340102,
					"content": "Ahah, ti vedo molto carica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Ma certo! Essere un'avventuriera è così emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340104,
					"content": "Beh... ancora non so bene cosa fare quando mi occupo degli incarichi, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340105,
					"content": "#Viaggiat{F#rice}{M#ore}, ti spiace venire di nuovo con me? Ci sono ancora delle cose che vorrei chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340108,
					"content": "Allora partiamo. L'incarico di oggi è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340109,
					"content": "Ah... Dovremo scortare... un altro pallone aerotrasportatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340106,
					"content": "Vuoi che venga con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Ti va? Eheh, certo! Avrei tantissimo da imparare da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
				2003406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003405",
							"3"
