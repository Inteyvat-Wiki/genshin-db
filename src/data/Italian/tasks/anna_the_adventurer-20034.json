				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bennett",
					"Fischl",
					"Anna",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl. Sei andata via troppo in fretta! Hai corso un bel rischio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "Ahah! Il mio castigo divino tonante non risparmia alcun malvivente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Oh, sono Fischl e Bennett! Ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "#Oh, sei tu Anna. E c'è anche {F#la}{M#il} viaggiat{F#rice}{M#ore}! Vi state occupando di un incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "Ah, sei qui, oh tu che hai ricevuto la benedizione della Prinzessin! Di certo sono state le trame del fato a portarti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Mein Fräulein vorrebbe dirti che è felice di averti incontrato per caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "Sto assistendo Anna nei suoi incarichi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "#Esatto, io e {F#la}{M#il} viaggiat{F#rice}{M#ore} stavamo scortando questo pallone aerotrasportatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "Ma, all'improvviso, un gruppo di Cacciatori di tesori ci ha attaccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Oh, mi dispiace tantissimo, è stata colpa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Io e Fischl abbiamo accettato un incarico che ci richiedeva di indagare sulla posizione di una certa banda di Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Oz è riuscito a trovarne le tracce e stavamo per catturarli... quando sono inciampato su un ramo e sono caduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "Il rumore ha allertato quei Cacciatori di tesori, che sono scappati via. Non avevamo altra scelta se non continuare a inseguirli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "Non c'è motivo di agitarsi. La luce viola della condanna deciderà il fato di quei disgustosi criminali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "#Ma, mein Fräulein, non è stat{F#a}{M#o} forse {F#la}{M#il} viaggiat{F#rice}{M#ore} a catturarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "O-Oz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "B-Bene, in ogni caso, grazie del vostro aiuto. Per fortuna che c'eravate voi a bloccargli la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "Sembra che la fortuna sia dalla mia parte oggi, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "#Sono felice di essere stat{F#a}{M#o} d'aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Eheh. Beh, immagino che ora scorteremo quei Cacciatori di tesori fino alla Gilda. Fate attenzione... soprattutto a dove mettete i piedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
		{
			"id": 2003403,
