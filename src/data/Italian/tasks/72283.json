			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Uff. Suppongo che non sia il mio giorno fortunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "I miei addestramenti stanno peggiorando sempre di più. Uno di questi giorni, finirò per colpirmi al ginocchio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Perché ti stai esercitando nel tiro con l'arco in un posto come questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "È tutta colpa di quel Jibashiri, è stato lui a suggerirmi di farlo! Sai cosa? Inizio a chiedermi se non siano tutti un branco di sadici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "A proposito, sai qualcosa sull'allevamento di unagi? Dato che non credo di avere un futuro con il tiro con l'arco, tanto vale fare qualcos'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "Che cosa hanno in comune queste due cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Oh, giusto, lascia perdere. Sembra che tu non sappia nulla sull'allevamento di unagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Per prima cosa, devi catturare degli avannotti di unagi, ma sono così piccoli che riesci a malapena vederli a occhio nudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Così ho pensato che, dato che gli arcieri possono colpire i bersagli da molto lontano, devono avere una buona vista. Pertanto ho chiesto ad alcuni Jibashiri esperti come allenare la mia vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "\"Akashi, devi avere pazienza con l'addestramento. I tuoi progressi saranno costanti solo quando avrai delle buone basi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "\"Gli avannotti di unagi sono piccoli e si muovono freneticamente, quindi devi iniziare con dei bersagli fermi. E non devono nemmeno essere troppo vicini: se vuoi fare le cose come si deve, devi impegnarti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Così ho seguito i suoi consigli, esercitandomi nel tiro con l'arco. Ma non ho colpito il bersaglio nemmeno una volta... È mai possibile?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Che ne dici di fare un tentativo? Se sali su quella piattaforma di pietra, potrai vedere i bersagli. Se li colpisci tutti, avrai successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Certo, me ne occupo io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Va bene allora, dimostrami le tue vere capacità. Ricordati di venirmi a cercare quando avrai finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Uhm, vedo che non hai avuto successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Suppongo che non sia il mio giorno fortunato. Qualcosa deve aver intralciato i miei progressi, in qualche modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "Vuoi fare qualche altro tentativo? Non preoccuparti, i bersagli non scapperanno via come quegli avannotti di unagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Wow! Ce l'hai fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "#*sospira* Sembravi un{F#a}{M#o} ver{F#a}{M#o} espert{F#a}{M#o}. Non credo che una persona senza un adeguato addestramento come me possa mai arrivare al tuo livello, nemmeno se continuassi ad esercitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Ed è un bel po' che non vedo un unagi vivo e saltellante, dato che vengo qui ogni giorno per esercitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "In ogni caso, ti piacciono gli unagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Ma davvero? Io li adoro, per questo motivo vorrei allevarli, in futuro. Non credi che siano adorabili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Beh, in effetti, non sono male neanche su un piatto da portata. Adorabili e deliziosi: un connubio perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "A proposito, pensi che le mie priorità siano sbagliate? Mi sto esercitando nel tiro con l'arco perché voglio allevare gli unagi, ma lo voglio fare solo perché mi piacciono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "Ma alla fine, vorrei che fossero liberi. Quindi, non ha alcun senso volerli allevare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "In ogni caso, ti ringrazio per la dimostrazione. Ecco, prendi. Buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Non mi fanno impazzire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}