				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#Salve, {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Mademoiselle Guillotin mi ha detto che state gestendo un acquario. Naturalmente, ho accettato il suo invito a venire qui come consulente marino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "#{F#Liete}{M#Lieti} di averti con noi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Oh, sì! Con la caposala Sigewinne qui, non dovremo preoccuparci che i pesciolini si ammalino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Eheh, da quando mi avete chiesto di prendermi cura degli animali a Cinefantasilandia Chevalmarine, ho imparato qualche trucco del mestiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "A quanto pare, prendersi cura degli animali non è poi così diverso dal prendersi cura dei pazienti. Beh, di quelli che si comportano bene, almeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "Ma il punto è proprio questo: non tutti i pesci sono così docili. Quindi, oltre a prenderti cura di quelli che avete già, ho qualche idea per una terapia di degenza di cui vorrei discutere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Prego, continua pure. Sono tutt'orecchi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Secondo l'agente Ceasth, alcuni pesci selvatici ultimamente si comportano in modo insolitamente aggressivo. Pare stiano attaccando altre creature, i subacquei e persino piccole imbarcazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Mi chiedevo se potessimo invitarli all'acquario per godersi un po' di riposo e relax... Così, per il momento, eviteremo che causino ulteriori problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Quando saranno qui, potrò cercare un modo per curare il loro malumore improvviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "In questo modo, potremo aiutare i pesci e le acque a tornare alla normalità, e voi potrete aggiungere degli ospiti unici all'acquario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Che idea fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Appoggio in pieno!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Bene, vi darò tutte le informazioni che ho su dove trovare quei pesci aggressivi. Il resto lo affido a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Siamo davvero felici di avere un aiuto in più!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}