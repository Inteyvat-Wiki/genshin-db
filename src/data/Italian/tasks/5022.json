			"dialogs": [
				{
					"id": 50220801,
					"content": "#Buongiorno, {NICKNAME}! Hai avuto un incubo stanotte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "#Paimon ti ha sentito girarti e rigirarti nel letto. Forse sei solo {F#tesa}{M#teso} per la battaglia finale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(Quindi è stato solo un sogno? Riesco a malapena a ricordare cosa ho sognato.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Tutto quel che è successo sembra così annebbiato. Mi sta venendo mal di testa a furia di cercare di ricordare...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "#Fatti forza, {NICKNAME}! Oggi dobbiamo incontrare Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
