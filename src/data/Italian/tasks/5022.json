			"dialogs": [
				{
					"id": 50220401,
					"content": "(Dove sono? Sono... nel Regno della Notte?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "#(Come sono {F#finita}{M#finito} qui? Avevo appena... Argh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(Mi gira la testa, non riesco nemmeno a pensare. Diamo un'occhiata in giro...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
