					}
				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(Attraversando il muro di luce, ho avuto la sensazione che tutto il mio corpo fosse paralizzato dal freddo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Immagino che la protezione della Signora della Notte non possa raggiungere questo posto. Il freddo e l'oscurità sono soffocanti, e non sento altro che urla di stanchezza e dolore.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Per quanto tempo queste anime sono state tormentate? Quanto tempo ci vorrà ancora prima che finisca...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Eh? C'è qualcuno...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Anche se la nostra terra natia è diventata un lontano ricordo, le fiamme della guerra continuano ad ardere. Da tempo abbiamo versato l'ultima goccia di sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "Il Condottiero"
				},
				{
					"id": 50220706,
					"content": "Resistete, miei soldati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "Il Condottiero"
				},
				{
					"id": 50220707,
					"content": "(Che ci fa qui il Condottiero? E cosa sta dicendo...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Un giorno vi porterò nel luogo che vi ho promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Condottiero"
				}
			]
		},
