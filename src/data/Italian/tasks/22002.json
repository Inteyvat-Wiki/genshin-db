			"trigger": {
				"objectNames": [
					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, perché sono di nuovo io il capitano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220020102,
					"content": "Perché è più divertente quando fai tu il capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020103,
					"content": "Beh, se questo ti rende felice... vorrà dire che mi accontenterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220020104,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Stiamo facendo un gioco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng è il capitano, Fei è il primo ufficiale e io sono la ricca commerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020107,
					"content": "Ci manca solo il pirata. Il suo compito è quello di derubarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020108,
					"content": "#Se vuoi giocare con noi, puoi fare tu {F#la}{M#il} pirat{F#essa}{M#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020109,
					"content": "Arrr! Avanti, miei prodi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020113,
					"content": "#Ok, facci sapere quando sei pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020111,
					"content": "#Non voglio fare la parte {F#della}{M#del} cattiv{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "È solo un gioco! Non preoccuparti, so che sei una brava persona in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
