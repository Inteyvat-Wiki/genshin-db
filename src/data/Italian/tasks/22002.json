			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccola Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "#Sono pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Sììì! Si parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020203,
					"content": "Devi cominciare tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020204,
					"content": "Arrr, ratti di sentina! Me vuole derubarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Ahah! In pieno giorno? Buona fortuna, i Milleliti sono proprio lì a fare la guardia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, fai presto! Dobbiamo scappare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220020207,
					"content": "#Salve, {F#signora}{M#signor} pirat{F#essa}{M#a}. Cosa vuoi rubare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020208,
					"content": "Ehm... dei Mora? Arrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Ma non ho molti Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020213,
					"content": "Papà dice che la cosa più preziosa che può esserci su una nave è la merce dei mercanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020214,
					"content": "Perché non vai a cercare degli oggetti di valore? Che ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020215,
					"content": "Così avrai qualcosa da rubare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020216,
					"content": "Mmmh... I frutti di loto andranno bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020217,
					"content": "#Noi tre adoriamo i frutti di loto. Se vuoi essere {F#una}{M#un} pirat{F#essa}{M#a} cattiv{F#a}{M#o}, la cosa più cattiva che puoi fare è rubare il nostro cibo preferito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020209,
					"content": "Te, mia bella signorina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Ehm, anche se sappiamo che è solo un gioco, dovremmo comunque fare attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020211,
					"content": "Visto? I Milleliti ci stanno guardando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
