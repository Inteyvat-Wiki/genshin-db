			"dialogs": [
				{
					"id": 220020301,
					"content": "Hai trovato i frutti di loto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020302,
					"content": "Trovati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng! Fei! Venite a mangiare i frutti di loto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020305,
					"content": "Ehi! Non avevi detto che dovevamo derubarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, giusto... Beh, ecco qui, prendete questi Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020307,
					"content": "#Sei davvero {F#una}{M#un} pirat{F#essa}{M#a} eccezionale. Non tutti hanno la stoffa per rubare tutta questa roba a dei ragazzini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220020308,
					"content": "Paimon ha l'impressione che questa bambina sia più furba di quanto credessimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Grazie dell'aiuto, ci siamo divertiti un mondo! Tornate presto a giocare con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
