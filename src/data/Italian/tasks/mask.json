					"Appunti investigativi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191823901,
					"content": "(Il nome di Mérieux appare in alcuni dei primissimi ritagli, ma più che altro in articoli che lamentano \"una serie di accoglienze tiepide per una forma di teatro sperimentale\" e \"sedie vuote allo spettacolo d'avanguardia nonostante il plauso della critica\"...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823902
					],
					"speakerTitle": "Appunti investigativi"
				},
				{
					"id": 191823902,
					"content": "(In anni più recenti, molte delle recensioni invece tessono le lodi di Mérieux in quanto regista visionario, uno dei migliori della sua generazione...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823903
					],
					"speakerTitle": "Appunti investigativi"
				},
				{
					"id": 191823903,
					"content": "(Gli articoli sono scritti da diversi autori, di specialità diverse e disparate. Tra questi, i nomi di Corentin e Amaury sono quelli che appaiono più spesso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti investigativi"
				}
			]
		},
