				{
					"id": 210100001,
					"content": "Mm... Devo pensarci bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100002
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100002,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Oh, niente. Stavo solo pensando che la Locanda Wangshu è un edificio altissimo. Mi chiedo quanto tempo ci vorrebbe per scendere tutte quelle scale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100004
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100004,
					"content": "Ci avrei provato per conto mio, ma poi questi mucchi di foglie hanno mandato all'aria i miei piani. Voglio spazzarli via tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Ma significherebbe scendere le scale e pulirle una alla volta. Mi stanco solo a pensarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100006,
					"content": "Ci proverò io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100007
					]
				},
				{
					"id": 210100007,
					"content": "Ahah, ottimo. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dandy"
				}
			]
		},
