			"dialogs": [
				{
					"id": 120360101,
					"content": "A dire il vero, non credo che valga la pena finire la partita... Non credo che riuscirei comunque a vincere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360102
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 120360102,
					"content": "Eheh, io non mi ricordo più dove eravamo arrivati con tutte le cose che sono successe negli ultimi giorni. Perché non ne approfitti per farti valere per una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360103
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
