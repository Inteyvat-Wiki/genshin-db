			"dialogs": [
				{
					"id": 120360201,
					"content": "Vi preghiamo di notare che l'avviso inerente al matrimonio tra il signor Kujou Kamaji e la signorina Hiiragi Chisato risulta erroneamente pubblicato, a causa di un malinteso all'interno Commissione Kanjou. Ci scusiamo sentitamente per qualunque equivoco o confusione che possano esserne derivati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 120360202,
					"content": "Le persone coinvolte sono state chiamate a rispondere severamente del loro operato e lo Shogunato ne approfitta per sottolineare, ancora una volta, l'importanza di una corretta comunicazione e della disciplina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120360203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 120360203,
					"content": "Le nozze sono quindi rimandate a data da comunicare successivamente, quando saranno resi noti maggiori dettagli.",
					"roleType": "TALK_ROLE_NPC",
