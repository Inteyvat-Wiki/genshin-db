			"dialogs": [
				{
					"id": 715340101,
					"content": "Mmm, dovrei prima dare un'occhiata agli altri biglietti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Oh, {NICKNAME}! Da quanto tempo... Perché hai l'aria sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Non mi aspettavo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Di vedere una guerriera come me qui a godersi il Festival delle lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Non penso di averti mai vista rilassarti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "La Commissione Tenryou ha una grande responsabilità nei confronti del popolo. In quanto suo membro, non posso permettermi di rilassarmi la maggior parte del tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "C'è chi mi crede una guerriera determinata, completamente fuori posto in un luogo festivo e raffinato come Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Ma abbassare la guardia significa permettere al crimine di essere a piede libero... Non è solo un danno al mio dovere, ma anche all'atmosfera generale di Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Il massimo che posso fare è approfittare dei momenti liberi che mi capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Ah, chiedo scusa. Non dovrei parlare di argomenti così seri durante le feste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Sto cercando di realizzare un biglietto d'auguri, però non ci sto riuscendo. Forse potresti darmi qualche consiglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Certo, fammi pensare un secondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
