					}
				]
			},
			"dialogs": [
				{
					"id": 750410301,
					"content": "Perché siete ancora qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410302,
					"content": "Il capo della nostra compagnia di avventurieri, l'eroe che indossava la maschera del falco, è già... Non possiamo più combatterli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750410303,
					"content": "#Devi andartene il prima possibile. Questo luogo è maledetto, {F#coraggiosa guerriera}{M#coraggioso guerriero}. Non è un luogo dove la gente dovrebbe fermarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
