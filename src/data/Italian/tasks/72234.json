			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Siete di ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "Non avete ancora trovato tutti i posti? Oh, è un vero peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Lasciate che vi spieghi di nuovo dove si trovano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Uno di questi posti si trova sotto una porta di pietra nel punto più alto delle Forre. Un altro è uno spazio aperto circondato da coralli vicino al Tempio della Notteterna, e l'ultimo si trova accanto alle rovine torreggianti del Cuore del Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "Ho lasciato dei segni in tutti questi posti e ho appeso una lampada per illuminare il cammino. Non dovreste avere problemi a trovarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
