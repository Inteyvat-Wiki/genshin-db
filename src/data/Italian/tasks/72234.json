			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "#Come vanno le cose? Sei comod{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Wow, questo non me l'aspettavo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Oh, mi dispiace terribilmente. Non volevo spaventarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Sono Kabayama, e spesso mi siedo proprio dove siedi tu ora. È un posto tranquillo dove riflettere sulla vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Vuoi che mi alzi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Grazie, va bene così. A proposito, non siete di queste parti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Allora dovete conoscere un sacco di cose. Non ho mai visto il mondo esterno, anche se ho avuto molte esperienze con i traslochi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "*sospira* A proposito di questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Quando ero giovane abbiamo traslocato così tante volte che non ho mai avuto l'opportunità di fare amicizia. Ho visto tante cose belle nel mio girovagare, ma non c'è mai stato nessuno con cui condividerle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Sapete che vi dico? Perché non lasciate che vi indichi questi posti? Se passate in un luogo del genere, sedetevi e date un'occhiata in giro... Poi tornate da me e ditemi cosa ne pensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Uno di questi posti si trova sotto una porta di pietra nel punto più alto delle Forre. Un altro è uno spazio aperto circondato da coralli vicino al Tempio della Notteterna, e l'ultimo si trova accanto alle rovine torreggianti del Cuore del Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Ho lasciato dei segni in tutti questi posti e ho appeso una lampada per illuminare il cammino. Non dovreste avere problemi a trovarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
