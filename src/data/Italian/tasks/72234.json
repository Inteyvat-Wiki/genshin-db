					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Siete di ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "Avete trovato tutti i luoghi? Beh, forse non sono un granché per qualcuno che ha viaggiato tanto come voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Ho pensato che avessero un aspetto piuttosto unico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Ah, peccato che non sia mai riuscito a condividerli con nessun altro. Comunque, sono contento anche solo di avere la tua opinione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Forse ci sono luoghi più impressionanti di questi. Insomma, quaggiù è proprio buio e non c'è nemmeno molta varietà in termini di cibo. E poi, bisogna fare attenzione agli Elementosauri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Ma ora che vivo qui da così tanto tempo, sono affezionato a questo posto, sapete? Ho nostalgia di quei luoghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Avete mai provato la stessa sensazione? Anche un posto come questo può essere chiamato casa, una volta che vi si è rimasti abbastanza a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Forse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Sì, eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "Beh, grazie per avermi ascoltato, in ogni caso. Non ho molto da darvi in cambio, davvero, ma per favore accettate questo dono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Non proprio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Erano piuttosto banali. Ho visto cose più impressionanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}