			"dialogs": [
				{
					"id": 730280101,
					"content": "Anche qui c'è un grosso componente di un robot. Paimon scommette che Jazari tirerà di nuovo fuori la sua Fotokamera, se dovesse vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Ararycan sostiene di aver riportato laggiù i componenti grossi, ma non può essere vero, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Certo che è vero. Ararycan non inganna i Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "Aha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan era l'Aranara che giocava con i bambini nella base segreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "Ma Ararycan non ricorda niente di tutto questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Forse ha qualcosa a che vedere con il fiore essiccato nel diario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Sì, anche l'Aranara nella Foresta di Mawtiyima aveva dimenticato tutto dopo averci consegnato un fiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Forse loro tre hanno vissuto le nostre stesse avventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan non sa di cosa stiate parlando, e Ararycan non ricorda. Ma è divertente passare il tempo con i piccoli Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Paimon spera che sarai sempre felice ovunque andrai, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "Abbiamo già visto qualcosa di simile in passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "Se non erro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				}
			]
		},
