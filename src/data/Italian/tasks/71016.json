			"dialogs": [
				{
					"id": 710160401,
					"content": "Farò un tentativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Va bene. Se ne trovate altri, portatemeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
