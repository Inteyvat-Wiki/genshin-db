						"stepId": 7101602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "A proposito del Tesoro anonimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Questa cosa che avete portato... non sembra per niente male. Anche il motivo sembra piuttosto antico. Aspettate un attimo che la apro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Ci sono alcuni difetti qua e là, ma, se volete liberarvene, posso offrirvi un prezzo onesto, sebbene non altissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Ci ho dato un'occhiata. I simboli sono sicuramente quelli di Liyue, e qui si può vedere inciso un aneddoto su Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Si dice che Azhdaha fosse un drago generato dalla convergenza degli spiriti di Geo a Liyue, e che nemmeno Rex Lapis riusciva a sottometterlo facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Così, Rex Lapis chiamò in suo aiuto tre Adepti, e insieme crearono un regno cavernoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Quindi Rex Lapis combatté la creatura, attirandola nel regno, prima di ordinare agli Adepti di sigillare l'ingresso e intrappolare Azhdaha al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "I motivi sulla cosa che avete portato sembrano descrivere i tre Adepti che uniscono le mani per creare il regno cavernoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Credo che ci dovrebbero essere almeno tre reliquie di questo tipo. Combinandole tutte, si dovrebbe ottenere l'oggetto completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Come fai a essere così informata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Beh, commercio oggetti di tutti i tipi. Un po' di conoscenza generale qua e là non guasta di certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Ah, sto divagando. Come dicevo prima, dovrebbero esserci tre esemplari di questo oggetto. Uno da solo probabilmente non sarà valutato granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Ma se riusciste a raccoglierli tutti e tre, sarebbe un'altra storia. Questo sembra piuttosto antico... Raccoglierli tutti e tre, però, potrebbe rivelarsi un compito difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue è davvero un luogo mistico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Ah, certo che sì, ma una volta una persona più anziana mi ha detto che Liyue è troppo grande e che la sua storia è, allo stesso modo, troppo lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Non stupitevi se a Liyue troverete strane reliquie... Quello che sappiamo della lunga storia di quella nazione non è che una goccia nella vastità dell'oceano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7101603,
