				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Li ho trovati tutti e tre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "#Siete davvero riuscit{F#e}{M#i} a metterli insieme? Fatemi vedere... In effetti questi tre esemplari, messi insieme, raccontano la storia di Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Questa gru deve essere l'Adeptus Formamontagne, e questo cervo potrebbe essere Scultore della luna. Ma quest'ultimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Eh? Sembra che questo motivo sia stato... intenzionalmente rimosso da qualcuno, al punto che non riesco a distinguerlo. Chi era questo terzo Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Non importa, sono questioni che esulano dalle mie conoscenze. Comunque sia, questo tesoro è completo e si venderà sicuramente bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Allora, volete tenerlo come ricordo o preferite vendermelo? Vi offrirò una bella somma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "È tutto tuo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Perfetto, ecco a voi allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Però non capisco perché l'immagine di uno dei tre Adepti sia stata rovinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Chi ha creato questa cosa, chi l'ha rotta e chi ha rimosso l'immagine dell'Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160511,
					"content": "Bene, sembra che Soraya sia arrivata a Liyue. Potrei scriverle una lettera... Sarebbe sicuramente interessata a questo oggetto.",
					"roleType": "TALK_ROLE_NPC",
