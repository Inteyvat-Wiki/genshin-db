			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arderne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "#Hai qualche problema? O qualcun altro ha qualche problema? Sembrate entramb{F#e}{M#i} in salute, quindi dev'essere qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Eh, già...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Spieghi la situazione di Lechlade.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Di nuovo lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Puoi curarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Il suo mal di testa? O le sue illusioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Eh? Vuoi dire che non è poi tanto malato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Secondo i suoi esami di laboratorio, molto probabilmente non lo è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "Ho sentito dire che ha sbagliato una diagnosi quando era ancora fuori, ignorando dei precoci segnali d'allarme... Beh, da allora è un po' paranoico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Fa così con gli altri, ed è anche peggio con sé stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "E per quanto riguarda le pietre gialle e verdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Nessun altro sta avendo quei problemi di salute, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Ma non posso proprio ignorarlo, per cui dagli questa, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Questa non è Acqua pura? Sei sicuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Oh, sapete anche voi che cos'è. È un bene, nel senso che non fa male al corpo e gli darà un po' di carica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Quindi lui non lo sa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Per quel che so io, lui se ne sta alla larga da queste bevande. Ma gliene ho già data in passato dicendogli che era una pozione magica e ha davvero mostrato un maggior vigore dopo averla bevuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Ok, gliela daremo. E se non funziona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Allora ditegli di andare a sdraiarsi in infermeria. Se gli dite che glielo ordina il dottore, vi ascolterà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Va bene. Torniamo indietro, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Perché non gli hai dato della Fonta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Il problema è che tutti qui sanno che sapore ha la Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Ma per quel che so, non ha mai provato l'Acqua pura. Dopotutto, non è molto comune qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Gliene ho già data in passato dicendogli che era una pozione magica e ha davvero mostrato un maggior vigore dopo averla bevuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
