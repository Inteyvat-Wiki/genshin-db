			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "C'è qualcosa che non torna con queste pietre di colore giallo-verde... Penso che morirò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Ehm, tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "A lungo andare, staremo tutti \"bene\", ma io starò \"bene\" prima di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Tanto meglio allora... Arrivederci",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Un momento, non sembra stare per niente bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "No, sto bene, davvero. E comunque, anche se ci fosse qualcosa che non va, sarebbe ormai troppo tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "Allora stai bene o no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon è molto confusa. Puoi parlare più chiaro, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Nello specifico, quando mi trovo nell'area di produzione mi vengono mal di testa e palpitazioni, e sento freddo alle mani e ai piedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "Sono spacciato! Sai che voglio dire? Sono proprio spacciato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Devono essere le pietre giallo-verdi! Sono malvagie! Sai di quelle pietre, vero? Il Laboratorio centrale dell'Istituto di ricerca di Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "Le pietre gialle e verdi hanno distrutto tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Per favore vai a farti visitare da un medico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "Io sono un medico! Lo so! Aspetta, io non sono più un medico. Ho perso la mia licenza, non posso fare diagnosi ufficiali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Vi prego, andate a cercare un vero medico con una licenza e salvatemi! Vi supplico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Sembra una faccenda molto seria. {NICKNAME}, andiamo a cercare un medico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Perché non ti riposi in infermeria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "È un modo nuovo di usare la parola \"bene\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "Non sembri star bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
