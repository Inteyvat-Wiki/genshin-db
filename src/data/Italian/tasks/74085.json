			"dialogs": [
				{
					"id": 740851701,
					"content": "#Fiuuu! Finalmente ce l'abbiamo fatta. Non svegliare il Segugio che dorme, eh? {NICKNAME}, tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851702,
						740851703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851702,
					"content": "Benissimo, potrei andare avanti una settimana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "Eheh, Paimon è sicura che non lo dici tanto per dire. Sembra che le radici si stiano riprendendo. Dovremmo aver risolto il problema, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851705,
					"content": "Ma cos'è successo? È apparso un Elementosauro per aiutarci... e Pahsiv è scomparsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851706,
					"content": "Ehi! Pahsiv! Ci sei? Riesci a sentire Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851707,
					"content": "Oh... Sembra che sia scomparsa davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851708,
					"content": "Di certo ha un sacco di segreti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851709
					]
				},
				{
					"id": 740851709,
					"content": "Uhm... È proprio una Melusina misteriosa. Paimon sa che non avevamo parlato di una ricompensa, ma sembra comunque strano che se ne sia andata così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851710,
					"content": "Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "È come... È come avere un cibo preferito... E poi un giorno il cibo ti guarda e dice: \"Mi spiace, tra noi è finita\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851712,
					"content": "Sarebbe spiacevole, sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "Beh, guarda che è lo stesso tipo di emozione! E se Pahsiv fosse ferita? Sembrava esausta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851715,
					"content": "Magari possiamo cercarla qui in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "Sì! Paimon pensa che dovremmo proprio cercarla. Potrebbe essere in pericolo, no? Magari le serve una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851717,
					"content": "Aspetta... Cosa c'è che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851718,
					"content": "Proprio quando stavate per iniziare a cercare Pahsiv, la grotta si allaga e l'acqua vi trascina in superficie.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "Però parlare con del cibo sembra ancora più strano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851703,
					"content": "Eh... Ho le mani un po' doloranti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851718
					]
				}
			]
		},
