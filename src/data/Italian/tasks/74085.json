						740851904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851904,
					"content": "Si è ripreso! Ed è bellissimo! Prima era così? Pahsiv sarà felice di vederlo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851905,
					"content": "#Paimon! Pahsiv! {NICKNAME}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851906,
					"content": "#Pahsiv? Eccoti! Dov'eri finita? Eravamo così {F#preoccupate}{M#preoccupati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851907,
					"content": "Scomparsa, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851908,
					"content": "Ah... Scatola. Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851909,
					"content": "Cosa? È un baule del tesoro? Sei andata in cerca di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851910,
					"content": "Pahsiv! Ma, luccicante, tondo, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851911,
					"content": "Non hai trovato Mora? Va benissimo lo stesso, il baule è più che sufficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851912,
					"content": "Hai ricordato quello che ti ha detto Paimon! Oh, così fai commuovere Paimon! Grazie, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851913,
					"content": "G-Grazie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851916,
					"content": "Vuol dire Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#Paimon, grazie! {NICKNAME}, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851918,
					"content": "#Paimon, cosa buona! {NICKNAME}, cosa buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851919,
					"content": "Pahsiv, cosa buona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "Pahsiv, cosa buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME} dovremmo venire a trovare Pahsiv quando avremo tempo e insegnarle altre parole, come ha fatto Niuvilett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851922,
					"content": "Pahsiv!",
