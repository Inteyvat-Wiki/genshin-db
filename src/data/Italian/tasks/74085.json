			"dialogs": [
				{
					"id": 740851401,
					"content": "Finalmente, ce l'abbiamo fatta. Paimon non sapeva che avessi un'abilità così meravigliosa, Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851402,
					"content": "Un momento... C'è qualcosa di luminoso sul terreno... Sembra una specie di formazione arcana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851403,
					"content": "Aaah! Dei Segugi della Faglia ci stanno attaccando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851404,
					"content": "Cosa viola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851405
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851405,
					"content": "Non preoccuparti, Pahsiv. Ti proteggeremo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851406,
					"content": "Aspetta! Dove vai, Pahsiv? Fermati! Questo posto è pericoloso!",
					"roleType": "TALK_ROLE_NPC",
