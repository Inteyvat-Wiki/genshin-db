						740851002
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851002,
					"content": "Finalmente ci siamo! Wow, c'è un sacco di roba strana. Paimon non vede nessuno in giro, ma ha una sensazione familiare... Il male deve essere in agguato nelle vicinanze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851003,
					"content": "Salice... Radice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851004
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851004,
					"content": "Queste sono le radici del grande albero di prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851005,
					"content": "Paimon ha capito! Ecco perché il grande albero sembrava così malato. Guarda in che stato sono le radici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851006,
					"content": "Radice... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851007,
					"content": "#{NICKNAME}, puliamo questa sporcizia. Secondo Paimon sta intaccando le radici.",
