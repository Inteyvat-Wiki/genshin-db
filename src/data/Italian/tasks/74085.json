					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "Che ne pensi, Pahsiv? Possiamo tornare a giocare con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851924,
					"content": "Dove sarà andata stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851925,
					"content": "Pahsiv, scomparsa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Paimon non ha mai visto una Melusina come lei. O meglio... Non si comporta come una Melusina, ma più come una fata selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851927,
					"content": "Forse è per questo che riesce a spiare di nascosto la cosa viola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851928,
					"content": "Ehi, Pahsiv! A presto! Se ci incontriamo di nuovo, ti insegneremo a salutare come si deve!",
