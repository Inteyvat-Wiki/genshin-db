			"dialogs": [
				{
					"id": 741870801,
					"content": "Ora che ci penso... Potreste essere dei barbari in incognito, che provano a prendersi gioco di noi! È così, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870802
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870802,
					"content": "Maledetti vermi, vi ucciderò!",
					"roleType": "TALK_ROLE_NPC",
