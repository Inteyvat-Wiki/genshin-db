			"dialogs": [
				{
					"id": 741870201,
					"content": "Ehi, tu! Sì, tu! Imbecille farfugliante! Perché ti attardi?! Se ci gingilliamo, il tesoro non si muoverà da solo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870202,
					"content": "No, signore! È solo che sono troppo pesanti! Abbiamo lavorato tutto il giorno, ma c'è ancora così tanto da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Il tizio che chiamano \"idiota\""
				},
				{
					"id": 741870203,
					"content": "Ma allora, se non hai la forza di trasportarlo, per cosa ti rimpinzi a fare?! È un tesoro, zoticone che non sei altro! È ovvio che sia più pesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870204,
					"content": "Inoltre, abbiamo \"confiscato\" tutti questi tesori da quei maledetti barbari, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870205,
					"content": "Sarebbe uno spreco lasciare così tante ricchezze nelle mani di quei bifolchi, letteralmente perle ai porci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870206,
					"content": "Ma Signore, non crede che per riportare tutte queste ricchezze a Remuria sarebbe stato necessario un numero maggiore di navi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Il tizio che chiamano \"idiota\""
				},
				{
					"id": 741870207,
					"content": "Hai preso una botta in testa? Le nostre navi da carico imperiali non verranno mai usate per una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870208,
					"content": "Beh, perché allora non distruggere quello che non possiamo trasportare? Sempre meglio che farlo cadere nelle mani dei selvaggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Il tizio che chiamano \"idiota\""
				},
				{
					"id": 741870209,
					"content": "Uhm... È solo un'impressione di Paimon o abbiamo già sentito questa conversazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "#Mi ricorda la prima volta che siamo {F#arrivate}{M#arrivati} a Petrichor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Sì, quegli sfortunati avventurieri che abbiamo fatto scappare dicevano cose simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "A quanto pare questa volta è pure peggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Sono forse stati tramutati in Golem dopo che la barca su cui erano è affondata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Uh... Inquietante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Siete della Legio IX? Cosa ci fate qui? Non avevate l'ordine di ritirarvi a Forte Charybdis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Ehi, Este! Non osare rovinarci il divertimento, capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870218,
					"content": "Comunque questi barbari sono meno pericolosi dei pesci morti... Lasciaci qui a trafficare ancora un po', d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870219,
					"content": "Quei tesori... *sospira* Non so quali ordini vi abbia dato il vostro Armosta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Ma il Sebastos non ci aveva ordinato di sottomettere queste tribù ignoranti e liberarle dalle catene del destino? Ordini ben diversi da questi... atti sfacciatamente criminali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Eh? Stai scherzando, vero? Gli ordini del nostro Comandante, il possente Dominus Boethius, erano proprio \"punire severamente questi selvaggi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870222,
					"content": "Inoltre, non abbiamo ricevuto alcuna punizione, il che significa che anche Phobos e il Sebastos, nostro Imperator, approvano le nostre azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870223,
					"content": "Allora, cos'è tutto questo parlare di crimini... Cerchiamo di creare problemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870224,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "C'è un altro Este qui? Le cose si fanno sempre più strane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Pare sia arrivato il momento di rispondere alla tua domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "L'Este che hai incontrato in città dev'essere un discendente dei remuriani. Il suo antenato deve avermi seguito nella nuova nazione tantissimi anni fa, divenendo un comune abitante di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "Pertanto, la \"Sinfonia\" che ha rubato le anime degli abitanti di Fontaine non ha avuto alcun effetto su di lui. Di contro, la melodia in cui sono racchiusi i ricordi del suo antenato, non potendo andare altrove, si è legata a quella scultura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "Quindi vuoi dire che l'Este che si trova qui è l'antenato dell'Este di città, cioè del vero \"Este il Perspicace\"? E gli altri, invece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Sono anime vaganti, perse nei propri ricordi. Vi faccio vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Ti avvicini assieme a Monsieur Os...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Ciao, Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Ehm, ciao. Voi chi sareste, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Non mi sembrate remuriani. Siete forse dei barbari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "#Sono soltanto {F#una viaggiatrice}{M#un viaggiatore} di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Siamo su un campo di battaglia, e vi siete messi in una situazione di grande pericolo. Non importa chi siate, dovreste andarvene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Este, sono io. È passato un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "...Santo cielo, è lei, Dominus Cassiodor! Sono così rare le sue apparizioni in questa forma che quasi non la riconoscevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "#E chi sarebbero costoro? {F#Le sue}{M#I suoi} attendenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "Diciamo di sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Di grazia, cosa la porta qui, Dominus Cassiodor? Il Sebastos non l'aveva mandata a... Maledizione! Non me lo ricordo più! Sto forse sognando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Sembra proprio che sia così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Ahah! A sua signoria piace scherzare! Il Sebastos deve averle assegnato un'altra di quelle missioni segrete, altrimenti non saprei davvero come mai sia qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Hai indovinato. A proposito, perché quei soldati della Legio IX sorvegliano quelle catene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "Le catene... Intende il tesoro, vero? Credo che siano un bottino di guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Sebbene il Sebastos consideri la guerra come un male necessario per esaudire le nostre grandiose aspirazioni, e abbia da tempo bandito tali comportamenti brutali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Sa quanto me che questi comportamenti sono comunque diventati all'ordine del giorno... Siamo sempre più vicini all'oscurità, anche se nessuno se n'è accorto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Dominus Cassiodor, cosa è successo? Phobos doveva portarci la felicità, ma io non provo altro che un dolore indescrivibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Anch'io sto cercando una risposta a questa domanda. Ma, a quanto pare, prima dobbiamo occuparci di risolvere un altro problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Proprio così. Eppure quelli sono membri delle nostre legioni, quindi cerchiamo, se possibile, di risolvere tutto in maniera pacifica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "#In realtà sono {F#la sua padrona}{M#il suo padrone}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ehi, ehi, {NICKNAME}, smettila di complicarti la vita! Non preoccuparti, Este, stava scherzando, continua pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "#Oh, posso essere piuttosto {F#selvaggia}{M#selvaggio}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "È come avere di nuovo a che fare con i \"Cacciatori di tesori\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
		{
