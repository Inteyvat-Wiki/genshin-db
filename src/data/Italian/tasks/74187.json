				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ahem, soldati della Legio IX!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "#Eh? E voi chi siete? {F#Le piccole}{M#I piccoli} aiutanti di Este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870603,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Non siamo mica aiutanti comuni! Grande è la forza di coloro che accompagnano e assistono il Dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "#(Siete proprio due {F#attrici nate}{M#attori nati}, voi due.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Il Dominus Cassiodor, eh... Ho sentito dire che il Sebastos l'aveva inviato ad Aremorica. È già di ritorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870611,
					"content": "Ecco, in effetti, quello accanto a noi è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "Comunque stiano le cose, siamo qui per ispezionare le legioni della prima linea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Già. L'avevo capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870615,
					"content": "Ecco, non abbiamo seguito il grosso delle truppe a Forte Charybdis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870616,
					"content": "Ma noi siamo le retrovie, per cui è di nostra competenza una \"pulizia\" finale, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870617,
					"content": "Anche questo è un ordine che viene da Phobos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Beh... Phobos doveva essere il faro guida di ogni nostra mossa ma, da quando siamo qui, ci sono stati dei periodi in cui non abbiamo potuto sentire la sua melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870619,
					"content": "Per cui siamo tornati a ubbidire al Dominus Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870620,
					"content": "Ah, che impudente quello lì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Chi ti credi di essere?! Come osi nominare il Dominus Boethius così a cuor leggero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870622,
					"content": "Un Armosta così rispettato come lui segue le direttive del Sebastos con assoluto rigore. La sua parola è autorevole quanto quella di Phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870626,
					"content": "Anche Phobos potrebbe aver commesso un errore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "#Ah! Sei {F#sicura}{M#sicuro} di venire da Remuria? Non lo sai che Phobos è stata creata dall'onnipotente Sebastos e dall'infallibile oracolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870628,
					"content": "Eppure non riuscite a sentirne la melodia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Anche questo è vero. Ma in cosa confidare, se non in Phobos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870630,
					"content": "Sicuramente, se ci discostassimo dalla retta via, ce lo farebbe notare in qualche modo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870623,
					"content": "Il Sebastos non permette che agli innocenti venga fatto del male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Innocenti, dici... Certo, ci ha incaricato di dare una mano a questi vulnerabili umani prima dell'inizio della guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870625,
					"content": "Ma noi operiamo sotto il tacito assenso di Phobos. I suoi ordini non potrebbero mai essere in contrasto col sacro verbo del Sebastos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870605,
					"content": "#Siamo {F#emissarie}{M#emissari} speciali del Sebastos, il nostro grande Imperator.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Che razza di titolo è?! Beh, non è del tutto sbagliato. Siamo con il Dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "Siamo al servizio di Cassiodor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "#Proprio così! {F#Le sue}{M#I suoi} leali {F#servitrici}{M#servitori}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
