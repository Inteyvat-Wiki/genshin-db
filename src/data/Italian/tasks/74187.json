			"dialogs": [
				{
					"id": 741871201,
					"content": "Phobos è una creazione perfetta. Ti consiglio, in quanto remuriano, di non mettere in discussione i suoi ordini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871202,
						741871204
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741871202,
					"content": "Perfetta? Niente è davvero perfetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871203
					]
				},
				{
					"id": 741871203,
					"content": "Ora ci mettiamo a fare i sofisti? Di queste cose parlane con gli eruditi nella capitale. Il compito di un soldato è quello di obbedire. Gli argomenti complessi non sono il mio forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leader"
				},
				{
					"id": 741871204,
					"content": "Il silenzio di Phobos equivale a un rifiuto.",
