			"dialogs": [
				{
					"id": 741870901,
					"content": "A quanto pare avete risolto il nostro problema precedente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Immagino significhi che vi precipiterete in avanti verso il vostro prossimo obiettivo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Sì. Conto su di te, Este. Prenditi cura di questo posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "E inoltre ricordati che, per decidere cosa è giusto e cosa è sbagliato, è meglio fidarsi del proprio cuore invece che di Phobos o di un qualsiasi Armosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "Il Sebastos ha creato Phobos per liberarci dalla nostra servitù nei confronti del destino, ma la fede cieca della gente ci ha resi schiavi vittime di un terrore ancora peggiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "In futuro potresti avere davanti a te una scelta simile a questa. Spero che tu prenda la decisione giusta, quando arriverà il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Dominus Cassiodor, perché parlare di queste cose, così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "A ogni modo, conserverò queste parole nel mio cuore. Io, Este, terrò fede al mio senso di giustizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Bene. Addio, Este. Credo che ci incontreremo ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
