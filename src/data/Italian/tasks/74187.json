				"points": []
			},
			"dialogs": [
				{
					"id": 741870701,
					"content": "Molto bene... Dici la verità. Dobbiamo riconsiderare le nostre azioni. In tutta franchezza, non so come si sia arrivati a questo punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870702,
					"content": "Non so perché, ma ho provato una strana sensazione in cuor mio sin dall'inizio di questa guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870703,
					"content": "Dovevamo essere alla ricerca della libertà e della felicità, ma Phobos invece ci ha condotti qui, un passo dopo l'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870704,
					"content": "Qualcosa è andato storto? Cosa potrebbe essere stato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870705,
					"content": "Se incontrate il Sebastos sulla via del ritorno, informatelo circa la situazione presente e i nostri dubbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870706,
					"content": "Ci fareste un grande favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Leader"
				},
				{
					"id": 741870707,
					"content": "Non preoccuparti, lo faremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
