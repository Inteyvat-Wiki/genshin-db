				]
			},
			"dialogs": [
				{
					"id": 150170201,
					"content": "Eccoci qua. Bella casa, eh? Un secondo, vado a bussare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "#Tlazolli, apri! Sono {F#arrivate}{M#arrivati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "...Tlazolli! Sei in casa? Dai, vieni ad aprire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Che strano... Uh. La porta è chiusa a chiave, ma non dovrebbe essere fuori a quest'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Ehi, Nechca! Nechca? Sono io, Cheven. Apri, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Nessuna risposta...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Inoltre, avevo già avvisato Tlazolli del nostro arrivo... Forse ha dovuto portare Nechca a prendere una medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Ehi, cosa c'è laggiù? Sembra un nido di Tepetlisauri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Esatto. Tlazolli ha un Tepetlisauro da compagnia. Se ricordo bene, si chiama... Iengu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Quando lavorava ancora nel settore della forgiatura, chiedeva spesso a Iengu di aiutarla a scavare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Ma da quando Nechca si è ammalata, Tlazolli non gli ha più chiesto di farlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Un attimo. Ma che...? Questo posto è un disastro! E non c'è traccia di Iengu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Wow, guarda tutte queste casse rotte! Paimon teme sia successo qualcosa di terribile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Diamo un'occhiata più da vicino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Tu resta qui, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh... Va bene! Allora... troverò un posto dove nascondermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Com'è che ogni volta che Imix mi dice di non andare in un posto pericoloso, finisco sempre in mezzo ai guai? È come se le sue parole avessero un qualche potere su di me... Forse è opera della Wayob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Vuoi che sfondi la porta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Non sarà successo loro qualcosa? Forse le condizioni di Nechca si sono aggravate di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Non fasciamoci la testa troppo presto. L'ultima volta che sono stata qui stavano bene. Nechca stava dormendo profondamente nella sua stanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
