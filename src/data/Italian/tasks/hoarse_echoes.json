				]
			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "Oh, c'era davvero un Tepetlisauro, qui. Paimon però non sa se sia l'animaletto di Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Almeno non sembra essere in pericolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Uh... Paimon non vede traccia di Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#Ehi, {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "È la voce di Cheven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Sembra ci sia qualcuno accanto a lei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Scendete, presto! Tlazolli è qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "#Eh? Siamo appena {F#salite}{M#saliti} e Tlazolli è già tornata? Che coincidenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Fa niente, scendiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Eh? Perché questo Tepetlisauro sta venendo verso di noi? Ehi, ehi, ehi, non correre, così ci vieni addosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Scendete dalla montagna insieme al Tepetlisauro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, vieni qui... Hai fatto di nuovo il monello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Bravo Saurico. Hai fame? Scusa... Più tardi ti preparo qualcosa di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Bene, ora vai a giocare. Ti raggiungo tra poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "Scusatemi. Vi stavo aspettando in casa quando Nechca... Beh, è sgattaiolata fuori ed è corsa via da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "Diceva di voler andare a cogliere dei fiori per i nostri ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Ma ha finito per perdersi lungo la strada... Per fortuna sono riuscita a trovarla poco dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Sta bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Sì, Cheven ci ha detto che è guarita solo di recente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "È ancora molto debole, e lo spavento unito al vento freddo non hanno giovato, quindi ora ha qualche linea di febbre. Ha preso la medicina, ora si è messa a letto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Ma niente di grave, una bella dormita e tornerà come nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Però temo che oggi non potrà vedervi. Mi dispiace, avete fatto tanta strada apposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Oh, nessun problema! Sappiamo che è ancora convalescente. Cheven ci ha detto che la sua malattia era molto grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "#La salute è decisamente la prima cosa! Eravamo solo {F#passate}{M#passati} a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Si sente meglio, ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "...Beh, se non altro ora riesce a parlare e trascorrere delle giornate normali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "È già molto più di quanto potessi chiedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "Ehi, su col morale! Dovrebbe essere un'occasione di gioia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Nechca è stata gentile ad aver pensato di volerci dare dei fiori. Comunque, Tlazolli, riguardo a quello che ti accennavo prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "Il regalo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "Già! Che ci hai regalato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Beh, è un'Incisione su Gemmardente. L'ho realizzata con il minerale più puro, quindi è praticamente immune all'erosione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Le tecniche che ho usato hanno radice nell'arte dei Nomi antichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Quindi è praticamente una versione semplificata di un Nome antico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Ehi, non dire così, o la Wayob potrebbe incenerirmi. Ho solo usato alcune delle stesse tecniche e degli stessi materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Quando realizzai il mio primo oggetto di questo tipo, non pensavo che avrebbe potuto avere un qualche uso pratico, a parte l'essere ornamentale e resistente all'erosione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Ma poi Cheven mi ha suggerito di usare questi cristalli per creare un tipo di \"decorazioni\" speciali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "\"Incisioni su Gemmardente realizzate da un'artigiana di Nomi antichi, con incisi nomi che non sbiadiscono mai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Molto accattivante come slogan, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Uhm, la descrizione aiuta davvero a dare a quest'oggetto un non so che di speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Hai fiuto per gli affari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Ahah, le Incisioni su Gemmardente di Tlazolli sono davvero speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Il passaparola non sempre funziona. Man mano che vengono trasmesse, le informazioni diventano incomplete, dimenticate, o persino distorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Ma le parole incise su questi cristalli dureranno per sempre. Immutabili, imperiture, proprio come il loro significato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "È il regalo perfetto per un caro amico o per chi si ama. Si può anche tramandare alle future generazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Ok, forse cominci ad esagerare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#Paimon è interessata! Ehi, {NICKNAME}, perché non ne compriamo una e ci facciamo incidere i nostri nomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#E poi, una volta {F#trovato tuo fratello, possiamo chiedergli se vuole incidere anche lui}{M#trovata tua sorella, possiamo chiederle se vuole incidere anche lei} il suo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "In questo modo, i nostri nomi saranno per sempre uniti. Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Paimon sembra già convinta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "#Suvvia, non fare tanto {F#la modesta}{M#il modesto}. Dopotutto, hai salvato me e il regalo di compleanno di Nechca. Voglio sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, ti avevo detto che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "E non cominciare a fare la timida anche tu, Tlazolli, è un gran bel regalo! So quanto lavoro ci vuole per realizzare un'incisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "Bene, allora... Grazie per la fiducia. Sarà pronta il prima possibile. Quando sarà il momento, vi farò incidere i vostri nomi personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Per allora, credo che Nechca si sarà rimessa in forze. Sarà contenta di vedervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Le cose buone sono migliori in compagnia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "#Freniamo un momento. Non sappiamo quanto potrebbe costare... Sei {F#sicura}{M#sicuro} che il nostro budget per i viaggi sia sufficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Un attimo... Non è che fa tutto parte del tuo piano per farci spendere fino all'ultimo Mora, vero, Cheven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "#Mmm, forse. Non si sa mai... Avete l'aria di {F#viaggiatrici}{M#viaggiatori} con un bel gruzzolo da parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#No! Non ascoltare, {NICKNAME}! Finirai per perdere tutti i tuoi Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Ahah! Vi lascio discuterne tra di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "Eh?! Rieccolo! Presto, qualcuno lo fermi! Paimon non vuole farsi camminare sopra di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Woah! Buono, buono!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Ah, Tlazolli, se non ti dispiace, vorrei che mi aiutassi a riparare l'Incisione su Gemmardente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Mi è caduta prima, quando sono stata attaccata. Si sono rotti sia la corda che il gancio, per questo non l'ho indossata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Ho provato a ripararla da sola, ma non riesco a farla stare insieme. Mi dai una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Ci penso io. Vedrai: tornerà come nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "Grazie per la tua disponibilità, Cheven. Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Nessun problema, Tlazolli. A me basta che Nechca si rimetta presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "...Hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Iengu, fai il bravo! Fra un attimo ti do da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "Una volta completata l'incisione, chiederò a Cheven di contattarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Forse riusciremo anche a far coincidere tutto con il compleanno di Nechca. Potremmo perfino dare una festicciola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "#Ottima idea! Paimon immagina che ci sarà un sacco di cibo delizioso, saremo {F#pronte}{M#pronti} ad abbuffarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "A ogni modo, ci vediamo, Tlazolli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Ci si vede, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Arrivederci. Statemi bene anche voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "Sono sicura che Nechca sarà felice di conoscervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Spero che tua figlia guarisca presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Potremmo comprarne qualcuna in più come regalo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Sembra un tantino troppo prezioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Sei molto persuasiva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#Dai, compriamone una e facciamoci incidere i nostri nomi. Poi, quando avremo trovato {F#tuo fratello}{M#tua sorella}, potremo farci incidere anche il suo di nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Non c'è da stupirsi che tu abbia un negozio tutto tuo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "D'accordo! Sentiamo di che si tratta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Considerando che è riuscita a correre via, direi che sta bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Sì, e vedessi come corre quando cerco di farle mangiare le verdure. Una vera scheggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Salta sulle sedie, si nasconde sotto il tavolo... E quando inizia a correre per tutta la casa, riesco a malapena a starle dietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Vedendo come sta adesso... posso dire che non potevo chiedere di meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Già, una vera coincidenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "Beh, sembra che dovremo scendere, ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "Sarà salito lassù da solo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
		{
			"id": 1501706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1501702",
							"2"
						],
						"stepId": 1501702,
						"stateName": "QUEST_STATE_UNFINISHED"
