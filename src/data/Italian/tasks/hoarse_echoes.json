			"dialogs": [
				{
					"id": 150170101,
					"content": "Oh, siete in anticipo! Non vedevate l'ora di ricevere il vostro regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Siamo solo felici di fare visita a Tlazolli e a Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Esatto! Nechca è stata così tanto malata che Tlazolli ha dovuto rinunciare a fare ciò che amava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Forse le cose miglioreranno, ma di certo un po' di positività in più le aiuterebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Ahah, ho già chiesto a qualcuno di passare a casa di Tlazolli e informarla del nostro arrivo. Probabilmente ha fatto tutti i preparativi necessari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Andiamo, allora. Ti dispiace tenere d'occhio il negozio, Imix? Torno subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "#Bene, ora sono {F#curiosa}{M#curioso}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Pure Paimon è curiosa di saperlo... Ma siamo qui anche per vedere come sta Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Non dev'essere facile riprendersi da una malattia così pesante. E poi c'è Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Ha dovuto rinunciare a una cosa che adora... Vogliamo soltanto tirarle su di morale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1501702,
