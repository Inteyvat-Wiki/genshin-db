			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "Che seccatura... E per un misero pugno di Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "A proposito del modulo di registrazione del personale di assistenza esterna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Racconti le vicende di Livre e le motivazioni per la sua richiesta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*sospira* La fortuna non è dalla parte di Livre... Temo di non averne altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "Ho portato un membro del personale del negozio per aiutarmi mentre stavo riparando i lampioni al Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Ora, non è stato di grande aiuto, quindi non ho incluso il suo nome nel modulo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "Ma quando l'ho consegnato, Clapiers ha insistito che scrivessi tutti i nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "Ha anche detto che, se non l'avessi compilato in modo veritiero, ci sarebbero state delle \"gravi e imprevedibili conseguenze\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Cavolo, è solo un nome in meno. Che gravi conseguenze potrebbero mai esserci? Ridicolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
		{
			"id": 2400003,
