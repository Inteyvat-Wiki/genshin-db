					"nextDialogs": [
						240000405
					]
				},
				{
					"id": 240000405,
					"content": "#Oh, santissimo cielo! Sei {F#la mia salvatrice}{M#il mio salvatore}! Se avessi fatto un altro giro a vuoto mi sarei sicuramente buttato in un fiume!",
