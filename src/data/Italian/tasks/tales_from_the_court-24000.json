				]
			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "Ripeto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Monsieur Livre, capisco la sua richiesta e sono disposta ad assisterla nel miglior modo possibile, ma... Beh, per favore, guardi questa domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000103,
					"content": "Il responsabile qui è Monsieur Clapiers. È lui che si occupa della gestione di tutti i materiali presentati. Fra di noi, nessun altro è autorizzato a farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000104,
					"content": "Al momento è fuori per lavoro. Affinché il suo materiale possa rientrare nel nostro sistema di calcolo delle spese, serve il suo timbro ufficiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000105,
					"content": "Sì certo, come no! Ma sa cosa? Sono già venuto qui tre volte, vi decidete a risolvere la mia pratica o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Per favore si calmi, Monsieur Livre. Ci sono solo due persone nell'ufficio di Monsieur Clapiers, l'altra persona è Monsieur Monthois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000107,
					"content": "Ma è un po' in là con gli anni e sta aspettando di andare in pensione. In realtà, è da un po' di tempo che non lavora più in ufficio. Non prende nemmeno più uno stipendio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000108,
					"content": "E allora andrò nell'ufficio e farò mettere un timbro al vecchio. Me li timbrerò io stesso se necessario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Sono spiacente, ma non è possibile. Primo, è contro le regole; secondo, la chiave per il timbro ce l'ha Monsieur Clapiers e solo lui vi ha accesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000110,
					"content": "Quanto a me, ho anche altre cose di cui occuparmi... La prego di credermi quando le dico che oggi Monsieur Clapiers tornerà e l'aiuterà a risolvere la questione oggi stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000111,
					"content": "...E va bene. Le auguro una buona giornata, Mademoiselle Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Anche a lei, Monsieur Livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000113,
					"content": "Cornelia se ne va di fretta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "Pare che mi toccherà tornare a casa a mani vuote... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Niente, davvero. Ho solo sprecato il mio tempo, mezza giornata, per la precisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "Ne ho fin sopra i capelli di questo Clapiers! Il Palais Mermonia ha ordinato alcuni Mekautomi da noi, ma non hanno ancora pagato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "La prima volta che sono venuto a cercarlo, mi ha detto che stavano effettuando una verifica interna di fine mese e che avrebbe potuto erogare i fondi a soggetti esterni solo il mese successivo. Di conseguenza, la mia domanda non poteva essere esaminata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "La seconda volta mi ha detto che erano a corto di inchiostro per i timbri e che c'è stato un incendio nel magazzino del fornitore per gli inchiostri, quindi devono comprarlo da altre parti. Il che significa che la mia pratica non poteva essere timbrata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "La terza volta ha detto che il modulo di registrazione del personale di assistenza esterna era stato aggiornato e doveva essere compilato di nuovo, ma naturalmente i moduli erano esauriti e quelli nuovi sarebbero arrivati solo domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Ero venuto qua per prenderne uno oggi, ma ora non è nemmeno in ufficio. Per l'amor degli Archon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Uhm? Monsieur Livre? Sembra molto triste, posso aiutarla con qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Agente Rhemia! Che bello vederla. È successo questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "Livre racconta la storia in maniera concitata...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Ah, Monsieur Clapiers... Non è facile trovarlo, quello è certo, ma al momento si trova davvero a Érinnyes e non è al Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Comunque sia, andiamo prima a prendere il modulo che le serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Eh? Ma Clapiers ha detto che non ce n'erano più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "Ho un modo per aiutarla a risolvere il problema. Se non ricordo male, alcuni negozi che hanno accordi a lungo termine con il Palais Mermonia hanno riscontrato il suo stesso problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "La loro soluzione è quella di venire di tanto in tanto al Palais a prendere i moduli e i documenti che gli possono servire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "In questo modo, da un lato si facilitano e velocizzano la compilazione e l'invio dei moduli, dall'altro ci si tiene aggiornati sulle modifiche apportate a tali documenti... \"Tenersi preparati conviene\", come si dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "È... per questo che sono spariti tutti i moduli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "E per questo scommetto che questi negozi hanno dei moduli in più, andiamo a fargli visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "Inoltre, sono sicura che saranno più che disponibili ad aiutare una volta che avranno sentito dei suoi viaggi a vuoto al Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "Ah, sì. Dovremmo trovare i documenti che le servono, compilarli e portarli all'ufficio di Monsieur Clapiers prima che al Palais finiscano di lavorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "#Te la sentiresti di aiutare, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "#Aiutami, per favore, Viaggiat{F#rice}{M#ore}! Se non riesco a risolvere questa questione temo che passerò altre notti in bianco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Dovrai solo andare a fare visita a questi due negozi e cercare di farti dare il modulo di registrazione del personale di assistenza esterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Vai alla fucina di Estelle e al negozio di orologi di Caron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Non molto tempo fa, il primo ha aiutato il Palais a riparare i lampioni, mentre il secondo si è occupato di sistemarne l'orologio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Si occupano spesso di incarichi dal Palais, quindi sicuramente avranno un modulo con loro da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Contiamo su di te per questi posti, nel frattempo, io e Livre ci dividiamo gli altri negozi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Ma cosa dovrei fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "Cosa ti è capitato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
