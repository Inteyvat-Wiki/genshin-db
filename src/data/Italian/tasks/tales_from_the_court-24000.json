					"content": "Racconti le vicende di Livre e le motivazioni per la sua richiesta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000304
					]
				},
				{
					"id": 240000304,
					"content": "Questo accade piuttosto spesso, quando hai a che fare con il Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000305
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000305,
					"content": "Ho un modulo in più, puoi darglielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
