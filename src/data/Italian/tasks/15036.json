					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Oh... Questo è un vicolo cieco. Abbiamo raggiunto il suo nascondiglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Uff, con questa nebbia non si vede un accidente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "#Questo dovrebbe essere il luogo dove sei {F#stata attaccata}{M#stato attaccato}, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "La parte mancante della tua anima dovrebbe essere nei paraggi. Riesci a percepirla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Se chiudo gli occhi e mi concentro sulla luce che emanava la ferita... Sì, percepisco qualcosa. È qui vicino, ma non riesco a capire dove.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Non riesco a localizzarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Mmmh. Il nostro avversario deve aver celato le sue tracce. Avresti dovuto percepire una sensazione molto più forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Un momento, guardate! Gli spuntoni sono tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Calma. Facciamoci da parte, per ora, e vediamo con cosa abbiamo a che fare. Meglio procedere con cautela, piuttosto che rischiare di finire dritti in una trappola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Dev'esserci un motivo, se il nostro nemico ha preso parte della tua anima... Ed è probabile che l'abbia integrata in qualche modo nei suoi attacchi. Usando il giusto approccio, possiamo rintracciarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Ma so che è vicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
