				]
			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "Fiuu... Ah... Ora dovremmo essere al sicuro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360502,
					"content": "Non percepisco più la sua presenza. Dubito ci abbia seguito al di fuori del dominio abissale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360503,
					"content": "Un pusillanime come lui scoprirà a sue spese che il mio potere non è così facile da controllare. Finché non riuscirà a digerirlo, non credo avrà la forza di lasciare quel posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360504,
					"content": "Il Narvalo Divoramondi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "#Sembri {F#sorpresa}{M#sorpreso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360507,
					"content": "Beh, è normale... Tu hai visto solo una minima parte di ciò che quella balena è in grado di fare. Con le sue fauci gigantesche potrebbe divorare un pianeta intero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360508,
					"content": "Si chiama \"Narvalo Divoramondi\" non a caso... \"Divorare\" è ciò che gli riesce meglio. Può assorbire potere da qualsiasi cosa, viva o morta che sia, purché vi stabilisca un contatto fisico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360509,
					"content": "Già, quando ci abbiamo combattuto contro, Neuvillette ce l'aveva accennato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360510,
					"content": "Il vostro amico drago ha riconosciuto la natura delle sue capacità e ha usato il potere di Hydro per proteggervi. Ha funzionato perché quella volta la balena era già sazia, quindi era meno aggressiva del solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360511,
					"content": "Ma quando si ritrova a non avere più potere di cui nutrirsi, la sua voracità diventa implacabile. Sarebbe capace di cibarsi di tutto ciò che le capita a tiro... per questo l'ho gettata in quello spazio vuoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360512,
					"content": "Tuttavia, non pensavo che su questo pianeta avrei trovato qualcuno capace di sfruttare il suo potere. E questo può significare solo una cosa, secondo me: quell'uomo ha incontrato la balena, molto tempo fa, e deve aver conosciuto il mio maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360513,
					"content": "Sì, sentirti dire \"l'Abominevole\" di certo gli ha provocato una reazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "#Proprio così. Mi ha detto tutto ciò che mi serviva sapere. Per questo reputo che abbiamo {F#entrambe}{M#entrambi} ottenuto ciò che volevamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360515,
					"content": "E con questo, il nostro scambio può dirsi concluso. Ora che hai ritrovato il tuo frammento mancante, potete riprendere il vostro viaggio. Posso occuparmi del resto da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360516,
					"content": "Non se ne parla proprio! È colpa nostra se quel tizio ti ha derubato! Dobbiamo aiutarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360517,
					"content": "Non è certo la prima volta che mi capita di fallire o essere privata dei miei poteri. Quando si cade, bisogna soltanto rialzarsi e diventare più forti. È così che funziona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360518,
					"content": "Ma... Che farai se quel mostro ti trovasse prima che tu riesca a riprenderti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360519,
					"content": "E poi, come farai a tornare a casa? Non puoi nemmeno aprire le porte per l'Abisso come prima. Non prima che tu ti sia rimessa in sesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360520,
					"content": "Restare con noi per un altro po' non è la fine del mondo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360521,
					"content": "Non lo facciamo per compassione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360524,
					"content": "Va bene. Allora prendete questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360525,
					"content": "Oh, che cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360526,
					"content": "È un pacchetto di Mora. So bene che niente a questo mondo è gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360527,
					"content": "Lascio a voi la pianificazione. Sbrigatevi e decidete dove andare, meglio non rimanere qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360522,
					"content": "Hai detto che essere in debito con te è l'ultima cosa che voglio. Beh, il mio debito non è ancora saldato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "Con quel potere, è riuscito a colpire persino te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
