			"dialogs": [
				{
					"id": 150360101,
					"content": "Un momento... Qui siamo vicino alla Voragine, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "Esatto. Entrando da qui, raggiungeremo il luogo del tuo sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "Hai già esperienza con i domini dell'Abisso, ma questo territorio appartiene a qualcun altro. Meglio procedere con cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "Niente paura! Paimon è un'esperta nell'usare gli altri come riparo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Oh, ma, ehm... Questo significa che devi fare molta attenzione, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "Lo farò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Bene. Ricorda il tuo addestramento. È ora di metterlo in pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Diamo una bella lezione a questo ladro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
