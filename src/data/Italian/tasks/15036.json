						],
						"pointId": 30
					}
				]
			},
			"dialogs": [
				{
					"id": 150360601,
					"content": "Uhm, il pacchetto di Skirk contiene veramente tanti Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360602,
					"content": "Avrà un lavoro di qualche tipo? No, aspetta. Dopo quel che è successo al Ristorante Wanmin, sembra impossibile. Cioè, te lo immagini? Sarebbe una cosa tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360603,
					"content": "\"Capo, vorrei lo stipendio di questo mese.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360604,
					"content": "\"Oh, certo! Aspetta un momento, tu chi sei? Ci conosciamo?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360605,
					"content": "Mh, non puoi mica lavorare se fai in modo che nessuno si ricordi di te. Ma allora... come avrà fatto a guadagnarsi tutti questi Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360606,
					"content": "Uff... Trovando qualche tesoro sepolto, eliminando mostri piantagrane... Niente di sconveniente. Sono soldi puliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360607,
					"content": "Waah! Hai sentito tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360608,
					"content": "Beh... Con la voce squillante che ti ritrovi, credo ti abbiano sentita anche in cima a qualche montagna nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360609,
					"content": "Allora, per caso... hai sentito anche quella, ehm... battuta innocente che ha fatto Paimon qualche giorno fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360610,
					"content": "Parli di quando mi hai chiamata \"Ghiacciolo al Melonlavanda\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360611,
					"content": "A quanto pare sì, eheh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "No, no. Scusa, Paimon si è espressa malissimo. Anzi, non ha detto proprio niente! È stata... una sosia di Paimon! Eh, sì, c'è una furfantella che sta sempre a fare l'imitazione di Paimon e a dare strani soprannomi alla gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360614,
					"content": "#...Oh, e va bene. La verità è che all'inizio a Paimon non andavi molto a genio. Ma adesso è diverso! Sei stata di enorme aiuto a {NICKNAME}, quindi... Che ne dici? Vuoi essere nostra amica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360616,
					"content": "Ho visto che c'è solo un letto. Andate pure a riposarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360617,
					"content": "Aspetta, e tu che farai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360618,
					"content": "Io non mi stanco, non ho bisogno di riposare. Andrò a esercitarmi con la spada. Dovrebbe aiutarmi a rimettermi un po' in forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360619,
					"content": "Ma... La tua spalla! Ehi, non te ne andare così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360620,
					"content": "Uff, che tipo. Beh, lasciamo che si stanchi ancora. Prima o poi tornerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360621,
					"content": "Andiamo a dormire, su! Quel letto così comodo sta chiamando Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360622,
					"content": "(Skirk è testarda. Anche se provassi a convincerla a rilassarsi, dubito che mi ascolterebbe.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "(Paimon ha ragione. Di sicuro Skirk si riposerà quando si sarà stancata abbastanza... Almeno spero. Meglio che dorma un po' anch'io.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "*ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360625,
					"content": "(Skirk...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "(Si sta comportando come se non fosse stata ferita alla spalla. Uhm, però sembra che qualcosa non vada...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "*ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360628,
					"content": "...Fa' silenzio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360629,
					"content": "(Con chi sta parlando? Non c'è nessuno, qui. A meno che...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "Non ricordi quanti di noi sono morti in quell'incendio? Quanti corpi sono rimasti a marcire sulla terra bruciata? Eppure, tu sei l'unica che è sopravvissuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "Abitante nel panico"
				},
				{
					"id": 150360631,
					"content": "Tieni gli occhi fissi sulla tua lama. Non meriti di riposare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "Abitante nel panico"
				},
				{
					"id": 150360632,
					"content": "Corri, Skirk... Corri! Qui c'è solo morte per noi. Continua a correre e non voltarti mai indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "Voce maschile allegra"
				},
				{
					"id": 150360633,
					"content": "(È vero! In quel sogno, ho visto Skirk che si allenava da sola, ma c'erano delle voci incorporee che si rivolgevano a lei.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "(Una di loro parlava di un incendio... Mi chiedo cosa sia successo esattamente. Se solo potesse parlarci...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "Ahhh! Non c'è niente di meglio che farsi una lunga dormita! Quel letto era super comodissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360636,
					"content": "Eh? Skirk? Sei rimasta seduta qua fuori tutta la notte? Il letto è tutto tuo, se lo vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360637,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360638,
					"content": "Hai recuperato le forze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "Sono circa al sessanta per cento, forse al settanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360640,
					"content": "Woah! Paimon pensava ti ci sarebbero voluti almeno un paio di giorni! Che velocità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360641,
					"content": "No... Non sono abbastanza veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360642,
					"content": "È un venti percento in meno rispetto all'ultima volta. Ho seguito lo stesso regime di allenamento con la medesima intensità, ma per qualche ragione ho fatto peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360643,
					"content": "Che sia colpa di quello spuntone che ti ha colpito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "No, probabilmente il problema sono io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360645,
					"content": "Dovrò trascorrere i prossimi due giorni a meditare. Un'introspezione approfondita dovrebbe aiutarmi a determinare il problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360646,
					"content": "Cavoli, sembra pesante! Vorrà dire che baderemo noi a te, nel frattempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360647,
					"content": "Grazie. Ci rivediamo fra due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360612,
					"content": "Devi lavorare sul tuo sussurro, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
		{
			"id": 1503650,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1503609",
							"2"
						],
						"stepId": 1503609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365001,
					"content": "Lui sa qualcosa sul Maestro, ne sono sicura... La prossima volta, dovrò essere pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "Come sta la spalla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "È a posto. Era solo un graffio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Mi ci vorrà del tempo per recuperare le forze, ma adattarmi a situazioni del genere non è una novità, per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "I tuoi vestiti sembrano diversi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "Ah, questa? È una \"tenuta in cristallo stellare\". A Teyvat, l'energia dell'Abisso è scarsa; questo abbigliamento mi permette di accedervi più liberamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Al suo interno è racchiusa una quantità concentrata di energia dell'Abisso che posso utilizzare quando voglio. Quando l'energia si esaurisce, il dispositivo torna alla sua forma originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Possiamo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Ah, hai trovato un posto dove riposare? Va bene, allora. Dopo di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
		{
			"id": 1503651,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
