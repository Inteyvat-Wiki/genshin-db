				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baizhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "#Ti vedo molto meglio, {NICKNAME}. Ne deduco che tu abbia risolto i tuoi problemi di salute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Uhm, la tua era una situazione complicata. Forse è un tantino presto per festeggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "#Concordo, Changsheng. Dovremmo {F#tenerla}{M#tenerlo} sotto osservazione ancora per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "Non abbiamo molti pazienti, ultimamente, quindi ci sono diverse stanze libere. Se ne avete bisogno, potete fermarvi anche per qualche giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "Fantastico! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}