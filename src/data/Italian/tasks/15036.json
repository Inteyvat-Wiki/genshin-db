			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#Ah, {NICKNAME}, Skirk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360302,
					"content": "Cos'è successo? Sembra che Skirk sia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360304,
					"content": "Nelle Pianure di Guili, mi hai chiesto perché questo nemico ha preso di mira proprio te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360305,
					"content": "Adesso è chiaro. Non è solo per via della tua forza impressionante, ma anche per la tua capacità di \"purificare\" il potere dell'Abisso di cui parlavi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360306,
					"content": "Qualunque cosa significhi, quell'abilità gli ha permesso di fare qualcosa che normalmente dovrebbe essere impossibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360307,
					"content": "Ha infranto le mie difese e si è preso il mio potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360308,
					"content": "Vuoi dire che eri tu il suo vero obiettivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "No, non poteva sapere che sarei venuta nel suo dominio. Ha rubato il frammento della tua anima perché sapeva che il suo potere era prezioso. Dubito si aspettasse di poterlo sfruttare così presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360311,
					"content": "Puoi chiamarlo \"destino\", se vuoi. Se non erro, è il termine che usano in questo mondo per riferirsi a coincidenze imprevedibili come questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360312,
					"content": "Se non altro, la cosa ha funzionato a nostro vantaggio. Quando ho capito come intendeva usare quel potere, sono riuscita a recuperare ciò che avevi perso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360313,
					"content": "Ma tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Io me la caverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360315,
					"content": "Dunque, ti sei rimpinzato per bene? Ottimo. Allora rispondi a qualche domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360316,
					"content": "Come hai ottenuto il potere del Narvalo Divoramondi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360317,
					"content": "Il Narvalo Divoramondi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360318,
					"content": "Ohh... Ma certo! Ecco perché quello spuntone aveva un'aria familiare! Era identico al corno del narvalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360319,
					"content": "Dubito che tu abbia ottenuto quel potere con le tue sole forze. Dimmi se sbaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360320,
					"content": "Cerchi disperatamente di accaparrarti ogni resto divino o vestigia di potere che riesci a trovare. Questo dimostra che non avresti mai sconfitto una creatura del genere in condizioni normali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360321,
					"content": "Andando per esclusione, la spiegazione è soltanto una... Tu conosci Surtalogi \"l'Abominevole\", il mio maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360322,
					"content": "\"L'Abominevole\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360323,
					"content": "Chi osa chiamarlo \"Abominevole\"? Surtalogi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360324,
					"content": "Surta... logi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360325,
					"content": "Cosa c'è? Ti sei ingozzato troppo? Non riesci nemmeno a intrattenere una semplice conversazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360326,
					"content": "Solo un altro po'. Sto ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360327,
					"content": "Guardate! Sono tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360328,
					"content": "Chi è ossessionato dal potere preferisce farsi divorare da esso, piuttosto che rinunciare ai propri fini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360329,
					"content": "Che facciamo, ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "#Resta {F#calma}{M#calmo} e ragiona su quale sia la mossa migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360331,
					"content": "(Skirk è stata trafitta da uno degli spuntoni mentre recuperava il frammento della mia anima, e nel farlo ha perso parte del suo potere.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(Il responsabile si nasconde da qualche parte nella nebbia. Ho appena combattuto contro di lui, quindi credo di aver capito come attacca. Se lo inseguiamo, le nostre probabilità di vittoria sono alte.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Ma Skirk sembra respirare a fatica. Se attacchiamo adesso, non posso garantire la sicurezza sua o di Paimon. È una decisione difficile, ma...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Penso sia meglio andarcene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "Saggia decisione. La vittoria finale non sempre si decide in un'unica battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360336,
					"content": "Abbiamo recuperato la parte mancante della tua anima, quindi la nostra missione è compiuta. Lasciamo che il nemico riprenda fiato, per adesso. La faccenda è solo rimandata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360337,
					"content": "#Facci uscire da qui, {NICKNAME}. Stavolta tocca a te guidarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360309,
					"content": "Aveva preso di mira te fin dall'inizio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
