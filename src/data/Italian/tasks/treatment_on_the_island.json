			"dialogs": [
				{
					"id": 721380701,
					"content": "Bleah!!! Ehm... ah... ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380702,
						721380703
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380702,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				},
				{
					"id": 721380704,
					"content": "Beh... come dire... è amarissima, e ora ho la lingua insensibile. La paralisi localizzata potrebbe essere causata dal Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380705
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380705,
					"content": "È terribile, ma pare innocua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380706
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380706,
					"content": "Potrebbe volerci parecchio tempo per analizzare gli effetti collaterali della medicina. Non so se... Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380707
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380707,
					"content": "#Stanno... stanno venendo verso di noi! Sbarazzatene, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
