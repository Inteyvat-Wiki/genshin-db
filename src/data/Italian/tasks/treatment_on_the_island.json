	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Aaah!!! Ehm... non sono un tipo sospetto, lo giuro! Solo un semplice dottore del luogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Se non mi credi, posso mostrarti dove vivo. Prendi quello che ti pare, ma lasciami andare, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Oppure portami da lord Kujou, il Generale! L-Lui mi conosce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Temo ci sia un malinteso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "#Eh...? Beh, non sembri un membro dello Shogunato, dopo tutto, né {F#una}{M#uno} di Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "#Sei per caso... u{F#na}{M#no} stranier{F#a}{M#o}? Che ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Beh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "A ogni modo, faresti meglio ad andartene il prima possibile. L'Isola di Yashiori è molto pericolosa, ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Al momento, il Tatarigami non sembra intenzionato a sparire... Inoltre, la Commissione Tenryou non si ritirerà certamente a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "L'isola non è più abitabile, e anche il turismo è altamente sconsigliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Se il Commissario ti sta alle calcagna e stai sfuggendo all'arresto, dirigiti a ovest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "#La Commissione Tenryou non accoglie volentieri fuggitivi sconosciuti, però potresti essere ben accett{F#a}{M#o} tra i pirati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Cos'è successo sull'isola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "#Beh, guarda tu stess{F#a}{M#o}. Non vedi cosa ci hanno fatto i bellimbusti di città e la gente di Sangonomiya?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Prima l'esplosione a Tatarasuna... Quella notte in cielo si vedevano colori stranissimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Molti dei miei parenti e amici hanno perso il lavoro e ora vivono in povertà. Tanti altri sono stati gravemente feriti ed erano in condizioni pietose, quando sono finalmente tornati a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Altri ancora... non sono riusciti a scappare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Poi quei geni di Sangonomiya hanno distrutto gli amuleti che tenevano sotto controllo i resti del Serpente. Il Tatarigami ha iniziato a diffondersi e gli abitanti dell'isola sono fuggiti in preda al panico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Anche la strana malattia portata dal Tatarigami continua a diffondersi, e molti residenti si sono gravemente ammalati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Temo sia solo questione di tempo, poi si diffonderà agli accampamenti di entrambi gli eserciti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Dove sono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Questo era uno dei luoghi chiave per la produzione del cristallo usato per ottenere l'acciaio di giada di Inazuma. Grazie alle scorte di cristalli, potevamo vivere agiatamente senza dover dipendere dalla gente di città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "E adesso? Non si trovano quasi più esseri viventi sull'isola... Cioè, umani come me, che parlano normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Perché tu non vai via?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Secondo te, non me ne andrei molto volentieri? Il figlio del Commissario Tenryou mi ha invitato più volte... Dovresti ancora trovarlo con l'esercito per dirigere la battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "\"Hai competenze mediche, sei diverso dalla gente comune. È pericoloso per te rimanere sull'isola, perché non diventi il mio medico personale? Posso fare il tuo nome a mio padre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "O almeno, così mi ha detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Prima della guerra, curare un commissario sarebbe stato un vero onore. Per un medico di campagna come me, poi, un autentico sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Adesso, però... Pensaci bene. Il Commissario non ha certo problemi ad assumere i migliori dottori in circolazione. Sull'Isola di Yashiori, invece, l'unico in grado di curare i bisognosi sono io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Quindi non me ne andrò, né presterò soccorso a nessuna delle due fazioni. Ho un solo nemico, io, il Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Posso fare qualcosa per te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "No, nulla... Anzi, dimentica quello che ho appena detto. Aspetta, in realtà sì, un aiuto mi farebbe molto comodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Ho bisogno di alcune piante speciali per preparare una medicina in grado di contrastare gli strani effetti del Tatarigami. Non ho la certezza che funzionerà, ma tentar non nuoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Il problema è che il Tatarigami ha contaminato tali piante, e queste ormai si trovano in ambienti pericolosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "I dintorni sono irraggiungibili per via dell'acqua oppure brulicano di mostri... Si tratta di luoghi altamente esposti a un'intensa concentrazione di Tatarigami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Uno con le mie abilità... e il mio coraggio si troverebbe in grossa difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Sono anche un dottore, quindi preferirei non correre rischi del genere per cogliere qualche pianta. Di conseguenza, da tempo mi limito a trattamenti cauti e palliativi, senza avere occasione per testare rimedi nuovi e più efficaci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "#Viaggiat{F#rice}{M#ore}, vedo che hai con te un aliante, si vede che hai esperienza. Cose del genere per te dovrebbero essere una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Quindi, mi aiuteresti a recuperare gli ingredienti adatti in quei luoghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "#Riporta qui le piante, una volta trovate. Verrai ricompensat{F#a}{M#o}, non temere. Ho ancora qualcosa da parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Un incarico da uno straniero forse non ha molte attrattive, ma spero che lo valuterai. Grazie in anticipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "E comunque, fa' attenzione lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Sembri scoraggiato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "È una lunga storia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Sei sospetto eccome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
