					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "Uff... uff... Il cuore mi è quasi balzato fuori dal petto. Mi hai salvato la vita, grazie davvero. Non lo dimenticherò mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "È un fenomeno normale. Gli esseri viventi infettati dal Tatarigami vengono attirati inconsciamente dall'energia nefasta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Dal momento che questa medicina contiene molta energia estratta dal Tatarigami, ne sono naturalmente attratti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Che faticaccia... A ogni modo, ora penso di sapere come migliorarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Il recente fallimento ha sprecato parecchie erbe, però, quindi me ne servirebbero di fresche per continuare la sperimentazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Nelle tue prossime avventure qui sull'isola, {NICKNAME}, ti spiacerebbe raccogliere per me qualche altra erba utile? Di mattina troverai un cesto di bambù davanti casa, puoi lasciarle lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Ti darò la ricompensa promessa, ma temo che dovrai attendere un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#Se sei occupat{F#a}{M#o} lascia stare, {NICKNAME}, lo capirei. Posso sempre cercare qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "Puoi contare su di me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Arrivederci, {NICKNAME}, spero che non correrai pericoli sull'Isola di Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
		},
