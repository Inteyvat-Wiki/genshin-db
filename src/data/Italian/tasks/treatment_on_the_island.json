			},
			"dialogs": [
				{
					"id": 721380201,
					"content": "Oh, eccoti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380202,
					"content": "Hai trovato le erbe che ti dicevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
			"id": 7213803,
			"completionStepIds": [
				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "Ancora fresche e perfette, con steli e foglie intatti... Grazie infinite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380302,
					"content": "C'è tutto, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Certo, dovrebbe bastare. Ora posso iniziare i test sui nuovi medicinali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380304,
					"content": "Grazie ancora per i tuoi sforzi, ed ecco la ricompensa promessa. Spero non sia troppo misera per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380305,
					"content": "#In ogni caso, stranier{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380306,
					"content": "No, lasciamo stare. Ti ho già dato fin troppi pensieri, eppure non so ancora come ti chiami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380307,
					"content": "#Chiamami pure {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, se mai volessi aiutarmi nuovamente, torna a trovarmi in seguito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380309,
					"content": "Anche in quel caso ti ricompenserò adeguatamente, è chiaro. Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
