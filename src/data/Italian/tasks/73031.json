			"dialogs": [
				{
					"id": 730310501,
					"content": "Il Festival di Utsava, di cui una volta si è parlato nella mia storia... Riuscirò a vederlo ancora una volta con i miei occhi?",
					"roleType": "TALK_ROLE_NPC",
