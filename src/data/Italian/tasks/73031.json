				},
				{
					"id": 730310309,
					"content": "Il Festival di Utsava sta quasi per iniziare. Arama non vede l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "Chissà come sta Rana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#Dovremmo andare a vedere come sta Rana, {NICKNAME}. Forse ora si sente meglio! Se è così, possiamo portarla qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Hai ragione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Anche io vado a trovare Arana tra poco. Voi andate avanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#A più tardi, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Speriamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "Non voglio illudermi troppo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Anch'io non vedo l'ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Sì! Paimon si chiede come sarà rispetto agli altri festival. Comunque sia, Paimon è entusiasta di passare questi momenti con i suoi amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "Se solo Rana fosse qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Paimon"
