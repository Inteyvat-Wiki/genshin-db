			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama! Siamo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#Che bello rivedere Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Oh, siete tornat{F#e}{M#i}! Tutti parlavano di {F#una}{M#un} Nara molto alt{F#a}{M#o} e potente di nome {NICKNAME} che li ha aiutati tanto. Erano tutti molto felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#È sempre bello quando c'è qualcuno ad aiutarti, vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Proprio così!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "No, sono felici perché hanno stretto nuove amicizie. Anche se Aranakin, Aranaga e Aragaru non riescono più a ricordarlo, la foresta lo farà. La storia continuerà a vivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Il Festival di Utsava sta quasi per iniziare. Serve solo ancora un po' di tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Sì, inizierà presto, e tutto grazie all'aiuto di Nara {NICKNAME} e Paimon. Non vedo l'ora che cominci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Giusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
