			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana sembra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Paimon vorrebbe dire che sta facendo sogni d'oro, ma non sembra così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Un'immagine sfocata appare nella \"bolla\" che ingloba Rana.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "#(Vieni ammaliat{F#a}{M#o} dall'immagine.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Ti trovi in una foresta dove tutto sembra essere immenso, e una sensazione di serenità ti avvolge. Ti senti a tuo agio.\\nI raggi del sole fanno capolino tra le foglie dorate e luccicanti, con l'erba alta tanto quanto te che ondeggia silenziosamente, sfiorandoti delicatamente la mano mentre cammini.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Tra la melodia del vento che soffia tra gli alberi e lo scorrere dell'acqua, si può udire il suono di un pianto angosciato. Seguendo il suono, trovi una bambina.\\nSembra che abbia pianto così tanto da sfinirsi, e che si sia addormentata nel prato. Ti avvicini a lei e intoni dolcemente una canzone in grado di rasserenare ogni essere vivente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#...Ehi! Che succede, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Che sollievo... Paimon era preoccupata... Sembrava che stessi per svenire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Siete tutti qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Wow! Hai spaventato Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Wow!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Caspita, ma cosa vi salta in testa a voi Aranara di spaventare così la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Hai detto \"wow\" per prima, Bianchina volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Mi chiamo Paimon, non Bianchina volante",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana era nella terra per preservare il potere dell'Ararakalari. In questo modo, Narana non appassirà. Ma ha ancora bisogno del Bija per recuperare le forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Ok, Paimon ha capito. Ma cos'è successo a {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Spieghi la tua visione.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Quello dovrebbe essere ricordo di Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Ricordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Oh, lasciate che Arana vi spieghi. Il potere degli Aranara risiede in ciò che è più prezioso per loro: i ricordi e i sogni. Con i ricordi e i loro sogni, Arana può usare l'Ararakalari per aiutare i Nara e gli Aranara che hanno bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Alcuni Nara possono percepire i ricordi nell'Ararakalari. Nara {NICKNAME} è un{F#a}{M#o} di questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "L'Ararakalari sembra una cosa molto importante! Hai usato tu l'Ararakalari per proteggere Iotham in quella grotta, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Sì, è stata Arana. Nara Iotham, Nara Kavus e Nara Sudabeh sono tutti amici, perciò Arana li ha protetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Andiamo spesso nella foresta, perciò Arana ha insegnato loro delle cose sulla foresta e sulla lingua delle piante. Sono ottimi amici, come Narana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "A proposito dei bambini scomparsi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Giusto! Prima di Iotham, anche Kavus e Sudabeh sono scomparsi, ma sono stati riportati al villaggio più tardi. Anche quella è stata opera tua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Sì, Arana ha notato il Nara cattivo e Nara Valuka che parlava con loro, perciò Arana ha aiutato Nara Kavus e Nara Sudabeh a scappare quando il Nara cattivo era distratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Ma perché non ricordano nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana ha fatto addormentare e sognare i piccoli Nara, poi ha cancellato le cose brutte dai loro sogni. Così, quando cresceranno, proprio come germogli che diventano alberi, non diventeranno cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Altrimenti i piccoli Nara avrebbero paura. Se i piccoli Nara hanno sempre paura, credono nel suo potere e da grandi diventano spaventosi Nara cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Sono amici di Arana, perciò Arana non vuole che diventino Nara cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Trovo che abbia senso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Da grandi diventeranno speciali! A proposito, hai qualche indizio sul Nara cattivo che ha provato a rapirli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana non li perdonerà mai. I Nara cattivi non sono Figli della foresta. Portano con sé Nara Valuka cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Nel Villaggio di Vimara c'è uno strano Nara. Non è un Figlio della foresta, ma della neve. Sembra un Nara buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Sta spesso insieme ai piccoli Nara e loro parlano di lui. Per questo Arana pensa che sia buono. Ma Arana l'ha anche visto parlare degli Aranara con il Nara cattivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Nel Villaggio di Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Fa parte dei Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Com'è possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Ah... Paimon non vuole nemmeno immaginarlo. Gli abitanti del Villaggio di Vimara dovrebbero trattarsi come una famiglia... Dopotutto, quella persona è la causa di ciò che sta succedendo ora a Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Dobbiamo catturare il cattivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Bene. Ci occuperemo di quella persona, a tutti i costi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Promettetelo, Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Promettete che punirete quel Nara cattivo, così Nara Iotham, Nara Kavus e Nara Sudabeh diventeranno tre Nara grandi senza paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Ora Narana è cresciuta, perciò non può più vedere Arana. Ma non importa, Arana è felice se sa che sta bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Non gioco con Narana da tanto tempo, ormai. Molti soli sono sorti e molte lune sono apparse in cielo. Molti frutti sono cresciuti sugli alberi e tornati alla terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Narana è cresciuta sempre di più. Prima era alta come Arana, poi come un piccolo albero. È lì che ha smesso di giocare con Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana ha raccontato molte storie sulla foresta. Gli Astrofunghi sono il riflesso delle stelle del cielo. Vedere il loto Nilotpala sbocciare ti porterà fortuna fino alla prossima alba di luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Arana insegnerà le stesse cose a Nara Iotham e ai suoi amici. Spero cresceranno bene come Narana. Oh, però senza imbattersi in Marana come Rana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Dimenticheranno tutto quando cresceranno, come Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, Nara Kavus e Nasa Sudabeh cresceranno. Non importa se non ricorderanno: la foresta non dimenticherà, e niente andrà perduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "La foresta non dimenticherà. Nessuna cosa bella svanisce nel nulla. Le sofferenze diventeranno il nutrimento per qualcosa di meraviglioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana non ti vede da un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Non hai avuto paura, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "E dai, Paimon non si spaventa così facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Arama vuole che torniamo nel Vanarana per celebrare il Festival di Utsava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Sì! Ora è pronto, e tutti stanno aspettando Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Urrà! Il Festival di Utsava! Ma tu verrai con noi, Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Arana non verrà. Se Arana stesse via troppo a lungo, l'Ararakalari non reggerebbe e Narana sarebbe in pericolo. Quindi, niente festival per Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Ohh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Non importa, finché Nara {NICKNAME} e Paimon sono felici, allora lo sono anche Arana, Arama e tutti quanti nel Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Sì, il Bija ha bisogno di te, Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Arana sarà pronta entro allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Oh, questo è per te, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "Un fiore...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Sì, prenditene cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "Lo terrò al sicuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Grazie, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Allora rientriamo, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "Dobbiamo rientrare per il Festival di Utsava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "Ci occuperemo di quella persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Qualcuno vuole prendere i bambini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Speriamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Da grandi diventeranno speciali! A proposito, hai qualche indizio sul Nara cattivo che ha provato a rapirli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "A proposito dei Nara cattivi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "A proposito dell'amnesia dei bambini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "Questa scena l'ho già vista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
