					"nextDialogs": [
						250250304
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250304,
					"content": "Ho già raschiato il fondo qualche giorno fa, quindi devi solo eliminare le impurità che galleggiano in superficie.",
