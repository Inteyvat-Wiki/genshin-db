					"nextDialogs": [
						250250305
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250305,
					"content": "Mi affido a te, allora. Io continuerò a cercare di persuadere questo piccoletto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250306
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250306,
