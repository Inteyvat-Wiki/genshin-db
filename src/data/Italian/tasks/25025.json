			"dialogs": [
				{
					"id": 250250101,
					"content": "Potresti uscire un attimo dall'acqua? Devo pulire le sorgenti quaggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Koholasauro pigro"
				},
				{
					"id": 250250103,
					"content": "Dai, fa' il bravo! Altrimenti devo venire lì a prenderti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Koholasauro pigro"
				},
				{
					"id": 250250105,
					"content": "Sparito in un secondo. Adesso come farò a trovarlo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Eh? Vuoi fare un bagno termale? Mi spiace, ma sto pulendo la sorgente, devi aspettare un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "E poi non riesco a convincere questo testone ad andarsene. *sospira* E pensare che ho anche tante altre sorgenti da pulire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Forse sta facendo i capricci perché ho dovuto trascinarlo fuori qualche giorno fa? Che seccatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
