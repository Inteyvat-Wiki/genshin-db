						250250202
					]
				},
				{
					"id": 250250202,
					"content": "Beh... Sì, perché no? Chissà, magari un approccio diverso è proprio quello che ci vuole. Buona fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250203
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250203,
					"content": "Ma cosa gli è preso? Prima bastava accarezzargli la <color=#00E1FFFF>testa</color> o la <color=#00E1FFFF>pancia</color> e faceva tutto ciò che gli veniva detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
