				},
				{
					"id": 230350601,
					"content": "È stato un grande aiuto. Sono certo che Asagiri creerà un'illustrazione eccellente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350602
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350602,
					"content": "Grazie infinite, Cyno. Le spedirò una copia del romanzo non appena pubblicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350603
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350603,
					"content": "Ehm, Cyno, i due mazzi che ha in mano...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350604
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350604,
					"content": "Non avevi promesso di fare qualche partita a Invokazione del genio con me poco fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350605,
					"content": "#Eh!? I-Io non sono molto bravo, quindi... viaggiat{F#rice}{M#ore}! Tu giochi di gran lunga meglio di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350606,
						230350607
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350606,
					"content": "Non ho mai giocato prima d'ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "Sei meglio di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "Allora la questione è risolta. Ecco, prendi questo mazzo da attacco rapido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350609
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350609,
					"content": "Io userò questo mazzo relativamente più lento per vedere come riesco a fronteggiare i tuoi attacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350610,
					"content": "Farò del mio meglio, Cyno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
