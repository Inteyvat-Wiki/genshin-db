			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "*sospira* Voglio tornare a Inazuma... Perché è successo proprio a me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Cosa c'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "#Viaggiat{F#rice}{M#ore}? *sospira* Oh, non pensare nemmeno al romanzo. I ragazzi che lavorano a Invokazione del genio, il gioco di carte, sono un po' in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "Secondo un ricercatore che conosco discretamente, la squadra ha avuto problemi di tutti i tipi, che potrebbero essere descritti solo come sconcertanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Ad esempio, un giorno un ricercatore dell'Haravatat si è immischiato all'improvviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Ha detto che la descrizione dell'effetto delle carte è troppo lunga e potrebbe scoraggiare le persone che non sono abituate a leggere lunghe porzioni di testo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "I ricercatori sono abituati a leggere lunghe sezioni scritte e per loro il problema non sussiste, ma le descrizioni lunghe potrebbero intimidire giocatori potenziali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "Per cui ha suggerito di ridurre la quantità di testi su alcune carte per renderle più facili da leggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "È davvero necessario?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Non è un problema per me... Ma i ricercatori ci stanno ancora lavorando duro. Dopo tutto, c'entra l'esperienza del giocatore, e meno problemi ci sono, meglio è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Comunque... C'è un problema ancora più grande. Hanno promesso di aiutarmi a trovare i modelli per il mio romanzo, ma qualcosa è andato storto anche là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Ti ricordi? Ti avevo parlato di un ricercatore che diceva di volermi presentare Tighnari e Cyno, e chiedergli di farmi da ispirazione per il mio romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Ma sono così occupati. Penso che non potrò contare su di loro per un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "Cosa farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Il ricercatore che mi ha ricevuto non è stato in grado di aiutarmi con questa faccenda, ma mi ha dato un'idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "Ha detto che Cyno a volte va a giocare a carte al Bar Puspa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Se volessi... potrei provare ad andare lì. O magari mi aiuteranno a contattarli quando saranno liberi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "E... cosa ne pensi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "*sospira*... Quando saranno liberi, avrò finito di scrivere il romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Allora magari ci vado e vedo se trovo Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Ma se dovessi essere così fortunato da incontrarlo al bar, in che modo potrei approcciarlo? Chissà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Posso aiutarti io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Davvero?!? È fantastico! Ma come... Ehm, sai che ti dico? Non voglio indagare oltre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "Cosa stiamo aspettando allora? Andiamo al Bar Puspa, di corsa. Speriamo di riuscire a incontrare Cyno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "Conosco Cyno abbastanza bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Come li contatterai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "È davvero così lungo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Hai il blocco dello scrittore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303503",
							"2"
						],
						"stepId": 2303503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Shhh... N-Non è Cyno, quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Guarda il suo abbigliamento, la sua acconciatura e il colore dei capelli... È esattamente l'aspetto che dovrebbe avere il protagonista di un romanzo di giochi di carte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Tutto ciò non ha alcun senso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Eh, fidati del mio istinto sul mercato. Non è un buon momento per spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "#Viaggiat{F#rice}{M#ore} per favore, chiedi a Cyno di fare da modello per il mio romanzo... Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "In realtà conosco anche un bel po' di persone che rientrano nella categoria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Davvero? Fantastico. Sto lavorando al terzo libro di Re delle Invokazioni, e stavolta non ho intenzione di basarlo sui meccanismi di gioco di Invokazione del genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "Sto per creare un modo totalmente nuovo di combattere. Per esempio... Tutte le carte sono sospese sul campo e i giocatori devono raccoglierle mentre combattono, pensando alla loro prossima mossa, impedendo agli avversari di raccoglierle a loro volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Ahahah! Mi esalta il solo pensiero! Ma non abbiamo tempo per fare questo adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "...Mmh, questa combinazione di carte non è così malvagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Ma non sono forti abbastanza da affrontare attacchi rapidi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Cosa stai facendo, Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? Non mi aspettavo di vederti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Sto cercando di costruire un mazzo di carte per Invocazione del genio con velocità d'attacco relativamente lenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Spero che il mazzo permetterà al giocatore di ottenere un'abbondanza di risorse e un sacco di carte potenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "Ma sinceramente, è difficile costruirne uno del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Al momento, nella comunità di Invokazione del genio, alcuni giocatori preferiscono utilizzare le carte con velocità d'attacco elevate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "All'inizio della partita, si giocano un numero elevato di carte in un colpo solo, per sconfiggere velocemente i propri avversari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Ma io non sono un fan di questa tattica. Preferisco accumulare continuamente risorse tramite modi diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "Cogliere ogni opportunità possibile, costruire il mio vantaggio, e alla fine assicurare la vittoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Sì, sì! Fantastico! Sei proprio come il personaggio principale del mio romanzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Spiacente! Eh... Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Lui è Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "È l'autore di Re delle Invokazioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Salve, generale Mahamatra. Non credo lei abbia mai sentito parlare di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "Ho letto il tuo romanzo. È molto bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Sono davvero onorato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "Nel romanzo, ogni volta che il protagonista si trova in una situazione di svantaggio, riesce sempre a ottenere una carta che non era sul mazzo tramite vari mezzi, e poi sconfigge il suo avversario. Mi ha colpito molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Capisco che per la scrittura dei romanzi è necessaria una licenza creativa, ma questo modo di vincere si allontana troppo dalle meccaniche fondamentali di Invokazione del genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "A proposito, beh... Anche se gioco spesso a Invokazione del genio, non ci so fare molto... E se scrivi dei duelli con una mentalità competitiva, la storia non ne trarrà giovamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
					"content": "Mmh, dici? Beh, si dà il caso che io abbia appena creato due mazzi di carte, possiamo farci una partitina. Magari troverai un po' d'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350423,
					"content": "(Ora si mettono a giocare a carte...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Ha solo voglia di giocare a carte...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "Eh? Giocare con... lei? Mi piacerebbe, ma la verità è che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350426,
					"content": "Lascia che sia io a spiegare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "A proposito della richiesta di Fukumoto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Racconti a Cyno della richiesta di Fukumoto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "Mi stai chiedendo di fare da modello per le illustrazioni in Re delle Invokazioni? Non è assolutamente un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350430,
					"content": "#Grandioso! Forza, viaggiat{F#rice}{M#ore}! Aiutami a scattare qualche foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
