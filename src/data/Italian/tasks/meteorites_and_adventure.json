					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*sospira* Se solo potessi andare a dare un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, sei tu. Beh, non è che sia successo niente di speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Mmmh. No, credo che questa sia davvero una situazione speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Ti riferisci ai meteoriti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Sì! Li hai visti anche tu, vero? È da un po' che cadono dal cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Grazie alla protezione dell'Archon di Anemo... o forse solo per pura fortuna, finora nessuno ha colpito la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Ma alcuni sono atterrati fuori città, e si dice che chiunque ne tocchi uno cada in un sonno profondo... una specie di torpore da cui è impossibile svegliarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Cyrus ha già raggruppato e incaricato un bel po' di avventurieri. Qualcuno è stato mandato ad avvisare chi è ancora fuori dalle mura di cercare riparo in città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Gli altri dovrebbero aiutare i Cavalieri di Favonius a determinare la posizione dei meteoriti caduti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "E a svolgere operazioni di ricerca e salvataggio intorno ai luoghi d'impatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Quanto a me, Cyrus ha detto che è meglio che rimanga in città a dare una mano con chi ha perso conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Forse è perché non sono ancora all'altezza... ma se continuano ad affibbiarmi questi lavoretti secondari, non avrò mai la possibilità di diventare più forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "#*sospira* In ogni caso, devo fare quello che mi è stato assegnato, e farlo bene... Però, posso chiederti un favore, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Potresti andare a raccogliere informazioni sui meteoriti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "A cosa ti servono queste informazioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Cyrus dice sempre che bisogna prepararsi al meglio prima di ogni avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Se riuscissi a convincerlo del fatto che conosco abbastanza bene la situazione, e che ho fatto i preparativi necessari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Magari mi lascerebbe unire alle squadre investigative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Ma al momento sono impegnato ad aiutare le persone qui, quindi non posso uscire a raccogliere informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "#Quindi, per favore, viaggiat{F#rice}{M#ore}, potresti indagare? Non c'è bisogno di andare lontano, basterebbe arrivare alla Foresta dei Sussurri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Se scopri qualcosa, torna a riferirmelo. Il mio futuro da investigatore... è tutto nelle tue mani ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Quindi vuoi uscire di nascosto e...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Cosa? Uscire di nascosto? No! Niente affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Voglio uscire e indagare, sì... ma c'è bisogno di aiuto anche in città, ed è molto importante! Non posso abbandonare i miei compiti così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "È solo che... Beh, Cyrus dice sempre che bisogna prepararsi al meglio prima di ogni avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Se riuscissi a convincerlo del fatto che conosco abbastanza bene la situazione, e che ho fatto i preparativi necessari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Magari mi lascerebbe unire alle squadre investigative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Ma al momento sono impegnato ad aiutare le persone qui, quindi non posso uscire a raccogliere informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Intendi la promozione a metà prezzo per l'anniversario del Buon Cacciatore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Cosa?!? Il Buon Cacciatore sta facendo una promozione? Perché nessuno me l'ha detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Oh, no, aspetta! Non è di questo che volevo parlare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Allora, ultimamente piovono meteoriti dal cielo, sono sicuro che li hai visti anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Grazie alla protezione dell'Archon di Anemo... o forse solo per pura fortuna, finora nessuno ha colpito la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
