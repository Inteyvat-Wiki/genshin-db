			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pallad il Temerario"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Beh, sembra che per ora me li sia scrollati di dosso. Comunque, che diavolo sta succedendo qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250202,
					"content": "Sei venuto qui a indagare sui meteoriti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Proprio così. Ho accettato un incarico dalla Gilda per scoprire tutto il possibile sui meteoriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250204,
					"content": "Ma i mostri situati vicino ai punti in cui sono caduti i meteoriti hanno improvvisamente iniziato a comportarsi in modo strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250205,
					"content": "La loro forza, i loro movimenti e tutta una serie di altre cose sono completamente anomali... e ci sono anche più mostri del solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250206,
					"content": "Sono stato scoperto, e non ho osato rimanere in zona, così ho preso alcuni sentieri meno battuti per far perdere le mie tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250207,
					"content": "Devo riferire queste anomalie a Cyrus il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250208,
					"content": "Hai scoperto qualcos'altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Qualcos'altro? Beh, se devo essere sincero, ci sono parecchi studiosi che si rifiutano di tornare in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250210,
					"content": "Per quanto abbia cercato di convincerli, hanno insistito nel continuare la loro ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250211,
					"content": "Non ci sono neanche abbastanza avventurieri in giro, quindi non possiamo mandare loro dei promemoria ogni paio di giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250212,
					"content": "Che mal di testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 411250213,
					"content": "#Beh, viaggiat{F#rice}{M#ore}, se non c'è altro, dovreste cercare riparo anche voi in città. Non abbiamo tempo da perdere qui fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad il Temerario"
				}
			]
		},
