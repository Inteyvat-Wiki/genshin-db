			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "Eh? Cosa stai guardando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340202,
					"content": "Su questo taccuino ci sono gli appunti su come occuparsi dei fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "Davvero? Paimon vuole vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340204,
					"content": "\"...Andrebbe messo all'aperto e necessita di molta luce...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340205,
					"content": "A quanto pare, Collei non ha avuto il tempo di spostarlo all'esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340206,
					"content": "Hihihi, allora occupiamocene per conto di Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340207,
					"content": "Mmm... In ogni caso, dovremmo prima spostare il fiore. Mettiamolo vicino alla casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340208,
					"content": "Non metterlo troppo lontano, o Collei si preoccuperà se non lo trova al suo ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Mmh, questa lettera sembra scritta da Collei. Vediamo di che si tratta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "Uhm, ma perché non è qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Forse è di nuovo fuori a lavorare con Tighnari. Sono sempre molto impegnati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Dai, leggi la lettera. A giudicare dalla grafia, Paimon scommette che Collei ha calcato parecchio la penna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#\"{NICKNAME} e Paimon, grazie per esservi pres{F#e}{M#i} cura del mio fiore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "\"Abbiamo tante cose di cui occuparci nella foresta, e per Paimon è facile dimenticarsi di prendersene cura, quando è indaffarata...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "\"Grazie ancora per il vostro aiuto. Vediamoci a casa del signor Jahangir per mangiare qualche barchetta di patate, quando Paimon avrà del tempo libero!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "Wow! Collei ci vuole offrire la cena! Paimon se lo annoterà e imprimerà nella mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Mmm... Paimon non sa ancora a cosa stia lavorando Collei, ma sembra impegnatissima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Paimon spera che Collei riesca a dormire abbastanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}