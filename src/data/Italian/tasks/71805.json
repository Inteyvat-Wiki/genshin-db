					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050601,
					"content": "Riguardo ai due libri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "Li hai consegnati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050603,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Grazie. La Libreria Wanwen è riuscita a rimanere aperta per tutti questi anni grazie al sostegno dei clienti di lunga data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "Loro sì che sono veri amanti della lettura. Immagino siano felicissimi di ricevere libri di tale qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "#Grazie davvero per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco, tieni, come compenso per i tuoi sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050607,
					"content": "Quando vorrai acquistare un libro, vieni pure da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
