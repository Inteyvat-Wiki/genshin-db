			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "Mi hai portato qualcosa, giovane?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Borghese De'An"
				},
				{
					"id": 718050402,
					"content": "Ecco l'ordine che avevi chiesto a Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Il quarto volume di Rex Incognito? Ho fatto quest'ordine secoli fa. Perché ci ha messo tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Borghese De'An"
				},
				{
					"id": 718050404,
					"content": "Vediamo. Eh? Una prima edizione? Ora capisco perché ci è voluto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Borghese De'An"
				},
				{
					"id": 718050405,
					"content": "Pensavo che Jifang si fosse dimenticata del mio libro, tra tutti gli altri ordini, e invece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Borghese De'An"
				},
				{
					"id": 718050406,
					"content": "#Grazie per avermelo consegnato, {M#giovanotto}{F#signorina}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Borghese De'An"
				}
			]
		},
		{
