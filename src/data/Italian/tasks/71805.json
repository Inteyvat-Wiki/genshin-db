			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zio Tian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "Cosa posso fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Zio Tian"
				},
				{
					"id": 718050502,
					"content": "Ecco l'ordine che avevi chiesto a Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Quale ordine? Ah... È vero, avevo ordinato una copia di \"Versi di Equilibrium\" alla Libreria Wanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Zio Tian"
				},
				{
					"id": 718050504,
					"content": "Certo, certo, è il libro che volevo. Ahah, iniziavo a sospettare che Jifang si fosse dimenticata del mio ordine, presa com'è dagli altri clienti e tutto il resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Zio Tian"
				},
				{
					"id": 718050505,
					"content": "Ma adesso che il libro è qui, è tutto a posto. Anche la rilegatura non è niente male. Sempre coscienziosa, la nostra Jifang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Zio Tian"
				},
				{
					"id": 718050506,
					"content": "#Grazie, {M#giovanotto}{F#signorina}. Lo porto con me, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zio Tian"
				}
			]
		},
		{
			"id": 7180506,
			"completionStepIds": [
				7180506
