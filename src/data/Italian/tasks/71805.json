						718050702
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050702,
					"content": "Si tratta di due nostri clienti di lunga data. Di solito do la precedenza ai loro ordini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050703,
					"content": "...Ma stavolta la cosa si è trascinata per le lunghe, dato che gli affari sono aumentati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050704,
					"content": "Staranno per perdere la pazienza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
