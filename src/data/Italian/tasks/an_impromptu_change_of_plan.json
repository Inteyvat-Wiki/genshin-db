			},
			"dialogs": [
				{
					"id": 10020501,
					"content": "#Torniamo a noi. A cosa è dovuta la tua visita, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020502,
					"content": "Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020503,
					"content": "Falsità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020504,
					"content": "FALSITÀ!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020505,
					"content": "Le Sette Stelle di Liyue si sono rivelate un'autentica delusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020506,
					"content": "Assassinare Rex Lapis durante il Rito della discensione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020507,
					"content": "Per poi accusare qualcuno tra la folla?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020509,
					"content": "#Viaggiat{F#rice}{M#ore}, costui comprende che delle gravi accuse sono state mosse contro di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020510,
					"content": "La risposta appare chiara... Ma va sottoposta all'altrui vaglio, affinché non ci sia spazio per errori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020511,
					"content": "Ora va'. Prendi il Sigillo del consenso e porta con te un messaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020512,
					"content": "Chi devo cercare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "Dove devo andare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "Qui troverai Formamontagne e Vestale delle nuvole. Solo il destino deciderà se t'imbatterai in loro. Solo il destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020515,
					"content": "Visita la Locanda Wangshu. Laggiù troverai Conquistademoni, un Guardiano Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scultore della luna"
				}
			]
		}
	]
