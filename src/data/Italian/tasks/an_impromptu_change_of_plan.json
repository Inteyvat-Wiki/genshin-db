			"dialogs": [
				{
					"id": 10020201,
					"content": "E voi chi siete? Come osate attraversare i Monti di Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020202,
					"content": "#Mi hanno mandat{M#o}{F#a} qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Ecco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Un Sigillo del consenso... Era da tempo immemore che costui non vedeva un oggetto del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020205,
					"content": "Siete al cospetto del potente e illuminato Adeptus Scultore della luna. Cosa vi porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020206,
					"content": "A dire il vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "#È l'assassin{M#o}{F#a}! Fuggire proprio qui, sui Monti di Jueyun, dopo il delitto... Quale affronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Sergente dei Milleliti"
				},
				{
					"id": 10020208,
					"content": "Signore, ci siamo addentrati troppo oltre tra i Monti di Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Soldato dei Milleliti"
				},
				{
					"id": 10020209,
					"content": "Dannazione, non abbiamo altra scelta. La sua cattura è la nostra priorità, dobbiamo continuare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Sergente dei Milleliti"
				},
				{
					"id": 10020210,
					"content": "...Disturbando i nostri confini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10020211,
					"content": "Fate in modo che non sia più così. Costui non vuole avere interruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scultore della luna"
				}
			]
		},
		{
