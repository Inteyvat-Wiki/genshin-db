				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "Come procede il dipinto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Ho continuato a dipingere a fianco di quelle due statue da quando i loro occhi si sono illuminati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Però... come posso dire...? Ho come la sensazione di non avere ancora realizzato il dipinto perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "È come se mancasse qualcosa, capisci cosa voglio dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "È come quando cucini bene un piatto usando ottimi ingredienti, ma... c'è comunque qualcosa che manca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Non so come descrivere questa sensazione. Nemmeno io riesco a metterla a fuoco. Posso solo continuare a dipingere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Non preoccuparti, fatti pure una risata. Dipingere così tanto deve avermi un po' frastornato. Mi sarei preso una pausa molto prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Il problema è che, appena chiudo gli occhi, vedo subito luccicare davanti a me quelli delle statue. È come se fossero vive e mi fissassero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "È per questo che sono venuto qui a riposare. Non dovrei vedere i loro occhi da qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Ah, sì, volevo chiederti... Perché non prendi tu questo dipinto? È il migliore che ho fatto finora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Ora, se non ti dispiace, devo riposare. Sono molto stanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Ma cosa manca ai miei quadri...? Cos'è che manca...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}