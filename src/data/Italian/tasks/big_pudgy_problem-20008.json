			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "Grazie! Mi hai salvato la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Quei Melmosi sono sbucati fuori dal nulla. Non pensavo sarebbero venuti da queste parti... Sono stato circondato prima ancora di capire cosa stesse succedendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Per favore, non dirlo a mio padre... Mi ha già assillato perché restassi a casa, dicendo che recentemente i Melmosi da queste parti sono diventati più aggressivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Sono rimasto bloccato a casa per giorni, a causa dei Melmosi che appaiono sempre più vicino alla città. Oggi sono riuscito a fuggire senza che se ne accorgesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Se non ti dispiace, potresti controllare se la costa è libera ora? E se non lo è, potresti liberarti dei Melmosi per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Certo, non ci vorrà molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Ottimo! Così mio padre non lo scoprirà mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Scusa, ma ho troppo da fare in questo momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "M-Ma... Non posso coinvolgere mio padre... Per favore, solo tu puoi aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
