			"dialogs": [
				{
					"id": 740510301,
					"content": "Fantastico! La Videokamera è intatta, e il filmato non è stato distrutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510328,
					"content": "Grazie agli Archon! Pensavo dovessimo ricominciare le riprese da capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510302,
					"content": "Perché state facendo le riprese qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Sembra che neanche voi siate di Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "È una lunga storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510304,
					"content": "In poche parole, noi tre siamo del Villaggio di Qiaoying, a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510305,
					"content": "La maggior parte dei nostri compaesani commerciano foglie di tè... a noi il tè non interessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510306,
					"content": "E quindi abbiamo cambiato professione e iniziato a filmare dei dokumentari al fine di promuovere i venditori di tè nel villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510307,
					"content": "In realtà, ci sono troppe persone nel settore del tè, e non potevamo competere con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Gli aiutanti esperti che avevamo al negozio ci hanno abbandonati uno dopo l'altro per lavorare da altre parti, per cui se avessimo continuato con il tè, saremmo morti di fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Dovete per forza... raccontarla in modo così deprimente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510310,
					"content": "Abbiamo fatto un bel po' di Mora filmando i Dokumentari sul tè nel villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510311,
					"content": "Ma di recente, altra gente del villaggio ha iniziato a produrre i propri filmati promozionali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Alcuni di questi includono anche parti di opera lirica. Uno spettacolo in pompa magna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "Allora è per questo motivo che siamo a Fontaine. Stiamo provando a cercare consigli dai registi esperti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510314,
					"content": "Oh, quindi siete qui per approfondire l'arte della cinepresa a Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Sì. Abbiamo trovato questo \"esperto delle luci\" chiamato Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510316,
					"content": "È davvero bravo nell'uso delle luci a scopo... com'è che era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Narrativo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Esatto! Utilizzare luci a scopo narrativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510319,
					"content": "Mettendo in pratica i consigli di Monsieur Geisert, filmeremo sicuramente i migliori Dokumentari dell'intero Villaggio di Qiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510320,
					"content": "Capo, lo scorso mese hai detto che stavamo per filmare i migliori Dokumentari di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Quando si fanno gli affari si deve dire addio ai sogni di gloria ed essere realisti... Ma che ne sai tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510322,
					"content": "#E comunque, grazie dell'aiuto, viaggiat{F#rice}{M#ore}. Ecco, questi Mora sono per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, sbrigatevi a montare tutto! Dobbiamo finire con le riprese campione, che andranno mostrate al Monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510324,
					"content": "Attenzione all'illuminazione! La Fotokamera deve essere messa verso la fonte di luce in questo modo. Dobbiamo essere in grado di catturare questa... illuminazione ad alta definizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510325,
					"content": "Quel libro l'avete letto anche voi, vero? La luce deve avere una sua consistenza... Capite di cosa parlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 740510326,
					"content": "Capo, il libro di Monsieur Geisert potremmo pure averlo letto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Ma con quello che abbiamo, non siamo in grado di filmare quella \"consistenza delle luci in alta definizione\" che richiedi, e non perché non vogliamo provarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
