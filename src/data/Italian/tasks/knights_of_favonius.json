			]
		},
		{
			"id": 35801,
			"completionStepIds": [
				35802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35802",
							"2"
						],
						"stepId": 35802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "#...e una volta finito, l{F#e}{M#i} ho portat{F#e}{M#i} subito qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "#Mondstadt vi dà il benvenuto, viaggiat{F#rici}{M#ori} del vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Sono Jean, Gran Maestra Reggente dei Cavalieri di Favonius. Lei è Lisa, la nostra attuale bibliotecaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "#Oh! Siete venut{F#e}{M#i} qui per aiutarci, tesorini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "Siete proprio adorabili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Purtroppo il vostro tempismo non è dei migliori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Terrore alato ha creato molto trambusto in questa regione, da quando è tornato attivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Per farla semplice, le linee geomantiche e la sfera elementale di Mondstadt ora sono come un gomitolo tra le zampe di un gattino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Per un mago, esistono poche situazioni peggiori di questa. Un'altra particella elementale e temo che la mia pelle inizierà a infiammarsi più che mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Se non fosse stato per questa interferenza, i Cavalieri di Favonius avrebbero trovato modi migliori per aiutarvi, anziché limitarsi ad affiggere dei manifesti di persona scomparsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "#Vi chiediamo solo di riposare a Mondstadt mentre vi aiutiamo a cercare {F#tuo fratello}{M#tua sorella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Voglio dare una mano anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Anche Paimon vuole contribuire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Bene. Se è così, ci serve un piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Ora che Terrore alato ha iniziato ad attaccare direttamente Mondstadt, potremmo avere una possibilità di risolvere il problema alla radice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Le magie di localizzazione di Lisa hanno svelato le fonti del potere di Terrore alato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Si trovano nelle rovine abbandonate dei <color=#00E1FFFF>Templi dei Quattro Venti</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "Terrore alato riesce a evocare tempeste così forti attingendo al potere di quei luoghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Il nostro obiettivo è eliminare <color=#00E1FFFF>tre</color> dei quattro templi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Sappiamo tutti perché solo tre, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Paimon non lo sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Sarà una cosa del posto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Cavalieri di Favonius, il tempo non ci assiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "La tempesta infuria, non ha senso mantenere le posizioni difensive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "D'accordo: prendiamo l'iniziativa e diamoci da fare prima che la situazione peggiori ulteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Chiederemo più tardi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Allora lasciamo a te la questione. Dov'è la locanda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Ehi, non è tempo di essere pigri, dobbiamo partecipare anche noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}