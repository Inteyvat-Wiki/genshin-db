			"dialogs": [
				{
					"id": 3572401,
					"content": "È il <color=#00E1FFFF>quartier generale dei Cavalieri di Favonius</color>. Diamo un'occhiata all'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
