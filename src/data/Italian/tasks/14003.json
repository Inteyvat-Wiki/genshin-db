			"dialogs": [
				{
					"id": 140030101,
					"content": "Mi spiace, Charlotte, io e mia sorella siamo molto impegnati, quest'oggi. Temo che dovremo declinare la tua intervista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Oh, ti prego, Lyney! Non ci vorrà molto! Te lo chiedo per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Eh? Che succede qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Ho passato tutta la notte a scrivere il mio articolo sulla Donnola fantasma, doveva andare in stampa stamattina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Ma poi all'alba mi è giunta voce che Jemma, la fidanzata di César, si è costituita e ha confessato alla Garde di essere sempre stata lei la vera Donnola fantasma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "Che rapidità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Ahem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Troppo tardi, fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Ohohoh! \"Che rapidità\", hai detto? Sembra ci siano un bel po' di cose che devo sapere! Prego, ragguagliatemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Eheh... Ops!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Ah-ha! Il mio istinto non sbaglia mai: mi state nascondendo qualcosa, lo so! Il fatto che Jemma si sia costituita c'entra qualcosa con l'esibizione di Lyney di ieri sera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Magari l'aver visto il numero ad alta quota le ha fatto ricordare il tempo trascorso con César, e non è più riuscita a ignorare la voce della sua coscienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Ah, d'accordo, quindi... No no no, aspetta, dev'esserci dell'altro! Se fosse bastato così poco per farle cambiare idea, perché avrebbe aspettato addirittura dieci anni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Aah, ecco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(Lo spirito giornalistico di Charlotte si sta infervorando. Dobbiamo distrarla in un modo o nell'altro...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Ah, ma certo! Tu e Jemma siete letteralmente spariti dopo lo spettacolo... Cosa c'è stato tra voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Domanda a bruciapelo! Dove siete andati tutti quanti dopo l'esibizione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "#Oh, siamo andat{F#e}{M#i} al cimitero e Lyney ci ha mostrato un trucco di magia, appositamente per noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "In realtà, questo ha fatto tornare in mente una cosa a Paimon. Indovina? Lyney ha iniziato a usare le rose arcobaleno nei suoi trucchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "*tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "...Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "Sono piuttosto sicura di non aver mai ricevuto una rosa arcobaleno da parte tua. Significa forse che loro sono più importanti della tua sorellina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "No! È solo che, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "#U-Un momento... Che sta succedendo? Paimon ha di nuovo parlato troppo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#L'atmosfera si sta facendo strana... Che cosa facciamo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*sospira* A quanto sembra, quest'intervista non era da fare. Beh, fa nulla, sarà per la prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Scusate se ho insistito, ma quando c'è uno scoop del genere non posso di certo ignorarlo! La notizia di Jemma ha già fatto scalpore, e nulla potrà ostacolarmi dall'andare in fondo alla cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "A quanto pare, una delle cose che ha detto alla Garde è che il suo ultimo desiderio era \"rivedere Lorenzo per l'ultima volta\". *sospira* È chiaro che c'è una fitta rete di relazioni complicate... Non potete biasimare la mia curiosità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Vabbè, vi lascio continuare in pace la vostra conversazione. Ci vediamo un'altra volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Ehm, senti, Lynette... Paimon non voleva mica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Tranquilla, non me la sono presa. Stavo solo cercando di distrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Oh, davvero? Meno male. Hai fatto prendere un colpo a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Fiuuu, siamo in due, Paimon... Beh, almeno ha avuto l'effetto sperato, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "...Prendetevi cura della rosa arcobaleno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Mi dispiacerebbe molto, se la perdeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}