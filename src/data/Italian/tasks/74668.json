			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Eh? La luce ha appena iniziato a diffondersi da quella Statua dei Sette...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Strano forte! È mai successa una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "È normale che una Statua dei Sette risplenda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, tu non ti sei sentit{F#a}{M#o} stran{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Eh? L'acqua... L'acqua mi sta parlando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Col cavolo che Paimon ci crede! Ahah, se riesci a fare battute del genere, vuol dire che stai bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Eppure, dopo che si è illuminata così, l'aria sembra molto più umida. Forse per via di tutta quell'energia di Hydro che è stata rilasciata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Eheh, Paimon ha sentito dire che a Fontaine, se sai usare correttamente l'energia elementale, puoi perfino respirare sott'acqua! Magari puoi perfino trovare dei tesori sommersi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Paimon lascia a te andare a fare immersioni alla ricerca di tesori. Paimon... se ne resterà a riva ad aspettarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "#Mi sentirò sol{F#a}{M#o} ad andare sott'acqua senza di te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Eeeeeh? Ma... Ma... L'acqua fa paura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "E se Paimon venisse portata via dalla corrente e finisse in un vortice e per il giramento di testa non riuscisse a volare via qualsiasi cosa facesse...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Proprio come prima che Paimon ti incontrasse, a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Ti pescherei fuori di nuovo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "...Davvero? A-Allora forse Paimon può provare a venire sott'acqua con te. Umpf! Farai meglio a non rimangiarti la parola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Potresti provare a fare qualcosa per una volta, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Wow, mi sento come se stessi usando le branchie per respirare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Buon per te! Vediamo se prima ti crescono le branchie! Umpf! Sembra che ti senta parecchio bene! Paimon non riesce a credere che Paimon si stesse preoccupando per te, fino a poco fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Un rumore di acqua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Di sicuro è la nazione dell'Archon di Hydro! Anche le Statue dei Sette sono delle fontane... SÌ, ESATTO! Quella luce non era affatto normale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}