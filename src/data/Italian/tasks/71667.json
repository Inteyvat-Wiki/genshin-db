			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Ah, siete voi! Sono eoni che vi aspetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Hai fatto amicizia con il Regisreptus di Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Ah, non ne parliamo. Hai \"negoziato\" una tregua momentanea. Estremamente momentanea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "Non appena si è ripreso, ha cercato nuovamente di colpirmi! Sai che c'è? Avevi ragione, con questa creatura è impossibile essere amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Ma il suo frutto è comunque molto buono... Sa di Pyro. Scommetto che ai miei amici di Natlan piacerà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Che sapore ha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Vuoi assaggiare? Se ti va, posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Ehm, sì, no, no, grazie! Comunque... Ora pensi di passare a un Geosauro primordiale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Esatto. Sono convinto che con un Geosauro ci riuscirò. Dopotutto, i Geosauri primordiali sono un po' come i Tepetlisauri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Se viaggi da Sumeru a Natlan, come ho fatto io, sappi che saranno una delle prime cose che vedrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Sì, sì, ok. Paimon comunque non nutre grandi speranze nemmeno con il Geosauro... Ma perché non provare con un cucciolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "...Perché non hanno la pancia tonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Eeeh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "I Cuccioli di Geosauro non hanno la pancia tonda. Con tutto quel loro rotolare qui e là a incredibile velocità, non corrono di sicuro il rischio d'immagazzinare del grasso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*sospira* Ma il motivo principale è comunque che non fa un grande... effetto. Cosa c'è di speciale in un Cucciolo per chi vive assieme ai Saurici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Con un Geosauro primordiale, invece, è tutta un'altra storia. Anche solo ascoltarne il racconto vale tutto il tempo che serve. E comunque, un potente protagonista deve avere un degno avversario, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Bando alle ciance! Il Geosauro primordiale ci aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Signorsì, signore. Andiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Ho altre cose da fare. Ci vediamo fra un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Nessun problema, ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}