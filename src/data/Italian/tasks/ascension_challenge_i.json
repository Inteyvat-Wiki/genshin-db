				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "Miao! (Favoloso! Congratulazioni per il completamento della sfida d'ascensione. Adesso sei un giocatore avanzato!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660202,
					"content": "Miao? (Ci vuole solo una sfida per diventare giocatori avanzati? Beh, dato che la maggior parte delle persone giocano solo per divertimento, non la prendono molto seriamente...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660203,
					"content": "(In altre parole, solo poche persone hanno preso il gioco sul serio, ma anche se fosse solo per divertirsi, vale la pena impegnarsi un po' di più.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660204,
					"content": "Miao! (Ah, certo! Ora che hai il mio riconoscimento, puoi anche partecipare ai giochi preparati dagli altri tipi della taverna. Mmh... dovrebbe piacergli la tua compagnia.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660205,
					"content": "Gli altri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Miao. (Capito bene. Ovviamente, proprio come me, loro sono gatti in questa taverna, ma non sono da prendere sottogamba.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660207,
					"content": "Miao... (Se arrivasse il momento, Shuyun sarebbe in grado di tener loro le carte. Va bene. Per onorare la tradizione, c'è un'altra cosa che ho da dire!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660208,
					"content": "#({NICKNAME}, che il divertimento sia con te nel mondo di Invokazione del genio!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
