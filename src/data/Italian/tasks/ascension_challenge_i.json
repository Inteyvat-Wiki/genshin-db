				{
					"id": 706660101,
					"content": "Sono qui per la sfida d'ascensione!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "Miao... (Mmh? Qui per la sfida d'ascensione? Capisco... Infatti la sfida fa per te. Bene...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660103,
					"content": "\"Chiederò a Shuyun di preparare la gara per te subito. Fai attenzione però!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
		{
			"id": 7066602,
			"completionStepIds": [
				7066603
			],
