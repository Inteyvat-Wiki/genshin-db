			"dialogs": [
				{
					"id": 200120201,
					"content": "#G-grazie, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120202,
					"content": "*sospira* Prima i mostri, e ora questi ostacoli... Casa mia è già abbastanza caotica, e io pensavo addirittura che questa sarebbe stata un'opportunità per allontanarmene per un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120203,
					"content": "Scusami, ma potresti risolvere la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120204,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Grazie! Spero che i miei due ragazzi diventino gentili come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120205,
					"content": "Ho altre cose da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Dai, ti prego... Ti prometto che non ci vorrà molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana spaventata"
				}
			]
		},
