			},
			"dialogs": [
				{
					"id": 200120301,
					"content": "#G-Grazie davvero, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120302,
					"content": "Ma ti prego, non dire a nessuno che mi sono cacciata nei guai. Se lo scopre, mio marito mi darà una bella strigliata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120303,
					"content": "Non guardarmi così... Aspetta di sposarti, poi vedrai. Una passeggiata solitaria è un lusso enorme quando vivi con qualcuno. Devi approfittarne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Myrana spaventata"
				},
				{
					"id": 200120304,
					"content": "Ecco, tieni. Li ho raccolti mentre passeggiavo. Costa molto di meno cucinare da soli, piuttosto che mangiare al Buon Cacciatore! Devi risparmiare se vuoi tirare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana spaventata"
				}
			]
		}
