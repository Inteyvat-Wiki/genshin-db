			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Mmm... Le bevande alla Coda di Gatto non sono per niente male... proprio per niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Alla Coda di Gatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#Oh, ehi! Sei tu, viaggiat{F#rice}{M#ore} ...Eh? Non hai mai sentito parlare della Coda di Gatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "#A giudicare dalla tua espressione, sembra che tu non conosca davvero il posto. Ah, cosa ti sei pers{F#a}{M#o}....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "La Coda di Gatto è rinomata per le sue bevande speciali. Sto parlando di cocktail che sicuramente non hai mai assaggiato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "E, proprio come suggerisce il nome, ospita un sacco di simpatici gattini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Il tempo inizia semplicemente a scivolare via, quando ti godi una deliziosa bevanda speciale e sei circondato da un mucchio di teneri micetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "Sarà ancora aperta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Ehm, non mi sembra che tu possa bere, alla tua età.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Beh, non ci dovrebbero essere problemi, perché Diona sarà lì. È la migliore barista di tutta Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Dovrebbe essere facile per lei prepararti una bevanda analcolica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Ah, per non parlare del fatto che Diona è piuttosto carina... proprio come una gattina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*singhiozza* Oh, no... L'ho detto ad alta voce? Ah, per favore non dirle che l'ho detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Ad ogni modo, se vuoi dare un'occhiata alla Coda di Gatto, l'ingresso è proprio sul retro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Andrò... *singhiozza* laggiù e mi calmerò un po', non credo di poter reggere un quinto giro... Ho già bevuto troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Mi piacerebbe visitarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}