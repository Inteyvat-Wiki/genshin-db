			"dialogs": [
				{
					"id": 200380201,
					"content": "Hai finito di spolverare le Statue dei Sette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380202
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380203
					]
				},
				{
					"id": 200380203,
					"content": "Capisco. Beh, non c'è fretta. Prenditi il tuo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
