				{
					"id": 200380301,
					"content": "Hai finito di spolverare le Statue dei Sette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "#Che gli dèi ti benedicano, {F#mia cara}{M#mio caro}! E che Barbatos sia con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380304,
					"content": "Tieni, è il mio regalo per te. Potrei richiedere ancora la tua assistenza in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
