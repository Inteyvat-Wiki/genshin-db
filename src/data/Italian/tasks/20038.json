				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "*sospira* Chissà in che stato saranno le Statue dei Sette, ormai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "Le Statue dei Sette? Cosa è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Lascia che ti spieghi... In passato, andavo ogni settimana a pregare a una Statua dei Sette e, mentre ero lì, ne approfittavo per togliere la polvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "Devo ringraziare gli Archon per tutte le benedizioni nella mia vita... Pulire le statue era il mio modo di ricambiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "Da quando ho avuto Lily, però, non ho quasi mai occasione di uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "Le statue saranno sporche, senza nessuno che le pulisce da così tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "So che potrebbe sembrare che io stia cercando di evitare le responsabilità, ma... credi di poter spolverare le Statue dei Sette per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Ma certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Grazie davvero! Che l'Archon di Anemo sia con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "Un'altra cosa. Le Statue dei Sette contengono il potere degli Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "La polvere che le copre non si può ripulire normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "Ma tu hai abilità elementali, dovrebbe essere facile per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "A differenza mia... A me ci vuole un giorno intero per ripulire un'unica statua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Ci avrà già pensato il vento, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Barbatos e gli altri venti che comanda avranno troppe altre cose a cui pensare per occuparsi di questioni del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "In ogni caso, non possiamo contare sugli Archon perché si occupino di tutto mentre noi ci impigriamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Collaboriamo per alleggerire almeno un po' il carico del Supremo Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
