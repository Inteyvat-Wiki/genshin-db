			"trigger": {
				"objectNames": [
					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "#Sembra che tu sia di fretta, amic{F#a}{M#o} mi{F#a}{M#o}. Cosa ti turba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Molte cose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "#Ah... Sì, vedo che sei stanc{F#a}{M#o} e che hai poco tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "#Devi essere preoccupat{F#a}{M#o} per qualcosa che deve essere risolto al più presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "Invece di correre a destra e a manca, vorrei invitarti a gustare un piatto delizioso con me, se per te va bene aspettare giusto qualche minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "La fretta fa parte della vita, è vero... Ma come diciamo spesso: anche un fiume impetuoso a volte ha bisogno di scorrere pacificamente in un placido ruscello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "Bisogna concedersi una piccola pausa di tanto in tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Che ne dici di mangiare una zuppa di fagioli alla menta con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Non devi darmi nessun Mora in cambio. Ti chiedo solo di aiutarmi a trovare un rametto di menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "Ah, comunque, non perdere troppo tempo a cercare il rametto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "Ricorda: stai cercando un semplice rametto di menta, non sei in cerca di guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "In realtà sto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Oh, molto bene, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Tuttavia, acceleri il passo. Forse stai tentando di risolvere un problema o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Beh, non so quale sia il problema che stai tentando di risolvere, ma ho una proposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
