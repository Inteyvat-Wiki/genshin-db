					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "Non c'è di che. Buon appetito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100306,
					"content": "Mangiare per me significa lasciarmi alle spalle per un po' tutto il mio estenuante lavoro e le mie ricerche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100307,
					"content": "Lascio che la mia mente scorra pacificamente in quel placido ruscello... è così che mi rilasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100308,
					"content": "Bene, goditi appieno questo pasto. Spero che riesca a tranquillizzare anche te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
