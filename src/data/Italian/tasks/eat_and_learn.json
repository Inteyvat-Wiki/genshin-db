				{
					"id": 230100301,
					"content": "Questo rametto di menta è perfetto! Aspetta qui giusto un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100302,
					"content": "Gli ingredienti sono pronti e Jafar inizia a cucinare...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "Ecco a te la zuppa di fagioli alla menta, preparata con gli ingredienti che mi hai portato. Serviti pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
