					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "Ah, e comunque, non ha importanza il modo in cui la trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Ricorda solo che stai cercando un pezzo di carne cruda. Non pensare che sia qualcosa di complicato, perché non è così.",
