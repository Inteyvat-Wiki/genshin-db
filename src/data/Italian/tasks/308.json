			"dialogs": [
				{
					"id": 3081301,
					"content": "Persino qui fuori il disturbo del flusso elementale all'interno mi mette a disagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Riportiamo questo tempio al suo stato normale... non sopporto più questa tensione.",
