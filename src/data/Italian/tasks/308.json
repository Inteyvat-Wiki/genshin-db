			"dialogs": [
				{
					"id": 3081101,
					"content": "Ehi, tesorino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081102,
					"content": "Vuoi aiutarmi anche tu? Molto gentile da parte tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081103,
					"content": "Se hai bisogno di una mano, passa pure da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081104,
					"content": "Di cosa si occupa una bibliotecaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Ottima domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "In breve, si occupa di cose per cui non serve forza fisica... o intelligenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "Quindi... cosa fai, in sostanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
					"content": "Dovresti fare lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081108,
					"content": "Perché una bibliotecaria dovrebbe addentrarsi tra le rovine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Mmh... Ottima domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081110,
					"content": "Beh, perché Jean si fida di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Lisa"
				}
			]
		},
