					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Siamo di nuovo in questo posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "L'ultima volta che ci sono venuto, secondo la durata della vita umana, dev'essere stato... molte, molte, molte... generazioni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Sembra che siamo stati tutti risucchiati di nuovo nell'Intervallo apatico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "E come facciamo a uscire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Il modo tradizionale è attraverso la meditazione: imparare a padroneggiare la propria mente e i propri pensieri, per poi lasciare andare ogni desiderio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "In breve, dobbiamo mantenere uno stato di vuoto totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "A dirlo sembra semplice. Ma a seconda della natura di una persona e della forza dei suoi desideri, può richiedere da pochi anni a diversi secoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Per qualcuno come te, che porta sulle spalle il destino del mondo, i tuoi desideri probabilmente non possono essere accantonati... né dovrebbero esserlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Cosa facciamo, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Troviamo Zeitlind e decidiamo il da farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Cos'hai raccolto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Aspetta, anche Dex è stato trascinato all'interno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "In tal caso, potrebbe ancora esserci la possibilità di ribaltare la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Dato che anche Dex è un Osservatore, potrebbe essere in grado di utilizzare il potere contenuto in questi frammenti per aprire un varco con la forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Dovremo dare un nome a questi frammenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Ho sentito parlare di queste bare elaborate. Vennero allestite da una delle sorelle della sacerdotessa del tempio... Credo siano chiamate Bare di Maranasati, se non ricordo male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "In tal caso, chiamiamo i Frammenti di Necromusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
}