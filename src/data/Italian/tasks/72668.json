			"dialogs": [
				{
					"id": 726680101,
					"content": "Fantastico. In un certo senso, si sono realizzati i desideri di tutti coloro che hanno inseguito il Leviatano lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Hai finito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Vedi? Non pensi che Jiawei abbia trovato una moglie benestante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuck è pure diventato un autore famoso grazie al suo libro sul Leviatano lunare, sebbene i suoi contenuti siano errati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji è diventata la pescatrice più celebre d'Inazuma e ha fatto ciò che suo padre non era riuscito a fare... Catturare il Leviatano lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Perciò Paimon sente che anche il desiderio di {NICKNAME} si realizzerà! Ihih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Cos'hai desiderato, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Non si può dire! No! Se Paimon lo dice ad alta voce, non si realizzerà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "Il Leviatano lunare non sarà così taccagno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Mmh... Ascolta bene! Perché Paimon lo dirà una sola volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "Il desiderio di Paimon è che il tuo desiderio si realizzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Non ho sentito bene, cosa hai detto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Tsk, Paimon non ripete due volte! Paimon se ne va a compare delle caramelle... Lalala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
