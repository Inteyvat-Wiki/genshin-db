			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Se solo potessi piantare altri fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "#Oh, ciao! Piacere di conoscerti... Anche tu sei un{F#'}{M# }abitante di ritorno? Perdonami, temo di non averti mai vist{F#a}{M#o} prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "#Un{F#'}{M# }abitante \"di ritorno\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Proprio così. In passato, gli abitanti di Tatarasuna furono evacuati per via dell'incidente alla Fornace Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Tempo fa sentii dire che la situazione alla Fornace Mikage era rientrata e che Tatarasuna era di nuovo al sicuro, così feci richiesta per tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Ottenuto la via libera, feci i bagagli e tornai qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Però... a parte me, non sembra che molti altri vogliano tornare a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Che ci vuoi fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "In effetti, l'incidente alla Fornace Mikage fu piuttosto grave. La paura che possa accadere nuovamente è reale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "E tu non hai paura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Certo, sì... Però quando resto lontana da casa troppo a lungo, mi sale una nostalgia incredibile... Non riuscivo a non preoccuparmi per i miei fiori, eheh! Quindi ho deciso di tornare, nonostante tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Purtroppo, i fiori che avevo piantato qui in precedenza sono tutti appassiti. È un peccato che non si trovino altri semi, al momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Questo luogo è perfetto per far crescere i fiori. Puoi piantare i semi che preferisci, qualunque bocciolo qui cresce in modo rigoglioso e in men che non si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Ho anche coltivato fiori d'oltreoceano. Lampaduline, Asterie del vento e denti di leone di Mondstadt, ma anche Fiordiseta di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Di notte, le Lampaduline sono bellissime. Vanno piantate all'ombra, richiedono tanta acqua e bisogna tagliare le punte delle foglie morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Dicono che le Asterie del vento crescano bene dove c'è vento, che a Inazuma non manca affatto, però temo non sia forte come quello di Mondstadt... Infatti gli faccio spesso vento con un ventaglio! Non sono certa che serva davvero, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "I denti di leone non sono impegnativi, invece: badano perfettamente a loro stessi... e anche troppo. Se non li contieni, infatti, crescono a dismisura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Immagino! Comunque sia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "I Fiordiseta di Liyue, al contrario, danno un sacco da fare. Gli Onikabuto amano strisciare nei loro petali, e io devo sfrattarli uno per uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Ho anche provato a coltivare un po' di Qingxin, ma senza fortuna. Quelli che ho piantato non sono cresciuti per niente o sono appassiti in pochissimo tempo. Mm... Mi domando se esista una terra magica, dove i fiori di tutti i tipi possano crescere senza problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Chi lo sa? Adesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Oh, sai che a Liyue esiste un tipo di fiore chiamato \"Campaviola\"? È difficile da trovare, ho chiesto aiuto a un po' di persone, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Oh! Scusa! Quando mi metto a parlare di fiori finisce sempre così, perdonami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Sai un sacco di cose sui fiori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Ma no, è solo un hobby, eheheh... Tra l'altro al momento non ho semi, quindi non posso coltivare proprio nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Non vivevo qui, no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Oh, davvero? Pensavo di aver trovato qualcun altro che condividesse il mio stesso desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Gli abitanti di Tatarasuna vennero evacuati per via dell'incidente alla Fornace Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Tempo fa sentii dire che la situazione alla Fornace Mikage era rientrata e che Tatarasuna era di nuovo al sicuro, così feci richiesta per tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Ottenuto la via libera, feci i bagagli e tornai qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250114,
					"content": "A parte me, non sembra che molti altri vogliano tornare a casa...",
					"roleType": "TALK_ROLE_NPC",
