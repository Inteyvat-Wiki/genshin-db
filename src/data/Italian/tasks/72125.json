			"dialogs": [
				{
					"id": 721250301,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Mi chiedevo dove trovare dei semi di fiori per poterli ripiantare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "L'isola era stata evacuata in seguito all'incidente nella Fornace Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Una volta scoperto che la situazione era rientrata, sono tornata subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250305,
					"content": "Però tutti i fiori che avevo piantato qui sono appassiti e non trovo altri semi da nessuna parte. Che peccato... Questo posto è perfetto per coltivarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
