				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Questi semi di fiori ti servono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Come? Oh, wow! Ma certo, vanno benissimo! Con questi riuscirò sicuramente a far crescere un sacco di fiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Però, ehm... Aspetta, per favore... Devo per forza darti qualcosa in cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Ecco qua. Grazie infinite per i semi! Torna a farmi visita in futuro, sono sicura che troverai un mare di fiori ad attenderti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
