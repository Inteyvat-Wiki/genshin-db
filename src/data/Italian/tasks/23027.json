			},
			"dialogs": [
				{
					"id": 230271101,
					"content": "#Sei tornat{F#a}{M#o}! Come stanno le radici dell'Albero divino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Descrivi le condizioni delle radici a Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "...Oh, se delle forme di vita si radunano lì, allora l'area dovrebbe ancora essere piena di vitalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "Ciò significa che le radici dell'Albero divino dovrebbero essere in grado di crescere costantemente senza alcun problema, per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "La mia unica preoccupazione... è la possibile eutrofizzazione dei corpi d'acqua circostanti, che potrebbe alimentare altri Miconoidi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "A ogni modo, ecco il tuo compenso. Grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "Sarà meglio far controllare la concentrazione degli elementi nelle vicinanze a Ladep e Pharez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
}