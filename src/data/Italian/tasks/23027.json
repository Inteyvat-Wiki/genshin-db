			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Sembra che abbia bisogno di cure adeguate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#Tu sei... Ehm. A giudicare dal tuo aspetto, devi essere {F#una}{M#un} viaggiat{F#rice}{M#ore}, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Sono Yasmin, una studentessa dell'Amurta. Sono qui per studiare l'Albero divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Questo Albero divino ha vissuto più anni del numero di chicchi di riso usati in tutti i pilaf di Porto Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Inoltre sostiene l'Akademiya. Si dice che sia importante quanto le verdure sul fondo di un piatto di pollo tandoori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "Ma che razza di metafora è mai questa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Se dovesse succedergli qualcosa di spiacevole, anche l'intera Città di Sumeru dovrebbe affrontare dei terribili disastri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Potrebbe venire tormentata dai parassiti, o delle locuste più grandi di un tetto potrebbero fuoriuscire dall'interno dell'albero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Oppure i rami potrebbero iniziare ad agitarsi freneticamente, e le radici emergere a fiotti dalla terra, distruggendo ogni casa lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Oppure l'Albero divino potrebbe appassire così velocemente che il suo fusto cadrebbe su metà Città di Sumeru, annientando qualsiasi cosa sottostante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "Q-Queste cose non succederanno davvero, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Oh, certo che no! Perlomeno, finora è andato tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Ma d'altro canto, non è che le bestie fungine ti avvisino prima di attaccarti mentre raccogli funghi nella foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "Per questo sono qui: per osservare l'albero e prepararmi all'eventualità di una sciagura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Ma come potete ben vedere, sebbene i miei pensieri siano lesti come un Uccello del crepuscolo, la mia forza è pari a quella di un Astrofungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "#Quindi, viaggiat{F#rice}{M#ore}, potresti aiutarmi a registrare le condizioni delle radici dell'Albero divino in alcuni posti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Di solito, ingaggio degli avventurieri come scorta, ma al momento sembra non ci siano persone disponibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Voi ricercatori parlate tutti così...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Eh? Ti riferisci alle metafore che uso? Mi dispiace. È soltanto il mio modo di esprimermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Me ne hanno parlato anche alcune persone all'Akademiya, ma ci metterò del tempo a cambiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Conto su di te questa volta. Ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Ne sai qualcosa, eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Già, è proprio un grande albero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
