			"dialogs": [
				{
					"id": 750711321,
					"content": "Hai sconfitto il nemico e aperto la gabbia che teneva imprigionata la piccola bestia da soma. Quest'ultima ti salta addosso emettendo un verso felice.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Wow... Fiuuu, è finita. Che emozione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Shhh...! Guarda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*clic*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Wow, vanno proprio d'accordo... Paimon pensava che le bestie da soma avrebbero finito per essere mangiate o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Eheh, suvvia. I Tepetlisauri sembrano feroci, ma in realtà sono anime gentili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Bene, la foto è fatta, ecco la tua copia. Ah, giusto: ecco il compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*sospira* Pensavo che avremmo potuto immortalare un momento personale tra un cucciolo di Tepetlisauro e un adulto, ma la bestia da soma ne ha approfittato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Eheh, dai, le bestie da soma non sono così fastidiose. Paimon è sicura che anche tu lo pensi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Beh, non importa cosa penso io... L'opinione che conta è quella del comitato di valutazione della fotografia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Eppure... potrebbe essere troppo pericoloso per la nostra piccola bestia da soma vagare per i dintorni sconosciuti di Natlan. E io ho bisogno di un partner che mi aiuti a trasportare alcune cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Immagino che dovrò farla venire con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "E il suo proprietario originale, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Umpf! È colpa sua per aver lasciato quella bestiolina in un posto così pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Comunque, basta parlare di questo! Gallerie fotografiche di Fontaine, sto arrivando! Ahah... Spero che verrete anche voi a visitarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Chiedo scusa, ma ora devo lasciare la nazione. Addio, {NICKNAME}, Paimon! Addio, mio piccolo amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711319,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711320,
					"content": "#E... prendete questo! Un ricordo, così non vi dimenticherete di me, {F#piccoline}{M#piccolini}!",
