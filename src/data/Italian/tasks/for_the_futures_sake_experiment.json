			"trigger": {
				"objectNames": [
					"Frejus",
					"Chenee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "I dati indicano che questa invenzione è stata un successo. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Sì, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "Visto? Ve l'avevo detto che sarebbe andata bene! Con la tua genialità in gioco, Frejus, realizzare questo cannone telecomandato è stato un gioco da ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "Suppongo di sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "In tal caso, mettiamoci al lavoro sul prossimo fantastico gadget... e ho già una super idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "Che ne pensi di... un dirigibile in grado di esplorare il cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "O un megatrapano in grado di penetrare il sottosuolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Sembra che stia cercando di complicarsi la vita di proposito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Sembra una bella impresa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Voglio dire, sei tu che hai rifiutato tre volte l'offerta dell'Istituto. Sono sicura che sapresti creare cose che nemmeno loro sono in grado di realizzare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "Certo. Non ho dubbi che sarà complicato, ma nemmeno impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "*sospira* Sai cosa ti dico? Non voglio più quegli aggeggi. Volare in cielo o scavare sottoterra sembra una vera noia. Lassù fa freddo e laggiù si soffoca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "Mi trovi d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "In tal caso, potresti creare qualcosa che potremmo usare quotidianamente? Ah, giusto! Mi piace tanto dormire fino a tardi, quindi... Potresti crearmi un fornello automatico in grado di cucinare da solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Beh, questo sembra fattibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "I suoi suggerimenti precedenti erano intenzionalmente impossibili da realizzare, credo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Bene, fammi pensare a come potrei progettarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Ottimo! La prendo come una promessa... E, se si dimostrerà impossibile, in futuro ti toccherà prepararmi la colazione, eh, Frejus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "Cosa? Che razza di richiesta è? In ogni caso, non preoccuparti, sono sicuro che una piccola invenzione sia alla mia portata. Dopotutto, sono un \"genio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
		},
