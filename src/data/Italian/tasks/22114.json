			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Hai verificato i numeri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Bene, e io ho quasi ultimato i preparativi. Ricontrollerò quelle merci a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Quasi dimenticavo! Ecco, per il tuo disturbo. Fra poco andrò a controllare le merci. Stavolta non permetterò che qualcosa vada storto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Non stavi scrivendo una poesia, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Assolutamente no! So bene quali sono le mie priorità. Non è questo il momento di pensare alla poesia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "Non posso più scrivere poesie a lavoro, devo concentrarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Alla fine, il lavoro viene prima di tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Lo so, è che fare sempre le stesse cose ogni giorno... anno dopo anno... Alla fine ci si annoia, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "E poi si tratta di un lavoretto di poca importanza, no? Non conta un granché, nessuno ci fa caso, quindi dopo un po' ti ritrovi a fantasticare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "An il Nervoso ripete sempre cose tipo \"ogni lavoro è importante\" e \"ogni lavoro è cruciale\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Se così fosse, però, allora perché tutti sono così selettivi quando si parla del lavoro che vogliono fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Devi assumerti la responsabilità del tuo lavoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Ti chiedo aiuto solo occasionalmente. La maggior parte delle volte mi arrangio da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Dovrei assumermi la responsabilità per il mio operato, lo so. Il fatto è che più diventa impegnativo, più mi scopro svogliata. È il motivo per cui ogni tanto ti chiedo una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Se invece non sono occupata, mi viene istintivo trovarmi qualcosa da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Ma in fondo, tu non hai lavorato neppure un giorno in vita tua, giusto? Che te lo racconto a fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Perché ti interessa tanto scrivere poesie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Come? Fammi pensare... Beh, per quale motivo una persona lavora, secondo te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Per come la vedo io, \"lavorare tanto per continuare a lavorare\" è un po' troppo noioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Come dire... Ognuno di noi ha diritto a un sogno nel cassetto, giusto? Qualcosa di totalmente distinto dalla routine lavorativa quotidiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "In questo modo, anche nei momenti in cui la stanchezza ti fa dire \"sto per scoppiare\", riesci a rifugiarti in un mondo tutto tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "#È solo il mio modo di vedere le cose, ovviamente. Non so cosa possa pensarne un{M# }{F#'}avventurier{M#e}{F#a} come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Gli avventurieri vivono solo per i propri sogni. Quando mi fermo a pensarci, sento il bisogno di un'occupazione \"normale\", che mi aiuti a tenere i piedi per terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Eppure... Eheheh! Credimi, i sogni restano sogni. Mentre lavori, è necessario tenere i piedi ben piantati a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
