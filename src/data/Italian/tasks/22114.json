			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"An il Nervoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Sono come un bottaio senza le abilità manuali né i materiali per realizzare la sua opera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140702,
					"content": "Un bottaio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Sì, per dire che sono come un artigiano che ripara botti e a cui manca una sola doga di legno per completare un bel barile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140704,
					"content": "Ma la doga che ha in mano è di scarsa qualità. È un po' corta, e inserendola nel barile ne diminuirebbe la capienza complessiva, e di parecchio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140705,
					"content": "Eppure, se cercasse un'altra doga, non saprebbe quanto ci metterebbe a completare il barile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140706,
					"content": "Visto che il termine ultimo per la sua consegna si avvicina, dovrà scegliere il male minore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140707,
					"content": "Chissà quanti altri \"bottai\" come me ci sono al mondo, costretti a fronteggiare lo stesso dilemma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140708,
					"content": "Possiamo parlare del lavoro di Linling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "Del suo lavoro? Sì, mi pare che in passato abbia chiesto il tuo aiuto per contare le imbarcazioni, vero? Lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140710,
					"content": "Che faccia sorpresa! Per me contano i risultati, non il modo in cui li ottiene. Non sono così pignolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140711,
					"content": "Inoltre, le ricompense che ti offre sono interamente a carico suo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140712,
					"content": "Per quanto riguarda la consegna di dati non revisionati da lei, invece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140713,
					"content": "Si tratta di un comportamento irresponsabile che mi ha fatto infuriare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An il Nervoso"
				}
			]
		},
