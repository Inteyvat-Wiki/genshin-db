			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Stavolta per me è davvero finita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*singhiozza* An il Nervoso dice che forse non sono tagliata per questo tipo di lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Adesso mi licenzierà? Cosa posso fare? Io... Io m'impegno sempre duramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Eh? Così all'improvviso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Beh, non ti avevo chiesto aiuto in precedenza per contare le imbarcazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Mi sono fidata di te, quindi non ho ricontrollato i dati che mi hai fornito e li ho consegnati direttamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Tante cifre sono risultate sbagliate... An il Nervoso ha davvero perso le staffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Gli parleresti al posto mio? D-D'ora in poi sarò ancora più scrupolosa e non chiederò più il tuo aiuto, te lo garantisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Io non ho il coraggio di affrontarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Il conteggio delle imbarcazioni era sbagliato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Sì! Non ti avevo chiesto di aiutarmi a contarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Mi sono fidata di te e non ho ricontrollato i dati. Li ho consegnati direttamente e... in gran parte sono risultati sbagliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Alcuni calcoli li ho fatti di persona, però, non ho delegato a te tutto il lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Di conseguenza, una volta messi insieme tutti i conti, non sapevo quali fossero quelli sbagliati. An il Nervoso ha perso le staffe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Parlagli al posto mio, per favore! D-D'ora in poi sarò ancora più scrupolosa e non chiederò più il tuo aiuto, te lo garantisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Io non ho il coraggio di affrontarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211402,
			"completionStepIds": [
				2211402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
