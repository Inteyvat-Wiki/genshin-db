			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"An il Nervoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*sospira* Davvero, stavolta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140202,
					"content": "Possiamo parlare di Linling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Mmm? Vuoi parlare di Linling? Beh, come dire... Non è proprio tagliata per il suo lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140204,
					"content": "In particolare, gli errori commessi nell'inserimento dei dati sono imperdonabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140205,
					"content": "Per quanto riguarda quelli di questa settimana, le cifre sono corrette solo per uno o due giorni al massimo. Perfino un conteggio a colpo d'occhio risulterebbe più accurato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140206,
					"content": "Se la situazione è questa, come posso assegnarle questo lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140207,
					"content": "Beh, se si tratta soltanto di cifre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Quando si parla di lavoro, la parola \"soltanto\" è fuori luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140209,
					"content": "Se anche un'unica doga di un barile di legno è più corta, la capienza dell'intero barile diminuisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140210,
					"content": "Lo stesso vale per il lavoro. Se tralasciamo anche il più piccolo dettaglio, l'intero operato andrà in malora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140211,
					"content": "Prendiamo per esempio il conteggio delle imbarcazioni. Se le cifre non sono accurate, allora anche le varie attività svolte al porto risulteranno imprecise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140212,
					"content": "Le imprecisioni hanno un costo. È possibile rimediare, è vero, ma il tempo perso inutilmente per risolvere il problema non può essere recuperato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140213,
					"content": "Capisci cosa intendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140214,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "Nonostante ciò, qui al porto non abbiamo abbastanza personale, quindi non penso di licenziarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140216,
					"content": "Come dire... \"Meglio una doga più corta che nessuna doga\". Chiaro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140217,
					"content": "Oggi la persona incaricata di fare l'inventario dei carichi non c'è per via di un imprevisto. Di' a Linling che il suo aiuto sarebbe gradito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140218,
					"content": "Se mentre lavora lì non commetterà errori seri, allora potrà tornare alle sue mansioni di conteggio delle imbarcazioni, quando la persona incaricata dei controlli farà ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140224,
					"content": "Mmm... Immagino si possa considerare un test. Un po' una seconda possibilità, ecco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140225,
					"content": "Consegna questo foglio a Linling. Chiedile di seguire le istruzioni sull'inventario e di segnare sul retro quali verifiche ha completato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140226,
					"content": "Inoltre, dille di rimboccarsi le maniche. Se fallisce anche questo incarico, può scordarsi ulteriori seconde possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140219,
					"content": "Le dirò che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Cosa le dirai? Che è licenziata? Per adesso ancora non lo è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140221,
					"content": "Siamo seriamente a corto di personale, qui al porto. Come dire... \"Meglio una doga più corta che nessuna doga\". Chiaro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140222,
					"content": "Oggi la persona incaricata di fare l'inventario dei carichi non c'è per via di un imprevisto. Di' a Linling che il suo aiuto sarebbe gradito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 221140223,
					"content": "Se mentre lavora lì non commetterà errori seri, allora potrà tornare alle sue mansioni di conteggio delle imbarcazioni, quando la persona incaricata dei controlli farà ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An il Nervoso"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "Oh, cosa farò con il mio lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "An il Nervoso vuole darti un'altra possibilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Davvero? Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Come? L'inventario di un carico? Oh, no! Non ho mai fatto nulla di simile prima d'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Se sbaglio un'altra volta, non avrò scampo. No, devo prima prepararmi a dovere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Devo scoprire quali erano gli standard di chi se n'è occupato prima e i formati che utilizzava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Mi aiuteresti a conteggiare le merci? Basterà verificare che i numeri su di esse corrispondano accuratamente a quelli sul documento. In seguito, farò io un controllo più dettagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "Ho capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Grazie mille. Nel frattempo resterò qui a occuparmi dei preparativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Stavolta non posso sbagliare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "No, non posso. Stavolta no. L'inventario delle merci è un compito molto più complesso del conteggio delle imbarcazioni. Devo fare da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Verifica soltanto la quantità di merci presenti, allora. In seguito farò un controllo più dettagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
