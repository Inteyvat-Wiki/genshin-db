			"dialogs": [
				{
					"id": 740812401,
					"content": "Sono questi i nastri che dovevamo recuperare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812402,
					"content": "Mostri i nastri perforati recuperati a Sévigne...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "Sì, sono questi! Siete così efficienti e solerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812404,
					"content": "Per un incarico tanto semplice? Non esiste che non lo portiamo a termine in un batter d'occhio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "È pur sempre lodevole. Non esagero se dico che alcuni dei miei colleghi ci metterebbero una giornata intera per trovare anche la cosa più stupida di questo mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812406,
					"content": "Ma non parliamone ora... Dovete portare i nastri perforati a Chisseray.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812407,
					"content": "E ditele che mi tratterrò qui ancora per un po'. Oh, e anche di mettersi in contatto con Maillardet per fargli sapere che dovrebbe venire qui a recuperare i prototipi il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812408,
					"content": "#Ok. Allora, {NICKNAME}... dovremo tornare da dove siamo venut{F#e}{M#i}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "Oh, non sarà necessario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812410,
					"content": "Sapete fare immersioni, giusto? Potete arrivarci attraverso un corso d'acqua. È stato chiuso per evitare cadute accidentali, ma posso riaprirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812411,
					"content": "#Grandioso! Andiamo sott'acqua, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "Il terminale per aprirlo è all'interno. Posso farlo da sola. Ce la farete a uscire da qui per conto vostro, vero? Non vi perderete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812413,
					"content": "#Assolutamente, non sottovalutarci! Paimon è la guida migliore di tutta Teyvat. {NICKNAME} non potrebbe mai perdersi con Paimon al suo fianco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "Siete davvero affidabili. Conto su di voi per la consegna del messaggio e de i nastri perforati. Spero non vi offendiate se non vi accompagno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sévigne"
				}
			]
		},
