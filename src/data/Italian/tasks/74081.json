					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Uh, abbiamo... appena fatto qualcosa di brutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "Che strano, ho percepito una vibrazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811703,
					"content": "Anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Mmm, potrebbe essere che abbiamo combinato qualche pasticcio con il dispositivo al livello superiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Prima questa porta era chiusa a chiave, vero? E c'erano anche dei Mekautomi a fare da guardia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811707,
					"content": "Ho mandato in \"pausa\" le guardie e aperto la porta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "#Non abbiamo... avuto scelta! Ci hanno attaccat{F#e}{M#i} prima loro, è stata legittima difesa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "I prototipi di Maillardet... Avrebbero dovuto essere in modalità standby. Dopotutto, da quando ha ottenuto un buon posto su Érinnyes non è praticamente più tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811711,
					"content": "Ora che ci penso, chi mai vorrebbe tornare in questo laboratorio umidiccio e fatiscente... quando può vantarsi delle proprie ricerche dinanzi a un pubblico in adorazione in una cornice incantevole come la pista da ballo del giardino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811712,
					"content": "Dopo che Messire Bossuet ha lasciato il posto, sono stati tutti disseminati per tutto l'Istituto, proprio come questi materiali. Non è rimasto nemmeno un divano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811713,
					"content": "Qui dovrebbero esserci solo dei prototipi, in attesa di chi non farà mai ritorno. Normalmente starebbero qui in modalità standby, niente di speciale. Ma ora, oh, è semplicemente pazzesco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811714,
					"content": "Guardate! Sono stati colpiti così duramente che gran parte dei pezzi sono caduti. Se Maillardet lo venisse a sapere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811715,
					"content": "È colpa mia, mi dispiace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Scusa... Questo prototipo è costoso? Nel caso ci chiedessero un risarcimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Tranquilla, stavo per dire che... se Maillardet lo venisse a sapere, scoppierebbe in una grassa risata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811720,
					"content": "Dopotutto, di solito era lui a interrompere la danza dei prototipi e, dopo essere stato messo al tappeto, si sedeva lì a ridere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811721,
					"content": "Oh, ho parlato talmente tanto che non mi sono ancora presentata: sono una ricercatrice dell'Istituto di ricerca di Fontaine, potete chiamarmi Sévigne. E voi come vi chiamate...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811722,
					"content": "#Paimon è Paimon, e {F#lei}{M#lui} è {NICKNAME}. Siamo... ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Solo di passaggio, senza uno scopo particolare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Esatto! Siamo solo di passaggio, e senza ombra di dubbio non credevamo che qui ci fossero dei tesori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Oh, intendi una specie di tour delle rovine con sessioni di caccia al tesoro? In tal caso, siete nel posto sbagliato. Queste potrebbero sembrare delle rovine, ma... beh, effettivamente è quello che sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811727,
					"content": "Anche se non sono ancora in nessun elenco di rovine consigliate ai turisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811728,
					"content": "Bene... Allora è il momento di levare le tende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "...Un momento, avete saputo del nuovo Istituto di ricerca di Fontaine, giusto? Se state andando via, potreste farmi un favore? Andreste all'Istituto a cercare Chisseray?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811730,
					"content": "#Ma non siamo dirett{F#e}{M#i} lì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Come farò, allora? Ho ancora del lavoro da fare, e i prototipi di Maillardet si sono rotti! Mi serve che qualcuno li riporti indietro il prima possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811733,
					"content": "#Mm... Forse dovremmo aiutarla, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "#Magnifico! Visto che siete dispost{F#e}{M#i} a riportarlo indietro, già che ci siete dovrete anche recuperare i nastri perforati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811735,
					"content": "Se l'avessi saputo, non avrei toccato quei dispositivi là fuori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Non dire così. Dopo tutto, per te sarà una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811737,
					"content": "In questo modo potrò ottenere il rimborso del costo dell'incarico sotto forma di spesa per il recupero dei materiali per le ricerche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811738,
					"content": "Sul serio? Sicura che sia così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Visto che si tratta del nostro lavoro di ricerca, è del tutto giustificato e legittimo. Nessun problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811740,
					"content": "Se sarà contestabile, la richiesta verrà comunque rifiutata dal personale amministrativo. In tal caso dovrò coprire solo il costo dell'incarico di tasca mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811741,
					"content": "Fai spesso questo genere di cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Personalmente no! Non conosco nessuno che l'abbia mai fatto prima, ma ho sentito delle storie... Non importa, non sono cose che potrebbero interessare a degli estranei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811743,
					"content": "Ci sono tre nastri perforati da recuperare, e dovrebbero essere sullo scaffale. Dovreste trovarli facilmente. Grazie per il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811744,
					"content": "Nel frattempo controllerò nuovamente i prototipi, visto che sono stati revisionati parecchio tempo fa... Se andassero in tilt non sarebbe divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811745,
					"content": "Ok, allora torneremo qui quando avremo recuperato i nastri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "Nessun problema, me ne occupo io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Dobbiamo ancora trovare altri tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "Ci sono dei tesori qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Avete mai pensato a potenziare la forza dei prototipi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Maillardet l'ha fatto, forse il prodotto finale soddisferà le tue aspettative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811708,
					"content": "Già, che strano! Perché adesso è aperta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Che fosse solo nella tua testa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
