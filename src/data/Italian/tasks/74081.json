			"dialogs": [
				{
					"id": 740812901,
					"content": "Per un attimo ho pensato che Monsieur Eastinghouse fosse tornato, sentendo tutto quel trambusto... Ma poi ho scoperto che qualcuno ha attivato per errore i dispositivi là fuori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812902
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812902,
