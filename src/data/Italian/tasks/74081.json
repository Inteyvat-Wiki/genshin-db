			"dialogs": [
				{
					"id": 740813101,
					"content": "Ciao! A proposito di Sévigne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Racconti a Chisseray quello che è successo e le consegni i tre nastri perforati...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Stavo giusto pensando che forse dovrei andare a trovarla. Allora è questo che è successo. Grazie per l'aggiornamento... e per i nastri perforati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "È sorprendente che i prototipi di Maillardet possano ancora muoversi, e che Sévigne stia lavorando in un ambiente tanto pericoloso. Parlerò con il personale amministrativo per organizzare il recupero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "E per vedere se ci sia la possibilità di detrarre le spese... È stato piuttosto intelligente da parte sua. Alla fine sarà il personale amministrativo a decidere sulla questione, ma per il momento pagherò io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "Comunque sia, grazie per il vostro aiuto. Ecco il vostro compenso per un lavoro ben fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
			]
