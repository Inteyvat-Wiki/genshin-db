			"dialogs": [
				{
					"id": 710130901,
					"content": "I mostri seminano distruzione in ogni parte del mondo, e noi che cerchiamo di proteggerlo faremmo bene a ricordare questo: i mostri non meritano altro che di essere sterminati senza pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130902
