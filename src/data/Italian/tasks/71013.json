			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131001,
					"content": "Queste tre domande ho posto al mio compagno discepolo, ma egli non ha fatto altro che rimproverarmi. Mi ha accusato di essere venuto meno al mio dovere, per poi andarsene furioso. Possano le vere risposte a queste tre domande portare la pace nel mondo. Nel corso del mio tempo, ho cercato la saggezza in testi antichi provenienti da ogni nazione, mi sono nascosto qui per meditare nella tranquillità e studiare la lingua dei mostri. Tutto ciò nella speranza di comprendere la loro vera natura. Ho eretto questo monumento affinché, un giorno, sia testimone dell'arrivo di qualcuno che possa rispondere a queste domande una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131002
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710131002,
					"content": "Tocca il monumento",
					"roleType": "TALK_ROLE_PLAYER",
