			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "Le <color=#00E1FFFF>Visioni</color>... Esse provengono davvero da un regno che trascende il nostro. Si dice che siano un dono divino, ma nessuno può dire chi lo riceverà e perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710131502,
					"content": "Secondo i testi antichi, il divino osserva dall'alto il regno dei mortali con sguardo compassionevole, e dona le <color=#00E1FFFF>Visioni</color> a coloro che ne sono degni per aiutarli a combattere il male e a proteggere il mondo. In me, però, non arde più il desiderio di bandire i mostri... Voglio solo comunicare con loro, per comprenderli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710131503,
					"content": "Questa <color=#00E1FFFF>Visione</color>... non mi è di alcuna utilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
