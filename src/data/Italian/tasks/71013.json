				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Sin dall'infanzia, sono stato addestrato alle arti marziali insieme a un altro discepolo. La nostra missione era combattere le forze del male e proteggere tutto ciò che di sacro vi è in questo mondo. Un compito non facile per chi è privo di una <color=#00E1FFFF>Visione</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710130102,
					"content": "Abbiamo scelto di ritirarci qui per allenarci ulteriormente e trovare le <color=#00E1FFFF>Visioni</color> tanto desiderate. Abbiamo eretto questo monumento come testimonianza dei nostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
							"2"
						],
						"stepId": 7101302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "Sono stato abbastanza fortunato da ricevere la mia <color=#00E1FFFF>Visione</color>. Tuttavia, nella mia mente albergava un dubbio: dei semplici mortali hanno davvero la facoltà di purificare il mondo dai mostri che per lungo tempo l'hanno infestato? E prima di tutto, questi mostri sono davvero così diversi dall'essere umano, al di là del loro aspetto? Non è che, come noi, anche loro parlano, costruiscono e provano sentimenti come amore, odio, gioia e dolore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710130202,
					"content": "Con queste parole, scolpisco su questo monumento la più grande perplessità del mio animo. O tu che leggi da un lontano futuro, sarai forse in grado di risolvere questo enigma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
