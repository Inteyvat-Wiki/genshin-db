	"talks": [
		{
			"id": 7101301,
			"completionStepIds": [
				7101316,
				7101317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101301",
							"2"
						],
						"stepId": 7101301,
