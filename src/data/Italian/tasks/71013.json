				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>Qualora ti possa interessare, ho seppellito vicino al lago i pochi tesori che possiedo. Recuperali con la mia benedizione.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710131404,
					"content": "La mia unica richiesta è che tu non dimentichi mai queste tre domande. Prego perché giunga il giorno in cui avrai modo di rispondervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
		{
			"id": 7101315,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
