			},
			"dialogs": [
				{
					"id": 20185301,
					"content": "Finché avremo la Musou no Hitotachi, la gente di Inazuma non avrà nulla da temere. Questo è un dato di fatto, ma Sara non vuole vedere la verità... Umpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
