			"dialogs": [
				{
					"id": 401730501,
					"content": "Mh? Tutto ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Devo andare a restituire la spada cerimoniale al capo tra poco, ma lascio l'accampamento così com'è. Guarda e usa quello che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "Ehm... Si dà il caso che abbia l'ultimo volume della saga \"Guerrieri del miraggio\" qui con me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "...Così come uno spin-off de \"I casi della signorina Orith\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "EEEEEEH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Ti va di leggerli assieme a me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "#(Ma che...? Che succede? Come fa a sapere che sono fissata con quei libri? A meno che... non si sia volutamente {F#informata}{M#informato} su di me...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "#(No, è ridicolo... Scommetto che è stato quel mocciosetto di Ororon a {F#spifferarle}{M#spifferargli} tutto...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "#(Eppure... Se n'è {F#ricordata}{M#ricordato}, deve significare qualcosa, no? Perché segnarsi un dettaglio tanto banale?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "(Ugh, concentrati! Mi ha fatto una domanda! Uhm, uhm, uhm... Argh, come dovrei rispondere?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Certo, perché no. Più tardi dovrei avere un po' di tempo. Ti faccio sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
}