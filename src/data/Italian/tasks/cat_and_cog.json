			"dialogs": [
				{
					"id": 761850201,
					"content": "Il tè ha un sapore molto migliore se accompagnato da delle informazioni utili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850204,
					"content": "Oh, riguardati. E ricorda di fare un salto, quando hai tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
