			"dialogs": [
				{
					"id": 761850101,
					"content": "Mmm, tè delizioso e stuzzichini prelibati. Grazie per la tua ospitalità, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Sono contenta che ti piaccia. Ho portato anche degli snackini per Ashru. Vero, Ashru? Vieni qua. Bravo, bel miciotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850103,
					"content": "Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Spero che la tua simpatia nei confronti di Nod-Krai e del Consiglio dei segreti si riveli proficua per le nostre collaborazioni future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Lo spero anch'io. Tieni, Ashru, prova uno di questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850106,
					"content": "Inoltre, riguardo alla questione di cui ti ho parlato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Eheh, che zampettine morbidine che hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Sandrone... Non dirmi che hai usato questo ricevimento come pretesto per venire a vezzeggiare il mio gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Eh...? C-Chi, io? Ma quando mai! Prendo molto seriamente i miei rapporti col Consiglio dei segreti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850111,
					"content": "Ashru, vieni qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Oooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850114,
					"content": "Allora parliamo un po' dei dettagli dei nostri \"rapporti\", ti va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "...Umpf. E allora? V-Volevo accarezzare Ashru... Chi non lo vorrebbe?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850116,
					"content": "Gli animaletti di solito diffidano delle macchine. Ho dovuto faticare parecchio per conquistare la fiducia di Ashru mentre ero qui a lavorare sulla matrice numerologica. Che c'è di male nel fargli una carezzina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761850117,
					"content": "Ah... Non c'è bisogno di mettersi sulla difensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Va' pure, Ashru. Non spetta certo a me dirti addosso a chi puoi strusciarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Ma dopo che avrai finito di accarezzarlo, non dimenticare che abbiamo affari da discutere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Come ti ho detto, prendo molto seriamente i nostri rapporti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
