			"dialogs": [
				{
					"id": 750360401,
					"content": "Bene, la profondità sembra sufficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360402,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360403
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360403,
					"content": "Lascia pensare Paimon... Uhm, se le piante di Natlan sono diverse rispetto alle altre... di sicuro è per via del Flogisto! Forse possiamo usarlo per dare nutrimento al seme? Proviamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
