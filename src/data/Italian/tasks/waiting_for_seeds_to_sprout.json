			"dialogs": [
				{
					"id": 750360801,
					"content": "Coraggio, bel semino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360802,
					"content": "Vieni fuori, fiorellino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360803,
					"content": "Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360804,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Ah, {NICKNAME}, l'energia del Flogisto è svanita. Dev'essere stata assorbita dal seme, ma... non c'è stata alcuna reazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Forse ha solo bisogno di tempo per crescere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Tu dici? Mmh, non hai tutti i torti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "I semi di Dente di leone volano come piccoli ombrelli se si soffia leggermente su di loro, le Bacche uncinate si attaccano ai piccoli lupi e scappano con loro in luoghi lontani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "I semi sono esserini tanto piccoli quanto tenaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Beh, in questo caso, lasciamo perdere per ora: avremo tempo per tornare più tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Forse il seme è solo timido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "Davvero? Uhm, sì, forse Paimon è solo troppo impaziente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ha dissotterrato il seme, che è stato privato di nutrienti dagli insetti volanti e persino disturbato da alcuni mostri che l'hanno calpestato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Questa lotta deve aver causato un grande scompiglio per il povero seme: è naturale che si nasconda nel terreno e non osi muoversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
		},
