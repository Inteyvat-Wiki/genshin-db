			"dialogs": [
				{
					"id": 760280301,
					"content": "#Aaah, eccoti qui, {NICKNAME}! Quando quelle due cose luminose si sono scontrate, l'esplosione ha fatto volare via Paimon! Per fortuna non si è fatta male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Paimon ci ha messo un'eternità per tornare qui in volo... Ma Paimon è felice che tu stia bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "A dire il vero, anch'io ho volato per un bel po'...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Ah, davvero... Eh? Aspetta, che intendi dire con volare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Racconti a Paimon quello che hai appena visto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, Paimon non ha mai sentito parlare di un posto del genere a Teyvat... Sei {F#sicura}{M#sicuro} di non aver avuto le allucinazioni, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Comunque, l'importante è che tu stia bene! Qui intorno stanno succedendo troppe cose strane. Andiamocene via prima che sia troppo tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Uff, Paimon non pensava che fossero così pericolose, e alla fine non abbiamo nemmeno trovato alcun tesoro... E poi, perché qualcosa del genere dovrebbe trovarsi qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "E se quelle due cose luminose non erano Seelie... allora cosa erano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "#Penso di essere {F#stata scaraventata}{M#stato scaraventato} in un posto strano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
				},
				{
					"id": 760280309,
					"content": "Racconti a Paimon quello che hai appena visto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280310
