					"nextDialogs": [
						721840502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840502,
					"content": "Mi chiedo che sapore avrà una pizza fatta con gli ingredienti locali di Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840503,
					"content": "Finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840504,
					"content": "Questa pizza sembra... piuttosto buona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "#Grazie per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "Ora penserò a godermi il sapore di questa pizza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
					"content": "Se non è male... verrà inserita ufficialmente come nuovo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
