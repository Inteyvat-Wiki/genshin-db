			"dialogs": [
				{
					"id": 721840201,
					"content": "Oh, salve. Posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840202,
					"content": "A proposito della pizza del Ristorante Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "Oh, quella pizza è davvero buona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Ma... Come dire, non sono molto abituata al suo sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Credo che all'interno della pizza si potrebbero integrare alcuni degli ingredienti locali di Inazuma, come il Melonlavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Forse, in questo modo chiunque apprezzerebbe la pizza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
				}
			]
		},
		{
