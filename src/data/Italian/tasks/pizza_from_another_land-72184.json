			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "#Viaggiat{F#rice}{M#ore}, sei tornat{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Com'è andata? Qualche commento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "A proposito dei commenti dei clienti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Pizza con il Melonlavanda... Nulla di troppo difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Il resto degli ingredienti va preparato come al solito. Beh, visto che il commento dice d'integrare alcuni degli ingredienti locali di Inazuma, allora posso aggiungerne altri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Mmm, ganoderma marino? Erba del pianto? Oh, che ne dici del Fungo fluorescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Mmm, hai bisogno di aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Oh! Scusa, stavo pensando a quali ingredienti aggiungere! Vediamo, credo che in dispensa non siano rimasti molti Melonlavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "#Viaggiat{F#rice}{M#ore}, ti prego, aiutami a recuperare un Melonlavanda. Direi che... manca solo questo come ingrediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Allora conto su di te. Basta un solo Melonlavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Hai bisogno di altri ingredienti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "In dispensa ci sono ancora altri ingredienti. Porta solo un Melonlavanda, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
