				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "A proposito, ma Neuvillette non è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Hai ragione! Neuvillette è il Drago di Hydro, giusto? Non vuol dire che questo tipo è persino più vecchio di lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "È già nato un nuovo Drago di Hydro? È passato tantissimo tempo dalla scomparsa della precedente Signora delle Mille Acque... Eoni ed eoni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "A ogni modo, un tempo il malvagio drago Scylla era alleato del Sebastos, ma gli si rivoltò contro nel momento critico della battaglia tra noi remuriani e... i fontainiani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832302,
					"content": "Così, Scylla condusse la brutale stirpe dei Dragogeniti a Machimos, con l'intento di penetrare a Capitolium, la città interna dove risiedeva il Sebastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832303,
					"content": "Machimos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Sì, gli abitanti parlavano continuamente di una certa Machimos e di un campanile o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Esatto. Machimos è la città esterna della capitale, ma se l'empio drago volesse arrivare alla città interna, dovrebbe per forza passare attraverso l'Initium Iani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832307,
					"content": "È la barriera che separa le due parti della capitale. Anche il Sebastos e i musicisti che composero la Sinfonia diffusasi in tutta Remuria sono passati per l'Initium Iani e le sue idrovie dorate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832308,
					"content": "Boethius e le sue truppe hanno colto l'occasione per sigillare l'Initium Iani e imprigionarvi per sempre dentro il drago malvagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832309,
					"content": "Forse Scylla ha tentato di arrivare al trono del Sebastos, ma ormai non è più possibile. In seguito, il drago malvagio è affondato assieme a Remuria, e del Sebastos si sono perse le tracce. La situazione è rimasta invariata fino a oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832310,
					"content": "(C'è qualcosa che non torna in questa storia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#Ti è tornato in mente qualcosa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832314,
					"content": "Ho dei ricordi molto confusi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Non posso negarlo... Io stesso sono venuto a conoscenza dei fatti quando tutto era ormai accaduto. Del resto, non mi trovavo nella capitale al momento del disastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832316,
					"content": "A quel tempo nessuno sapeva cosa fosse accaduto al Sebastos. Credo che lo scopriremo solo andando avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832317,
					"content": "Il pesce luminoso che abbiamo visto prima nel castello... Dev'essere la forma che hanno preso i pensieri di Scylla espulsi dalla sua cella attraverso le fessure nella pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832318,
					"content": "Temo che sappia già della nostra presenza. Dopo essere stato rinchiuso qui tanto a lungo, ora che ha fiutato degli estranei, cercherà in tutti i modi di farci cadere in trappola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832319,
					"content": "Ah, è così che stanno le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Un attimo, però. Hai detto che non c'è altro modo di entrare nella Domus Aurea se non attraverso quelle porte o qualcosa del genere. Ma se Boethius le ha già serrate, significa che è inaccessibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Non sarà certo semplice, questo è sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832322,
					"content": "Ma la maleducazione davvero non conosce limiti?! Che dice a fare \"Vi aspetto alla Domus Aurea, muhahaha!\", se poi non lascia neanche una mezza porta aperta, eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Perché non troviamo il modo di rompere il sigillo del drago, e lasciamo che sia questo nemico un tempo sconfitto ad abbattere la porta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "No! Come potremmo mai fare una cosa del genere?! Voglio dire, è una delle nemesi di Remuria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832325,
					"content": "Ma non vale quella storia che il nemico del mio nemico è mio amico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "È passato così tanto tempo che, per quanto ne sappiamo, potrebbe aver \"cambiato pelle\" e deciso di fare il bravo drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Stiamo pur sempre parlando di un drago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741832329,
					"content": "#E quindi? Potrebbe essere uno di quei draghi con cui si può ragionare. Abbiamo molta esperienza con i draghi, non è vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "Però Remuria ormai è solo un ricordo, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(La dimensione onirica di prima... A quel tempo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(Scylla dovrebbe già essere venuto a trovare Remus...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
