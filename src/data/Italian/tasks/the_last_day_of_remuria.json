					},
					{
						"sceneId": 11,
						"position": [
							1494.143,
							702.766,
							4593.569
						],
						"pointId": 901101004
					}
				]
			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Woah... Sembra il pesce luminoso che abbiamo visto prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Ha ancora qualcosa impigliato nella parte superiore... Ma che succede? Paimon ci capisce sempre meno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Ho già sentito questa voce in un sogno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Sì. Lo hai incontrato nel sogno del Sebastos, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830406,
					"content": "Scylla, un empio drago che un tempo era agli ordini del Sebastos. A sottometterlo e rinchiuderlo qui è stato Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830407,
					"content": "Eeeh?! Quel cafonazzo ha sottomesso un drago malvagio? Paimon non lo credeva all'altezza di una simile impresa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Beh, \"empio drago\" è come l'hanno definito, ma non era altro che un Elementosauro appena un po' più forte del normale. Del resto, fintanto che la Signora delle Mille Acque fosse rimasta ibernata nelle profondità marine, non vi sarebbe stato spazio per un nuovo Drago di Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830404,
					"content": "È solo che non ricordo il nome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Monsieur Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Aaah! Come sono calde le correnti dell'oceano! Libertà, finalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Dunque, piccoletti, siete piovuti giù dalla superficie? Non so cosa vi abbia spinti fino a questa galera sottomarina, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "\"Piccoletti\"? Guarda che sei tu ad avere delle proporzioni gigantesche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Ahah! Poco importa, avete mandato in frantumi le catene che mi imprigionavano da millenni. Sono in debito verso di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Se avete un desiderio, pronunciatelo e io lo esaudirò. Consideratelo il mio personale ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hihi, Paimon lo sapeva che eri un bravo ragazzo, dopotutto. A proposito, noi siamo Paimon e {NICKNAME}, mentre questo è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Ehm... Paimon non ha idea se tu lo conosca con qualche altro nome, ma noi lo chiamiamo \"Monsieur Os\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Cassiodor, sei proprio tu! Non mi aspettavo più di vederti... Sei in ritardo di svariate migliaia di anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Ehi, Monsieur Os, sembra che questo bestione ti conosca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Non ho nulla da dire a un infame traditore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830611,
					"content": "Attento a come parli, mortale! Noi discendiamo dai draghi e manteniamo sempre la parola data, senza eccezione. Al contrario, non si può dire lo stesso della tua specie arrogante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Risparmia il fiato! Vale meno di un'Algamarea spiaggiata! Non ci sono dubbi sul tuo tradimento, non è forse per questo che abbiamo perso quella guerra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830613,
					"content": "Se non avessimo perso la guerra... La nostra nazione... Il Sebastos... non avrebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830614,
					"content": "Oh, Cassiodor, si vede che sei stato via troppo a lungo! La verità è diversa da quel che immagini... Del resto, è stato concepito un piano segreto, ed è normale che non sia arrivato alle tue orecchie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "Un piano... segreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830616,
					"content": "Condurre l'assalto alla capitale assieme a un esercito di Elementosauri faceva parte del piano finale segreto di Remus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "E ha fatto quel che ha fatto per salvare la sua nazione e il suo popolo: un uomo dai grandi princìpi morali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "Ma è assurdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "È vero, non ha senso. Quale sovrano chiederebbe mai a qualcun altro di invadere il proprio Paese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Tenero esserino, cosa possiamo saperne io e te di quello che pensa Remus? Ciò non toglie, Cassiodor, che persino tu, dando un'occhiata rapida a questo, dovresti essere in grado di intuirne il significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Le Api guida dorate... dovrebbero rispondere unicamente alla Sinfonia... Perché mai il Sebastos dovrebbe conferire il suo potere a un drago selvaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830624,
					"content": "Perché avevano un accordo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Oh! Guarda un po' quante cose sai, esserino. Da dove viene questa conoscenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Dai ricordi dispersi in mare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Dici il vero! Sì, effettivamente avevamo un accordo, ma non l'ho rispettato, rendendo il suo nobile sacrificio vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Non sono arrivato in tempo alla Domus Aurea! E le onde hanno inghiottito la città, condannando i miei simili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "Come può essere...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830630,
					"content": "Umpf! Se parliamo di tradimenti, devi menzionare Boethius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "È stato a causa di quel viscido spergiuro, di quel ratto di fogna e delle sue vuote promesse, se io, un principe della discendenza dei draghi che ha guidato gli eserciti dopo l'era dei draghi antichi, sono stato così facilmente sconfitto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "Prima quella carogna dice che non avrebbe più opposto resistenza agli ordini di Remus, affermando di aver intimato alle legioni di cessare ogni azione di lotta. Ma quando arriviamo là, ci assale all'improvviso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Ora che ho avuto tempo per rifletterci, temo che in qualche modo abbia saputo del piano di Remus, e sia stato così in grado di attirarmi pian piano e farmi cadere in una trappola appositamente preparata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "E così mi sono trasformato in pietra per millenni, fino a quando non mi avete liberato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius era perfettamente consapevole delle nefaste conseguenze che avrebbero comportato le sue azioni, ma le ha eseguite comunque... Forse perché stava cercando di prendere il controllo di Phobos? Sarà stato questo il motivo per cui ha commesso quei peccati...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830636,
					"content": "Sembra che manchi ancora qualche pezzo alla storia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Ciò vuol dire che chi additava tutti come traditori era sin da principio l'unico e vero traditore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Ma che motivo aveva? Uff, davvero l'unico modo per scoprirlo è chiederglielo direttamente? Paimon dubita che ci risponderà in maniera sincera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Uhm... Vuoi dire che quel verme maledetto e rivoltante non è ancora scomparso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Non solo, ha anche rubato l'anima a diversi abitanti di Fontaine! Infatti siamo qui per aiutarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "Ha detto che ci avrebbe aspettato nella Domus Aurea... Anzi, che avrebbe aspettato Monsieur Os, quindi noi siamo comunque di troppo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Nemmeno la porta aperta ci ha lasciato... Che screanzato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "L'Initium Iani...? Umpf, avrà pure usato dei trucchetti da quattro soldi o qualche specchietto per le allodole per scoraggiarci ma, alla fin fine, altro non è che una pomposa porta di pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "Anche se non ho più un corpo fisico, posso sempre mandare voi piccoletti a regolare i conti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Fate attenzione, piccoletti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Ooooooh! A quanto pare ci si può proprio fidare di te, eh, bestione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Dobbiamo far saltare questi sigilli, uno dopo l'altro. Se siete pronti, possiamo cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Bene, Monsieur Os. Sei pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "A questo punto, non abbiamo scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830647,
					"content": "#D'accordo. Possiamo procedere, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Aveva perso il senno anche lui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
