			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "Non credevo che gli Elementosauri potessero raggiungere dimensioni simili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Umpf. Dopotutto non sono altro che dei barbari ignoranti. Non mi sorprenderebbe se diventassero ancora più strani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
