			"dialogs": [
				{
					"id": 150120101,
					"content": "N-Non è ancora tornata... Spero non sia successo qualcosa alla maestra Cheven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Quella bambina laggiù sta piangendo. Chissà cosa le è successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "Andiamo a controllare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Ehi, piccola. C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*singhiozza* La maestra Ch-Cheven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "È andata a raccogliere dei Cristalli vulcanici... ma non è ancora tornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Ne ho parlato con le guardie, ma hanno detto che sono a corto di personale. È un posto super pericoloso, con tanti mostri e malintenzionati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Dovranno finire i preparativi prima di poter provare a salvarla... Ma allora sarà troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Tranquilla, ci pensiamo noi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Davvero mi aiuterete? Fantastico! Aspettate, vi disegno il luogo dove sono andate poco fa le guardie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Hanno detto che potrebbe trovarsi da quelle parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Potrebbe anche essere stata costretta ad avvicinarsi al Chiodo dell'ombra. Se è così... allora... *tira su col naso*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "Ti prego! Devi salvarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "#A quanto pare tocca di nuovo essere {F#le eroine}{M#gli eroi}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
