			"dialogs": [
				{
					"id": 150121301,
					"content": "Anche Xilonen è dell'ambito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Ah, conosci Xilonen? Ahah, prova a pronunciare il suo nome davanti a Tlazolli, inizierà a incensarla come se non ci fosse un domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "\"La più grande esperta in materia di Nomi antichi\", \"il futuro della nostra tribù\", \"la più eccezionale artigiana di Natlan\"... Andrebbe avanti così per ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "So che a Tlazolli mancano i tempi in cui creava Nomi antichi. Non lo ammetterà mai... ma è evidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
		},
