					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Si tratta di un Nome antico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "Ehi, l'Archon di Pyro ha detto di aver già contattato Xilonen in merito. Non c'è bisogno di complicare la situazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Non ci serve nulla di così stravagante... Un regalo normale basta e avanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
					"speakerTitle": "Paimon"
