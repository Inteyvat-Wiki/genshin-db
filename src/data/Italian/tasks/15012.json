			"dialogs": [
				{
					"id": 150120501,
					"content": "#In preda al panico ho imboccato un sentiero stretto per evitarli... per poi imbattermi in quei banditi. Meno male che siete {F#arrivate}{M#arrivati}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Se la situazione era così pericolosa, perché non hai gettato i cristalli per scappare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Ah, ne ho buttato la maggior parte, credimi. Quello rimasto è il frammento più puro di tutti. Sono determinata a riportarlo indietro a qualunque costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "Devo farlo, per Tlazolli e per la povera piccola Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Chi sarebbero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, giusto, non potete saperlo. Tlazolli... una volta era un'ideatrice di Nomi antichi. Nechca è sua figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
