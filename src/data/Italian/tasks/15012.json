			"dialogs": [
				{
					"id": 150120401,
					"content": "Wow, che determinazione a fuggire che avevano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Sapevano a cosa andavano incontro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Fiuuu... Grazie mille. Se non fosse stato per voi sarei stata spacciata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Salvata da {NICKNAME}... Oggi la fortuna mi sorride.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah, scusate, non mi sono presentata. Sono Cheven, un'artigiana di gemme, e di solito sfortunata... almeno finora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Imix ci ha mandato ad aiutarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Quella ragazzina... *sospira* Sembra che l'abbia fatta preoccupare di nuovo. Non pensavo che sarei stata via per più di due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Ma poi ho scoperto una nuova vena di Cristalli vulcanici vicino al Chiodo dell'ombra... dall'incredibile purezza e in quantità eccezionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Ne ho estratto un bel po' e mi stavo preparando per tornare indietro, ma il Flogisto all'interno dei cristalli ha attirato dei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "La fama ha i suoi vantaggi, immagino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
