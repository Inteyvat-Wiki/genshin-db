			},
			"dialogs": [
				{
					"id": 722391301,
					"content": "Mmm, qua c'è scritto: \"Supada no Hiko, il Bandito\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391302,
					"content": "No, dovrebbe essere solo \"Supada no Hiko\". È il nome di quell'uomo! Andiamo a dirglielo, presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7223918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
