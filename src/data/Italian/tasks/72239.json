					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "Eh? Ti sei già dimenticato di noi? Oh, no! Sei messo peggio di quanto Paimon pensasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Grazie. Davvero ci conosciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "In realtà, ci siamo appena incontrati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "Ah, sì, lo rammento. In questo luogo, viene erosa persino la tua stessa anima. I miei ricordi sono stati ridotti in polvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "Mi dispiace, io... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "Avete scoperto qualcosa di utile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "Il tuo nome è Supada no Hiko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko... Giusto... Sì, è così! Sono il capo della Resistenza, Spartacus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Oh, e così hai due nomi? Proprio come ci si aspetta da un grande leader!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Grazie mille per avermi restituito il ricordo del mio nome. Sembra che mi sia ricordato anche di altre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "\"Dopo il sole, inizia l'oscurità, ma la vera luce si cela nei nostri cuori.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "Che cos'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "È il nostro messaggio in codice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Adesso che ricordo nuovamente il mio nome, iniziano a tornarmi anche i ricordi. Questo dovrebbe essere il nostro messaggio in codice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Ora lasciate che vi dica dove sono nascosti i miei figli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "Ha qualche messaggio che vuoi che riferisca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Dite questo da parte mia: non arrendetevi mai, perché la speranza di Byakuyakoku è con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "Vuoi che li porti qui da te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "No, mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Il nostro unico vantaggio è che il nemico è allo scoperto, mentre noi siamo nell'ombra. I cuori della gente di Byakuyakoku sono tutti con noi, e noi non dobbiamo rivelarci così facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Inoltre, non riesco a ricordare ogni singolo nome. Voglio dire, avevo dimenticato persino il mio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "Quindi sì, dite loro di non arrendersi mai, perché la speranza di Byakuyakoku è con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "Se non sono più lì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "No, non accadrà. Finché i leader corrotti che controllano il Figlio del sole saranno ancora al loro posto, loro ci saranno sempre. La Resistenza continuerà a esistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Portate loro questo mio monito: non arrendetevi mai, perché la speranza di Byakuyakoku è con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "Questo sarà sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "Il tuo nome è Supada il Bandito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Oh, su! Il tuo nome è Supada no Hiko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390305,
					"content": "Stavamo cercando di scoprire la tua identità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
		},
