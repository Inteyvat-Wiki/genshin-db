			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Non arrendetevi mai, figli miei. La speranza è con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390102,
					"content": "Siete voi? Figli miei? Ci siete riusciti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390103,
					"content": "No... Riesco a sentirlo. Non siete voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, sembra che questa persona abbia perso la vista prima di diventare un'immagine residua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390105,
					"content": "Chiunque voi siate, potreste aiutarmi? Aiutatemi a trovare i miei figli! Devo dire loro qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390106,
					"content": "Per prima cosa, chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Il mio... Il mio nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390108,
					"content": "Ho... dimenticato il mio nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390109,
					"content": "Ricordo solo che... Un tempo mi sono fatto avanti per Byakuyakoku, e ho combattuto per la speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390110,
					"content": "Ancora oggi, rimango un membro della Resistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390111,
					"content": "Ma a cosa dovresti resistere quaggiù a Byakuyakoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390112,
					"content": "A quei luridi nobili che si sentono tanto superiori, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390113,
					"content": "Dicono di aver ricevuto qualche decreto divino e sventolano la bandiera degli dèi, ma non pensano che ai loro istinti animaleschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390114,
					"content": "In apparenza, custodiscono il Figlio del sole. Ma in realtà, sono i veri sovrani della nazione... Luride sanguisughe che consumano la carne e il sangue del popolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390115,
					"content": "Devono. Essere. Distrutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390116,
					"content": "Ti ricordi tutto questo così bene, ma non sai nemmeno qual è il tuo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390117,
					"content": "Questo dimostra solo quanto siano crudeli i loro metodi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390118,
					"content": "Dopo il nostro precedente fallimento sono stato catturato, imprigionato e torturato presso questo altare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390119,
					"content": "Questa prigione è malvagia. Anche adesso, sento la mia anima che viene triturata, privata di cose preziose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390120,
					"content": "Ti prego, anima gentile, ti supplico! Aiutami a trovare i miei figli, finché ne avrò ricordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390121,
					"content": "Di' loro di non arrendersi mai, perché la speranza è con loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390122,
					"content": "I tuoi figli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "C'è un gruppo di giovani menti brillanti che mi segue. Sono i miei studenti, nonché la nostra forza di riserva. Li considero alla stregua di figli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390124,
					"content": "Le persone malvagie al vertice hanno cercato di farmi parlare in qualsiasi modo per farmi tradire i miei figli, ma non ci sono riuscite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390125,
					"content": "Dopotutto, la speranza risiede in loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390126,
					"content": "Probabilmente, a questo punto saranno tutti spariti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390127,
					"content": "No, mai! Sono dei bravi figli. Non tradiranno i nostri ideali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390128,
					"content": "Io non mi sono arreso... E credo che non l'abbiano fatto neanche loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390129,
					"content": "Come li troveremo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Questo me lo ricordo. Certo che lo ricordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390131,
					"content": "Lasciate che vi dica dove si nascondono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390132,
					"content": "Ma se li troviamo, come dovremo presentarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390133,
					"content": "\"Siamo venuti qui perché ce l'ha detto un membro della Resistenza che ha dimenticato il suo nome\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390134,
					"content": "No, non funzionerebbe. Sono stati ben addestrati. Se non fornirete delle prove, non si fideranno di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390135,
					"content": "Ma non riesco nemmeno a ricordare il mio nome... Maledizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390136,
					"content": "#Sembra che un tempo questo tizio fosse un criminale ricercato di Byakuyakoku, {NICKNAME}... Di quelli di cui si parla nei libri di storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390137,
					"content": "Paimon scommette che per noi non dovrebbe essere difficile trovare informazioni su di lui. Magari persino nelle vicinanze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390138,
					"content": "Se il mio nome dovesse passare alla storia, spero che i fatti vengano scritti da coloro che erediteranno le nostre volontà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				}
			]
		},
