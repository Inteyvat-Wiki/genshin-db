			},
			"dialogs": [
				{
					"id": 722391801,
					"content": "Dopo il sole, inizia la vera luce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391802
					]
				},
				{
					"id": 722391802,
					"content": "Dopo cosa, inizia che? Andate via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				}
			]
		},
		{
			"id": 7223919,
			"completionStepIds": [
				7223906
			],
			"beginWay": "TALK_BEGIN_NONE",
