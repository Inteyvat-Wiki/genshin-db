				"objectNames": [
					"Adonis",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "Dopo il sole, inizia l'oscurità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "...Ma la vera luce si cela... nei nostri cuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "...L'avevo quasi dimenticato. Era da tanto che non sentivo questa frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "#Dimmi, compagn{F#a}{M#o}, chi vi manda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Il maestro Spartacus?! Vi ha mandato il maestro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Adesso dov'è? So solo che è stato catturato durante la rivolta dagli sgherri del Figlio del sole. Da allora, abbiamo perso ogni contatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "#È stato imprigionato presso l'altare del Cuore del Serpente e, a giudicare da come stanno le cose, non può uscire. Ecco perché ci ha mandat{M#i}{F#e} a cercarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Quel maledetto Figlio del sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Che istruzioni vi ha affidato il maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Ci ha affidato solo un messaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "\"Non arrendetevi mai, figli miei. La speranza di Byakuyakoku è con voi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "Mi... Mi dispiace! Ti abbiamo deluso, maestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "La Resistenza non esiste più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Cosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Dopo la cattura del maestro, la struttura della Resistenza è collassata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Siamo riusciti a scappare solo noi studenti che lo seguivamo assiduamente, dal momento che eravamo lontani dal cuore degli eventi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "In seguito, i fortunati tra di noi che sono riusciti a scappare si sono rifugiati nei nascondigli preparati in precedenza, con la speranza di radunare ancora una volta le forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Tra di noi ci sono eccellenti strateghi, studiosi professionisti, esperti nelle arti mistiche e abili dottori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Beh, sembra promettente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "È quello che pensavamo anche noi. Con il tempo, credevamo di poter infondere nuova linfa vitale al movimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Ma per tutto questo erano necessari dei fondi... che non avevamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Così, qualcuno ha suggerito di vendere le Sfere d'osso di drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Cos'è una Sfera d'osso di drago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "È un raro frutto prodotto dai Fiori d'osso di drago in determinate circostanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Il suo profumo può rilassare la mente e calmare i pensieri ansiosi, spazzando via tutte le preoccupazioni. Per questo, può raggiungere prezzi particolarmente elevati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "È davvero così mistico? Sicuro che non sia una truffa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Magari si fosse trattato di una menzogna! Ingenuo com'ero, non mi sono accorto dei pericoli in agguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "Non conosco le origini della formula, ma so che ci ha fatto guadagnare parecchio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Stava andando tutto così bene... Ma presto, abbiamo scoperto che alcuni dei nostri compagni cominciavano a evitare il conflitto e a rifiutare l'idea di scendere in battaglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "Il numero di queste persone aumentava sempre di più, tanto da chiedere di abbandonare i nostri ranghi. Non sono stato in grado di fermarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Com'è successo? Le sfere hanno arricchito te e i tuoi compagni al tal punto che le persone si sono stancate di lottare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Intendi il fascino corruttore del denaro? No... Io... Non lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "So solo che quando la gente oppressa è soddisfatta della propria esistenza, smette di lottare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Quello è stato l'inizio della fine. E, una volta iniziata, non c'è stato modo di fermarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "A volte, mi chiedo se la formula per realizzare questo tipo di cose non sia stata divulgata da quegli spregevoli sovrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "A volte mi domando se il fatto che quelle sfere siano così richieste non sia tutta opera di quegli spregevoli sovrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*sospira* Se il maestro fosse stato lì, sono sicuro che sarebbe stato in grado di controllare la situazione. Sarebbe anche riuscito a stroncarla sul nascere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Mi dispiace, maestro. Non siamo riusciti a essere la speranza di cui parlavi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Mi dispiace molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Non posso, in queste condizioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "Tuttavia, vi ringrazio per le notizie che mi avete riferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Non ho nulla con cui ringraziarvi. Ma, permettetemi di condividere con voi il segreto delle Sfere d'osso di drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Possono essere create solo usando l'acqua del Tokoyo Reisen, ovvero l'Acqua di Lethe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Forse potreste scambiarle con del denaro, o tenerle per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Tuttavia, siate prudenti. Non abbandonate mai la motivazione ad andare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Vuoi vedere il tuo maestro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Su questa lapide sono scritte due righe di testo. La prima riga è scritta nella lingua di Byakuyakoku, ed è incomprensibile.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 722392402,
					"content": "La seconda riga è scritta in una lingua comune, e c'è scritto:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 722392403,
					"content": "\"Qui giace Spartacus il Giusto, conosciuto ora come Supada no Hiko. Di seguito l'elenco dei suoi crimini. Che servano da monito per ricordare la nostra storia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Antica stele di pietra"
				},
				{
					"id": 722392404,
					"content": "\"Supada no Hiko, famigerato fuorilegge, mente criminale e sobillatore di disordini. In nome dell'Ookami di Tokoyo, possa essere privato della vista e lasciare che la sua anima venga schiacciata. Che sia gettato in una prigione profonda, ora e per sempre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antica stele di pietra"
				}
			]
		}
	]
}