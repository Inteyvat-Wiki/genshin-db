			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Va bene, siete con i Cacciatori di tesori, giusto? Nella lettera mi sembrava di avervi suggerito di fare come me... Mettere una maschera, un costume e così via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "Ma sembra che vi sia sfuggito il promemoria. Eheheh... non male però... bel coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Tsk! Beh, sai cosa c'è? Noi non abbiamo bisogno di andare in giro con fare furtivo e nascondendo la nostra identità! Perché, a differenza di te, non faremmo mai qualcosa di così vergognoso da doverci nascondere dietro a una maschera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "Seriamente?! Ero nel bel mezzo del mio discorso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Secondo me è solo che gli piacciono i travestimenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Aspettate un attimo... voi non siete Cacciatori di tesori! Che cosa state combinando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "Il costume non è mica male però...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
