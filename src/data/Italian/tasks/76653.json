			"dialogs": [
				{
					"id": 766530201,
					"content": "Dove ho sbagliato? Se solo avessi studiato di più la teoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Ok, non c'è bisogno di confermare quest'ordine... Lei è Ginette, un'ingegnera di Fontaine. Tra tutti gli ordini che ho ricevuto, questo è decisamente il più interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Finalmente sei qui! Allora c'è ancora speranza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "#Ehilà! Siamo {F#le}{M#gli} assistenti di Aino... O meglio, Paimon pensa che possiamo definirci così. Di cosa hai bisogno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Ha creato un tipo di robot che può usare il Kuuvahki per comunicare su lunghe distanze... Il che sembra divertentissimo! Però ha incontrato un sacco di problemi e vuole che la aiuti a risolverli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Mi vergogno ad ammetterlo, ma la mera curiosità non porterà a nulla. Alla fine, si vede che è tutta questione di pratica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Non sembra molto difficile... Lascia fare a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Mi vergogno un po' a dirlo, ma... vorrei modificare il mio ordine. Mentre aspettavo la tua risposta, ho... Beh, fatto un altro disastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "All'improvviso mi sono chiesta se un cambio di ambiente non potesse risolvere il problema, così ho condotto altri test in aree con concentrazioni di Kuuvahki diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "Ma i malfunzionamenti dei robot non accennavano a smettere, e così ho finito per perderli. Quindi... oltre all'eliminazione degli errori, non è che potresti aiutarmi anche a recuperarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Hai perso i robot? Tutti quanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Se devo pagare un extra, prometto che troverò un modo per farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Mmh... Dovrebbero esserci molti modi per rintracciarli. Dato che i robot sono alimentati a Kuuvahki, dovrebbero lasciarne dei residui ovunque vadano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Ti preparerò un dispositivo speciale. Lo userai per raccogliere abbastanza residui di Kuuvahki e rintracciare il robot che li ha lasciati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Mh-mh... Beh, sembra divertente! E, visto che è così, non ti chiederò compensi extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Sul serio?! Oh, grazie, grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}