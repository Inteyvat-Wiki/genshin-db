			"trigger": {
				"objectNames": [
					"\"Pignottina\"",
					"\"Statuetta in legno Esplofiamma\"",
					"Vigée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "Sebbene la Guerriera mascherata non possa volare come la Pacificatrice, tutto ciò che deve fare per vincere è usare le sue cariche al momento giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "\"Pignottina\""
				},
				{
					"id": 755100102,
					"content": "Testa vuota che non sei altro! Non puoi pensare solo alla velocità di corsa in linea retta. Se non riesce a curvare o a colpire niente, è totalmente inutile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "\"Statuetta in legno Esplofiamma\""
				},
				{
					"id": 755100103,
					"content": "Basta così, bambini. Possiamo discuterne in maniera civile, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100104,
					"content": "È quello che stiamo facendo...! È solo che, quando parliamo di grandi guerrieri, ci facciamo prendere la mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "\"Statuetta in legno Esplofiamma\""
				},
				{
					"id": 755100105,
					"content": "Non preoccuparti, Vigée! Potremmo anche avere opinioni discordanti, ma discuteremo in maniera razionale e portando prove!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "\"Pignottina\""
				},
				{
					"id": 755100106,
					"content": "...Ohoh! Mi è appena venuta in mente una nuova strategia. Ti sfido di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "\"Statuetta in legno Esplofiamma\""
				},
				{
					"id": 755100107,
					"content": "Di nuovo, di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "\"Pignottina\""
				},
				{
					"id": 755100108,
					"content": "...Siete molto vivaci, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "#{F#Una nuova cliente}{M#Un nuovo cliente}! {F#Benvenuta}{M#Benvenuto}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100111,
					"content": "#A giudicare dal tuo abbigliamento, sei {F#una viaggiatrice}{M#un viaggiatore}, giusto? Allora abbiamo qualcosa in comune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100112,
					"content": "Vuoi provate questo rotolo di tessuto interattivo che ho realizzato assieme ai bambini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100113,
					"content": "Un \"rotolo di tessuto interattivo\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "In parole semplici, è un gioco che combina il teatro di carta di Liyue, i fumetti di Inazuma e la tecnologia cinematografica di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100116,
					"content": "È basato sui famosi eroi locali e include il concetto di \"Sfide crossover\" per creare una nuova storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100117,
					"content": "Provalo! Chissà, potrebbe essere una nuova esperienza per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100118,
					"content": "Con piacere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Fantastico! Divertiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100114,
					"content": "Un rotolo che si muove per conto proprio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
