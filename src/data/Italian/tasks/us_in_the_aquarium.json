			"dialogs": [
				{
					"id": 747050101,
					"content": "Uhm, forse... Questo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "Sì, posso capire perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "Perché proprio quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "Guardate il colore della coda, è la cosa più alla moda di tutto l'acquario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "I colori sono un po' troppo sgargianti per i miei gusti, ma va bene, lo prenderò come un complimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "Cavoli, quanta gente! Siete tutte qui per vedere i pesci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "Mh-mh, ho appena finito di girare una scena, quindi mi sto prendendo un attimo per ammirare il vostro acquario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "Di che parlavate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "Stavamo cercando di decidere quale pesce somiglia di più a Chiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "Lo fate anche voi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "Oh, ehm, eheh... Beh, in realtà è stata Colombina a parlarne per prima. Sembrava divertente, così abbiamo iniziato a farlo anche noi senza rendercene conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "Quindi è contagioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "Oh, guardate! Quello è proprio come te, Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "Che vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "Non sta mai fermo, nuota avanti e indietro nella vasca. È proprio come te che ti alleni ogni secondo della giornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "...Quindi è così che mi vedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
