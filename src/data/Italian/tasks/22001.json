					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "Ecco a voi il capitano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010302,
					"content": "Che hai combinato... loro non dovrebbero essere qui! Avresti dovuto depistarli, in modo che io e Lulu avremmo avuto il tempo di scappare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010303,
					"content": "#Perché tu e Lulu potete scappare mentre io devo restare qui a trattenere {F#le}{M#i} pirat{F#esse}{M#i}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010304,
					"content": "Ho un'idea migliore: ti consegno a loro e fuggo via con Lulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010305,
					"content": "Ma... Beidou dice che non bisogna mai abbandonare i propri amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010306,
					"content": "Beidou dice anche che il capitano dovrebbe fuggire via con la sua persona preferita alla prima difficoltà?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010307,
					"content": "Come osi... Non condividerò mai più i miei frutti di loto con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010308,
					"content": "Bene! Non mi importa, sei tu ad essere fissato per quegli stupidi frutti di loto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010309,
					"content": "Paimon pensa che stiano leggermente esagerando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Non preoccuparti, so cosa possiamo fare per risolvere questa situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010311,
					"content": "Adorano i frutti di loto... Sono probabilmente l'unica cosa che li tranquillizzerebbe in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010312,
					"content": "Potresti andare a cercare dei frutti di loto per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010313,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Grazie! Devi fare in fretta, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010315,
					"content": "Non stanno litigando per i frutti di loto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Oh... Davvero? Per cosa stanno litigando, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010317,
					"content": "In ogni caso, vai a cercare dei frutti di loto. Non possono continuare a litigare in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
