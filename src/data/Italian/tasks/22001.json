			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, oggi farò io il capitano, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010102,
					"content": "Dai Lulu, ho fatto il capitano così tante volte di fila, ora è il momento che lo faccia Fei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010103,
					"content": "Ma io voglio che lo faccia sempre tu! Sei così bravo a fare il capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010104,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Vorremmo fare un gioco. Mi avevano promesso che stavolta avrei potuto fare io il capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010106,
					"content": "Ma Lulu continua a dire che è più divertente quando lo fa Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010107,
					"content": "*sospira* Lulu fa sempre così... Ma se è quello che vuole... vorrà dire che mi accontenterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010108,
					"content": "#Ehi, puoi giocare con noi, se hai tempo! Potresti fare {F#la}{M#il} pirat{F#essa}{M#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010109,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "*sospira* Come sempre, devo fare di nuovo il primo ufficiale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010113,
					"content": "#Facciamo come la volta scorsa: quando ti senti pront{F#a}{M#o}, raggiungici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010111,
					"content": "#Non voglio fare la parte {F#della}{M#del} cattiv{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "*sospira* Ah, quanto vorrei fare il capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Piccolo Fei"
				}
			]
		},
