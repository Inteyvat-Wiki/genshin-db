			"dialogs": [
				{
					"id": 220010401,
					"content": "Hai trovato i frutti di loto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010402
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010402,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010404,
					"content": "Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010405,
					"content": "Smettete di litigare. Finirete solo per stancarvi inutilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010406,
					"content": "È solo un gioco, non c'è bisogno di agitarsi tanto. Siamo tutti amici, ricordate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010407,
					"content": "Guardate un po' qui... Frutti di loto appena raccolti! Avanti, servitevi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010408,
					"content": "Dopo che avrete finito di mangiare, risolveremo la questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010409,
					"content": "Decideremo chi farà il capitano e chi il primo ufficiale, e in quale ordine. Va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010410,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220010411,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010412,
					"content": "Wow, ha funzionato davvero! Ah, un po' di pace, finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Te l'avevo detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010414,
					"content": "Come sapevi che avrebbe funzionato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Giochiamo insieme da tanto tempo. Li conosco piuttosto bene, ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010416,
					"content": "La Piccola Lulu fa miracoli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Eheheh, grazie. Anche se in realtà è Beidou a fare miracoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220010418,
					"content": "Spero di diventare come lei da grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
