						220010602
					]
				},
				{
					"id": 220010602,
					"content": "Possiamo iniziare, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010603
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010603,
					"content": "Non mi piace fare il primo ufficiale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010604,
					"content": "Lulu e Meng pensano solo a sé stessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010605,
					"content": "Per mille balene! Cosa vedono i miei occhi? Un bel bottino! Consegnamelo subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "#Ciao, pirat{F#essa}{M#a}. Mi dispiace, sono solo un misero primo ufficiale, non ho niente da farti rubare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220010607,
					"content": "Se vuoi saccheggiare la nave, devi trovare qualcuno che abbia abbastanza soldi... Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Piccolo Fei"
