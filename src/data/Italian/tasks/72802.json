			},
			"dialogs": [
				{
					"id": 728020601,
					"content": "Dov'è fuggita nostra figlia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Anche se lavora il giorno dopo, di solito Atsuko ci dice sempre qualcosa prima di partire. Ma oggi se n'è andata senza dire niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "#Ieri, dopo che te ne sei andat{F#a}{M#o}, Atsuko ha detto che era stanca ed è andata dritta nella sua stanza a dormire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Quando ci siamo alzati il giorno dopo, non era più a letto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "L'abbiamo cercata ovunque. Mio marito ha controllato dappertutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Anche dopo aver passato mezza giornata a cercarla, non siamo riusciti a trovare nessuna traccia di nostra figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "*sospira* Forse è partita per un altro viaggio? Che ragazza problematica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Calmati, cara. Continuerò a cercarla. Per favore, prima spazza la stanza di Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Quando è partita, Atsuko non ha chiuso bene la finestra. Molte foglie sono entrate nella stanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "Ah, prima che me ne dimentichi. Ecco il tuo pagamento. Tieni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "*sospira* Atsuko... Dove si sarà cacciata questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Atsuko è andata di nuovo a lavorare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
