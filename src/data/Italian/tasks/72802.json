						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoh",
					"Michiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "Atsuko non è ancora a casa. Per favore, torna stasera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Atsuko dovrebbe tornare verso sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko dovrebbe essere tornata ormai. Bussiamo alla porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Sembrano parlare di qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Comunque, mi chiedo cosa sia successo al tanuki che abbiamo salvato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Sei troppo gentile. Quel tanuki aveva solo un piccolo graffio sulla zampa. Se l'avessi lasciato tra i cespugli, si sarebbe ripreso da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Non potevo farne a meno. Mi guardava con le lacrime agli occhi. Mi ha fatto pietà. La mia coscienza mi ha obbligato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Va bene. Fare buoni azioni non è mai sbagliato. Solo che ha mangiato un po' troppo, quasi quanto me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "Toc toc",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "#Sono {F#la}{M#il} viaggiat{F#rice}{M#ore} di prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Ahh, mi ricordo di te. Aspetta qui, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "C-Ciao! Sono Atsuko, piacere di cono... Ehm... che piacere vederti di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Scusa, ma mi mancava casa. Dopo averti dato la lettera, ho cambiato idea e sono salita su una nave per Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Ahahah... Mi dispiace di non aver chiarito le cose e di averti fatto fare tutta questa strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Come sei tornata a Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "...Ah, a modo mio, ahah. Non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Ehm, ho preparato il pagamento. Tieni. Grazie dell'aiuto. Sbrigati... Ehm, sbrigati e goditi il resto della giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Come mai le cose che Atsuko ci sta dicendo ora sono diverse da quello che ci ha detto prima? Se tornare a Inazuma era così facile, perché ci hai chiesto di aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Cos'è successo ai tuoi affari a Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Affari? Ma quali affari? Avevo affari a Liyue?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "...Ah, quella roba è insignificante. La famiglia è la cosa più importante. Ho già affidato tutto a qualcun altro, ah... Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Aspetta! La vera Atsuko ha avuto problemi a trovare un lavoro a Liyue, non è possibile che sia diventata improvvisamente ricca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Chi sei tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "Io... Io sono Atsuko, ovviamente! Ho l'aspetto e la voce di Atsuko. Perché tanti sospetti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Guarda qui! Smettila d'insistere... Lascia perdere. Non ho più niente da dirti. Devo lavorare domani. Me ne vado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Atsuko! Perché s'è arrabbiata all'improvviso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "#Mi dispiace, viaggiat{F#rice}{M#ore}. Dev'essersi stancata troppo al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Ma l'avete vista voi stessi. Quella è nostra figlia. La lettera... Forse se n'è dimenticata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Vorremmo comunque ringraziarti per il disturbo. Per quanto riguarda il pagamento... Potresti aspettare ancora un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "No, per niente. Possiamo ancora permetterci di pagarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Ti abbiamo già detto che Atsuko lavora tutto il giorno, no? Ma la paga che riceve è sempre strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Porta sempre a casa degli strani semi o della frutta selvatica, ma mai dei Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Sebbene cose del genere non siano completamente senza valore, prima dobbiamo venderle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "#Immagino che {F#una}{M#un} viaggiat{F#rice}{M#ore} come te preferisca i Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Per favore, torna domani, quando potremo darti dei Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Se c'è qualche problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "E la tua villa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Villa? Cosa? Avevo addirittura una villa a Liyue?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
