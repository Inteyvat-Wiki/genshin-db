			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michiru",
					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Quanti piatti dovremmo preparare per il pranzo di domani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "I nostri bambini mangiano molto ultimamente. Prepariamo qualche piatto in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Mmh? E chi saresti tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Questa è casa di Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Sì. Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Atsuko mi ha chiesto di portarvi questa lettera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Una lettera? E perché mai dovrebbe scriverci una lettera così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "La lettera è un po' lunga... Cioè, è già a casa, quindi se vuole dirci qualcosa, può dircelo direttamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#...Viaggiat{F#rice}{M#ore}, sembri sorpres{F#a}{M#o}. È vero che Atsuko stava viaggiando all'estero, ma è tornata ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Perché ci manda una lettera se è già a casa con noi? Ci hai scambiati per qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Aspetta un attimo, cara. Ho dato una lettura veloce alla lettera. La grafia e il modo di scrivere sono sicuramente di nostra figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "La lettera dice anche che non ha intenzione di tornare nell'immediato futuro, e ci chiede di prenderci cura di noi stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "#Ma cosa significa tutto ciò? Può essere che sia tornata a casa mentre quest{F#a}{M#o} viaggiat{F#rice}{M#ore} veniva a consegnarci la lettera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Credo ci sia stato un fraintendimento. Glielo chiederemo quando tornerà a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Purtroppo, oggi Atsuko aveva delle cose da fare. Le chiederemo delle spiegazioni quando sarà a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Se non ti crea problemi, vienici a trovare domani sera. Le chiederemo di spiegarti tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Dov'è adesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Ha detto di avere molto lavoro da fare. Dopo colazione, se n'è andata di fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Sì, ogni giorno parte presto e torna tardi. La vediamo solo la sera, quindi non siamo sicuri di cosa stia veramente combinando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Comunque, torna domani sera. Se ha fatto qualcosa di sbagliato, ci assicureremo che ti chieda scusa di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Ci dispiace molto che tu abbia fatto tutta questa strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Quella Atsuko, se solo fosse più educata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Perché solo la sera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Ha detto di avere molto lavoro da fare. Se ne va dopo colazione e sta fuori casa per tutto il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko è... tornata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Per caso siete i genitori di Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
