			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "Perché nostra figlia è arrivata a casa prima della data in cui è stata firmata questa lettera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Meglio non pensarci troppo. Probabilmente si tratta di un malinteso. Sarebbe più utile se mi aiutassi a capire cosa preparare per pranzo domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280204",
							"2"
						],
