				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "...Aria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Questo andava ben oltre una semplice punizione, e non era certo la prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Che si tratti della città dei draghi che il nostro re ci ha affidato, o delle splendide ma fragili dimore costruite da quei minuscoli umani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Quante altre vite innocenti dovrete veder morire prima di smetterla di restare a guardare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Se il nostro re fosse ancora qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "Ma lui non è qui, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Se quel sovrano tutt'altro che onnipotente crede che questo pallido e orribile destino sia \"ordine\", se questo è l'unico modo per salvare questo mondo condannato a essere divorato, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Non importa quanto sia gravoso il prezzo richiesto... e non importa quanta sofferenza quel prezzo mi arrechi, è comunque meglio di un silenzio nero come la pece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "Se il mondo è destinato alla distruzione... che senso ha combattere l'oscurità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "...Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "L-Lascia stare, Aria! Dimentica ciò che ho detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Penso solo che non dovremmo restare a guardare mentre quel tiranno massacra gli esseri viventi che ripongono la loro fede in noi... Che si tratti di draghi o di quei piccoli umani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Non dovremmo... salvarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "...Posso capire la rabbia di Sonnet, Aria. Per me, quello che ha fatto quel sovrano è stato fin troppo crudele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Se c'è anche solo una minima possibilità... voglio fare tutto ciò che è in mio potere per salvare coloro che possono essere salvati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "Ma... che ne sarà di tutti gli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Coloro per i quali non c'è salvezza, le cui vite sono ormai perdute per sempre... Il loro sangue, le loro lacrime e le loro grida di agonia sono forse destinate a svanire nel nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "No... Non è così che deve essere. Io voglio che tutti possano essere salvati, e che nessuno debba cadere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Se solo il suo \"ordine\" perisse insieme a lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "...Sonnet. Non dimenticare la ragione per cui siamo nate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "La nostra unica missione è preservare questo mondo finché il nostro re, colui che ci ha donato la vita, non tornerà dal suo lungo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Sapevamo fin dall'inizio quale sarebbe stato il costo di questo ordine... ma non potevamo permettere che il mondo marciasse verso la distruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "...No, questo non ha nulla a che fare con l'ordine, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, per noi... per me, tu sei la nostra amata sorellina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "Quindi... ti prego, non fare nulla che possa ferire me e Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Non tentare di sfidare l'ordine imposto dal cielo. Almeno... non adesso, mentre il mondo è così vulnerabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Canon... Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth mi ha menzionato una parola che solo gli esseri umani possono rivendicare... \"Speranza\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Finché c'è vita, c'è speranza... Ci sarà sempre speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}