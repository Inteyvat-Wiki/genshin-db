					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "Ecco fatto, dovrebbero essere a posto. Non penso che qualcuno si farà più male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "Non rispecchiano lo stile della locanda, però...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Non posso farci molto. Non sono certo un artigiano di pregio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Un attimo... Ho riparato un buco, ma devo ancora aggiustarne un altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Beh, per oggi mi accontenterò. La locanda è ancora aperta e devo tornare dentro per i clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Indipendentemente da quanto urgente sia la riparazione, gli affari sono affari... Grazie per l'aiuto, eccoti qualcosa per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
