				{
					"id": 221120301,
					"content": "Le hai trovate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Vediamo... Sì, penso che basteranno. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "Bene, mi metto all'opera. Devo completare la riparazione il prima possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
