			"dialogs": [
				{
					"id": 221120201,
					"content": "Le hai trovate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Sono qui fuori, non dovrebbe essere difficile trovarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Vai a dare un'occhiata. Io devo rimanere qui per evitare che qualcuno un po' distratto possa farsi male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
