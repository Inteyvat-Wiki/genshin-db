			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Fantastico! Sapevo che avresti trovato un modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Il Pigrariete non può sopravvivere in regioni prive di Kuuvahki, ma almeno può offrire a quel signore un po' di conforto durante il suo soggiorno a Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Ora devo andare. Ecco un pensierino per dimostrarti la nostra gratitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
