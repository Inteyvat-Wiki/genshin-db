			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "Ah, questo è il compagno di quel mercante straniero perso nella grotta, no? Quindi sei riuscito a tirarlo fuori, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Sappiamo tutti che il Pigrariete ti segue solo per disperdere i semi che trasporta più lontano, ma quel signore non ci ha creduto, per quanto glielo spiegassimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#Sinceramente, non sapevo proprio cosa fare, quindi è una fortuna che abbia incontrato {F#un'avventuriera}{M#un avventuriere} così disponibile come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Ecco, un piccolo segno di ringraziamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
	]
