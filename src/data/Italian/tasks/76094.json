			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "Come faccio a tirare fuori quel tizio da lì? Che seccatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Posso esserti d'aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#Mmh? Oh! {F#Una gentile avventuriera}{M#Un gentile avventuriere}. Arrivi al momento giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Dunque, qui c'era una galleria che portava a nord, ma è crollata di recente a causa di una sorta di anomalia con il Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Per fortuna nessuno si è fatto male, ma un mercante itinerante d'oltremare sostiene che il suo \"compagno\" sia rimasto intrappolato all'interno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "È un Pigrariete di queste parti con cui ha stretto amicizia. Se resti qui abbastanza a lungo, noterai che i Pigrarieti di solito seguono le persone solo per spargere i semi che trasportano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Glielo abbiamo spiegato in tutte le maniere, ma quel signore non vuole sentire ragioni. Ha insistito affinché trovassimo un modo per salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Per ricollegare il sentiero che porta nelle profondità della grotta, dovremmo usare questi Fiori intricati. Il problema è che non posso usare la magia degli Eredi della Luna gelata e non ho dispositivi a Kuuvahki abbastanza potenti per questo lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "#Ma la fortuna ha voluto che tu passassi di qui. Se c'è qualcuno che può tirare fuori quel Pigrariete di lì, è {F#un'avventuriera}{M#un avventuriere} come te, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "Ti ringrazierò a nome di quel signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
			"id": 7609402,
