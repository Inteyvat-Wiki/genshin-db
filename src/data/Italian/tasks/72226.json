			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260302,
					"content": "Il trespolo sembra in buone condizioni. Sono sicuro che il rituale andrà bene questa volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260303,
					"content": "È stata una passeggiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "È stato piuttosto rischioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#Hihi. Siamo viaggiat{F#rici}{M#ori} espert{F#e}{M#i}, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260306,
					"content": "#In effetti, {NICKNAME}, da dove vieni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260307,
					"content": "Le persone che sono state qui prima hanno parlato di luoghi chiamati Inazuma e Isola di Narukami. Vieni da Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260308,
					"content": "Beh, in un certo senso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "#Sì, in effetti siamo venut{F#e}{M#i} dall'Isola di Narukami... Aspetta un attimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260310,
					"content": "Paimon aveva quasi dimenticato che siamo qui per il Maushiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260311,
					"content": "Veniamo da un posto molto, molto lontano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "È vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260314,
					"content": "#Wow! Sei salit{F#a}{M#o} sulla testa di un drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260315,
					"content": "Beh, era una situazione piuttosto... scomoda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Non è stato male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "Incredibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260318,
					"content": "Il mondo è grande, ragazzino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260319,
					"content": "Non immaginavo ci fossero così tanti posti oltre il Mare di nebbia. Se un giorno me ne andrò, voglio vederli tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260320,
					"content": "Dicono che, se usciremo dalla nebbia, la nostra anima andrà perduta, e che la nebbia ci protegge dall'oscurità del mondo esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260321,
					"content": "Ma ho incontrato un bel po' di persone che provengono dal mondo esterno. Ecco perché so che il Mare del silenzio è abitato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260322,
					"content": "Se ne avrai la possibilità, puoi venire con noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Va bene! Affare fatto, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260324,
					"content": "Andate avanti voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260325,
					"content": "Quando il rituale sarà finito, andremo a esplorare insieme il mondo al di fuori dell'Isola di Tsurumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260326,
					"content": "Certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
