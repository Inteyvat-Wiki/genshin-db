			"dialogs": [
				{
					"id": 761800401,
					"content": "Eravamo solite riunirci nel tuo giardino, Sandrone. Ora sei tu a farmi visita per il tè. Che strana sensazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800402,
					"content": "Sono ancora io a preparare tutto, per me non cambia poi molto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800403,
					"content": "Mh-mh, e il tuo cibo è delizioso proprio come lo ricordavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800404,
					"content": "#Mmh... Ho sentito che {NICKNAME} viene spesso a trovarti. Cosa fate di solito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800405,
					"content": "A volte chiacchieriamo, a volte giochiamo con le Kuuhenki, ci piace guardarle anche mentre disegnano. Ah, e giochiamo anche a Scacchi lunari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800406,
					"content": "Scacchi lunari? È quel gioco dove bisogna allineare tre pezzi? Chi vince, di solito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800407,
					"content": "#Non tengo il conto, ma devo ammettere che {NICKNAME} è {F#una giocatrice}{M#un giocatore} davvero abile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800408,
					"content": "Eheh, ti farò vedere cos'è la vera abilità. Ti va una partita? Se pareggiamo, per te varrà come una vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800409,
					"content": "Volentieri. Giochiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
