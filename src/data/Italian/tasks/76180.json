			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"La Damigella"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "M-Ma come? Non è possibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800602,
					"content": "Sembra che tu abbia perso, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800603,
					"content": "I-Io... Ti ho lasciato vincere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800604,
					"content": "Davvero? E allora perché sembri così agitata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800605,
					"content": "Porca miseria... Voglio la rivincita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800606,
					"content": "Umpf, è stata una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800607,
					"content": "Hai vinto. Sei davvero brava, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800608,
					"content": "La prossima volta giochiamo a qualcosa di più impegnativo. Conosco molti giochi divertenti basati sulla matematica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800609,
					"content": "Sembra interessante! Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800610,
					"content": "Eh? Che c'è da ridere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800611,
					"content": "Credo di non averti mai vista così felice. Non m'invitavi quasi mai a giocare... Anzi, di solito mi cacciavi via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800612,
					"content": "Ehi... Così mi fai passare per una prepotente! D'ora in poi ti inviterò a prendere il tè più spesso, ti va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800613,
					"content": "Mi piacerebbe molto, Sandrone. Questi piccoli ritrovi sono piacevoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
