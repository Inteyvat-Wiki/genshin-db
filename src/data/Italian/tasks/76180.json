			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "È molto divertente giocare con te, non vedo l'ora di farlo ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800802,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761800804,
					"content": "Vai già via? D'accordo, alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761800803,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
