			"dialogs": [
				{
					"id": 110231101,
					"content": "Questo è il luogo del delitto. Il corpo di Havria si dissolse, non lasciando altro che queste tracce di sale. I suoi ultimi istanti sono rimasti sospesi nel tempo fino ad oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "La storia narra che alcuni dei suoi fedeli compresero che questa dea, gentile e magnanima ma debole, non avrebbe mai protetto nessuno in una guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "La Guerra degli Archon fu estremamente crudele. Anziché consegnarla all'agonia della sconfitta, i fedeli pensarono che forse sarebbe stato meglio donarle una morte veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Ma... e quelle statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "Non importa quanto sia debole una divinità: il potere che scaturisce da essa quando viene uccisa non può essere sostenuto da miseri corpi mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Coloro che non poterono fuggire vennero trasformati così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "I fedeli che scamparono da questo disastro raggiunsero Liyue, dove cercarono riparo da Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "I loro discendenti temevano i resti di Havria, e vissero nel terrore che lei avesse scagliato su di loro una maledizione eterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "Rischiarono quindi le loro vite per venire qui e spezzare la spada, prostrandosi alla dea nella speranza di placare la sua ira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Ma non c'era necessità che lo facessero. Come avrebbe potuto una dea che non era mai riuscita a opporsi a nessuno, nemmeno alla fine, nutrire rancore per la sua gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "I-Io... Anche se è così, non riesco a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "Dev'essere una menzogna... una storia falsa... Tutto quanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Non osare... stravolgere la mia fede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Caspita, Zhongli è stato proprio spietato questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "Questo è il prezzo che deve pagare... Ma non tutto il male viene per nuocere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "A guardarla, temo che faticherà ad accettarlo per un bel po'. Ma anche se sul momento soffrirà, riconoscere la verità è già un bel passo avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Sembri conoscere fin troppo bene cos'è accaduto alla Dea del sale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "Hai ragione. In passato, la storia di Havria è stata un monito anche per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "La fede in un dio che è già morto non porta da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "È così per Havria, ed è così anche per Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Un giorno, la gente di Liyue lo capirà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Bene. Ora, vi andrebbe di accompagnarmi in un viaggio fino alla Foresta di pietra di Guyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Eh? E perché vuoi andare lì, Zhongli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "*sospira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Tornare a calpestare un sentiero battuto, raccontare vecchie storie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "È impossibile non pensare a vecchie conoscenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Non è che hai sentito delle dicerie su come rompere i sigilli, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "#No. Sei davvero {F#una buona osservatrice}{M#un buon osservatore}. Ma non è questione di saggezza, solo di maturità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}