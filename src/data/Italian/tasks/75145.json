					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450227,
					"content": "#Hihi, allora in marcia! Dobbiamo aiutare {REALNAME[ID(2)|SHOWHOST(true)]} a crescere forte e sano!",
					"roleType": "TALK_ROLE_NPC",
