			"dialogs": [
				{
					"id": 751450101,
					"content": "O Prescelti, Prescelti dei Draghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "La Montagna Sacra giace dinanzi a voi... A patto che... riusciate a sconfiggere il nemico avvolto nell'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "Entrate, Prescelti dei Draghi... Accedete alla Montagna Sacra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Il vulcano... ha eruttato?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "No... Il vulcano è super tranquillissimo... P-Perché, l'avete visto eruttare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME}? {REALNAME[ID(2)|SHOWHOST(true)]}? Che succede? Perché fate quelle facce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Sembrate due investigatori di una light novel che si sono appena resi conto di chi è l'assassino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Qualche \"verità\" in effetti l'abbiamo vista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Spieghi a Paimon cos'hai visto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Eh? Quindi era esattamente la stessa cosa che abbiamo visto noi quando abbiamo incontrato {REALNAME[ID(2)|SHOWHOST(true)]}, appena {F#arrivate}{M#arrivati} a Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "E delle immagini strane?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Ehhhr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "Hai detto di aver già visto delle strane parole in precedenza... Uhm, Paimon non ha visto niente, quindi non può esserne sicura, ma... non è che erano opera della stessa persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Credo proprio di sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Ma stavolta hai visto anche... un gigantesco complesso di rovine e l'Abisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "E anche una \"Montagna Sacra\"... Uhm, non è il nome che gli abitanti di Natlan danno al vulcano? Forse ciò che hai visto ha a che fare proprio con quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Paimon non riesce a scrollarsi di dosso la sensazione che la persona che c'ha fatto incontrare {REALNAME[ID(2)|SHOWHOST(true)]} vuole proprio che andiamo lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Forse troveremo le risposte sulle origini di {REALNAME[ID(2)|SHOWHOST(true)]}... e magari potremo anche incontrare la sua famiglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Comunque... Paimon pensa che dovremmo tenere le orecchie rizzate in caso arrivino notizie sul vulcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Mmh. Pensaci, una delle sei tribù di Natlan, la Comunità dell'Abbondanza, vive lì vicino, vero? Potremmo provare a chiedere a loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Il vero assassino della torta è... Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Cavolicchio! Come l'hai scoperto? Paimon era sicura che non ci fosse nessuno a guardare, mentre si mangiava la signora Torta... Non è vero, in realtà Paimon ha solo rubato dello stufato di carne abbrustolita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Allora... Aspetta, cos'è che avete visto davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "(Spieghi a Paimon cos'hai visto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Quindi, di nuovo quelle strane parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
