				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Basta! Non mi importa quanto supplichi, ho finito di fare lo scrittore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Per gli Archon... Questa è la settima volta che minacci di fare sciopero... l'avessi fatto seriamente almeno una volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Per cosa state litigando, stavolta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#Finalmente, sei qui, viaggiat{F#rice}{M#ore}! Devi aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Da quando hai preso le sue parti l'ultima volta, non ha fatto altro che esagerare. Continua a impormi regole su regole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Dall'assegnazione dei nomi alla trama. Vuole stabilire una serie di... criteri di scrittura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Come faccio a scrivere in queste condizioni?!? Perché non scrive lui, allora?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Questi sono princìpi di scrittura che ho tratto da romanzi di successo. Sono linee guida comprovate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Così stai solo imponendo la struttura di altri romanzi sul mio lavoro. Sto scrivendo il mio romanzo o sto copiando quello di qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Non scriverei mai in modo così rigido... Se vuoi una cosa del genere, allora scriviteli da solo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "E poi, non ci sono già tanti romanzi simili chiusi a marcire dentro la Casa editrice Yae?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "È solo colpa della pubblicità fatta male, non del romanzo in sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Non ha niente a che vedere con la strategia di vendita. È tutto dovuto al modo in cui quegli autori scrivono le loro opere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Forse non li conosci tutti, ma io, in quanto autore, ho letto ogni singolo libro pubblicato dalla Casa editrice Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti portarmi dei romanzi? Io e Shigeru dobbiamo fare una discussione importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Che romanzi dovrei portare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Portami quelli che tengo qui in giro. Li uso spesso come monito... per ricordarmi come non si scrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
