			"dialogs": [
				{
					"id": 220170201,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti portarmi dei romanzi? Io e Shigeru dobbiamo fare una discussione importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "Tsk, se lo lascio scrivere come vuole, rovinerà di certo i romanzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
