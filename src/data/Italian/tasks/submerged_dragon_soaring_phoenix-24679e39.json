				]
			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#La tua tecnica è davvero straordinaria, {F#giovane eroina}{M#giovane eroe}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hihi, puoi scommetterci! {NICKNAME} è imbattibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#In tal caso, mi chiedo se quest{F#a giovane eroina}{M#o giovane eroe} possa dimostrarmi la vera essenza delle <color=#00E1FFFF>Tecniche di balzo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Secondo le cronache, gli antichi maestri dei Guhua, il mio clan, erano capaci di scalare le mura cittadine come si cammina su un terreno pianeggiante. Avendo padroneggiato appieno l'arte di correre sui tetti e scalare i muri, distillarono tali abilità nelle Tecniche di balzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Da non credere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Uhm... Tanto vale fare un tentativo. In fondo, ti sei già {F#arrampicata}{M#arrampicato} un po' ovunque alla ricerca di tesori, no, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "A me sembrano abilità da ladri acrobati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Eheh. Pensaci bene, {F#giovane eroina}{M#giovane eroe}... Un ladro che può scavalcare un muro può sfuggire alla giustizia, e se noi che dovremmo difenderla non fossimo capaci di altrettanto, non potremmo nulla contro i malvagi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
			"id": 7621002,
			"completionStepIds": [
				7621005
