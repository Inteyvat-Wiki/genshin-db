				]
			},
			"dialogs": [
				{
					"id": 762100617,
					"content": "Con un balzo agile, la figura del dipinto atterra proprio davanti a te...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "#Ehilà! Sono Zhangsun Jijing. È un onore incontrarti di persona, giovane {F#eroina}{M#eroe}. Posso chiedervi perché mi avete chiamato? C'è qualche questione urgente da discutere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "Ah, niente di urgente. Ti abbiamo visto saltellare qua e là all'interno del dipinto e ci hai incuriosito un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Ah, comprendo. Stavo semplicemente esercitandomi con le tecniche di passo leggero. Ciò detto, temo di avervi offerto uno spettacolo piuttosto mediocre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100604
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100604,
					"content": "Tecniche di passo leggero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100605,
					"content": "Esattamente. Vedete, poiché la pioggia non cade mai in questo regno, non mi è possibile praticare le arti del \"Taglio della pioggia\" tramandate dal mio maestro. Non voglio che le mie abilità si arrugginiscano per mancanza di pratica, così ho scelto di addestrarmi in cotal modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100606
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100606,
