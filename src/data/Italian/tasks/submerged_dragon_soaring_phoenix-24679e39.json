			"dialogs": [
				{
					"id": 762100301,
					"content": "Ammirate la \"Formazione Guardapruno\" del nostro clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "Posso chiederti di spostarti sui pilastri di pietra nell'ordine che ti indicherò entro il tempo stabilito? Vorrei mi mostrassi di cosa sei capace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Nessun problema, sarà una passeggiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Anche se di \"passeggiate\" ce ne sono da fare parecchie... Uh, lascia perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Bene. Allora, giovane {F#eroina}{M#eroe}, è giunto il momento di dimostrare la tua maestria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "In realtà, scommetto che persino Paimon, maestra del clan Paimon, potrebbe farcela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Cosa?! Che dici, è del tutto impossibile... Aspetta. In effetti, Paimon potrebbe... ma volare sarebbe come barare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
