					}
				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "Davvero sorprendente. Sono profondamente colpito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#In tal caso... avrei un'altra umile richiesta. Mi chiedo se {F#questa giovane eroina}{M#questo giovane eroe} abbia mai sentito parlare delle <color=#00E1FFFF>Tecniche di cammino tra le nubi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Si narra che il nostro Gran Maestro, Guhua, un tempo ascese ai cieli avvolto in una foschia purpurea, camminando nell'aria come fosse terreno solido... E tutto ciò fu reso possibile da null'altro che questa leggendaria arte segreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Mi sembra un po' inverosimile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Già, sembra che se la stia inventando sul momento... Ma in effetti, se usassimo l'aliante, potremmo riuscire a fare qualcosa di simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#Oh? Allora posso chiederti di mostrarmi qualche mossa, giovane {F#eroina}{M#eroe}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Se usassimo l'aliante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
