				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300205",
							"2"
						],
						"stepId": 2300205,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"101955",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Meraviglioso, ce ne sono tantissimi. Sembrano anche ottimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Ecco il tuo compenso, e grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "È lordo o netto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "È netto, ovviamente. Non preoccuparti, non potrei mai farti tornare fino a Inazuma solo per pagare delle tasse scadute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "Ma non posso assicurarti che la politica fiscale dello Shogunato sia rimasta la stessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020306,
					"content": "Mmmh... Dovrei scrivere una lettera a Yousuke e chiederglielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
		{
			"id": 2300204,
			"completionStepIds": [
				2300206
