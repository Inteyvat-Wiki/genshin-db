			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "I funghi qui non sembrano male. Li aggiungerò alla lista della spesa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei? È un nome familiare. Paimon è sicura che l'abbiamo già sentito da qualche parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "...Non era quel tipo a Tatarasuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Accidenti, è il tipo che ha combinato un disastro alla Fornace Mikage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Credo che sia qui in veste di diplomatico straniero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Quindi è davvero qui a Sumeru. Paimon credeva che il fatto che è diventato un diplomatico straniero fosse una battuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "Eh? Capelli biondi... E una cosetta che vola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "#Tu sei {F#la}{M#il} viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Ahah, quindi sei davvero tu. Nella sua lettera, Yousuke accennava a come hai aiutato il signor Xavier a occuparsi della Fornace Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "*sospira* Me ne vergogno molto. Mentre voi riparavate la Fornace Mikage, io mi occupavo del lavoro amministrativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "Il lavoro amministrativo non è più importante della Fornace Mikage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Le tue priorità sono tutte sballate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "Senza il lavoro amministrativo, la manutenzione della Fornace Mikage non sarebbe filata così liscia, sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Io stavo facendo evacuare i dintorni, organizzando i materiali necessari alla riparazione, reindirizzando la forza lavoro necessaria, coordinando la produzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "Senza il sostegno del lavoro amministrativo, sarebbe tutto andato nel caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Toranosuke aveva ragione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Sei all'altezza della tua reputazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke... Quell'uomo disprezza spudoratamente il lavoro amministrativo. Quando lavoro con lui, finisco sempre per avere lavoro aggiuntivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Ma non sono più a capo della Fornace Mikage. Ora lavoro come diplomatico straniero a Sumeru, e mi occupo del commercio di funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "#Ah, viaggiat{F#rice}{M#ore}. Yousuke mi ha parlato delle tue gesta, e crede fermamente che tu sia una persona affidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Se non ti dispiace, mi daresti una mano con una cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Sto cercando un fornitore di funghi affidabile, e ho incontrato numerosi mercanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Ma ogni volta mi mostrano solo la merce migliore che hanno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Credo sia necessario fare un salto alle loro coltivazioni per valutare la qualità effettiva dei loro rifornimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "Ma come vedi, non ho esperienza nel fare indagini all'aperto. Se andassi da solo, non credo che riuscirei a uscire vivo dalla foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "Quindi, vorrei che mi accompagnassi lì per raccogliere dei funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Beh, posso farlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Lo farai? Meraviglioso! Non preoccuparti del compenso, ho già preparato la documentazione contrattuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Dai un'occhiata a questo. Sì, a questo documento. È il tuo contratto d'assunzione, con un'analisi dettagliata della paga e un accordo di riservatezza. Oh, quasi dimenticavo: ecco una mappa della coltivazione di funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "#Dopo aver letto attentamente tutta la documentazione con Hanbei, sei sfinit{F#a}{M#o}...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Ottimo, ora sai tutto. Farò rapporto allo Shogunato, e dopo aver avuto l'approvazione della Shogun potremo concludere il tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "Fino ad allora, ti pagherò di tasca mia. Dopotutto, non posso rinviare ulteriormente la faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Ovviamente, anche per questa cosa compilerò tutti i documenti necessari. Dopotutto, il tuo compenso va tassato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "Ehm... Ora vado a raccogliere i funghi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Eh? Oh, allora lascio fare a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "Non finiremo di nuovo in qualche guaio, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "Non se lo tengo d'occhio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Sul serio? Va bene, non hai tutti i torti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Eh? Perché hai quell'espressione dubbiosa? Non preoccuparti, ho organizzato tutto meticolosamente, quindi non ci saranno problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "Non stiamo parlando di quel tipo di problemi... *sospira* Andiamo a prendere quei funghi per lui, che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Mi chiedo che problemi creerà stavolta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Ehi! In tal caso, non avremmo nessuno ad aiutarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Prima parliamo del compenso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Lei si chiama Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Paimon è Paimon! Non una \"cosetta che vola\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Credo sia qui per i funghi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Sia Toranosuke che Yousuke l'hanno menzionato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
		{
