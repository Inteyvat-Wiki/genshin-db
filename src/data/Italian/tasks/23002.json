					"nextDialogs": [
						230020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020503,
					"content": "#Viaggiat{F#rice}{M#ore}, sei qui. I funghi che hai raccolto erano di ottima qualità.",
