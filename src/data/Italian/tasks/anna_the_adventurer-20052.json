			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200520101,
					"content": "Bene, lavoriamo sodo anche oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520102,
					"content": "Ahah, ti vedo molto carica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "Ma certo! Essere un'avventuriera è così emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520104,
					"content": "Beh... ancora non so bene cosa fare quando mi occupo degli incarichi, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520105,
					"content": "#Viaggiat{F#rice}{M#ore}, ti spiace venire di nuovo con me? Ci sono ancora delle cose che vorrei chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520108,
					"content": "Allora partiamo. L'incarico di oggi è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520109,
					"content": "Ah... Dovremo scortare... un altro pallone aerotrasportatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520106,
					"content": "Vuoi che venga con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "Ti va? Eheh, certo! Avrei tantissimo da imparare da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2005202,
			"completionStepIds": [
				2005204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005203",
							"3"
						],
						"stepId": 2005203,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005204",
							"2"
						],
						"stepId": 2005204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200520201,
					"content": "#Abbiamo finito! Grazie, viaggiat{F#rice}{M#ore}. È andata molto bene, credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520202,
					"content": "Ma questa è la tariffa normale per gli avventurieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520203,
						200520205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520203,
					"content": "Ce ne saranno altre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520204
					]
				},
				{
					"id": 200520204,
					"content": "Perché quel tono sconsolato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520207,
					"content": "Ah, è così... Bene! Allora continuerò a lavorarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520208,
					"content": "Quando avrò risparmiato abbastanza Mora, porterò mio fratello e i miei genitori in viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520209,
					"content": "Mio fratello avrebbe sempre voluto viaggiare... Ma mi sono ammalata, ed è dovuto restare per prendersi cura di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520210,
					"content": "Ma ora sto bene, sono persino diventata un'avventuriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520211,
					"content": "Eheh, quando arriverà il momento, aiuterò anche mio fratello a realizzare qualche suo sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520205,
					"content": "Lo capirai col tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520206
					]
				},
				{
					"id": 200520206,
					"content": "Ehi, non fare quella faccia così stanca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2005203,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
