					}
				]
			},
			"dialogs": [
				{
					"id": 750680501,
					"content": "Sarà meglio che ve ne andiate immediatamente. Se rimanete qui, sarà troppo tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680502,
					"content": "Perché è troppo tardi, chiedi? Perché... perché l'intera compagnia di avventurieri è stata spazzata via. Quella gigantesca bestia nera... Sono tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680503,
					"content": "Mi hanno incaricato di proteggere gli evacuati, e di assicurarmi che, come minimo, lasciassero la città. Mentre parliamo, una squadra di soccorso del Clan Piumafiore sta arrivando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680504,
					"content": "Devo eliminare questi mostri malvagi, così che i sopravvissuti possano tornare a una terra illuminata dal sole... Ehm, ma... perché sono qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680505,
					"content": "Quel suono nelle mie orecchie... Aaah, si sta facendo sempre più forte. Devo... Devo tornare alla cascata. Sì, devo... tornare alla cascata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680506,
					"content": "#{F#Coraggiosa guerriera}{M#Coraggioso guerriero}, anche tu dovresti andartene... il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
