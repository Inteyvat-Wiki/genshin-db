						],
						"pointId": 10052
					}
				]
			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "#Quindi sei ancora qui, {F#coraggiosa guerriera}{M#coraggioso guerriero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680402,
					"content": "Tanto tempo fa, così dicono gli studiosi, l'antico e tirannico Signore di questa Città di cenere conosceva... un modo per prevenire la corrosione dell'Abisso. Quindi noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680403,
					"content": "#Ma c'è qualcosa di davvero sinistro in questo luogo, {F#coraggiosa guerriera}{M#coraggioso guerriero}. Ultimamente, anche io ho iniziato a sentirmi... strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680404,
					"content": "A volte, al risveglio, una strada che ieri era intatta è oggi pericolante e rovinata... E quelle case di pietra sono sempre state così? Sento che dovrebbero essere più... complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680405,
					"content": "Altre volte, quando mi sveglio, vedo degli amici che non dovrebbero esserci più... Sono dei mostri? Devono esserlo... Sono mostri che hanno preso le sembianze dei miei amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680406,
					"content": "Il mio... Il mio dovere qui è sconfiggere quei mostri, ma... perché? Perché devo farlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680407,
					"content": "Comunque, detto ciò, questo è un posto molto strano. Dovreste andarvene... il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
