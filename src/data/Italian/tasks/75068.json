					}
				]
			},
			"dialogs": [
				{
					"id": 750680101,
					"content": "#Queste creature inumane sono degli avversari davvero difficili... Dei mostri inumani, dovrei dire. Salve, {F#coraggiosa guerriera}{M#coraggioso guerriero}... Io sono Quenin, un membro di questa compagnia di avventurieri. Il mio dovere è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680102,
					"content": "#Il mio dovere... è quello di eliminare questi mostri. Sì, sono un guerriero della compagnia di avventurieri. Fa' attenzione, {F#coraggiosa guerriera}{M#coraggioso guerriero}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680103,
					"content": "Questi mostri... sono estremamente furbi. Sono capaci di camuffarsi e assumere diverse forme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680104,
					"content": "Ogni notte, prima di addormentarmi, sento... i suoni che emettono dal loro nascondiglio in queste antiche rovine. Ecco perché... non riesco a dormire all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680105,
					"content": "Questo posto è pieno di quei mostri. Anche voi... Fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506802,
