			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Battuta",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Quand'ero per mare, una volta udii un richiamo proveniente dal nulla. Gli altri non reagirono affatto, ma io ne fui quasi istantaneamente rapito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Dev'essere stata una voce proveniente da un altro mondo. L'ho sentita anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Solo in seguito ho compreso... Quel richiamo portava con sé ogni sogno che non aveva mai raggiunto l'altra sponda: un insieme di rimpianti, si potrebbe dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Dovresti portare con te un Ciottolo ghiacciato. Se guarderai attraverso il foro al centro, vedrai chi ti stava chiamando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Ma all'epoca ero ancora un giovane sciocco e dalla testa calda. Perfino il pericolo mi sembrava un'opportunità. Così l'ho fatto senza pensarci due volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Dicono che il foro al centro del Ciottolo ghiacciato sia un portale verso un altro mondo... Ma come si dovrebbe fare esattamente per attraversarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "E, dopo di ciò... Il mare e i suoi venti furiosi mi hanno portato via tutto: la mia ricchezza, il mio onore e persino la mia famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Le avventure mosse dall'ambizione e dal desiderio non finiscono mai bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, si è incastrato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Lascia che ti aiuti a estrarlo. E, la prossima volta, cerca di non farlo di nuovo, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea! Cosa ti porta di nuovo qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Stavo raccogliendo dei Ciottoli ghiacciati qui vicino. Vi ho visti chiacchierare e ho pensato di venire a salutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Ah! Se sei tu, Linnea, forse potresti davvero usare un Ciottolo ghiacciato per aprire un portale verso un altro mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Non posso farlo nemmeno io. Non te l'ho già spiegato? È solo una leggenda popolare messa insieme dalla gente, non ci sono prove concrete a sostegno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Uff... A quanto pare non funzionerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "...Oh. Allora stavi ascoltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ehm... No. Non sono più la persona di una volta. Ormai mi accontento di quello che ho e non desidero nient'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Che peccato. Allora anch'io ti aiuterò a raccogliere i Ciottoli ghiacciati, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Sarebbe fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Con l'aiuto di Auni, i materiali vengono raccolti in breve tempo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Grazie, ma ho già raccolto tutto ciò di cui ho bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Va bene, allora. Andrò a Valletalpa a trovare Nonno Talpa e gli altri. A dopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
