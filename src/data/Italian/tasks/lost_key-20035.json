			"dialogs": [
				{
					"id": 200350201,
					"content": "Hai trovato la mia chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200350202
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200350202,
					"content": "Temo di no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200350203
					]
				},
				{
					"id": 200350203,
					"content": "Ok, l'area in cui cercare è molto vasta... Buona fortuna!",
