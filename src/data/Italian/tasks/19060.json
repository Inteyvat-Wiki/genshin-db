			"dialogs": [
				{
					"id": 190603101,
					"content": "Non prendere ciò che Uesugi dice troppo seriamente. Sorridi e annuisci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603102,
					"content": "Riguardo Takatsukasa Isamu e Ryuuji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Ah, quella storia? Beh, Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603104,
					"content": "Ryuuji vedeva Takatsukasa Isamu come un padre adottivo, questo è certo. Ma non so se Isamu aiutasse Ryuuji senza aspettarsi qualcosa in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "Dopotutto, Isamu era una persona piena di risorse. Un tipo semplice e ingenuo come Ryuuji non sarebbe stato adatto come consigliere, ma sicuramente sarebbe stato un aiutante fedele e affidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Isamu era in attesa di una figlia, ma sfortunatamente morì prima che nascesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603107,
					"content": "A ogni modo, basta parlarne... Non sei qui per investigare su un caso? Sarà meglio che ti dia una mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
