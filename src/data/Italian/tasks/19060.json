			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "#{F#Viaggiatrice}{M#Viaggiatore}, sono certa che riuscirai a svelare la verità. Quello Shikanoin sta nascondendo qualcosa, me lo sento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "*sospira* Sia Sango che l'investigatore Heizou sono brave persone, ma quando sono insieme non fanno altro che litigare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190602903,
					"content": "Oh, Ryuuji, fattene una ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1906030,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906004",
							"2"
						],
						"stepId": 1906004,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906005",
							"2"
						],
						"stepId": 1906005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906006",
							"2"
						],
						"stepId": 1906006,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906007",
							"2"
						],
						"stepId": 1906007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#Ehi {F#viaggiatrice}{M#viaggiatore}. Indagare su un caso non è così semplice come sembra, vero? Non preoccuparti, ti dirò tutto quello che vuoi sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Riguardo alla direttrice Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Ah, Sango? Il clan Takatsukasa ha assunto un'investigatrice davvero in gamba, non pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Ogni tanto passa alla stazione per presentare qualche domanda, e ogni volta chiede la riapertura del caso Ryuuji. Ma Heizou le ha sempre impedito di farlo. Non mi aspettavo che arrivasse a inviare lettere di reclamo, è davvero implacabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "E per quanto riguarda il motivo per cui il senpai Heizou l'ha tenuta lontana dal caso... credo che abbia paura che Sango possa cacciarsi nei guai. Dopotutto si tratta dell'omicidio di un uomo importante, potrebbe diventare una situazione pericolosa se non si sta attenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Certo, Sango gestisce un'agenzia investigativa, ma alla fine è una persona come le altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Quindi sono amici?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Beh... non proprio. Li vedo litigare ogni volta che si incrociano. Ma forse Heizou la considera ancora una vecchia amica. Ho sentito dire che un tempo lavoravano insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "A volte mi chiedeva di passare i casi meno urgenti all'agenzia investigativa. Immagino che volesse supportare l'attività di Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
