			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "#Ah, ciao, viaggiat{F#rice}{M#ore}. Sembra che tu sia qua per partecipare al Gala del Sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "Se ti interessa, ti andrebbe di provare il gioco che abbiamo organizzato noi dell'Amurta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "Che tipo di gioco si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Il nostro darsana ha organizzato un piccolo gioco chiamato \"Replica mimetica\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "In questo gioco, ti presenterò i modelli comportamentali di alcuni animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Ovviamente, questi modelli sono stati semplificati e generalizzati in modo da renderli più semplici da capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Tutto ciò che dovrai fare è usare questi modelli che abbiamo preparato per imitare le azioni dell'animale corrispondente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Sembra piuttosto semplice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Esattamente. Il fatto che \"gli animali hanno dei modelli comportamentali regolari\" è un concetto che è facile sia da comprendere sia da accettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Ma dietro a parole così semplici si celano alcuni dei misteri mai svelati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Comunque sia, mettiamo da parte per un momento questa osservazione accademica e goditi in tutta tranquillità il comportamento degli animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Farò un tentativo, perché no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "D'accordo. In questo caso, vieni qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "Al momento ho altro da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Va bene. Il mio stand sarà aperto per tutta la durata del Gala, quindi vieni pure a provare il gioco quando vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Non sembra difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}