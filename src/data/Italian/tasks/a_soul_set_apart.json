			"dialogs": [
				{
					"id": 80030401,
					"content": "Quindi, dopo tutto questo correre qua e là, siamo tornati qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030402,
					"content": "#Guardaci... La prima volta siamo riuscit{M#i}{F#e} a fuggire per un pelo, e ora ci stiamo rientrando con disinvoltura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030403,
					"content": "Dobbiamo proprio essere tra gli avventurieri più coraggiosi di tutta Teyvat! Oppure tra i più stupidi...",
					"roleType": "TALK_ROLE_NPC",
