			},
			"dialogs": [
				{
					"id": 80030501,
					"content": "Sembra che ci siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030502,
					"content": "Una stanza inquietante, oscura e senza vita... Ora capisco l'aura malvagia che mi avete descritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030503,
					"content": "Oooh... Che posto spaventoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030504,
					"content": "Fate attenzione a non farvi sopraffare dal potere della Statua dissacrata... L'Apostolo dell'Abisso è qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030505,
					"content": "Ahahah... Non ti sbagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80030506,
					"content": "Sei sempre la solita seccatura, Dainsleif, nemico dell'Abisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80030507,
					"content": "Percepisco che la tua anima è terribilmente macchiata di sangue, forse dai tuoi incubi più oscuri. A meno che... Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80030508,
					"content": "Oh, e c'è qualcosa di molto più pericoloso! Puzzi di una corruzione a me familiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80030509,
					"content": "Allora, siamo uguali. Siamo entrambi pericolosi. Ma i pericoli al di fuori dell'Ordine dell'Abisso devono essere catturati e chiusi in gabbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80030510,
					"content": "Tsk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030511,
					"content": "Sono le tue parole che puzzano di corruzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030512,
					"content": "È ora di metterti a tacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800306,
