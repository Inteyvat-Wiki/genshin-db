			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Dain, eccoti qui. Hai visto la maestra Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "L'ho vista e l'ho evitata di proposito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "In quanto Cavaliere della Zanna di leone e Gran Maestra Reggente, sarebbe naturale che avesse delle riserve nei miei confronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Se non sto attento, un giorno potrei ritrovarmi a essere oggetto di una delle sue indagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Tornando alle questioni urgenti... Ho sconfitto alcune delle forze dell'Abisso, ma non sono riuscito a ottenere informazioni. Avete avuto più successo di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Bene, allora. Possiamo più o meno capire dov'è finito il primo Zappaterra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Eh? Davvero? Solo basandoci sulla storia di Lupus Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "Basandoci su quelle informazioni e su un'analisi più comprensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "Per esempio, la vecchia storia che mi avete detto di aver sentito nella cattedrale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "\"La furia finale del Tiranno\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Esatto, quella strana storia che la giovane sorella vi ha raccontato, per tanti anni confusa con una maledizione scagliata da un defunto tiranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Le sfere di fuoco che piovevano dal cielo erano probabilmente dei missili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Ah, Paimon ha capito! Allora, la \"Furia finale del Tiranno\" non era altro che missili sparati dallo Zappaterra dopo essere scappato dal Regno dei Lupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Dopo aver riportato danni a seguito della battaglia contro il Lupo del Nord, deve aver vagato tra le rovine della vecchia Mondstadt ed essere rimasto lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "E poi, quando qualcuno si avvicinava... PAM, PAM, BUM! Sparava un sacco di missili... Finché, un giorno, si è spento definitivamente e le sfere di fuoco hanno smesso di piovere dal cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "Allora, gli abitanti di Mondstadt non avevano ancora visto tante Guardie delle rovine prima d'allora, e così hanno interpretato la storia come la \"furia finale del Tiranno\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "Sembra che dovremo fare un salto al <color=#00E1FFFF>Covo di Terrore alato</color> e setacciare l'intera zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Mmmh. Cosa intendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Mi... ricordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Eh? Vuoi dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "Oh, anche Paimon ricorda! Abbiamo visto quella <color=#00E1FFFF>Guardia delle rovine abbandonata seduto in cima alla torre</color> l'ultima volta che eravamo lì! Una cosa del genere non si dimentica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Non c'è bisogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Gli antichi popoli di Mondstadt non avrebbero potuto capire la vera natura delle sfere di fuoco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "A dire il vero, Barbara è la diaconessa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
