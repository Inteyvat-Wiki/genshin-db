						"stepId": 800311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Sono... andati via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "#Oh, non essere triste, {NICKNAME}... Li ritroveremo! Guarda il lato positivo, almeno abbiamo ottenuto informazioni utilissime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Non... sono triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Davvero? Dici sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "#Almeno adesso, Dain è un pezzo chiave per ritrovare {F#tuo fratello}{M#tua sorella}, proprio come i Sette. Non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Quando arriveremo a Inazuma, dovremmo tenerlo a mente, mentre cercheremo altri indizi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Esatto! Ehm... Comunque, quello che hanno detto poco fa mi ha confuso le idee... Tu ci hai capito qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Dovrei aver capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Oh... Beh... Allora analizziamo la situazione un'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Prima di tutto, quell'Apostolo dell'Abisso ha chiamato {F#tuo fratello \"Principe\"}{M#tua sorella \"Principessa\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Sembra che {F#tuo fratello}{M#tua sorella} fosse a capo dell'Ordine dell'Abisso, persino l'Apostolo dell'Abisso {F#gli}{M#le} dà retta... Però non sappiamo se sia {F#il}{M#la} leader di rango più alto dell'organizzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Inoltre, {F#tuo fratello}{M#tua sorella} ha detto che \"vuole inghiottire i troni\" e andare in \"guerra contro il destino\". Che diamine significa? Forse... vuole distruggere i Sette e le sette nazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Poi... A quanto pare, i mostri dell'Ordine dell'Abisso sono in realtà ciò in cui il popolo di Khaenri'ah si è trasformato dopo la distruzione della loro nazione. Questa storia è proprio terrificante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "E anche Dain viene da Khaenri'ah! Ha assistito alla sua distruzione cinquecento anni fa, Ma... non si è trasformato in mostro, e ora combatte contro l'Ordine dell'Abisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Quindi, per questo {F#tuo fratello}{M#tua sorella} ha detto che Dain è suo nemico, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Ma... Se i mostri dell'Abisso sono le stesse persone che Dain ha protetto tutti quegli anni fa, allora perché ora è nemico dell'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "#E poi, come mai... dopo tutto il tempo che abbiamo passato a cercare {F#tuo fratello}{M#tua sorella}, salta fuori che {F#lui}{M#lei} è dalla parte dell'Abisso? Cosa sarà mai successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Abbiamo ancora tante domande, ma poche risposte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Sì, hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Allora... non possiamo stare qui a demoralizzarci, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Il nostro viaggio non è ancora finito, proseguiamo! È ora di andarcene da questo posto oscuro e orribile e di tornare in superficie, dove il sole splende luminoso in cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Se {F#tuo fratello}{M#tua sorella} vuole che tu \"raggiunga la fine del tuo viaggio\"... {F#Mostragli}{M#Beh, allora mostrale} di che pasta sei fatt{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "#Forza, viaggiat{M#ore}{F#rice}, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Rimuginarci non risolverà niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Ero troppo concentrat{M#o}{F#a} su {F#mio fratello}{M#Lumine} per ascoltare con attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Un altro obiettivo per il nostro viaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Hai ragione, Paimon. C'è speranza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Sì, giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}