				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "Strano, che ci fa qui questa bambina? Ehi, bambina! Perché sei qui tutta sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710102,
					"content": "Ah! Una persona strana, e una persona strana volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710103,
					"content": "Ehi, ehi! Ma che scortese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710104,
					"content": "Sì, esatto. Scortese è il mio secondo nome. Non ho avuto i genitori ad insegnarmi \"le buone maniere\", sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710105,
					"content": "(Qui dietro c'è sicuramente una storia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "Mmh... A ogni modo, non siamo persone strane, e soprattutto non siamo persone cattive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710107,
					"content": "#Siamo solo due gentili viaggiat{F#rici}{M#ori}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "Esatto. Ed è per questo che non lasciamo indietro chi è in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710111,
					"content": "#Il nome di Paimon è Paimon, mentre {F#lei}{M#lui} si chiama {NICKNAME}. Possiamo sapere il tuo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710112,
					"content": "Il mio nome è Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710113,
					"content": "E perché sei qui tutta sola Varsha? Possiamo riaccompagnarti se ti sei persa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710114,
					"content": "No. Il passato deve restare nel passato. Ho deciso di andare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710115,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710116,
					"content": "Non posso fare affidamento sugli adulti. Devo andare per la mia strada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710117,
					"content": "Cos'è questo modo di parlare da nonnetta? Sei solo una bambina! In ogni caso, la foresta può essere molto pericolosa. Una bambina come te non può farcela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710118,
					"content": "Un tipo cattivo ha cercato di portarmi via prima... Ma è tutto a posto. Ora sono più attenta. Sarò in grado di evitare il pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710119,
					"content": "Era un tipo del Villaggio di Vimara e sembrava abbastanza gentile. Ma, a quanto pare, non era diverso dagli adulti che ho incontrato in precedenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710120,
					"content": "Sei quasi stata portata via da un tipo cattivo!? Non hai affatto imparato la lezione allora! Aspetta, come sei riuscita a scappare l'ultima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710121,
					"content": "Una piccola creatura mi ha portato in questo luogo. Non ho mai visto qualcosa di così piccolo a Borgo Gandharva, quindi credo che debba essere uno spirito della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710122,
					"content": "(Potrebbe essere un Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "(Detto questo, \"quel tipo del Villaggio di Vimara\" potrebbe riferirsi a...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710124,
					"content": "In ogni caso non è sicuro per i bambini stare da soli nella foresta. Potresti incontrare pericoli di ogni tipo, come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710125,
					"content": "Imbatterti in pericolosi Miconoidi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "Sì! E in dei cattivi come i Nara Marana. Oh, no, Paimon intendeva dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710127,
					"content": "Potresti incontrare dei tipi cattivi che vogliono rapirti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#Sì! Quello che ha detto {NICKNAME}! O... o potresti morire di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710129,
					"content": "È impossibile morire di fame in una foresta piena di doni della natura. Astrofunghi, Fiordolci e menta sono dappertutto, e io comunque mangio pochissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710130,
					"content": "E sono sempre stata brava a prendermi cura delle piante, quindi trovare un posto sicuro dove piantare dei Fiordolci o della menta per nutrirmi non è un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710131,
					"content": "Ahah, un giardino pieno di Fiordolci... Non sarebbe un paradiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710132,
					"content": "Che sogno ad occhi aperti che sta facendo, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710133,
					"content": "Comunque, sono molto più felice ora che quando ero a Borgo Gandharva, e non vengo picchiata... Apprezzo la vostra gentilezza. Ma ora, sarebbe meglio che mi lasciaste sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710134,
					"content": "Mmh... Paimon non sa cosa le sia successo, ma sembra difficile convincerla a tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710135,
					"content": "A essere onesti, non sembra così pericoloso qui... Torniamo a trovarla più avanti, se il caso lo permette. Forse cambierà idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710109,
					"content": "#Sto cercando mi{F#o fratello}{M#a sorella} scompars{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "#Sì. Per questo ci siamo preoccupat{F#e}{M#i} quando abbiamo visto una ragazzina come te qui da sola! Non possiamo lasciarti qui così sapendo che potresti aver bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307102",
							"2"
						],
						"stepId": 7307102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "Finché ci sono semi, possono coltivare più Fiordolci. Ma il pane è un'altra storia. Non si può piantare il pane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710202,
					"content": "Se il pane potesse spezzarsi a metà e ricrescere, nessuno soffrirebbe mai la fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "Ciao, Varsha! Sei ancora qui, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710302,
					"content": "#Paimon. {NICKNAME}. È bello vedervi. Me la passo bene qui. Non c'è nulla di cui dobbiate preoccuparvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710303,
					"content": "Hai perseverato, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710304,
					"content": "State ancora cercando di persuadermi? Non andrò da nessuna parte con voi. Assolutamente no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710305,
					"content": "Beh... Non ti forzeremo a fare nulla. Ricordi ciò che hai detto su \"un giardino pieno di Fiordolci\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710306,
					"content": "Ah... Si trattava di un desiderio in realtà. So che non esiste un posto così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710307,
					"content": "Mmh... Pensieri così maturi sembrano ancora strani detti da una bambina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710308,
					"content": "Indovina! Abbiamo buone notizie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710309,
					"content": "C'è davvero un giardino pieno di Fiordolci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "Sì! E, che tu ci creda o no, lo \"spirito della foresta\" che ti ha salvato appartiene a una specie chiamata Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710311,
					"content": "Sappiamo queste cose perché abbiamo aiutato a piantare molti Viparya per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710312,
					"content": "Abbiamo aiutato la terra a ricordare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "Esatto. Secondo Aranakula, il Vanarana ricorda ogni cosa, quindi i Viparya possono germogliare nel giardino una volta che la terra si ricorda di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710314,
					"content": "...Ho sentito molte storie come questa in passato, e solo i bambini le prendono sul serio. Ma so che l'hai detto con buone intenzioni, Paimon, quindi grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710315,
					"content": "Non sei forse anche tu una bambina? Paimon non ti sta raccontando storielle. Paimon sta dicendo la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710316,
					"content": "Certo, è quello che dicono tutti i cantastorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710317,
					"content": "Se non ci credi... Beh, vedere per credere! Vieni con noi e guarda tu stessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710318,
					"content": "Aspetta, hai davvero preparato un posto per la tua storia? Ora sono curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710319,
					"content": "Uff, Paimon ti sta dicendo la verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710320,
					"content": "#Portiamola al giardino degli Aranara, {NICKNAME}. Dovrebbe mettere a tacere i suoi dubbi una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307105",
							"2"
						],
						"stepId": 7307105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#Avete preparato voi tutto questo, Paimon e {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710402,
					"content": "Uff... Sì e no. Sono Aranakula e Arakara a prendersi cura di questo giardino insieme. Noi abbiamo solo aiutato un po'. Non è stato fatto solo per delle storie inventate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710403,
					"content": "Aranakula e Arakara... Sono gli \"Aranara\", gli spiriti della foresta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710404,
					"content": "Sì! Finalmente credi a Paimon? Non solo abbiamo aiutato con il giardino, ma abbiamo anche fatto delle avventure con gli Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710405,
					"content": "Gli Aranara sono quelli che riportano i bambini rapiti al Villaggio di Vimara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710406,
					"content": "Mi è ancora difficile credere alle storie... Ma, se rimarrò qui, avrò la possibilità di vederli anch'io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710407,
					"content": "Vanarana non è davvero pericolosa, ma sei sicura di non voler tornare a Borgo Gandharva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710408,
					"content": "Hai una pessima memoria, Paimon. Ho detto che non posso fare affidamento sugli adulti e che voglio andare per la mia strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710409,
					"content": "Ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "Va bene, non preoccupatevi per me. Sono riuscita a cavarmela fino a ora, ricordate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710411,
					"content": "E sono brava a prendermi cura delle piante. Gli Aranara saranno felici di vedere il giardino fiorire qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710412,
					"content": "Beh, se insisti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710413,
					"content": "Sei così apprensiva, Paimon. Nessuno si è mai preoccupato così tanto per me da quando ho memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710414,
					"content": "Uh... Senti, Varsha, sei al sicuro qui nel Vanarana. Ma sei ancora una bambina, quindi ti prego, abbi cura di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710415,
					"content": "Lo so, lo so. Abbiate cura di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307105,
			"completionStepIds": [
				7307107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307107",
							"2"
						],
						"stepId": 7307107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "Strano, che ci fa qui questa bambina? Ehi, bambina! Perché sei qui tutta sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710502,
					"content": "Ah! Una persona strana, e una persona strana volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710503,
					"content": "No, dai... È scortese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710504,
					"content": "Sì, esatto. Scortese è il mio secondo nome. Non ho avuto i genitori ad insegnarmi \"le buone maniere\", sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710505,
					"content": "(Qui dietro c'è sicuramente una storia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "Mmh... A ogni modo, non siamo persone strane, e soprattutto non siamo persone cattive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710507,
					"content": "#Siamo solo due gentili viaggiat{F#rici}{M#ori}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "Esatto. Ed è per questo che non lasciamo indietro chi è in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710511,
					"content": "#Il nome di Paimon è Paimon, mentre {F#lei}{M#lui} si chiama {NICKNAME}. Possiamo sapere il tuo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710512,
					"content": "Il mio nome è Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710513,
					"content": "E perché sei qui tutta sola Varsha? Possiamo riaccompagnarti se ti sei persa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710514,
					"content": "No. Il passato deve restare nel passato. Ho deciso di andare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710515,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710516,
					"content": "Non posso fare affidamento sugli adulti. Devo andare per la mia strada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710517,
					"content": "Cos'è questo modo di parlare da nonnetta? Sei solo una bambina! In ogni caso, la foresta può essere molto pericolosa. Una bambina come te non può farcela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710518,
					"content": "Un tipo cattivo ha cercato di portarmi via prima... Ma è tutto a posto. Ora sono più attenta. Sarò in grado di evitare il pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710519,
					"content": "Era un tipo del Villaggio di Vimara e sembrava abbastanza gentile. Ma, a quanto pare, non era diverso dagli adulti che ho incontrato in precedenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710520,
					"content": "Sei quasi stata portata via da un tipo cattivo!? Non hai affatto imparato la lezione allora! Aspetta, come sei riuscita a scappare l'ultima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710521,
					"content": "Una piccola creatura mi ha portato in questo luogo. Non ho mai visto qualcosa di così piccolo a Borgo Gandharva, quindi credo che debba essere uno spirito della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710522,
					"content": "(Questo dovrebbe essere un Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "(Detto questo, \"quel tipo del Villaggio di Vimara\" potrebbe riferirsi a...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710524,
					"content": "In ogni caso non è sicuro per i bambini stare da soli nella foresta. Potresti incontrare pericoli di ogni tipo, come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710525,
					"content": "Imbatterti in pericolosi Miconoidi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "Sì! E in dei cattivi come i Nara Marana. Oh, no, Paimon intendeva dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710527,
					"content": "Potresti incontrare dei tipi cattivi che vogliono rapirti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#Sì! Quello che ha detto {NICKNAME}! O... o potresti morire di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710529,
					"content": "È impossibile morire di fame in una foresta piena di doni della natura. Astrofunghi, Fiordolci e menta sono dappertutto, e io comunque mangio pochissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710530,
					"content": "E sono sempre stata brava a prendermi cura delle piante, quindi trovare un posto sicuro dove piantare dei Fiordolci o della menta per nutrirmi non è un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710531,
					"content": "Ahah, un giardino pieno di Fiordolci... Non sarebbe un paradiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710532,
					"content": "Un giardino pieno di Fiordolci, uuh... Ooh, Paimon ricorda che ce n'erano tanti nel giardino di cui ci siamo occupati per gli Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710533,
					"content": "Aspetta. Stai dicendo che c'è davvero un paradiso del genere là fuori, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710534,
					"content": "Esatto! E, che tu ci creda o no, lo \"spirito della foresta\" che ti ha salvato appartiene a una specie chiamata Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710535,
					"content": "Sappiamo queste cose perché abbiamo aiutato a piantare molti Viparya per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710536,
					"content": "Abbiamo aiutato la terra a ricordare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "Esatto. Secondo Aranakula, il Vanarana ricorda ogni cosa, quindi i Viparya possono germogliare nel giardino una volta che la terra si ricorda di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710538,
					"content": "...Ho sentito molte storie come questa in passato, e solo i bambini le prendono sul serio. Ma so che l'hai detto con buone intenzioni, Paimon, quindi grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710539,
					"content": "Non sei forse anche tu una bambina? Paimon non ti sta raccontando storielle. Paimon sta dicendo la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710540,
					"content": "Certo, è quello che dicono tutti i cantastorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710541,
					"content": "Se non ci credi... Beh, vedere per credere! Vieni con noi e guarda tu stessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710542,
					"content": "Aspetta, hai davvero preparato un posto per la tua storia? Ora sono curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710543,
					"content": "Uff, Paimon ti sta dicendo la verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710544,
					"content": "#Portiamola al giardino degli Aranara, {NICKNAME}. Dovrebbe mettere a tacere i suoi dubbi una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710509,
					"content": "#Sto cercando mi{F#o fratello}{M#a sorella} scompars{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710510
					]
				},
				{
					"id": 730710510,
					"content": "#Sì. Per questo ci siamo preoccupat{F#e}{M#i} quando abbiamo visto una ragazzina come te qui da sola! Non possiamo lasciarti qui così sapendo che potresti aver bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307106,
