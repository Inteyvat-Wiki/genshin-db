			"dialogs": [
				{
					"id": 730710601,
					"content": "Wow, ci sono così tanti Fiordolci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710602
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710602,
					"content": "Non correre così veloce, Varsha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710603,
					"content": "I fiori stanno crescendo molto bene qui!",
