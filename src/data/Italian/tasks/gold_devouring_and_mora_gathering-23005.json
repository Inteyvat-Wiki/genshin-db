			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Mmh... niente male....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "A quanto pare hai guadagnato una fortuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "#Oh, viaggiat{F#rice}{M#ore}! Grazie a te, questa volta sono riuscito a guadagnare qualcosa. A quanto pare, il \"piatto dorato\" si è rivelato efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Tuttavia, non è un guadagno tanto diverso da quello che ottengo di solito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Non è così che dovrebbe funzionare un \"piatto dorato\". Forse ho mangiato il piatto sbagliato...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "#Viaggiat{F#rice}{M#ore}, riproviamoci. Potresti aiutarmi a scegliere di nuovo un \"piatto dorato\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Le regole sono sempre le stesse: scegli un piatto tra <color=#00E1FFFF>Moranino</color>, <color=#00E1FFFF>Pollo al burro</color> e <color=#00E1FFFF>Stratosferico del Ludi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300503",
							"2"
						],
						"stepId": 2300503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300503"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "Avrò guadagnato poco l'ultima volta, ma stavolta farò il colpaccio! <color=#00E1FFFF>Moranino</color>, <color=#00E1FFFF>Pollo al burro</color> e <color=#00E1FFFF>Stratosferico del Ludi</color>. Allora, che ne dici? Quale sceglierai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300504",
							"2"
						],
						"stepId": 2300504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "Ciao, Hatim! Come va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Oh... Siete voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "Beh, immagino che me lo si legga in faccia, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "Sarò sincero, il mio portafoglio è rimasto mezzo vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Che strano... Non sarebbe dovuta andare così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "Ma d'altra parte... Ho la sensazione che questo sia un segno che il mercato sta per decollare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "Forse le persone devono piegarsi prima di poter saltare in alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "Lo stesso vale per il mercato di trading di futures: ha raggiunto un nuovo minimo storico e sta per toccare il fondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "In altre parole, questo è il momento migliore per andare a caccia di affari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "Forse non ha ancora toccato il fondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "No. Sono certo che questa è un'occasione unica nella vita, e io non perdo mai l'occasione di arricchirmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "Questo mi renderebbe degno della mia nomea a Kalimi come uomo straordinariamente ricco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "#Amic{F#a}{M#o} mi{F#a}{M#o}, mi aiuteresti anche questa volta a scegliere un \"piatto dorato\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "Le opzioni sono sempre le stesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "Mmh... Aspetta, no! Dato che stiamo andando a caccia di affari, ho bisogno di un piatto ancora più speciale che ribalti la situazione sul mercato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "Ho sentito dire che a Mondstadt c'è un magnate che ha un'attività molto redditizia nel settore delle bevande alcoliche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "Stai parlando di...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "Patron Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "Ma come fai a conoscere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Ahahah, come potrei non conoscerlo, se conosco persino \"Stratosferico del Ludi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "È il proprietario di una taverna in cui vendono una bevanda straordinaria: il sidro di mele. Se me ne scolo un po', forse riuscirò ad assorbire anche la sua capacità di attrarre la ricchezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "Quindi, aiutatemi a trovare una bottiglia di sidro di mele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Ad alcune persone vengono i crampi alle gambe quando si piegano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
