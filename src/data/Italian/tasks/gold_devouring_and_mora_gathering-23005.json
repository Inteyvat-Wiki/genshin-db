			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "Questo è il sidro di mele di quel magnate, vero? Ah, emana un aroma meraviglioso. Schiarisce davvero la mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Fantastico! Questo sì che è di qualità. Sono sicuro che porterà a una svolta sul mercato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Non dimenticherò il vostro aiuto! Ci si vede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
