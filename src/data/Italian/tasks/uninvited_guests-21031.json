					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "Mi sono imbattuto per caso in quei mostri e li ho sconfitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310305,
					"content": "Quest'area è pericolosa. Perciò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310306,
					"content": "Farò attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "Bene. Ora vado, ho delle faccende da sbrigare. Ci vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310303,
					"content": "Quei mostri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				}
			]
		},
