			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Accidenti, devo trovare una soluzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Ah, sei tu. *sospira* Non voglio parlarne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Ultimamente, gli affari alla locanda stanno andando sempre meglio, e sempre più persone vengono a soggiornare da noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Alcuni vogliono trascorrere un po' di tempo da sole, mentre altri sono in viaggio con le loro famiglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Ovviamente sono contento di come stiano andando gli affari, il problema è che ci sono molti mostri che si aggirano nei dintorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Se un bambino che si trova fuori a giocare o una persona anziana che vuole fare una passeggiata si imbattesse in queste creature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Per evitare inconvenienti di questo tipo, devo uscire e inseguire i mostri attorno alla locanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Ma io sono uno solo, e loro sono così tanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarmi? Ti ricompenserò a dovere, te lo prometto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "In ogni caso, conto su di te. Ho visto che c'erano diversi accampamenti di mostri con creature pericolose all'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Inoltre, un altro gruppo di mostri è arrivato di soppiatto nei pressi della locanda e si è perfino accampato lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "Sai che ti dico? Lascia che io mi occupi dei mostri più pericolosi, tu pensa solo di eliminare quelli che hanno circondato la locanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "Quando avremo finito, c'incontreremo di nuovo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "*sospira* Questi mostri sono davvero un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Anche tu te la cavi piuttosto bene, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Io? Beh... Grazie del complimento, ma non sono al tuo livello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "E, anche se fosse, non riuscirei comunque a sconfiggere tutti quei mostri da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
