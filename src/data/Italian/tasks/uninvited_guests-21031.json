			"dialogs": [
				{
					"id": 210310401,
					"content": "Eccoti qui. Accidenti, è stata davvero dura sconfiggere quei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310402,
					"content": "Li hai sconfitti tutti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Ahahah, proprio così. Mi ci è voluto un bel po', ma ce l'ho fatta... Ah, non sono più il giovane combattente di una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310404,
					"content": "Suppongo che anche tu li abbia sconfitti tutti, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310405,
					"content": "A proposito dell'accampamento dei mostri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "Sono stati tutti sconfitti... ma non hai trovato nessuno all'accampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310407,
					"content": "Questo è molto strano. Che li abbia sconfitti un avventuriere di passaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310408,
					"content": "In ogni caso, grazie per aver perlustrato l'area al mio posto. Ho qualcosa per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
