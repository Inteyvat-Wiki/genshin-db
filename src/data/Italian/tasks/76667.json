			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "Uff... Avrei dovuto portare più Baccalakka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Quando Lauma era qui l'ultima volta...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Ciao, {NICKNAME}, sei qui per il Banchetto della Luna? Mi dispiace, ma... dovrai aspettare un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Che cos'è questo \"Banchetto della Luna\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Eh? Non ne hai ricevuto uno l'ultima volta...? Ah, giusto, quello l'ha organizzato Lady Lauma... Immagino che non abbia menzionato il nome ufficiale del pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "In parole semplici, il \"Banchetto della Luna\" è un pasto gratuito che noi Eredi della Luna gelata distribuiamo a chi ne ha bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Aiutare i bisognosi è sempre stato parte della nostra tradizione, anche se un tempo ci limitavamo alla zona intorno all'Isola di Hiisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Ma sotto la guida di Lady Lauma e grazie all'aiuto di tutti, abbiamo gradualmente ampliato la portata di questa iniziativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Lady Lauma dice che questo è un modo per estendere la Grazia della Dea della Luna a tutti. Com'era il detto...? Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "\"Il primo frutto del raccolto dev'essere posto sull'Altare del Chiaro di luna, non come un'offerta agli dèi, bensì per illuminare..\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "\"Per illuminare...\" umm... Come continuava...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "Ahem, comunque! Questo negozio è uno dei principali punti di distribuzione per i pasti. Eheh, e gestisco quasi tutto da sola! Impressionante, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "Abbiamo avuto molte difficoltà a distribuire i pasti a Nasha, ma credo in quello che dice Lady Lauma: in questo modo possiamo davvero aiutare ancora più persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Tuttavia... ieri, mentre preparavo gli ingredienti, ho dimenticato di chiudere bene la scatola, e quando mi sono svegliata questa mattina, molti frutti erano stati beccati dagli uccelli ed erano completamente inutilizzabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "Riuscirò a malapena a preparare qualche Banchetto della Luna con le Baccalakka rimaste... *sospira*... Come posso fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Sembra che stessero distribuendo del cibo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
