			"dialogs": [
				{
					"id": 766670401,
					"content": "Queste saranno sufficienti. Grazie, grazie mille! Aspetta solo un momento, preparerò il \"Banchetto della Luna\" più delizioso che tu abbia mai visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki corre in cucina e si dedica alla preparazione del \"Banchetto della Luna\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "È pronto. Prego, assaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Grazie ancora per il tuo aiuto. La prossima volta che avrai fame, non esitare a passare di qui. Preparerò una porzione speciale solo per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
