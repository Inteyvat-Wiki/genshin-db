			},
			"dialogs": [
				{
					"id": 766670301,
					"content": "Andrò a raccoglierne un po' per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "#Sei... Sei {F#disposta}{M#disposto} ad aiutarmi?! Grazie mille! Davvero, grazie! Allora... per favore, portami cinque <color=#00E1FFFF>Baccalakka</color>, dovrebbero bastare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Dopo che me le avrai portate, ti prometto che preparerò il \"Banchetto della Luna\" più delizioso che tu abbia mai assaggiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
		{
