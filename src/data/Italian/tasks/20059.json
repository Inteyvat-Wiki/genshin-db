			"dialogs": [
				{
					"id": 2005906001,
					"content": "Una sommetta niente male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005906002,
					"content": "Appena riuscirò a vendere questa roba, ti ricompenserò in modo adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005906003,
					"content": "Ma guarda un po', qualcuno qui sembra interessato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
