				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005902001,
					"content": "Mmm, non ti ho detto affatto quali articoli vendano meglio, vero? Scommetto che non sai cosa cercare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902002,
					"content": "Perché non mi porti del <color=#00E1FFFF>bottino degli Hilichurl</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902003,
					"content": "#{M#Un avventuriere desideroso}{F#Un'avventuriera desiderosa} di provare il proprio valore dovrebbe trovare interessante una proposta del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
