					"nextDialogs": [
						2005910102
					]
				},
				{
					"id": 2005910102,
					"content": "Beh, allora è deciso. Lo prendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910103
					],
					"speakerTitle": "Jack"
				},
				{
