			},
			"dialogs": [
				{
					"id": 2005910001,
					"content": "Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Salve! Che gusti sopraffini! Hai puntato subito l'oggetto di maggior valore dell'intero negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "#{M#Il qui presente viaggiatore}{F#La qui presente viaggiatrice} ha strappato questo trofeo di guerra dalle mani del capo degli Hilichurl non molto tempo fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Chissà da quanto tempo quello Hilichurl spregiudicato minacciava Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "#Stiamo parlando di {M#un guerriero esperto}{F#una guerriera esperta}, eppure lo scontro è stato assolutamente feroce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Sul serio? Accidenti, quello Hilichurl doveva essere un bel tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "Forse dovrei comprarlo e mostrarlo a Cyrus o a Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Così magari mi guarderebbero con occhi diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Di sicuro! Qui siamo bravi a tenere la bocca chiusa, tra l'altro. Il tuo segreto sarebbe al sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Ti do una dritta: prendilo subito, prima che qualcun altro te lo soffi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "#Devo pensarci su... {M#Viaggiatore}{F#Viaggiatrice}, sta dicendo la verità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
