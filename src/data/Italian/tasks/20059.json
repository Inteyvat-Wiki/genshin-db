			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "Non va bene... Non va per niente bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#Viaggiat{F#rice}{M#ore}! Proprio la persona che volevo vedere. Sapevi che questo è il mio negozio di souvenir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "Mio padre aspettava che gli avventurieri tornassero per comprare i loro trofei di guerra e rivenderli al negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "Da quando la situazione ha iniziato a smorzarsi alla Gilda degli avventurieri, però, le mie opportunità di fare scorta sono meno che infime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Non solo, ma le merci che riceviamo ultimamente non valgono praticamente nulla. Nessuno vuole comprarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "#Viaggiat{F#rice}{M#ore}, le tue avventure ti portano ovunque, vero? Potrei per caso disturbarti e chiederti di portarmi dei tesori che posso rivendere, la prossima volta che passi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "Terrò gli occhi aperti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Grazie! Qualsiasi cosa mi porterai, ne ricaverò un buon prezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "In realtà, Paimon vale una bella somma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Mi dispiace, nessuno la comprerebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "I miei clienti preferiscono oggetti di natura più... inanimata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
