						],
						"pointId": 350400084
					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "Non va affatto bene... Proprio per niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "È andato storto qualcosa con l'addestramento di Alem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}! Grazie al cielo sei qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "Non c'è tempo per spiegare. Aiutami a salvarla, ti prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "È una tua amica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "S-Sì, direi di sì. Ci siamo disperate diverse volte per via delle nostre tesi, e abbiamo persino pianto insieme in biblioteca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "Aaah, ma ora non è il momento di parlarne! Non vuole ascoltarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Ha detto che avrebbe fatto qualsiasi cosa per la sua tesi, poi se n'è andata a girovagare nella natura selvaggia con quella sua guardia per chissà quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "Ma non è ancora tornata! E nessuno della tribù può andare a salvarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#Ti prego, {NICKNAME}, devi andare a salvarla tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Lascia fare a me, ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#A ogni modo, aiutami, {NICKNAME}! Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Seriamente, voi dell'Akademiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Quella ragazza... *sospira* Posso solo dire che è estremamente sfortunata. Diceva addirittura che avrebbe fatto un ultimo tentativo con la sua tesi a Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "La conosci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
		{
