				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "Allora, com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani sta bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "Fiuuu... Ero preoccupatissima. Se aveste tardato ulteriormente, sarei venuta a cercarvi personalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "Quella sciocca non avrebbe potuto scegliere un argomento un po' più semplice? Con le sue abilità, sono sicura che avrebbe comunque ottenuto un voto abbastanza buono per laurearsi.",
