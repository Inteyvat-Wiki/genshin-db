						],
						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "Grazie, grazie mille per l'aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Se avessi potuto liberarmi prima di quella maledetta borsa, me ne sarei occupata da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Non esiste! A quel punto saremmo venute a Natlan per niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Un attimo, tu sei... Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Eh? S-Sei {NICKNAME}, vero? Sei davvero tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Questa ragazza accanto a te non è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "#Narzam, Cacciatrice di tesori. Ci siamo già {F#incontrate}{M#incontrati}. Non te lo sarai dimenticato, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "#Fiuuu... Sei davvero {F#la mia salvatrice}{M#il mio salvatore}! Quante volte mi hai salvato? Una, due...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Spero che tu non stia contando quella volta in cui eri con me. È successo perché hai insistito per restare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Ovviamente non la sto contando. E cosa vuol dire che ho insistito per restare? Ti avevo già pagato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Sì, a malapena per coprire cibo e bevande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Non dirmi che sei di nuovo qui per la tua tesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Eheh, beh... Con tutta la fatica che ho fatto finora, non potevo permettere che fosse stato tutto vano, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Stavolta ho richiesto un finanziamento speciale all'Akademiya e ho scelto anche un argomento originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Inoltre, ho Narzam qui con me a farmi da guardia. È riuscita a tenere lontani tutti i malintenzionati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Probabilmente perché non abbiamo con noi nessun oggetto di valore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Ma alla fine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "...Per tutto il tragitto fin da quando abbiamo lasciato i Figli degli Echi, questa ragazza ha custodito quella borsa con dentro i documenti come se fosse un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "A dire la verità, a me sembra più una pazza che ha paura che le rubino un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "E vedendo qualcuno con un tesoro, che se ne va in giro nella natura selvaggia con una sola guardia a protezione... Chi non ci farebbe un pensierino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Beh, su una cosa hai ragione: la mia borsa custodisce davvero un tesoro! Non contiene solo tutte le interviste sul campo, ma anche le copie di vari documenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Munita di un tesoro del genere, non avrò alcun problema a scrivere la mia tesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "E l'argomento che ho scelto, il \"Pellegrinaggio del ritorno della Fiamma sacra\", è di grande importanza, per cui riuscirò sicuramente a laurearmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Ah, e ovviamente non ce l'avrei mai fatta senza Tahmures. È stata una sua idea! È davvero una grande amica. Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Grazie ancora, {NICKNAME}. Se non fosse stato per te, quei brutti ceffi non avrebbero solo rovinato i miei libri, ma avrebbero anche rubato i miei soldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Qualche tempo fa ho guadagnato un gruzzoletto aiutando nell'organizzazione di alcuni libri e materiali. Se mi avessero derubata, non avrei potuto permettermi nessun nuovo materiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "È vero, ma avresti comunque finito per spendere tutti i tuoi soldi in libri. Se non avessi confiscato il tuo portafoglio, avremmo patito la fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "N-Non compro così tanti libri... O sì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Comunque sia, ora basta parlare. Dobbiamo ancora andare dal Popolo delle Sorgenti per raccogliere i materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Arrivederci, allora! La prossima volta che c'incontreremo avrò finito la mia tesi, puoi scommetterci! E, quando sarà il momento, ti offrirò un piatto di cibo delizioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Ti sei comunque cacciata nei pasticci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
