				"points": []
			},
			"dialogs": [
				{
					"id": 742480201,
					"content": "Questo gioco, \"Compagnia del GdR\", è davvero divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480204,
					"content": "Sì. Anche la vampira cattivissima dovrebbe tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
