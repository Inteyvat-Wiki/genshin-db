			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "Ah! Colombina, Sandrone! Grazie per esservi unite alla nostra Compagnia del GdR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "Il piacere è tutto nostro. Non abbiamo mai giocato prima, quindi ci affidiamo a te per capire come funziona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480103,
					"content": "Tranquille, niente pressione. La cosa più importante è che tutti si divertano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "Che bello! Non vedo l'ora di iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480105,
					"content": "Dunque, vi spiego brevemente la storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "\"È un'epoca in cui vampiri e umani coesistono. La nostra storia si svolge in una città condivisa dalle due razze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 742480107,
					"content": "Pur non essendo apertamente ostile, i rapporti tra umani e vampiri sono tutt'altro che armoniosi. Ora, un omicidio nel cuore della notte ha completamente infranto quel delicato equilibrio...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 742480108,
					"content": "Vampiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480109,
					"content": "Sono una razza che sopravvive bevendo sangue umano. Sono un tema ricorrente nei romanzi fantasy. Hai mai letto storie del genere, Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Uhm, credo di averne sentito parlare. E quindi, cosa dobbiamo fare in questa storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480111,
					"content": "Prima di tutto, ognuno deve decidere quale personaggio vuole essere. Puoi scegliere qualsiasi identità e professione tu voglia, purché sia adatta all'ambientazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Che personaggio voglio essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480113,
					"content": "Se hai difficoltà a decidere, puoi fare squadra con qualcun altro e lasciare che pensi a un personaggio per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Oh? Quindi... possiamo lasciare che qualcun altro crei la nostra storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480115,
					"content": "Ah! Sembra divertente! Facciamolo tutti quanti! Affido a te la mia scheda personaggio, Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Allora decidi tu il mio personaggio, Sandrone, e io penserò al ruolo perfetto per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480117,
					"content": "Ah... Per me va bene, tanto non sapevo che professione scegliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480118,
					"content": "Ooh, avete finito? Eheh, sono ansiosa di vedere la mia scheda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "\"Sono una mercante che esercita la sua professione in una città in cui vampiri e umani coesistono...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Mercante itinerante"
				},
				{
					"id": 742480120,
					"content": "Aspetta un attimo... Game master, questa scheda personaggio è sospettosamente simile a quella dell'altra volta... Persino le statistiche sono le stesse! Hai copiato tutto di sana pianta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "Tanto, a prescindere da tutto, troverai sempre un modo assurdo per far deragliare la storia. E poi, penso che questo tipo di personaggio scaltro e chiassoso ti si addica alla perfezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "...Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Ahah. Vediamo un po' chi sono io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480124,
					"content": "\"Sono una vampira cattivissima. Durante il giorno mi piace dormire in casa, esco solo per passeggiare in giardino di notte, quando c'è la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "La Damigella",
					"speakerSubtitle": "Vampira cattivissima"
				},
				{
					"id": 742480125,
					"content": "Mi piace cantare e usare la mia voce per adescare le mie prede. Nessuno che abbia incrociato il mio sguardo è mai vissuto abbastanza da vedere l'alba.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "La Damigella",
					"speakerSubtitle": "Vampira cattivissima"
				},
				{
					"id": 742480126,
					"content": "Mmh... È così che mi vedi, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480127,
					"content": "Eheh, non pensi che ti si addica? E poi, è un personaggio affascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480128,
					"content": "Va bene, ma voglio comunque impegnarmi a essere una vampira... un po' più gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480129,
					"content": "Fa' come credi. Bene, vediamo il mio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480130,
					"content": "\"Sono una dama nobile ed elegante, a cui piace dilettarsi con le invenzioni nella propria stanza. Vado a dormire molto tardi e ho orari decisamente irregolari...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "La Marionetta",
					"speakerSubtitle": "Cacciatrice di vampiri"
				},
				{
					"id": 742480131,
					"content": "Ehi! Ma che razza di persona si presenta in questo modo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480132,
					"content": "Umpf... \"Ma sono anche una cacciatrice di vampiri. Quando qualcuno in città è in pericolo, uso coraggiosamente le mie invenzioni per salvarlo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "La Marionetta",
					"speakerSubtitle": "Cacciatrice di vampiri"
				},
				{
					"id": 742480133,
					"content": "...Eh? Ma non mi somiglia per niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742480134,
					"content": "Dici di no? Io invece credo che ti calzi a pennello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 742480135,
					"content": "Ma a giudicare da queste presentazioni, sembra che i personaggi di Colombina e Sandrone siano nemiche giurate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Mercante itinerante"
				},
				{
					"id": 742480136,
					"content": "Ah, beh, sembra che questa storia riserverà degli sviluppi molto interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 742480137,
					"content": "Ah! Non vedo l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Mercante itinerante"
				},
				{
					"id": 742480138,
					"content": "Ahhh... Sento che questa storia mi causerà un gran mal di testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "La Marionetta",
					"speakerSubtitle": "Cacciatrice di vampiri"
				},
				{
					"id": 742480139,
					"content": "Sei preoccupata di come andrà a finire, vero, Sandrone? È perché sono una malvagia vampira succhiasangue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "La Damigella",
					"speakerSubtitle": "Vampira cattivissima"
				},
				{
					"id": 742480140,
					"content": "Hah! L'unica cosa che mi preoccupa è non riuscire a metterti in riga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta",
					"speakerSubtitle": "Cacciatrice di vampiri"
				}
			]
		},
