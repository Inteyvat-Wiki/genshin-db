				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "Terrore alato... sta attaccando Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}! Proprio al momento giusto. Dobbiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Aspetta, Amber. Sbaglio o non ci hai ancora presentati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Oh... Sì, giusto. Lui è Kaeya, capitano della nostra cavalleria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Loro sono due viaggiat{F#rici}{M#ori} provenienti da molto lontano, Paimon e {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(Molto lontano? Davvero non sappiamo altro di loro?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Per farla breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "#Ho capito. Benvenut{F#e}{M#i} a Mondstadt. Purtroppo, non siete arrivat{F#e}{M#i} nel migliore dei momenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Capisco quanto sia angosciante essere lontani dalla propria famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Non capisco bene perché cerchiate il Dio di Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Ma tutti quanti abbiamo i nostri segreti, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "#Ahah, tranquill{F#e}{M#i}! Non insisterò ulteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "Per prima cosa, da parte dei Cavalieri di Favonius, vi faccio i nostri sentiti ringraziamenti per averci appena aiutati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Beh, non potevamo certo lasciare che la situazione precipitasse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "I vostri sforzi per difendere la città dal drago sono stati ammirati da un gran numero di cittadini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "#Anche la Gran Maestra Reggente dei Cavalieri di Favonius è molto interessata a conoscervi, vi invita formalmente entramb{F#e}{M#i} al <color=#00E1FFFF>nostro quartier generale</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "Figuratevi! Quindi, insomma, beh... Qual è il premio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Ah... Che ne pensate di un piatto tipico di Mondstadt, l'arrosto al miele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "L'ho sentito nominare proprio poco fa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}