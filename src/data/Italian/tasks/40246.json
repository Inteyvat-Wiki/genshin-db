					}
				]
			},
			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, siamo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, giusto in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "#Beh, sì... Non siamo {F#state}{M#stati} noi a bere tanto alcol quanto pesiamo, ieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Eh, cosa? State insinuando che Nonna non regge l'alcol? Ci vuole ben altro per farmi ubriacare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Davvero? Perché, ehm, a un certo punto hai smesso di dire cose sensate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "Ah... Sul serio? Mh, non me n'ero accorta. Non ho detto niente di... troppo assurdo, spero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Beh, vediamo... Hai passato mezz'ora a sparlare di Ororon, mezz'ora a lamentarti del lavoro, un'ora a parlare di light novel... e, ehm, dopo tutto questo Paimon si è un po' addormentata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "...Sono andati via?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461209,
					"content": "Mh? Ah, dici la troupe? Sì, li abbiamo incrociati sul ponte, ma se ne sono appena andati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Aspetta, ma ora che la questione del tuo nucleo è risolta, cosa ti impedisce di andare a trovare Colombina? Le manchi tantissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Io... voglio prima risolvere questo pasticcio. E poi, è l'occasione perfetta per farle prendere un colpo, una volta tanto. Devo pianificare tutto nei minimi dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461212,
					"content": "Ma basta parlare di questo. Sei riuscita a localizzare il nostro obiettivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461213,
					"content": "Ovviamente. Nonna Itztli mantiene sempre le promesse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Bene, vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461215,
					"content": "La Regione di Morterre... Aspetta, è la Torre della Gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461216,
					"content": "Il luogo in cui le anime vennero recise... È quella la fonte del rancore o è l'Ordo Narzissenkreuz in generale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461217,
					"content": "Vi accompagno. Quest'affare non ha una posizione fissa: se quando arriviamo non si trova in quel punto, posso utilizzare un rituale per evocarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Ti sei già data fin troppo disturbo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461219,
					"content": "Non mi pesa affatto. Le mie vecchie ossa non hanno nient'altro da fare, dopotutto. Evocare uno spirito non sarà di certo la fine del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(E poi, se non ci vado, avranno solo altre battute tra loro a cui non potrò partecipare!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "E va bene, allora. Te ne sono grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461222,
					"content": "Ah, non perdiamo altro tempo. Si va!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}