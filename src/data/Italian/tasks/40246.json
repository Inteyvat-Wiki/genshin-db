						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Beh, questo sì che è stato un bel disastro d'altri tempi. Sono contenta che sia tutto finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461002,
					"content": "Fa piacere compiere una buona azione, ogni tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461003,
					"content": "Hai dato un grande aiuto a tutti anche a Nod-Krai! Sembra proprio che tu sia una brava persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Eh, non ne sarei così sicura. Tornerò dai Fatui abbastanza presto. Voi due a volte vi fidate troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461005,
					"content": "Beh, come minimo sappiamo di poterci fidare di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Umpf, e va bene. Però quando vi si ritorcerà contro non venitemi a dire che non vi avevo avvertito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461007,
					"content": "Bene, e ora dove si va? Torniamo alla nave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Sì! Le tue questioni personali, la faccenda di Narzissenkreuz... È tutto risolto. Questo significa che ora puoi \"vedere le persone che devi vedere\"... Giusto, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Saranno tutti così felici del tuo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Eh... Prima non l'avrei mai ammesso neanche sotto tortura, ma... sì. Mi sono mancati davvero tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461011,
					"content": "Colombina è un caso speciale, però! Questa volta mi vendicherò sicuramente per tutte le sue bravate degli anni passati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
		{
			"id": 4024611,
			"completionStepIds": [
				4024611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
