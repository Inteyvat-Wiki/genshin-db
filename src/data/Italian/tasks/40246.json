					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali ha bevuto parecchio ieri sera, eh... Chissà se è già sveglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Buongiorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460203,
					"content": "Aaah! C-Colombina! Certo che, ehm, le entrate di soppiatto ti riescono bene... Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Abbiamo appena finito di girare l'ultima scena, così sono venuta a prendere un po' d'aria fresca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460205,
					"content": "Gli altri sono ancora di sotto a discutere di come dovrebbe essere la scena finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460206,
					"content": "Intendi dire come dovrebbe finire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Sì. Sono indecisi sul se la protagonista debba ricongiungersi con la sua vecchia amica oppure no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460208,
					"content": "Ah... Già, perché tutta la storia ruota attorno al fatto che lei è venuta nella terra natia della sua amica per cercarla, giusto? Paimon aveva quasi dimenticato la trama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Sì. Furina e la signorina Chiori pensano che un finale tragico, in cui le due non s'incontrano mai, sarebbe più toccante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460210,
					"content": "Ma il regista Xavier ritiene che l'incontro tra le due renderebbe il finale più toccante e commovente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460211,
					"content": "Tu cosa ne pensi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Io? Non... saprei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460213,
					"content": "A livello personale, certo che voglio rivederla... È ovvio che vorrei vivere il momento in cui ci riuniremo... Anche se sarà solo davanti alla Cinekamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460214,
					"content": "Ma questo significa... che qualcuno dovrebbe interpretare il suo ruolo, e questo mi fa sentire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Non preoccuparti di questo, per ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460218,
					"content": "Già! Non fare quella faccia preoccupata! Girare un film dovrebbe essere divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "I-Inoltre, andrà tutto bene! Puoi fidarti di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Andrà tutto bene... Come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460221,
					"content": "Oh, beh... Sai com'è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Alla fine si sistemerà tutto, vedrai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Già! Proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Eheh... Ok, mi fido di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460225,
					"content": "Per ora proverò solo a divertirmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460226,
					"content": "#Oh, bene, ma guarda un po' chi c'è! {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "#Uhh, {F#l'esperta}{M#l'esperto} luci e la ciacchista che hanno disertato il lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "#Eh, sì... Diciamo che ci siamo un pochino {F#assentate}{M#assentati}, eh? Vi chiediamo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Eheh, sul serio, non preoccupatevi. Per noi sta andando tutto liscio, quindi fate pure quello che dovete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Grazie per la comprensione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Sembra che il tuo umore sia migliorato, Colombina. Scusa se la nostra discussione di prima ti ha messa in difficoltà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Non preoccuparti, ora sto bene. {NICKNAME} e Paimon mi hanno aiutata a schiarirmi le idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460234,
					"content": "Allora cosa ne pensi del finale? Dovremmo farle riunire oppure no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Dovremmo... concludere tutto in bellezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402460236,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Ci faremo perdonare sicuramente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
