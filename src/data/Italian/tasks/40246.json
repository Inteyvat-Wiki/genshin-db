			"dialogs": [
				{
					"id": 402460501,
					"content": "Mm, per ora nessuna traccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460502,
					"content": "Dovrei iniziare il rituale di evocazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Prima dreniamo l'acqua da questo piano della torre. Sarà più facile muoversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460504,
					"content": "Aspetta, possiamo farlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Certo. Alain e René avevano entrambi previsto il futuro che attendeva Fontaine, e avevano persino condiviso alcuni metodi per impermeabilizzare gli edifici. Il principio alla base è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460506,
					"content": "...Ehm, non è importante. Limitatevi ad attivare i meccanismi nell'ordine che vi indicherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
