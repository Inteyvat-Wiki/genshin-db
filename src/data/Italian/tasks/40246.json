				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "#{F#Pronte}{M#Pronti}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Sì. Quando apparirà, proverò a parlare con le anime al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460703,
					"content": "Ma, con ogni probabilità, saranno già state spinte alla follia. Se non riusciremo a comunicare, dovremo prepararci a combattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460704,
					"content": "In tal caso, Paimon farebbe meglio a trovare un posto dove nascondersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Se finiremo per combattere, dovrei essere io a sferrare il colpo finale. Fidatevi di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460706,
					"content": "Tutto chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Bene, ho bisogno di silenzio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "...Spiriti erranti che vagate lungo le maree, ascoltatemi. Anime infrante, messe a tacere, lacerate e abbandonate, seguite le tracce del passato e fate ritorno a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "...Che il rancore riconosca il rancore. Che le entità vili si attraggano l'un l'altra e, in questo luogo, prendano forma ancora una volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(...E adesso? È tutto qui?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460713,
					"content": "(Ehm... Ecco perché preferisco i numeri alla magia. Come dovremmo capire in quale fase si trova l'incantesimo? È come se non ci fosse alcuna logica.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460714,
					"content": "(La scienza meccanica è molto più semplice da...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460716,
					"content": "Attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Rancore delle anime erranti"
				},
				{
					"id": 402460718,
					"content": "Ehi, voi! O chiunque sia all'interno... Ho bisogno che mi ascoltiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460719,
					"content": "Sono una discendente del \"Re dei meccanismi\" di Fontaine, Alain Guillotin. Posso ripristinare la vostra forma originale e riportarvi alle linee geomantiche. Dovete solo collaborare con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Rancore delle anime erranti"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Tsk... A quanto pare, risolvere la faccenda a parole non è un'opzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460723,
					"content": "Va bene, piano di riserva... È ora di sfogarsi un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024609",
							"2"
						],
						"stepId": 4024609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2644.99,
							253.937,
							3639.558
						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "...È finita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Già. Ve l'avevo detto che sarebbe stato un gioco da ragazzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460903,
					"content": "Come hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Quella creatura non aveva niente di speciale. Se prendi un mucchio di anime senza un posto dove andare, e aggiungi un pizzico di energia malevola, qualche impurità e un bel po' di risentimento, ecco cosa ottieni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460905,
					"content": "Non ho fatto altro che separare le anime originali dal resto della contaminazione, permettendo loro di essere accettate dalle regole attuali del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460906,
					"content": "Il principio alla base della formula del mondo è la \"divergenza\". Partendo da un punto d'origine, decostruisce e ricostruisce le possibilità del mondo per trovare determinate risposte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460907,
					"content": "Quindi, ne consegue che calcolando inversamente la formula del mondo è possibile ottenere convergenza e ripristino. È questo che sono riuscita a fare utilizzando la matrice numerologica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460908,
					"content": "È un concetto simile alla riduzione omologica in matematica. Le ho ridotte all'essenza basilare e fondamentale del loro essere, senza alterarne la natura intrinseca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460909,
					"content": "Il che significava... Uff, lasciamo perdere. A giudicare dai vostri sguardi persi nel vuoto, immagino che non vi interessi un granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460910,
					"content": "Credo di capire finalmente cosa provano i forestieri quando parlo di cose da sciamani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "I-Il punto è che è stato super incredibile! Sei davvero straordinaria, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Eh, te ne accorgi solo adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460913,
					"content": "Non mi aspetterei niente di meno dalla Risolutrice Suprema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Ehm, basta parlare di questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402460915,
					"content": "D-Dovremmo andare! Vado a ripristinare i meccanismi all'interno della torre. Ci vediamo sulla terraferma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
		{
			"id": 4024610,
			"completionStepIds": [
				4024610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
