			},
			"dialogs": [
				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461102,
					"content": "Ehm, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461103,
					"content": "Non rovinare il momento, o comincerò a pensare a come mi hai teletrasportata in un posto a caso dopo che ti avevo esplicitamente detto di smetterla di farlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461104,
					"content": "E-Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461105,
					"content": "Eee... stop! Magnifico! Stupendo! Ce l'abbiamo fatta! Questo è esattamente il finale che speravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Produttore cinematografico"
				},
				{
					"id": 402461106,
					"content": "...Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461107,
					"content": "Dov'eri andata, Mademoiselle Colombina? Sei sparita e poi ricomparsa subito dopo, abbracciata a questa, ehm... nuova amica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "C-Ci... Ci stavano... riprendendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 402461109,
					"content": "Già. Beh, la Cinekamera era già in funzione, ed è successo tutto così in fretta, quindi... Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Aspetta, quindi lei è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Già, è la mia migliore amica. Quella che stavo cercando. Non avrei mai pensato di poterla rivedere davvero. Sono... davvero felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461112,
					"content": "E poi, anche il film ha avuto un lieto fine. Ed è tutto merito tuo, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461113,
					"content": "...Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 402461114,
					"content": "Non potevi non essere una rottura anche solo per un secondo?! Colombinaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
		{
			"id": 4024612,
