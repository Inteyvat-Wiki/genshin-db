			"dialogs": [
				{
					"id": 740300301,
					"content": "C'è qualcosa che non è chiaro? Dovete solo tirare la leva assieme a me. Semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
