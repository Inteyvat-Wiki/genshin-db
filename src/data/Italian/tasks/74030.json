			"trigger": {
				"objectNames": [
					"Galvaryet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Ciao, cosa c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300102,
					"content": "Per favore, aiutaci, strega buona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "Perché parli come Lanoire? Arriva al punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300104,
					"content": "Ci servono molti Coupon. Ci sono degli incarichi da svolgere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300107,
					"content": "Non avrete partecipato al gioco di Éstienne, vero? Dovreste sapere quando fermarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300108,
					"content": "...Ciononostante, ho bisogno del vostro aiuto per una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300109,
					"content": "Clynes sta riparando il suo dispositivo o qualsiasi cosa sia nei pressi della Faglia dell'erosione. Andreste a dargli una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300110,
					"content": "Chiedete pure il compenso a lui, non si rifiuterà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300111,
					"content": "Ce ne occupiamo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300105,
					"content": "Possiamo aiutare in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "Sarebbe meglio se ci fosse un compenso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
