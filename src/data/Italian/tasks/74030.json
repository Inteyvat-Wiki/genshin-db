				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4373.38,
							184.186,
							4785.289
						],
						"pointId": 4603
					},
					{
						"sceneId": 3,
						"position": [
							4373.582,
							184.163,
							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Giusto in tempo. Venite ad aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Puoi leggere il pensiero? Che paura!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "#Galvaryet ci ha mandat{F#e}{M#i} ad aiutarti... Come facevi a saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "...Perché qui ci siete solo voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "...Beh, non fa una piega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Comunque sia, il lavoro non è per niente difficile. Il terminale di ricerca dev'essere controllato da due persone contemporaneamente, e ho già inserito i comandi. Non resta che tirare la leva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Quasi dimenticavo... Il dispositivo di ricarica dovrebbe essere qui vicino. Dovrete installarlo prima di cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "E... giusto per sicurezza... voi non siete dei killer di macchine, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "Dipende da cosa intendi per killer di macchine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Come mai questa domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "L'ultima volta ho chiesto aiuto a Galvana e, quando mi sono distratto per un momento, il terminale è andato distrutto. Le ho chiesto cosa fosse successo, ma lei non ha saputo rispondermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Più tardi ho saputo da sua sorella che nessuna macchina può sopravvivere in sua presenza per più di mezza giornata. Sospetto che persino Alain Guillotin si arrenderebbe con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Hanno addirittura detratto il costo della riparazione dal mio compenso. Se siete come lei, allora le mie fatiche saranno vane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Che storia! Non preoccuparti, non siamo assolutamente come lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Conto su di voi, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Se il terminale di ricerca mi attaccasse, potrei diventarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Non lo faremo gratis, però.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Dirò a Galvaryet di richiedere il vostro pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Eh? Aveva detto che avremmo ricevuto il compenso direttamente da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Ha detto così? Va bene, allora. Richiedere fondi qui è persino più difficile che richiederli direttamente all'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
			"id": 7403003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
