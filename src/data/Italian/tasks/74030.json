						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "#Benissimo. Se non ci trovassimo in un posto come questo, vi avrei assunt{F#e}{M#i} come {F#mie}{M#miei} assistenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Troppo facile. A proposito... Cosa fa questo dispositivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "In origine c'era un varco che conduceva all'esterno e che andava sorvegliato. Con questo dispositivo, ora possiamo sigillare il passaggio e risparmiare forza lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Non è una novità per l'Istituto di ricerca di Fontaine ma, avendo un sacco di tempo a disposizione, l'ho leggermente modificato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "Ciò che state vedendo ora non è la sua forma finale, che è poi stata utilizzata nel Tunnel dei geodi... Ehm, penso di aver parlato troppo. Fate finta che non abbia detto niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Dunque ci sono delle uscite nel Tunnel dei geodi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "Bene, sei intelligente. Ma se lo fossi di più, lo avresti tenuto per te senza spifferarlo ai quattro venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Comunque sia, problema risolto. Galvana non ha più bisogno di venire qui tanto spesso, così posso prendermi una pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "...Ah, sì. Stavo dimenticando il vostro compenso. Grazie per l'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "La versione finale è più potente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Naturalmente! Ci sono altri componenti... Un momento, perché vuoi saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "#Se vuoi saperne di più, puoi provarla tu stess{F#a}{M#o}. Ma se ti beccano, io non ti ho detto niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}