	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "\"Il serzhant scelto Anton ha scoperto una grande campana a sud-est. Riporta le stesse iscrizioni delle pareti di roccia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Diario del Fatuus"
				},
				{
					"id": 710430102,
					"content": "\"È molto simile alla grande campana scoperta dal Kapitan-Poruchik nelle rovine a nord-ovest. Forse...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Diario del Fatuus"
				},
				{
					"id": 710430103,
					"content": "\"Abbiamo mandato Snezhevna e Fadeyka a suonare le due campane ai rispettivi angoli...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Diario del Fatuus"
				},
				{
					"id": 710430104,
					"content": "\"Al propagarsi dei tremendi rintocchi nella roccia, la nebbia nera si è sollevata. Un fenomeno alquanto strano... È come se le campane stessero annunciando l'arrivo di qualcuno...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Diario del Fatuus"
				},
				{
					"id": 710430105,
					"content": "\"Ne abbiamo persi dieci, con ingenti danni a due squadre dell'avanguardia. Il Kapitan-Poruchik ha ordinato la ritirata...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Diario del Fatuus"
				},
				{
					"id": 710430106,
					"content": "(Dal diario cade una mappa semplice, che segna la posizione delle due campane, a nord-ovest e a sud-est, con accanto due inquietanti teschi)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario del Fatuus"
				}
			]
		},
