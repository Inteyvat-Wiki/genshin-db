			"dialogs": [
				{
					"id": 220130501,
					"content": "Ehi, vuoi fare due chiacchiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130502,
					"content": "Certo. Hai per caso letto \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "Sì, l'ho letto. Mi piace tanto il personaggio principale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130504,
					"content": "Ma ultimamente ho avuto difficoltà a leggerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130505,
					"content": "In che senso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "Negli ultimi capitoli, il personaggio principale è improvvisamente dotato di tutte queste nuove abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "L'autore si dilunga molto sul modo in cui il personaggio ha questa rivelazione e su come può usare le sue abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "E ho sempre più difficoltà a star dietro ai nomi delle abilità. Non riesco a ricordarne nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "Devo prima comprenderle bene per poter continuare a leggerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "*sospira* Quindi stavo pensando di lasciar perdere il libro per un po' e di leggere qualcosa di più semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Ehm... Torniamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Torniamo indietro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "Ok... Non riesco proprio a capire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
