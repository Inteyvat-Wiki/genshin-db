			"dialogs": [
				{
					"id": 220130301,
					"content": "Ciao, dimmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Ciao. Hai per caso letto \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Eh? Sì, certo, e mi è anche piaciuto, ma... come posso dire... La trama non mi convince più come prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Il personaggio principale acquisisce continuamente nuove abilità con cui riesce a sconfiggere il nemico immediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Mi piaceva \"Onibudou\" proprio per i modi ingegnosi con cui il personaggio principale sconfiggeva il nemico, ma ora... mi sembra che l'autore si sia impigrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "E poi, molte delle abilità che ha il personaggio principale vengono usate solo una volta. Questo fa sembrare la storia così... superficiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Non riesco proprio a capire cosa abbia in mente l'autore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Ehm... beh... chiediamo a qualche altra persona, va bene? Questo deve essere un caso particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
