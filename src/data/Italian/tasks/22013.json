					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "Aspetta, perché ha un'aria così triste... cosa hanno detto i lettori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "*sospira* Allora, Junkichi, ora capisci il motivo dei loro commenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Non posso crederci... Com'è potuto succedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Le mie idee... la mia trama... non sono interessanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Come ho già detto, portare avanti la storia dando nuovi poteri al personaggio può essere pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "La novità può attrarre i lettori solo momentaneamente: appena la novità svanirà, i lettori si annoieranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Fidati, è la voce dell'esperienza che parla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "Lo so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Non è troppo tardi per rimediare, in ogni caso... Certo, non possiamo far sparire i commenti negativi sugli ultimi capitoli, ma possiamo riportare i capitoli successivi sulla giusta strada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Credo sia giusto che incassi il colpo ora. Se avesse continuato per la sua strada, la situazione sarebbe di gran lunga peggiorata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Quindi, grazie. Ecco qui, per ringraziarti dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		}
	]
}