					"Hasegawa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Ciao, posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Sì che puoi. Hai mai letto \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Certo! È un romanzo molto interessante. I personaggi e la trama sono fantastici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Ma... ho l'impressione che l'autore si sia un po' impigrito ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Ehm... Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "All'improvviso ci sono tutti questi nuovi poteri, che non sono mai stati nominati prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Anche se nel romanzo viene chiamata rivelazione, mi sembra solo una trovata da quattro soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "E credo che questo abbia fatto perdere fascino anche alla trama e al personaggio principale. Spero davvero che l'autore riconsideri questa decisione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "#Viaggiat{F#rice}{M#ore}, andiamo... andiamo a chiederlo a qualcun altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
