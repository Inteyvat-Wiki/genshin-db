			"dialogs": [
				{
					"id": 120230601,
					"content": "Ehilà, vi interessano frutta e verdure fresche? Sono rimedi naturali al mal di pancia da troppo barbecue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Novità? Qualcosa da segnalare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Vi riferite alle voci sulla Commissione Tenryou in combutta con i Fatui? Ho sentito qualcosina, ma nulla di dettagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "Ora che ci penso... Avete notato una certa agitazione tra i soldati? Ho avuto la stessa impressione. Vedete quel tizio laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Di recente si comporta in modo strano, urla sempre e si allena con la lancia quando non ha altro da fare. Mi ha fatto prendere un colpo un sacco di volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Eh... È un vero miracolo che gli scontri siano terminati. Spero proprio che staremo lontano dai guai, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Scusate, temo di non avere molte informazioni. Per qualunque altra domanda, vi suggerirei di rivolgervi direttamente a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Sembra una buona idea, andiamo a sentire che ha da dirci, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
