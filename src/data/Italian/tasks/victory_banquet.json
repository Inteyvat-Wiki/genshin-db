					"Hirai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "L'Isola di Watatsumi è finalmente in pace, e tutto grazie a Sua Eccellenza, Sangonomiya Kokomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Novità? Qualcosa da segnalare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Di recente? Uhm... vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Beh, la notizia principale è che possiamo di nuovo pescare nell'oceano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Durante gli scontri, il mare pullulava di navi da guerra. Dovevamo arrangiarci con i pesciolini e i gamberetti che riuscivamo a trovare vicino alla riva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Quando non erano abbastanza, la fame si faceva sentire. I bambini piangevano da mattina a sera, ma non potevamo farci nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Le notti le trascorrevamo insonni, con lo stomaco brontolante, nell'attesa di una nuova alba. Se non altro, almeno le cose stanno finalmente migliorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "#Dicono che sei {M#il capitano}{F#la capitana} della Pesce spada II, è vero? Beh, grazie per il tuo impegno! Ecco un pesce per voi, appena catturato! Mi sa che puzza un po', però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Ma non c'è bisogno, g-grazie... Noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Prendetelo! Senza di te, probabilmente avrei dovuto combattere i morsi della fame anche stanotte. Sua Eccellenza dice sempre che è giusto ripagare la gentilezza con la gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Va bene, grazie. Coraggio, {NICKNAME}, andiamo a parlare con altre persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
