				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Bleah... Quel tizio puzza, sembra ubriaco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "#Eh? Non ci credo... {M#Il capitano}{F#La capitana} della Pesce spada II, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "#Sei tornat{F#a}{M#o}, alla fine. Pensavo che avessi abbandonato l'unità dandotela a gambe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Ma ti pare! Non fuggiamo mai davanti a uno scontro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Ma davvero? In questi giorni non si parla d'altro che di pace e stabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Ricordi qual è la cosa più importante di tutte nella Resistenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "Lo spirito combattivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "#Esatto, quindi voglio metterti alla prova. Vediamo se sei {F#un'autentica guerriera}{M#un autentico guerriero} della Resistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Risponderò alle tue domande solo se mi batterai a duello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Che tipo... Non si può manco avere una semplice conversazione con lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "#Cosa ne pensi, {NICKNAME}? Ci stai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Certo, è impossibile che io perda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Staremo a vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "Presto ci dirai tutto, che tu lo voglia o meno!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
				1202312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202305",
							"2"
						],
						"stepId": 1202305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "#Che combattente eccezionale... Ecco perché Sua Eccellenza ti ha scelt{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Hai spirito combattivo da vendere... Forse allora potrai comprenderci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "#Capitan{F#a}{M#o}... anzi, commiliton{F#a}{M#e}... Ti unirai a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Prima dimmi cosa sta succedendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "La storia del complotto tra la Commissione Tenryou e i Fatui... l'abbiamo inventata. Non è vera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "COSA?! La povera Kokomi è preoccupatissima! Ci stai dicendo che era tutto falso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Cosa vi è saltato in mente?! Avete rischiato di far scoppiare un'altra guerra con la Commissione Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Era esattamente ciò che speravamo di ottenere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Trattative di pace... Bah. Tutti sono entusiasti dell'idea, ma non capiscono che metterebbero a rischio il futuro dell'Isola di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Cosa impedirebbe alla Commissione Tenryou di pugnalarci alle spalle? Perché mai la Shogun Raiden non dovrebbe promulgare un nuovo Decreto di caccia alle Visioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Noi siamo la Resistenza! Il nostro spirito combattivo è ciò che conta più di tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Non possiamo fidarci della Commissione Tenryou e dalla Shogun Raiden. Dobbiamo credere solo in noi stessi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Sei d'accordo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Paimon capisce il suo punto di vista, ma c'è qualcosa che non torna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "In sostanza... volete combattere e basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Sì! Le tue sono solo ipotesi campate in aria, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Volete sul serio mettere in giro un pettegolezzo che può rovinare la pace ottenuta con tanta sofferenza? Basato su cosa, poi? Su una situazione immaginaria che forse non si verificherà mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Non parlatemi con quel tono, come se foste al di sopra di tutto questo. Cosa ne sapete, voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Solo abbandonandoci completamente allo spirito combattivo abbiamo trionfato, lo capite? Completamente. E ora all'improvviso ci raccontate che non ha più importanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Mi dite di gettare le armi e tornare alla vita di una persona normale, ma come potrei farlo mai? Come potrei, se... se ogni volta che chiudo gli occhi vedo i volti degli amici che ho perso in battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Ogni volta che rivedo i loro visi, seppure solo immaginandoli, mi rendo conto che non potrò mai perdonare la Commissione Tenryou e il Decreto di caccia alle Visioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "#Suppongo che non sarai mai davvero un{F#a}{M#o} di noi. Non importa, spiffera pure tutto a Kokomi se vuoi, tanto ormai è troppo tardi per fermarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Troppo tardi? Cosa intendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Accidenti, non vuole rispondere alla domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Cosa facciamo, {NICKNAME}? È una cosa gravissima! Dobbiamo raccontare tutto a Kokomi, e subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "Abbiamo scoperto alcune cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "L'alleanza segreta tra la Commissione Tenryou e i Fatui è una bugia! Si sono inventati tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Volevano far fallire le trattative di pace, così da far continuare la guerra. Dicono anche che ormai è troppo tardi e non c'è più modo di fermarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Uhm... Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Che succede, Kokomi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Sto bene, non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "È colpa mia. Se solo avessi compreso prima i loro sentimenti, non saremmo mai arrivati a questo punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Penso di aver capito cosa intende Kouzen quando sostiene che è troppo tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Le trattative non inizieranno prima di domani, ma entrambe le fazioni hanno già inviato le loro guardie sul luogo. Dovranno assicurarsi che tutto avvenga nella massima sicurezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Ho il sospetto che uno dei cospiratori, d'accordo con Kouzen, si sia infiltrato tra quei soldati per provocare nuove sommosse durante i negoziati di domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Non mi piace questa storia. Vuoi che andiamo lì per fare un cambio di guardie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Non funzionerebbe. Entrambe le parti in causa, infatti, troverebbero altamente sospetta una simile modifica allo schieramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Anzi, chi auspica un nuovo scontro ne approfitterebbe per entrare in azione, attaccando le guardie della Commissione Tenryou. Non sarebbe altro che l'inizio di una nuova guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "E poi, non abbiamo idea di quanti soldati dell'Isola di Watatsumi siano coinvolti in questo complotto. Un cambio della guardia affrettato ci porrebbe di fronte a un dilemma: di chi possiamo fidarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Sembra un gran bel pasticcio... Ma quindi, non c'è nulla da fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Non preoccupatevi, ciò che è fatto è fatto. Ora sta a me escogitare un piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Questi soldati hanno certamente oltrepassato il limite, ma non sono gli unici colpevoli. Qualunque cosa accada, mi assicurerò che non gli venga fatto alcun danno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Incontriamoci di nuovo qui, domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Ti senti male?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
				1202308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
