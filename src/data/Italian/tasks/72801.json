		},
		{
			"id": 7280105,
			"completionStepIds": [
				7280105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280105",
							"2"
						],
						"stepId": 7280105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "L'acqua è cristallina e la sabbia è bianchissima: questa spiaggia è completamente diversa dal mare aperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Sarebbe un bel posto da cui salpare... O da cui decollare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "Ehm, questo paesaggio è bellissimo. Me l'appunto subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "#Viaggiat{F#rice}{M#ore}, aspetta un secondo. Ho bisogno di pensare a come scrivere il mio diario di viaggio. Puoi farti un giro e goderti la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Ma non allontanarti troppo, per favore. Heihachi mi sta seguendo. È proprio qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
