				"points": []
			},
			"dialogs": [
				{
					"id": 728011103,
					"content": "Perché ci sono dei mostri da queste parti? Anche se è un paesaggio bellissimo, i pericoli qui non mancano di sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011104
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011104,
					"content": "Ma posso includere quest'esperienza nel mio diario di viaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011105
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011105,
					"content": "Andiamocene da qui e cerchiamo un posto sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011106
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011106,
					"content": "Quel tipo ci sta ancora seguendo. È davvero... Tsk... Ostinato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
