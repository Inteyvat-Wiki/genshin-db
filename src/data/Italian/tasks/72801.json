				{
					"id": 728011501,
					"content": "#Viaggiat{F#rice}{M#ore}, hai preso il diario di viaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011502
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011502,
					"content": "Questo è da parte del signor Ramsay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011503
					]
				},
				{
					"id": 728011503,
					"content": "\"Il giro di Teyvat in ottanta giorni\"... WOW! Grazie! Fammi dare un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011504
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011504,
					"content": "Oh, come mai è così sottile? Gli altri diari di viaggio sono molto più spessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011505
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011505,
					"content": "Non è stato ancora terminato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011506
					]
				},
				{
					"id": 728011506,
					"content": "Davvero? Allora, aspetterò e lo leggerò quando zio Ramsay avrà finito... Così avrò una nuova storia da raccontare a Kouichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011507
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011507,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Questi sono per te. Spero ti vadano bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Midori"
				}
			]
