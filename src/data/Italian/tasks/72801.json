			"dialogs": [
				{
					"id": 728011301,
					"content": "Dalla cima della montagna si può vedere quasi tutta l'Isola di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011302,
					"content": "Sulla cima della montagna il vento è abbastanza forte, e l'altezza è perfetta per decollare. Non ci sono ostacoli qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011303,
					"content": "Ed è molto lontano dalla Città d'Inazuma, non sarò disturbato da doushin... O da persone indesiderate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011304,
					"content": "È davvero un bel posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "In poche parole, è un buon posto da cui decollare... E un bel posto di cui parlare nel diario di viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "Quel tipo... Ci sta ancora seguendo. Non ci vuole proprio lasciarci in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "Me ne libero subito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Va tutto bene, non preoccuparti di lui. Non oserebbe fare nulla di avventato con te in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "Quando hai a che fare con questo tipo di persone... Se ti dovessi avvicinare a lui, non farebbe altro che tormentarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011310,
					"content": "Comunque, per oggi basta così. Torniamo alla Sala da tè Komore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
