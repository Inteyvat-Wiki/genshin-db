				{
					"id": 728011401,
					"content": "Ho già qualche idea per la storia principale del mio diario di viaggio. Ma mi ci vorranno un giorno o due per finire il capitolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011402
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011402,
					"content": "Prima ho scritto qualche paragrafo. Per favore, porta subito questi paragrafi a Midori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011403
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "Quando avrò finito la storia, chiederò a qualcuno di portarle il diario di viaggio terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "Diario di viaggio... Tsk. Questo è quello che dice lui. Come faccio a sapere che non ha secondi fini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011405
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011405,
					"content": "Di che stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "Ho detto che questo tipo ha altri motivi per scrivere dei diari di viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Chi mai penserebbe a queste sciocchezze assurde? Viaggiare per Teyvat in mongolfiera senza usare una Visione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011408
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011408,
					"content": "Tsk, deve avere dei secondi fini... Anche se non ha ancora rivelato di cosa si tratta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
				}
			]
