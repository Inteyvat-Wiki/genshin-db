			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "E adesso cosa facciamo? Abbiamo sconfitto l'Apostolo dell'Abisso, ma il dispositivo non accenna a fermarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "E Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Lasciate che prenda il suo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "No! Finché il dispositivo è attivo, chi è affetto dalla maledizione non può fare nulla. Solo tu puoi affrontare l'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Se date valore al suo sacrificio, non perdete altro tempo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Vedete tutti questi raggi di luce e quei portali? Devono aver installato svariati dispositivi energetici in varie posizioni. Trovateli, presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "Quindi dobbiamo... attraversare questi portali dell'Abisso? Ehi, aspetta Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "La purificazione non avrà alcun effetto su di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
