			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Quella era l'anima di Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "In questo posto c'è una convergenza di poteri misteriosi. L'apparizione di anime non sorprende più di tanto, date le circostanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Però, se volete avventurarvi in profondità e continuare a indagare, dovrete fare attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "#Ci puoi scommettere, staremo super attent{F#e}{M#i}. Oh, ma... Dain, vuol dire che non verrai con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Quel dispositivo mi ha indebolito parecchio... Mi ci vorrà del tempo per riprendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Oh, giusto... Beh, in realtà Paimon lo sapeva già. Si vedeva che stringevi i denti per il dolore tutto il tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "Ti sei guadagnato un po' di sano riposo, Dain... Oh, dovresti prenderti una vacanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "\"Vacanza\"? Ah, magari... Credo che nel mio dizionario questa parola non esista neppure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Ci sono cose più importanti di cui devo occuparmi. L'operazione \"Telaio del fato\" è ancora in corso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "E sospetto che questi dispositivi di amplificazione abbiano a che fare con quella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Resterò in guardia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "Grazie della comprensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "Spero solo che, la prossima volta che ci incontreremo, saprai da che parte stare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Caspita, certo che sa come tenere il broncio... Si è tenuto quel commento sprezzante fino alla fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Beh, peccato che non abbiamo potuto rivedere {F#tuo fratello}{M#tua sorella}, ma almeno abbiamo scoperto qualcosa di utile, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Se continuerai il tuo viaggio, vi incontrerete sicuramente di nuovo e tutto tornerà alla normalità, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "Oh, Paimon quasi dimenticava... Il vero motivo per cui siamo venuti qui era scoprire cosa succedeva agli Hilichurl, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "Probabilmente abbiamo visto abbastanza per fare rapporto al minatore, ma... come glielo spieghiamo? È tutto troppo complicato per la gente comune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Bah, troveremo una soluzione, ma non dimentichiamoci dell'incarico una volta finito qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Ne riparleremo la prossima volta, dopo che ti sarai ripreso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
