			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070901,
					"content": "Ce l'abbiamo fatta? Il dispositivo si è spento completamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070902,
					"content": "Di certo la sensazione di bruciore è scomparsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070903,
					"content": "Quindi siamo riusciti a fermare il piano dell'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070904,
					"content": "Ma... Halfdan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070907,
					"content": "Fatemi controllare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070908,
					"content": "Dev'essere dura per Dain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070909,
					"content": "Tra tutti i modi per ricongiungersi con uno dei suoi compagni dopo tanto tempo... questo è il peggiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070911,
					"content": "Andiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070905,
					"content": "Sembra che abbia esalato l'ultimo respiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
		{
			"id": 800710,
			"completionStepIds": [
				800710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
