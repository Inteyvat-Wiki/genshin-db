					"Cantore dell'Abisso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Pensavo che sarebbe stato ridotto in cenere in un istante... L'anima di Halfdan è davvero resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Stupido impiccione! Smettila di ostacolarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Cantore dell'Abisso"
				},
				{
					"id": 80070103,
					"content": "Non avete incombenze più importanti di cui preoccuparvi? Forza, questa è la vostra grande occasione per liberarvi di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "Dainsleif!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Cantore dell'Abisso"
				},
				{
					"id": 80070105,
					"content": "Eliminalo e disattiva il dispositivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
