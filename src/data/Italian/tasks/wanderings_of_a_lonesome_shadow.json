					],
					"speakerTitle": "Biglietto ingiallito"
				},
				{
					"id": 191737102,
					"content": "Mentre lavoravo, continuavo a riflettere su come tu riusciresti a fare un lavoro molto migliore del mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Biglietto ingiallito"
				},
				{
					"id": 191737103,
					"content": "Dopotutto, sei la studentessa più eccezionale che abbia mai incontrato.\"",
