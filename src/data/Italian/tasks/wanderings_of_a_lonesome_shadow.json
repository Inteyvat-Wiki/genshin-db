			"dialogs": [
				{
					"id": 191737201,
					"content": "\"Gentile Madame Faruzan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737202
					],
					"speakerTitle": "Appunti redatti con cura"
				},
				{
					"id": 191737202,
					"content": "\"Gli appunti e i manoscritti trovati su Tamimi sono trascritti e organizzati, e ciascuno di loro è stato contrassegnato col tuo nome.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737203
					],
					"speakerTitle": "Appunti redatti con cura"
				},
				{
					"id": 191737203,
					"content": "Spero che, anche dopo un secolo, le future generazioni di studenti ricorderanno ancora il nome di Madame Faruzan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti redatti con cura"
				}
			]
		},
