				},
				{
					"id": 191737302,
					"content": "(La scrittura è confusa ed è stata cancellata e corretta più volte, lasciando solo qualche frase a malapena leggibile e un unico messaggio pienamente comprensibile sul retro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737303
					],
					"speakerTitle": "Biglietto con tante correzioni"
				},
				{
					"id": 191737303,
					"content": "\"Sbrigati, torna a casa e mangia qualcosa! Tua madre prepara sempre una porzione di cibo in più.\"",
