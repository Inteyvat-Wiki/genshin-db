			"dialogs": [
				{
					"id": 191735301,
					"content": "Un \"sistema d'irrigazione automatizzato\"... È una bella impresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735302,
					"content": "Maestro, posso aiutare in qualche modo? Se c'è da comprare qualcosa, preparo carta e penna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735303
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735303,
					"content": "Oh, ma se ben ricordo, hai un bel po' di compiti per casa da completare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735304,
					"content": "Eh? O-Oh, beh, è vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735305,
					"content": "Bene, allora sbrigati a finirli e vai a dormire di buon'ora, o Faruzan starà in pensiero. Questo è l'aiuto che puoi darmi al momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735306
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735306,
					"content": "Ah... Va bene...",
