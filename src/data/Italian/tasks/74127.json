				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "Come ho già detto, gentile funzionario, questa è la procedura, e non c'è nulla che io possa fare in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "Monsieur Roialte ha inviato la lista dei documenti necessari e io li ho tutti pronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Tuttavia, non basta solo venire qui a prenderli. È contro le nostre norme sulla corrispondenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Eh? Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Ti trovo bene, Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Anch'io vi trovo bene. Devo ringraziare l'aiuto che ho ricevuto da Monsieur Roialte e Monsieur Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Anche tu conosci {NICKNAME}, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Certo. {NICKNAME} mi ha fatto un grosso favore, in passato. Se non fosse per {F#lei}{M#lui}, oggi non lavorerei più alla Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Sul serio? Non mi stupisce che l'Istituto consideri {NICKNAME} {F#una}{M#un} Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "Fornire supporto morale è la mia specialità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Sia come sia, senza di te... di sicuro non ce l'avrei mai fatta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "#Se ho ben capito, Monsieur Choiseul ti ha definit{F#a}{M#o} \"Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}\" dell'Istituto, è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Esatto. Ho perfino l'attestato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "E anche una foto! Dentro c'è pure Paimon, anche se a Paimon l'attestato non l'hanno dato mica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#È così: per riconoscere i meriti e i conseguimenti di {NICKNAME}, l'Istituto ha deciso di conferir{F#le}{M#gli} il titolo di \"Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#Riguardo a quali sono questi \"conseguimenti\"... Beh, lascerò che sia {F#lei}{M#lui} a parlartene. Prima veniamo agli affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "Ho assoluto bisogno di quei documenti, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Ma, stando a ciò che hai chiesto prima, ti servirebbe un ricercatore a farti da guida per scattare delle foto intorno all'Istituto... E sono certo che non sarà un problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Credo che {NICKNAME} sia una persona più che qualificata. Conosce la zona tanto quanto gli altri, quindi sarebbe perfettamente in grado di svolgere l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#Tu che ne pensi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Per me non c'è nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Sei troppo gentile. Se posso contare sulla tua presenza, allora andrà tutto bene. Quando sono arrivato, ero circondato da Meka fuori controllo e da mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Ma le fotografie non sono una faccenda prioritaria, Monsieur Choiseul. In realtà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Mi piacerebbe poterti aiutare, Iaune, ma purtroppo ho le mani legate e questa è la procedura. Per favore, non complicare le cose per un comune ufficiale pubblico che si occupa solo di stampare documenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Molto bene, più tardi, al mio ritorno, ne discuterò con Monsieur Roialte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Arrivederci, Monsieur Choiseul. E buona giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Ti ringrazio. Spero che ti divertirai all'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#Ora tocca a te farmi da guida, {NICKNAME}. Perché non cominciamo dal Parco della memoria di Mary-Ann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "Aiutare Iaune è sempre un piacere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Ho solo sistemato l'Autostamper 3000.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Allora più tardi ci faremo una trasvolata fin quaggiù.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Che bello averti qui. E che fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 7412702,
