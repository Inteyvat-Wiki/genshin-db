					}
				]
			},
			"dialogs": [
				{
					"id": 741270301,
					"content": "Così questa è la Sala per le riunioni accademiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "La struttura ha di sicuro l'aspetto di una sala, ma... di preciso, cos'avrebbe di \"accademico\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "La parte accademica è quella nella testa dei ricercatori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Beh, per fortuna oggi non sono venuto per la roba accademica. Comunque, l'edificio sembra relativamente... intatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "\"Intatto\" è la parola esatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Ahem! Forza, diamo un'occhiata in giro. Credo che questo sia il posto ideale per scattare una foto di gruppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Devo trovare un posto dove avere una buona visuale d'insieme, così almeno avrò qualcosa da dire in caso Monsieur Roialte decidesse di torchiarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#Scatta qualche foto anche per me, {NICKNAME}. Mi hanno detto che sei {F#una brava fotografa}{M#un bravo fotografo}, di sicuro migliore di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "Le rocce non sono accademiche, questo è sicuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
		{
			"id": 7412704,
