							4221.525,
							466.37,
							4554.115
						],
						"pointId": 6053
					}
				]
			},
			"dialogs": [
				{
					"id": 741270501,
					"content": "O Archon, abbiate pietà. Spero che i Meka non diano più problemi... Che cosa ci fai qui, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "Monsieur Roialte mi ha mandato qui per condurre un'ispezione, così ho pensato di fare un salto per portarle del caffè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Ma devo dire che il suo ambiente di lavoro è... piuttosto duro. Credevo che in questo \"ufficio\" ci fosse almeno una stanza propriamente detta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Grazie per il caffè, caro Iaune. In quanto all'ambiente di lavoro... quello che ho mi basta e avanza. Per lo meno ho un tetto sopra la testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "Sei ancora tu il responsabile delle valutazioni delle qualifiche?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! Anzi, no... Ora devo chiamarti Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}! Che bello averti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Cos'è quella faccia triste, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "*sospira* Il fatto è che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Scuro in volto, Iaune racconta tutto quello che è capitato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Mmmh... Ci sono documenti riservati all'interno di questa corrispondenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "Non credo. Se fosse il caso, le risposte più tipiche sono: \"Ho capito\", \"Non ho altre domande\", \"Non lo so\" o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "Al massimo, viene ricopiata per sezioni diverse per metterle al corrente di qualcosa d'importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Oh, ecco perché ho ricevuto anch'io una copia della lettera... Guarda, è di questa che stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "Cosa?!? Ma Monsieur Choiseul ha detto espressamente di non averla ancora spedita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "...Oh, credo intendesse dire le lettere dirette all'esterno non sono ancora state spedite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Come al solito, ha dimenticato i dettagli più importanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "Quelli dell'Istituto sono davvero dei professionisti nel dare sui nervi, eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "A giudicare dalla tua reazione, immagino che sia questo il documento che cercavi. Io l'ho già letto diverse volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Direi che è identico a quello che volevi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#Molto astuto, {NICKNAME}. Di sicuro tutte le lettere che ha spedito Choiseul sono identiche, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "Puoi prendere semplicemente la mia copia, se vuoi. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "Aspetta, che? Se la dai a Iaune, qualcuno non penserà che tu abbia smarrito la tua copia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Ahahah, ma mi hai visto? A chi vuoi che importi che se qualcuno nella mia posizione perde per sbaglio una lettera così trascurabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Non è una cattiva idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Lo vedi, Iaune? Non sono bravo soltanto a scroccarti il caffè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "No, Messire, questo non posso farlo. È contro le regole. Tornerò indietro e aspetterò che la lettera ufficiale venga recapitata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "Mio caro Iaune, non essere sciocco. Pensa fuori dagli schemi! Perché vuoi renderti le cose più difficili di quello che sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Non hai idea di quanto dovrai aspettare per riceverla! Prima l'avrai tra le mani, prima potrai iniziare a risolvere la questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "No, Messire. La ringrazio molto, ma non intendo trasgredire le regole. Il mio dovere da onesto cittadino me lo impone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Monsieur Desnos, Paimon... Ora devo congedarmi. Monsieur Roialte sta ancora aspettando il mio rapporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune si allontana a passo pesante e solenne...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "*sospira* Iaune a volte riesce a essere così stupido. È come se gli si fosse fuso il cervello, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Tutti cercano un modo per semplificarsi la vita, se c'è; lui invece si limita a seguire meccanicamente le procedure, anche per minuzie come questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "È questo il suo carattere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Da una parte è ammirevole, ma dall'altra è tremendo. Non mi meraviglia che abbia così pochi amici alla Maison Gestion, a parte Roialte e Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "#Anch'io sono su{F#a}{M#o} amic{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "E Paimon, pure Paimon lo è!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Buon per lui. Dovresti frequentarlo più spesso. Sento che da un giorno all'altro potrebbe avere un esaurimento nervoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Per quanto riguarda la lettera, vedrò di inventarmi qualcosa. Andrò a parlare con Choiseul e gli chiederò di spedirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Se acconsente, farò in modo che Iaune riceva la sua al più presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "*sospira* Essere amico di uno stupido è davvero faticoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "Iaune è fatto così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "È una soluzione al problema, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
