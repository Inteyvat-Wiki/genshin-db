							4471.684,
							541.04,
							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Uh, così questo è il Parco della memoria di Mary-Ann. Non l'avrei detto, non ha esattamente l'aria di un parco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Monsieur Roialte resterà un po' deluso. Sperava di poterlo utilizzare per organizzare un discorso pubblico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Se mi guardo intorno, direi che è fuori discussione. Non c'è nessun punto di riferimento particolare e non è adatto per scattare delle foto di gruppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Ma puoi portarti appresso uno dei Meka come ricordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "Bella battuta, ma alla Maison Gestion non c'è posto dove disporre cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "E poi, anche se potessi, dovrei prima far valutare il Meka, protocollarlo, categorizzarlo e infine conservarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "Ehi! Guarda che stavamo scherzando. Non c'è bisogno di prenderla così seriamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Parlando di protocolli... Non sono ancora riuscito ad avere quel documento. Finirò di nuovo per deludere Monsieur Roialte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Choiseul ti sta rendendo le cose difficili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Non proprio. So di avergli fatto una richiesta non esattamente ortodossa, quindi è normale che non l'abbia accettata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Come saprete già, l'Istituto sta attuando dei piani di ricostruzione, no? A questo scopo, la Maison Gestion si è occupata di organizzare una parte del personale e delle risorse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "La Maison Gestion tratta questa faccenda con grande serietà, così Monsieur Roialte ha selezionato una squadra per effettuare degli studi sul campo e dell'area circostante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Pertanto, Monsieur Roialte è rimasto alla Maison Gestion per selezionare il personale, mentre a me spetta il compito di visitare l'Istituto e coordinare le attività di accoglienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Ho saputo che l'Istituto ha una lettera indirizzata alla Maison Gestion, così, giacché ero qui, ho pensato di farmela consegnare per recapitarla di persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Ma Monsieur Choiseul dice che si tratta di una violazione della procedura e non intende darmela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Una violazione della procedura? Quale procedura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "Esistono delle procedure specifiche per poter ricevere un documento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Woah! Quindi è tutta questione di andare in giro a raccogliere approvazioni, apporre firme e ascoltare ore e ore di burocratese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Per dirla in parole povere, gran parte della corrispondenza all'interno della Maison Gestion va effettuata via posta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "Cosa? E questo vale anche... se due sezioni si trovano sulla stessa strada, o magari sui due lati opposti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "Sì, bisogna spedirle in ogni caso. Questo serve a fare in modo che siano \"tracciabili\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "I funzionari giudiziari sono veramente solerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Immagino che ormai tutti c'abbiano fatto l'abitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Ma lasciamo stare, raggiungiamo la prossima destinazione. Fatemi solo controllare il promemoria che mi ha dato Monsieur Roialte... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "Il posto si chiama... \"Sala per le riunioni accademiche\". Strano... Quando sono venuto, non mi sembra di aver visto edifici chiamati così nell'Istituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "So dove si trova, vieni con me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Sapevo di poter contare su di te! Non so proprio cosa farei se tu non fossi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Muoviamoci, allora. Potrebbero esserci dei Meka fuori controllo, qui intorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "Di cosa stavate parlando tu e Choiseul di là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
		{
			"id": 7412703,
