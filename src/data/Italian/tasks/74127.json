					}
				]
			},
			"dialogs": [
				{
					"id": 741270401,
					"content": "Oh, accidenti... È troppo alto, davvero troppo alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Stai descrivendo il livello accademico dell'Istituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "No, sono stupito dall'altezza di questo posto! Ma il livello accademico dell'Istituto è altrettanto alto, poco ma sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Davvero, però... *sospira* Chi immaginava che l'Istituto si sarebbe ritrovato ad affrontare simili difficoltà? Chissà se i lavori di ricostruzione andranno davvero avanti senza intoppi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "L'ultima destinazione è... l'Ufficio di rappresentanza per le valutazioni delle qualifiche dell'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "L'hai detto tutto d'un fiato, impressionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Grazie. Ma dove si trova? Non mi sembra di aver visto nessun ufficio del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "Non c'è Desnos a capo di quell'ufficio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "#Sì, infatti! Sai anche dove si trova quello? Non dovrei stupirmene, in fondo sei {F#la}{M#il} Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}, è ovvio che tu sappia tutto dell'Istituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Oh, adesso Paimon ricorda! Non era quell'ufficio all'interno delle rovine? Non so quanto lo si possa considerare un \"ufficio\", a dirla tutta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Forse Monsieur Desnos ha accorciato il nome per renderlo più facile da capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Fatemi strada, per favore. Ho alcuni documenti da chiedere anche a Monsieur Desnos. Una volta fatto, potrò tornare alla Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "È stata una giornata piuttosto tranquilla, penso che riuscirò anche a riposarmi un po'. Devo dire che l'Istituto di ricerca di Fontaine ha un modo di fare decisamente diverso rispetto a... Ahem! Come non detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
