					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "Quasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "Fammele vedere quando hai finito, per favore.",
