						],
						"pointId": 10048
					}
				]
			},
			"dialogs": [
				{
					"id": 750660201,
					"content": "Ah, questo posto è davvero maledetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660202,
					"content": "Non indugiate oltre. Andatevene e fatelo in fretta... Prima che arrivi la marea nera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660203,
					"content": "Sì, la marea nera. La sua ombra enorme è quasi sopra di noi. Dobbiamo... Dobbiamo assicurarci che tutti siano al sicuro. Che... Che tutti vengano evacuati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506603,
