						4700107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700107,
					"content": "È un'emergenza! Dobbiamo necessariamente ordinare una generosa porzione di <color=#00E1FFFF>Toast del pescatore</color> dal <color=#00E1FFFF>Buon Cacciatore</color>, subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700108,
