					"nextDialogs": [
						4700105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700105,
					"content": "Sormontata da una generosa porzione di cipolla a fettine, leggermente caramellate dalla tostatura... Gnam!",
