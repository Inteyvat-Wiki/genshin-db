				},
				{
					"id": 4700202,
					"content": "Il Toast del pescatore del Buon Cacciatore è il migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700203,
					"content": "Potrà sembrarti strano, ma in realtà si tratta di una ricetta classica che chiunque a Mondstadt è in grado di cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700204
