			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Ora tocca a me trovare chi è nascosto, eh? Ti scoverò di sicuro, Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Se fossi in te, non ne sarei così sicuro! Ci sono dei posti dove nemmeno tu puoi arrampicarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Beh, mm, quello è solo perché non ho le calzature adatte. Se cambiassi scarpe, ti troverei sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Allora leviamoci entrambi le scarpe. In questo modo saremo alla pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Smettetela! Non vi è consentito correre in giro a piedi nudi. Per terra c'è di tutto. E se vi tagliaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060106,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Mm, fratello, quando prima stavi per prendermi eri un tantino distratto, vero? Ti ho corso accanto, ma tu non hai battuto ciglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Eh? Davvero? Non l'ho notato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060110,
					"content": "Esattamente! Prima ho corso per un giro completo, ed era come se non mi vedessi per niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "Ma... Eh? Siete voi? Cosa ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060112,
					"content": "Perché Lovi è qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Papà ha detto che doveva andare al lavoro. Anche la mamma deve lavorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Aurèle doveva restituire un libro, quindi papà gli ha chiesto di prendersi cura di me, così sono venuta a giocare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Non ha importanza, continuiamo a giocare. Chi fa la conta adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060119,
					"content": "Pensavo che non ti piacesse giocare a nascondino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Beh, ehm... *tossisce* Ultimamente ho provato a scrivere una recensione, e avevo delle domande a cui non riuscivo a rispondere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060122,
					"content": "Ho scoperto che, beh... La mia mente è più agile quando faccio sport, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060123,
					"content": "Ma si estranea facilmente, e certe volte resta impalato a parlare da solo. Non reagisce a nessuna cosa gli si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#Perché non ti unisci a noi, {F#sorella}{M#fratello}? Sei molto meglio di mio fratello a nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Eheh, nemmeno noi con te. Io e Lovi siamo maestri di nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Allora cominciamo. Forza, Lovi! Dobbiamo trovare dei nascondigli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi e Verut corrono come il vento, mentre Aurèle si allontana lentamente, immerso nei pensieri...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Non ci andrò piano con voi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Come mai questo entusiasmo improvviso per il nascondino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Sempre a nascondino, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Sì. Monsieur Delerue doveva partire per lavoro, e anche zia Dumay doveva lavorare, quindi mi hanno chiesto di prendermi cura di Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060117,
					"content": "Allora l'ho portata qui a giocare con noi... Spero che il suo vestito non si rovini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400602",
							"2"
						],
						"stepId": 2400602,
						"stateName": "QUEST_STATE_UNFINISHED"
