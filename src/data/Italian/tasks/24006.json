				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#Alla fine mi hai trovato, eh? Dunque sei davvero più brav{F#a}{M#o} di noi a nascondino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Vado al punto d'incontro. Spero che a mio fratello vada meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Perché ci speri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Beh, è stato lui a dirlo, no? Il suo cervello funziona meglio dopo aver giocato a nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Ma ha troppi pensieri, e deve accovacciarsi a terra per diverso tempo per raccoglierli e memorizzarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi mi ha detto che le sue idee sono molto preziose, quindi non dovremmo disturbarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "Ecco perché quando giochiamo a nascondino insieme a lui e stiamo per trovarlo, cerchiamo di prendere tempo finché non ha raccolto i suoi pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "È solo che, quando tocca a lui fare la conta, dobbiamo aspettarlo per diverso tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400603",
							"2"
						],
						"stepId": 2400603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "No... Questa sequenza logica non corrisponde. Devo ragionarci sopra da una prospettiva diversa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060302,
					"content": "E se...? No, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060303,
					"content": "Eh? Mi hai trovato! Mi sa che dovrò raggiungere il luogo di ritrovo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060304,
					"content": "Ma questa prospettiva è giusta? No, è... Effettivamente, è giusta o sbagliata...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400604",
							"2"
						],
						"stepId": 2400604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Chissà se Aurèle riuscirà a raccogliere i suoi pensieri...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "Eh, cosa? Hai davvero trovato questo posto? Sul serio, quante volte hai giocato a nascondino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Beh, torno al luogo di ritrovo. La prossima volta mi nasconderò meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400606,
			"completionStepIds": [
				2400606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400606",
							"2"
						],
						"stepId": 2400606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle",
					"Lovi",
					"Verut"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.448,
							281.167,
							4542.663
						],
						"pointId": 340100170
					}
				]
			},
			"dialogs": [
				{
					"id": 240060601,
					"content": "No, no... L'argomento non è sufficientemente rigoroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060602,
					"content": "#Oh, beh... Sembra che Aurèle sia di nuovo nel suo mondo. Comunque sia, grazie per aver giocato di nuovo con noi, {F#sorella}{M#fratello}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "Starà bene...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Fintanto che non si metterà a bere caffè come fosse acqua come mio padre, dovrebbe cavarsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060606,
					"content": "Ci penso io! Non permetterò che mio fratello beva troppo caffè... Se sarà necessario, lo nasconderò in modo che non possa trovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060607
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060607,
