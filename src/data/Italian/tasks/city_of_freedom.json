			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "Lasciate che vi presenti ufficialmente la città del vento, dei denti di leone e della libertà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "#Viaggiat{F#rici}{M#ori} sotto la protezione dei Cavalieri di Favonius... Mondstadt vi dà il benvenuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "Finalmente non dovremo più accamparci all'aperto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "Ma... i cittadini non sembrano particolarmente contenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "Negli ultimi tempi, Terrore alato ha terrorizzato tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "Ma finché abbiamo Jean dalla nostra parte, tutto andrà per il meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "La Gran Maestra Reggente dei Cavalieri di Favonius. Jean, la protettrice di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "Finché Jean è dalla nostra parte, neanche il perfido Terrore alato potrà sconfiggerci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Sembra una persona di grande valore...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Prima che vi accompagni al quartier generale dei Cavalieri di Favonius, ho un regalo per te, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "Un premio per avermi aiutato a sgombrare l'accampamento degli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "Ehi, ehi! E Paimon non ha diritto a un premio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Ahh... È solo che questo premio a te non serve, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "Ma ti posso offrire un piatto tipico di Mondstadt, l'arrosto al miele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "Arrosto al miele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Venite, dobbiamo raggiungere la, ehm... <color=#00E1FFFF>parte alta</color> della città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(Spero che ne sappia qualcosa del Dio di Anemo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
