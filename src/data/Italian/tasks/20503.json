			"dialogs": [
				{
					"id": 205030501,
					"content": "Cosa volete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030502,
					"content": "Ho i pezzi di ferro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "Oh, sì. Me n'ero dimenticato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030505,
					"content": "Questi dovrebbero andar bene. Dovrei riuscire a utilizzarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030506,
					"content": "Vorrei che mi fabbricassi qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030503,
					"content": "Ti ricordi? Mi hai mandato a procurarmi dei pezzi di ferro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
		{
			"id": 2050306,
