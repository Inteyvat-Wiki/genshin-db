			"dialogs": [
				{
					"id": 205030601,
					"content": "Se trovi altri minerali in futuro, puoi sempre tornare da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030602,
					"content": "Preferibilmente quando non sono occupato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "Sembri di cattivo umore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "Il lavoro di un fabbro richiede concentrazione, non prevede di chiacchierare con i clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Quando posso lavorare liberamente, gli affari vanno bene. Il mestiere è tutto qui, e se qualcuno ti dice il contrario vuole solo imbrogliarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Se non avete altro da dire, io mi rimetto all'opera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		}
	]
