				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma mangione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "#Ehi, {F#novellina}{M#novellino}. Non puoi cucinare così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330102,
					"content": "Stiamo preparando le razioni per i Ratniki sull'isola, quindi dobbiamo cucinare pensando ai loro gusti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330103,
					"content": "Questi piatti non vanno bene. In primis, il tuo controllo del calore è tremendo, e in secundis, questa roba non va bene per la nostra dieta. Dobbiamo cambiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330104,
					"content": "Hai molto da imparare. Ti suggerisco di iniziare dai nostri piatti più semplici, come gli hot dog di Nod-Krai. Quando avrai finito, torna da me e fammi vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma mangione"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma mangione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Mmmh. La salsiccia è grigliata come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330202,
					"content": "#Se lavorassi in un ristorante là fuori, direi che saresti {F#un'ottima}{M#un ottimo} chef in seconda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330203,
					"content": "Ma al momento stiamo preparando da mangiare per tutti i Ratniki dell'isola. Quindi non importa quanto sia squisito il cibo, è più importante che sia abbondante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330204,
					"content": "Fai più spesso il pane. Poi ora non ci sono tante verdure e potresti aggiungere dell'altra carne, oltre alle salsicce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330205,
					"content": "Devi esercitarti di più! Torna un'altra volta e prepara della carne rosolata con bacche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma mangione"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma mangione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Mmmh. Hai tagliato la carne in dei pezzi considerevoli e li hai rosolati alla perfezione. Non male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330302,
					"content": "Ma ti ricordo che, quando prepari la carne rosolata, devi considerare i contorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330303,
					"content": "È facile riempirsi mangiando troppa carne. È per questo che ci sono le bacche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330304,
					"content": "Qui sull'isola, ci occupiamo della salute alimentare di tutti, quindi dobbiamo trovare un equilibrio tra verdure e carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330305,
					"content": "In questo piatto non ci sono abbastanza verdure. Non va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330306,
					"content": "Devi esercitarti di più! Torna un'altra volta e prepara del pollo alle Baccalakka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma mangione"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603308",
							"2"
						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma mangione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "Il pollo è saporito e ci sono abbastanza contorni. Vuoi impedirmi di fare il pignolo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330402,
					"content": "...Eh. Non importa. Non che io abbia mai cercato di trovare difetti in voi novellini in particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330403,
					"content": "Sono solo un cuoco. Faccio solo il mio lavoro, e voglio farlo bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330404,
					"content": "E proprio per quello, ho fatto tutti i tipi di preparativi per l'arrivo della Caccia selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Fantasma mangione"
				},
				{
					"id": 760330405,
					"content": "Ma che peccato... Non sono riuscito a consegnare in tempo i piatti pronti... Il cibo si è... rovesciato... rovesciato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma mangione"
				}
			]
		}
	]
}