	"talks": [
		{
			"id": 7603301,
			"completionStepIds": [
				7603302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603302",
							"2"
						],
						"stepId": 7603302,
						"stateName": "QUEST_STATE_UNFINISHED"
