			"dialogs": [
				{
					"id": 240030201,
					"content": "Wow! Mi hai trovato! È stato mio fratello a dirti dov'ero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030202,
					"content": "#Bah, pazienza, immagino tu sia piuttosto brav{F#a}{M#o} a questo gioco. Ci vediamo al nostro luogo di ritrovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
