			"dialogs": [
				{
					"id": 240030901,
					"content": "#Ehi! {F#Le}{M#Gli} hai rivelato dov'ero nascosto? Come ha fatto a trovarmi così presto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Te l'ho già spiegato: i tuoi nascondigli sono troppo scontati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030903,
					"content": "Temo che l'esperienza sia dalla mia parte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Davvero? In tal caso, verrai un'altra volta? Potremmo giocare di nuovo insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "I nostri genitori non sono a casa durante il giorno, e mio fratello sta sempre a leggere... Nessuno ha tempo per giocare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Beh, puoi fare come me e leggere i libri sugli scaffali. È molto meglio di giocare a nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030908,
					"content": "Beh... Preferisco cercare la mamma e farmi insegnare a cucire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "#Sono molto brav{F#a}{M#o} a giocare a nascondino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
