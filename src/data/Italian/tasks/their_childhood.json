				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Quand'è che Verut si deciderà a crescere...? *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030702,
					"content": "Non ti nascondi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Non ne avevo davvero l'intenzione. Se Verut non mi scocciasse continuamente, preferirei leggere i miei libri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030704,
					"content": "I nostri genitori si spaccano la schiena, quindi devo sbrigarmi a crescere per aiutarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030705,
					"content": "Ma Verut non smette di ripetere che gli manca la mamma, quindi devo fargli compagnia. In questo modo smette di piangere per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030706,
					"content": "Scusa, ho parlato troppo. Aspetterò al nostro luogo di ritrovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030707,
					"content": "Spero solo che stavolta Verut non si sporcherà i vestiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
