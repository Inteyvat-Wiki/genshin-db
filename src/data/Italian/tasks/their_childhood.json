			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Stavolta non troverai il nascondiglio che ho scelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Se ti nasconderai in posti del genere saranno i tuoi genitori a venirti a cercare, non io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030103,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Sto giocando a nascondino con mio fratello! Il guaio è che... Beh, lui conosce tutti i miei nascondigli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut, giochiamo qui da così tanto tempo che ormai hai esaurito tutti i posti dove nasconderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030106,
					"content": "E per quanto riguarda i posti dove non puoi nasconderti... Te l'avrò già detto mille volte che non puoi andarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030107,
					"content": "Oh, quei posti non sono tanto pericolosi! Mamma e papà esagerano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Ma quando ti nascondi lì, ti rovini i vestiti. Mamma e papà faticano un sacco, non dargli altre preoccupazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030109,
					"content": "Oh... Va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Magari mi unisco a voi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Davvero? Vuoi giocare con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, non dare fastidio agli altri! Chiedo scusa, mio fratello non pensa ad altro che a giocare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030114,
					"content": "Non preoccuparti, ho tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "Mitico! Visto, fratello? È d'accordo con me! Mi nasconderò meglio di te, vedrai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "*sospira* Ok, allora. In tal caso contiamo su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030118,
					"content": "Verut, non nasconderti nei posti di cui ti ho detto prima, ok? Se i nostri genitori tornano più tardi e ti trovano con i vestiti rovinati, nessuno ti aiuterà a rattopparli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030119,
					"content": "Ho capito, ho capito... Uffa, sei proprio una lagna! Ora mi nascondo. Nasconditi anche tu, presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Vai prima tu. Io so già dove nascondermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030121,
					"content": "#Davvero? Stai imbrogliando, lo so! {F#Lei}{M#Lui} ti troverà di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurèle e Verut si nascondono...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Tranquillo. Non mi stai dando fastidio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Beh, non riuscirei a trovarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
		{
