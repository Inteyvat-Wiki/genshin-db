			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "Assunzione di operai a tempo indeterminato per la manutenzione del Muro di Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181602,
					"content": "Offriamo un salario equo, oltre a vitto e alloggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181603,
					"content": "I dipendenti migliori saranno raccomandati dal funzionario per ricevere un'ulteriore formazione presso l'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321817,
			"completionStepIds": [
				7321817
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321817",
							"2"
						],
						"stepId": 7321817,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "\"Ho perdonato i tuoi peccati nel nome del Re della bottiglia magica, ma chi perdonerà i nostri?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321818,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
