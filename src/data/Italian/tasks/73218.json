			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "\"In quanto porta d'ingresso per Sumeru, il Ribat delle Carovane è un passaggio fondamentale. Questa bacheca è stata creata per informare i mercanti e i turisti di questioni importanti. Si prega di consultarla regolarmente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"Amore mio, anche se siamo distanti, il mio cuore apparterrà sempre a te.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180202,
					"content": "\"Lo so. Hai cose più importanti di cui occuparti. Dopotutto, più è alta la posizione, più aumentano le responsabilità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180203,
					"content": "\"Ma non ho potuto condividere con nessuno la cosa che mi turba così profondamente. Non ho potuto dire loro il tuo nome.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180204,
					"content": "\"Spero che un giorno potrò condividere con tutti la tua saggezza e il tuo sapere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
