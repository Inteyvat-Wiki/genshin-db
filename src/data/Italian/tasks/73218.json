				{
					"id": 732181001,
					"content": "\"Pacchetto avventura nel deserto in vendita: le migliori soluzioni di avventura nel deserto per commercianti e viaggiatori.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181002,
					"content": "\"A coloro che acquistano il pacchetto garantiamo un ritorno sicuro. Siamo responsabili di una multa maggiorata pari a dieci volte il costo per ogni contraffazione venduta. Preordinate ora per avere diritto a uno sconto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"Ho sentito che l'Akademiya aveva allestito un ospedale nel deserto per l'Eleazar, ma è stato abbandonato per ragioni sconosciute...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181102,
					"content": "\"Secondo gli abitanti del Villaggio di Aaru, da lì sono scappati diversi pazienti guariti dall'Eleazar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181103,
					"content": "\"Se lì dentro sono rimaste delle informazioni, forse serviranno a trovare una cura per la malattia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"Dicono che uno di noi del Villaggio di Aaru sia diventato un alto funzionario all'Akademiya. Noi gente della sabbia potremmo vivere una vita migliore in futuro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181202,
					"content": "\"Guadagno a malapena il necessario trasportando queste pietre. Se ricevessi anche una sola richiesta per il trasporto di Conoscenze in scatola, potrei sposarmi nella mia città natale.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181203,
					"content": "\"Ho sentito però che quel funzionario è uno che lotta contro il contrabbando. Non credo che sarà dalla nostra parte.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181204,
					"content": "\"Tsk, ecco perché noi gente delle sabbia facciamo questa fine. Non collaboriamo tra noi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Agli avventurieri che si recano nel deserto: si prega di ricordare che tutte le spedizioni alla Grande Sabbia Rossa devono essere registrate presso l'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181302,
					"content": "Di regola, le reliquie trovate nel deserto appartengono all'Akademiya, e nessuno può appropriarsene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181303,
					"content": "Per motivi di sicurezza, l'Akademiya ha vietato l'accesso alle aree del deserto, a esclusione del Mare della Grande Sabbia Rossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181304,
					"content": "L'Akademiya non si assume alcuna responsabilità per eventuali incidenti nelle suddette aree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
						],
						"stepId": 7321814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"Dicono che alcuni abbiano guadagnato una fortuna limitandosi a vendere del grasso di crisalide arenosa in città. Ora hanno magioni di lusso in centro e si definiscono come una specie di famiglia. Fingono persino di essere amiconi di quelli dell'Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181402,
					"content": "\"Ho passato la maggior parte della mia vita qui a trasportare pietre, e ancora non ho ottenuto nulla.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181403,
					"content": "\"Ma tu pensa che coincidenza! Vendere grasso di crisalide arenosa è un'attività autorizzata dall'Akademiya. Stupido io che non ho le mani in pasta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181404,
					"content": "\"Se vuoi riempirti le tasche, vieni a contrabbandare libri con me. Se funziona, almeno non dovremo più trasportare pietre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
						],
						"stepId": 7321815,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"I giovani di oggi rimuginano troppo su tutto. Se non fosse stato per Sua Eccellenza Maggiore Rukkhadevata, noi abitanti del Villaggio di Aaru saremmo da tempo diventati scheletri sotto quei templi in rovina.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181502,
					"content": "\"Ho sentito qualcuno dire che Re Deshret potrebbe tornare in vita. Persino Sua Eccellenza Maggiore Rukkhadevata non è mai tornata dopo tutti questi anni, figuriamoci Re Deshret.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181503,
					"content": "\"Meglio rimettersi al lavoro. Non possiamo certo vivere dei pochi rifornimenti che consegnano al Villaggio di Aaru ogni mese.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321816,
			"completionStepIds": [
				7321816
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
