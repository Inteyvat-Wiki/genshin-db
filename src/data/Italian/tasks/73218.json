						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "\"Spero che il Mahamata prenda in considerazione la possibilità di inasprire le restrizioni doganali al Ribat delle Carovane.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181802,
					"content": "\"Il fatto che adesso la gente delle sabbie possa attraversare il confine toglie lavoro alla gente di Sumeru e dà la possibilità ai banditi di fuggire nella giungla per nascondersi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181803,
					"content": "\"L'Akasha non è ancora disponibile alla gente delle sabbie, ma gli incarichi affidati dalla Cittadella di Regzar non si limitano ai mercenari. Di questo passo, anche se tutti si presentassero all'esame di ammissione per l'Akademiya, alcuni perderebbero comunque il lavoro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181804,
					"content": "\"Di cosa stai parlando? Gli abitanti del deserto sono il popolo dell'Archon di Dendro, e sono anche cittadini di Sumeru. È naturale che sia permesso loro di entrare in città.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732181805,
					"content": "\"Sii prudente nel dire certe cose qui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
