			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Alla Grande Sabbia Rossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180302,
					"content": "Coloro che non rispettano i defunti resteranno qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "L'Akademiya vieta ogni forma di distruzione del Muro di Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180402,
					"content": "Qualsiasi violazione sarà severamente punita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "\"Vendita di frutta in conserva, ingredienti per dolci e altre specialità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180502,
					"content": "\"La consegna è disponibile per ordini di grandi quantità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180503,
					"content": "\"Ha un bell'aspetto, potrei prepararci dei dango. Effettui consegne a Inazuma?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180504,
					"content": "\"Chiedo scusa, ma la consegna transfrontaliera è disponibile solo per Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Forse il Viaggio dorato non ha bisogno di pubblicità, essendo l'unico hotel del Ribat delle Carovane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180602,
					"content": "Sappiate che il sapore del nostro barbecue è dato dall'aria del deserto. Molto più autentico di quello in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180603,
					"content": "Se siete stanchi dopo un lungo viaggio, vi invitiamo a venire da noi per avere un assaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"Spero che il Mahamata prenda in considerazione la possibilità di inasprire le restrizioni doganali al Ribat delle Carovane.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180702,
					"content": "\"Il fatto che adesso la gente delle sabbie possa attraversare il confine toglie lavoro alla gente di Sumeru e dà la possibilità ai banditi di fuggire nella giungla per nascondersi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180703,
					"content": "\"L'Akasha non è ancora disponibile alla gente delle sabbie, ma gli incarichi affidati dalla Cittadella di Regzar non si limitano ai mercenari. Di questo passo, anche se tutti si presentassero all'esame di ammissione per l'Akademiya, alcuni perderebbero comunque il lavoro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180704,
					"content": "\"Di cosa stai parlando? La gente delle sabbie è il popolo di Sua Eccellenza Maggiore Rukkhadevata e sono anche abitanti di Sumeru. È naturale che sia permesso loro di entrare in città.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180705,
					"content": "\"Sii prudente nel dire certe cose qui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "I ricercatori che soggiornano a lungo al Ribat delle Carovane devono registrarsi presso il funzionario dell'Akademiya prima di pernottare in hotel, per evitare fughe di informazioni e altri imprevisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "I mercanti e i viaggiatori devono registrarsi presso il Mahamata per ottenere l'autorizzazione ad attraversare il confine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180902,
					"content": "È vietato trasportare merci non registrate o di contrabbando le cui importazione ed esportazione sono proibite. Qualsiasi carico illegale sarà confiscato e le parti associate saranno espulse nel deserto in conformità con le leggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732180903,
					"content": "Inoltre, i residenti del Villaggio di Aaru possono attraversare il confine con l'autorizzazione rilasciata dall'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
