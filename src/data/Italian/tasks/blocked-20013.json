				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#Grazie davvero, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Stavo andando a vedere il luogo dove Stanley si è avventurato una volta. Se solo avessi saputo che sarebbero sbucati fuori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Semplicemente non sono abbastanza forte... So con certezza che Stanley non avrebbe avuto problemi a sbarazzarsi di un gruppo del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Perché non ti unisci a me? Dai! ...Uff, non fa niente, non posso lasciare che qualcuno vada addirittura all'avventura al posto mio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Me ne vado. Tieni, sono per te. Ne ho prese tantissime mentre rifornivo le mie razioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "...Anche se non sono esattamente delle razioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
	]
