				"points": []
			},
			"dialogs": [
				{
					"id": 200130201,
					"content": "#Viaggiat{F#rice}{M#ore}, sei tu! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130202,
					"content": "Posso chiederti un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130203,
					"content": "Questi ostacoli sono la sola cosa che mi separa dalla mia avventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130204,
					"content": "Puoi distruggerli per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130205,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "*sospira* Mi piacerebbe essere più come te... Sarei un avventuriere veterano ormai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130206,
					"content": "Vorrei poterlo fare, ma devo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Per favore, ti supplico... Questa non può essere la fine della mia avventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2001303,
			"completionStepIds": [
				2001304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
