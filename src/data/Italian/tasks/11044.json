			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Sono tornato, hai visto qualcosa di interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "Non ci ho capito nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Non temere, sono solo per scopi alchemici. È difficile trovargli un uso nella vita di tutti i giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Beh, andiamo avanti con la ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Potrebbero esistere differenze significative tra mondi diversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Prendi Teyvat, per esempio. Qui, le persone con le Visioni possono manipolare gli elementi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Ma potrebbero esistere dei mondi in cui una sola persona è in grado di farlo, o persino tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Quindi, lasciando da parte gli elementi... Tu possiedi qualche... abilità unica, {NICKNAME}? Abilità che non esistono in questo mondo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Credo che la risposta a questa domanda richieda una metodologia simile alla precedente. In altre parole: è ora di un esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "Devo combattere di nuovo contro i Melmosi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "No, no! Non dovrai compiere sforzi simili, stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "Ora, vedi quel pilastro? Usa la tua forza di volontà per distruggerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "Scusa, non ci riesco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "Tutto qui il tuo sforzo? Mmmh... Beh, immagino tu non possa farci niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "Perché sei deluso? Non è, tipo, impossibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "Ah! Hai provato a usare il tuo potere elementale sul cibo? Non intendo per cucinare, o simili... Intendo incanalare il tuo potere negli ingredienti stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Sono curioso di sapere come ne risponderanno gusto e consistenza. Potrebbe persino aiutare la... proliferazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Gli alchimisti hanno proprio una fervida immaginazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Ahah, suppongo sia curioso di comprendere ciò che altri reputano sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "Comunque, perché non ci cucini uno spratto al burro saltato? Ho appena finito di preparare la ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "Cucinare? Paimon voleva vedere altra roba da scienziato pazzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Questa ricetta non è solo un alimento basilare per me, è anche un qualcosa di molto nutriente e su cui vale la pena sperimentare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "Bah, Paimon scommette che sei soltanto affamato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Però sembra appetitosa, in effetti... Ok, Paimon approva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "So dove vuoi arrivare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Eh sì, i buoni amici sono sempre sulla stessa lunghezza d'onda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Allora ti lascio fare. Non vedo l'ora di conoscere i risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "Se avanza qualcosa, magari Timaeus può finire gli ultimi bocconi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Mmmh... Paimon non pensa che sarà il caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Ti tengo da parte una o due pinne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Sei certo che non sia semplicemente frutto della fame?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Paimon, provaci tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Pensi che Paimon sappia fare una roba simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "Tutto qui il tuo sforzo? Mmmh... Beh, immagino tu non possa farci niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Ho già dato, grazie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "La tua roba non è molto ordinata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Sono d'accordo. Mi piacerebbe tanto trovare un momento per mettere tutto in ordine. Però, prima gli esperimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Caspita, le hai trovate? Incredibile, grazie davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Mi chiedo se... Questa Vista elementale è ciò che ti ha permesso di localizzare gli oggetti e di trovarmi qui tra le montagne, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "Sì! Immagino che questo conti come superpotere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Purtroppo, anche se la Vista elementale è rara, non è del tutto sconosciuta a Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Solo un potere mai visto prima e proveniente da un altro mondo gioverebbe alla mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Vuoi dire... che abbiamo fallito di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "Non scoraggiarti, rientra tutto nelle mie aspettative. E poi, hai ritrovato questi oggetti! Si può dire che l'esperimento sia stato proficuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Devo elogiare la tua deduzione riguardo alle tracce elementali contenute negli oggetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "#Bene. Finora, la nostra ricerca si è focalizzata sulla tua identità come essere proveniente da un altro mondo. La nostra ricerca sulla tua identità come un{M#o}{F#a} di noi sta per iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Sarò con te fino in fondo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "Essenzialmente, le differenze tra gli umani sono riflesse nelle nostre capacità intellettuali e fisiche. Iniziamo con quelle fisiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "Da questa posizione, riesci a vedere cosa sta facendo Sucrose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "E se saltassi da qui e atterrassi su quella scarpata, quella laggiù, riusciresti a vederla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "E se tu dessi un unico colpo alla montagna qui di fronte ed essa esplodesse in un milione di frammenti? Saresti in grado di vederla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Mmmh, allora non dovrei esaltarmi troppo. Sta di fatto che acquisiremo una comprensione più dettagliata tramite un esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Conosco un luogo perfetto per un test fisico. Seguimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "Sembra che il test dei superpoteri non sia ancora terminato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Come si scende da questa barca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104416",
							"2"
						],
						"stepId": 1104416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Mmmh, un risultato nella media per un piatto accettabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "Per quanto riguarda l'ipotesi di proliferazione, abbiamo fallito. Sembra che il cibo comporti le stesse scocciature nel tuo mondo così come nel nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "A meno che... Forse sono le leggi naturali di questo mondo a limitare le tue abilità uniche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Non sappiamo come si incanala il potere elementale nel cibo. È un po' più complicato che aggiungere erbe e spezie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Non preoccuparti, almeno abbiamo fatto buon uso del cibo, non c'è bisogno di buttarsi giù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Ed eccoti la tua porzione, buon appetito! Posso incartarla, se vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Oooh, grazie! Paimon è felice che hai fatto attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Sei il nuovo preferito da Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "Si vede che la vostra è una bella amicizia. Paimon è sempre stata attenta alla tua sicurezza durante tutto l'esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Non che Paimon avrebbe potuto fare molto se qualcosa fosse andato storto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Ehi! Fino a un attimo fa eri così gentile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Ma hai delle ricette deliziose, Paimon ti perdona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "E hai ragione, la nostra è una bella amicizia. Anche tu hai buoni amici, vero? Buoni studenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "Ehm... sì! Anch'io sono fortunato, immagino. Comunque, passiamo al prossimo esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Qui dentro, ci sono oggetti alchemici di tutti i tipi. Tenerli tutti al proprio posto è a dir poco una sfida. Tempo fa, ho avuto la sfortuna di perdere delle fiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Sono riuscito a ritrovarne la maggior parte, ma non riesco proprio a trovarne due: l'estratto elementale di Cristallottero di Anemo e la polvere di Ipostasi di Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon ha appena finito di mangiare e tu vuoi che andiamo di nuovo a trovare oggetti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Non temere se non li trovate, pensavo comunque di sostituirli. Però, se li trovaste, mi risparmiereste la fatica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Se tu avessi, diciamo, un \"superpotere\", come la visione notturna o la percezione delle vibrazioni, gli oggetti smarriti sarebbero acqua passata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Devo averli persi da qualche parte nella zona in cui stavate cercando poco fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Quindi... andiamo a dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Dovrebbero esserci delle tracce elementali degli oggetti smarriti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Ah, sì! Potresti usare la Vista elementale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Paimon non riceve spesso queste attenzioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
