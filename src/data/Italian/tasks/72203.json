			"dialogs": [
				{
					"id": 722030501,
					"content": "Ahah, mi hai trovata di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Mi mancherai, sai? Questa volta sono qui per dirti addio. L'uomo d'oro dice che dobbiamo andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Ma non preoccuparti per me: andrò in un posto dove ci sono tantissime persone con cui giocare! Vorrei che venissi anche tu, ma l'uomo d'oro dice che non è ancora arrivato il momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Nessun problema, però! Davvero! Ti aspetterò lì... e se non riuscissi ad aspettare, mi trasformerò in piccoli frammenti di luce e ti verrò a cercare nei tuoi sogni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Fai buon viaggio, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Sì, grazie! È stato molto divertente giocare con te. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Finalmente avrò compagnia, che bello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonno"
				}
			]
