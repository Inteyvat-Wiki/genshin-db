				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "Oh, non avresti dovuto! Cioè, certo che avresti dovuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310502,
					"content": "Questo è un pegno della gratitudine della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310503,
					"content": "Riceviamo molti nuovi incarichi ogni giorno e, senza gli sforzi di ognuno degli avventurieri, non potremmo in alcun modo rispondere a tutte le richieste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310504,
					"content": "Se completi abbastanza incarichi ogni giorno, potrai venire da me a ritirare una ricompensa speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310505,
					"content": "Il tuo Manuale dell'avventuriere tiene il conto delle avventure che completi ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310506,
					"content": "Ricordati di riscuotere le tue ricompense giornaliere nei giorni in cui completi abbastanza avventure. La quantità di ricompense è limitata, perciò svaniranno se non le riscuoti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310507,
					"content": "Ok, grazie della spiegazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "Non c'è di che. Dopotutto, sei tu che stai aiutando me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310512,
					"content": "Ricorda anche che aiutare un compagno avventuriere a completare un incarico vale come requisito per la ricompensa giornaliera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310513,
					"content": "Ti incoraggiamo a collaborare attivamente con i tuoi compagni avventurieri. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310509,
					"content": "C'è solo una ricompensa al giorno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "Per come stanno attualmente le cose, sì... Chiedo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310511,
					"content": "Ma sappi che facciamo continuamente pressioni sul quartier generale per far sì che tutti i nostri avventurieri ricevano un compenso giusto e adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
