			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#Hai fatto un buon lavoro, {NICKNAME}! Un performance incredibile, per essere la tua prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "Il richiedente mi ha perfino chiesto di ringraziarti da parte sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "E, come promesso, ti meriti la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003103,
			"completionStepIds": [
				2003104,
				2003107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
