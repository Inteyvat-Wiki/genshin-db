					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#Gira una certa voce, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Si dice che tu abbia completato un <color=#00E1FFFF>incarico</color>. Il richiedente ti ringrazia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "Quale incarico? Rinfrescami la memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Hai aiutato una persona bisognosa durante i tuoi giri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "In realtà, molte delle persone che incontrerai avranno richiesto assistenza alla Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Lascia che ti spieghi il sistema della Gilda un po' più nel dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "La Gilda riceve richieste da ogni dove tutti i giorni e assegna gli incarichi agli avventurieri di conseguenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Queste avventure su commissione sono la fonte principale di ricompensa per i membri della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "A proposito di compenso, devo dirti che la Gilda ti ha preparato una cosina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Mi stavo solo comportando da buon samaritana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "#Ed è proprio questo che ti rende {F#la nostra nuova intrepida avventuriera}{M#il nostro nuovo intrepido avventuriere}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
