			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "#Ci incontriamo di nuovo, intrepid{F#a}{M#o} avventurier{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Le tue avventure stanno andando bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Sono una macchina da avventura, io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Questo è lo spirito giusto. Continua così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Sembri avere un sacco di esperienza ormai. È il momento di presentarti il lavoro ufficiale della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "La Gilda riceve richieste da ogni dove tutti i giorni e assegna gli <color=#00E1FFFF>incarichi</color> agli avventurieri di conseguenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Queste avventure su commissione sono la fonte principale di ricompensa per i membri della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Ma di che genere di incarichi si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Un po' di tutto! Dal correre a fare delle compere per dei concittadini, all'occuparsi dei mostri. Alcuni sono basilari, altri molto pericolosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Ma non devi credermi sulla parola. Lo scoprirai per conto tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Qui puoi trovare i dettagli dell'incarico di oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Torna a fare rapporto quando finisci. Una ricompensa generosa sarà qui ad aspettarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Fantastico! Sapevo di poter contare su di te, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Attenderò il tuo ritorno con grande trepidazione, {NICKNAME}. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "Quanto generosa esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "La pazienza è la virtù dei forti! Lo scoprirai presto. Sicuramente non sarà una delusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "In realtà, avventurarsi è un lavoro abbastanza faticoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "È sempre così quando si comincia. Prepararsi per bene prima di un'avventura può aiutare a rendere le cose più facili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
