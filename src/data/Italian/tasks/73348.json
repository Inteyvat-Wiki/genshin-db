			"dialogs": [
				{
					"id": 733480101,
					"content": "Ma... senza quei campioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "A proposito della Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Sì, nonché l'attuale herbad. Come posso essere utile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "#Hai forse dei quesiti accademici? Devo dire, però, che non hai l'aria di u{F#na}{M#n} ricercat{F#rice}{M#ore} dell'Akademiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "A proposito della lettera di raccomandazione di Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "La lettera in questione è stata scritta da Khedive in prima persona? La leggo subito, solo un istante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Mmmh, quindi le sue ricerche alla Voragine procedono bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "Ricerche sui Miconoidi... ambiente acquatico... fossili... aspetti di carattere geologico... campioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Bene, ottimo, eccellente! Come sempre, è uno studioso sveglio e un ricercatore eccezionale, mai una delusione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Umpf... Anche se detesto ammetterlo di fronte agli stranieri, i ricercatori della Pursina hanno un certo talento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Inoltre, Khedive nella sua lettera ha sottolineato il tuo contributo continuo ed eccezionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Grazie al tuo aiuto, le sue ricerche sono andate \"lisce come il balzo di un gatto\". Si dice così...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Non ne parliamo più, per piacere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Ah, d'accordo. Ehm, mi spiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Quando farà ritorno all'Akademiya, un altro glorioso capitolo si aggiungerà agli annali della Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "E... l'amicizia millenaria tra Purbiruni e Pursina si rinsalderà ulteriormente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "#Ti ringrazio, viaggiat{F#rice}{M#ore}, a nome della Purbiruni e della Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Oh, quasi dimenticavo! Si parlava anche di un regalo per te... Dammi solo un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Ti prego, fa' che non sia un'altra lettera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Certo che no! Il tuo duro lavoro a supporto delle ricerche di Khedive merita di essere ricompensato in Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Ma, ecco... perdonami, oggi è stata una giornata caotica e non ho molto qui con me. Se non vi dispiace, aspettatemi un secondo qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Un altro ricercatore orgoglioso, non è così? Ma... sembra essere molto diverso da Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Ha un'aria... piuttosto povera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "C-Come? Noi della Purbiruni nasciamo ricercatori, non siamo attratti dal vil denaro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Investiamo quasi tutto ciò che possediamo nella ricerca... e per il resto tiriamo la cinghia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Ma non lasciamo che ciò turbi i nostri studi. Anzi, in assenza del condizionamento dei beni materiali, la via per la saggezza ci appare più chiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Andrò a occuparmi del tuo pagamento a breve. Ma prima non posso fare a meno di formulare una richiesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "#Khedive parla di te come di {F#un'avventuriera}{M#un avventuriere} forte, espert{F#a}{M#o} ed eccezionale, come se ne vedono raramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Quindi mi chiedevo se... potessi farmi un piacere. Non troppo tempo fa, ero andato da solo a esplorare il deserto per uno studio di carattere geologico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Non avevo assunto una guardia del corpo... per mancanza di soldi. Era una trasferta di breve durata, pensavo non ci sarebbe stato bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Ma, per mia sfortuna, al ritorno ho incontrato Cacciatori di tesori lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Anche se sono riuscito a scappare sano e salvo in città, la cassa con tutti i miei campioni e gli appunti è andata perduta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "I mercanti e i Cacciatori di tesori non sapranno che farsene di quella cassa, ma per me... per me ha un valore inestimabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "#Nessun avventuriere ha voluto aiutarmi finora... Viaggiat{F#rice}{M#ore}, posso contare sul tuo aiuto? Per piacere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Ti darò una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Davvero? Non potrò mai ringraziarti abbastanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Ecco, qui ho segnato il punto in cui è avvenuto l'attacco. La valigetta non può essere troppo lontana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Mi è bastato sentirlo da lui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Chiedo scusa, sei un ricercatore della Purbiruni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
		{
			"id": 7334802,
