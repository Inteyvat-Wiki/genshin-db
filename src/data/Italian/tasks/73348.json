						],
						"pointId": 600100254
					}
				]
			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Guarda un po' chi si vede! Hai trovato uno della Purbiruni? Non è poi così difficile, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "In effetti è così, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Mmh? Ti vedo esitante. Qualcuno ti ha dato problemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Racconti a Khedive quanto è accaduto a Sadife...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah, Sadife... Lo sappiamo tutti che ha la testa dura, anche gli insegnanti a volte si arrendono con lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Pensa che continua a rifiutare qualsiasi finanziamento e insiste nel lavorare da solo, per non \"contaminare\" la sue ricerche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Un'applicazione pratica del detto \"la saggezza non conosce ricchezza\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Beh, quella è la regola della Purbiruni... Ahah, alla Pursina non sono così rigidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Beh... A dirla tutta, è solo perché sono alquanto benestante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Come hai fatto a fare soldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "Cos'è quella faccia sospettosa? Ho lavorato duro per guadagnarmi la mia ricchezza. Hai idea di quanto sia complicato il trading di futures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "T-Trading di futures?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Non è facile... Bisogna cogliere le tendenze del mercato, conoscere i volumi delle transazioni e sapere su cosa investire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Ho cominciato un po' per divertimento, perché non volevo sottrarre tempo alle mie ricerche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Non immaginavo che... Ugh! Ho iniziato a guadagnare sempre più Mora, il capitale in Borsa non la smetteva più di crescere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "\"Sono un ricercatore professionista! I miei interessi sono le ricerche e il lavoro accademico, non i Mora!\" È quello che continuavo a ripetermi ogni giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Eppure, ogni volta che mi trovo alla Città di Sumeru non resisto al richiamo della Borsa, e non posso fare a meno di dedicarmi al trading sui futures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Di conseguenza, il mio conto in banca è cresciuto a dismisura, mentre la mia ricerca... RISTAGNA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Quindi, ho reclutato un'intera squadra per una spedizione alla Voragine. L'unico modo che ho di combinare qualcosa è stare il più possibile lontano dai posti in cui esiste una Borsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Non me ne andrò dalla Voragine senza... senza aver prima ottenuto dei risultati soddisfacenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "È così che ti arricchisci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Come fai a essere così ricco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "È successo qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
