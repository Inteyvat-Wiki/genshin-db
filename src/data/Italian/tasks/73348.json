				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1856.942,
							155.632,
							5478.944
						],
						"pointId": 330700023
					},
					{
						"sceneId": 3,
						"position": [
							-1855.365,
							155.684,
							5479.971
						],
						"pointId": 330700024
					},
					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Ehi! Stop! Basta! Basta così, ho detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "*ansima* Davvero, non ha senso. È solo una cassa piena di libri. Prendetevela pure, se ci tenete tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "Tutto qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Lo giuro! Non abbiamo preso altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Oltre ai libri, abbiamo trovato delle rocce e del fango in provetta... Anche se, ora che ci penso, c'era qualche bella gemma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "Le avete prese voi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Ehi, restituite quelle gemme! Sono dei campioni geologici di grande valore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Campioni... geologici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Restituitele subito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Sì! Va bene! Come vuoi, te le ridiamo! Presto, rimettete tutto a posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Vedi? Ora non manca più niente. Perciò, noi adesso ce ne andremmo... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "Bene, qui dentro dovrebbe esserci tutto quello che Sadife cercava. Riportiamogli la cassa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "E pensare che è venuto nel deserto tutto da solo, ha raccolto un sacco di campioni e preso un mare di appunti! Paimon lo considera un ricercatore eccellente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "Conterò fino a tre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Sicuri che non c'è altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
			"id": 7334803,
			"completionStepIds": [
				7334805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7334805",
