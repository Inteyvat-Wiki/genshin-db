			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sadife"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "#Viaggiat{F#rice}{M#ore}, sei tornat{F#a}{M#o}! A proposito della mia cassa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Ecco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Fantastico, grazie davvero! Nonostante avessi una lettera di raccomandazione, ti ho dato così tanto lavoro da fare... Ti prego di accettare questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Come dicono sempre quelli della Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Ah? Quindi lo sai già? Si è proprio un comandamento della Purbiruni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "È un ammonimento contro la tentazione di tradire i princìpi della ricerca per ragioni venali o di altra natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Del resto, un ricercatore che si dedichi alla ricerca per fini di lucro non è degno di essere chiamato tale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Ma considerando gli sforzi che tu hai fatto per aiutarmi, meriti assolutamente una ricompensa adeguata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Ti ringrazio ancora per l'assistenza, e fammi sapere se posso fare qualcosa per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "Intendi che \"la saggezza non conosce ricchezza\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "L'ho recuperata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
		{
			"id": 7334804,
