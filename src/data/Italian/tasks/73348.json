			"dialogs": [
				{
					"id": 733480901,
					"content": "*sospira* Questo misero finanziamento non è minimamente sufficiente per la mia ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Ehm, chiedo scusa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Un ricercatore della Purbiruni, dici? Credo che tu stia cercando Sadife. Di solito non riceve mai visite... Davvero inconsueto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Di recente si è occupato di certe cose all'Akademiya, e deve essere nei paraggi. Come mai lo cerchi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "A proposito della lettera di raccomandazione di Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive? Quindi ha concluso la sua ricerca? Deve essere bello avere così tanti soldi da poter ingaggiare un'intera squadra di ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Io invece non riesco a ottenere fondi neanche per un semplice sopralluogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Conosci Khedive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Certamente! Noi ricercatori poveri in canna, sempre alla ricerca di finanziamenti e a corto di Mora, sappiamo tutto delle sue mirabolanti ricchezze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Woah, vuol dire che... questo Khedive... e i ricercatori della sua famiglia sono tutti ricchi sfondati?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Vuol dire che ci daranno una ricompensa bella cicciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Neanche per sogno. Khedive è un'eccezione: non aspettarti nulla dai ricercatori della Purbiruni e Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Specie se parliamo di quelli che si specializzano in astrologia o che studiano storia e biologia... Tra loro ci sono diversi sventurati che non possono nemmeno permettersi di richiedere dei fondi di ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "Inoltre ripetono sempre che \"la saggezza non conosce ricchezza\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "Ehm, forse non era il caso di dirlo... Ecco la persona che cerchi: se hai altre domande, potrai porle direttamente a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "A proposito del ricercatore della Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
		},
