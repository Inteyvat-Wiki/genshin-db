			"dialogs": [
				{
					"id": 700730401,
					"content": "Non ti disturberò più, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730402
					]
				},
				{
					"id": 700730402,
					"content": "Vai dove vuoi. Il fungo non ha bisogno di un guardiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
