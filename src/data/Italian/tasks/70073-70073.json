			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Voglio allenarmi con questo colosso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Che sia lode! Anche il mio Signore deve mantenere il suo corpo divino agile, affinché le fette cadute possano diventare tenere e ricche di sapore. Non trattenerti. Non mostrare pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "O mio Signore, Maha Vasudeva{RUBY#[D]Discendente del Signore che dona il mondo}yaputra, possano le tue Jivit{RUBY#[D]Radici della vita}indriya affondare in profondità nelle fondamenta di questa terra. Possa il tuo gusto superare quello di ogni divinità sotto i cieli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Che cos'è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Una domanda oltremodo benedetta! Questo è il venerato erede del{RUBY#[S]Bifrons} Signore che dona il mondo, un sacro fungo nato da un sapore perfezionato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya invoca sempre la Signora della flora e la Signora del giardino {RUBY#[D]Pushpavatika} fiorito. Il khagan Makani prega eternamente il Signore della sabbia. Chiedi pure a loro: dei tre grandi Signori, quale ha un sapore migliore del mio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Sappi questo: non arrecare danno è il sentiero della rettitudine. Se non fosse per la carne divina della nostra Signora, saremmo costretti a togliere la vita a bestie, uccelli e piante per sopravvivere... Ahimè, quanto sarebbe miserabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Davvero promettente. Quando la Signora dello Spazio mi sollevò da terra, le sue ji{RUBY#[D]spore}va viaggiarono con me. E, come potete vedere, sono cresciute fino a oggi, conferendomi un sapore supremo e meraviglioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
