			"dialogs": [
				{
					"id": 705400101,
					"content": "*soffia*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Ser Balzellotto"
				},
				{
					"id": 705400102,
					"content": "*piagnucola* Il gatto mi sta soffiando, Rosaria! Ho paura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Meglio se gli dai un po' di spazio. Se ti avvicini troppo, rischi di beccarti una zampata in faccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Oh-oh, sembra che Valerina abbia ancora problemi coi felini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Sembra che ci sia un nuovo ospite al rifugio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "#{F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Sussurratrice dei gatti! Questo gattone è appena entrato assieme a Palla di neve! L'avrà adocchiata mentre stava passeggiando e deve averla seguita fin qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Su, su, nessuno qui vuole farti del male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Tutta quella malvagità, tutte quelle persone cattive che ti hanno costretto a lottare per sopravvivere... qui non potranno trovarti. Finché resterai tra queste mura, sarai al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Sei fra gente buona, adesso. Certo, potrebbero gironzolarti attorno in maniera fastidiosa, ma è solo per il tuo bene. Puoi rilassarti. Una vita di comodità non è affatto male, sai. Tutto sta nell'abituarcisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*soffia* ... *miagola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Ser Balzellotto"
				},
				{
					"id": 705400112,
					"content": "Ha... Ha capito quello che hai detto?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Sembra che abbia funzionato. Ahah, sei un gatto sveglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Porca pupazza, questo gatto è gigantesco rispetto agli altri. Ha un colore che sembra un Bulle appena spremuto! E indossa pure una sciarpa! Uh, sopra c'è disegnato qualcosa... Oh, il simbolo dei Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Allora si merita un nome degno di un cavaliere! Uhm, sembra avere l'argento vivo addosso. Che ne dite di \"Ser Balzellotto\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Ser Balzellotto"
				},
				{
					"id": 705400117,
					"content": "Ci sai veramente fare con i gatti. Sembra essersi calmato molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Paimon pensa che il merito spetti a te, stavolta. Ser Balzellotto si è calmato subito, dopo che gli hai parlato tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Ti stai abituando sempre di più ai gatti, Rosaria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "La cosa non mi interessa. Però... il fatto che siano carini non è una cosa negativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "Ora Paimon ti farà vedere come mettere Ser Balzellotto a proprio agio! A Paimon basterà solo usare uno dei suoi trucchetti e lo renderà felice oltre ogni misura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Spero che ora troverai l'incarico un po' più divertente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Ha un'aria... quasi solenne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}