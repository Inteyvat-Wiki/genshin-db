			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071401,
					"content": "Un branco di cani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Oh, no... Che segnale nefasto, che la mia vita amorosa sia condannata al fallimento prima ancora d'iniziare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Un attimo, però... Quei cani sembravano amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "Ma certo, li conosco! Si vogliono decisamente un gran bene. Stanno sempre insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Sembra una cosa positiva, ma la verità è che... nessuno di loro ha mai trovato l'anima gemella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Presto o tardi diventeranno vecchi, e a quel punto sarà troppo tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Quindi il segnale mi suggerisce di appassire lentamente in compagnia degli amici, dal momento che non troverò mai una compagna?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "D-Devo sedermi... e pensare molto a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210715,
