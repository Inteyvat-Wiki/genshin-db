			"dialogs": [
				{
					"id": 221071901,
					"content": "Un branco di cani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071902
					]
				},
				{
					"id": 221071902,
					"content": "Oh, no... Che segnale nefasto, che la mia vita amorosa sia condannata al fallimento prima ancora d'iniziare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071903
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071903,
					"content": "Un attimo, però... Quei cani sembravano amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071904,
					"content": "Ma certo, li conosco! Si vogliono decisamente un gran bene. Stanno sempre insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Sembra una cosa positiva, ma la verità è che... nessuno di loro ha mai trovato l'anima gemella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "Non se ne curano solo perché sono costantemente circondati dai propri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Ora potrebbero avere un incentivo a cercare l'amore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "Un incentivo? Ehm... Per caso li hai inseguiti, disperdendo il gruppo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "Mmm... Sai, in realtà potrebbe funzionare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "A volte occorre una forza esterna che rimuova le costrizioni che noi stessi mettiamo in piedi... liberando energie da dedicare alla ricerca del vero amore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Fantastico! Non ti ringrazierò mai abbastanza. Ora ho ben chiaro cosa significhi questo segnale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071912,
					"content": "Qiming... Giuro che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
