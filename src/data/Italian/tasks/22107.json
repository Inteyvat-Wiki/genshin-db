					"content": "Hai trovato qualcos'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071502
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071502,
					"content": "Per il momento no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071503
					]
				},
				{
					"id": 221071503,
					"content": "Capisco... Immagino che farei meglio a parlare ancora con Qiming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210716,
			"completionStepIds": [
				2210716
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
