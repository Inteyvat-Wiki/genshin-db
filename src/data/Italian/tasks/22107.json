			"dialogs": [
				{
					"id": 221071301,
					"content": "Un gatto e un pesce hanno fatto amicizia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "Incredibile, è un segnale magnifico! Sai bene cosa cercare, è chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "Un'amicizia a dir poco trionfale... Quegli animali sono davvero ammirevoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "E non è forse questo il vero significato dell'amore?!? Ovvero la capacità di superare ogni limite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "Dal canto mio, non posso che nutrire un profondo rispetto nei loro confronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Questo segnale mi sta chiaramente dicendo che non devo temere alcun ostacolo lungo la via che porta all'amore. Solo così Qiming vedrà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "Beh, grazie! Grazie molte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210714,
