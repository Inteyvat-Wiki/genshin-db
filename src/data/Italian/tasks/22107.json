			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "Sul tetto c'è una coppia di uccelli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "Capisco... Beh, sembra davvero un buon segno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Due piccioni che abbandonano lo stormo pur di vivere la loro storia d'amore... Non desiderano altro che stare insieme, mentre volano ad ali spiegate verso l'orizzonte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "Questo segnale vuol dire che presto incontrerò la persona giusta, che amerà me e me soltanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "Affronterà qualsiasi avversità, abbatterà ogni ostacolo, non si fermerà davanti a nessuno e infine potremo stare insieme... Noi due uniti contro il mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Ehm... Io, ecco... Ti ringrazio, sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Chissà per quale scherzo del destino si saranno incontrati? E come avranno compreso di essere anime gemelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*sospira* Oh, perché non sono nato con le piume? Non conoscerò mai il dolce sapore dell'amore che sgorga dal becco di un altro piccione... Che destino avverso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Che ne diresti di assaggiare direttamente un piccione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Assaggiare un piccione? Che intendi... Oh, no, non ci credo! Cos'hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "Cos'hai fatto?!? Era solo una metafora! Non avrai davvero pensato che mi stessi riferendo al desiderio di addentare il concetto astratto dell'amore romantico?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "Esistono persone poco inclini al romanticismo, lo capisco, ma questo è davvero troppo! Si ripercuoterà sul mio destino, me lo sento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "È solo che... Non importa. Ho bisogno di restare solo per calmarmi. Perché non torni a ciò che avevi in mente di fare oggi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210717,
