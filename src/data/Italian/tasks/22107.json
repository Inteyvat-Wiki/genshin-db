					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071701,
					"content": "Foglie morte...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "Ma dai, perfino Paimon sa che le foglie morte non hanno niente a che vedere con l'amore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "Al contrario, il collegamento è lampante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "Puoi osservare queste foglie morte e giudicarle semplicemente appassite... Ma io ci vedo un infinito potenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "È sufficiente una scintilla per trasformarle in un fuoco ardente, e un lieve alito di vento basta a proiettarle maestosamente verso il cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "Qualcosa di molto simile al mio inquieto amore, celato in fondo al mio cuore da tempo immemore... Sempre con la speranza che qualcosa possa cambiare tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "*sospira* Purtroppo, però, sarà il destino a decidere. Chissà quando arriverà la svolta... E in che modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "Non devo perdere la speranza. Tutto accade per un motivo, devo solo avere pazienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "Analogie a parte, mi considero il punto di svolta di quelle foglie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "Come? Cosa vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Un attimo, non penserai che... No, di certo non... Non dirmi che tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "Oh, no! Allora è tutto finito! Se distruggerai il tempismo del punto di svolta, andrà tutto in rovina! Fato e amore verranno gettati nel caos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "Chi ti credi di essere? Ti diverti a decidere il destino di queste foglie, come farebbe una divinità capricciosa? Forse volevi aiutare, ma ti assicuro che hai arrecato danni inimmaginabili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "Oh, cosa farò adesso? Grrr, vattene via! Rovina la vita a qualcun altro! Ho bisogno di calmarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
