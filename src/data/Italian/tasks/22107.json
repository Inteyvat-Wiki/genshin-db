					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071806
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071806,
					"content": "Soprattutto per il pesce. Sapeva benissimo di provare sentimenti per un gatto, eppure ha deciso di mettere a nudo la propria anima, di non tenere a freno le sue emozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071807,
					"content": "Puoi dirglielo di persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "Cosa intendi? Ah, il pesce è qui... L'hai portato con te?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Quindi l'hai rapito sotto gli occhi del suo amico felino, che non ha potuto impedirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Che razza di persona assiste a un evento tanto raro come lo sbocciare di un'amicizia tra specie diverse... e fa in modo che le due parti non possano stare insieme?!? Sono eventi da tutelare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Ma a parte questo... Era il segnale perfetto, invece tu l'hai rovinato! Complimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Bah. Lasciami da solo, ti prego. Ho bisogno di tempo per riflettere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
