			"dialogs": [
				{
					"id": 221070901,
					"content": "Hai trovato un segnale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210710",
							"2"
						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Sul tetto c'è una coppia di uccelli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Capisco... Beh, sembra davvero un buon segno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Due piccioni che abbandonano lo stormo pur di vivere la loro storia d'amore... Non desiderano altro che stare insieme, mentre volano ad ali spiegate verso l'orizzonte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "Questo segnale vuol dire che presto incontrerò la persona giusta, che amerà me e me soltanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "Affronterà qualsiasi avversità, abbatterà ogni ostacolo, non si fermerà davanti a nessuno e infine potremo stare insieme... Noi due uniti contro il mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "Ehm... Intendevo dire... grazie mille! Dovrò parlarne con Qiming, ovviamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210711",
							"2"
						],
						"stepId": 2210711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Oggi un mercante sta facendo buoni affari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Attività in crescita? Flusso di denaro costante? Non male, sembra promettente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Si raccoglie ciò che si semina. Occorrono pazienza e impegno, altrimenti non è possibile prosperare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "Questo vale anche per l'amore! Ma certo, ora è tutto chiaro! Bisogna investire sulla propria vita amorosa, mostrare perseveranza e tenacia. Solo così alla fine si possono raccogliere i frutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "Ehm... Grazie di tutto! Ovviamente dovrò riflettere a lungo... Potrebbe anche voler dire qualcos'altro, certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Oh, Qiming! Quel giorno arriverà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210712",
							"2"
						],
						"stepId": 2210712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "Foglie morte...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "Ma dai, perfino Paimon sa che le foglie morte non hanno niente a che vedere con l'amore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071203,
					"content": "Al contrario, il collegamento è lampante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071204,
					"content": "Puoi osservare queste foglie morte e giudicarle semplicemente appassite... Ma io ci vedo un infinito potenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071205,
					"content": "È sufficiente una scintilla per trasformarle in un fuoco ardente, e un lieve alito di vento basta a proiettarle maestosamente verso il cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071206,
					"content": "Qualcosa di molto simile al mio inquieto amore, celato in fondo al mio cuore da tempo immemore... Sempre con la speranza che qualcosa possa cambiare tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071207,
					"content": "*sospira* Purtroppo, però, sarà il destino a decidere. Chissà quando arriverà la svolta... E in che modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071208
					],
