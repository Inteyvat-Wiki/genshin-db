			"dialogs": [
				{
					"id": 250360101,
					"content": "Forse era una domanda troppo semplice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "#Oh, chiedo scusa. Stavo pensando a voce alta. Non ti avevo {F#vista}{M#visto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Mi presento, sono Keita, dei Maestri del Vento della Notte. Sono un apprendista, mi occupo della gestione degli archivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "A cosa stavi pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... A delle semplici domande sul passato, il presente e il futuro di Natlan. Niente per cui valga la pena di intavolare una discussione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "#A giudicare dal tuo aspetto, potresti essere {F#una viaggiatrice}{M#un viaggiatore} proveniente da terre lontane. Intuisco che le tue amicizie sono profonde e la tua conoscenza è vasta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Se lo desideri, puoi metterti alla prova con alcune delle domande che ho già preparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "Troverai le risposte nel tuo cammino passato, presente e futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
