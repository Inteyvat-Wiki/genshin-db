				]
			},
			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor! Dominus Cassiodor... È lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "Proprio come pensavo! È lei! Finalmente è tornato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860304,
					"content": "Mi era stato ordinato di presidiare questa fortezza, ma come potevo far fronte ai crudeli Elementosauri e agli attacchi dei barbari? Sono quindi stato costretto a indietreggiare passo dopo passo, fino ad arrivare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860305,
					"content": "Sembra che siano passati tantissimi anni... Quali notizie giungono? Abbiamo vinto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "...Davvero? Allora abbiamo perso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860308,
					"content": "Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Non dica queste cose, Onorevole Dominus. Quando mi sono unito alle legioni del Sebastos, già immaginavo che questo giorno sarebbe arrivato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860310,
					"content": "Il Sebastos ha detto di volerci liberare dalle catene di \"Fortuna\", giusto? Ma non può essere così facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860311,
					"content": "Dopotutto siamo in lotta contro il destino stesso, e sfidare il destino è un'impresa che va oltre anche il più grande degli dèi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860312,
					"content": "Alla fine, tutti i nostri sforzi sono stati inutili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Non dica così, Dominus. Abbiamo combattuto contro il destino divino, e le nostre gesta hanno sfidato le leggi del cielo. Abbiamo resistito alla profezia, con valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860314,
					"content": "Anche se alla fine siamo stati sconfitti... Qualcuno deve averci traditi, fuorviandoci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860315,
					"content": "Eppure, il risultato non importa più. Sia ciò che sia, le nostre azioni verranno scolpite nella \"storia\" del mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Golem senza nome"
				},
				{
					"id": 741860316,
					"content": "Ehi! Come ha fatto a cadere così? Anche le persone di pietra svengono all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Non conosco il suo nome... Sembra che la sua \"storia\" sia giunta al termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Ma che tristezza! È qui che combatte da migliaia d'anni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Ma ora, finalmente, può smettere. Proseguiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}