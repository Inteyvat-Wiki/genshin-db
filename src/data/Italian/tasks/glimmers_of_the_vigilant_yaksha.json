			},
			"dialogs": [
				{
					"id": 111010201,
					"content": "Quindi vorresti una copia di Yaksha: Gli Adepti guardiani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010202,
					"content": "Sì. Ecco, e tieni il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010203,
					"content": "Oh, che generosità! Ti ringrazio per il supporto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010204,
					"content": "Ehi, ma quello non è, ehm... Strappastelle? Che coincidenza incontrarlo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010205,
					"content": "Si chiama Ladro di stelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "Hai sentito il nome del libro che ha appena comprato? Era... Yaksha: Gli Adepti guardiani, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010208,
					"content": "Beh, in ogni caso, era decisamente un libro sugli Adepti. Perché un Adeptus dovrebbe voler comprare un libro su sé stesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010209,
					"content": "Ho sempre pensato fosse sospetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "Sul serio? Che cos'ha di tanto sospetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010214,
					"content": "Perché un Adeptus dovrebbe volere dei Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "Uhm, ottima osservazione... Nessuno degli altri Adepti che abbiamo incontrato sembrava aver bisogno di qualcosa da qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010220,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010221,
					"content": "Paimon pensa che dovremmo dare un'occhiata a quel libro. Forse scopriremo qualcosa di utile su questo tizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010216,
					"content": "A mio parere, è solo un ciarlatano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Quindi, quello che stai cercando di dire è che non può esaudire i desideri delle persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010218,
					"content": "Ha una maschera davvero terribile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "È vero, lo è davvero. Molto strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010211,
					"content": "Forse è solo un narcisista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "Possibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010213,
					"content": "Mmh, ora che Paimon ci pensa, c'è decisamente qualcosa che non va in questo tizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010206,
					"content": "Coincidenza o adepticidenza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
