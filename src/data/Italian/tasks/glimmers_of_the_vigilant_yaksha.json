				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111010701,
					"content": "Non capisco... Perché il Sigillo del consenso non ha avuto alcun effetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010702,
					"content": "Forse l'aura malvagia di questi Hilichurl è diventata più potente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010703,
					"content": "Il Sigillo del consenso, eh? Come mai mi ricorda qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Ah, sì, ciò che serve per uscire da Jueyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Giusto! È un dono degli Adepti, quindi conserverà ancora delle tracce del loro potere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "*sussulta* Non c'è da stupirsi che sia riuscito a mettere in fuga quei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "C-Che cosa state blaterando voi due? Costui semplicemente non ha dormito abbastanza, quindi non è in grado di esercitare il suo potere adeptico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010709,
					"content": "Se solo costui avesse un'altra opportunità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010710,
					"content": "Beh, si dà proprio il caso che ci sia un altro gruppo di Hilichurl malvagi laggiù. Ci pensi tu, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Costui... Costui... si sente improvvisamente a disagio. Costui ha utilizzato troppo i poteri adeptici, altrimenti sarebbe sicuramente riuscito a sconfiggere immediatamente questi esseri infernali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010712,
					"content": "Uff, lo sapevo che ti stavi dando solo delle arie. Avevamo ragione a nutrire dei sospetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "#Forza, viaggiat{F#rice}{M#ore}, sta a noi. Usa la tua Vista elementale per scovarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "Ecco cosa usava per i suoi esorcismi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
