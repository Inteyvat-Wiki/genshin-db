			"dialogs": [
				{
					"id": 111010501,
					"content": "Al mio ordine, fuggite, demoni immondi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010502,
					"content": "...Fuggite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010503,
					"content": "P-perché non fuggite?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111010504,
					"content": "Beru nye! Beru nya! Beru nyaaaa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 111010505,
					"content": "Oh-oh, sembra che Ladro di stelle sia nei guai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010506,
					"content": "E ci sono anche delle persone innocenti che stanno passando di qui. Dobbiamo intervenire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
