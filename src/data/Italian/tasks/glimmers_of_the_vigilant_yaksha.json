					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010401,
					"content": "Non hai ancora finito? Eheh, Paimon ha già finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010402,
					"content": "Questo libro parla degli Yaksha, un gruppo di Adepti che proteggono Liyue.",
					"roleType": "TALK_ROLE_NPC",
