					"nextDialogs": [
						111011407
					]
				},
				{
					"id": 111011407,
					"content": "Eheh! A essere onesti, Paimon spera che sia un vero Adeptus. Ah... perlomeno la sua tecnica di esorcismo sembrava abbastanza reale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011408,
					"content": "Mmh, ma troppe illusioni porteranno solo ad altra delusione. Perciò, sarebbe meglio indagare a fondo sulla questione, per avere la certezza di non star sbagliando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011409,
					"content": "Va bene, torniamo alla Locanda Wangshu!",
					"roleType": "TALK_ROLE_NPC",
