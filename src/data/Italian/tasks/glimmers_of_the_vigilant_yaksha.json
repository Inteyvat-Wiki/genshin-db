				{
					"id": 111010222,
					"content": "Salve. Vorremmo il libro Yaksha: Gli Adepti guardiani, ne hai una copia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010223,
					"content": "Eh? Da quando quel vecchio libro è diventato così famoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010224
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010224,
					"content": "Per essere così giovani, avete dei gusti piuttosto strani... Ma dovreste riuscire a trovarne una copia da qualche parte su quella scrivania laggiù.",
					"roleType": "TALK_ROLE_NPC",
