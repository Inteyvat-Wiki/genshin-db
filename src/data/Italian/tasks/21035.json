			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "*sospira* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "#Viaggiat{F#rice}{M#ore}! Che coincidenza! Non mi aspettavo d'incontrarti qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "Io... Mi sto addestrando qui, e sto per andarmene da Liyue per viaggiare all'estero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "Cos'è questa storia improvvisa del viaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "*sospira* Beh, quasi mi vergogno a dirlo... La mia intenzione era effettivamente quella di far rivivere il clan Guhua \"facendomi guidare dagli Adepti\", ma finora non ho fatto altro che... vagare sui Monti di Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "Sebbene sia grato a Que'er per la sua compagnia, nel profondo so perfettamente che un tale comportamento non ha nulla a che vedere con la rinascita del clan Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "Qualche tempo fa, mentre stavo facendo la spesa in città, mi sono ritrovato a parlare con un mercante di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "Le sue parole sono state: \"Non puoi trovare la soluzione a un problema nel luogo dove si è verificato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "Ho riflettuto su queste parole per un po'. Forse questo mercante di Fontaine mi stava suggerendo d'intraprendere un viaggio fuori da Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "Viaggiare può aprire gli occhi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "È proprio quello che ho pensato! Ma... Que'er non vuole lasciare Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "Di solito i suoi attacchi d'ira non sono seri, e spesso risultano addirittura scherzosi. Non ci metto molto a calmarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "Ma stavolta sembrava davvero furiosa. Qualunque cosa le dicessi, si rifiuta di ascoltarmi... È persino tornata da sola in città... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "#Ma non voglio annoiarti ulteriormente con queste banalità. Posso chiederti un favore, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "Sebbene abbia imparato delle tecniche difensive in passato, non le ho mai provate seriamente. Se farò questo viaggio, prima o poi mi ritroverò a combattere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "#Viaggiat{F#rice}{M#ore}, ho sentito molte storie sulle tue avventure in tutto il mondo. Devi conoscere un sacco di modi per affrontare i mostri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "Ti andrebbe di accompagnarmi a trovare dei mostri per combatterli? Magari dandomi anche qualche consiglio al riguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Vediamo... Più avanti c'è un posto dove si radunano i mostri. Andiamo prima lì, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "Temo che non riuscirai a vedere chiaramente le mie mosse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "#S-Sei davvero così brav{F#a}{M#o}? Ahah, beh, allora fammi un altro favore e rallenta un pochino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "Puoi considerarlo come una semplice distrazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "Non volevi riportare in vita il clan Guhua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
