				{
					"id": 721590301,
					"content": "Vorrei parlare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "Ho rinunciato al mio passato. Io e questo mondo non abbiamo più niente da dirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590303,
					"content": "Se stai cercando qualcuno con cui parlare, hai sbagliato persona.",
