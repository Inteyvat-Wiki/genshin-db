			"dialogs": [
				{
					"id": 721590401,
					"content": "Ahah. Non sono ancora al tuo livello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590402
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590402,
					"content": "Avrei dovuto aspettarmelo. Tu non fai che migliorare, mentre i limiti della mia natura m'impediscono di compiere simili progressi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590403,
					"content": "Ciononostante, se dovessi imparare nuove tecniche, sarei felice di esserne testimone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590404
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590404,
					"content": "Alla prossima, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masanori"
				}
			]
		},
