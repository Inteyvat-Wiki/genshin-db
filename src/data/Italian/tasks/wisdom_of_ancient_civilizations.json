					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "Saluti! Sono Timaeus, ricercatore di alchimia. Ti do il benvenuto a Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Alchimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "L'Alchimia è un'arte tramandata fin dall'antichità, ma ancora oggi viene compresa a malapena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "I suoi meccanismi sono magici e misteriosi, diversamente dai princìpi che regolano la comprensione del nostro mondo fisico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Se riuscissimo a carpirne i segreti, potremmo realizzare creazioni favolose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "Questo dev'essere il tuo tavolo da lavoro di alchimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Esatto, perché non fate un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "Non so, sembra complicato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Non temere, il processo è molto semplice, in realtà. Se ti interessa, posso mostrarti le basi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Crea",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Ho paura di far saltare in aria qualcosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050602",
							"2"
						],
						"stepId": 2050602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "Fooorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060202,
					"content": "In realtà, stiamo solo seguendo i metodi degli antichi nel modo migliore possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060203,
					"content": "Allo stesso modo in cui chi usa un aliante non ha bisogno di capire com'è stato costruito per riuscire a planare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060204,
					"content": "La differenza con l'alchimia è che, ogni volta che penso di aver finalmente capito come dovrebbe funzionare, succede qualcosa di totalmente inaspettato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060205,
					"content": "Quali altri usi ha l'alchimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "Se devo essere onesto con te, non lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060210,
					"content": "Ci sono tante altre misteriose ricette su cui devo prima svolgere delle ricerche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060211,
					"content": "Nel corso delle tue avventure, potresti trovare gli appunti di altri alchimisti risalenti a civiltà antiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060212,
					"content": "E man mano che il tuo grado avventura aumenterà, avrai a disposizione tante altre ricette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060213,
					"content": "Grazie della spiegazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "Non c'è di che. Non vedo l'ora di sentire altri racconti delle tue imprese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060218,
					"content": "Beh, alla prossima, allora. Che il vento porti fortuna al vostro cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060215,
					"content": "La prossima volta che sentirai parlare di me, sarò un mago in grado di evocare Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "Perché ti interessa tanto avere altre Paimon? Paimon non ti basta per soddisfare i tuoi bisogni Paimonali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060217,
					"content": "Ahah... voi due siete una coppia interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060207,
					"content": "Puoi evocare una nuova Paimon usando l'alchimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "Ehi! Di Paimon ce n'è una, come lei non c'è nessuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060209,
					"content": "Ahahah! Purtroppo, le mie abilità non sono così avanzate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}