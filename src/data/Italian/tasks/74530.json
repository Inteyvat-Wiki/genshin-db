				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#Ah, sei {F#tornata}{M#tornato}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Sembri di buonumore, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Eheh. Ho trovato un minerale fantastico durante questo scavo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "Se lucidato a dovere, potrebbe trasformarsi in una grande gemma luccicante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Vero? A dirla tutta, lo scavo non è iniziato bene e sono quasi tornata a casa a mani vuote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "Ma ho pensato tra me e me che avrei dovuto resistere ancora un po'. E così ho fatto, e poi ho tenuto duro ancora un po', e ancora un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "Non so quante volte me lo sono ripetuto... ma alla fine ce l'ho fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "Mi sono accorta che il sole stava tramontando solo quando sono uscita... alla fine ho scavato tutto il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "Proprio come ci si aspetterebbe dalla nostra Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "D-Davvero? I-Io... mi imbarazzo un po' davanti alle fotocamere... Non sono sicura che andrà bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "Ma... farò del mio meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "Stai già facendo del tuo meglio, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Ok, allora! Lascio fare a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Sei fantastica così come sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Lascia che ti faccia una foto mentre risplendi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "È successo qualcosa di bello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
