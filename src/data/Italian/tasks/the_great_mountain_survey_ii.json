			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Ciao, come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Ho una lettera per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Una lettera? Oh, è da parte sua. Scommetto che chiede di nuovo della prossima squadra di esplorazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*sospira* Non so che fare. È difficile trovare una squadra disposta ad affrontare la montagna... È troppo pericoloso lassù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "#Le scriverò una risposta a breve per spiegarle la situazione. Grazie di essere venut{F#e}{M#i} fin qui per portarmi la sua lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "A proposito di lettere, poco tempo fa me ne ha inviata un'altra in cui chiedeva di preparare una ricompensa per voi. Ecco, prendete pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "#Un'ultima cosa... So che siete {F#delle tipe toste}{M#dei tipi tosti}, ma fate lo stesso attenzione in montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, il Picco del Drago... Se mai mi capitasse l'occasione di guidare personalmente una squadra di esploratori lì, la coglierei al volo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
