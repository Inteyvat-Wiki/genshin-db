			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "Avete piazzato il sensore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Fantastico! Grazie, ora potrò finalmente avere una misura affidabile dell'altezza della montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Oh, e per quanto riguarda il compenso, ho chiesto a Cyrus di mettere insieme qualcosa. Andate da lui, la prossima volta che siete in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "E, visto che lo vedrete prima di me, potreste anche dargli questa lettera da parte mia? Mi ha promesso di tenermi al corrente su una seconda squadra di esplorazione diretta verso le montagne, ma non ho ancora avuto notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Quando il resto dei miei sensori sarà riparato, dovrò risalire e calibrarli tutti. Ci sono ancora molte cose da rilevare su quella montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
