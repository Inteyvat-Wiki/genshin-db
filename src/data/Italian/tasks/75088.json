			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Ahah! Bene, bene! Presto decifrerò il codice dei motivi dorati sulle Incisioni... E poi... la ricompensa sarà mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "Non che abbia altra scelta... Se dovessi fallire di nuovo, finirò i miei fondi, quindi o la va o la spacca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "Ah, giusto. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Mmmh, se avessi abbastanza campioni, potrei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "Ehi, guarda! C'è un tipo strano che sta farfugliando qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "Ce l'hai con me? A Natlan è pieno di persone che parlano da sole. Se c'è qualcuno di strano qui, quella sei tu... Se non c'è altro, ti prego di non interrompere la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "Le mie spese di questo mese hanno superato le previsioni, quindi devo coprire l'ammanco riscuotendo alcuni dei premi di ricerca dell'Associazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "Uh, Paimon non sapeva che si venisse pagati per fare ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "È così che funziona l'Associazione delle Reliquie Sauriche. I Mora sono l'unico modo per incoraggiare la ricerca su ogni genere di argomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "Stavolta mi occuperò del decifrare le Incisioni iridescenti... Si dice che non ci sia mai riuscito nessuno, e i Mora da guadagnare sono davvero considerevoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "È solo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Mi serviranno abbastanza frammenti delle Incisioni per svolgere questo compito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "Mmmh... Che ne dite di aiutarmi? Se mi porterete i frammenti d'Incisione iridescente, vi pagherò. Vi va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "#Voglio dire, sembrate {F#delle avventuriere esperte}{M#degli avventurieri esperti}. Di sicuro accetterete incarichi di questo tipo continuamente, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "Beh, certo, potremmo aiutarti. Ma non hai già finito le spese mensili...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Beh, avendo già superato il budget, se spenderò di più o di meno non farà differenza... Ma se riuscirò a trovare quei frammenti e a decifrare le Incisioni, il problema sarà risolto, ve lo garantisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "Ci occuperemo solo di trovare quei frammenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Non preoccuparti. Tutto quello che devi fare è assicurarti che sia \"merce autentica\". Il che mi ricorda di un venditore truffaldino che mi ha rifilato degli articoli contraffatti dopo avermi garantito che provenivano dalle \"Rovine della Fonte segreta\"... Argh, mi fa ribollire il sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "Ci ho rimesso parecchi Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "Ah, ecco come sperperi il tuo budget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "Ed è proprio per questo che devo recuperare i Mora con le Incisioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "Quindi, per favore! Conto su di te per trovare quei frammenti! Trovali e portameli, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "Non me ne servono neanche tanti. Solo... tre? No, quattro! Voglio dire, non posso permettermene di più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "Non posso garantire che ti torneranno utili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
			"completionStepIds": [],
