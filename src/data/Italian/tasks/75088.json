				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Ah, sei tu! Grazie per avermi portato quei frammenti delle Incisioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Tuttavia, i progressi che sto facendo nel decifrarle sono... preoccupanti. Le somiglianze con le Incisioni di Flogisto sono solo apparenti, la complessità è maggiore di quanto immaginassi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Ma ora non c'è modo di tornare indietro, quindi... devo farcela comunque, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
