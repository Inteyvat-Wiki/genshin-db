			"dialogs": [
				{
					"id": 715360101,
					"content": "#Buon Festival delle lanterne, {NICKNAME}. Ho saputo che hai aiutato Dehya con il biglietto. Era bellissimo, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Immagino che al villaggio sia tornato tutto alla normalità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Sì, è tutto grazie a Dehya e agli altri. Mi rincuora sapere che il villaggio sia in buone mani mentre sono via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Approfittane per riposarti un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Sarà così. Dehya vorrebbe visitare il Villaggio di Qiaoying tra qualche giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Ha detto che il paesaggio è bellissimo, e che il villaggio è famoso per il tè. È un regalo perfetto per la gente rimasta a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Pensavo di seguire la tradizione e di realizzare dei biglietti d'auguri per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Ma Dehya ha riempito fino all'orlo la nostra agenda e non so se avrò tempo, visto che dovremo andare dappertutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "#Dehya mi ha detto che sei {F#brava}{M#bravo} a creare i biglietti d'auguri. Puoi insegnarmi a realizzarne uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Certo, lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
