			"dialogs": [
				{
					"id": 715360301,
					"content": "#Quindi è così che funziona... Questo biglietto è davvero meraviglioso. Grazie, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360302,
					"content": "Allora, mi basterà prepararne un po' di più da regalare assieme ai souvenir che ho comprato. Sicuramente la gente a casa ne andrà matta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360303,
					"content": "Ma questo... me lo tengo per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
