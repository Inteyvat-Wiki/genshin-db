			"dialogs": [
				{
					"id": 747090101,
					"content": "#Grazie per il vostro impegno, {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Le condizioni dei nostri pazienti mi sono chiare, ora, quindi ho preparato per loro una medicina Melusina apposita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Aggiungendo queste erbe speciali all'acqua della vasca, dovremmo riuscire a calmarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Quindi in pratica stai trasformando l'intera vasca in una gigantesca stazione termale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "È un piano che potevi concepire solo tu, Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Ma così facendo, i loro sintomi si allevieranno solo temporaneamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Hai ragione. Dovrò eseguire degli esami fisici su un'ampia varietà di pesci diversi per poter determinare con esattezza il problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Preparerò un elenco di pazienti da esaminare in base alle caratteristiche di cui ho bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "Vi sarei grata se poteste tenere d'occhio i pesci che corrispondono ai criteri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "Per curarli del tutto, dobbiamo scoprire la causa scatenante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
