			"dialogs": [
				{
					"id": 205160201,
					"content": "Si vede davvero tutta Mondstadt da quassù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160202,
					"content": "Vedi di non prenderti un raffreddore, ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "#Aaah! Che spavento, ma da dove sei spuntat{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Scommetto che mio fratello mi sta ancora cercando. Ahahah, sapevo che non mi avrebbe mai trovata, qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Lo so, lo so. Ho capito, torno subito da lui. Non voglio farlo preoccupare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051603,
			"completionStepIds": [
				2051603
