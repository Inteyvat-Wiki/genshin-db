				{
					"id": 205160502,
					"content": "Vedi di non prenderti un raffreddore, ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160503
					]
				},
				{
					"id": 205160503,
					"content": "#Ah! Che paura mi hai fatto prendere! Da dove sei spuntat{F#a}{M#o}, e come hai fatto a trovarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160504,
					"content": "Ero sicurissima che qui nessuno mi avrebbe trovata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Ah, giusto... Dev'essere stata sorella Grace a dirti dov'ero. Passa sempre da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Molte delle medicine che ho preso in passato me le aveva inviate lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Sorella Grace è una persona stupenda... ma io non voglio restare per sempre a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "E va bene, so che mio fratello mi sta cercando. Tornerò presto a casa in modo che non si preoccupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
