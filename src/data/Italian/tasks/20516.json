			"dialogs": [
				{
					"id": 205160301,
					"content": "Hai già trovato Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160302,
					"content": "È sulle mani della statua dell'Archon di Anemo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "Le... Le mani della statua dell'Archon di Anemo? Come accidenti ha fatto ad arrivare lassù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160304,
					"content": "Andrò subito là, la farò scendere e le darò una bella lavata di testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160305,
					"content": "Ti ringrazio. Prendi, per sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051604,
			"completionStepIds": [
				2051604
