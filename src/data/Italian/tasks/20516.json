					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160401,
					"content": "Non è sempre stata malata, quella ragazza? Ma allora come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Hai visto una certa ragazza...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Ah... Ti riferisci sicuramente ad Anna. Guarda lassù: è sulle mani della statua dell'Archon di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "A essere sincera, sono rimasta senza parole quando mi è passata accanto correndo. Voglio dire, è stata malata per così a lungo, da dove trae tanta energia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Quando sono riuscita a riprendermi, era già salita fino alle mani della statua dell'Archon di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Non sei... arrabbiata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Arrabbiata? Beh, un po'... ma quella ragazza è sempre stata tormentata dalla sua malattia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "E a vederla tanto in forze... Come posso dire? Non posso arrabbiarmi con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Detto questo, il vento lassù è molto forte, spero che non si buschi un raffreddore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
