				]
			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "Fai attenzione nei luoghi dove si muove il nostro nemico oscuro. Fai attenzione al nemico che contamina tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320502,
					"content": "#{F#Eroina venuta}{M#Eroe venuto} da lontano, c'è qualcosa che vorresti sapere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320503,
					"content": "A proposito degli eroi ritratti nell'affresco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "A est, dentro una caverna dove ondeggiano alberi luminosi. Lì, proprio come dicono i narratori con in mano i loro rotoli di tessuto, giace anche un terrore nascosto nelle storie del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320505,
					"content": "Forse quell'ombra cerca di fuggire dalla sua prigionia attraverso quelle stesse storie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320506,
					"content": "A proposito di cosa giace sul mare di mistero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "A ovest, c'è un'isola avvolta dalla nebbia. In passato era un santuario sacro, abitato da coloro che avevano stretto un patto con gli Iktomisauri molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320508,
					"content": "Ma dal suo interno emerse una contaminazione tremenda che trasformò il luogo sacro in una fossa nera, sigillata e dimenticata... Ah, ma il nostro astuto nemico non si sarebbe mai arreso così facilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320509,
					"content": "A proposito della nebbia incolore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "La nebbia contaminata è natata quando l'antica città di Ochkanatlan è stata distrutta. Avrebbe dovuto essere sigillata... Ma il tempo e la memoria sono nostri nemici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320511,
					"content": "Se solo... Ahimè... Se solo qualcuno potesse disperdere la nebbia incolore ancora una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320512,
					"content": "Non mi serve nulla al momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ah... Ricorda, ricorda... Fai molta attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				}
			]
		},
