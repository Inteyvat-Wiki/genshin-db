			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "#Lo percepisco, {F#eroina}{M#eroe} di una terra lontana... Riesco a percepire tutto ciò che hai fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320602,
					"content": "#Un'impresa notevole, {F#eroina}{M#eroe}. Il potere contaminato è tornato al Regno della Notte e riesco a sentire gioire le Anima della Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320603,
					"content": "#...Prendi questi come ricompensa, {F#eroina}{M#eroe}, poiché coloro che compiono grandi imprese devono essere ricompensati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				}
			]
		}
	]
