			"dialogs": [
				{
					"id": 751320101,
					"content": "#...Ah... {F#Eroina}{M#Eroe} di una terra lontana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320102,
					"content": "Per favore, ascolta le mie parole. Io sono il corvo notturno che guida, il ricordo delle poetiche riflessioni della nostra Signora della Notte... e una nozione tra le miliardi illuminate dalla luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320103,
					"content": "Porgimi l'orecchio, poiché il fiume spirituale sottoterra è stato infranto e posso parlarti solo tramite immagine, per esortarti: fai attenzione al nemico oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320104,
					"content": "Un tempo quello specchio rotto irradiava raggi luminosi. Ora, invece, il fumo scuro si è gradualmente diffuso in tre aree. Ricorda queste parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320105,
					"content": "Prima, a est. Le ombre sono emerse da dove un tempo si nascondevano, negli affreschi di eroi leggendari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320106,
					"content": "Poi, a ovest, dove, su un mare di mistero, l'oscurità si manifesta, un'irritante parodia della Signora della Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320107,
					"content": "Il terzo si trova sotto i dirupi, dove una nebbia incolore che avrebbe dovuto dissiparsi ora si diffonde mentre la Città di cenere si agita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				},
				{
					"id": 751320108,
					"content": "#{F#Eroina}{M#Eroe} di terre lontane, ti prego di fare attenzione... Fai attenzione nei luoghi dove si muove il nostro nemico oscuro. Fai attenzione al nemico che contamina tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Volontà dei graffiti misteriosi"
				}
			]
		},
		{
