			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "#Ehi, {F#amica}{M#amico}! Ho qui qualche bell'oggettino di qualità a prezzi stracciati! Ti interessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Eh? Ma queste non sono bambole a forma di Koholasauro? Paimon le ha già viste al Mercato Dolcebrezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Esatto! Ma le mie sono più economiche, praticamente la metà del prezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Come fanno a costare così poco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Eheh, non farti troppe domande. Ho i miei metodi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Saranno anche più economiche, ma i colori sembrano un po' strani... Non saranno mica delle imitazioni, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Imitazioni?! Tsk, ma che vuoi saperne, mocciosa? Sparisci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Via, sciò! A voi non venderò più niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
