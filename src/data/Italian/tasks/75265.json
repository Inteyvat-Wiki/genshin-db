						752650607
					]
				},
				{
					"id": 752650607,
					"content": "Paimon lo sapeva! È un truffatore bello e buono! E hai visto come ha provato a imbrogliarci... Non gliela faremo passare liscia!",
					"roleType": "TALK_ROLE_NPC",
