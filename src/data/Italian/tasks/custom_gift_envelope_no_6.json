			"dialogs": [
				{
					"id": 715380301,
					"content": "Wow, che super risultato! Mmmh... Ti meriti qualcosa in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Ecco, prendi un po' di questi dim sum in segno di ringraziamento. Ricevere questo biglietto ha dato valore a tutto il viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "...Eppure, è da un po' che non torno. Mi chiedo se i miei agenti continuino ad allenarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Beh, immagino che sia ora di iniziare a pensare a un test di idoneità fisica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
