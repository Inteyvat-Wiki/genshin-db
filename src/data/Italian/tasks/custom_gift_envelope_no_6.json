			"dialogs": [
				{
					"id": 715380101,
					"content": "#Ciao, {NICKNAME}. Buon Festival delle lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Sei qui per un caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Mi hanno obbligato a fare una vacanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Ti hanno... obbligato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "La Maison de la Garde stabilisce che tutti i dipendenti debbano usare il proprio periodo di ferie prima della fine dell'anno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Quando sono arrivati i calcoli di fine anno, hanno scoperto che non avevo preso neanche un giorno di ferie, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Sembra un lavoro impegnativo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "No. I nostri agenti seguono dei turni ma, in quanto Capitana, sono sempre in servizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "E gestisco molti casi urgenti, quindi col tempo... Mi dimentico di prendere le ferie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Non era un problema per me non andare in vacanza quest'anno, ma gli altri agenti non hanno sentito ragioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Hanno iniziato a urlare che \"le regole devono essere rispettate\" e che \"un capitano deve dare l'esempio\". In pratica non volevano ricevere un no come risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Uno dei funzionari giudiziari che lavora con noi ha menzionato che Liyue è una destinazione fantastica per le vacanze durante il Festival delle lanterne. Ha tirato fuori un biglietto per la nave e... Eccomi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Glielo concedo, Liyue è davvero magnifica in questo periodo dell'anno. Sono appena tornata dal Villaggio di Qiaoying, in realtà. Mi sono piaciuti molto i dim sum fatti col tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Ne ho comprati un po' da condividere con la Pattuglia speciale. Volevo seguire le usanze locali e preparare dei biglietti d'auguri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Solo che... Non sono molto brava in questo genere di cose. Non importa cosa faccia, finisce sempre per avere un aspetto strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#Sai come si preparano, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Ho qualche suggerimento in merito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "È così per tutti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Non hai l'aria di essere qui per lavoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
