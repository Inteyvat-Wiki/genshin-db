					},
					{
						"sceneId": 3,
						"position": [
							1547.072,
							258.854,
							9322.94
						],
						"pointId": 13087
					},
					{
						"sceneId": 3,
						"position": [
							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Quest'uomo era come un faro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Viveva qui come se fosse un'ovvietà, e portava luce e grazia a coloro che lo circondavano. Ma le persone, una volta abituate a quella luce, tendono a ignorare la presenza della lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Pian piano, iniziò anch'egli a pensare:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "\"Ho fatto troppo poco, devo fare di meglio, c'è ancora del lavoro da fare...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Forse la sua fu una fine tragica, ma sono fiero di come egli abbia illuminato il cammino degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Ogni ombra generata dalla luce lo ricorderà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Poverino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Una volta ho sentito la storia di una Fata della lanterna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Eh, l'ho sentita anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "E vorrei dire a lui la stessa cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Beh, hai ragione. Potrebbe sembrare che i nostri sforzi siano stati inutili, e che Rerir abbia raggiunto il suo scopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Ma lo perseguiremo fino alla fine, anche se il risultato non sarà quello desiderato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Non è molto diverso dal ruolo del custode di cimitero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Non cerchiamo di riportare in vita i defunti, ma di concedergli pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Mi fa piacere che tu la veda così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "C-Cosa state dicendo? Potreste spiegare anche a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Non ora, Paimon. Ti spiegherò tutto al nostro ritorno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "In ogni caso, la Fata della lanterna non interpreta il ruolo principale in questi ultimi rituali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "\"Tu che porti la luce, hai aperto la strada per la gloria e la giustizia con il tuo sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "Anche se procedessimo spediti e finissimo per subire molti danni, fermati per un momento a contemplare l'amore e l'odio di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "Finché non chiuderà i suoi occhi nelle profondità della notte, e una lanterna non s'accenderà solo per te, invisibile agli altri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Grazie di tutto, sergente maggiore Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Il risultato non è importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
