			"dialogs": [
				{
					"id": 60111001,
					"content": "Riparare una lanterna? Ma per favore! Non ci vorranno più di dieci minuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111002,
					"content": "Se solo tutti avessero saputo quello che stavano facendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111003,
					"content": "Prendi Hintsa, per esempio. Come ha fatto a realizzare un interruttore integrato per il cannone e la barriera con dei componenti a caso che gli hanno chiesto di riparare?! Uff, mi viene il mal di testa solo a pensarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111004,
					"content": "Gli ho fatto una bella ramanzina, e gli ho detto che dovrà mandarmi dei rapporti regolarmente... Se sta lavorando a qualcosa, voglio saperlo! *sospira* S-Sì, lo so, anch'io ho sbagliato, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
