						"pointId": 13093
					}
				]
			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "Colombina! Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "#Mm? Non siete {F#state}{M#stati} voi a consigliarmi di fare delle passeggiate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110603,
					"content": "Sì, ma non hai paura che i Fatui possano vederti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone non sembra interessata alla mia cattura, e gli altri non mi sembrano molto propensi a rischiare di entrare in contatto con me. Hanno altri affari più urgenti di cui occuparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110605,
					"content": "(Rerir, se dovessi tirare a indovinare... è una minaccia per tutti gli abitanti di Nod-Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Beh, in ogni caso, fare una passeggiata è piacevole. Allora, come ti senti? Ti piace Nasha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Mmm... Il flusso del Kuuvahki è turbolento, e la gente è inquieta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110608,
					"content": "Anche se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110609,
					"content": "Anche se?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "È qui che avete comprato i piatti con cui mi avete fatto una \"sorpresa\" l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110611,
					"content": "(Dice sul serio? È questo che la preoccupa? La carne rosolata con bacche?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Uhm, beh, possiamo portarti fuori a mangiare qualcosa, se vuoi. Qui ci sono prelibatezze di tutti i tipi che a casa non puoi neanche sognarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "#...Sei {F#silenziosa}{M#silenzioso}, ultimamente. C'è qualcosa che ti turba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110614,
					"content": "Mi preoccupa Rerir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Temo di non aver colto il senso del suo piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110616,
					"content": "Ora che ha assunto una forma fisica, sottovalutare il suo potere sarebbe un errore fatale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110617,
					"content": "Ma in quel potere alberga un'ossessione che rasenta il delirio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110618,
					"content": "Non so dire se sia legata alle lune o a qualcos'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110619,
					"content": "Forse comprenderne l'oggetto sarà fondamentale per respingerlo in futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110620,
					"content": "Parlami dei Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Sandrone ha una routine molto imprevedibile, mentre il Luminare dà sempre ordini a tutti. Quanto ad Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110622,
					"content": "Eh? Non era questo che volevi sapere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110623,
					"content": "Hai visitato il loro Istituto di Progettazione sperimentale? Quell'arma sarà fondamentale per il piano della Tsaritsa. Almeno, questo è ciò che ho sentito dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110624,
					"content": "Qual è il piano, precisamente? Beh, non che m'interessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110625,
					"content": "Stavo pensando alla nostra astronave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Potrei esaminare il Midollo della Luna eterna per te, se lo desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110627,
					"content": "Ma, dopo il nostro ultimo tentativo, sospetto che la vostra astronave sia stata nascosta intenzionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110628,
					"content": "Forse qualcuno vuole nascondere a te o ad altri delle verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110629,
					"content": "E dubito che in molti ci riuscirebbero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110630,
					"content": "Non ho altre domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "Io... voglio ancora tornare alla luna che mi appartiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60110632,
					"content": "È lì che sono sepolte le risposte. Quella... è la mia vera \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
