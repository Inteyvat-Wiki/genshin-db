			"dialogs": [
				{
					"id": 60110501,
					"content": "Capo, ricorda... quella cosa... su cui volevo chiederle un parere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Su una scala da uno a dieci, quanto dovrebbe impegnarsi il Consiglio dei segreti per lavorare nuovamente con altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110504,
					"content": "È un uno? Non è un po' basso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Prova a indovinare di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Un momento, intende zero? Ma non dovremmo semplicemente apporre il nostro marchio sull'accordo? Che senso avrebbe collaborare, a quel punto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*sospira*... Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Ciò che intendo dire è che non c'è nessun limite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Ah! È proprio da lei, capo, pensa sempre in anticipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Un attimo, ma è una risposta senza senso! Forza, capo, dica un numero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
