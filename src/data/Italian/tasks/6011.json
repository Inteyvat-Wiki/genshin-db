			"dialogs": [
				{
					"id": 60111101,
					"content": "#Ah, che piacere vederti, {NICKNAME}. Ho pensato che fosse appropriato un periodo di manutenzione dopo quella grande battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111102,
					"content": "Grazie per aver mantenuto i miei segreti, nonostante le mie rivelazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111103,
					"content": "Non ho avuto il tempo di chiedertelo prima, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Beh, non volevo mettermi nei guai con lo Starsina. Se non fossero riusciti a rilevarla, i miei superiori mi avrebbero rifilato una lanterna di ordinanza dei Ratniki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Un Ratnik con due lanterne, ma pensa te! Una trasgressione antiestetica della peggior specie, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Perché i Guardaluce potevano rilevare la tua lanterna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
