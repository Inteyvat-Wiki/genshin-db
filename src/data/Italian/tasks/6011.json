			"dialogs": [
				{
					"id": 60110701,
					"content": "...Interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "\"Vindice di Solnari\""
				},
				{
					"id": 60110702,
					"content": "Hai fatto un bel po' di strada per seguirmi, perché non ti mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
					"speakerTitle": "\"Vindice di Solnari\""
				},
				{
					"id": 60110703,
					"content": "Ahah, giusto, giusto! Hai ragione. Ho dimenticato di presentarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
