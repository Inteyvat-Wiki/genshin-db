				]
			},
			"dialogs": [
				{
					"id": 60110901,
					"content": "Mmmh? Cosa vi porta qui? Non mi aspettavo di rivedervi così presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110902,
					"content": "E tu dov'eri, eh? Non avrai mica deciso di scappare, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110903,
					"content": "Oh, certo che no! Ero solo da un'altra parte, a discutere di affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110904,
					"content": "Il mio piccolo negozio è stato risparmiato solo grazie a voi. *singhiozza* Vi sono grata. Davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110905,
					"content": "Basta, d'accordo, ora piantala con questa messinscena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "Cosa? Non era una messinscena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110907,
					"content": "Non vi avevo detto che i miei prezzi sono ragionevoli? Ah, ma avete comunque preferito chiedere aiuto a quel Consiglio dei segreti o come cavolo si chiama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110908,
					"content": "*sospira* Se anche i clienti abituali come voi mi abbandonano, cosa può fare una donna d'affari se non portare i suoi prodotti altrove...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110909,
					"content": "Sei troppo diffidente riguardo al Consiglio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "Come non potrei esserlo, mm? Gestire delle piccole attività all'estero non è cosa da poco, tanto più se c'è una forte concorrenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110911,
					"content": "Ah, lasciamo perdere. Fortuna e destino sono un tutt'uno, perciò lamentarsi è inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "In quanto compatriote, Nefer non mi ha mai negato dei favori quando sono arrivata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "Se c'è qualcosa di cui mi pento, è che non sono riuscita a far sì che anche lei avesse un debito con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Quindi! Se avesse bisogno di qualcosa, assicuratevi d'informarmi, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
