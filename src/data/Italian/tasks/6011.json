			"dialogs": [
				{
					"id": 60110401,
					"content": "Creazione krumkake completata. Prego, se li goda finché sono caldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Grazie per averlo ricordato, Ineffa. Che questo sapore sia testimone della nostra amicizia, e che possa perdurare nel tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Ricevuto. Tuttavia, temo che i krumcake non durino così a lungo. Il sapore inizia a deteriorare già dopo una settimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Eheh, non è esattamente ciò che intendevo... Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Eh? Sembra che abbiamo ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Ah, devono aver seguito l'aroma dei krumkake... Tranquilli, avvicinatevi pure. Ineffa è un'amica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Affermativo. Infatti posso preparare un'omelette di cereali in base alle preferenze individuali, per poi suddividerla in porzioni da condividere con tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "Che cosa stanno dicendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Stanno... parlando di dove abiti. Vogliono venire a casa con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
