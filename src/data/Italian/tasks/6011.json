			"dialogs": [
				{
					"id": 60110101,
					"content": "Tutti si riuniscono, raccontando cosa gli è successo e condividendo ciò che sanno...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Fortunatamente siamo riusciti a contenere i danni. Solo alcuni abitanti sono rimasti feriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Ma adesso il Vindice di Solnari ha assunto una forma completa, e noi non sappiamo ancora niente delle sue intenzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "È come se avessimo liberato in natura un Qucusauro feroce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "...Chiedo scusa. Nessuno qui sa cos'è un Qucusauro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "Paimon ha capito cosa vuoi dire, ma questa analogia è un tantino blanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Ha detto che questo mondo non ha alcuna importanza per lui, quindi è possibile che al momento non abbia alcun motivo per combatterci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Se il suo obiettivo fosse stato solo vendicarsi, probabilmente non avremmo avuto nessuna possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Sono ancora in tempo per dare le dimissioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Scherzavo, scherzavo! Non si preoccupi, capo, so che ormai non si torna più indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Il mio cannone, la mia gioia e la mia fonte d'orgoglio... è stato un ostacolo piuttosto che un aiuto... Bah! Sapete che vi dico? Lo smonto. Adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Non è stata colpa tua, Aino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Esatto, e funziona ancora contro le anomalie normali della Caccia selvaggia. Non scoraggiarti, Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, dovrai occuparti della situazione con i Guardaluce. Non preoccuparti, gli ho già spiegato tutto. Sanno che sei innocente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "E grazie anche per tutto ciò che ha fatto per aiutarci a scoprire la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Se ti fossi fatto vedere in pubblico più spesso, non saresti stato così facile da isolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Eheh, ottima osservazione. Sarà un ottimo spunto di riflessione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Mmmh. Immagino che questo sarà uno dei vantaggi di prendere il posto del sergente maggiore Sousi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Vuoi dire che verrai promosso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Sta scherzando, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Paimon è l'unica a non aver capito niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#Beh, {NICKNAME}, se hai un attimo, ti andrebbe di venire con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "C'è un certo gentiluomo che vorrei accompagnare alla sua destinazione finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "...né del cannone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
		{
			"id": 601102,
