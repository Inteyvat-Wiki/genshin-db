						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins? Non ti vedo spesso da queste parti. Dai pure un'occhiata in giro, ora sono impegnata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Beh, sono solo venuto a farle visita, signorina Aino. Ecco, ho portato degli spuntini dal sapore tradizionale di burro. Dove li lascio...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Shhh! Ineffa potrebbe sentirti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "...Allora, qual è l'occasione? Mi vuoi dire che... i Ratniki si occuperanno di tutte le manifestazioni della Caccia selvaggia dopo l'incidente con il cannone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "E criticare un genio come lei per risultati che nessuno di noi poteva prevedere? Non saremmo tanto scortesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Se lo facessimo veramente, non vedremmo mai più alcun progresso tecnologico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Umpf, che adulatore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Sono lieto di sapere che si sente rassicurata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Comunque sia... Cosa c'è, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Potrebbe aiutarmi a riparare questa lanterna? L'avevo portata con me a Nasha per farla riparare, ma si è di nuovo rotta nell'ultima battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Vuoi che un genio come me si metta a riparare lanterne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Oh, chiedo scusa. Forse avrei dovuto rivolgere questa richiesta alla signorina Ineffa, con spuntini annessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "C-Co-Cos...? Io... insomma, posso farlo tranquillamente, nessun problema. Aspetta lì. Finirò in un baleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Ben gentile, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "E se dovesse succederti di nuovo, vieni prima da me, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
