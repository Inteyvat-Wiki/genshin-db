	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Ciao! Accomodati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Allora, che mi dici della tua precedente avventura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Ah, stai cercando di chiedermi perché sono stata così testarda o perché ho fatto preoccupare tutti? Ahah, dai, so di avere sbagliato... Puoi anche non premere troppo su quel tasto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "#A essere onesta, ho il sospetto che rimanere affascinat{F#e}{M#i} dal pericolo sia parte della natura di noi avventurier{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "#D'altronde, siamo entramb{F#e}{M#i} nat{F#e}{M#i} con degli arti belli agili e una schiena robusta. Avere doti del genere e limitarsi a una vita tranquilla sarebbe uno spreco, non trovi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Quanto al rischio di rimetterci le penne, non è che non ci ho mai pensato, ma... Posso farti una domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Stanley, il noto avventuriere di Mondstadt, è diventato famoso dopo essere riuscito ad attraversare il Mare Jivari, perdendo però nell'impresa un caro amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Sono in pochi a sapere come si chiamasse, eppure il fatto che ha partecipato a tale avventura lo ha consacrato nella memoria degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Quindi stavo pensando... Per piacere, non ridere se mi trovi un po' immatura, ma... credi che quell'amico di Stanley, che non ha fatto ritorno, alla fine non sia scomparso, ma continui a vivere nella nostra memoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "L'unica cosa che conta è la vita stessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Però, in caso di scomparsa prematura... il ricordo non potrebbe essere visto come una sorta di estensione della propria vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "In questo modo, una persona rimarrebbe viva agli occhi degli altri in maniera diversa, poiché ammirata e ricordata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Non preoccuparti troppo di ciò che pensa la gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "È quello che mi hanno detto tante persone. \"Sii te stessa\", \"Dedicati al tuo lavoro\"... All'apparenza sono dei buoni consigli, ma in realtà mi dicono di arrendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Penso di averlo già detto, ma non vado all'avventura per conto di nessuno... e nemmeno per il mio ego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Mmmh, ci avevi mai pensato prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Questo mondo è governato dagli dèi e, sebbene costoro non vedano di buon occhio noi comuni mortali, non abbiamo alcuna intenzione di andarcene in silenzio per essere poi dimenticati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Credo che la mia insoddisfazione abbia un senso ed è per questo che mi avventuro in aree pericolose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "D'altronde, affrontare cose di cui anche gli dèi avrebbero paura se fossero nelle nostre spoglie mortali... non è ciò che ci rende essere umani? Io la penso così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Tuttavia, non sei l'unica persona che ha il diritto di dare un senso a un'avventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Lo so... Non ho dimenticato l'aiuto che ho ricevuto e... non dimenticherò nemmeno i guai che ti ho fatto passare. Quest'avventura, dopotutto, non l'ho intrapresa da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Però, alla fine, non è ciò che fa ogni avventuriere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Di nuovo alla ricerca di imprese eroiche, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Eh, ho ancora molta strada da fare rispetto a te... Non vedo in me nulla di eroico, ma mi reputo piuttosto una persona che non teme di morire pur di vivere appieno la propria vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Quest'ultima frase me la disse un'insegnante di Sumeru, che l'aveva sentita a sua volta dagli Eremiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Trovo che abbia senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Beh, Paimon pensa che tu sia più una persona che continua a mettersi nei guai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Immagino che anche essere ricordati sia una forma di successo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Beh... Non ho mai pensato di avere successo nella vita. Piuttosto, vorrei riuscire a lasciare il segno anche se mi capita di fallire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Perlomeno chiunque, poi, potrà dire: \"Una volta Zhiqiong ha anche provato ad affrontare le insidie della Voragine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Almeno non sarei dimenticata come coloro che si sono sacrificati in luoghi deserti o... beh, come me adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Non avevo mai considerato questo aspetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Davvero? Immagino che sia così perché, visto che non sei di queste parti, è normale che la gente cominci subito a parlare di te ovunque tu vada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "Suppongo che sia lo stesso per i bambini provenienti da famiglie ricche, che potrebbero vedere nella vita da poveri una sorta di avventura intrigante, ma non necessaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Oh... ehm... Perdonami, non era quello che volevo dire. Intendevo... Lascia perdere, fai finta che non abbia detto niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Uff, si tratta di nuovo di Zhiqiong... È andata a prendere i segnalatori e da allora non è più tornata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Dato che la conosco e so che ha quella sciocca abitudine di andarsene in giro ovunque, le ho dato tre ore in più, ma ormai saranno passate cinque o sei ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Potreste aiutarmi a cercarla? Quella ragazza ha molto rispetto per voi, quindi dovrebbe essere più facile... In ogni caso, finché sono io la responsabile, non voglio che qualcuno si metta di nuovo nei guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "Bah, andarsene in giro in quel modo, ma cosa le prende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380205,
					"content": "Va bene, ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				},
				{
					"id": 710380207,
					"content": "Ah, sì! Che sciocca, stavo quasi per dimenticare di dirvi la cosa più importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380208,
					"content": "È probabile che non sia andata molto lontano. Allo stesso tempo, però, dove potrebbe essere andata?",
					"roleType": "TALK_ROLE_NPC",
