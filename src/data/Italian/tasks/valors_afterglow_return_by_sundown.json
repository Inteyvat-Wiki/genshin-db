					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380606,
					"content": "Per adesso lasciamo perdere. Ora Zhiqiong ha solo bisogno di riposo. Potreste aiutarmi e portarle questa zuppa finché è ancora calda?",
					"roleType": "TALK_ROLE_NPC",
