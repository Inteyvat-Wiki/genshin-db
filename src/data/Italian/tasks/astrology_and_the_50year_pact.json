					"nextDialogs": [
						105000334
					]
				},
				{
					"id": 105000334,
					"content": "Forza, seguiamola! In nome del buon cibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000335,
