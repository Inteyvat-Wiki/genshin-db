			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "C-Come fai a saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "Come? Perché sono una maestra d'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "Se non avete altre domande, seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Oh, si dà il caso che invece abbia un sacco di domande da porti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "*sospira* E va bene. Cercherò di essere paziente per chiarirvi le idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "Sono l'astrologa Mona Megistus ma, considerato che dimenticare i nomi altrui è maleducazione, permetto agli altri di chiamarmi soltanto Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "La mia maestra mi ha affidato una missione: recuperare una certa scatola da Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Faceva parte di un accordo preso con una sua amica cinquant'anni or sono. Ma ormai non è più arzilla come un tempo, per cui tocca a me occuparmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Ehm... Non capisco cosa c'entriamo noi con il recupero di questa scatola. Perché dovremmo seguirti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Beh... Perché vorrei anche affrontare il guardiano della scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "La mia maestra e la sua amica hanno passato la vita a sfidarsi nelle arti mistiche, senza che nessuna delle due ne uscisse vincitrice. Se dovessi farcela, dimostrerei di aver superato la mia maestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "Quindi vuoi dar prova di te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "Ahem, in realtà voglio dar prova del potere e del prestigio dell'arte dell'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Stando alle mie predizioni, l'amica della mia maestra ha lasciato Mondstadt, affidando la guardia della scatola al suo erede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Proprio come me, anche questa persona deve aver superato la sua maestra, per cui non posso lasciare nulla al caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "Quindi preferirei assicurarmi la vittoria in questa sfida e, dopo averci riflettuto un po', ho pensato che tu avresti fatto al caso mio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "Ma... io non ho idea di come funzioni l'astrologia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "#Cosa c'entra {F#lei}{M#lui} con questa storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "La conoscenza che la mia maestra mi ha trasmesso dev'essere a sua volta tramandata a qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "#Se portassi con me u{F#na}{M#n} discepol{F#a}{M#o} a conoscerla, sarei già in vantaggio, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "#E tu sei {F#la grande eroina}{M#il grande eroe} di Mondstadt, mi{F#a}{M#o} pari quanto a prestigio. Per cui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "Mi rifiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "#Non è necessario che diventi davvero {F#mia discepola}{M#mio discepolo}. Devi solo fingere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Se accetterai di accompagnarmi a recuperare quella scatola, ci guadagnerai qualcosa anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Dopo che avrò incontrato l'erede e confrontato le nostre conoscenze, dovrei essere in grado di leggere il tuo futuro con maggior precisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "A quel punto potrò rispondere alle tue domande, anche su questioni fumose come divinità e parentele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "Beh, in effetti sarebbe più rapido che setacciare l'intero continente paese per paese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "D'accordo, accetto le tue condizioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Eheh, saggia decisione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Detto ciò, vorrei far visita a un certo luogo prima di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Beh... Suppongo che ti asseconderemo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "#E da quando sarei {F#diventata una tua allieva}{M#diventato un tuo allievo}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "Come mai hai pensato proprio a me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "Cioè, in altre parole, vuoi metterti in mostra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "Non dire sciocchezze! Il punto è che posso sfruttare quest'occasione per dimostrare il potere e il prestigio dell'arte dell'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "Tanto per cominciare: chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
		{
			"id": 1050002,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050003",
							"2"
						],
						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Signor Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Non mi sorprende che una locanda in questo posto non faccia grandi affari...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, sei arrivata proprio al momento giusto. Per caso hai visto un anello di giada sulla strada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Signor Zhu"
				},
				{
					"id": 105000203,
					"content": "Un anello di giada? Non direi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Oh, no... Quell'anello era un regalo di mia madre. Mentre ero di spalle, un Melmoso l'ha ingoiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Signor Zhu"
				},
				{
					"id": 105000205,
					"content": "Beh, non dovrebbe essere un problema, ora che Mona è qui! È bravissima con l'astrologia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Assolutamente no. L'astrologia va usata per comprendere la realtà e il destino stesso, non per questioni tanto banali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Ma prima non hai detto che il proprietario della locanda è stato buono con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "È una questione di orgoglio e consapevolezza. Se un astrologo pensasse di usare la propria arte per risolvere qualsiasi problema, verrebbe presto abbandonato dall'etere stellare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Le sue divinazioni perderebbero la capacità di guidare, e non sarebbe più in grado di penetrare la nebbia dell'ignoto dinanzi a sé. È una questione di principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Hai un potere così grande... e non lo usi per guadagnarti da vivere? Un vero spreco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*sospira* Beh, avrei offerto 20.000 Mora come ricompensa, se foste stati disposti ad aiutarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Signor Zhu"
				},
				{
					"id": 105000212,
					"content": "2—20.000...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Oh... Ah... Niente! S-Stavo solo pensando che chiunque trovi quell'anello sarà davvero fortunato. Guadagnare 20.000 Mora così... di punto in bianco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Prima non stavi parlando di orgoglio dell'astrologo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Ahem... Ma sì, certo! Tuttavia... l'attività del locandiere ha visto giorni migliori. Dev'essere un anello davvero straordinario, se è disposto a spendere tanto denaro per ritrovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Non sarebbe giusto andarcene senza averlo aiutato. Forse ci sono altri modi per riuscirci, oltre all'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, Paimon sa già come andrà a finire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, lascerò che sia tu a occupartene! Considerala la prima missione che ti affido come tua maestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
