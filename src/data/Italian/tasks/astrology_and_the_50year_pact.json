					"content": "#Non ho mai detto che sarei {F#stata davvero tua discepola}{M#stato davvero tuo discepolo}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000322
					]
				},
				{
					"id": 105000322,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
