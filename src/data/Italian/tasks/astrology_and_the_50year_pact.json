					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000229,
					"content": "Non dirmi che l'hai conservata solo per fare uno spuntino quando ti viene fame...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
