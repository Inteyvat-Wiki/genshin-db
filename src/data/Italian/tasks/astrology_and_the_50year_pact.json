					"content": "Paimon è il partner perfetto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "A quanto pare avete già un piano.",
