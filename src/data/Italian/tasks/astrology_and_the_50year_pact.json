					"id": 105000319,
					"content": "Beh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000320
					]
				},
				{
					"id": 105000320,
					"content": "#{NICKNAME}, non si era detto che avremmo semplicemente finto?",
