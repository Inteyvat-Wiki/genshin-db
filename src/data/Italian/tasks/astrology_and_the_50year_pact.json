					"content": "Oh, ma certo! Suppongo che tu non abbia mangiato per giorni. Avevo dimenticato che non hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000328
					],
					"speakerTitle": "Signor Zhu"
				},
				{
					"id": 105000328,
					"content": "Aaaaaaah! Shhhhahahahaha! Non è successo niente! È tutto a posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000329
					],
					"speakerTitle": "Mona"
				},
