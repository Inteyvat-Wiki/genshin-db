			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Non mi sorprende che una locanda in questo posto non faccia grandi affari...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, sei arrivata proprio al momento giusto. Per caso hai visto un anello di giada sulla strada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Signor Zhu"
				},
				{
					"id": 105000203,
					"content": "Un anello di giada? Non direi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Oh, no... Quell'anello era un regalo di mia madre. Mentre ero di spalle, un Melmoso l'ha ingoiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Signor Zhu"
				},
