			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#Sono Arama e {F#la}{M#il} Nara dorat{F#a}{M#o}. Siete così alti. Ma quella d'argento al tuo fianco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Mmh? Quella d'argento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Come dire... Probabilmente riesci a infilarti nelle cavità più strette degli alberi. Che fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Beh, in base alle usanze dei Nara, prima dovremmo presentarci. Loro sono Nara {NICKNAME} e Paimon. Questo è Arakavi. Stringetevi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "#Ti senti un po' confus{F#a}{M#o}, ma stringi comunque la mano ad Arakavi...\\nCerchi di non usare troppa forza...\\nLa mano di Arakavu... lascia una sensazione speciale.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "#Affascinante. In passato ho sentito parlare molto dei Nara, ma è la prima volta che ne tocco un{F#a}{M#o}. Che sensazione speciale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "#È passato molto tempo dall'ultima volta che abbiamo ospitato un Nara qui. Molti semi sono diventati alberi, e molte storie leggende. Que{F#l}{M#lla} Nara era u{F#n}{M#na} Nara buon{F#o}{M#a}, o almeno così abbiamo sentito dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Anche Nara {NICKNAME} è buon{F#a}{M#o}. Forte e coraggios{F#a}{M#o}, come una piantina che germoglia da un muro di pietra. Ed è qui per aiutare Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Ah, Arana... È passato un po' di tempo dall'ultima volta. Spero che vada tutto bene e che i piccoli Nara del Villaggio di Vimara stiano bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Conosci i bambini del Villaggio di Vimara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Ma certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Tutti noi li conosciamo! Arana è tornata e ci ha raccontato delle storie sui piccoli Nara. Nara Iotham, Nara Bahram e Narana sono nostri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Paimon non è sicura che questo conti come \"conoscere qualcuno\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Cos'è che conta, allora? Dobbiamo \"stringerci la mano\" dopo le \"presentazioni\" come fanno i Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "So cosa intende Paimon. I Nara mangiano e cercano \"tesori\" insieme. È così che si conoscono, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "Non è proprio così semplice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Finché conosciamo le storie gli uni degli altri, ci conosciamo. Questo perché il mondo degli Aranara è luogo di canzoni e di sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi ha ragione. Finché sentiamo parlare di Nara {NICKNAME} dalle canzoni e vediamo com'è fatto Nara {NICKNAME} attraverso i sogni, questo conta come se ti conoscessimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon pensa che potremmo lasciare da parte tutte queste cose, per ora... Dopotutto, siamo già amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Ottimi amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama e Arakavi"
				},
				{
					"id": 730810325,
					"content": "Ottimi amici!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Sì. Arakavi deve fare alcuni preparativi per il Festival di Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Esatto. Ci serve il Bija, giusto? Ho mandato Arayasa, Aradasa e Arasudraka a cercare gli Antri di Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Perfetto! Ma Paimon si chiede... Perché non sapete dove si trovano questi Antri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Gli Antri di Ashvattha sono luoghi molto, molto sacri. Di solito noi non ci andiamo. Preferiamo lasciare che l'albero di Vasara dorma e sogni, finché tutti i ricordi non si riuniscono nel Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "La foresta non dimenticherà. Nessuna cosa buona svanirà, e tutte le sofferenze in futuro diventeranno il nutrimento per qualcosa di bello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "A ogni modo, potrete trovare Arayasa, Aradasa e Arasudraka alla ricerca degli Antri di Ashvattha. Arama, vai in loro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Lo farò. Nara {NICKNAME} e Paimon, se ci incontriamo nella foresta, viviamo qualche avventura insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Molto bene. Piacere di avervi conosciut{F#e}{M#i}, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "E ora, parliamo di affari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Come potrei spiegarvelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Io e Paimon mangiamo e cerchiamo tesori insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "#Sì! E non siamo solo \"persone che si conoscono\", ma ottim{F#e}{M#i} compagn{F#e}{M#i} di viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Buon per voi, Nara {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
		{
