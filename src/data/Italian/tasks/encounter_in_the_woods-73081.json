			"dialogs": [
				{
					"id": 730810401,
					"content": "È stato un piacere! Quando arriverà il Festival di Utsava, canteremo insieme in allegria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
