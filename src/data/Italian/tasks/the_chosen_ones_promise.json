			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380102,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#Che sollievo! {NICKNAME}... Beh, è complicato da spiegare, ma in pratica, {F#lei}{M#lui} ti ha visto in sogno con una strana persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380104,
					"content": "Hai incontrato qualcuno di strano sulla Tonatiuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380105,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "Eh? Allora? Sì o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380107,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "Uff, Paimon non ha idea di cosa tu stia cercando di dire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380109,
					"content": "Beh, tu stai bene, e questo è tutto ciò che conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "Sì, hai ragione. E Bona? Dov'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380111,
					"content": "Rooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "Vi siete separati? Oppure Bona è davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380113,
					"content": "Forse Bona è un personaggio inventato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "Mm... Hai ragione. Una persona normale non può vivere per centinaia di anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380115,
					"content": "Ma almeno abbiamo portato a termine la sua avventura incompleta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "Sì, e le abbiamo anche promesso che l'avremmo raccontata a tutti. Quando si saprà che abbiamo trovato la Tonatiuh, anche Bona diventerà un'avventuriera famosa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380117,
					"content": "Ok, è il momento di...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "Ok, è ora di andare sul vulcano a trovare \"quella persona\", e...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "Arrivare in fondo alla questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380120,
					"content": "Detto questo, potrebbe trattarsi del Saggio della Fiamma rubata? Tutti i messaggi che abbiamo trovato lungo la strada erano stati lasciati da lui. Paimon è sempre più curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380121,
					"content": "Ha anche detto che è in grado di assumere diverse identità... Anche se lo avessimo incontrato, potremmo non averlo riconosciuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380122,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#Questo incuriosisce anche te, vero, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380124,
					"content": "#Ora che abbiamo raccolto tutti gli amuleti, andiamo al vulcano con {REALNAME[ID(2)|SHOWHOST(true)]} per scoprire la verità e spezzare la sua maledizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380125,
					"content": "Scusa, Bona! Porteremo con noi la Prece dorata, per ora. Ti racconteremo tutto non appena avremo capito che succede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
