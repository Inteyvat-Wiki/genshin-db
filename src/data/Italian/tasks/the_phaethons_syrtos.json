	"talks": [
		{
			"id": 7224401,
			"completionStepIds": [
				7224401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224401",
							"2"
						],
						"stepId": 7224401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Mmm? Che cosa bizzarra... È da molti anni che non vedevo una persona con indosso abiti del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "A giudicare dai tuoi modi di fare, non sei di Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "#Sei {F#una visitatrice}{M#un visitatore} da terre lontane che si trova qui per caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Più o meno sì, è così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "E pensare che c'è un modo per entrare a Byakuyakoku dal mondo esterno... Questa sì che è una notizia sconvolgente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Io sono nata qui, e non ho mai visto nessuno del mondo esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Tempo fa, una persona mi disse che voleva dare una sbirciatina al mondo fuori di qui. Pensavo stesse scherzando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "#Viaggiat{F#rice}{M#ore}, a dire il vero, ho un'umile richiesta da farti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "Ci sono sette tombe regali sparse per Byakuyakoku, in cui sono stati sepolti i resti dei nostri \"Figli{RUBY#[S]Phaethons} del sole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "I Figli del sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Esatto. Noi veneriamo il Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Dopo un certo numero di anni, un bambino viene scelto come Figlio del sole, e prende il controllo della nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Abbiamo avuto... sette Figli del sole, in tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "#Viaggiat{F#rice}{M#ore} sconosciut{F#a}{M#o} di terre lontane, ti supplico, rendi omaggio alle loro tombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Ehm, perché dovremmo farlo noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Non spetta alla famiglia e agli amici rendere loro omaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "Sì, di solito spetta a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Ma temo che nessuno di Byakuyakoku sia disposto a farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "In effetti, credo che queste tombe non vengano visitate da molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "I Figli del sole sono disprezzati dagli abitanti di questa nazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "Dire che li disprezzano è poco. Sarebbe più corretto dire che li detestano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Come ho già detto, i Figli del sole sono nati per svolgere un ruolo ben preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Ma una nazione non può essere governata da dei bambini, per cui avevano delle persone alle loro spalle che detenevano realmente il potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "I Figli del sole erano solo dei burattini, le cui decisioni erano manipolate da queste persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "E, nonostante ciò, l'avidità di queste persone non aveva fine. Il popolo sgobbava, mentre loro si arricchivano e costringevano i Figli del sole a compiere azioni atroci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "E così, l'ira del popolo cresceva, e la colpa di quelle azioni ricadeva sui Figli del sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "Ma è terribile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "I Figli del sole non avevano nessuna colpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Nessuna colpa? Mmm, non è esattamente così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Per quanto riguarda il popolo di Byakuyakoku, la loro colpa più grande era l'ignoranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "Un peccato, anche se commesso nell'ignoranza, può ferire altre persone. Può una persona che commette tali trasgressioni essere realmente considerata innocente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "Sarebbe un po' inverosimile, no? Il danno è già stato fatto, e non può essere riparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Ma se la pensi così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Beh, puoi considerarlo... un desiderio che viene dal profondo del mio cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Il mio nome è Clymene. Ero una funzionaria che aveva il compito di occuparsi dei Figli del sole nel Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Nonostante sapessi che si sbagliavano, e fossi consapevole che venivano manipolati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "Erano comunque dei bambini che ho visto crescere. Li compativo, e ne ho pianto la perdita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Non posso odiarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Anche se il mio lavoro consisteva nello stare con loro ogni giorno, ero costantemente sotto stretta sorveglianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "Non avevo il permesso di proferire una sola parola, quando stavo con quei bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Ma quando non c'era nessuno, quando erano indifesi e spaventati, mi dicevano così tante cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "E io non potevo dire loro una sola parola in risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Se solo avessi avuto un po' di spirito di sacrificio e di coraggio per dire loro qualcosa, qualsiasi cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Forse sarebbe potuta andare diversamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Questo è il motivo per cui non posso farlo io personalmente, quindi è l'unico modo che ho per onorarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "#Ti supplico, gentile viaggiat{F#rice}{M#ore}, aiutami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Tutto ciò che ti chiedo è di deporre una perla di corallo sulle loro tombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "In questo modo, potrai accendere le Lanterne dell'anima nel santuario e raggiungere il Locus della guida delle anime per donare loro la pace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Grazie. È tutto nelle tue mani, dunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Perché vuoi che rendiamo loro omaggio, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
		{
			"id": 7224402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
