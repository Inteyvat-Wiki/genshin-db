			},
			"dialogs": [
				{
					"id": 722440201,
					"content": "#I Figli del sole erano sette. Viaggiat{F#rice}{M#ore}, rendi loro omaggio al posto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224403,
			"completionStepIds": [
				7224410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224410",
							"2"
