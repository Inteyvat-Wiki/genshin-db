				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Aaah... Sì, non ci sono dubbi: è proprio la Briglia divina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "#Non avrei mai pensato che sarebbe arrivato il giorno in cui avrei potuto ammirarla ancora una volta. Viaggiat{F#rice}{M#ore}, dimmi: come l'hai avuta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "Me l'ha data Aberaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "Aberaku no Mikoto in persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "Che strano... Ricordo chiaramente che fu un personaggio di spicco sin dai tempi in cui la nostra nazione era stata appena fondata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "Si diceva, però, che avesse intenzione di usurpare il potere del Figlio del sole, per cui fu bollato con il reato di tradimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Ma, dato che dici di averla ottenuta da lui, forse non sono a conoscenza dell'intera storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "E così, il destino ha voluto che la Briglia ricomparisse qui... Ah, riesco già a ricordare i volti di quei bambini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "In questo modo, potrò finalmente espiare le mie colpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "#Viaggiat{F#rice}{M#ore}, metti la Briglia nella pozza d'acqua. In questo modo, potremo rinforzare le loro anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "I vuoti delle loro anime saranno colmati e potranno intraprendere il cammino verso la prossima vita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224411,
