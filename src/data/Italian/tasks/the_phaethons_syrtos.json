			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon. Amavi così tanto i libri, dicevi sempre che esisteva un mondo a noi sconosciuto, anche se non ti credevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Io sorridevo e scuotevo la testa di fronte alle tue folli affermazioni. Ahimè, avrei dovuto crederti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Dicevi che un giorno saresti scappato dal Dainichi Mikoshi e ti saresti avventurato nel mondo esterno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "È il tuo momento, Piramumon. Non lasciare che qualcuno t'incateni di nuovo. Vai, liberati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "E tu, caro Orupeusu. Cosa darei per sentirti di nuovo cantare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Nessuno riusciva ad ascoltare la tua voce chiara e pura senza desiderare di cantare insieme a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "La notte prima del Rito del ritorno al sole, volevi sentire la mia voce, volevi sentirmi cantare a tutti i costi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Mi dicesti che non avresti riso, anche se il mio canto fosse stato terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Lo sapevi, vero? Sapevi che questo ritorno al sole sarebbe stato il tuo ultimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "E, tuttavia... fino alla fine, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "#Chiedo scusa, viaggiat{F#rice}{M#ore}. È stato inopportuno da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "Una funzionaria al servizio dei Figli del sole deve preservare la propria purezza... Non può sposarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Per cui, non ho mai avuto figli miei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Questi bambini, che ho servito e visto crescere... A un certo punto, ho iniziato a sentirli come miei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Grazie per aver trovato la Briglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "È passata per le mani di tutti i Figli del sole, e i ricordi che ha raccolto sono sufficienti per colmare i vuoti delle loro anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Anche se questi ricordi hanno due facce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Due facce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Certamente. In questo caso, i ricordi hanno due facce perché da un lato ci sono i tuoi ricordi, e dall'altro i ricordi che gli altri hanno di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Quindi i vuoti delle loro anime vengono colmati dai ricordi di entrambi i Figli del sole, impressi nella Briglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Che dai ricordi che il popolo ha di loro in quanto bambini accusati da Byakuyakoku, di coloro che sono diventati figli del peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "I miei soli ricordi non sono sufficienti, perciò ho dovuto integrarli con quelli degli abitanti della nostra nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "Ed è grazie a quelle azioni atroci a loro attribuite che ora possono essere ricordati dal popolo di Byakuyakoku, e possono liberarsi delle loro immagini residue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Il mio più grande desiderio è stato esaudito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "Posso finalmente... essere serena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Sì, potrò finalmente stare di nuovo con i bambini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "I ricordi hanno delle facce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
