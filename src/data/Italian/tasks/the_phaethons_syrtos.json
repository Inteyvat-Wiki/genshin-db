			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "Uno, due, tre... Sembra che abbiamo reso omaggio a tutte le tombe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Torniamo al santuario e diciamolo allo spirito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
