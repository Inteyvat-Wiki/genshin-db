			"dialogs": [
				{
					"id": 722440501,
					"content": "#Viaggiat{F#rice}{M#ore}, hai trovato... la Briglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440502
					],
