						"stepId": 7224410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Ah, le sette Lanterne dell'anima sono accese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "Sembra che tu abbia portato a termine il tuo compito. Ricorderò per sempre che mi hai aiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "Vieni con me, ti aprirò la strada per il Locus della guida delle anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "#Viaggiat{F#rice}{M#ore} di terre straniere, so di averti causato molti problemi... Ma vorrei che fossi testimone di questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Segui questo sentiero. Ci incontreremo sul lato opposto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#Ah, viaggiat{F#rice}{M#ore}, sei qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Questo è il Locus della guida delle anime, dove riposano i miei ultimi pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Quando i Figli del sole raggiungevano una certa età, dovevano eseguire un rituale ed entrare nel Dainichi Mikoshi il giorno della loro nascita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Entrare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Sì, per questo era conosciuto come Rito del ritorno al sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "I Figli del sole nascevano dal Dainichi Mikoshi, ed è lì che dovevano ritornare prima che il mondo mortale potesse contaminarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "La temperatura del Dainichi Mikoshi era tale che la sua luce poteva riscaldare l'intera Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Poteva riscaldare perfino i Figli del sole, ormai ridotti a semplici brandelli di anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Ma credo ancora che, forse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Forse...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Essendo stata io ad aprire il Locus, potrei usare i miei ricordi per colmare i vuoti delle loro anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Lascia che faccia un tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon... Orupeusu... Sono qui. Perché non tornate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Com'è andata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*sospira* Tra i sette Figli del sole, Piramumon e Orupeusu sono stati cresciuti da me personalmente. Se neanche loro torneranno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "Sembra che i miei soli ricordi non siano sufficienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "Se solo potessi usare qualcosa come mezzo... Forse la Briglia divina, il simbolo dell'autorità del Figlio del sole, potrebbe funzionare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "Ma, ahimè... è andata persa molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "*sospira* Questa nazione, Byakuyakoku, detesta ancora quei bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Forse il mio desiderio di liberare le loro anime è solo una vana speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "#Ma, in ogni caso, viaggiat{F#rice}{M#ore}, se volessi prendere in considerazione questa mia ultima richiesta, potresti aiutarmi a trovare la Briglia divina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "So che le possibilità di trovarla sono piuttosto scarse, ed è sicuramente scortese da parte mia farti un'altra richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "Comunque, la Briglia non è stata trovata per molti anni. Non c'è bisogno di affrettarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "Se mai dovessi scoprire qualcosa, ti prego di dirmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Questo significa che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
