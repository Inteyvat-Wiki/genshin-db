			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Oh, miao, miao... Dove sono finiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, siete voi. Alcuni di quei furfantelli sono scappati, e non so dove siano finiti. Sono molto preoccupata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "Il mondo esterno è pericoloso. Gliel'ho detto mille volte, quei mostriciattoli pelosi armati di bastoni e quelle palle d'acqua e di fuoco sono pericolosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "E se dovessero finire in quel posto pieno di scosse e formicolii, gli si drizzerebbero tutti i peli del corpo. Non vorrei che a quei birbanti capitasse qualcosa di così terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Ma ce n'è sempre qualcuno che non ascolta e va a zonzo, e ogni volta devo impazzire per riportarli a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Oggi alcuni di loro sono sgattaiolati via di nuovo, il che è molto preoccupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Per favore, aiutatemi a trovare Konbumaru e Hachihou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "Chi è Konbumaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Un bravo gattino. Il Konbumaru di questa generazione è molto intelligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "Cosa vuoi dire \"di questa generazione\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Hibiki a volte ne parlava. Non posso dire di aver capito, ma, dalla sua espressione quando parlava di Konbumaru, sembrava qualcosa di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Io chiamo i piccoli con nomi di cose buone... e quando i piccoli non sono più piccoli e se ne vanno, uso gli stessi nomi per i nuovi gattini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "Konbumaru ama dormire nei posti molto alti, quindi dovreste iniziare da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "E invece Hachihou è...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Un piccoletto molto agile e amante del pesce, quindi spesso va in riva al mare per cercare i pesci che si sono arenati sulla spiaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Una cosa molto pericolosa. L'acqua è davvero una cosa spaventosa. Molto, molto tempo fa, un certo... tanuki, giusto? Beh, quel tizio cadde in acqua e rischiò di non tornare mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Probabilmente troverai Hachihou vicino al mare, in cerca di pesci o granchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Certo che non sono indicazioni molto specifiche...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Davvero? Un posto molto in alto e il mare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Ehm, che ne dici di mostrare a Neko la nostra mappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "A voi... manca proprio la capacità di comprensione, eh? Questo è il luogo molto in alto, e questo è il mare. Saranno sicuramente lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Allora è tutto nelle vostre mani, miao, miao. Ah, questi gattini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "#Non sono {F#un'esperta}{M#un esperto} nel catturare i gatti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miao, miao, non abbiate paura, quei piccoli non temono gli umani... Anzi, si potrebbe dire che è proprio perché nessuno gioca con loro che scappano per questo scappano sempre da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Allora è tutto nelle vostre mani, miao, miao. Ah, questi gattini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
