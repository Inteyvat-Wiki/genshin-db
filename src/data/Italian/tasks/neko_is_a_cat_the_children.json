				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Li avete trovati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Voi due! Non mi ascoltate mai, vero? Perché non potete essere bravi come Meshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Ahahah, \"riso al vapore\", li chiami davvero con nomi di cose buone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miao, miao miao miao... miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "Hachihou"
				},
				{
					"id": 722100407,
					"content": "Miao! Miao miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100408,
					"content": "Non vi azzardate a rispondermi! Oppure smetterò di cercarvi lasciandovi semplicemente... affamati da quando sorge il sole a quando spunta la luna, e fino a quando il sole è di nuovo alto nel cielo... e aspetterò che torniate a casa da soli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100410,
					"content": "Ahah, ecco, bravo gattino. Va bene, va bene, sono felice che siate tornati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Sono in debito con voi. Se non fosse stato per il vostro aiuto, questi furfantelli avrebbero sofferto la fame lontano da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "In realtà penso che sarebbero riusciti a tornare da soli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Forse sì, o forse no... ma vi ringrazio comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Se avete tempo, tornate a trovarmi. Potrei avere ancora bisogno del vostro aiuto in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
