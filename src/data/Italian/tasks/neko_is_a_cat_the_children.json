			"dialogs": [
				{
					"id": 722100301,
					"content": "Miao! Miao miao, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100302,
					"content": "Wow! È proprio un gattino feroce, fai attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miao, miao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miao, miao? Miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100307,
					"content": "Eheheh, faceva il gattaccio feroce, ma sembra che alla fine si lasci prendere in braccio, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "Siamo qui per portarti a casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "Miao! Miao... miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
