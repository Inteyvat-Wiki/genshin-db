					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "La prima volta che ho fatto questo addestramento con Razor, ci è voluto un giorno intero per finirlo. Sai perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "Ha passato un quarto della giornata a far rotolare i barili, e gli altri tre quarti a cercare di capire di cosa diamine stessi parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
