			"dialogs": [
				{
					"id": 766750101,
					"content": "...Nannina gestirà il nord, quindi Laurent si occuperà dell'est... Bene, per ora è tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750102,
					"content": "Ehi, Varka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750103,
					"content": "#Eh? {F#Cavaliere Onoraria}{M#Cavaliere Onorario}? Paimon? Cosa vi porta al mio accampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750104,
						766750105
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750104,
					"content": "#Stavamo gironzolando, e ci siamo {F#imbattute}{M#imbattuti} in te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				},
				{
					"id": 766750106,
					"content": "Niente affatto! Qualsiasi accampamento dei Cavalieri di Favonius è anche il vostro, quindi fate pure come a casa vostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750107
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750107,
					"content": "Però la prossima volta dovreste avvisarmi, così dirò al sovrintendente di portare qualcosa di buono da bere per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750108,
					"content": "E questo sarebbe l'accampamento del corpo di spedizione? Paimon si aspettava fosse un po' più... affollato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750109,
					"content": "Non sono molti i membri del corpo di stanza qui, e la maggior parte sono di pattuglia. A essere sinceri... Ahahah, è un po' una città fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750110,
					"content": "Cosa fanno le persone rimaste qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750111
					]
				},
				{
					"id": 766750111,
					"content": "Raccolgono tutte le informazioni sull'Abisso possibili. Naturalmente, in questo momento ci stiamo concentrando sulla Caccia selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750112,
					"content": "A tal fine, stiamo raccogliendo informazioni da tutta Nod-Krai. Anche con Rerir sigillato, le acque non si sono ancora del tutto calmate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750113,
					"content": "Stiamo anche raccogliendo tutte le informazioni possibili relative all'Abisso. La situazione a Nod-Krai è stabile per ora, ma dobbiamo rimanere vigili. Non si sa mai quando l'Abisso potrebbe tornare ad attaccare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750114,
					"content": "Le informazioni sono la base di ogni campagna. Non si tratta solo dei movimenti nemici: il terreno o i cambiamenti delle condizioni atmosferiche possono fare la differenza tra la vittoria e il fallimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750115,
					"content": "In futuro, intendiamo stabilire una collaborazione a lungo termine con la Rete di spionaggio del Nord, trasformando questo accampamento temporaneo in una stazione di intelligence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750116,
					"content": "U-Una stazione di intelligence? Woah, tipo quelle dei thriller di spionaggio di Fontaine?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750117,
					"content": "Ahah, come no! Dimmi un libro in cui ci sia un accampamento così poco difeso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750118,
					"content": "Durante questi anni di campagna, abbiamo scoperto che diversi disastri dell'Abisso si stanno verificando in tutta Teyvat. Sono incredibilmente astuti, sempre mutevoli, e non ci sono mai due attacchi uguali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750119,
					"content": "Spero di utilizzare la Rete di spionaggio del Nord per condividere le nostre scoperte e, tramite questa collaborazione, continuare a raccogliere informazioni sull'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750120,
					"content": "Questo non è il fardello di una sola nazione. Ogni giorno, innumerevoli venti soffiano a Nod-Krai... Direi che questo lo rende il posto perfetto per stabilire un avamposto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750121
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750121,
					"content": "Ohhh, ecco perché... Quindi questa è la \"cavalleria\" in azione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750122,
					"content": "Ahah! Beh, è sicuramente un bene avere la \"cavalleria\", ma in realtà... abbiamo appena stabilito questa stazione e non abbiamo nemmeno una buona mappa del terreno circostante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750123,
					"content": "Se ti imbatti in materiali da costruzione o informazioni nelle vicinanze, non dimenticare di riportarli con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750124,
					"content": "#Non temere, sei {F#la nostra Cavaliere Onoraria}{M#il nostro Cavaliere Onorario}. Ci prenderemo cura di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750125,
					"content": "Ci penso io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750126
					]
				},
				{
					"id": 766750126,
					"content": "Ah, finita una spedizione, ecco che ne comincia un'altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750127
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750127,
					"content": "G-Gran Maestro! Abbiamo un grosso problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750128
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750128,
					"content": "Eh? Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750129
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750129,
					"content": "L'ospite importante che stavamo aspettando oggi... è intrappolato ai piedi della montagna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750130
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750130,
					"content": "COSA?! È... chi penso io?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750131,
					"content": "Sì, signore! È lui! La maggior parte delle nostre forze disponibili è in pattuglia. A chi dovremmo assegnarlo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750132
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750132,
					"content": "#...Non serve! Indicami la direzione giusta, me ne occuperò io! {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, Paimon, alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750133
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750133,
					"content": "Varka sfreccia via come il vento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766750134
					]
				},
				{
					"id": 766750134,
					"content": "Woah, Paimon non ha mai visto Varka così nervoso! Adesso vuole proprio sapere chi sia quell'ospite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750135,
					"content": "Che sia... un informatore importante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750136
					]
				},
				{
					"id": 766750136,
					"content": "Sì, dev'essere così! Seguiamolo e vediamo se ha bisogno d'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750105,
					"content": "Disturbiamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				}
			]
		},
		{
			"id": 7667504,
