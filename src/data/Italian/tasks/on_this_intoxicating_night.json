						],
						"pointId": 15070
					}
				]
			},
			"dialogs": [
				{
					"id": 766750401,
					"content": "...Ehi, tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "S-Sto bene... Uff, meno male che siete arrivati così in fretta, o non sarei arrivato al tramonto, mi sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "...Grazie al cielo! I nostri \"rifornimenti essenziali\" ce l'hanno fatta, sani e salvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Ehm, che razza di rifornimenti sono così importanti...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "Alcol. Sicuramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Che perspicace! Questo è il vino di denti di leone che abbiamo ordinato appositamente dal Vigneto Prima Luce! L'essenza di Mondstadt in bottiglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "Non avete idea della fatica che abbiamo fatto per portarlo fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Ahah, hai fatto un ottimo lavoro! Stasera al banchetto berrai con noi. Tutto l'accampamento non vede l'ora di brindare in tuo onore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "...Quindi l'unico motivo per cui avevi fretta era assicurarti che le bevande arrivassero in tempo? E Paimon che pensava che finalmente stessi prendendo sul serio qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "Cosa? Stai forse insinuando che bere non è la cosa più seria che ci sia? Perché mi farei volentieri un bicchiere proprio... ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "A-Aspetta! Ti prego, aspetta un secondo! Non è il momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "Sì, dagli retta! Prima devi occuparti delle cose serie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "Questa è una bevanda speciale, deve essere mescolata costantemente per evitare che si depositi e per mantenerne il sapore! Essendo rimasta ferma così a lungo, direi che il gusto è peggiorato... di almeno il dieci per cento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Dieci per cento?! Inaccettabile! Nessuno tocchi una goccia finché non è pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "...Ooook. Come dici tu, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "Quindi, come possiamo riportarlo al sapore giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "Abbiamo appositamente incaricato qualcuno di costruire un meccanismo capace di mantenere i barili in movimento... Sembra però che si sia rotto durante la caduta. Motivo per cui suppongo che dovremo usare i nostri muscoli, come una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Mmmh, quindi basta che <color=#00E1FFFF>continuiamo a colpire i barili di legno e li facciamo rotolare fino a destinazione</color>...? Sembra un tipico addestramento di forza dei Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Aspetta, i Cavalieri seguono un addestramento del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Esatto, insegna il controllo della forza e la precisione. Servono entrambi, altrimenti il barile non manterrà la traiettoria. È l'addestramento di base per molti cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Adesso hai la mia curiosità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "Ah, hai voglia di esercizi basilari, eh? Beh, ci vorrà un po' prima che Laurent e gli altri tornino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "Bene, a te. Non preoccuparti se finiscono un po' troppo lontano. Fammi un fischio e li rimetto a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "#Essendo {F#la Cavaliere Onoraria}{M#il Cavaliere Onorario}, vorrei cimentarmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Perché sento odore di alcol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
