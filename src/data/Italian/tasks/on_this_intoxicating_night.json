			"dialogs": [
				{
					"id": 766750501,
					"content": "Devo occuparmi dei barili, o volevi solo fare due chiacchiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750502,
						766750504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750502,
					"content": "Riposizionalo, per favore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "Forza! Non mollare adesso, tieni duro e riprova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750504,
					"content": "Facciamo due chiacchiere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "Quando addestravo Noelle, faceva esplodere i barili in mille pezzi non appena si innervosiva. E non c'era modo di impedirle di ripulire il pasticcio che creava da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750506,
					"content": "Col tempo... è diventata la migliore addetta alle pulizie dei Cavalieri. Ah, forse non se n'è resa conto, ma anche quello lo si può considerare progresso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
