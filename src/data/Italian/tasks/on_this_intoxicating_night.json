			},
			"dialogs": [
				{
					"id": 766750901,
					"content": "#Ah! Gran Maestro! {F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Sono tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "Sono tornati! Sono tornati! Venite tutti a dargli il benvenuto che si meritano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Wow, siamo così popolari? Paimon diventerà rossa come un pomodoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "Ah, il vento trasporta quel profumo da lontano! Dolce Barbatos, è vero! Vino di denti di leone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "E per giunta, una bevanda speciale dal Vigneto Prima Luce! Sono tornati... tutti i miei ricordi preziosi... stanno riaffiorando tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Ehm... Quindi, il benvenuto non è per noi, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Sì, è questo, è proprio questo l'odore... Esattamente come lo ricordavo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "Incredibile, dopo tutti questi anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "Ah, pensavo quasi di aver dimenticato l'odore di un vino d'annata del Vigneto Prima Luce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "Se l'odore non è cambiato... allora neanche la mia casa al Villaggio Acquachiara probabilmente non è cambiata... vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "#...Grazie, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "...Basta così, piano con l'entusiasmo. I barili resteranno sigillati finché non saranno tornati tutti. Nel frattempo, finiamo i preparativi per la festa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "Sì, signore! Subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "...Come dicevo: bere è una cosa serissima, la più seria di tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Ooooh... Arrosto al miele... Pollo ai Fiordolci... Paimon non avrebbe mai pensato di poter mangiare dei piatti di Mondstadt così autentici qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Ehm, aspetta, dov'è Varka? Qualcuno l'ha visto? Non è che si è addormentato ubriaco in qualche fosso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Con un fegato così resistente, è davvero possibile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Ok... Paimon ti raggiungerà appena avrà finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "Vado a cercarlo, tu continua a mangiare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "#È la stessa, ci sono {F#passata}{M#passato}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667510",
							"2"
						],
						"stepId": 7667510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varka"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5921.365,
							283.763,
							9726.784
						],
						"pointId": 14164
					},
					{
						"sceneId": 3,
						"position": [
							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "#Allora, cosa ci fa in un posto del genere l'{F#eroina}{M#eroe} che ha salvato il nostro salvatore e l'ha riportato all'accampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751002,
					"content": "Mi hai tolto le parole di bocca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Eh... A dire il vero, quello che ho nella mia tazza è la più speciale delle bevande. Può essere bevuta solo in solitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751005,
					"content": "...Ma dato che mi hai beccato, tanto vale. Tieni, prendi un bicchiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751006,
					"content": "...Lo sapevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "Mi hai beccato! Era solo uno scherzo. Non ho un goccio di alcol in corpo in questo momento. Se hai voglia di vero alcol, vai a cercare Erminie più tardi, ne ha in abbondanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751009,
					"content": "Un accampamento ha sempre bisogno di un'anima sobria che vegli sui compagni ubriachi e li protegga da ciò che si aggira nella notte. Questi sono stati i miei ordini fin dall'inizio della spedizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751010,
					"content": "Che sfortuna, eh? E guarda caso, stasera tocca a me essere l'anima sobria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751011,
					"content": "...Quindi, in una notte come questa, essendo tutti ubriachi, io non posso permettermelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751012,
					"content": "È stata davvero questione di fortuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Chissà... Forse il destino si diverte a prendersi gioco di noi? Se fosse arrivato un giorno dopo, magari sarei stato lì a tracannare vino a più non posso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751015,
					"content": "#Ma se fosse arrivato un solo giorno dopo, forse non saresti {F#passata}{M#passato} per l'accampamento. Ti saresti perso il banchetto e non avremmo mai avuto l'occasione di parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751016,
					"content": "Nessuno può dire quali risultati avranno le nostre scelte finché non arriva il momento opportuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751017,
					"content": "Proprio come quando decisi di guidare questa spedizione fuori da Mondstadt... Non avrei mai immaginato di arrivare così lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751018,
					"content": "Hai avviato la spedizione... per affrontare la Caccia selvaggia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "...Così è andata a finire, sì. Ma quando stavamo marciando, \"sapevo\" solo che una tempesta abissale stesse prendendo forma a nord, e che minacciava di spazzare via tutta Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751020,
					"content": "Ci volle del tempo per mobilitarci, ma dove sarebbe apparso il nemico e quale forma avrebbe assunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751021,
					"content": "...Tutto ciò non era altro che un mistero per noi, quando partimmo. Potevamo solo raccogliere informazioni mentre marciavamo, preparandoci per ogni evenienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751022,
					"content": "Sapevi solo questo, e hai comunque iniziato la spedizione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Ah! Impari in fretta, non è vero? Purtroppo, il nemico non se ne sta con le mani in mano mentre noi finiamo di prepararci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751025,
					"content": "Per ogni ora che esitavamo, l'Abisso divorava le vite di innumerevoli persone. Prima ci mettevamo in marcia, prima avremmo potuto cambiare il loro destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751026,
					"content": "Queste erano tutte le informazioni di cui avevamo bisogno per avviare questa \"spedizione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751027,
					"content": "Non mi stupisce che tu sia il Cavaliere di Boreas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "#Basta con le formalità, \"{F#Cavaliere Onoraria}{M#Cavaliere Onorario}\"! E tu non sei da meno. Anche il tuo viaggio ha cambiato il destino di molte persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751030,
					"content": "Quello di Mondstadt allora, di Dvalin... di Nod-Krai adesso, del corpo di spedizione... persino il mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751031,
					"content": "#Il fatto che possiamo cantare attorno al falò, bere e pensare al futuro... Niente di tutto questo sarebbe potuto accadere senza il tuo arrivo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751032,
					"content": "...Sono davvero così incredibile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "...Ahah, chi può dirlo? Il destino è volubile e imperscrutabile, dopotutto. Ma finché si è vivi, c'è speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751034,
					"content": "Il vino che non abbiamo bevuto stasera, potremo berlo domani. I ragazzi ne terranno un po' per me. Finché siamo vivi, il domani porterà altro vino e risate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751035,
					"content": "Allora, cin cin! Al domani! Alla speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751028,
					"content": "I Cavalieri di Favonius, signore e signori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "Non avevi detto che le informazioni sono la base di ogni campagna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "Proprio il giorno in cui era previsto l'arrivo del vino di denti di leone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "È sidro di mele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "Perché sei qui a bere tutto solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
