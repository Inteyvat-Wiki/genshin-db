			"dialogs": [
				{
					"id": 150201001,
					"content": "Oh, siete qui per darmi una mano? Meno male! Non sarei mai riuscito a fare tutto da solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201002,
					"content": "L'ostruzione che era qui è stata rimossa usando una bomba speciale, ma trasportare degli esplosivi su per una salita ripida è decisamente rischioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201003,
					"content": "Se cadessi o inciampassi e finissi a terra, salterei in aria in un istante. Quindi ho pensato di trasportare la bomba dall'altro lato e farla arrivare con un pallone aerostatico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201004,
					"content": "Mi serve solo qualcuno che <color=#00E1FFFF>colpisca il pallone nel momento giusto, per sganciare il carico al di sopra della bocchetta</color>... E il gioco sarà fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201005,
					"content": "Cosa ne pensi? Un compito facile facile, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201006,
					"content": "Credo di potercela fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Ma quel pallone aerostatico non è tuo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Eh? Ah, QUELLO... No, non ho idea a chi appartenga. O come abbia fatto ad arrivare così in alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201009,
					"content": "Mi piacerebbe solo poter volare fin lassù e scoprire che razza di tecnologia monti... Però, rimettere in sesto l'Arena per la prova ha decisamente la priorità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201010,
					"content": "Vado a preparare tutto. Dimmi quando ci sei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigatore audace"
				}
			]
