				]
			},
			"dialogs": [
				{
					"id": 150200801,
					"content": "#Mh? Chasca e {NICKNAME}? Che sorpresa vedervi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Anziana Allpa? Eh? Allora... Dov'è questo Qucusauro aggressivo di cui si parla tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "È già volato via. Sembra che sia scappato quando ha capito che stavano arrivando i rinforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Si è fatta un'idea sul perché abbia attaccato quelle persone? Era affamato, forse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "No, quei mercanti non stavano trasportando cibo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ah! Meno male! Le Ali a Flogisto sono intatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Giovane mercante"
				},
				{
					"id": 150200807,
					"content": "...Ali a Flogisto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "#Aaah, grazie infinite per essere {F#venute}{M#venuti} in nostro soccorso. Queste Ali a Flogisto sono la nostra merce più preziosa. Se fosse successo loro qualcosa, sarebbe stata una rovina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "...Un momento, siete forse i mercanti che volevano collaborare con noi? Warmi me ne aveva accennato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Sì, proprio così! Allora... Lei dev'essere l'Anziana Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Sì. Immagino sarete stanchi per il viaggio, nonché scossi per l'attacco che avete appena subito. Lasciate che vi ospiti presso la nostra tribù, potremo parlare di affari quando vi sarete riposati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Ma... Anziana Allpa, che facciamo riguardo a quel Qucusauro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Beh, i nostri ospiti non hanno subito ferite gravi e la loro merce è intatta... Forse il Qucusauro era semplicemente indisposto, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Ce ne sono così tanti, qualche colpo di testa ogni tanto può capitare. Non penso valga la pena di fare altro... Piuttosto, come procedono i preparativi per le prove di volo? È tutto a posto all'arena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Sì, tutto regolare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Eh? Avete detto... \"prove di volo\"? Cribbio, che coincidenza! Sembra l'occasione perfetta per mostrarvi le Ali a Flogisto! Resterete sorpresi da ciò che sono in grado di fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Oh, sul serio? La cosa mi incuriosisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Eheh, allora lasciamoci alle spalle l'attacco di quel Qucusauro... Abbiamo affari decisamente più urgenti da discutere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Tutto qui? È andata molto più liscia di quanto ci aspettassimo... Beh, allora possiamo andare. Eh? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Che stai guardando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Una piuma macchiata di sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "L'incidente viene dimenticato e la pace ritorna nel Clan Piumafiore.\\nI giorni successivi trascorrono sereni, tranne che per le preparazioni per la prova di volo, che continuano a ritmo serrato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Le prove potranno iniziare molto presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
