				},
				{
					"id": 150200202,
					"content": "Ma all'interno ci sono strani segni di vita... Metterci le mani potrebbe rivelarsi pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigatore prudente"
				}
			]
		},
		{
			"id": 1502003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
