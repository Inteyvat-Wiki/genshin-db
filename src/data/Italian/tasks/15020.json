			"dialogs": [
				{
					"id": 150200501,
					"content": "È tutto pronto? Per Chasca dovrebbe rivelarsi una sciocchezza, ma sempre meglio essere prudenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "Di sicuro se la caverà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Bene. Allora spiega le ali e vola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Ho bisogno di un altro po' di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
