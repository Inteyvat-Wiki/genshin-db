			},
			"dialogs": [
				{
					"id": 150200101,
					"content": "Oh! Ehilà, Chasca. Ti manda l'Anziana Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Sì, aveva altre faccende di cui occuparsi. Come procede, qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Mmmh, beh, l'ispezione ha rivelato diverse ostruzioni sparse per tutta l'Arena. Pare siano l'effetto delle anomalie geomantiche dovute all'invasione dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "In teoria, dovrebbe bastare rimuovere le ostruzioni per permettere al Flogisto aeriforme di riempire di nuovo l'arena, ma per varie ragioni si sta dimostrando più difficile del previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Volete scendere a vedere di persona? Se vi servono altre informazioni, chiedete pure al personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502002,
