						150201102
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201102,
					"content": "Potresti spiegarmi di nuovo il piano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201103
					]
				},
				{
					"id": 150201103,
					"content": "Ah, certo. Dunque, voglio sganciare degli esplosivi sulla bocchetta dall'altro lato con il pallone aerostatico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201104
					],
					"speakerTitle": "Investigatore audace"
				},
				{
					"id": 150201104,
					"content": "Tutto quello che devi fare è <color=#00E1FFFF>colpire il pallone al momento giusto per far cadere la bomba sulla bocchetta</color>. Semplice!",
					"roleType": "TALK_ROLE_NPC",
