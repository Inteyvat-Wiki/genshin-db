			"dialogs": [
				{
					"id": 150200601,
					"content": "È stato fenomenale! Paimon non riusciva a toglierti gli occhi di dosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Hai notato qualche altro potenziale problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Mmmh... No, niente di che. Basterà aspettare qualche altro giorno e potremo svolgere la prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Aiuto... Aiutatemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "Voi... siete del Clan Piumafiore, vero? Presto, dovete venire ad aiutarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Calma, respira profondamente. Che sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "S-Siamo stati... attaccati da un Qucusauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "I miei amici sono bloccati in mezzo a una strada insieme alla merce che stavamo trasportando... Vi supplico, dovete salvarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Eh? I Qucusauri possono essere così aggressivi? Attaccano i gruppi di persone anche se non vengono provocati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
