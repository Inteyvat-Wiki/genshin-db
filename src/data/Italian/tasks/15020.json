			},
			"dialogs": [
				{
					"id": 150200701,
					"content": "Curioso... Che ci fa qui tutto questo Flogisto solido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Investigatore titubante"
				},
				{
					"id": 150200702,
					"content": "Che appartenga ai Figli degli Echi...? Forse è finito qui a causa delle anomalie geomantiche. <color=#00E1FFFF>In effetti, ora si spiegano tutti quei segni strani sulla rupe...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200703
					],
					"speakerTitle": "Investigatrice confusa"
				},
				{
					"id": 150200703,
					"content": "Uff, non so cosa fare, onestamente... L'unica sarebbe andare dai Figli degli Echi a prendere in prestito un <color=#00E1FFFF>Tepetlisauro</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigatore titubante"
				}
			]
		},
