			"dialogs": [
				{
					"id": 150200401,
					"content": "Wow, avete risolto in due secondi... Incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Ora dobbiamo solo aspettare che il Flogisto aeriforme riempia tutta la zona. Dopodiché potremo dare inizio alla nuova sessione di prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Uhm... In realtà, Inkanak, vorrei prima effettuare un volo di prova per assicurarmi che non ci siano problemi. Credi sia possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Eh? Ma... abbiamo appena finito di preparare l'arena, potrebbero esserci altri pericoli di cui non siamo al corrente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "A maggior ragione, allora. Considerala come un'ispezione aggiuntiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Mh... Credo che tu abbia ragione. Viste le tue abilità di volo, dubito che correrai rischi particolari, a prescindere da eventuali pericoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Le condizioni dell'area sembrano un po' instabili, un volo di prova è l'unico modo per individuare eventuali problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Va bene, preparo tutto io. Quando sei pronta, fammi sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
