			"dialogs": [
				{
					"id": 150200201,
					"content": "Uhm... Per sbloccare questa bocchetta credo <color=#00E1FFFF>basterà qualche colpo ben assestato</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200202
					],
