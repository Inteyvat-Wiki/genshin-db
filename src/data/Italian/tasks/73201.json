			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Questa è la bacheca degli annunci del Bar Puspa. Per qualche motivo, per il momento sarò la responsabile provvisoria del locale. Se avete qualcosa da comunicarci, sentitevi liberi di lasciare un messaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"La leggendaria storia di Antara continua questa settimana!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010202,
					"content": "\"Presentata da Maddah, lo speciale cantastorie della casa del Bar Puspa! Da non perdere!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010203,
					"content": "Caro Maddah... Ti offriremo un caffè se smetti di pubblicare qui i tuoi annunci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "\"Eheh... Gata, eheh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010302,
					"content": "Anche Gata sembra essere molto affezionata a te, Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"Il club di carte di Puspa sta reclutando membri per giocare al GCC Invokazione del genio!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010402,
					"content": "\"Se volete discutere di come creare un mazzo e delle varie tecniche, venite a cercarmi al tavolo da gioco!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010403,
					"content": "Nayab, almeno ordina un caffè se vuoi giocare a carte qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"Di recente ci sono stati diversi casi di contrabbando di Conoscenze in scatola.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010502,
					"content": "\"Promemoria speciale dei Matra: per richiedere e ottenere la Conoscenza che cercate, utilizzare solo i canali autorizzati.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010503,
					"content": "\"Le conoscenze proibite ottenute attraverso canali illegittimi comporteranno la revoca del diritto di studiare presso l'Akademiya. Attenzione.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "\"Per chi, come me, sta preparando un esame, l'atmosfera che si respira qui è molto più amichevole di quella di un'osteria.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010602,
					"content": "\"Trovo sempre del caffè che mi dà la forza di andare avanti e degli anziani a cui chiedere consiglio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010603,
					"content": "\"Anche la responsabile ha predetto che quest'anno entrerò nell'Akademiya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010604,
					"content": "Spero che il tuo desiderio possa avverarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"Attenzione! Il mio amico si è imbattuto nel Raja Chiomalunga nel cuore della notte, nella foresta a nord-ovest! È stato fortunato a tornare tutto intero. In ogni caso, non uscite dopo il tramonto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "\"L'ultimo studio della grande ricercatrice Pursina suggerisce che bere caffè migliora le capacità cognitive.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010802,
					"content": "\"Venite più spesso in questo bar, se state provando a entrare nell'Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010803,
					"content": "Grazie davvero per aver pubblicizzato la nostra attività, ma il caffè serve solo a darti un po' più di energia... Inoltre, il Mahamata potrebbe prendere provvedimenti contro affermazioni infondate come questa, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "\"Se siete qui per giocare a carte, vi invito a imparare una lezione da me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010902,
					"content": "\"Non avrei dovuto inventare una carta per ingannare gli altri giocatori di Invokazione del genio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010903,
					"content": "\"Lord Jackal mi ha aiutato a capire i miei errori, e sono qui per confessare.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732010904,
					"content": "\"Molte persone nemmeno li capiscono, i propri errori. Ma... chi è questo Lord Jackal?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "\"Ho sentito che molti banditi sono spuntati nel deserto e che molti mercanti si rifiutano di percorrere quelle strade. Il prezzo delle noci di Ajilenakh potrebbe iniziare a salire alle stelle.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011002,
					"content": "\"Fantastico! Adesso venderò tutti i miei funghi in cambio di noci di Ajilenakh! Ahah! Forse è questo il coraggio e la missione del clan Alkindi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011003,
					"content": "\"Mi piacerebbe vedere la vostra ricchezza moltiplicarsi, ma ci tengo a precisare che il mio negozio non è responsabile di eventuali perdite che potrebbero derivare dalle informazioni contenute in questa bacheca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
							"2"
						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "\"Dopo aver lasciato il Gruppo dei Trenta, è qui che prendo ogni giorno il caffè.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011102,
					"content": "\"La responsabile provvisoria mi prepara lo stesso caffè ogni giorno, e il cantastorie racconta sempre la stessa storia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011103,
					"content": "\"Forse una tale reiterazione è l'essenza della vita a Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "\"Le storie raccontate da Maddah possono anche essere antiquate, ma lui è molto abile nel raccontarle.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011202,
					"content": "\"Ormai tutti sono abituati a ricevere le informazioni dall'Akasha, quindi inconsciamente trascurano una tale maturazione artistica e una tecnica così raffinata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011203,
					"content": "\"Devi essere più realista. Nessuna forma d'arte è eterna. Il giorno in cui tutto il loro valore sarà sfruttato, la loro ragione di esistere verrà meno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011204,
					"content": "\"Sono come i frutti troppo maturi, che cadono a terra e forniscono nutrimento alle nuove piante.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011205,
					"content": "\"Per questo ho sempre disprezzato i materialisti come te. L'arte è un prezioso frutto del tempo libero, non si può paragonare alla produzione e allo sfruttamento per il scopi commerciali!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011206,
					"content": "\"Le persone con tanto tempo libero sono come quelle che camminano su un terreno sferico: non esistono. Perché non usi il cervello per pensare un attimo? Può esistere una qualsiasi attività produttiva senza scambi commerciali?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011207,
					"content": "\"Che avvincente scontro dialettico... Tuttavia, è ora di saldare il conto di Kaveh per questo mese. Va messo sul conto suo conto come al solito, signor Alhaitham?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011208,
					"content": "\"No, voglio che quel viziato tocchi con mano la brutalità del mondo degli affari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011209,
					"content": "\"Cara responsabile provvisoria, prego, mettilo pure sul conto di Lord Sangemah Bay. Dopotutto, non si può fare arte senza caffè!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320113",
							"2"
						],
						"stepId": 7320113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"Dopo tanti anni, questo posto è ancora così animato! Ogni volta che vengo in questo bar, non posso fare a meno di ricordare quel pomeriggio trascorso a discutere con lui sull'interpretazione di una singola parola.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732011302,
					"content": "Il nostro negozio non sarebbe così animato senza di te. Torna a trovarci più spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		}
	]
}