			"dialogs": [
				{
					"id": 711160401,
					"content": "Siamo sempre stati compagni, Johnnie, quindi comprendo perfettamente il guaio in cui ti sei cacciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160402,
					"content": "Avresti potuto dirmelo in faccia, invece di montare su tutto questo fumo... Mi hai davvero spezzato il cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160403,
					"content": "Beh, amico, sai bene che gli affari da queste parti non vanno più come un tempo. La Spina di Rosula si sta facendo un nome, ultimamente, e tra i miei uomini gira un certo malcontento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Ma devo comunque prendermi cura di loro. Di questo passo, a noi non resteranno neanche le briciole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Facciamo buoni affari, noi due, e sono grato per questo, ma se puoi darci qualcosina di più... sono certo che possiamo trovare un accordo vantaggioso anche per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "In caso contrario... Eheh, beh, il mare è pieno di pesci, Ming Salferro. Uno come te sarà di sicuro in grado di farsi dei nuovi amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "In pratica, mi stai dicendo che questa è la tua ultima offerta, Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160408,
					"content": "La cosa ti crea problemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "Chi vuoi prendere in giro? Parla chiaro! A chi credi di poter rubare qualcosa, con questa miseria? È un'idiozia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160410,
					"content": "Silenzio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160411,
					"content": "Ascoltami, Johnnie. I Don Pesci mi pagano 58 sacchi a cassa, mentre i De Niro 70. Non credo di doverti dire io quanto siano potenti a Porto Lumidouce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160412,
					"content": "Ma a te ho sempre venduto tre casse per 100 sacchi, e ci ho incluso anche un servizio di ritiro e consegna... E, se l'ho fatto, è sempre stato in nome della nostra amicizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160413,
					"content": "Non serve che aggiunga altro... Di sicuro non ci avevi pensato a dovere. Possiamo parlarne davanti a un buon bicchierino, che dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160414,
					"content": "Eheh, non ce ne sarà bisogno. So come funziona con voi di Liyue. Giacché i contratti esistono in nome dell'imparzialità, dubito che l'amicizia possa scavalcarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Eheh, Johnnie, fratello mio! È bello vedere qualcuno che capisce lo spirito dei contratti... Ah, se solo i miei uomini imparassero da te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160416,
					"content": "Più che altro... almeno per questa faccenda specifica, gradirei che rispettaste appieno il contratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160417,
					"content": "Ma certo, certo! Mi sembra più che giusto, e l'antica tradizione di Liyue nell'onorare i contratti è qualcosa per cui noi proviamo grande ammirazione. Immagino che dovrò trovare il modo per dimostrare la mia buona fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, credi che potremmo aumentare la nostra offerta di... diciamo, un Mora ad articolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Molto generoso da parte tua, Johnnie. Queste brave persone di Liyue si sono sempre impegnate tanto per noi, un Mora extra è il minimo che gli dobbiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Ranocchietti di Fontaine! Cosa state tramando?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160421,
					"content": "Suvvia, andiamo, non riesci a notare la mia assoluta buona fede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Quindi stai cercando di violare il nostro accordo, Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160423,
					"content": "Eh? Tu dici? Cos'è che te lo fa pensare, Walker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Johnnie, per come la vedo io, il mare è pieno di pesci. Anche un semplice avannotto dovrebbe saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Tu mi deludi, Walker. Come puoi insultare così il nostro amico di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Non capisci che presto il loro territorio apparterrà comunque a noi? Dimostrare un po' di gratitudine mi sembra più che ragionevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Chiedo scusa, Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "Viscidi bastardi! Come potete avere l'audacia di concepire un piano del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160429,
					"content": "Uoh, piano con gli insulti! Non serve essere così scontrosi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "#Ehi, chi sono {F#queste due giovincelle}{M#questi due giovincelli}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Bene, bene, molto interessante. I ragazzini di Liyue hanno sempre tutto questo fegato? Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "#Ehi, da dove saltate fuori, voi {F#mocciose}{M#mocciosi}? Ecco, vi do un po' di Mora. Ora smammate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Oh, certo che sei un gran bel buzzurro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "E voi due chi sareste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160435,
					"content": "Siamo qui per il pasto luculliano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Ahahah! Quindi... immagino che voi siate i rinforzi del caro Ming Salferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Hai avuto la stessa pensata, eh, Ming Salferro? Beh, è un'eventualità che avevamo previsto. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Tocca a voi, gente, venite fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Cosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160441,
					"content": "Oh, cribbio. Direi proprio che siamo in superiorità numerica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Mi dispiace veramente tanto, caro Ming Salferro. Prima della nostra riunione, ho fatto in modo che i miei uomini si occupassero del tuo accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "E adesso tocca a te. Ti garantisco che con me i tuoi affari saranno in buone mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "\"Capo\" Johnnie... Se pensi di sbarazzarti di noi così, ti sbagli di grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160445,
					"content": "Beh, allora spero che tu possa dimostrarmelo. Prendetelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Siamo qui per far smammare certi tizi che conosciamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
