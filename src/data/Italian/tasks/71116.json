				]
			},
			"dialogs": [
				{
					"id": 711160601,
					"content": "#Che incredibile coppia di {F#eroine}{M#eroi}! Vi sono debitore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160602,
					"content": "È tutto a posto! A prescindere da quali fossero gli accordi che hai preso, rispettare un contratto è fondamentale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Eheh, questa piccola eroina ha le idee chiare! Ma come facevate a sapere del nostro accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160604,
					"content": "Ce ne ha parlato Dou'er Salferro. Parlava di un traffico di contrabbando o roba simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Che cos'è il \"contrabbando\", poi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "È uno scambio di merci illegale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "#Date le circostanze, due {F#eroine valorose}{M#eroi valorosi} come voi meritano assolutamente una ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160608,
					"content": "#Venite, ragazzi! {F#Legatele}{M#Legateli} ben {F#strette}{M#stretti} e {F#gettatele}{M#gettateli} a mare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160609,
					"content": "#{F#Attaccatele}{M#Attaccateli} pure a un paio di massi belli pesanti. La Banda del Salferro deve loro molto, facciamo in modo che non debbano soffrire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160610,
					"content": "Aspetta... Che?!? Tu vuoi farci COSA?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Cara la mia eroina, da come parlavi poco fa, pensavo che avresti capito. Qui a Liyue, siamo molto seri quando si tratta di rispettare un contratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160612,
					"content": "E chi si intromette in affari illegali va messo a tacere. È un genere di contratto che confido conosciate anche voi, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160613,
					"content": "Non esiste nessun contratto del genere! Ripagare la gentilezza con un omicidio è una violazione bella e buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "#Vi prego, la vostra situazione è già abbastanza complicata. Se mi occupassi personalmente di voi, potete stare {F#certe}{M#certi} che patireste un mare di sofferenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160615,
					"content": "Tu non sai chi sono io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "#Chiudi il becco! Dou'er Salferro, Chuan'er Salferro, che state aspettando? {F#Prendetele}{M#Prendeteli}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160618,
					"content": "Capo Ming Salferro... Sei davvero spietato. Una serpe spregevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160619,
					"content": "Se riusciremo a fermare i delinquenti come te dall'insozzare Liyue con le loro malefatte, i nostri sforzi non saranno stati vani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160626,
					"content": "Circondatelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160620,
					"content": "C-Cosa...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160621,
					"content": "Ming Salferro, feccia immonda! Apri bene gli occhi e guardaci attentamente! Chi siamo, secondo te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160622,
					"content": "...M-Milleliti?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160623,
					"content": "Ehi, ehi, fermi tutti! Che porca pupazza sta succedendo, qui?! Perché all'improvviso state...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Credevo foste dei semplici pivellini, non avrei mai pensato di avere a che fare con dei maledetti segugi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160625,
					"content": "Ma non aspettatevi che mi arrenda così! Fatevi sotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ming Salferro"
				},
				{
					"id": 711160616,
					"content": "Oh, no, sto tremando come una foglia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
		{
