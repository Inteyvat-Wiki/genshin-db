			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dou'er Salferro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2083.502,
							359.483,
							2715.594
						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Abbiamo bevuto dalla stessa bottiglia, no? Noi non diciamo \"grazie\" per favori così grandi. Se siete nei pasticci, vi basta urlare e i guai si dilegueranno all'istante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160203,
					"content": "Wow, sei davvero cortese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "#Andrò {F#dritta}{M#dritto} al punto: siamo un po' a corto di pecunia, ultimamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Vi servono Mora? Ahah! Buffo, questo potrebbe rivelarsi una bella gatta da pelare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160206,
					"content": "I nostri Mora? Il grande capo se li è presi tutti. Ci ha lasciati sul lastrico, letteralmente all'asciutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160210,
					"content": "Grande capo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Il nostro leader, il capo della Banda del Salferro. È sceso in fondo alla scogliera laggiù per incontrare un manipolo di gentaglia proveniente da Fontaine. Ci ha lasciati qui a fare le sue veci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160212,
					"content": "Ma avete visto anche voi cos'è capitato, no? Quei ranocchietti di Fontaine si sono intrufolati qui mentre il capo era assente e ci hanno pugnalato lì dove non batte il sole. Ci hanno proprio messo alle strette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160213,
					"content": "Waah... Pugnalato lì dove non batte il sole...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Oh, mamma bella...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Puah, pensano di poterci turlupinare così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160216,
					"content": "#Giacché hanno deciso di spingere fin qui i loro brutti musi, è probabile che anche il nostro capo finirà per farsi raggirare. Che ne dici, {F#sorella}{M#fratello}? Ci darai manforte, vero? Ti daremo i Mora o qualunque altra cosa tu voglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160217,
					"content": "Finché al capo non torceranno un capello, ti possiamo garantire pasti luculliani e una vita da pascià!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160218,
					"content": "Dove si trova lui adesso? Vado a vedere che aria tira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "È su quella spiaggia in fondo alla scogliera. Non puoi sbagliare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160220,
					"content": "Affido a te la faccenda, io ti raggiungo non appena ho finito qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160207,
					"content": "Faccio solo il mio dovere affinché la giustizia trionfi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Quale splendido onore, quale incomparabile virtù! In tal caso, ho delle notizie assai ghiotte da darvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160209,
					"content": "Il nostro grande capo... è possibile che sia nei pasticci anche lui e che abbia bisogno di una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Dou'er Salferro"
				}
			]
		},
