				]
			},
			"dialogs": [
				{
					"id": 711160801,
					"content": "#È valsa davvero la pena venire fin qui! Non solo abbiamo acciuffato il criminale che cercavamo, ma abbiamo anche potuto incontrare {F#la famosa}{M#il famoso} {F#viaggiatrice}{M#viaggiatore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160802,
					"content": "Ci conoscete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "Certo che sì! I miei parenti al Porto di Liyue mi hanno parlato tanto di voi, ho capito subito che eravate voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160804,
					"content": "Ma c'erano troppe orecchie ad ascoltarci e darlo a vedere sarebbe stato troppo rischioso. Scusate tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160805,
					"content": "Allora tutto questo non era davvero un accordo illegale... Era una specie di retata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Esattamente. Era da molto che tenevamo d'occhio quei contrabbandieri, ma siamo riusciti a infiltrarci nelle loro file solo di recente, grazie agli agganci giusti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160807,
					"content": "È passato circa un mese da allora, ma oggi, finalmente, siamo riusciti a catturare in un colpo solo la Banda del Salferro e uno dei più grandi boss della malavita di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160808,
					"content": "#E c'è mancato tanto così che quei criminali di Fontaine ci scoprissero coi loro sporchi trucchetti. È stata una vera fortuna averti con noi, {F#viaggiatrice}{M#viaggiatore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160809,
					"content": "Anche se, purtroppo, temo che dovrete rinunciare al pasto luculliano che vi avevamo promesso. Però, in cambio, possiamo darvi dei Mora. Vi prego di accettarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160810,
					"content": "E sappiate che non potete rifiutare. Vi meritereste ben più di questo, per tutto l'aiuto che date agli altri. È questo il contratto che tutti dovremmo rispettare. Altrimenti, in futuro, saranno sempre meno quelli disposti a dare una mano a chi ne ha bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Dou'er Salferro"
				},
				{
					"id": 711160811,
					"content": "Bene, ora abbiamo le ultime faccende da sbrigare. Non vogliamo trattenervi oltre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Chuan'er Salferro"
				},
				{
					"id": 711160812,
					"content": "#Buona fortuna a {F#entrambe}{M#entrambi}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuan'er Salferro"
				}
			]
		},
