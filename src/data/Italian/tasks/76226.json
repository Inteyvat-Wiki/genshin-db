			"dialogs": [
				{
					"id": 762260201,
					"content": "Eh? Maalaus? Ci sei anche tu? Non ci aspettavamo di incontrarti sulla luna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "È stata Colombina a portarti qui, vero? Ha detto che ti avrebbe portato sulla luna per la tua mostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "A proposito della mostra... dove sono i tuoi dipinti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260205,
					"content": "Cosa c'è? Non li avrai mica... persi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "Com'è possibile? Siamo sulla luna! Nessuno può averli rubati, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260208,
					"content": "A ogni modo, aiutiamo prima Maalaus a cercarli. Forse sono semplicemente qui da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
