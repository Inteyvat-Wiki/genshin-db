			"dialogs": [
				{
					"id": 4270201,
					"content": "Ehi! Qui, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270202,
					"content": "È tutto pronto. Continuiamo con l'esame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270203,
					"content": "Stessa cosa di prima: vola attraverso gli indicatori e raggiungi il traguardo senza fermarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270204,
					"content": "#Sono pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
