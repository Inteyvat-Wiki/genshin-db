			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Sono Otto, membro dei Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "C-Cosa sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Mostrami il tuo brevetto di volo a vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Ah... ehm, il mio brevetto è, ecco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Volare senza brevetto è illegale! Sei in arresto ai sensi del codice penale di Mondstadt, sezione 7, articolo 12.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Hai il diritto di rimanere in silenzio. Tutto quello che dirai volerà per sempre nel vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Aspetta... Sono un'istruttrice, questo è un esame di volo a vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Oh... Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Beh, avete scelto un brutto momento per tenere l'esame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Davvero? Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "#I Cavalieri di Favonius hanno ricevuto una segnalazione da una sorella della cattedrale: sembra aver visto Raptor planare da queste parti. Pensavo che {F#la tua allieva}{M#il tuo allievo} qui fosse su{F#a}{M#o} complice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Raptor? Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Un noto criminale di Mondstadt che usa sempre un aliante per commettere i suoi crimini. È come un uccello rapace, così la gente ha iniziato a chiamarlo \"Raptor\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Wow. Allora deve volare parecchio veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Finora non siamo mai riusciti a catturarlo... Il nostro piano stavolta era attirarlo nella cattedrale con un prezioso manufatto per tendergli un'imboscata, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "...è fuggito insieme al manufatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Fortunatamente, una delle sorelle ha apposto dei marchi segreti sul manufatto usando la magia elementale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "Ma è stato comunque troppo veloce e non siamo riusciti nemmeno a seguire la traccia lasciata dai marchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Beh, se avete bisogno di aiuto per inseguire un criminale volante, faccio proprio al caso vostro! Da che parte è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Per quanto ne so, è stato avvistato l'ultima volta vicino al Villaggio Acquachiara, seppur molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Lascia fare a me! Se io e {NICKNAME} lo inseguiamo insieme, non avrà via di scampo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "D'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Quando avremo preso questo Raptor, ricominceremo da dove avevamo lasciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "Ma non preoccuparti... Parlerò io con Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "#Allora... sono stat{F#a}{M#o} promoss{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Se l'è mangiato il Baron Coniglio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
