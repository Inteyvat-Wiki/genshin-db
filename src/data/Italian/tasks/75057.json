			"dialogs": [
				{
					"id": 750013201,
					"content": "Non posso crederci, ha funzionato davvero. È stata come una scena tratta da una storia o da una canzone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "La cacofonia si placò... e il Chiodo tornò al suo stato originale. La sua gigantesca forma si schiantò al suolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "Uh... Mai avrei pensato che qualcuno potesse riuscirci... Non è un sogno, vero? Esistete davvero? Non siete frutto della mia immaginazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Svegliati, svegliati! Devi risolvere il problema da solo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Ehi, non c'è bisogno di essere così cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#Comunque, Paimon non te lo aveva detto? {NICKNAME} è super forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Eheh, anche tu la pensi così, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#Non hai subito l'influenza dall'Abisso, vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Tranquillo, è solo l'Abisso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Perfino i nostri guerrieri più forti devono restare vigili quando combattono contro l'Abisso. Non sei decisamente una persona comune, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Ahah, chissà, magari la storia che trarrò da questo tema potrebbe perfino superare quelle scritte da Sanhaj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Ehrrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Davvero incredibile, ma chi è Sanhaj?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Ahah, per \"coloro che narrano le storie nelle loro tribù\", Sanhaj dei Maestri del Vento della Notte è degno di venerazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Ahimè, la situazione è urgente. Vi dirò di più su Sanhaj quando avremo più tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Va bene. Dirigiamoci al prossimo Chiodo dell'ombra fluttuante. Voglio risolvere il problema e iniziare a scrivere prima che faccia buio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "Yuhuu! Andiamo, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Per il momento sto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Beh, meno male che ho pensato di venire a controllare dopo aver sentito tutti quei rumori spaventosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Mi dicevo: \"Forza, Titu, probabilmente non è niente\"... E invece è successo qualcosa di incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "#E c'è anche un piccolo Tepetlisauro... Sei stato tu a portare qui {F#queste straniere}{M#questi stranieri}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "#E... siete {F#state}{M#stati} voi a far cadere giù il Chiodo dell'ombra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "...Non dovevamo farlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Eh? Aspetta, abbiamo fatto qualcosa di sbagliato, {NICKNAME}? Se agiamo in fretta, mentre c'è solo un testimone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Ahah, suvvia, non fate così! Non è niente di serio, anzi, direi che ci avete fatto un favore. Quindi tu sei {NICKNAME}? E chi sei tu, invece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#E questo è {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Io mi chiamo Titu, colui che narra le sto{RUBY#[D]narratore}rie nella nostra tribù. Il mio compito è anche quello di \"prendermi cura\" dei pilastri di pietra di questa valle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "E, ovviamente, il Chiodo dell'ombra che avete riconficcato nel terreno, uno di tre Chiodi più piccoli, per la precisione, ed è sotto la mia responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "R-Responsabilità... Oh-oh, sembra ci toccherà pagare gli abitanti del posto per aver fatto cadere quel pilastro di pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Uff, non avremmo dovuto usare i nostri veri nomi, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Pagare... \"A Titu venne in mente un'idea. Forse avrebbe potuto costringere quelle persone ad aiutarlo a raggiungere i suoi scopi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "O almeno, è così che avrei inserito una svolta del genere nella trama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, scusatemi, mi sono fatto trasportare un attimo pensando alle storie. Ho il compito di rac{RUBY#[D]narratore}contare le storie qui nella tribù e, dopo tanti anni, ho bisogno di inventarne di originali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "È da qualche giorno che ci penso e, ovviamente, qualcosa doveva andare storto con il Chiodo dell'ombra... Perché deve piovere sempre sul bagnato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Ahem! Non voglio ricattarvi. V-Voglio dire, fosse stato quello il caso, non lo avrei detto ad alta voce, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Insomma, ci siamo presentati e non è scoppiata alcuna rissa, quindi possiamo considerarci amici, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "In tal caso... potreste ascoltare la richiesta di un amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Certo... basta che non sia richiesto un risarcimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "No, no, certo che no! Mmmh, come posso spiegarvelo? Attraversando la valle, avete visto un blocco di Flogisto solido gigante con incisi sopra dei motivi dorati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "È al centro di questo posto, impossibile da non vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Mi dice qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Tutta questa faccenda ha a che fare con quell'enorme pilastro di pietra. Lo chiamiamo \"Chiodo dell'ombra\"... e ultimamente ci sta dando problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "A dirla tutta, prima di incontrarvi mi ero praticamente arreso. Avevo anche un'idea su come dirlo nella mia storia: \"Non fu possibile salvare i Chiodi dell'ombra e ciò condannò la tribù a una distruzione inesorabile\"... Non era neanche così male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Aspetta, ma è solo un pilastro di pietra. Di sicuro non potrà distruggere una tribù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "E poi cosa c'è di così speciale in questi \"Chiodi dell'ombra\"? E quello che abbiamo fatto cadere era un Chiodo... minore? Altro che minore, a Paimon sembrava bello grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#Mmmh... Dato che siete {F#entrambe delle straniere}{M#entrambi degli stranieri}, immagino che ci sia bisogno di una spiegazione più dettagliata. In realtà è tutto collegato a una leggenda tramandata nella nostra tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "Secondo le storie, la Wayob li utilizzò per sigillare l'ombra del Signore del vulcano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Ma ciò che è sigillato sotto di essi, in realtà, è l'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "La maggior parte dei racconti di Natlan è così. Narrazioni romanzate, piene di retorica e metafore, presentate come avvertimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Aspetta, quindi l'Abisso è davvero sigillato là sotto??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Esatto. E di recente, due dei tre Chiodi dell'ombra minori sono risaliti. Forse, quando lo farà anche il terzo, tutto il male sotto la terra traboccherà come una marea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Quindi, a dirla tutta, ci avete fatto un favore inaspettato a riconficcare a terra quel pilastro. Non c'è bisogno di alcun risarcimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "In realtà, volevo chiederti se potresti rimettere dentro anche l'altro Chiodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Ah... Tu che ne pensi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "...Quando c'è di mezzo l'Abisso, non possiamo restarcene con le mani in mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Anche tu sei d'accordo, {REALNAME[ID(2)|SHOWHOST(true)]}? Va bene, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah, come una fiamma che appare nelle tenebre, così anche gli eroi sorgeranno nei momenti di grande pericolo. Le possibilità umane brillano sempre in momenti come questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Sapete una cosa? Anche questa potrebbe essere una grande storia. {NICKNAME}, hai delle caratteristiche che gli eroi leggendari non hanno. Ammetto di non vedere l'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "#Allora in marcia, {F#care eroine}{M#cari eroi}. Andiamo a controllare l'ultimo Chiodo fluttuante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Forse potrei aiutarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "No, non penso di averlo visto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Uh. Pensavo fosse abbastanza evidente. Ma va bene così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "La colpa è di Paimon. Io sono solo di passaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Ehi! Sei sempre così! Paimon si arrabbierà se non la smetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "Ahah, non preoccupatevi. Anzi, per me è un sollievo. Quindi ti chiami Paimon? E tu, invece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}