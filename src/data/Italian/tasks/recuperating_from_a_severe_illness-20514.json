			"dialogs": [
				{
					"id": 205140301,
					"content": "Hai trovato Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "È in cima a uno dei mulini a vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Uno dei mulini a vento?! Come ha fatto ad arrivare lassù? Chiamo subito i Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Ha detto che tornerà presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "O-Oh, davvero? Beh, l'importante è che stia bene. Mi hai fatto prendere un bello spavento! Temevo fosse rimasta bloccata in cima a quel mulino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Grazie, vado subito a cercarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Svignarsela così ora che si è appena ripresa... Devo proprio dirle due paroline.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
