						205140503
					]
				},
				{
					"id": 205140503,
					"content": "Wow! Come hai fatto ad arrivare quassù? E senza fare alcun rumore, per giunta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140504,
					"content": "E poi, come hai fatto a trovarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Ah, lo so io come. Deve avertelo detto il signor Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Si è sempre preso cura di me e mio fratello, e l'ho salutato quando l'ho incontrato poco fa. Anche lui sembrava sorpreso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Forse dovrei provare a iscrivermi alla Gilda degli avventurieri e diventare una di loro. Potrebbe essere bello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "Cosa? Mio fratello mi sta cercando? Ah, dev'essere passato un po' di tempo, non me n'ero proprio accorta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
					"content": "Ho capito. Lasciami restare qui solo un altro po', tornerò da sola da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
