				"points": []
			},
			"dialogs": [
				{
					"id": 205140201,
					"content": "Sono così in alto! Mio fratello non mi troverà mai, qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140202,
					"content": "E tu che ci fai qui...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "Wow! Come hai fatto ad arrivare quassù? E senza fare alcun rumore, per giunta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "No, aspetta. Come hai fatto a trovarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "Io? Sono appena salita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "Mio fratello mi sta cercando? Ah, dev'essere passato un po' di tempo, non me n'ero accorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "Ho capito. Torno subito da lui. Resto qui solo un altro po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051403,
