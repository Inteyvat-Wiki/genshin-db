						205140603
					]
				},
				{
					"id": 205140603,
					"content": "Uno dei mulini a vento?! Come ha fatto a finire lassù? Vado subito a prenderla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140604
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140604,
					"content": "Cosa? Vuole provare a diventare un'avventuriera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140605
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140605,
					"content": "Ora si sta montando la testa, non si è ancora nemmeno ripresa del tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140606,
					"content": "Non fraintendermi. Quando starà bene, non avrò alcun problema a lasciare che vada a scoprire il mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140607,
					"content": "Grazie, ora vado a cercarla. Svignarsela così ora che si è appena ripresa... Devo proprio dirle due paroline.",
