				{
					"id": 401960301,
					"content": "#Oh, {NICKNAME} e Kinich, siete tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960302,
					"content": "Abbiamo appena visto Chevreuse che portava via quel criminale. Sembrava anche abbastanza compiaciuta, a dirla tutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960303,
					"content": "Beh, è andata meglio del previsto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Hihi, tutta questa fatica e non ha neanche opposto resistenza? In fin dei conti, era bravo solo a darsela a gambe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960306,
					"content": "Oh, a proposito! Wriothesley ha chiesto a Paimon di dirvi che è già tornato al Palais Mermonia per fare rapporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960307,
					"content": "Ha detto che lo Spettro Maréchaussée si sta preparando a indagare a fondo sul giro delle scommesse clandestine. Sembra che ne avranno per un bel po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960308,
					"content": "Comunque sia se ne occuperà il Palais, non è nulla che ci riguardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960309,
					"content": "A giudicare dalla velocità con cui il Duca se l'è filata, direi che sta cercando di non farsi fotografare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960310,
					"content": "*sospira* Ormai ci sono abituata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960311,
					"content": "Ehi, non è da te arrendersi così facilmente, Charlotte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960312,
					"content": "Eheh, non fa niente. Ho già scattato un mucchio di foto fantastiche. Più che abbastanza per la prima pagina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960313,
					"content": "Detto ciò, la reporter indaffarata vi saluta. Queste foto non si sviluppano da sole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960314,
					"content": "Occhio a scegliere gli scatti migliori di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960315,
					"content": "Ah, se n'è già andata... Spero che abbia sentito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960316,
					"content": "È una fotografa professionista, Paimon, fidati del suo giudizio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Hihi, hai ragione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960318,
					"content": "Ma perché ci avete messo così tanto? È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960319,
					"content": "Ajaw ha preso un colpo in testa e ha iniziato a frignare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960321,
					"content": "Sono solo calunnie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960322,
					"content": "Quando mai l'onnipotente Signore dei Draghi K'uhul Ajaw si è messo a frignare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960323,
					"content": "Beh, è capitato spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960329,
					"content": "Comunque... Ora che si fa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "Mmh... In realtà non ho ancora deciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960331,
					"content": "Ma per ora non ho niente di urgente in programma, e in tribunale potrebbero ancora aver bisogno della mia testimonianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "Inoltre, quella pistola è ancora una prova rilevante, probabilmente dovrò aspettare che il caso sia stato risolto prima di poterla riportare a Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Me ne resterò qui a godermi la spiaggia ancora per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
					"content": "Kinich ha preso un colpo in testa e ha iniziato a frignare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Se lo dici tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960326,
					"content": "Ahahah! Povero Kinichino! Non c'era nessuno a consolarlo ed è scoppiato a piangere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960327,
					"content": "Sul serio? Secondo Paimon, è più probabile che sia stato Ajaw a mettersi a piangere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960328,
					"content": "Ehi, brutta piccola...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960304,
					"content": "Il nostro avversario era piuttosto debole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}