			"dialogs": [
				{
					"id": 401960101,
					"content": "Salve, gente! Non siamo in ritardo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "No, arrivate giusto in tempo. Avete riposato bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "Tenersi impegnati aiuta a restare lucidi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Di certo è un ottimo modo per mantenersi carichi d'energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Avete iniziato i preparativi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Ieri abbiamo ricevuto una comunicazione da parte di Monsieur Argenteau, ci ha fornito il luogo e l'ora della transazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Si svolgerà nel pomeriggio, e in un posto che tutti noi conosciamo piuttosto bene: il ristorante di Cinefantasilandia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Eh? Pare proprio che abbia un debole per quel posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Sembra che tu condivida le nostre preoccupazioni, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Esattamente. Catturare qualcuno in un luogo così affollato sarà molto più difficile che in uno spazio aperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Il criminale potrebbe tentare di confondersi tra la folla, o perfino di prendere degli ostaggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Alla luce di ciò, abbiamo dovuto effettuare dei preparativi aggiuntivi. Ieri, appena ricevuta la notizia, abbiamo iniziato a coordinarci con lo Spettro Maréchaussée e la Pattuglia speciale di sicurezza e sorveglianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Mh-mh. Saremo in grado di schierare molti agenti sotto copertura. Se le cose dovessero degenerare, la priorità sarà la sicurezza dei civili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Certo, incrociamo le dita e speriamo che vada tutto liscio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Ho riconosciuto diversi volti noti del caso precedente, come la capitana Chevreuse della Pattuglia speciale, quindi sono ottimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Ci fideremo del suo istinto, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Ah, già, siamo rimasti in contatto anche con Mademoiselle Lépine-Pauline e Mademoiselle Navia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "La Spina di Rosula fornirà supporto a distanza, quindi non c'è nulla da temere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "L'unico problema... potrebbe essere Mademoiselle Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Non vuole servire dei criminali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Vuole presentargli il suo tagliere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Ahah, magari fosse così semplice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Sai, in realtà potrebbe non essere una cattiva idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Ok, basta scherzare. Mademoiselle Escoffier ha messo bene in chiaro che non vuole che il suo locale subisca delle perdite come conseguenza di questa operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Ma, ehm... Beh, suppongo che le cose potrebbero non andare lisce come spera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Posso essere d'aiuto in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "In tutta onestà, non avremmo dovuto coinvolgerti in questa storia. Ti abbiamo già causato un sacco di problemi, ora spetta alle autorità di Fontaine occuparsi del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Ma immagino che tu voglia comunque sapere come andrà a finire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Decisamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "#Allora, sentiti {F#libera}{M#libero} di recarti sulla scena, ma presta attenzione e agisci seguendo il buon senso. Non dovrai necessariamente intervenire, a meno che la situazione non degeneri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Farò del mio meglio perché non si arrivi a quel punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Ci sarai anche tu, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Ci sono ancora molte domande senza una risposta, ma finora tutte le nostre informazioni indicano che il colpevole è di Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Inoltre, sono anche un testimone; non posso andarmene proprio adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Hihi, questo è il Kinich che ci piace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Il gruppo continua a discutere sui dettagli dell'operazione e sui rischi da evitare.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Bene, credo che abbiamo parlato abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "L'operazione è prevista nel pomeriggio. Se ci sbrighiamo, avremo persino il tempo di sorseggiare qualche tazza di tè prima di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "Oh, e prendiamo anche qualcosa da mangiare! Non si può lavorare a stomaco vuoto, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Ma tu sarai lì solo per guardare, no...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Ehi, anche fare il tifo è un lavoro importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Bene, io andrò subito al luogo dell'incontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ajaw è giorni che mi assilla perché vuole provare un piatto in offerta esclusivo dell'evento. Meglio accontentarlo subito, così da farlo tacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "A presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Non vedo l'ora di sapere come andrà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
