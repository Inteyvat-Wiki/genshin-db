			"dialogs": [
				{
					"id": 401960201,
					"content": "Questa spiaggia sembra sempre più vivace ogni giorno che passa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(In gran parte è dovuto agli agenti sotto copertura.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "Ahem! Paimon ha un po' di famina... Andiamo a dare un'occhiata al menù del ristorante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(Il tizio con la cassa... Dev'essere lui.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "(Bene, la faccenda si fa seria.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Ma che maniere! Non puoi trascinare via la gente in questo modo! Non c'è più alcun rispetto per la vita umana... Ti porterò in tribunale per questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "Ah, davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "Credo di averti fatto un favore ad allontanarti dal \"pubblico\". Ti ho salvato la faccia, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Se poi ora vuoi nasconderla o meno... Beh, questo dipende da te, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "Razza di...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "E va bene, lo ammetto... Ero nel torto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "*sospira* Certo che so distinguere il bene dal male. Ma non ho avuto altra scelta... Avevo disperato bisogno di quei soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "Ero un esperto di reliquie antiche... Avevo una carriera di successo e una famiglia felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "Ma mio figlio... Se solo avessi saputo che si sarebbe unito a quella gentaglia e che avrebbe contratto tutti quei debiti! Avevamo dei risparmi, ma li ha prosciugati tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Per via dei suoi debiti, i creditori venivano spesso a casa nostra per minacciarlo... In quanto suo padre, come avrei potuto lasciare che soffrisse così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "*sospira* Mio figlio ha più o meno la tua età! Se solo fosse cresciuto come te... Questa è l'unica ragione per cui avevo bisogno di quei soldi, devi credermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "Tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Per favore, giovanotto, aiutami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Sei di Natlan anche tu, vero? Ti prego, risparmiami, in nome delle nostre origini comuni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Posso ancora riportare mio figlio sulla retta via, se torno a casa. Ma se finisco in prigione, lui sarà spacciato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "Non è forse a questo che servono le famiglie? A lottare insieme per un futuro migliore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "Il nostro destino è nelle tue mani, giovanotto. Per piacere, abbi pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Ahah, qualcosa non va, Kinich? Non ti sarai mica ammorbidito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960228,
					"content": "Umpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "Non credo a una sola parola di quello che hai detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Wriothesley è arrivato alla conclusione che sei un giocatore d'azzardo puro e semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "Un giocatore d'azzardo? Io? Te l'ho detto, è... è mio figlio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "Tanto per cominciare... Sei davvero di Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Stavi seguendo le tracce della pistola, avresti dovuto riconoscere facilmente un volto familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "E poi, il modo in cui hai minacciato di \"portarmi in tribunale\"... Sembri conoscere piuttosto bene le usanze di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "Eh? Che razza di logica sarebbe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "P-Posso spiegare! A dire il vero sono cresciuto a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "Tsk, non voglio sentire altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Ajaw, è la tua occasione. Per una volta, fai tacere qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "Ahahah, non aspettavamo altro che Ce lo dicessi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960240,
					"content": "Prendi questo, vecchio scimunito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960241,
					"content": "Essere un bugiardo compulsivo è uno dei segni distintivi di un giocatore d'azzardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Scommetto che sei un fontainiano che finge di essere di Natlan, e che i parenti o gli amici di cui parli, sempre che esistano, hanno tagliato i ponti con te da diverso tempo per via delle tue abitudini deprecabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Ovviamente, potrei sbagliarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "Ma cambierebbe qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Sono qui solo per arrestarti. Se stai cercando un avvocato o una spalla su cui piangere, temo di non poterti aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "E poi, tirarti fuori la verità è esattamente il lavoro del tuo beneamato tribunale. Non ho forse ragione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "È passato un po' di tempo, Monsieur Kinich. La Pattuglia speciale preleverà questo criminale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "Dovrei essere io a ringraziare lei per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "E a Noi? A Noi niente?! Umpf, che maleducazione! Non dovresti inchinarti e rendere grazie all'onnipotente Signore dei Draghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960252,
					"content": "Molto bene, allora... Grazie a te e a Cacucu per le vostre spettacolari performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "Ehi, in che senso?! Un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960254,
					"content": "Stai bene, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "Non preoccuparti, sto bene. Non sono io quello che è stato trascinato fino a qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Mi sei sembrato un po' turbato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Pfft... Kinichino, non starai pensando ai tempi in cui eri solo \"un frugoletto piccino picciò\", vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960258,
					"content": "Ora non cominciare a frignare come un moccioso! Se qualcuno ci vede, penserà che l'onnipotente Signore dei Draghi ha un servitore patetico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960259,
					"content": "Cosa stai blaterando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Ajaw cattivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "Non ha senso tenertelo nascosto. Parlando sinceramente, non sopporto i giocatori d'azzardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "Sono gli individui più irresponsabili del mondo... Non hanno alcun rispetto per chi si guadagna il pane lavorando sodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "Venderebbero la propria madre pur di guadagnare qualche Mora, e s'illudono di poter diventare ricchi scommettendo al gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Ma tutti sappiamo che, quando si ottiene qualcosa senza sforzi e fatica, si finisce quasi sempre per pagare un prezzo molto più alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "Anch'io in passato ho dovuto pagare un prezzo per i debiti di gioco di mio padre. Non voglio che altri finiscano nella stessa situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "Non dispiacerti per me. Non lo faccio nemmeno io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "Dicono che le persone vengano plasmate dal loro passato. E, visto che sono arrivato fin qui... significa che ho fatto qualcosa di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Non dovremmo mai punire noi stessi per gli errori commessi dagli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Al contrario, preferisco ricordare i momenti che mi hanno aiutato a crescere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Come la prima volta che ho imparato a usare il rampino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "O quando ho iniziato a bramare la conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Certo, ti credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Muoviamoci. Se non ci vedono, inizieranno a preoccuparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		},
