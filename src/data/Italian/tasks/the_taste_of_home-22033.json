					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Mmmh, questo sapore... Beh, non mi sembra un piatto di Liyue o di Inazuma. Non l'avevo mai assaggiato prima d'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330402,
					"content": "Anche se non è la cucina che sognavo, sono già contenta di aver potuto gustare un piatto nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330403,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Ti prego, accetta questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203305",
