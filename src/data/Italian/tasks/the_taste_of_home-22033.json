				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "Eh? Credo che questo sia un piatto di Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330502,
					"content": "Non penso sia il piatto che ti avevo chiesto... Beh, non importa, anche questo sazia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330503,
					"content": "#Ti ringrazio comunque, viaggiat{F#rice}{M#ore}. Tieni, per sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203306,
			"completionStepIds": [
				2203306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
