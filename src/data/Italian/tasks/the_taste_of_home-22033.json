					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "Mmmh? Perché questo piatto ha un sapore... così... così interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Non interessante... Uhm, direi più... unico, o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "#Come sei riuscit{F#a}{M#o} a inventarti un piatto simile? La tua abilità in cucina è davvero... di un altro mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "#Grazie per esserti impegnat{F#a}{M#o} tanto! Viaggiat{F#rice}{M#ore}, prendi. Io, mmmh, mi gusterò questo piatto più tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
