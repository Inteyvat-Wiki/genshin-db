					"speakerTitle": "Vahid"
				},
				{
					"id": 220360408,
					"content": "Potresti ripetermi l'intero processo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360409
					]
				},
				{
					"id": 220360409,
					"content": "Prima si aggiungono delle <color=#37FFFF>foglie in polvere</color> al fertilizzante, poi dell'<color=#37FFFF>acqua</color>. Dopodiché, <color=#37FFFF>si mescola bene</color> il preparato e infine lo si sparge sul terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360410
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360410,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}... Diamo tutti il massimo. Con un po' di fortuna, riusciremo a fare buoni affari questo mese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
