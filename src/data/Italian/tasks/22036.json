			},
			"dialogs": [
				{
					"id": 220360501,
					"content": "#Giovinastr{F#e}{M#i}, ci incontriamo di nuovo. Cosa desiderate sapere, questa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360502,
					"content": "Non ho domande da fare, oggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Oh, ti manda Vahid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Ho sentito che c'era un nuovo negozio di fertilizzanti a Ritou, così sono andato a trovare il sig. Vahid per provare il suo prodotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Se funziona e aumenta la produzione, potrebbe esserci speranza per il Villaggio di Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "Eh, immagino tocchi ancora a un vecchiardo come me rimettere in sesto il villaggio. Ah, quei giovinastri... Umpf! Inutile farci affidamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Bene, allora dimmi. Come dovrei usare questo fertilizzante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Prima aggiungi dell'acqua, poi delle foglie in polvere e poi mescoli il tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Che procedura complessa, per un fertilizzante... E va bene, ho capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Prima aggiungi delle foglie in polvere, poi mescoli tutto e infine aggiungi dell'acqua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360511,
					"content": "Prima aggiungi delle foglie in polvere, poi dell'acqua e poi mescoli tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360503,
					"content": "Sono qui per spiegarti come usare il fertilizzante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				}
			]
		},
