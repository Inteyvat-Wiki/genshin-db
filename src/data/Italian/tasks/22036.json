				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "Bene, dimmi come si usa il fertilizzante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Oh, giusto, non te l'ho ancora detto. Il fertilizzante che porterai con te va usato in modo specifico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Dunque, fammi vedere... Stando al manuale, l'ordine dovrebbe essere questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Prima si aggiunge dell'<color=#37FFFF>acqua</color> al fertilizzante, poi delle <color=#37FFFF>foglie in polvere</color>. Dopodiché, <color=#37FFFF>si mescola bene</color> il preparato e lo si sparge sul terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Non sbagliare l'ordine, o potresti causare problemi e influenzare l'impressione che i clienti hanno di noi. C'è in gioco il futuro della nostra attività...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Me lo ricordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Allora conto su di te. Quando avrai consegnato la Benedizione di Anahita al cliente, potrai tenerti il suo primo pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Potresti ripetermi l'intero processo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Prima si aggiunge dell'<color=#37FFFF>acqua</color> al fertilizzante, poi delle <color=#37FFFF>foglie in polvere</color>. Dopodiché, <color=#37FFFF>si mescola bene</color> il preparato e lo si sparge sul terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}... Diamo tutti il massimo. Con un po' di fortuna, riusciremo a fare buoni affari questo mese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
