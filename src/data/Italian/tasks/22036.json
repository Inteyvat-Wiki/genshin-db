			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Questo settore è così difficile. Tutte le mie merci sono autentiche e di qualità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Ma perché nessuno qui vuole comprare nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "#Oh, sei tu, viaggiat{F#rice}{M#ore}. *sospira* Lascia stare. Ancora non riesco a vendere il mio fertilizzante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Non c'è anche Alrani ad aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Mi ha aiutato un po'. Il problema è che nessuno di noi sa come promuovere queste merci. Possiamo solo attendere che arrivino dei clienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "E sai com'è la situazione a Ritou. Nessuno compra nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Così ho fatto visita ai gentili signori della gilda dei mercanti per chiedere aiuto, e ci hanno consigliato di fare una cosa chiamata commercializzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "In parole povere, vogliono che parliamo di più ai clienti degli effetti del fertilizzante e della teoria che c'è dietro. Dovremmo anche fare più promozioni basate sui dati e offrire un servizio di prova gratuita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Ma... sono cose complicate e io non mi ci raccapezzo. Non sono stato io a creare questo fertilizzante, come faccio a spiegare come funziona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "In ogni caso, anche se si tratta solo di ripetere le istruzioni, credo che dovrò comunque andare in giro a promuoverlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "#Alrani è già uscita a promuovere la nostra merce, e più tardi farò lo stesso anch'io. Viaggiat{F#rice}{M#ore}, ti va di darci una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "#Perfetto! Contiamo su di te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Il luogo in cui dovrai recarti tu si chiama Villaggio di Konda. Non è distante da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "C'è un gentiluomo chiamato Konda Densuke che ha mostrato un certo interesse per il nostro fertilizzante. È anche entrato in negozio a parlare con me poco fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Se tu andassi a casa sua per promuovere alcuni dei nostri prodotti e gli offrissi una prova gratuita, magari acquisterebbe del fertilizzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Dov'è andata Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Ha detto che doveva raccogliere dei materiali e che sarebbe andata piuttosto lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Il luogo in cui dovrai recarti tu si chiama Villaggio di Konda. Non è distante da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
				2203608
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
