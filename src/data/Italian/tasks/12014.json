			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Penso che starò qui ancora un po'. Lo spettacolo nel mio cuore non si è ancora concluso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Oh, ma per due chiacchiere, sono a disposizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Cosa vuoi fare dopo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka e gli altri mi stanno ancora aspettando, quindi possiamo dare la caccia al Grande Youkai Mujina. Sono come una sorella maggiore per loro, quindi non posso rimangiarmi la parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Inoltre, voglio andare a chiedere a tutti cosa ne pensano dei fuochi d'artificio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "E nei prossimi giorni, vorrei anche ringraziare tutti per il loro supporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Ciò include anche te e Paimon, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "I fuochi d'artificio sono costosi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Per voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Sono gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Dopotutto, non vi ho lasciato molta scelta. Per non parlare del fatto che vi ho trascinato con me e vi ho creato un sacco di problemi lungo la strada. Eheh, mi sentirei in colpa se vi facessi pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Sei sicura? Mi sento in colpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#È giusto così... Ma possiamo fare un accordo: Dopo aver trovato tu{F#o}{M#a} {F#fratello}{M#sorella}, di{F#gli}{M#lle} che può rivolgersi ai Naganohara se ha bisogno di fuochi d'artificio. In questo modo, avrò un nuovo cliente. Va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "#E poi, mi piacerebbe conoscerl{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "E se la Commissione Tenryou vi causasse altri problemi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Li prenderò di nuovo a calci nel sedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Ahahah, sto scherzando. Non vi ho detto forse che la mia famiglia ha a che fare con le Commissioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Per noi è tutto più semplice. Nel peggiore dei casi, dovremmo scusarci, sorridere e pagare una multa. Non sarebbe la fine del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "#Voi due dovreste fare attenzione, però. Senza avere le mie conoscenze, non potete permettervi di essere sconsiderat{F#e}{M#i} come me, ihih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}