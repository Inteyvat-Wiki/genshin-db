				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031201,
					"content": "Com'è andata? Hai recitato le mie poesie agli Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031202,
					"content": "Sì, l'ho fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "Allora, come l'hanno presa? Dall'aspetto mi sembra di capire che... ehm, non è andata così bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "C'è stato un problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Hai seguito i miei appunti come ti ho detto? O anche quelli erano sbagliati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Mi... dispiace. A quanto pare non sono così esperta come pensavo... Sembra che dovrò studiare ancora più intensamente. Grazie comunque dell'aiuto, prendi questo per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "Devo risolvere questo problema... Non posso disonorare il nome della famiglia Musk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
