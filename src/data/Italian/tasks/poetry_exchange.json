				{
					"id": 201031102,
					"content": "Sì, l'ho fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "Allora, come l'hanno presa? Dall'aspetto mi sembra di capire... che è andata bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "È andata molto bene!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Allora, la mia comprensione del vocabolario era corretta, dopotutto. Ottima notizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Un altro passo avanti nel campo degli studi hilichurliani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Un giorno, riuscirò a parlare liberamente con gli Hilichurl, e ne ascolterò tutti i segreti direttamente dalla loro bocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "Potrò finalmente dire di essere all'altezza del nome della famiglia Musk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Oh, ma prima di tutto ciò... questo è per te. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
