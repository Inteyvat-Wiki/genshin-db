					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "Chissà se agli Hilichurl piaceranno le mie poesie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Cosa ti ha ispirato a comporre poesie in hilichurliano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "A essere sincera, è perché voglio migliorare le mie abilità linguistiche. Ci sono certe regole grammaticali, strutture sintattiche, collocazioni lessicali e cose simili che non ho ancora afferrato del tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Mi sono impegnata tantissimo per scrivere questi versi, ma chissà... potrebbero ancora sembrare goffi e innaturali a un madrelingua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Alle volte, una singola scelta lessicale crea la connotazione sbagliata e finisce per cambiare il senso di tutta la frase... C'è solo un modo per apprendere le sfumature minime, e cioè parlare con un vero Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "La maggior parte delle persone trova intollerabile l'idea di imparare l'hilichurliano direttamente dagli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Ma non io. Se voglio davvero diventare esperta di hilichurliano e capire la cultura del loro popolo, è una cosa che devo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "E qual è il modo più adeguato per comunicare con gli Hilichurl di Mondstadt, se non attraverso la poesia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Cosa sono questi commenti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "Oh, quelli alla fine? Già... Tutti i vocaboli presenti in queste poesie sono certa di averli già visti in altri testi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "E, per ogni parola, ho fatto del mio meglio per basarmi sul contesto d'uso originale, mentre mettevo insieme le frasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "...Ma le lingue sono complesse. A volte, persino la parola che sembra più innocente può cambiare significato quando è usata in un contesto specifico, andando a influenzare anche il senso dell'intera frase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Comunque, questi sono i versi di cui sono più sicura in termini di comprensione. Relativamente parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Ho qui altri versi che ancora non so come tradurre in lingua comune, anche se li ho scritti io... Quelli te li risparmio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Mi sembra che tu abbia già le idee più o meno chiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Sì, beh... \"più o meno\" è ancora molto lontano dal \"completamente\". E anche se sono decisa a ottenere un'interazione amichevole con gli Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "...Dubito che mi concederanno l'occasione di spiegarmi, se qualcosa non viene percepita nel senso che intendevo. È più probabile che mi si rivoltino contro e che mi riducano a pezzettini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Ed è qui che entri in gioco tu! A te andrà tutto bene, lo so! Segui i miei appunti e, quasi sicuramente, non avrai alcun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Quasi sicuramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
