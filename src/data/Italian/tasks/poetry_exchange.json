			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Che bello rivederti! Ti ricordi di me, vero? Di sicuro, almeno ricorderai il nostro tentativo di amicizia con gli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Non guardarmi così... Apprendere una lingua richiede questo e altro. Bisogna esercitarsi, esercitarsi ed esercitarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Non temere, i tuoi sforzi non sono stati vani! Il mio hilichurliano parlato ha fatto grossi passi avanti da quel giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Ma ho anche dovuto esercitare il mio hilichurliano scritto. Perciò, dopo un intenso periodo di ricerca, ho composto una serie di poesie originali in hilichurliano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Detto questo, ci sono ancora dei versi di cui non sono sicura. Devo controllarne il significato... Potresti andare a sperimentarli per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "...\"Sperimentarli\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Sai, tipo... leggerli a voce alta a un Hilichurl e vedere come reagisce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Non preoccuparti! Ho <color=#00E1FFFF>evidenziato</color> i versi di cui non sono sicura del significato. E comunque, sono certa di non aver sbagliato più di tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Ho già un luogo in mente. Gli Hilichurl che vi risiedono sono più amichevoli degli altri. Leggi solo i singoli versi che vorrei verificare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Grazie dell'aiuto! Torna qui non appena avrai letto la poesia, voglio sapere ogni cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "Leggere agli Hilichurl, di nuovo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Esatto! Hai già esperienza, ormai. E non preoccuparti, ho <color=#00E1FFFF>evidenziato</color> i versi di cui non sono sicura del significato. Sono certa di non aver sbagliato più di tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Ho già un luogo in mente. Gli Hilichurl che vi risiedono sono più amichevoli degli altri. Leggi solo i singoli versi che vorrei verificare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Grazie dell'aiuto! Torna qui non appena avrai letto la poesia, voglio sapere ogni cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "E, ehm... se poi non va come sperato, di sicuro non avrai problemi a risolvere la situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
