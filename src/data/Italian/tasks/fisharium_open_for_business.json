			},
			"dialogs": [
				{
					"id": 747020101,
					"content": "Ah, ultimamente avete portato un gran numero di pesci, l'acquario sta iniziando a sembrare un vero habitat oceanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020102,
					"content": "#Hihihi, siamo praticamente già {F#delle}{M#degli} acchiappapesci {F#provette}{M#provetti}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "#Sembrate essere molto {F#orgogliose}{M#orgogliosi} del vostro lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020104,
					"content": "Certo che sì! Ma oltre alla soddisfazione, c'è qualcos'altro... qualcosa come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Il rimpianto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Sì, esatto! È esattamente ciò che sente Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "E per quale motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020109,
					"content": "Paimon non ne è sicura... Ma ha l'impressione che manchi qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Tipo un ristorante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Ehi! Non dire cose del genere! Con che coraggio mangeresti dei pesciolini così belli?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Ci mancano dei visitatori che vengano ad ammirare il nostro fantastico lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Stai forse dicendo che... vuoi aprire l'acquario al pubblico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020116,
					"content": "Sarebbe un problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Temi che ci sarebbe troppo chiasso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Se è così, pensiamo a tutto noi! Ci occuperemo della pubblicità e di tutte le faccende quotidiane, così tu potrai concentrarti sul tuo lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Se è questo che volete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020121,
					"content": "Possiamo dividere i guadagni: trenta e settanta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Eh...? A noi solo il settanta per cento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "No, il settanta va a Sandrone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Oh, giusto, certo... Dopotutto, è stata Sandrone a noleggiare questa nave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Uff, così mi fate sembrare una specie di proprietaria dispotica. Siete voi ad aver fatto tutto il lavoro, quindi vi spetta la fetta più grande. Non sono mica Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020126,
					"content": "Vuoi dire che... l'acquario può aprire al pubblico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Certo, avete il mio benestare. Fate solo in modo che non interferisca con le mie ricerche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020128,
					"content": "Evvai! L'Acquario Wingalet Glub-Glub apre ufficialmente i battenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*sospira* Dovevo aspettarmi che avessi già pensato a un nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747020118,
					"content": "Temi che causerebbe troppi guai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Tipo dei visitatori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Ah! Sì, esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "La solitudine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}