			"dialogs": [
				{
					"id": 761910201,
					"content": "Te l'ho detto più di una volta: tieni gli occhi aperti. Questa è merce pregiata, richiesta personalmente da clienti abituali di Snezhnograd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "E tu te la sei lasciata sfuggire così? Ma che ti è preso? Ti è spuntata all'improvviso una coscienza o cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Capo, ascolti, non è colpa mia. Quegli Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Hilichurl? Sarebbe questa la tua scusa? Se continui così, rovinerai la nostra reputazione di Cacciatori di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Non ce l'ho fatta, capo. Davvero non ce l'ho fatta! Quello blu e il suo amico verde... Picchiavano più forte di quegli Agenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Quei due... sono sicuramente dei contrabbandieri.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "...Chi è là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Calma, Lumi! Non ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Questo cos'è? Mmm... Piuttosto raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Riesci a gestire una ragazzina, vero? Questo dovrebbe compensare ciò che abbiamo perso. Prendilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Sì, capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Adesso ve la prendete pure con Lumi? Non c'è da stupirsi che la reputazione dei Cacciatori di tesori sia andata in malora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "\"Reputazione\"? I Cacciatori di tesori ora ne hanno... una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Smettila di sprecare il fiato con lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
