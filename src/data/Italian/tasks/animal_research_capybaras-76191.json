			"dialogs": [
				{
					"id": 761910301,
					"content": "È davvero un capibara argentato: niente tintura, nessun gioco di luce. È straordinariamente raro... Assolutamente sbalorditivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Ho cercato in tutta Natlan senza mai riuscire a trovarne uno. Ecco dov'era finito, catturato proprio da dei contrabbandieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Ma non sembra ferito... Eheh, un capibara argentato! Non avrei mai immaginato di poterne vedere uno con i miei occhi! Voglio solo... Eh, toccarlo un attimo, per vedere se al tatto è diverso dagli altri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Ahia! Scotta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capibara"
				},
				{
					"id": 761910306,
					"content": "Ah, l'avevo quasi dimenticato! Sei ancora nella pentola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Forse ti sei abituato al Flogisto liquido di Natlan, quindi questa temperatura non ti turba più di tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Comunque, per ora vieni con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capibara"
				}
			]
		},
