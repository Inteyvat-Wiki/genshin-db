				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Ahah! Grazie, {F#avventuriera}{M#avventuriere} dai capelli dorati! Sei {F#la mia eroina}{M#il mio eroe}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "L'ispirazione inizia già a ribollirmi nella testa, come i venti del Covo di Terrore alato, il miasma della Vallata Chenyu e i tuoni sull'Isola di Seirai... Sento che sta per esplodere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Sembra molto pericoloso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Eheh, aspetta e vedrai! Sto prendendo appunti per tutte le mie idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Le poesie pretenziose di Linus non hanno vita lunga. Quando avrò completato il mio capolavoro, nelle taverne di tutta Teyvat risuonerà il mio nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082806,
			"completionStepIds": [],
