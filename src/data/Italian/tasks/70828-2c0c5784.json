				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(Consegna \"Il sogno di Rhonabouillet\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Oh, una raccolta di poesie di Fontaine! Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Torna nel passato... alla corte del cavaliere di Loch... e si innamora a prima vista di una cameriera...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Pfff! Che risate! Hai la possibilità di tornare indietro nel tempo, e la prima cosa che ti viene in mente è inseguire una storia d'amore con qualcuno dell'età dei tuoi antenati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Oh, ecco qual è il punto. È una poesia d'amore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Hah, ora capisco. L'amore fa davvero perdere la testa alle persone. Comunque, lo comprerò e lo leggerò per bene più tardi. Grazie, {F#avventuriera}{M#avventuriere} dai capelli dorati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
