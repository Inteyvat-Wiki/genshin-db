			"dialogs": [
				{
					"id": 708280601,
					"content": "#Ah, {F#avventuriera}{M#avventuriere} dai capelli dorati! Hai portato qualche poesia d'amore degna d'ispirare il mio genio?",
					"roleType": "TALK_ROLE_NPC",
