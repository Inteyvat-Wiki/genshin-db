	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#Ah! Scusa! Tu, {F#avventuriera}{M#avventuriere} dai capelli dorati! Aspetta un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Hai bisogno di aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Oh, no, niente del genere! Volevo solo chiedere se per caso hai una raccolta di poesie d'amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Ascolta: io sono un bardo incredibile, forse il più incredibile di tutta Mondstadt dopo il Supremo Barbatos in persona! Sul serio, sono fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Ma c'è quel Linus... Quel bardo fastidioso non vuole mai ammettere che sono più brava di lui! Salta fuori in continuazione e inizia a declamarmi poesie senza sosta! Comunque la si guardi, è ovvio che sta cercando di superarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "E la cosa peggiore è che ogni sua poesia parla d'amore e di romanticismo... Argomenti che io non ho mai nemmeno sfiorato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Perciò devo prendere in mano la situazione: scriverò una poesia d'amore così epica che Mondstadt se la ricorderà per sempre! Gli farò vedere cos'è il vero talento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Certo... avendo dedicato tutto il mio tempo alla ricerca della vera grande arte, non ho ancora avuto l'occasione di sperimentare l'amore in prima persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Quindi, se per caso hai una raccolta di poesie sull'amore, ti prego di vendermela! Mi basterà sfogliarla un po' e l'ispirazione comincerà a scorrere a fiumi. Con un talento come il mio, è praticamente inevitabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Temo di non poterti aiutare, ho degli altri impegni. Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "No, no! Non intendevo chiederti aiuto. Dopotutto, se tutti chiedessero aiuto a uno sconosciuto ogni volta che qualcosa va storto, nessuno oserebbe più viaggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Ahem! Volevo solo chiederti se per caso hai un libro di poesie d'amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
