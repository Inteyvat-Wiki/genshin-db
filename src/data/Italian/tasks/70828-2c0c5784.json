					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(Consegna \"Il canto di Ay-Khanoum\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Cribbio, che bel libro! Bene, vediamo cosa dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"...Nessun trono si erge senza serpi al di sotto, nessuna rosa fiorisce priva di spine. Bevi fino all'ultima goccia d'amarezza, Ferigees, e coi tuoi dolci occhi, promettimi... promettimi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Uh... aspetta, come si pronuncia questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#Sì, è decisamente troppo profondo per me! Mi si annoda già la lingua! Lo porterò a casa e lo leggerò con calma più tardi... Grazie, {F#avventuriera}{M#avventuriere} dai capelli dorati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Consegna \"Rivelazioni d'amore divino\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Ah! Il titolo non mi è nuovo. È una raccolta poetica della Chiesa di Favonius, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Vediamo un po'... \"La sua anima è un campo in fiamme, che riversa nel vento il suo ardente canto. Tra le stelle, la luna e il sole splendente, finanche la mia luce brucia al suo bagliore...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Che razza di poesia è mai questa? A dirla tutta, ha un che d'inquietante... e la Chiesa di Favonius chiaramente non ne sa molto di poesia. Insomma, stelle, luna e sole che compaiono tutti insieme? Pfui, bubbole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "#Beh, questo risolve tutto! Ho ritrovato la mia sicurezza. Se questo è il livello poetico di questo libro, persino io potrei fare di meglio. Lo compro. Grazie, {F#avventuriera}{M#avventuriere} dai capelli dorati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
			"completionStepIds": [
				7082804
