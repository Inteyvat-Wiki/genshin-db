					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280701,
					"content": "(Consegna \"Brezza nella foresta\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Ahah, \"Brezza nella foresta\"? Andiamo, sono un bardo brillante. Pensi che non lo conosca? L'ho letto da cima a fondo più volte di quante possa contarne! Non hai qualcosa di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
