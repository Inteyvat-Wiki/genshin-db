			"dialogs": [
				{
					"id": 751080101,
					"content": "Abbiamo detto che avremmo cucinato, ma cosa dovremmo preparare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Mmmh... Paimon ricorda che davamo del pesce a Goffobacca, giusto? In tal caso, un piatto a base di pesce dovrebbe andare bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Paimon vuole che la Blobbofoca e {REALNAME[ID(2)|SHOWHOST(true)]} mangino bene... Pensa che la specialità di Natlan, il pesce alla griglia in salsa alla menta, sia una buona scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Ah, è praticamente la mia specialità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Va bene, allora cominciamo. E Paimon sarà qui per darti qualche consiglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Fai delle incisioni più profonde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Certo, più profonda è l'incisione, più sapore assorbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Un po' più di sale, un po' più di gioia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Mmm, che sapore ricco. Paimon è sicura che a {REALNAME[ID(2)|SHOWHOST(true)]} e alla Blobbofoca piacerà un sacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "La salsa alla menta. Più se ne mette, meglio è.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Eheh, quel sapore così fresco e rinfrescante sarà davvero fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Non può mancare il peperoncino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "La quantità giusta di piccante, abbastanza da risvegliare l'appetito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Cotto alla griglia su fiamma alta: croccante fuori e tenero dentro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Hihi, sembra così delizioso che a Paimon sta venendo l'acquolina in bocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Dopo un magnifico processo culinario, il pesce speciale che hai grigliato per {REALNAME[ID(2)|SHOWHOST(true)]} e la Blobbofoca è pronto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Arrostito a fuoco lento, tenero e succulento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Wow, fantastico! È il pesce alla griglia segreto di {NICKNAME}... Forse un giorno diventerà una delle tue specialità e la preparerai per gli altri nostri amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Gli animali di Fontaine potrebbero essere allergici al cibo piccante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Ma senza peperoncino, sembra che manchi qualcosa. Perché non aggiungerne un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Una creatura acquatica come la Blobbofoca non avrà paura della menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Paimon non crede che funzioni così. Una Blobbofoca che arriva sulla terraferma la troverà sicuramente calda e asciutta, quindi aggiungere un po' di salsa alla menta dovrebbe aiutarla a rinfrescarsi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Il sapore è fantastico. Non c'è bisogno di aggiungere sale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Esatto. Ci sono altri condimenti, quindi non è necessario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Fai delle incisioni più superficiali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "Non male. Dovrebbe mantenere il sapore leggero, ma anche quello del pesce originale... la Blobbofoca sicuramente lo apprezzerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Non è la mia specialità, ma nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
