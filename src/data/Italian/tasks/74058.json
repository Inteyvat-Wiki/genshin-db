			"dialogs": [
				{
					"id": 740580201,
					"content": "#Woah, ne avete trovato tantissimo... Siete stat{F#e}{M#i} di enorme aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Ho già mandato il minerale alla bottega, ma non ho ancora ricevuto il mio campione di prodotto. Potrebbe essere perché gli artigiani non hanno familiarità con gemme come questa e hanno avuto dei problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Ma non vi preoccupate! Confido nel mio giudizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Sto pianificando di farne degli accessori che diventeranno senza dubbio l'ultima moda di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "La prossima volta che verrete vedrete il prodotto finale! Vi darò dei campioni in regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "O magari... potreste vedere il più modaiolo dei nobili indossarlo prima ancora che arriviate, ahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "#Bene, quando volete tornare, siete sempre {F#le benvenute}{M#i benvenuti}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
		},
