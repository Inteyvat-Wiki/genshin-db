			"dialogs": [
				{
					"id": 740580101,
					"content": "#Puca, siamo tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME}, Paimon! Siete qui per giocare con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Ehm, a dire il vero no! Ci hai detto che potevamo chiederti qualsiasi cosa legata ai giacimenti minerali e alle gemme, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Esatto! Ho raccolto tutte le pietre belle nell'area circostante. Cosa volete sapere esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "Riguarda quella pietra che abbiamo trovato la volta scorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Racconti a Puca di come avete venduto lo strano minerale al mercante di gemme...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Eh? La persone di fuori pensano davvero che sia una gemma preziosa? Ma l'ho perfino fatta vedere a mia sorella... Gli umani sono veramente difficili da capire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Ma conosco un sacco di posti con delle pietre come questa! Se volete, vi mostro dove sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca segna le posizioni dello strano minerale sulla mappa.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Fantastico! Grazie, Puca! Oh, a proposito, questi sono i Mora che Chesil ci ha pagato in anticipo. Potremmo dartene metà, sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Oh, va bene così. Non abbiamo bisogno di niente del genere nel villaggio, comunque... per non parlare di quanto anche voi mi abbiate aiutata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
