					"id": 740580401,
					"content": "#Benvenut{F#e}{M#i}... Oh, ehi, siete voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580402,
					"content": "Avete il minerale che avevate promesso di portare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580403,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "Va bene, tanto gli artigiani stanno ancora lavorando al campione precedente, quindi non c'è troppa urgenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580405,
					"content": "Ma se riuscissimo a mettere le mani su altre forniture del minerale, gli artigiani potrebbero avere nuove ispirazioni, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580406,
					"content": "Sarò ancora qui in attesa di vostre notizie.",
					"roleType": "TALK_ROLE_NPC",
