			"dialogs": [
				{
					"id": 740580301,
					"content": "#Benvenut{F#e}{M#i}... Oh, ehi, siete voi! {F#Le mie fornitrici}{M#I miei fornitori} di gemme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580302
