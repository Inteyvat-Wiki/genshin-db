			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, davvero non c'è nessun altro modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "Il mio libro non ne nomina altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Eh, come vorrei che a bloccarci la strada ci fosse giusto qualche mostro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Sono questi i fiori di sakura che cercate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Ah! Sì, esatto! E questo colore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Evviva! Finalmente possiamo mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Aspetta, quindi hai attraversato quella barriera? Hai usato il metodo di cui ti avevo parlato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Mi diresti dove hai trovato il ramo del Sakura del tuono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "E quando l'hai toccato, come ha fatto l'Electrograno a poggiarsi su di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "...Aspetta, scusa, fammi tirar fuori il taccuino. Quindi, hai provato qualcosa quando l'Electrograno si è attaccato a te? Poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "#Parvaneh, dai un attimo di respiro {F#alla}{M#al} viaggiat{F#rice}{M#ore}. Ci ha appena aiutato, e penso che la tua ricerca possa aspettare un pochino, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "#Grazie infinite, viaggiat{F#rice}{M#ore}. Ti pagheremo, come da accordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Ma prima ti chiedo di aspettare qui un attimo. Credo di poter preparare un piatto coi fiori di sakura che ci hai dato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "Ho sentito parlare di un piatto tipico di Inazuma chiamato tempura ai fiori di sakura. Immagino che sia ora di provarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Dammi un attimo per prepararlo. Torna tra poco, non dovrei metterci molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "Si fa così... poi così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "Hai finito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Aspetta un attimo... Ora lo si infarina, poi lo si fa asciugare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "Ed ecco qua la tempura ai fiori di sakura! Mangiala finché è calda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "È-È buonissima! Però è bollente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong, credo che questa \"tempura\" vada servita con una salsa particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "Una salsa, dici? Devo ammettere che non ne ho ancora preparata nessuna. Se ne avremo l'occasione, vedrò cosa posso fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "#Ecco, prendi questa porzione di tempura ai fiori di sakura come ringraziamento, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "Ah, sì, ti do anche una copia della ricetta. Dammi un attimo che te la scrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "Prova a prepararla, se ne hai l'occasione! Cucinare è divertente, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "Figurati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "Staremo a Inazuma per un po', poi immagino che in seguito ci dirigeremo a <color=#00E1FFFF>Kannazuka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "Julie dice di voler anche andare a vedere il Sakura sacro del Gran Santuario di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "Si dice che tutti i fiori di sakura presenti su quest'isola cadano da quell'albero gigantesco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "Con tutte queste foglie cadute, mi chiedo quanto sia imponente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "Visitalo anche tu, se ti interessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "#Grazie ancora per l'aiuto, viaggiat{F#rice}{M#ore}. Bene, ora mangio un boccone anch'io, sto morendo di fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "Dove andrete ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
