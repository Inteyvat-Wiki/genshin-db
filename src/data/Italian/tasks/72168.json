					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "Mi potresti ripetere il tuo metodo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Certo. Sostanzialmente, da queste parti c'è una cosa chiamata ramo del Sakura del tuono. Devi trovarlo e toccarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "A quel punto, una cosa chiamata Electrograno si attaccherà a te e ti permetterà di attraversare la barriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
