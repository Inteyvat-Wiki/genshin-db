			"dialogs": [
				{
					"id": 742500101,
					"content": "A pensarci bene, non sono stata un'anfitriona molto attenta, quando avete visitato Snezhnaya in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500102,
					"content": "Non importa, Lady Sandrone. Anche se non ci siamo mai seduti a chiacchierare, lei ci ha sempre offerto i rinfreschi migliori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*sospira* Perdonatemi, all'epoca ero fin troppo impegnata. La prossima volta che verrete a trovarmi, mi prenderò sicuramente più cura di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500104,
					"content": "Mh. Anche perché non mi ha mai lasciato provare le sue invenzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Per quello c'erano altri motivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500106,
					"content": "Umpf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "A dire il vero, nostro Padre ci ha detto che non dobbiamo esserle di disturbo, per quanto possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Non preoccuparti per questo, non mi dispiace essere disturbata di tanto in tanto. Venite pure a prendere un tè quando vi va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500109,
					"content": "Davvero? Ah, b-beh... Ho sempre voluto chiederle di dare un'occhiata a Pers... Ho qualche idea per delle migliorie e mi piacerebbe discuterne con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Volentieri, in fondo è il mio campo di competenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500111,
					"content": "...La ringrazio, Lady Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Mh. Essere una Messaggera è davvero così difficile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Messa in questi termini... Suppongo che un po' lo sia. Ci sono molte cose da considerare. Anche se le mie frustrazioni derivano principalmente dai miei colleghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500114,
					"content": "Vuole dire che... andare d'accordo con gli altri è un'abilità indispensabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "Direi di sì... Ma dubito che voi dobbiate preoccuparvene. Di sicuro, non Lyney.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500116,
					"content": "Ahah, mi lusinga, Lady Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Vuoi diventare un Messaggero? Anzi, no... C'ho ripensato, non sta a me chiedertelo. Fai finta che non abbia detto nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500118,
					"content": "Mmh... Per me è ancora tutto molto lontano. Non ho fretta di pensarci adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Se tu diventassi un Messaggero, non avresti più tempo per svolgere le missioni insieme a noi, sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "Ma questo significherebbe... che anche io e Lynette dovremmo diventare Messaggeri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "Ve l'ho già detto, è troppo presto per pensare a cose del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "E poi, non importa dove andrò: non lascerò mai voi due indietro, ve lo prometto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Ah... A volte invidio proprio la vostra piccola famigliola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
