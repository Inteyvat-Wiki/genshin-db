			"dialogs": [
				{
					"id": 742500201,
					"content": "Grazie per l'ospitalità, Lady Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742500204,
					"content": "A presto, e si riguardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
