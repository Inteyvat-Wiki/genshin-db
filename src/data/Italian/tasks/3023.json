					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Non avere fretta. È un progetto molto importante, e ci vorrà del tempo per pianificare e prepararci a tutto ciò che ci aspetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Fa' con calma. Dobbiamo assicurarci che il piano sia quanto più efficace possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "Sta ricominciando a leggere il suo libro! Ehi! Ma stai ascoltando?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Posso prestarti qualcosa da leggere, se vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Assolutamente no! A Paimon non piacciono i tuoi libri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Era una battuta. So bene che i miei libri sono troppo difficili per te. Inoltre, non ho alcuna intenzione di prestarteli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Uff! Sei fastidiosissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
