			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "Fatemi sapere se posso fare altro per aiutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Anche se non posso andarmene dal Villaggio di Aaru, ogni volta che incrocio i vostri sguardi non riesco a non... provare entusiasmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Combattere da sola non mi aveva mai fatta sentire così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Suppongo che sia questo il potere dello spirito di squadra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
