				"points": []
			},
			"dialogs": [
				{
					"id": 30230401,
					"content": "L'incarico degli ultimi giorni è stato tra i più difficili a cui abbia mai lavorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "E non ne ricaverò neanche un singolo Mora... Non ci posso credere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "Dehya, guarda il lato positivo! Quando tutto sarà finito, magari ci sarà una ricompensa enooorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Mmmh, hai ragione. Ehi, cosa faresti se domani ti svegliassi con più denaro di quanto ne potessi mai spendere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Paimon comprerebbe vagonate di spuntini saporiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "Tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Uhm... Forse anche qualche bevanda saporita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Ahah, sei adorabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "Urrà per le nostre fantasie... Se esiste la minima possibilità di farle avverare, mi impegnerò al massimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230410,
					"content": "E speriamo che tutto ciò che facciamo d'ora in poi cambi il mondo in meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
