			"dialogs": [
				{
					"id": 200250401,
					"content": "Hai già trovato la chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250402,
					"content": "Ho trovato questa chiave. È tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250403
					]
				},
				{
					"id": 200250403,
					"content": "Sì! È proprio lei. Non posso permettermi che accada di nuovo... Devo proprio darmi una regolata con l'alcol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250404
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250404,
					"content": "Ah, tieni. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
