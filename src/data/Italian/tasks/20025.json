			"dialogs": [
				{
					"id": 200250201,
					"content": "Hai trovato la mia chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250202
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250202,
					"content": "Temo di no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250203
					]
				},
				{
					"id": 200250203,
					"content": "Ok, l'area in cui cercare è molto vasta... Buona fortuna!",
