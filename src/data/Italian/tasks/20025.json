			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wyatt"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200250101,
					"content": "#Viaggiat{F#rice}{M#ore}! Non avresti potuto scegliere un momento migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250102,
					"content": "La notte scorsa, stavo andando in città a consegnare queste merci, quando all'improvviso delle sfere scintillanti hanno attirato la mia attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250103,
					"content": "H-Ho bevuto troppo e... Mi sono sentito attratto da loro, capisci? Sono andato a controllare e ho scoperto che si trattava di un enorme gruppo di Melmosi. Hanno conciato per le feste anche me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250104,
					"content": "Sono andato nel panico e sono scappato, ma mi sono perso. Ci ho messo una vita a ritrovare il carretto. Poi, questa mattina, ho scoperto che la mia <color=#00E1FFFF>chiave</color> è scomparsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250105,
					"content": "Puoi aiutarmi a cercarla? Dovrebbe essere qui da qualche parte... Sento che è proprio sotto il mio naso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250106,
						200250108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250106,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250107
					]
				},
				{
					"id": 200250107,
					"content": "Fantastico! È un'area molto vasta, non saprei proprio da dove cominciare a cercare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250108,
					"content": "Ho degli affari urgenti di cui occuparmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250109
					]
				},
				{
					"id": 200250109,
					"content": "Questa è un'area molto vasta, non saprei proprio da dove cominciare a cercare. Per piacere, solo tu puoi aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
