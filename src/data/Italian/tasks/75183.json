			"dialogs": [
				{
					"id": 751830101,
					"content": "Riesco a sentirla, la sento! La tua \"intensità\"... È impressionante, lo è davvero! Quindi, che ne dici? Vuoi provare la Sfida del guerriero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751830102,
						751830103,
						751830106
					],
					"speakerTitle": "Ma'chah",
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				},
				{
					"id": 751830102,
					"content": "#Sono {F#pronta}{M#pronto}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				},
				{
					"id": 751830103,
					"content": "Ho bisogno di un attimo per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				},
				{
					"id": 751830106,
					"content": "Perché tremi? Hai preso un raffreddore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751830107
					],
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				},
				{
					"id": 751830107,
					"content": "\"Tremare\"? No, no. Ho solo i brividi per l'\"intensità\"! Venite, sfidate il mio record. Provate a rivendicare il titolo di \"Campione della Comunità dell'Abbondanza\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ma'chah",
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				}
			]
		},
