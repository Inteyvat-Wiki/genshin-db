			"dialogs": [
				{
					"id": 751830301,
					"content": "Mmm... Concentrarsi troppo sull'obiettivo durante la corsa porta a trascurare i pericoli circostanti. Non va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751830302
					],
					"speakerTitle": "Runa"
				},
				{
					"id": 751830302,
					"content": "Perciò la mia filosofia è quella di mettere qualcosa lungo il percorso che renda la sfida un po' più... \"interessante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751830303
					],
					"speakerTitle": "Runa"
				},
				{
					"id": 751830303,
					"content": "#Che ne pensi, {F#allegra guerriera}{M#allegro guerriero} di una terra straniera? Ti va di metterti alla prova con la Sfida del guerriero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751830304,
						751830305
					],
					"speakerTitle": "Runa"
				},
				{
					"id": 751830304,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatore, Comunità dell'Abbondanza"
				},
				{
