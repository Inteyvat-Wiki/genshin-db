					"nextDialogs": [
						790480107
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790480107,
					"content": "#Forse possiamo trovare il resto del diario da qualche altra parte. {NICKNAME}, teniamo gli occhi aperti, ok?",
