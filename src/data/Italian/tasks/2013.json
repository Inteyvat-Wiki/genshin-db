			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Aspettate un momento, per favore... queste merci devono essere consegnate... all'Isola di Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Signorina! Che onore inaspettato. Esatto, queste merci sono state più volte richieste dal commissario Kanjou. Dobbiamo accertarci che arrivino all'Isola di Watatsumi intatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Qualcosa non va, signorina Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "No, no. È solo che mio padre è preoccupato per la sicurezza del carico, e ha inviato me insieme a una scorta qualificata per garantire la sicurezza del trasporto delle merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Signorina, sta dicendo che intende scortare personalmente il carico? Non si deve preoccupare di una cosa del genere, e per quanto riguarda la \"scorta qualificata\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Sarà un piacere lavorare con voi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Vi prego, non perdiamo altro tempo. Se ben ricordo, mio padre ha già insistito sull'importanza della puntualità della consegna di questo carico. Sono certa che una punizione sarà doverosa, se ci dovessero essere ritardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Certo, mia signora. S-Solo che... beh, non sappiamo chi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Devo ricordarvi cosa succederebbe se mi accadesse qualcosa durante il viaggio? Sono certa conosciate bene il carattere di mio padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Ritenete davvero di poter garantire la mia sicurezza da soli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Certo che Chisato sa essere proprio convincente, non hanno scampo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "S-Sì, mia signora. Molto bene, allora... P-Per noi, la sua compagnia è un onore e la sua sicurezza è la nostra massima priorità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou! Sei davvero d'accordo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Beh, la richiesta proviene dalla signorina Hiiragi. È nostro dovere servirla al meglio delle nostre capacità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Sì, ma... non è questo il problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Bene allora, se qui abbiamo finito, suggerirei di partire immediatamente. Indugiare ancora darebbe solo più tempo a potenziali ladri per prepararsi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "S-Sì, mia signora. L'hai sentita, non c'è tempo da perdere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Osate mettere in discussione le mie abilità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
			"id": 201310,
			"completionStepIds": [
				201310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201310",
