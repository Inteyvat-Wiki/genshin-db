			"trigger": {
				"objectNames": [
					"Kobayashi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "Fermi lì! Mostrate i vostri Permessi di viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Scusa, ma dobbiamo proprio andare all'Isola di Narukami, è abbastanza urgente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Senza un permesso di viaggio, non andrete proprio da nessuna parte. Così è la legge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Eh... proprio come previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "#Viaggiat{F#rice}{M#ore}, devi inventarti qualcosa. Come usciamo da Ritou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "Se la Commissione Yashiro ha sentito parlare di noi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "Stai dicendo... che dovremmo incontrare il commissario Kanjou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "...Tentare non costa nulla. Anche se Paimon avrebbe da dirgliene quattro sui suoi subordinati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "Chissà, magari è un nostro fan accanito! Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "Mi domando se anche la Commissione Kanjou ci conosce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
