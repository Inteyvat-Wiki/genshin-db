				"objectNames": [
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "Fermatevi, voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130402,
					"content": "Proprio come pensavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "Eh? Cosa abbiamo fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130405,
					"content": "La signorina Hiiragi ha una lettera per voi. Vuole che la leggiate immediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130406,
					"content": "Una lettera? Presto, fai vedere anche a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130407,
					"content": "#Car{F#a}{M#o} viaggiat{F#rice}{M#ore}, mi sarebbe piaciuto poterti parlare di persona. Mi scuso per i mezzi precipitosi con cui ti è giunta questa lettera e spero che non ti abbia arrecato sconcerto o turbamento in alcun modo. Questa è la prima volta che rivolgo un invito a un{F#a}{M#o} stranier{F#a}{M#o} che non conosco, in fondo. Non è una coincidenza che le nostre strade si siano incrociate. Perciò spero tu mi conceda gentilmente la possibilità di incontrarci stasera sotto il bagliore della luce splendente della luna. Non preoccuparti di inservienti e guardie del corpo, farò in modo che la loro attenzione sia rivolta altrove. Attendo con ansia di avere il piacere della tua compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130408,
					"content": "Quindi significa... che vuole vederti in segreto stanotte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130409,
					"content": "Però non sembra che la cosa ti sorprenda... che sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130410,
					"content": "#Ci siamo scambiat{F#e}{M#i} uno sguardo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "Eh? Hai combinato qualcosa alle spalle di Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130414,
					"content": "Mmmh... chiediamoglielo stanotte e vediamo cos'ha da dirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130412,
					"content": "Shinsuke non ha intenzione di lasciarci andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "Paimon sapeva che c'era qualcosa che non andava in lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130403,
					"content": "Lo sapevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
			"completionStepIds": [
				201307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201307",
							"2"
						],
						"stepId": 201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, eccoti, finalmente... Lascia che mi presenti, sono Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "Questa è tecnicamente... la seconda volta che ci incontriamo. È un piacere incontrarti di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Wow, è davvero la figlia del clan Hiiragi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "Il piacere è mio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "N-Non c'è bisogno di essere così formali... è da tanto che ammiro le tue gesta... finalmente abbiamo la possibilità di incontrarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "È un'impressione di Paimon o c'è qualcosa di strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "Il motivo per cui volevo incontrarti in segreto qui è... beh, avevo paura che non avrei mai più avuto l'occasione di parlartene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "P-Parlare di cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "Ehm... Vorrei chiederti aiuto per consegnare... una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Uff, tale padre, tale figlia! Non potete essere più originali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "N-No! Mi avete fraintesa... lasciate che vi spieghi, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "Speravo che poteste consegnare una lettera all'Isola di Narukami al posto mio. Dovreste portarla a Kujou Kamaji della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Mio padre mi ha sempre proibito di parlare con lui. Sa che ci sono prospettive di matrimonio per me che gli sarebbero politicamente più utili. Ma il mio cuore è di Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "#Non c'è nessuno che oserebbe sfidare la volontà di mio padre qui a Ritou, ma voi siete stranier{F#e}{M#i}... stranier{F#e}{M#i} che stanno cercando il modo di andare all'Isola di Narukami. Sarebbe un peccato lasciarsi sfuggire quest'occasione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, adesso Paimon capisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "Ovviamente, se accettate, farò tutto ciò che è in mio potere per aiutarvi a lasciare Ritou. Questa è la mia promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Mmmh, sembra un accordo ragionevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "A essere del tutto onesti... fintanto che rimarrete a Inazuma, mio padre non avrà intenzione di farvi lasciare Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Sì, lo avevamo capito. Era ovvio che stesse cercando di farci rimanere qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "Proprio qualche giorno fa ho sentito per caso una conversazione tra mio padre e una donna che parlava in maniera arrogante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "Sembravano star discutendo un modo per farvi rimanere a Ritou. In realtà, era la prima volta che sentivo mio padre parlare in maniera così rispettosa con qualcuno che non fosse la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Una donna che parlava in maniera arrogante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "Non abbiamo molto tempo. Vi rivelerò il modo in cui ho intenzione di farvi lasciare l'isola. Si dà il caso che un carico di merci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "#(Hiiragi Chisato spiega il suo piano al{F#la}{M#} viaggiat{F#rice}{M#ore}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "Molto bene, ti aspetterò al confine. Conto su di te per consegnare la mia lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "Pare che dobbiamo andarcene da Ritou il più in fretta possibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Visto che non abbiamo altre opzioni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Me ne vado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "È un piacere incontrarti di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
			"completionStepIds": [
				201308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201308",
							"2"
