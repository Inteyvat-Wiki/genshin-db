			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Fiuuu, possiamo rifugiarci al villaggio laggiù. Come sta, mia signora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Sto benissimo. Potete fermarvi qui. La strada per l'Isola di Narukami è da quella parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "Nella mia lettera, ho chiesto a Kamaji di concedervi un permesso di viaggio speciale da parte della Commissione Tenryou. Consideratelo un pegno della mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "Grazie, Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Mia signora...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "Ah! Quindi le cose stanno così. Avevo la sensazione che ci fosse qualcosa che non andasse, ma Shinnojou, tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "No, la signorina Hiiragi non ci nasconderebbe mai nulla, ne sono certo. Ma chi è questo \"Kamaji\" di cui parla, mia signora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "Non ho timore nel dire... che è la persona che amo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "La persona... che ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou... Pensavi davvero che...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "Cosa?! N-No, Io, uh... ehm! Stavo solo chiedendo, ecco. Non potrei mai, nemmeno nei miei sogni, ah... ehm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "Non dovete preoccuparvi. Per favore, dimenticatevi tutto quello che è successo. Se mio padre dovesse scoprirlo, sarò io l'unica responsabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Sì, certamente. Come preferisce, mia signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "Ma cosa succederà se ti scoprissero, Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "Non preoccuparti, mio padre mi ha sempre viziata. Il massimo che potrebbe fare è lasciarmi senza cibo per mezza giornata o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Oh, Paimon non si sarebbe mai aspettata che un tipo simile avesse un lato tenero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Vi auguro buon viaggio. Sono certa che ci incontreremo di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "Ciao, Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "Andiamo, su! Smettila di fissare e diamoci una mossa. Abbiamo un carico da spostare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "*piagnucola* V-Va bene... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Fai attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
