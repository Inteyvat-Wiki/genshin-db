			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patchi la Curiosa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Non c'è NIENTE di meglio di un piano perfetto quando sei all'avventura! Come si può sperare di compiere progressi, continuando ad agire alla rinfusa in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410102,
					"content": "Se il piano non è perfetto, bisogna essere pronti a tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Perché state discutendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Sono una ricercatrice di antiche rovine e voglio partire per una spedizione al Tempio dei Mille Venti. Ma non me la cavo bene nelle situazioni in cui bisogna combattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410105,
					"content": "Il signor Doolan qui presente è un avventuriere, e si è fatto carico di organizzare tutto il necessario per l'esplorazione del tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410106,
					"content": "Ora, non voglio criticare Doolan, e so che quelle Guardie delle rovine sanno essere molto fastidiose... ma lui insiste nel voler stilare un piano di avventura completo e preciso in ogni dettaglio, perciò non fa altro che indire riunioni dopo riunioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410107,
					"content": "Abbiamo fatto ricerche, indagato, rettificato, svolto ricerche supplementari, ulteriori ricerche, correzioni... Aaah, non ce la faccio più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410108,
					"content": "Ora dice di aver trovato delle prove riguardo a dei mostri accampati vicino al tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410109,
					"content": "Ti supplico, potresti liberartene tu per me? Solo per tappargli la bocca, anche se non riusciamo a entrare nel tempio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410110,
					"content": "Ho capito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Sarò felice di sostituirti nelle riunioni con Doolan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Apprezzo il gesto, ma dammi retta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patchi la Curiosa"
				},
				{
					"id": 200410113,
					"content": "Batterti con quei mostri sarà molto meno stressante di una delle sue riunioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi la Curiosa"
				}
			]
		},
