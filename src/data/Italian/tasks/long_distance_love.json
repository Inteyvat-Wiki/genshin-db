			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "Bah, non vedo l'ora di tornare a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "#Oh, viaggiat{F#rice}{M#ore}, ciao! Posso chiederti un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Come vedi, sono un cavaliere e sono di pattuglia, in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Ho detto alla mia ragazza che le avrei mandato una lettera presto, così da farle sapere che sto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Però, ho avuto tanto da fare e mi sono dimenticato... povero me. Potresti consegnarle questa <color=#00E1FFFF>lettera</color> da parte mia? Si chiama <color=#00E1FFFF>Glory</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Un momento... Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "La ragazza cieca... Colleziona semi di dente di leone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Ah! Tu devi essere Godwin, Glory ha parlato di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Che cosa... Come fai a conoscere Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Abbiamo svolto un incarico per lei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Avete svolto un incarico per lei, dici? Spero non fosse niente di pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Ci ha chiesto solo di portarle dei semi di dente di leone, niente di più. Diceva che, se li avesse liberati nel vento, avrebbero portato i desideri del suo cuore fino a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Semi di dente di leone, eh? È proprio tipico della mia Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Un momento, lei ha detto che eri in un luogo molto lontano da Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Sì, ehm, quello era il piano... Lasciate che vi spieghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Avete sentito parlare dei tempi in cui il Gran Maestro lasciò Mondstadt, portando quattro cavalieri su cinque con lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Ecco, beh, io ero uno di quelli assegnati alla spedizione. Ma purtroppo... proprio mentre ci preparavamo a partire, mi sono accorto di aver perso il pegno che mi aveva regalato Glory. Quando finii di cercarlo, erano già andati via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "A-Ancora non ho capito come raggiungerli e, nel frattempo, sono rimasto a vagare qui nei dintorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Non posso permettermi di tornare a Mondstadt. Posso solo immaginare ciò che i cavalieri direbbero di me, se tornassi strisciando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "E poi... ho promesso a Glory che le avrei mandato lettere e regali da tutto il mondo. Le ho detto che le avrei mandato il mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Se scoprisse che non sono neanche riuscito a uscire da Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Non vuoi fare una brutta figura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Ti prego, consegna questa <color=#00E1FFFF>lettera</color> a <color=#00E1FFFF>Glory</color> per me. Scommetto che è preoccupatissima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "#Non so davvero come ringraziarti, viaggiat{F#rice}{M#ore}! Ti prego, mantieni il segreto su ciò che ti ho detto, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Perché non provi a usare i semi di dente di leone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Ci sono così tante così che vorrei dire a Glory, molte più di quante una manciata di semi di dente di leone potrebbe mai trasportare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Grazie per aver preso in carico la mia lettera. E ricorda: non una parola di tutto questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
