			"dialogs": [
				{
					"id": 762010201,
					"content": "Sei cattiva, Metta! Volevo solo che ti divertissi nella tua avventura... Perché devi dire cose del genere, umpf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Se non la smetti di agire seguendo ogni tuo capriccio, anche gli altri finiranno per stufarsi di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Non è un capriccio! Io... Anch'io ho i miei piani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Wow, piani, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Uff... Mi stai di nuovo ignorando. Non ti parlo più! Anche se poi te ne pentirai, sarà troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "...Ah, Linnea! Metta stava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Ascoltando il resoconto stentato di Vesa, diventa chiaro che si è trattato solo di un tipico battibecco tra bambini...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Comunque la si guardi, non sono io ad aver sbagliato, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Allora... non ho sbagliato nemmeno io! Sorellona Linnea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Mm... A volte queste cose succedono e basta. Nessuno sbaglia per davvero, ma le cose non vanno comunque come vorremmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Oh, è come la storia delle due sorelle degli Eredi della Luna gelata rappresentata dal Bocciolo notturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Eh? La storia delle due sorelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Sì. Ho sentito dire che un tempo tra gli Eredi della Luna gelata c'erano due sorelle. Avevano personalità molto diverse, come il rosso e il blu del Bocciolo notturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "Entrambe fecero ciò che credevano fosse giusto, ma proprio per questo le loro strade si separarono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Si dice che la sorella minore non perdonò mai la maggiore per averla lasciata indietro, anche se quest'ultima salvò innumerevoli vite... Alla fine, le due morirono senza mai più rivedersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Ah... Non sapevo che gli Eredi della Luna gelata avessero delle storie del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Nemmeno io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Mmm... L'ho sentita da un bardo itinerante. Forse c'è qualche elemento di fantasia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Ah, quindi è una storia inventata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Beh, anche se la storia non è del tutto vera, la lezione che trasmette resta comunque valida, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Nessuna delle due pensava di essere nel torto. Entrambe erano certe che la propria scelta fosse quella giusta, ma quelle scelte avevano distrutto il loro legame per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Se dimostrare di avere ragione significasse perdere un amico... Voi cosa scegliereste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Ah... In realtà, qualche piccola deviazione spontanea durante un'avventura non è poi così male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "...Sì! A pensarci bene, il tempo che Metta trascorre all'avventura con me è prezioso. Se continuo a cambiare idea, potremmo finire per non goderci nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "La... La prossima volta organizzerò meglio le cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Eheh, sono felice che abbiate chiarito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "La prossima volta che Vesa e io andremo all'avventura, porteremo allo Speranza tutte le pietre insolite che troveremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Perfetto! Grazie in anticipo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
