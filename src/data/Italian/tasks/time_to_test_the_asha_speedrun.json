						150480402
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480402,
					"content": "Stai dicendo che... vorresti mostrarmi la strada e farmi da allenatore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480403
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480403,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480404
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480404,
					"content": "Ma è fantastico! Ora mi sento più sicuro di prima. Allora andiamo, allenatore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480405
					],
					"speakerTitle": "Bennett"
				},
				{
