			"dialogs": [
				{
					"id": 150480301,
					"content": "Ce l'hai fatta! Visto? Non era così difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480302,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480303
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480303,
					"content": "Sei stato grande, bello! Non mi aspettavo proprio che fossi così atletico, sono stupefatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480304,
					"content": "Adesso tocca a te, vero, Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Sì! Ho finito il riscaldamento e ho fatto stretching, sono pronto a entrare in azione. Fidatevi, andrà benone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Stai attento, mi raccomando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "#Grazie per la premura, {NICKNAME}! Non ti preoccupare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
