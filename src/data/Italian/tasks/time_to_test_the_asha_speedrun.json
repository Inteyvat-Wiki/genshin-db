					}
				]
			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "...Mi spiace, ma non possiamo permetterle di correre un rischio del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Ma non è quello che lei mi ha detto prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Siamo desolati. Anche se siamo in ritardo sulla tabella di marcia, la sicurezza degli ospiti ha la priorità assoluta. Confidiamo nella sua comprensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#Oh, {NICKNAME}, tempismo perfetto! Potresti aiutarmi a persuadere questo buon uomo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Gli serve qualcuno per fare il collaudo, così gli ho detto della mia esperienza come avventuriere e che sono cosciente degli eventuali rischi. Stava andando tutto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Ma da quando ha saputo di tutte le situazioni fatali in cui mi sono ritrovato, si rifiuta categoricamente di farmi partecipare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Signore, apprezzo il suo entusiasmo, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Ma se lei stesso dice di avere la tendenza a cadere nei fiumi perfino percorrendo solidi ponti di pietra, allora forse è il caso di dedicarsi a qualcosa di meno... impegnativo? Potrebbe adagiarsi su una di quelle sdraio laggiù, per esempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*sospira* Ma io sono davvero un avventuriere, e sono anche qualificato per il collaudo! È solo che... in passato ho avuto qualche sfortuna di troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Voglio davvero darvi una mano. Mi creda, sono una persona affidabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Posso garantire io per lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "#Beh, se è {F#la salvatrice}{M#il salvatore} di Natlan a dirlo... allora che ne dice di chiedere al suo compagno Asha di completare il primo turno di prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Lei potrà osservarlo e familiarizzare con il percorso. Se tutto andrà bene, potrà partecipare al secondo turno di prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Tu sei d'accordo, bello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Bene, allora! Conto su di te, partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Ha la mia piena fiducia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
