			"dialogs": [
				{
					"id": 150480601,
					"content": "Bene, siamo quasi alla fine. Calma e sangue freddo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480602,
					"content": "Eh? Cosa?! Dov'è finito il traguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480603
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480603,
					"content": "Oh, no, ho parlato troppo presto? Non è che la mia fortuna si è già esaurita?! No, avanti, non posso perdere la speranza proprio ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480604,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480605
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480605,
					"content": "È vero, posso sempre seguire il mio amico Asha! Devo avere fiducia nel nostro legame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
		{
