			"dialogs": [
				{
					"id": 150480801,
					"content": "Fiuu, sento il cuore che mi scoppia... Devo riprendere un attimo il fiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480802,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "Un bell'applauso a Bennett e al suo amico Asha! Siete una squadra formidabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Soprattutto per il modo in cui avete collaborato alla fine. Il vostro legame speciale è stato decisivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Avete ribaltato la situazione insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Eh, già!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Devo ringraziare in particolare te, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "Se non mi avessi sostenuto e aiutato a convincere il dipendente, non avrei mai avuto la possibilità di competere in questa sfida, figuriamoci di affrontarla assieme al nostro amico Asha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Signor Bennett, il test di sicurezza finale è terminato, il che significa che la Corsa degli Asha è ufficialmente pronta ad accogliere il pubblico. Grazie infinite per il suo aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Hai sentito, Asha? Ce l'abbiamo fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Mi ricorderò di lei, signor Bennett: è un avventuriere gentile e coraggioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "So che quest'avventura non è ancora finita, ma l'idea di dover dire addio a un certo punto mi fa sempre più male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480813,
					"content": "Asha, mi mancherai un mondo.",
