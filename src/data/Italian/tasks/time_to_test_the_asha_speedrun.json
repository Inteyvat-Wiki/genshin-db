					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480815,
					"content": "Eheh, ehi... Dovrei essere io a confortare te, in questo caso! In quanto leader della compagnia, è mio dovere prendermi cura di te e degli altri membri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Bennett"
				},
				{
