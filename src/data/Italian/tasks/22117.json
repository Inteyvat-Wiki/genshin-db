			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Oh no, non posso averla davvero lasciata in cima alla montagna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170102,
					"content": "Ciao, nonnina, sono felice di vederti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Oh! Che bello imbattersi in tanta gioventù! Una coincidenza molto fortunata, tra l'altro... Dovreste coprirvi di più, comunque. Quassù è molto ventoso, vi raffredderete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170104,
					"content": "Stavo tornando in città dal Monte Hulao, dove sono stata a trovare un vecchio amico. Abbiamo parlato dei bei tempi andati, ed è stato piacevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170105,
					"content": "Circa a metà strada, però, mi sono accorta di aver dimenticato qualcosa. *sospira* L'avrò lasciata sulla montagna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170106,
					"content": "Alla mia età, non reggerei un secondo viaggio fin lassù nello stesso giorno... È molto distante, e quel luogo è pieno di fastidiosissima ambra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170107,
					"content": "Se chiedessi a voi giovani di recuperare ciò che ho perso in cima al monte? Ve ne sarei immensamente grata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170108,
					"content": "Chi è questo vecchio amico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "Vive sul Monte Hulao, avete presente? L'avete incontrato sicuramente... Circondato da quell'ambra che è piuttosto seccante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170110,
					"content": "La mia memoria non è più quella di una volta... Come ho potuto dimenticare di riporre la scatola nella mia teiera, prima di ripartire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170111,
					"content": "Cos'hai lasciato lassù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Una scatola... mi pare. La mia memoria non è più quella di un tempo... Avrei dovuto metterla subito nella teiera, invece... Oh, quante scocciature mi sarei risparmiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170113,
					"content": "Se davvero è in cima alla montagna, è possibile che sia rimasta intrappolata nell'ambra, quindi non dovreste avere troppi problemi a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170114,
					"content": "Fareste un grosso favore a una povera vecchietta... Andate sul Monte Hulao per me, è la zona dove si trova l'ambra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170115,
					"content": "Fate attenzione, però. L'ambra potrebbe aver incapsulato anche altro, nel corso degli anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211703",
							"2"
						],
						"stepId": 2211703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "#Perché non ti sei copert{M#o}{F#a} un po' di più, prima di uscire? Se prendessi un raffreddore, mi sentirei terribilmente in colpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170302,
					"content": "Ciao nonnina, è questo l'oggetto che hai perso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Vediamo un po'... Ma certo, è la mia scatola! L'avevo lasciata sul serio lassù, allora. Ah, la mia memoria perde colpi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170304,
					"content": "Grazie mille. Contiene solo qualche cianfrusaglia, ma ci tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170305,
					"content": "Ed ecco qui qualcosina per il vostro disturbo. Vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170306,
					"content": "Meglio riporre la scatola nella teiera, o finirò col dimenticarla di nuovo in giro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211704,
