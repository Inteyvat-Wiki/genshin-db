			},
			"dialogs": [
				{
					"id": 221170401,
					"content": "#Perché non ti sei copert{M#o}{F#a} un po' di più, prima di uscire? Se prendessi un raffreddore, mi sentirei terribilmente in colpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170402,
					"content": "Parlami dell'ambra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "La crea il mio amico. Secondo lui riesce a catturare mostri e banditi diretti in cima alla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170404,
					"content": "La usa da molto tempo, e devo dire che nel corso degli anni ha intrappolato cose piuttosto peculiari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170405,
					"content": "È una sostanza terrificante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170406,
					"content": "Tutto bene con la teiera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Oh, sì. Ora è in perfetto stato, come nuova. Tutto merito tuo, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170408,
					"content": "In realtà, il lungo cammino e tutti i miei sforzi erano proprio mirati a dare una ravvivata alla mia teiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170409,
					"content": "Ci tengo molto all'ordine e alla pulizia, così presto potrò nuovamente offrire del tè ai miei ospiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		}
	]
}