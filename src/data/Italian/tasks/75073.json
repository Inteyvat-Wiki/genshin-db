				{
					"id": 750730404,
					"content": "Che ti è successo stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730405
					]
				},
				{
					"id": 750730405,
					"content": "#Ah, sei tu, {F#mia salvatrice}{M#mio salvatore}! Non mi aspettavo di incontrarti... Cioè, non mi aspettavo che mi avresti salvato di nuovo durante i nostri rispettivi viaggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730406
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730406,
					"content": "Ah, non avevo già detto prima che mi chiamo Conulaf, e che sono un'apprendista sacerdotessa dei Maestri del Vento della Notte?",
