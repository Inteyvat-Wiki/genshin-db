					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730201,
					"content": "#Oh, per favore, {F#mia salvatrice}{M#mio salvatore}, questo posto è così in alto, e ci sono così tanti Qucusauri. Non puoi abbandonarmi qui, in questa gabbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
