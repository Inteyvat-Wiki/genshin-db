			"dialogs": [
				{
					"id": 750730301,
					"content": "*singhiozza* Libertà! Finalmente libera da questa prigione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Il pallone aerostatico continua a muoversi di qua e di là. Eheh, chissà, magari arriverà una folata di vento e farà cadere tutto quanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Temo che a quel punto neanche Nonna Itztli sarebbe in grado di salvarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Chi sei e come sei finita qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ah, sì, non mi sono ancora presentata. Chiamatemi Conulaf, un'apprendista sacerdotessa dei Maestri del Vento della Notte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Come suggerisce il titolo, mi sto addestrando per diventare una sacerdotessa. Sono rimasta nella nostra tribù per tutta la vita, e quindi gli anziani mi hanno detto: \"Perché non parti a vedere il mondo?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "E così mi hanno cacciata via dalla tribù con la scusa dell'addestramento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "#Tuttavia, venire catturata dagli Hilichurl non è il modo migliorare di \"vedere il mondo\", vero, {F#mia salvatrice}{M#mio salvatore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Partire all'avventura da soli è un grosso rischio....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Esatto, proprio così! Se non fosse stato per te, non so quanto sarei rimasta intrappolata lì dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "#In ogni caso, grazie mille per avermi salvata, {F#mia cara salvatrice}{M#mio caro salvatore}... Ora, dopo tutto questo vento che ho dovuto sopportare, sarà meglio che scenda prima di riflettere ulteriormente sul mio addestramento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Non ho molto con me, ma nella mia famiglia ripaghiamo la gentilezza che ci viene offerta, quindi lascia che ti dia questi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Beh, finché sei abbastanza forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "Eh... Non mi convinci. Temo che non ci sia nessun'altra persona al mondo che sia forte come te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
