				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#Ah, {F#mia salvatrice}{M#mio salvatore}! Grazie per avermi aiutato a... sconfiggere quegli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "Mi trovavo sul dirupo a godermi il panorama, quando uno di loro mi ha colpito. Quando ho ripreso conoscenza, ero già intrappolata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "È chiusa. La chiave... Ah, giusto, la chiave è in quella cassetta laggiù. Posso chiederti un favore piccolissimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Sarei eternamente e incredibilmente grata se tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
		{
			"id": 7507302,
