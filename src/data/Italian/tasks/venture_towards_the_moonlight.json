				},
				{
					"id": 766600102,
					"content": "Ahh... Mi sento già a casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "Oh... Hai fretta? Posso aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "Katheryne"
				},
				{
