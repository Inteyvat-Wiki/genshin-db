					"content": "Niente affatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "Siamo solo iper felici di vederti, Katheryne! Eheh, sei la migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766600108,
					"content": "Grazie per le parole gentili... Ma se volevate scherzare, temo di non aver capito cosa volevate dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600109,
					"content": "Comunque sia, vi do il benvenuto a Nod-Krai, una terra ricca di opportunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600110,
					"content": "Sono certa che qui riuscirete a vivere grandi avventure e a scoprire tesori inimmaginabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600111,
					"content": "#Buona fortuna, {F#avventuriere}{M#avventurieri}! E buon viaggio! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600106,
