			"dialogs": [
				{
					"id": 207432001,
					"content": "Hai già sgomberato le tre strade commerciali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "Sono perfettamente sgombre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Ottimo. Ora i nostri affari potranno gradualmente riprendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Onestamente, avrei dovuto parlare di questo problema con patron Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Ma è scomparso. L'ho cercato per tutto il Vigneto, ma nessuno sa dove sia finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde ha detto qualcosa del tipo: \"Patron Diluc è andato a occuparsi di una faccenda personale\", ma non ha voluto dire altro. Non sembrava nemmeno preoccupata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*sospira* Lasciamo perdere. Quando sarà tornato, faremo una bella chiacchierata...",
