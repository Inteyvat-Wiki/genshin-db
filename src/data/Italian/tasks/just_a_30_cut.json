			"dialogs": [
				{
					"id": 747030101,
					"content": "#Un momento... questi conti... Siete {F#sicure}{M#sicuri} di non aver fatto un errore di calcolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030102,
					"content": "Mh? Qualcosa non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "...I profitti sono stati davvero così alti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030104,
					"content": "Stai avendo dei ripensamenti sulla quota del trenta per cento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Mi credi davvero così meschina? Sono solo stupita che abbiate fatto un lavoro così eccellente nel gestire l'acquario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030106,
					"content": "Paimon pensa che parte del merito sia anche del Cinefestival di Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Tutti questi incassi... Anche dopo aver pagato l'affitto della Wingalet, rimarrà comunque un bel profitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030108,
					"content": "Stai pensando di cambiare carriera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Col cavolo. Non sono così illusa sul mio fiuto per gli affari. La mia passione sta nella costruzione di macchinari e nello studio delle formule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030110,
					"content": "D'altra parte... Vedere questo posto trasformarsi da una sala senza pesci a quello che è ora sembra un miracolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030111,
					"content": "Hihi, dobbiamo ringraziarti per averci prestato lo spazio! È gratificante vedere il proprio duro lavoro portare gioia a così tante persone! Non credi anche tu, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Umpf. Forse un pochino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747030113,
					"content": "Solo un pochino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Dev'essere perché si è accontentata del trenta per cento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Uff, ho già detto che non m'interessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
