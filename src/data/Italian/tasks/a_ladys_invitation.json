			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"La Marionetta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh? Eccovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180102,
					"content": "Ehilà, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Grazie per l'invito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Eh? Ma la tua lettera non diceva che avremmo avuto un tè? Com'è che non c'è niente, qui? Non sarà mica un raduno senza spuntini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Ah! Ti piacerebbe, eh, Paimon? Credi davvero che mi dimenticherei del cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180107,
					"content": "Woah! Quel... Quel tavolo è appena apparso dal nulla?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Eheh, forte, vero? È il tavolino da tè portatile che ho appena sviluppato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180109,
					"content": "È facile da trasportare e riporre, ed è persino dotato di un dispositivo di levitazione, proprio come quello di Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180110,
					"content": "#La cosa ancora più incredibile è... Ah, ehm, lasciamo perdere, non voglio passare per un'imbonitrice. Potete verificarlo voi {F#stesse}{M#stessi}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180111,
					"content": "Ecco, ho preparato del tè e degli spuntini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180112,
					"content": "Allora non faccio complimenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mmm...! Che buoni! Sei davvero un'ottima cuoca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Mi pare logico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180115,
					"content": "Ma cosa ti ha ispirato a creare un'invenzione del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Volevo potermi godere dei tè piacevoli con gli amici ovunque si trovassero, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180117,
					"content": "Te l'ho già detto: aggrapparsi a ciò che si ha non è l'unico modo per preservare ciò che è prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180118,
					"content": "Ultimamente mi ritrovo a voler fare passeggiate e andare a trovare i miei amici più spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180119,
					"content": "Ma presentarmi a casa degli altri aspettandomi che preparino tè e dolcetti, per poi lasciare che sparecchino anche... non è certo un comportamento appropriato per una signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180120,
					"content": "Eheh, Paimon non crede che ai tuoi amici dispiacerebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Dispiacerebbe a me. E poi, un'invenzione semplice come questa non è affatto un problema per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180122,
					"content": "Vedo che vi piace. Non preoccupatevi, posso farne uno anche per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180123,
					"content": "Eh?! Ne sei proprio sicura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Ma sì. Ti ho già detto anche questo: non ci metto nulla a creare qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180125,
					"content": "Se è così, grazie mille...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Non c'è di che. Mi avete aiutato molto durante la Festa di Fontinalia. Consideratelo un ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 762180104,
					"content": "Speriamo di non averti fatto aspettare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}