					"Escoffier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Ah, sei tu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Ne è passato di tempo, Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Oggi non sono io a capo della cucina. Sono qui in veste di assaggiatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna sta cercando di inventare qualcosa di nuovo e mi ha chiesto di darle un'occhiata. Ciò detto, questo è... il quinto rifacimento del suddetto piatto finora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Se non è la consistenza degli ingredienti a essere compromessa da una differenza di pochi secondi nel controllo della temperatura, allora è l'aroma delle spezie usate a predominare a causa di un eccesso di condimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Sei esigente come sempre, vedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Certo! L'arte culinaria è una scienza, e la nostra amicizia non la cambierà. Anzi, quella e il nostro dovere verso i nostri clienti esigono che io sia severa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Avrei una piccola richiesta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "...In un momento come questo? Se le foto sono destinate al pubblico, potrei suggerirti di trovare un altro momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Dobbiamo allestire il set con cura e regolare attentamente l'illuminazione e l'angolazione per ottenere i migliori risultati possibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Sto solo scattando una foto ricordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "...Va bene. Alla fine, c'è un po' di tempo prima del sesto tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Allora, vediamo chi la spunterà tra la tua lente e quel nuovo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Ne approfitto anche per provare questo nuovo obiettivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Ti dispiacerebbe se ti scattassi una foto, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Stai preparando una nuova ricetta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
