					"Li Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "Che succede? Ah... La signorina Tang Wen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Perdita di appetito... Uno strano sapore in bocca... Ci vuole una pietanza speciale per risolvere la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Si è imbattuta davvero in una situazione del genere... È un bel problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Ma, a mio parere, non serve un piatto particolarmente costoso. Basta che il sapore e il gusto sono unici, e intensi a sufficienza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Suggerisco del guoba di Jueyun! Ha una consistenza croccante e un forte gusto piccante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Sono passati più di dieci anni da quando ho assaggiato per la prima volta il guoba di Jueyun al Villaggio di Qingce, ci penso ancora ogni tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Credo che, se si tratta del guoba di Jueyun, qualunque sia il problema, sarà risolto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
