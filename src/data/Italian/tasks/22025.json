			"dialogs": [
				{
					"id": 220250301,
					"content": "Chi sarà mai? Mmmh... La signorina Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Uno strano gusto in bocca, poco appetito e nessuna voglia di mangiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "#È davvero perché ha mangiato qualcosa di strano? Ne siete sicur{M#i}{F#e}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Perché sembra solo che sia un po' gonfia? Mmmh, fammici pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Lasciamo stare, dato che non c'è modo di giudicare, l'unico piatto che posso suggerire è... la zuppa di germogli di bambù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "È saporita, la carne è tenera e il sapore è rinfrescante e appetitoso. Ma, cosa più importante, la zuppa favorisce la digestione. Mmmh! Come vorrei poterne mangiare un po' adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Credimi, l'unica cosa che serve ora a Tang Wen è la zuppa di germogli di bambù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
