			"trigger": {
				"objectNames": [
					"Tang Wen",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... che fame... Non mi sento bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "N-Non lo so... mi sento solo un po' lenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Forse è per via di ieri notte, quando sono tornata a casa e ho mangiato quel piatto delizioso che mi hai preparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Anche se il piatto era... piuttosto particolare, almeno ha riempito il mio stomaco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Volevo poi godermi un bella nottata di sonno e lavorare bene oggi, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Ogni volta che cercavo di addormentarmi, l'interessante aroma di quel piatto mi tornava improvvisamente alla bocca, svegliandomi all'istante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Ho passato tutta la notte così, rimanendo mezza addormenta fino al sorgere del sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Non è un grande problema se si tratta solo di dormire di meno. Ho già dovuto fare gli straordinari, in passato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "La questione principale è ciò che è successo oggi! Ho pensato che sarei stata bene, una volta che mi fossi svegliata e avessi mangiato qualcosa, ma non mi aspettavo di sentire ancora il sapore del piatto di ieri in bocca, anche dopo aver mangiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Quel piatto è davvero così forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "*sospira* Credo che... solo un piatto dal gusto unico possa lavare via quel sapore particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Un piatto dal gusto unico? Perché non andiamo in giro a chiedere agli altri se conoscono un piatto simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Così potremo prepararne uno per la signorina Tang Wen... Risolvendo forse il suo problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Davvero? Ma è fantastico, grazie davvero! S-Se potete, andate a Ritou e chiedete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Mi ricordo di... Li Xiao, un mercante di Ritou molto esperto di cibo, e Qiuyue della Società commerciale Chuyu, anche lei apprezza il buon cibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
