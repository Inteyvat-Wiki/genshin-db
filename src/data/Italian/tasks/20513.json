			"dialogs": [
				{
					"id": 205130101,
					"content": "Questa sembra piuttosto normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Hai un bell'aspetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Sì, beh, credo di essermi solo preso uno spavento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna migliora di giorno in giorno. Questo dottore è davvero bravo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Che ne dici di aiutarmi a trovare altri ingredienti? Questa volta, ci serve un'Asteria del vento fluttuante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Non sembra una medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Beh, le Asterie del vento a volte sono impiegate in medicina, ma solitamente servono a curare disturbi minori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Forse la chiave è il Melmoso di Anemo, anche se Melmosi di Anemo e Asterie del vento non si vedono spesso insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Fortunatamente, a Jack è già capitato di vederli un paio di volte, e mi ha riferito a grandi linee i luoghi dove trovarli. Lascia che ti segni sulla mappa dove si trovavano l'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Io non posso affrontare i Melmosi di Anemo, dal momento che riescono a volare... Posso contare solo su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Tipico di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Non me la sento di darti torto, ma Melmosi di Anemo e Asterie del vento non si vedono spesso insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Fortunatamente, a Jack è già capitato di vederli un paio di volte, e mi ha riferito a grandi linee i luoghi dove trovarli. Lascia che ti segni sulla mappa dove si trovavano l'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Io non posso combattere contro i Melmosi di Anemo, dal momento che riescono a volare... Posso contare solo su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "Catturerò un Melmoso di Anemo per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Vuoi solo guardarmi mentre mi copro di ridicolo, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Tuttavia, Melmosi di Anemo e Asterie del vento non si vedono spesso insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Fortunatamente, a Jack è già capitato di vederli un paio di volte, e mi ha riferito a grandi linee i luoghi dove trovarli. Lascia che ti segni sulla mappa dove si trovavano l'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130119,
					"content": "Se proprio non riesci a trovare questa Asteria del vento fluttuante, allora porta un Melmoso di Anemo. Farò qualsiasi cosa per Anna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
