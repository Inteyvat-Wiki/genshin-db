			},
			"dialogs": [
				{
					"id": 750321201,
					"content": "Cavalca il tuo Saurico a piena velocità lungo il percorso e totalizza il punteggio più alto possibile entro il tempo limite. <color=#00E1FFFF>Se superi il secondo punteggio più alto, la considereremo come una vittoria da parte tua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
