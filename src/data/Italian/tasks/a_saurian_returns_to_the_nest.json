			"dialogs": [
				{
					"id": 750320101,
					"content": "Bella vista, non trovi? Perfetta anche per volare. Solcare il cielo, seguire il vento... È una sensazione fantastica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Già.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "#Ehilà, {F#guerriera}{M#guerriero}! Se vuoi fare un volo di prova, fai pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "Anche se è stato mio padre a costruire questo posto, non ho problemi a condividerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Grazie, stavo proprio pensando di fare una prova!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "Non c'è assolutamente bisogno di ringraziare! Chi ama volare è amico di Manyoya! Manyoya sono io, tra parentesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "#Sembri un po' {F#piccina}{M#piccino} per la squadra volante. Sei {F#una}{M#un} riservista? O ti stai allenando per diventare {F#una guerriera}{M#un guerriero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "#Siamo solo {F#avventuriere}{M#avventurieri} di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "Eh? È raro vedere avventurieri così appassionati di volo. Francamente, fino a un momento fa pensavo volessi allenarti per l'esame di volo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "La prima volta che si vola nel cielo è una sensazione che non si dimentica mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Dubito esista anche solo un'anima che non si aggrapperebbe a quella libertà a tutti i costi, e io non faccio eccezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "Sembri sapere un sacco di cose. Fai parte della squadra volante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Ahah! Non più! Ora sono in pensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "Ho volato per molti anni... e anche se questo non mi rende vecchia in senso stretto, ero un'autentica veterana della squadra volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "Perciò, quando le mie condizioni fisiche sono peggiorate, è arrivato il momento di cedere il passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "Non dispiacetevi per me. Ahah! Non sono triste, anche se è un peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "I giovani Cavalcatori di Saurici hanno appena iniziato a spiccare il volo, mentre io ho già afferrato una stella cadente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Ovviamente le cose non saranno più le stesse, e non potrò trascorrere la maggior parte della mia giornata in cielo, ma ho ancora la possibilità di librarmi in volo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "Così, sono venuta qui per ripensare alla vita che ho lasciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Purtroppo volare senza compagni di squadra può essere abbastanza noioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "Che ne dici di volare con me? Nella squadra volante ci si sfida spesso per divertimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "Quello con il punteggio più alto viene lanciato in aria, mentre quello con il punteggio più basso offre da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "I vostri Cavalcatori di Saurici sembrano molto legati tra loro, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Sì, sono tutti fantastici. Siamo compagni di squadra, ma anche rivali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Ah! Non avrò mai più l'occasione di divertirmi in un ambiente del genere, e devo ammettere che le mie abilità sono inesorabilmente diminuite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "Ma anche se la mia forza fisica è in declino e il mio giudizio è meno vispo, l'esperienza non smette mai di accumularsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "Ho rinunciato alla squadra, non a volare in cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "Allora, facciamo a gara? Pensi di riuscire a tenere testa in volo a una Cavalcatrice di Saurici veterana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "Proviamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "#Ah. Per un attimo ero preoccupata che mi avresti presa per matta per aver parlato improvvisamente di queste cose con {F#una giovincella}{M#un giovincello} come te. Che sollievo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "Ma fammi sapere quando vuoi provarci. Poniamoci questo obiettivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "Cavalca il tuo Saurico e raggiungi il punto più lontano possibile lungo il percorso indicato nel tempo limite. Prenderò nota del tuo punteggio e i risultati saranno suddivisi in quattro gradi in base ai punti. Se riuscirai a superare il secondo grado più alto, avrai vinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "Fammi sapere quando vuoi cominciare la sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Fammici pensare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Grazie, ci penserò su quando ne avrò il tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Salve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
