				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Non è così semplice, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "#Il nostro capitano si arrabbierebbe molto se si sapesse che i membri della sua squadra volante si sono fatti superare da {F#un'}{M#un }{F#avventuriera}{M#avventuriere} di passaggio. Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Ah, beh, non c'è bisogno di preoccuparsi. Dovrei ringraziarti per aver salvato la mia autostima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "Hai volato piuttosto bene, ma è comunque troppo presto perché tu riesca a superarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Se pensi di poter fare di meglio, perché non ci provi di nuovo? Non dovresti mollare finché sei giovane. E comunque, non c'è niente di male a perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503209,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
