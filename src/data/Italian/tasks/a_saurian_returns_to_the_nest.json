			},
			"dialogs": [
				{
					"id": 750320901,
					"content": "#Mi è piaciuto volare con te! Dovremmo farlo di nuovo... Ma, fino ad allora, stai in guardia, giovane {M#avventuriere}{F#avventuriera}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503212,
