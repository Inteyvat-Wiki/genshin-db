						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "Allora, vuoi sfidarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Cavalca il tuo Saurico a piena velocità lungo il percorso e totalizza il punteggio più alto possibile entro il tempo limite. <color=#00E1FFFF>Se superi il secondo punteggio più alto, la considereremo come una vittoria da parte tua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "#Sono {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "Bene! Raggiungiamo il punto di partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "Ho bisogno di un altro po' di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "#Certo. Fammi sapere quando sei {F#pronta}{M#pronto}. Volare dev'essere principalmente divertente e rilassante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "Ahahah! Spettacolare! È proprio vero, i giovani sono destinati a superare noi vecchietti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Le stelle possono cadere, e tanto più le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "Il mio tempo è finito. Ritirarmi in tranquillità è stata la scelta migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "Ah... ma è così difficile da accettare. Sono ancora giovane, non ho nemmeno una ruga. Perché sono costretta ad andare in pensione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "Come ha fatto la mia carriera a finire così presto? La mia caduta è cominciata prima ancora che potessi toccare con mano la vetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "Sapevo che avrei avuto tanti rimpianti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Non importa. Se potessi fare tutto di nuovo, lo farei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "Darei ancora ogni cosa per unirmi alla squadra volante, cosa che non è poi così difficile considerate le mie capacità. E, dopo un po', andrei di nuovo in pensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "Ho fatto del mio meglio. Ora non posso far altro che accettarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "Immagino che la vita vada così. Molte cose sono al di fuori del nostro controllo, e se sogniamo di essere degli eroi, forse dobbiamo accettare che la nostra luce può brillare solo per un istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "Non preoccuparti, è fenomenale in volo. Hai avuto uno sguardo compassionevole per tutto il tempo, perché ora fai quella faccia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Ahah! La vita è piena di sorprese, e ti sorprenderà anche se non vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Considerala una perla di saggezza da parte di una Cavalcatrice di Saurici pensionata. I miei problemi sono affar mio, non lasciare che ti guastino l'umore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "Notevole. Se soltanto i miei fratelli fossero tanto calmi quanto te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "Hai fratelli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "Esatto. Due fratelli più giovani che, a differenza di te, sanno essere una vera rogna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "Anche loro si stanno addestrando per affinare le abilità di volo... Beh, no. Acomitl è concentrato solo sul fuggire da tutto, quindi potrebbe essersi nascosto da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "Lascia perdere quei monellacci. Vedo chiaramente il tuo talento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Se hai tempo, prova ad allenarti di più. Chissà, la squadra volante potrebbe bussare alla tua porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "#Buono a sapersi. Spero di rivederti volare in giro. Buona fortuna, giovane {F#guerriera}{M#guerriero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503206",
							"2"
						],
						"stepId": 7503206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "È ora che il mio Saurico faccia ritorno al suo nido. Forse farei meglio anche io scendere dal mio palcoscenico nel cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320602,
					"content": "Non smettere di volare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "Mi hai sentito borbottare tra me e me, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "Dovrei tornare a casa... Non ho ancora detto alla mia famiglia che ho lasciato la squadra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "Avrò molto tempo libero in questi giorni, ma non ho ancora deciso cosa farne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "Quando avrò capito dove andare, dovrò affrontare la fase successiva della mia vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "Per cui mi sembra giusto conoscere prima l'opinione della mia famiglia. Mio padre era nella squadra volante, e dopo il pensionamento è diventato un Capo istruttore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "Ci è passato anche lui, sicuramente avrà qualcosa da dire al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "Perciò, smantellerò questo posto e me lo porterò con me, ma lascerò il percorso. I giovani guerrieri come te hanno bisogno di un luogo dove allenarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Ci rivedremo, Manyoya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "Non ti so rispondere. Tuttavia, qualunque sia la scelta che farò, non credo che potrò mai rinunciare al cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "Quindi, finché continuerai a volare, credo che ci incontreremo ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "Alla prossima, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "#Ci vediamo, giovane {F#guerriera}{M#guerriero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320604,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "Ah, eccoti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503208,
			"completionStepIds": [],
