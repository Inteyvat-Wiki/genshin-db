			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "Il vento qui porta un sentore di salsedine e il lontano profumo legnoso delle navi mercantili... e porta anche notizie di vecchi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#Come vanno le cose, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Ne è passato di tempo, Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "La Crux è attualmente attraccata a Inazuma per effettuare rifornimenti. Ho deciso di cogliere questa rara opportunità per visitare la mia terra natale, ammirarne i panorami e i suoni, e ascoltare il vento che soffia qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "I venti di Ritou sono sempre più tumultuosi che altrove, intrisi di addii e ricongiungimenti, speranza e confusione... È un luogo dove si possono ascoltare innumerevoli storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Ti dispiace se ti scatto una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Eheh. Ogni cosa in questo mondo ha una sua forma, e lo stesso vale per il vento, sebbene lo si intraveda nelle foglie che cadono, nelle onde che si alzano o nel momento in cui le vesti di un viaggiatore svolazzano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Spero che la mia presenza ti permetta di dare forma a questa forza effimera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Ci siamo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "In tal caso, che tu possa scrivere il verso che meglio descrive questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Resta come eri prima e senti il vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Vorrei catturare anche il vento che soffia in questo momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
