			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#Ah, bene. Sei qui, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Da quanto tempo, Citlali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Ma per favore! Ogni tanto esco a fare due passi, grazie tante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "E in ogni caso, le mie divinazioni di ieri sera avevano predetto che mi sarebbero capitate cose buone se fossi uscita oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Se questo non è il compimento di tale predizione, allora non so cosa lo sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Allora, aggiungiamo un altro punto al bilancio positivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Beh, non è che non puoi... È solo che... due giorni fa ho fatto le ore piccole per finire l'ultimo volume della light novel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Quindi... Dammi un'occhiata veloce. Sto bene? Le occhiaie dovrebbero essere sparite ormai, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Stai benissimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Sul serio? Non stai scherzando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Giusto per tua informazione, terrò tutti gli scatti di cui non sarò soddisfatta. A te rimarrà solo il meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Sei radiosa come sempre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Ti scatto una foto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Che sorpresa! Oggi non dormi fino a tardi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
