	"talks": [
		{
			"id": 2050501,
			"completionStepIds": [
				2050501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050501",
							"2"
						],
						"stepId": 2050501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Mi dispiace disturbarti ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "Nessun problema, si prendono tutti cura di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Mi fa molto piacere. In tal caso, sarò breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Ti siamo molto grati per gli incarichi che hai portato a termine fino a oggi. Come risultato, la reputazione della Gilda si è invigorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Tuttavia, un'altra conseguenza è che stiamo ricevendo un numero di richieste senza precedenti... più di quante i nostri membri attuali siano in grado di gestire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "Vuoi che reclutiamo nuove leve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Aaah... no. Anche se apprezzo l'offerta... Sarebbe fantastico avere qualche nuovo membro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Ma al momento, reclutare ufficialmente nuove leve non risolverebbe i nostri problemi immediati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Perciò volevo chiederti... i tuoi amici avrebbero tempo di darci una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Dovrei chiederlo a loro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Ottimo. Per favore, fallo. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "In questo momento, abbiamo urgente bisogno di trovare qualcuno per le nostre <color=#00E1FFFF>spedizioni</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "Spedizioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Organizziamo spedizioni per esplorare le aree intorno alla città e nella natura incontaminata. È uno dei modi per tenerci informati su pericoli emergenti, attività insolite nei domini e così via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Dato che le spedizioni non sono commissionate da terzi, non abbiamo limiti di tempo ristretti per completarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Tuttavia, le stiamo tralasciando a nostro rischio e pericolo. Se dovessero insorgere dei problemi a causa della mancanza di controllo, le cose potrebbero facilmente trasformarsi in un disastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "Allora è molto importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Di certo i miei amici capiranno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Devi solo convincerli ad aiutare, dei dettagli mi occuperò io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "E ora, senza indugiare oltre, lascia che ti mostri le spedizioni attualmente disponibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Controlla le spedizioni",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "E il compenso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Ti garantisco che la Gilda non si approprierà del bottino delle spedizioni. Tutto andrà a te e ai tuoi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "Vuoi convincere tutti i miei amici a unirsi alla Gilda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "No, no, non intendevo questo. So che i tuoi amici provengono da situazioni molto diverse e chiedere loro di diventare membri ufficiali sarebbe improponibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "La mia richiesta è un po' più presuntuosa... Alla Gilda serve un favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "Nuova ricompensa in vista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Ahah... Hai indovinato! E presumo che ti interessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Puoi mandare qualcuno in spedizione in ogni momento, ma potrà comunque unirsi alla tua avventura se ne avrai bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "Poi anche scegliere la durata della spedizione. Una volta che il tuo amico avrà fatto ritorno, vieni a trovarmi per confermare i risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "Man mano che il tuo grado avventura aumenta, saranno disponibili spedizioni più pericolose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Dopotutto, da poteri epici derivano responsabilità epiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "E naturalmente, far corrispondere i rischi all'esperienza è un bene per la sicurezza di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "Grazie ancora del tuo aiuto, spero che tu e tuoi amici possiate offrire tutto l'aiuto possibile per le spedizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}