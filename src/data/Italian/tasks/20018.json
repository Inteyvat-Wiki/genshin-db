			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Magar terrorizzato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180301,
					"content": "Questa andrà bene. Dovrei riuscire ad aggiustare il carretto ora. Penso. O almeno spero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180302
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180302,
					"content": "#Oh no! Eccoli di nuovo! Aiutami, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
		{
			"id": 2001804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
