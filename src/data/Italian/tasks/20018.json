			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Magar terrorizzato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "#Grazie viaggiat{F#rice}{M#ore}. Uff, in un modo o nell'altro incasino sempre tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180102,
					"content": "Sono davvero un buono a nulla se non riesco nemmeno a portare un carretto di vino da un punto all'altro senza cacciarmi nei guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180103,
					"content": "Quelli del Vigneto mi licenzieranno se non metto la testa a posto... Sempre che Connor non mi stia già tenendo d'occhio. Uff, scommetto che mentre sto qui a parlare Elzer sta già scrivendo la mia lettera di licenziamento... Non c'è nessuna speranza, nessuna spe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180104,
					"content": "Con calma, con calma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "*sospira* Beh, anche se la mia situazione professionale è senza speranza, devo comunque portare a destinazione questo carretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180106,
					"content": "#E per di più il carretto è stato danneggiato... Viaggiat{F#rice}{M#ore}, puoi aiutarmi a trovare ciò di cui ho bisogno? Mi basterà un'<color=#00E1FFFF>asse robusta</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
		{
			"id": 2001802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
