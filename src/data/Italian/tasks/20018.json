				"objectNames": [
					"Magar terrorizzato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180201,
					"content": "Dovrebbe esserci un'<color=#00E1FFFF>asse robusta</color> nel bosco. Portamela quando la trovi, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
		{
			"id": 2001803,
			"completionStepIds": [
				2001804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
