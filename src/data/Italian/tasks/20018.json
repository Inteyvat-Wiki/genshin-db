			},
			"dialogs": [
				{
					"id": 200180601,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Questa andrà benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180602
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180602,
					"content": "Dovrebbe reggere fino al Villaggio Acquachiara. Lascerò le merci laggiù e poi tornerò al Vigneto per metterli al corrente di cosa è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180603
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180603,
					"content": "Spero che Elzer non mi licenzi quando vede cosa è successo al suo carretto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
