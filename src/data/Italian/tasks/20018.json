			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Magar terrorizzato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180401,
					"content": "#Fiuuu... Grazie al cielo sei qui, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180402,
					"content": "Ma ora non so più come fare per aggiustare il carretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180403,
					"content": "È tutto rotto... Immagino che dovrò rattopparlo in qualche modo. In ogni caso, non sarà una soluzione definitiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180404,
					"content": "Nessun problema. Mi basta che tenga fino in città, poi una volta arrivato potrò pensare al da farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180405,
					"content": "Pensavo ci fosse qualche corda sul carretto... Argh, devono avermela rubata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Magar terrorizzato"
				},
				{
					"id": 200180406,
					"content": "#Viaggiat{F#rice}{M#ore}... Potresti andare a dare un'occhiata nel bosco? Sarebbe perfetto se riuscissi a trovare una <color=#00E1FFFF>corda</color> nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
		{
