					"nextDialogs": [
						200180702
					]
				},
				{
					"id": 200180702,
					"content": "Uff... Grazie. Nel frattempo io... penserò a come aggiustare il carretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
