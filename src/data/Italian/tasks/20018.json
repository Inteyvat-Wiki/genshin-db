			},
			"dialogs": [
				{
					"id": 200180801,
					"content": "Mi dispiace, ma devo proprio andare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180802
					]
				},
				{
					"id": 200180802,
					"content": "No, non andartene, ti prego. Solo a provarci, farò un altro disastro. Ho bisogno di te. Sei la mia unica speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar terrorizzato"
				}
			]
		},
