			"dialogs": [
				{
					"id": 20030501,
					"content": "Secondo la lettera, il posto dovrebbe essere questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Siamo spiacenti, non serviamo il pubblico. Temo di dovervi chiedere di andarvene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "Un attimo! Non facciamo parte del pubblico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "Allora... a giudicare dal vostro abbigliamento... siete una coppia di stranieri erranti che si sono intrufolati nella nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "I nostri vestiti sono davvero così... oh! Ehm... Ciò che Paimon intende dire è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Ecco la nostra lettera d'invito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Uhm, il sigillo della Commissione Yashiro... deve provenire dal signor Thoma. Sembra che non siate dei semplici stranieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "In tal caso, vi do il benvenuto alla Sala da tè Komore, un rifugio sicuro per la Commissione Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Beh, così va decisamente meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
