					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330601,
					"content": "#Uff, ho perso di nuovo. Dopo essermi allenato tanto, non sono comunque riuscito a {F#batterla}{M#batterlo}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "È da una vita che te lo ripeto: non devi concentrarti solo sulla vittoria. Anche se, devo ammetterlo, ammiro la tua temerarietà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
					"content": "Beh, anche tu eri così fino a qualche anno fa. Mi seguivi ovunque, parlavi di voler diventare un grande Domatore di Saurici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330604,
					"content": "Smettila di prendermi in giro, Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Siete tutti dei bravi ragazzi, e anche degli abili guerrieri. E ogni guerriero deve affrontare sfide diverse in momenti diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330606,
					"content": "Ed è giusto così. Finché sarete a posto con la coscienza, io sarò sempre fiero di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
