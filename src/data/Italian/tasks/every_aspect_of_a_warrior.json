			"dialogs": [
				{
					"id": 750330101,
					"content": "Perché insistere ancora? Perché non posso semplicemente rinunciare...? Sai che c'è, io mi arrendo! Aiutami, Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Sei imbarazzante! Smettila di comportarti come un bambino e di arrenderti ogni volta che le cose non vanno esattamente come vuoi. Come puoi definirti un guerriero? Come fratello sei una vergogna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "Vuoi dirmi che non ti è mai capitato di essere in difficoltà e di aver bisogno di aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Sì, ed è per questo che sono qui a chiedere consigli sui frutti del mio addestramento speciale a nostro padre e a Manyoya. Non sono un codardo come te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, credo che il capitano abbia rifiutato la tua lettera di dimissioni perché voleva che ci pensassi ancora un po'. Non prendere decisioni così importanti preso dall'impeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Calmati e rifletti. La cosa più importante è che tu non finisca per pentirtene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Io sono in pensione, e neanch'io so cosa mi riserva il futuro, per cui temo di non poterti dare alcun tipo di indicazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Wow! Quindi siete tre fratelli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Non me l'aspettavo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "Voi due?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "#Chiedo scusa, {F#mia benefattrice}{M#mio benefattore}. Il mio piano di fuga è fallito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Ti pareva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Non c'è modo di evitare questa sofferenza? Essere un guerriero è estenuante. Perché non può essere tutto più semplice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Stai ancora pensando alla squadra volante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Mi dispiace, Acomitl. Purtroppo, secondo la mia esperienza, non è così che funziona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "Comunque, ho appena finito di riparare i parabraccia di Matahga. Anche i tuoi hanno bisogno di una sistemata, Manyoya? Mmh? Abbiamo ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "#Ah, sono {F#le avventuriere}{M#gli avventurieri} che abbiamo incontrato durante l'addestramento, papà. Hanno persino aiutato Acomitl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "È un piacere conoscervi, allora. Io sono Xueyoni, un Capo allenatore, nonché loro padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Capo allenatore, Clan Piumafiore"
				},
				{
					"id": 750330121,
					"content": "Acomitl sembra essere in condizioni terribili, fateci sapere se vi serve una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Grazie per l'offerta, ma penso che Acomitl stia benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Eh? Vuoi lasciarlo fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "#Ahah! Ecco... Diciamo così: voi siete {F#avventuriere}{M#avventurieri}, quindi dovete essere membri della Gilda, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Un'organizzazione fantastica. A voi avventurieri interessa esplorare il mondo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Ciononostante, immagino che ogni avventuriere abbia le proprie motivazioni. Alcuni vogliono guadagnare soldi, altri desiderano acquisire conoscenza, altri ancora non hanno semplicemente nulla da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "La Gilda degli avventurieri deve essere molto orgogliosa di aver unito così tante persone sotto un unico stendardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Prendete me, per esempio. Sono un vecchio andato in pensione dopo aver servito come Cavalcatore di Saurici nella squadra volante, per poi diventare un Capo allenatore nella nostra tribù. Eppure, non riesco a immaginare come sarebbe una Gilda con i colleghi di tutte e sei le tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Ehm... Questo cosa c'entra con Acomitl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "È così che nostro padre ci ha sempre spiegato le cose. Quando era ancora nella squadra volante, tutti, persino i Qucusauri, ascoltavano con piacere le sue opinioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Ora è un Capo istruttore per la nostra tribù, e chiunque voglia diventare un guerriero si rivolge a lui, quindi rilassati e ascolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "Eheh, il passato è passato, Manyoya. Ma concluderò la storia comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Noi Capi allenatori aspiriamo all'ideale del \"guerriero\". È per questo che ci impegniamo a creare e organizzare dei programmi di addestramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "Tutti abbiamo un \"guerriero dei sogni\" che speriamo di vedere, ma non sta a nessun singolo individuo stabilire che tipo di guerriero debba essere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Noi Capi allenatori non siamo riusciti a stabilire princìpi e regole precise, figuriamoci formare una vera e propria gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "Il \"guerriero più grande\" ha innumerevoli volti e personalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "A volte è molto determinato, altre volte viene morso dal dubbio, altre ancora si cruccia sulla vecchiaia e sulla morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "I guerrieri devono essere immuni alla fatica fisica e mentale? Posso mostrarti diversi rotoli di tessuto che dimostrano come il dubbio e la stanchezza affliggano tutti allo stesso modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Tutti i guerrieri sono enormi? Ne ho conosciuti molti che sembravano dei giganti, ma erano spregevoli oltre ogni dire. Anche loro sono presenti all'interno dei rotoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "E, ovviamente, ogni guerriero è destinato a diventare debole, un giorno, come dettato dalle leggi della natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "I miei figli mi definiscono un guerriero, ma guardami: non sono che un vecchio uccello che non sa più volare. Non ne ho più la forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Un guerriero dal volto perfetto, una persona che si confà a ogni noioso criterio, non verrà mai considerato un eroe qui a Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga, vi ho portati qui perché siate gli eroi del Clan Piumafiore, affinché possiate contemplare il mondo dall'alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Le vostre preoccupazioni e i vostri desideri sono stati mentali provvisori nel lungo viaggio di un eroe, non sono problemi che devono essere risolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Lasciare la squadra volante significa smettere di essere un guerriero? Unirsi alla squadra volante rende automaticamente un guerriero? Non esistono regole del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "Avere ambizioni, esitare e sentirsi persi è normale. Siete guerrieri, e ogni guerriero deve affrontare delle prove per diventare un eroe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Accettate chi siete, imparate a convivere con questo stato e trovate un modo per superarlo, non lasciatevi controllare da esso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "Questa è la via di Natlan, la via degli eroi. Avete capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Ho capito, Padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Acomitl, stai ancora esitando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Le ramanzine non sono mai state nello stile della nostra famiglia. Vai a volare con tuo fratello e tua sorella, come facevi quando eri piccolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Lascia che la tua mente e il tuo corpo ti aiutino a decidere. Rimanere rintanato in casa a rimuginare non ti porterà da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Chiaro, Padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#I Capi allenatori sono sempre così astratti? Paimon non ci ha capito niente. E tu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Beh, in pratica, si tratta di organizzare una sfida di volo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "#{F#Avventuriera}{M#Avventuriere}, i miei figli mi hanno parlato di te. Sei proprio {F#una}{M#un} giovane interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "#Hai avuto il coraggio di competere contro Manyoya, di aiutare il piccolo Acomitl... e hai persino ottenuto l'approvazione di Matahga. Sei {F#una vera guerriera}{M#un vero guerriero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Vorrei volassi coi miei ragazzi. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Non mi tiro indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Ahah, va bene. Quando avrai deciso, faccelo sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Tutti e tre i miei figli sono tra i migliori aviatori del Clan Piumafiore. Sono sicuro che vi divertirete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Ci devo pensare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "No. Le tecniche educative della famiglia sono troppo profonde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Pff.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Era ovvio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
