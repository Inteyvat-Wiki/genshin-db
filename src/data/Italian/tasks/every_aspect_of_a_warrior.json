			"dialogs": [
				{
					"id": 750330501,
					"content": "Ahah! Mi spiace, stavolta l'ho spuntata io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330502
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330502,
					"content": "Bah, Matahga, sei una spina nel fianco... Fai sempre così, dai il massimo sempre a scoppio ritardato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330503
					],
					"speakerTitle": "Acomitl"
				},
				{
