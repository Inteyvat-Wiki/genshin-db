					"nextDialogs": [
						750330802
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330802,
					"content": "La fiducia in te non ti manca. Forza, Acomitl. Non possiamo perdere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330803,
					"content": "Perdere contro di te non mi pesa, ma contro Matahga sarebbe inaccettabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330804
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330804,
					"content": "#{NICKNAME}, anche tu dovresti impegnarti al massimo. Non lasciarti ingannare dai trucchetti di Matahga, è la sua strategia tipica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330805
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330805,
					"content": "#Quando ti senti {F#pronta}{M#pronto}, fammi sapere e andiamo a volare insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acomitl"
