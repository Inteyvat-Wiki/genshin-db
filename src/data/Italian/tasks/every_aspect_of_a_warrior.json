			},
			"dialogs": [
				{
					"id": 750330401,
					"content": "Un volo coi fiocchi, giovane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330402,
					"content": "Come sono andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330403,
					"content": "Alla grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "Grazie dell'incoraggiamento, ma si vede che sei di un livello superiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330406,
					"content": "Acomitl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330407,
					"content": "Non è come credi. Non sono scoraggiato perché non riesco a superare gli altri. So volare, ne sono consapevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330408,
					"content": "Tuttavia, essere in cattiva forma così a lungo ha dato un brutto colpo alla mia autostima. Non riesco proprio a volare con calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME} è {M#diverso}{F#diversa}. La sua postura è molto più rilassata. Chiunque abbia gli occhi se ne renderebbe conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330410,
					"content": "Padre, so che tu e Manyoya volete che mi decida e che non continui a evitare il problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330411,
					"content": "Ma se adesso ti dicessi che il mio corpo, il mio cervello o il mio cuore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330412,
					"content": "Si rifiutano tutti di continuare su un sentiero che non è destinato a me... mi supporteresti lo stesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330413,
					"content": "Non c'è problema, a patto che sia una tua scelta personale, e che tu sia pronto a subirne le conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330414,
					"content": "Matahga, tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330415,
					"content": "Ehi! Non ti criticherò in un momento come questo. Ho sempre saputo che tipo di persona sei, Acomitl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330416,
					"content": "Se è qualcosa che senti di non riuscire a sostenere, allora devi lasciartelo alle spalle. Finché resti coerente con te stesso, resterai sempre un guerriero. Nessuno ha il diritto di criticarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330417,
					"content": "A volte, in quanto Capo allenatore, il mio lavoro è alquanto facile: mi basta elaborare dei piani di addestramento per i guerrieri, ma non ho bisogno di partecipare di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330418,
					"content": "Tuttavia, anch'io ho volato coi Saurici, per anni, e conosco lo stile di vita che ne deriva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330419,
					"content": "Criticare gli altri è facile, ma agire è assai arduo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330420,
					"content": "In qualità di Capo allenatore, ti suggerisco di chiedere qualche giorno per riposare sia fisicamente che mentalmente, anche se questo causerà dei malumori all'interno della squadra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330421,
					"content": "In quanto tuo padre, so che non vuoi continuare, e rispetto la tua scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330422,
					"content": "Non fare più parte della squadra volante non è la fine del mondo. Non è solo tramite il volo che i guerrieri del Clan Piumafiore dimostrano il proprio valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330423,
					"content": "Grazie... Avevo paura che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330424,
					"content": "Non pensarci troppo. Siamo la tua famiglia, ti aiuteremo sempre a trovare la strada, qualsiasi cosa accada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330425,
					"content": "Essere un guerriero sembra dura! Paimon non avrebbe mai immaginato che fosse così difficile entrare a far parte della squadra volante del Clan Piumafiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330426,
					"content": "Ognuno ha le proprie difficoltà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "Aah, hai ragione! Se ci pensi, anche noi abbiamo superato un sacco di ostacoli finora. Non ti viene un certo moto d'orgoglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330430,
					"content": "E se diventare un guerriero non è facile di per sé, diventare un eroe è ancora più difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330431,
					"content": "Ne ho visti talmente tanti, di guerrieri, che capisco immediatamente chi ha le qualità per essere un eroe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330432,
					"content": "Hai affrontato molte peripezie, giovane, non è così? Lo vedo nei tuoi occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330433,
					"content": "Più di quanto pensi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "#C'ho visto giusto, a quanto sembra. Il tuo cammino è diverso dal nostro, e sembra che tu abbia ancora molta strada da fare. Sarei felice di poter aiutare {F#una futura eroina}{M#un futuro eroe}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330436,
					"content": "E poi, hai già incontrato e aiutato la nostra famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330437,
					"content": "Fammi sapere se vuoi usare il percorso di allenamento. Puoi decollare da qui in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330438,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "#Figurati. Anzi, non vedo l'ora di assistere al momento in cui diventerai {F#una luminosa eroina}{M#un luminoso eroe} del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330434,
					"content": "(Rimani in silenzio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "Non tutti hanno la stoffa del guerriero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "È un'affermazione severa, ma sensata. Oh, beh, Paimon non voleva comunque diventarlo, visto che poi le sarebbe toccato allenarsi ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330404,
					"content": "Non male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				}
			]
		},
		{
			"id": 7503305,
			"completionStepIds": [
				7503306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
