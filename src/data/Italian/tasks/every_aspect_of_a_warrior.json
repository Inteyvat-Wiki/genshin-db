			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Vieni a volare con i miei ragazzi, giovane. Non capita tutti i giorni di poter gareggiare con i migliori aviatori del Clan Piumafiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Insegui la <color=#00E1FFFF>torcia volante</color> lungo il percorso. Chi la acchiappa per primo vince. È così che li ho addestrati quando erano piccoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>La torcia è sostenuta da un pallone decorato da piume rosse</color>, che simboleggia la responsabilità e l'onore che un guerriero dovrebbe portare. L'ho preparata per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "Quando la vedrai, capirai cosa intendo. Allora? Vuoi partecipare alla gara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "#Sono {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Ahah, fantastico! Raggiungiamo il punto di partenza e prepariamoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "Ho bisogno di un altro po' di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "#Fammi sapere quando sei {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
		{
			"id": 7503304,
			"completionStepIds": [
				7503304
