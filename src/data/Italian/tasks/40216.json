			"dialogs": [
				{
					"id": 766530501,
					"content": "Uhm... Dovrei continuare la mia ricerca o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "Questo cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Robospia Zip-zap n. 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Zip-zap che cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Per essere più precisi, è una piattaforma di collaudo per Robospia Zip-zap n. 1, l'ultima creazione progettata da Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Di recente ha acquistato un robot pulitore abbandonato sul mercato nero. Dopo averlo modificato, ha creato Robospia Zip-zap n. 1, il robot che avete davanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Questa piattaforma ha simulato diversi ambienti ostili per testare la capacità del robot di restare nascosto in situazioni avverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Perché Aino sta creando di nuovo un robot furtivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Dopo il furto di Krum-tin 70% di zucchero, Aino ha preso una decisione e fatto la seguente dichiarazione: \"Non importa quanto sia potente il nemico, i nostri amici vanno salvati sempre!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Così ha completato in fretta il progetto di Robospia Zip-zap n. 1 e ha iniziato subito a svilupparlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "Secondo il suo piano, una volta completato lo sviluppo, dovrebbe riuscire a infiltrarsi con facilità persino nell'altamente sorvegliato Istituto di Progettazione sperimentale del Kuuvahki per poter salvare i nostri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Sembra veramente notevole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Tuttavia, Aino si è accorta che perfezionare il piano le avrebbe richiesto troppo tempo, così ha abbandonato l'idea. Secondo i suoi calcoli, mettere a soqquadro tutta Nod-Krai sarebbe stato comunque il metodo più veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Ho deciso! Visto che dobbiamo procedere con calma, continuerò a lavorare su Robospia Zip-zap n. 1! Ci aiuterà di sicuro a salvare i nostri amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "In tal caso, possiamo chiedere a voi due di aiutarci con i test?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "In base alle statistiche passate, se altri collaudatori forniscono dei dati di riferimento, la velocità di Aino nello sviluppo subisce un aumento del trenta per cento circa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "A Paimon va bene! Sembra divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Do una mano anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Allora vi ringrazio a nome di Aino. Vi darò accesso alla piattaforma. D'ora in poi, potrete usarla per condurre test di qualsiasi tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}