			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Lyylikki, come vanno le cose ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Ah! Salve, Lady Lauma. Ultimamente fila tutto liscio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "Abbiamo un costante rifornimento di ingredienti, nessuno sta causando problemi, e le mie abilità culinarie sono migliorate di molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Ah, a proposito, quegli \"amici\" di cui parlavi l'altra volta... ti riferivi a quegli animali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Si comportano così bene e osservano in silenzio le persone in fila. Ho provato a offrire loro qualcosa da mangiare, ma non l'hanno voluto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Quei piccoli sanno quali sono i loro doveri. Quando sono di turno, mantengono la concentrazione e restano al loro posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Comunque, quando non sono in servizio, sentiti libera di dar loro qualche snack. Eheh, sono sicura che ne sarebbero felicissimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Perfetto! Allora oggi preparerò qualcosa di delizioso per mostrare la mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Grazie, Lyylikki. Se dovessi aver bisogno di aiuto, non esitare a comunicarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Non serve, davvero! Ho tutto sotto controllo... E poi, il signor Kantor e la signorina Jahoda mi stanno dando una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Va bene allora, ti lascio al tuo lavoro. A dopo, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Ah, dovrei portare gli altri piatti... Oh, Lady Lauma, vorrebbe assaggiare anche questo piatto? Ho appena finito di cucinarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Va bene, ora devo servirlo su un piatto... Eh? Dove sono i piatti che ho appena lavato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}