				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Ma guarda un po'! Chi altro se non {NICKNAME} e Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650102,
					"content": "Ci conosciamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Non essere così insensibile, non mi scorderò mai quello che hai fatto per me quella volta lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650105,
					"content": "Quella volta lì... Ah! Abbiamo ancora così tante domande da farti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "D-Davvero? Uff, oh, cosa c'è? La mia memoria mi fa gli scherzi! Mi chiedo cosa sia successo quella volta? Non mi ricordo niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650107,
					"content": "Dice il saggio che è meglio guardare al futuro che al passato. Parliamo della nostra collaborazione futura, e dimentichiamoci del passato, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650108,
					"content": "Ho dei lavori sotto mano che pagano abbastanza bene, ma non ho nessuno che venga ad aiutarmi. Se non avete altro da fare, vi piacerebbe provarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650109,
					"content": "Umpf! Non pensare che abbocchiamo facilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "E quanto pagano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "È per questo che mi piace parlare di affari con gente come te. Com'è che si dice? Ah sì, sei sempre sul pezzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650113,
					"content": "Magari propongo una cifra che vi soddisferà sicuramente...eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650114,
					"content": "Cento Coupon! Mica male, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650115,
					"content": "Cento?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Mmm, capisco, vedo la commozione per tanta generosità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650117,
					"content": "Con cento non ci compriamo nemmeno un tappo di sughero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "Esatto! Paimon non riesce a credere che abbia avuto il coraggio di offrirci così poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "Non sono abbastanza generoso? Voi giovinastri... Non sapete proprio cosa sia buono per voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650122,
					"content": "Dovreste saperlo, ci sono orde di poveracci che darebbero un braccio per un lavoro così facile e redditizio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650123,
					"content": "Décembre, viscido imbroglione, finalmente ti ho preso! La volta scorsa che ti ho beccato dalle parti dell'ufficio della corrispondenza, imbrogliavi i nuovi arrivati, offrendogli degli incarichi per una frazione della tariffa effettiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME} e Paimon? Non ci siete cascat{F#e}{M#i}, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "#Sono devastat{F#a}{M#o}... Siamo già stat{F#e}{M#i} ingannat{F#e}{M#i} una volta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "*sospira* Allora è troppo tardi per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Comunque, non credete a una parola di quello che dice. Prende di mira i nuovi arrivati, o chiunque non sappia le regole, e lo truffa. La lista di vittime è già lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "Ma quale truffa e truffa... Mi descrivi come una persona terribile. Siamo davvero così diversi? Voi guardie non offrite Coupon in cambio di lavoretti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650132,
					"content": "Non ci intaschiamo una parte del loro compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "A che ti riferisci? Non calunniarmi senza nessuna prova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Décembre"
				},
				{
					"id": 740650134,
					"content": "Oh, vuoi delle prove? Va bene. L'isolamento è silenzioso e spazioso, il luogo perfetto per visionare tutte le prove che vuoi. Davvero, ho ancora da fare al Tunnel dei geodi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#Oh, {NICKNAME} e Paimon. Non è che potreste aiutarmi, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "Ehi, guarda che neanche noi abbiamo tutto il tempo del mondo, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "Se la paga è buona, faccio quello che vuoi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "#Ahah! Ovviamente sarete pagat{F#e}{M#i} come da regolamento. Di certo conoscete gli standard, e saprete che non tenterò in alcun modo di truffarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Comunque, ci sono degli Aberranti del Fontemer che sono stati avvistati nel Tunnel dei geodi... Potrebbero rivelarsi una minaccia se non ce ne occupiamo al più presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Porterò prima questo tizio in isolamento, ci vorrà un po' per affidarlo ai miei colleghi... Vi raggiungo più tardi, non appena ho finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Va bene, ma non metterci troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Farò del mio meglio, ma le procedure burocratiche purtroppo prendono il tempo che prendono. Affido il Tunnel a voi, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Ma non questa volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "Questa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Oh... Degli eventi si sono verificati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "Ti darò io 100, tu lavori e io guadagno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Woah! Avevi questo in mente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "Ho una brutta sensazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
