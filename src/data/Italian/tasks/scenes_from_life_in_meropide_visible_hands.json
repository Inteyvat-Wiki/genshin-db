			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Ma ti sembra l'ora di arrivare? Abbiamo appena finito di scacciare via tutti gli Aberranti del Fontemer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Quindi finalmente è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "Che cosa? Di che parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "Sono arrivato dove dovevo e ho trovato il lavoro già finito da un'altra persona, ovviamente! Cioè, non ho più niente da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "Ecco a voi. Grazie infinite per l'aiuto! Confido che stanotte riuscirò finalmente a farmi un bel sonno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
}