				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "Mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490302,
					"content": "Tsuyuko...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "Oh, chiedo scusa. Ero persa nei miei pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490304,
					"content": "Grazie al vostro aiuto, ora siamo in possesso della Chiave delle Profondità seleniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490305,
					"content": "Profondità seleni... Che?! Di che stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490306,
					"content": "Eheh, chiamiamola semplicemente \"Chiave delle Profondità\". Non siete del posto, non pretendiamo che conosciate alla perfezione i termini completi per tutte le nostre tradizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490307,
					"content": "Servirà ad aprire l'entrata di Enkanomiya. È stata forgiata con il sangue versato dal nostro Omikami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490308,
					"content": "O così dicono le leggende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490309,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490310,
					"content": "Il mistero si infittisce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "Eheh! Nessun mistero, anzi al contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490312,
					"content": "Bene, non resta che parlare con la Sacerdotessa divina, attendere la sua approvazione e poi cogliere il momento più propizio del flusso nelle vene spirituali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490313,
					"content": "A quel punto, potremo raggiungere Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490314,
					"content": "Aspetta, ma allora perché abbiamo fatto tutto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490315,
					"content": "Beh, il percorso in sé vi ha dato tanto, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490316,
					"content": "Voglio dire... Avete consolidato un solido rapporto con il Santuario dei Sangonomiya! L'Isola di Watatsumi vi accoglierà nuovamente quando lo vorrete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490317,
					"content": "Non ci sarebbe qualcosa di più concreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490319,
					"content": "Si dice che le Perle spirituali risponderanno solo alla chiamata di un'anima candida, e che la Chiave apparirà solo dinnanzi a un cuore puro come le acque più cristalline.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490320,
					"content": "Di solito non do molto peso a quei testi, ma di una cosa sono convinta: tu puoi dare una svolta alla situazione attuale sull'Isola di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490321,
					"content": "Che dire... Quando sarà il momento di raggiungere Enkanomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490322,
					"content": "Ci incontreremo ancora, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "D'accordo, a presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490323,
					"content": "Estrarrai un altro omikuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "Eheh, ne ho già ricevuto uno fortunato. Ci rivedremo, non ho dubbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
