			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Bentornat{F#a}{M#o}, {NICKNAME}. Posso fare qualcosa per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "Riguardo all'incarico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "Abbiamo le quattro Perle spirituali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "Davvero? Sapevo di poter contare su di voi, grazie mille! Allora siamo all'ultimo passaggio prima di poter sbloccare il sigillo del cuore, ovvero quello finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "Mi spiace, ma dovrò chiedervi di accompagnarmi. Spero non vi dispiaccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#Beh, fatto trenta facciamo trentuno! Giusto, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "Non c'è tempo da perdere. Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "D'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
