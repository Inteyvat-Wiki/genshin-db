			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yelan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280701,
					"content": "Non si mette affatto bene, non ancora sembra esserci una via di fuga. Prepariamoci mentalmente a rimanere quaggiù piuttosto a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Per fortuna le scorte non mancano e il nostro gruppo, variegato e carico di teste calde, nel momento del bisogno sembra comunque in grado di mantenere la calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Prendetevi cura di voi, al resto ci penso io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
		{
			"id": 102808,
			"completionStepIds": [
				102806,
				102807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102807",
							"2"
						],
						"stepId": 102807,
						"stateName": "QUEST_STATE_UNFINISHED"
