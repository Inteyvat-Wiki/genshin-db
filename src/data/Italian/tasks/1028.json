				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "Ora basta, voglio dare un'altra occhiata. E stavolta il Solo e oni-co Arataki Itto, cioè il sottoscritto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "Capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "Ohi! Che succede, brontolona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "Melonlavanda arrosto in arrivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "Cosa? Siamo intrappolati sottoterra, è questione di vita o di morte e tu... osi darmi del Melonlavanda arrosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "Muu, muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "Interessante... Sentito? Ushi dice che hai ragione... Però aspetta, non ho capito da che parte stai, \"Bel manzo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Muu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "È fondamentale rifornirsi di energie, così da mantenere alto il morale in previsione dell'ignoto che incombe su di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Perfino Ushi lo capisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "D'accordo... Ehi, avete iniziato senza di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Un secondo, è ancora caldo? Mmm, che profumino, in effetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "Va bene, uno spuntino veloce e poi riprendiamo la ricerca di una via d'uscita. Non spazzolate via tutto, lasciate qualcosa anche per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		}
	]
