				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "C-Cosa? No, aspetta, così non va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280402,
					"content": "Eh? Come abbiamo fatto a tornare qui?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280403,
					"content": "Siamo già stati qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280404,
					"content": "Certo, è il punto da cui siamo partiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280405,
					"content": "Ma è impossibile, non abbiamo mai cambiato direzione, né svoltato, né tantomeno abbiamo fatto dietrofront...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280406,
					"content": "Ho pensato la stessa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280407,
					"content": "#Viaggiat{F#rice}{M#ore}, stavamo andando dalla parte giusta, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280408,
					"content": "Sì, o almeno è quello che pensavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280410,
					"content": "A Inazuma si narra la leggenda di un mercante ingannato da un bake-danuki. Una sera ha iniziato a girare in tondo nello stesso luogo, per tutta la notte e fino all'alba, senza mai trovare una via d'uscita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280411,
					"content": "Sì, anche Paimon l'ha sentita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280412,
					"content": "Allora la conosci? Bene, perché penso sia esattamente ciò che sta succedendo a noi in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280413,
					"content": "Niente paura, però. Ho uno scagnozzo in grado di esorcizzare youkai, spiriti eccetera. Adesso lo evoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280414,
					"content": "Incredibile... Un oni amico di un esorcista... Di sicuro è uno di ampie vedute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280415,
					"content": "Diciamo che la frase \"beata ignoranza\" si applica bene al capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280416,
					"content": "Forza, Ushi, cattura quello spirito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280417,
					"content": "Muu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280418,
					"content": "Ecco Ushi, un membro ausiliario della Banda di Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280419,
					"content": "Muu, muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280420,
					"content": "Ahah, Ushi ha salutato tutti quanti. Potete chiamarlo \"Ushi\" o \"Bel manzo\". Se ve lo state chiedendo, sì, ha un ottimo senso dell'orientamento, quindi lascerò che sia lui a guidarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280421,
					"content": "Non sapevo esistessero i membri ausiliari nelle bande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280422,
					"content": "Questa idea non sembra esattamente destinata al successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280423,
					"content": "Mi hai tolto le parole di bocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280424,
					"content": "Coraggio, Ushi, all'opera! Trova l'uscita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280425,
					"content": "Muu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280426,
					"content": "Ushi inizia a cercare un'uscita nascosta nei paraggi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Muu... Muu, muu... Muu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280428,
					"content": "Eh? Come dici? Sul serio?!? Ma dai, non ci credo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280429,
					"content": "Qualcosa non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280430,
					"content": "Ushi dice che ha cercato ovunque, ma non ci sono uscite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280431,
					"content": "Eppure non ha senso... Se siamo riusciti a entrare, ci sarà anche una via per uscire. Fammi dare un'altra occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280432,
					"content": "Non so se avete notato che all'inizio pensavamo di essere precipitati qui dall'alto, e infatti lassù s'intravedeva un varco. Ora invece sembra sparito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280433,
					"content": "È inspiegabile, a mio parere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280434,
					"content": "A quanto pare, queste strutture sotterranee nascondono vari segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280435,
					"content": "Darò un'altra occhiata in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280436,
					"content": "Ci sono solo rocce e ancora rocce, a perdita d'occhio. E se ci fossimo sbagliati? Magari non è davvero il posto dove siamo finiti all'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280437,
					"content": "Non dirmi che hai paura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280438,
					"content": "N-No, Paimon è coraggiosissima...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280439,
					"content": "Muu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280440,
					"content": "Ah, sì? Beh, anche secondo Ushi sei spaventata, invece. Non c'è problema, però, basta che lo ammetti. Ci siamo noi qui a proteggerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280441,
					"content": "Ci sono qua io, Paimon, tranquilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#Non possiamo restare qui a girarci i pollici, continuiamo a cercare una via di fuga. Shinobu, tu resta qui con la mia salvatrice. Io andrò in esplorazione con {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280443,
					"content": "Capito. Fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280444,
					"content": "Ti prego di non chiamarmi \"salvatrice\", va benissimo Yanfei. Signor Arataki, in quanto capo della Banda di Arataki sembri possedere un innato senso di responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280445,
					"content": "Sei troppo gentile. Chiamami pure Itto, in fondo ora siamo una squadra e dobbiamo darci man forte. Paimon, la prossima volta che hai paura dimmelo, così ti copro gli occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280446,
					"content": "Vi dividete in gruppi per indagare nei dintorni, ma non trovate nulla...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "...*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280448,
					"content": "Non sembra esserci una via di fuga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280449,
					"content": "Muu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280450,
					"content": "Eppure ho ancora la sensazione che ci sia qualcosa di strano, in questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280451,
					"content": "Capo, avete trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280452,
					"content": "Macché, niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "E, come se non bastasse, potrei giurare di aver intravisto con la coda dell'occhio alcune ombre che si muovevano... Spero che questo posto non sia infestato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280454,
					"content": "Forse non è ideale chiederlo ora, ma Paimon non resiste... Itto, tu sei un oni... in pratica rendi infestato qualunque luogo in cui ti trovi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280455,
					"content": "Piantala! Lascia perdere le corna rosse, ok? Io pensavo a fantasmi spaventosi e fluttuanti, che appaiono e scompaiono... Quella roba lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280456,
					"content": "Mmh... Itto, per caso hai... paura dei fantasmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280457,
					"content": "Ohi, capo... Ti hanno scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280458,
					"content": "Ma chi, io? Ahah, figuriamoci! Sei seria? Basta con gli scherzi, d'accordo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280459,
					"content": "Eheh, che ridere! Paimon improvvisamente non ha più paura! Ehi, Toro sdraiato, se hai paura... Paimon può coprirti gli occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280460,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280461,
					"content": "Penso di poter utilizzare meglio il mio tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280462,
					"content": "(Mm... Shinobu è andata a prendere delle pietre, alcuni ramoscelli e i Melonlavanda che aveva con sé... Ma cosa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "Un po' di sale, un pizzico di pepe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280464,
					"content": "Stai arrostendo i Melonlavanda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Sì, i Melonlavanda arrosto sono deliziosi. Assaggiali, non appena saranno pronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280466,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Ne esistono di due tipi, dolci e salati. Quali preferisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280468,
					"content": "Vanno bene entrambi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "D'accordo, allora faremo un po' e un po'. L'importante è mantenere la calma, soprattutto quando ci si trova in situazioni del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280470,
					"content": "#Non so se la mia lettura della vicenda sia corretta, ma credo ci siano dei segreti qui che né io né il capo dovremmo conoscere. Non temere, farò in modo di distrarlo, così potrai discuterne con {F#le altre}{M#gli altri}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280471,
					"content": "Oh, l'olfatto non mi ingannava, stai davvero cucinando qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280472,
					"content": "Ne vuoi un po', Yanfei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280473,
					"content": "Non ho fame, ma ti ringrazio. Voi servitevi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280474,
					"content": "Comunque non c'incontravamo da parecchio, Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280475,
					"content": "Già, è passato un po' di tempo, vero? L'ultima volta che ci siamo viste, hai fatto una supplenza in uno dei miei corsi, quando studiavo a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280476,
					"content": "Supplenza... Ah sì, ora ricordo. Era inverno, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280477,
					"content": "Sì, ricordo che tutti avevano trovato la tua lezione interessantissima. Ora che ci penso, dovrei usare il titolo di \"senpai\", quando mi rivolgo a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280478,
					"content": "Oh, mi piace come suona! Eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280479,
					"content": "Chi avrebbe mai pensato che ci saremmo ritrovate insieme in una situazione simile... Il destino a volte è strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280480,
					"content": "Quindi Yanfei tiene anche dei corsi? Incredibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Certo, e il suo modo di spiegare risulta simpatico e coinvolgente. Insomma, gli studenti la adorano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280482,
					"content": "Ahah, quanti complimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280483,
					"content": "Vedo che siete ancora tutti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280484,
					"content": "Yelan, ci siamo divisi in gruppi per perlustrare l'area, però nessuno ha trovato una via di fuga. Tu invece hai avuto più fortuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280485,
					"content": "No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280486,
					"content": "Preferirei non doverlo ammettere, ma... Faremmo meglio a prepararci mentalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280487,
					"content": "Qualora non trovassimo mai un'uscita, rimarremmo quaggiù per... molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280488,
					"content": "Immagino tu abbia ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280489,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280490,
					"content": "Mm... Uno spazio sotterraneo con un'entrata, ma privo di uscita... Non ha senso. Capirò come uscirne, ma mi serve del tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280491,
					"content": "Se qualcuno avvista una potenziale via di fuga, presti la massima attenzione prima di proseguire con l'esplorazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280492,
					"content": "(A ben pensarci, anche Xiao è qui. Si raccomanda sempre di chiamarlo, in caso di difficoltà.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(Forse vale la pena provare...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "#Ehi, viaggiat{F#rice}{M#ore}, perché quella faccia? Hai un piano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280495,
					"content": "Stavo solo pensando che anche Xiao è qui, ricordi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Xiao... Oh, giusto! Vuoi chiedergli di aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280497,
					"content": "Penso ne valga la pena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Certo, facciamo un tentativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280499,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Xiao, riesci a sentirmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280502,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Ehm... Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Nessuna risposta... Paimon pensava che Xiao ci avrebbe raggiunti perfino quaggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280505,
					"content": "Oh, no... Forse Xiao non riesce a percepire la nostra presenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280506,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Mi chiedo cosa significhi... Che razza di posto è mai questo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 102806,
