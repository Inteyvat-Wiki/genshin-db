			"dialogs": [
				{
					"id": 250201101,
					"content": "È lì, vicino a una piscinetta, guarda caso. Se riusciamo ad attirarlo là dentro, possiamo metterlo a mollo e dargli una bella lavata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201102,
					"content": "Ma se venissi anch'io mi noterebbe di sicuro. Ti andrebbe di andarci solo tu? Ti basterà mettere la Fluttipalla al centro dell'acqua. So che posso fidarmi di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201103
