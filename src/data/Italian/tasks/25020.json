				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora! Fa' il bravo, adesso, non ti muovere! Diamo giusto una pulitina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "*piagnucola* Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Suvvia, piccolino. Perché non ci facciamo un bel bagnetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Guarda, lì c'è proprio una piscinetta d'acqua che fa al caso nostro. Una volta che sarai ripulito, potremo ricominciare a giocare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "Ehi, aspetta! Non scappare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "M-Ma che roba era?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "#Siete {F#venute}{M#venuti} a visitare la nostra tribù? Vi chiedo scusa per Hora. Di recente sprizza energia da tutti i pori, e non fa che correre avanti e indietro. Non vi avrà spaventato, spero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Lo stavi costringendo a lavarsi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Costringendo? *sospira* Direi supplicando, piuttosto. Ogni volta che esce a giocare, torna completamente ricoperto di fango, considerando quanto ha piovuto nei giorni scorsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Sto provando a dargli una ripulita, ma non riesco a tenerlo fermo. Vuole solo correre e giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Ma non ho qualità atletiche, come faccio a stargli dietro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Hai provato ad attirarlo con del cibo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Come no! Ci ho provato più volte, ma credo fiuti le mie intenzioni e, finché vede che sono nelle vicinanze, finge disinteresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Se poi distolgo lo sguardo anche solo per un attimo, ecco che scatta, ingurgita tutto in mezzo secondo e riprende a fuggire di gran carriera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Un Tepetlisauro in tutto e per tutto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Proprio così! E non oso immaginare cosa potrà combinare una volta cresciuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Spero solo che non gli venga in mente di distruggere il negozio di Cheven... Non potrei mai ripagare una tale quantità di gemme danneggiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "*sospira* Finirò per provare l'idea di Batz, credo. Ma davvero un Tepetlisauro può essere interessato a questa palla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Chi è Batz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Ah, è la persona della tribù incaricata di badare ai Tepetlisauri. Un tipo in gamba nonché un vero esperto di musica. Sta simpatico a tutti, sia umani che Saurici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "L'ultima volta che glie ne ho parlato, ha tirato fuori un progetto per realizzare ciò che lui ha chiamato \"Fluttipalla\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "È un progetto che gli ha passato a sua volta Mataoho. Mi ha suggerito di creare una palla simile per Hora, sembra che piaccia molto ai piccoli Saurici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Ho raccolto i materiali e stavo per mettermi al lavoro, ma poi Hora ha ripreso a correre. Una frenesia incredibile, sembrava avesse le pulci per quanto saltava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Pare che quest'idea della Fluttipalla sia la mia unica possibilità, al momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Posso essere d'aiuto in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Davvero mi aiuteresti? Sarebbe fantastico! Che fortuna esserci incontrati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Non è che potresti vedere se in quella cassa laggiù ci sono degli steli di Cuordambra? Intanto comincerò a lavorare alla struttura di base della Fluttipalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Fammi sapere se ti serve una mano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Woah! C'è mancato poco che non mi ribaltasse!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
