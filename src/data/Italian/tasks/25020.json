				]
			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "Hroo?! Roar, rroar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200502,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200503,
					"content": "Hora ha lo sguardo pieno di gioia e prende a rotolarsi nell'acqua giocando con la Fluttipalla. Così facendo, il fango si stacca dal suo corpo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Ahahah, quel furfante sembra gradire la sua nuova palla. Non avrei mai immaginato che si sarebbe tuffato immediatamente nella piscina per giocarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Andiamo, adesso. Credo che per questa volta basti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "Roar...? Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200507,
					"content": "Ti piace, vero, piccolino? È tutta tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "Roar, roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200509,
					"content": "Non è stato facile farti fare un bagno... ma di certo ho imparato un paio di cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "Hroo... Groaar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200511,
					"content": "Perché mi tocchi la mano? Ah, questi... Sono solo dei graffietti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "*piagnucola*... Roar, roaaar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200513,
					"content": "E adesso che ti prende, piccolino? Cos'è quel broncio, così all'improvviso? Forse ti sei stancato di giocare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "#Oh, e grazie tante per il tuo aiuto, {F#amica mia}{M#amico mio}. Questi sono per te, considerali una ricompensa. Non è nulla di grande valore, ma ti prego di accettarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "Roar! Roarrr! Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200516,
					"content": "No, Hora. Aspetta, non tuffarti di nuovo in piscina. Ti ho appena asciugato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
