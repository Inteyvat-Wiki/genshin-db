			"dialogs": [
				{
					"id": 250201001,
					"content": "Ecco qua, grazie! Adesso... Ahia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201002,
					"content": "Scusami, mi... sono tagliato un dito per errore, mentre imbastivo la struttura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201003,
					"content": "Lo sapevo che mi sarei trovato in difficoltà con questo genere di lavori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201004,
					"content": "Dammi giusto il tempo di intrecciare questi steli intorno alla struttura della palla e di coprirla con un panno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201005,
					"content": "Cazcal continua a impegnarsi nella realizzazione della Fluttipalla e completa il lavoro, dopo essersi tagliato altre tre volte...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "Fatto! Andiamo a cercare Hora. Probabilmente, starà di nuovo scavando sotto l'albero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201007,
					"content": "Prima ti conviene medicarti la mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Non preoccuparti, è solo un graffio. Dopo cercherò una garza con cui fasciarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201009,
					"content": "Prima andiamo a vedere dov'è Hora, non vorrei si scatenasse nuovamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
