			},
			"dialogs": [
				{
					"id": 200060101,
					"content": "Ordina una consegna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "#Il Buon Cacciatore ti dà il benvenuto... Oh, ciao viaggiat{F#rice}{M#ore}! Arrivi proprio al momento giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Scusami, so che stai morendo di fame, ma potresti farmi un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Orlean del Villaggio Acquachiara ha ordinato un <color=#00E1FFFF>arrosto al miele</color>, ma mi hanno detto che ultimamente il Villaggio Acquachiara brulica di Melmosi....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Non ho il coraggio di fare il viaggio da sola... Potresti consegnare questo ordine a <color=#00E1FFFF>Orlean al Villaggio Acquachiara</color>, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Ok, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Ti assicuro che ci sarà un pasto fatto con amore ad aspettarti al tuo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Sono qui solo per mangiare, sto morendo di fame!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Quando avrai fatto quello che ti ho chiesto, ti offrirò qualcosa dal menù speciale del Buon Cacciatore! Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
