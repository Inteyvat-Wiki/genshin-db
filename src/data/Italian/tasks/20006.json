						200060402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060402,
					"content": "Eccoti qua! La consegna è andata bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060403,
					"content": "Ecco il pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Fammi controllare... Perfetto! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060405,
					"content": "Ecco, questo <color=#00E1FFFF>tortino di granchio, prosciutto e verdure al forno delizioso</color> è per te. Mangialo finché è caldo, è stato appena sfornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		}
