				"points": []
			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "Grazie! Uff, questi Melmosi sono proprio insopportabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Orlean la Vivace"
				},
				{
					"id": 200060202,
					"content": "Se non avessi avuto un calo di zuccheri, gli avrei dato una lezione io stessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Orlean la Vivace"
				},
				{
					"id": 200060203,
					"content": "Ecco il suo ordine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Mmh... Profuma di carote e carne... Peccato che questo piatto non sia arrivato prima. Avrei distrutto quei Melmosi, se solo avessi combattuto a stomaco pieno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Orlean la Vivace"
				},
				{
					"id": 200060205,
					"content": "Suppongo non ci sia niente da fare. Ecco i soldi, portali a Sara da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orlean la Vivace"
				}
			]
		},
