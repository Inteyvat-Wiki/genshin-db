			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "Hai eliminato il Cacciatore delle rovine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Per te i Cacciatori delle rovine sono ordinaria amministrazione, vero? Se mai avessi avuto dei dubbi sulle tue capacità, ora sarebbero scomparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "Ancora nulla della spada? *sospira* Inizio a odiare il suono della mia stessa voce quando faccio quella domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "Non importa, ti ho assegnato svariati incarichi e li hai completati tutti alla perfezione. Di questo ti ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "Lama nascosta, dove ti sei cacciata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Prima o poi la troverai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "Stai cercando di farmi sentire meglio? Grazie, ma non è nulla di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Non so quanto tempo ci metterò, né dove mi porterà questa ricerca, ma... troverò quella spada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Intendo ampliare la mia area di ricerca, quindi potrei chiedere di nuovo il tuo aiuto in futuro. Sì, continuerò a ricompensare i tuoi servigi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Ecco la tua ricompensa. Ora vado, devo analizzare un nuovo elenco di incarichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "Lama nascosta... Non rimarrai tale per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Questi incarichi non sembrano avere a che fare con una spada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Questo perché ho già completato tutti gli incarichi con una qualche attinenza a una spada, ma purtroppo non hanno dato risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Allora ho pensato che soltanto una circostanza altamente pericolosa avrebbe separato mio fratello dalla spada. Di questo sono certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Quindi ho iniziato ad accettare altri incarichi ad alto rischio, nella speranza che mi forniscano degli indizi sulla posizione di Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Ma si tratta di incarichi spesso pericolosi, e non sempre riesco ad affrontarli da sola. Questo è il motivo per cui ho iniziato a chiederti aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}