			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "È tutto vano... Terribilmente vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "Non hai proprio niente da fare, vero? Vuol dire che sei abile nel tuo lavoro oppure che sei incapace oltre ogni limite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Dubito sia la seconda possibilità, però. In fondo, finora hai svolto sapientemente gli incarichi che ti ho assegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Se non hai impegni, avrei qualcos'altro da farti fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Stavolta si tratta di una missione più pericolosa. Dovrai sconfiggere un Cacciatore delle rovine. Te la senti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Consideralo fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Bella la sicurezza di sé, eh? Mio fratello ragionava allo stesso modo... Magari un giorno raggiungerai i suoi livelli di grandezza, chissà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Tutto qui. Raggiungi le Pianure di Guili e preparati, poi elimina quel Cacciatore delle rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Una volta che l'avrai eliminato, ricordati di cercare nei dintorni degli oggetti collegati alla spada. Se trovi qualcosa, portamelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "Se invece non trovi nulla, torna e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "In bocca al lupo per l'incarico! Stavolta spero che la ricerca si riveli più fruttuosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Devo anche cercare una spada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Sì, grazie. Una volta sconfitto il Cacciatore delle rovine, vedi se riesci a trovare una spada o degli oggetti correlati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Ti avverto, però: i Cacciatori delle rovine sono avversari duri. Per sconfiggerli, dovrai mantenere la concentrazione su di loro per tutto il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "Per quanto riguarda la spada, sarebbe fantastico che tu la trovassi ma, in caso contrario, non preoccuparti. Fintanto che sconfiggerai il Cacciatore delle rovine, ti pagherò comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
