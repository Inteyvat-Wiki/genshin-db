			},
			"dialogs": [
				{
					"id": 221100201,
					"content": "Hai eliminato il Cacciatore delle rovine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Prenditi il tuo tempo. Bisogna prepararsi per bene prima di affrontare un Cacciatore delle rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211003,
