			"dialogs": [
				{
					"id": 760310201,
					"content": "...Buona idea. Chiederò a Kunegunda di portarci della frutta, più tardi. Dovrà riposare nei prossimi due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Uh, sembra che Lauma sia occupata. Diamole un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Molti anni fa ho capito che la Cantaluna è una figura molto importante per gli Eredi della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310204,
					"content": "A volte penso che il loro compito sia persino più difficile di quello di una divinità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310205,
					"content": "Finalmente è libera! Andiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Lady Lauma, alcune delle strutture difensive richiedono la sua attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Certamente. Me ne occupo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "Ed eccola che se ne va di nuovo! Non riposa mai, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Forza, seguiamole. Ma... con discrezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
