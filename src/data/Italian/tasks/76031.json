			},
			"dialogs": [
				{
					"id": 760310301,
					"content": "...Così dovrebbe andare bene. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "Possa il chiaro di luna ricongiungerci, sia di giorno che di notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "...Mmh? Quel detto è cambiato dall'ultima volta che l'ho sentito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310304,
					"content": "Ehi! Quella persona se n'è andata! Forza, questa è la nostra occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "Lady Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "Sul serio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "...Grazie per il tuo duro lavoro. Mi devi scusare per un attimo, a breve sarò da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "Non c'è nessuno nei paraggi. Ora potete uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "Un momento, sapevi che eravamo qui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "Come potrei mai non vedere la \"Kuu{RUBY#[S]Fanciulla lunare}tar\" e il suo Kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "Anche se... non so bene perché mi stiate seguendo. È piuttosto inquietante... essere \"osservati\" al lavoro in questo modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "Oh, ehm... S-Scusa. Avevamo qualcosa da dirti, ma non era mai il momento giusto... Paimon spera solo che non ti abbiamo messo troppo sotto pressione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Ah, capisco... Ricevuto. Me ne occupo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "A dirla tutta, dopo averti guardato lavorare tutto il giorno, Paimon si sente un po' in colpa a chiederti di fare dell'altro lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "Ah, non preoccuparti, è il mio dovere di Cantaluna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310319,
					"content": "...Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310320
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310320,
