			"dialogs": [
				{
					"id": 760310101,
					"content": "Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310103,
					"content": "Ah, sta facendo un pisolino pomeridiano. Torniamo più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Elegantasso"
				},
				{
					"id": 760310105,
					"content": "No, aspetta! Non andare laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "...Uh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310107,
					"content": "Ahia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Elegantasso"
				},
				{
					"id": 760310109,
					"content": "Sei scivolato? Oh, non preoccuparti, non mi sono fatta male. Mm? Ah, ci siete anche voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310110,
					"content": "Ah, Paimon immagina che una Dea della Luna non sia immune a qualche livido e bernoccolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Non mi dispiace se delle piccole creature mi urtano, a patto che il Kuuvahki che emanano non rispecchi delle cattive intenzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310112,
					"content": "È successo qualcosa? Perché sembri così spaventato, piccoletto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Elegantasso"
				},
				{
					"id": 760310114,
					"content": "Mm, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310115,
					"content": "Oh, quindi anche tu riesci a capire cosa dicono questi animali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "La luna splende su Nod-Krai. Tutti gli animali che crescono sotto la luce del Kuuvahki possono essere considerati \"famigli della Dea della Luna\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310117,
					"content": "Quindi, che ha detto questo piccoletto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Che sono comparsi dei mostri dove vive. Stava cercando Lauma, ma i mostri lo hanno seguito fin qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310119,
					"content": "Ohh... Non c'è da stupirsi che sia così spaventato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Dove dovremmo portarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Da Lauma, penso. Lei saprà cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760310122,
					"content": "Ok, a quanto pare dobbiamo uscire di nuovo. Stavolta nasconditi super bene, dopotutto stiamo andando dagli Eredi della Luna gelata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
