			},
			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi, sei tornato! Ho da poco scoperto come cucinare un nuovo piattino delizioso! Vieni da me, così te lo faccio assaggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Sisi, sono appena arrivato e mi sento a pezzi, sia mentalmente che fisicamente. Al momento vorrei soltanto sdraiarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Certo, capisco... Hai lavorato duramente, devi essere esausto. Vai a riposare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Però... Non appena avrai ripreso le forze potremmo vederci, che ne dici? Fissiamo un giorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Sì, buona idea. Mi faccio sentire io. Non saprei di preciso quando, ma... Non sto cercando una scusa, eh! È solo che non voglio fare promesse che non posso mantenere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "*sospira* Sono un marinaio, Sisi, e in quanto tale sposato con il mare. Tu meriti molto di meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Non dire così, Chaoxi... Sai che lo capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
