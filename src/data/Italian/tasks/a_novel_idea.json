					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "Non so proprio da dove iniziare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Ah, rieccoti. Sto scrivendo un nuovo romanzo, o meglio... ci sto provando. Non trovo un'idea valida per l'introduzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160104,
					"content": "Mi scervello da un sacco di tempo, ma non sono arrivato a nulla. Di questo passo, chissà quando potrò iniziare a scrivere sul serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160105,
					"content": "#Tu sei un{M# viaggiatore}{F#a viaggiatrice} e il mondo non ha segreti per te, vero? Allora dimmi, quale pensi sia l'ingrediente base di un romanzo di successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211602,
			"completionStepIds": [
				2211605
			],
