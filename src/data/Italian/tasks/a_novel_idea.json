			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160201,
					"content": "Cuore e anima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "Oh, che risposta senza senso! La mia era una domanda seria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211603,
			"completionStepIds": [
				2211601,
				2211602
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
