			"dialogs": [
				{
					"id": 221161001,
					"content": "Ciao, Qiming! Oggi io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Oggi non è giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161003,
					"content": "Ma... Non ho nemmeno finito la frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161004,
					"content": "Non ce n'è bisogno, ho un'idea piuttosto precisa di cosa stavi per dire. E ripeto che oggi non è giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161005,
					"content": "Capisco... Pensi che verrà mai una giornata ideale per te, oppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161006,
					"content": "Oh, non temere, verrà di sicuro. E quel giorno per me sarà fantastico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161007,
					"content": "Ne so quanto prima! Qiming, ascoltami per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161008,
					"content": "Grazie, il prossimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161009,
					"content": "Non ho ancora finito! Aspetta... Cosa intendi con \"il prossimo\"?!? Non c'è nessuno in coda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
