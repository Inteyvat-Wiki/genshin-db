					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211602",
							"2"
						],
						"stepId": 2211602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Battaglie epiche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Battaglie, eh? Battaglie... L'idea non mi dispiace. Se non altro, attira l'attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160303,
					"content": "È difficile trovare l'ispirazione per quell'argomento nel Villaggio di Qingce... Non ci sono battaglie qui, né normali né epiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160304,
					"content": "Devo ampliare i miei orizzonti... nella natura! Sì, è la strada giusta! Dicono che là fuori le avventure non manchino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160305,
					"content": "La gente esplora luoghi remoti in cerca di tesori e finisce sempre per scontrarsi con tanti nemici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160306,
					"content": "In effetti conosco un posto che pullula sempre di mostri, e neanche troppo banali! Sì, possiamo andare laggiù e attendere che qualche avventuriere si faccia vivo, per poi assistere di persona a una di quelle battaglie a cui accennavi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160307,
					"content": "Così avrò tutto ciò che mi occorre, ahah! E allora andiamo, senza perderci in chiacchiere! Il viaggio è lungo e consiglio anche a te di non attardarti ulteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Oh, fantastico... Ora posso dire di aver toccato con mano una battaglia epica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160502,
					"content": "Non preferivi osservare da lontano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Beh, sì, quella era l'idea originale... Gli avventurieri su cui contavo però non si sono visti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160504,
					"content": "Ho notato che i mostri stavano pianificando di spostarsi. Se fossero andati via tutti, questo viaggio sarebbe stato inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160505,
					"content": "Quindi ho tirato loro una pietra. Nelle storie succede sempre così, tiri una pietra e attiri l'attenzione. Una cosa del genere, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160506,
					"content": "Come facevo a prevedere che avrebbe colpito uno di loro in fronte? A quel punto... Beh, il resto lo sapete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160507,
					"content": "A ogni modo, tutto è bene quel che finisce bene. Sì, ho un po' di graffi e di lividi, ma anche una storia! In fondo, ero venuto qui per quella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160508,
					"content": "Infine, sento la creatività scorrere nelle mie vene! Oh, quasi dimenticavo... Ecco una ricompensa per i vostri sforzi. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160509,
					"content": "Il mio blocco dello scrittore ha subito un durissimo colpo, me lo sento! Ora fuggo, i fogli attendono impazienti le mie parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211606,
