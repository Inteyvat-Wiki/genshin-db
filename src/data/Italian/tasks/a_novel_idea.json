			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161801,
					"content": "Allora, com'è andata? Hai una storia per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161802,
					"content": "Ecco gli appunti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Perfetto! Ehm... manca un po' di pathos, il che è normale considerando la loro giovane età... Fra qualche anno, però, forse vedremo fiorire una storia d'amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161804,
					"content": "Infatti conserverò queste annotazioni, sono l'inizio di un romanzo coi fiocchi. Non sprizza romanticismo da tutti i pori, è vero, ma quello credo di poterlo aggiungere io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161805,
					"content": "Oh, quasi dimenticavo. Ecco, per te. Grazie per il materiale che mi hai portato. Ora devo riflettere su come sviluppare il tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
