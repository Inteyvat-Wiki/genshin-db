			"dialogs": [
				{
					"id": 221161501,
					"content": "Romanticismo, eh? Non so molto sull'argomento, questo è certo. La mia conoscenza delle storie d'amore è... diciamo vaga, ecco.",
					"roleType": "TALK_ROLE_NPC",
