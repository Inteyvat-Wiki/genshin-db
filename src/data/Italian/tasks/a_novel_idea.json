			},
			"dialogs": [
				{
					"id": 221161201,
					"content": "Lulu, stavolta tocca a Fei fare il capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 221161202,
					"content": "Sì, perché devo fare sempre io il primo ufficiale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 221161203,
					"content": "È solo che, secondo me, quando Meng fa il capitano ci divertiamo di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 221161204,
					"content": "Non è giusto, Lulu. Anche Fei lo sa fare bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 221161205,
					"content": "Siamo tutti bravi nel nostro ruolo! Tu sei il capitano, io la ricca mercante e Fei il primo ufficiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 221161206,
					"content": "E stavolta sarà ancora più divertente! Che ne pensi, Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 221161207,
					"content": "Ma dai, Lulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 221161208,
					"content": "Beh... se la pensi così, Lulu... P-Per me va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 221161209,
					"content": "Fei...! Ne avevamo parlato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 221161210,
					"content": "Non fa nulla, basta che Lulu sia felice... Iniziamo, forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 221161211,
					"content": "È solo un gioco, chi se ne importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 221161212,
					"content": "Bah, siete davvero strani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
