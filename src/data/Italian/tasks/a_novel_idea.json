			},
			"dialogs": [
				{
					"id": 221160901,
					"content": "Ah sì, nei pressi del porto ho visto tre bambini: Meng, Lulu e Fei. Erano impegnati in un gioco curioso. Ti dice nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160902
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160902,
					"content": "Sono solo ragazzini, lo so, però... di sicuro verrà fuori una storia da raccontare, me lo sento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160903,
					"content": "Vai a dare un'occhiata e annota i punti salienti, poi consegnami gli appunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
