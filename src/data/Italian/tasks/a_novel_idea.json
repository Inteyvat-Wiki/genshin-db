			"dialogs": [
				{
					"id": 221161701,
					"content": "Allora, com'è andata? Hai una storia per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161702
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161702,
					"content": "Ecco gli appunti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161703
					]
				},
				{
					"id": 221161703,
					"content": "Ah, benissimo! Vediamo... Mmm, questo Chaoxi non mi convince per niente... Anzi no, ritiro tutto, sono strani entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161704
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161704,
					"content": "Non so se considerare la loro storia romantica... Tuttavia, il materiale per scrivere qualcosa c'è. Posso lavorarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161705
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161705,
					"content": "Oh, quasi dimenticavo. Ecco, per te. Grazie per il materiale che mi hai portato. Ora devo riflettere su come sviluppare la storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161706
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161706,
					"content": "Penso renda meglio come romanzo, anche se immaginare il finale di questa storia nella vita reale mi fa rabbrividire! Probabilmente servirebbe l'intervento dei Milleliti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161707
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161707,
					"content": "Per quei due bolle in pentola un bel disastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
