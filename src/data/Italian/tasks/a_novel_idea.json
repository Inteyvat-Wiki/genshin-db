			"dialogs": [
				{
					"id": 221161301,
					"content": "Allora, com'è andata? Hai una storia per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161302
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161302,
					"content": "Ecco gli appunti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "Perfetto! Vediamo... Zhihua e Qiming?!? Lo sapevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161304,
					"content": "Mmm... Bene... Ottimo materiale! Davvero ottimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161305,
					"content": "Sul serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "Forse a prima vista non è evidente ma, se ci fai caso, i segnali di una tensione amorosa fra quei due ci sono tutti. Sottili, sì, ma inconfondibili... Tra loro c'è chiaramente del tenero, eppure non lo esprimono apertamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161307,
					"content": "Ehm... Credo di aver trovato l'incipit adatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161308,
					"content": "A proposito, ho qualcosa per te. Grazie per l'aiuto! Ora è tempo di riflettere, poi arriveranno le parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
