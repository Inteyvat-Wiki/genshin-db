					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161601,
					"content": "Hai ragione, però: il mondo è pieno di persone come me, cioè prive di qualunque esperienza in materia. Se mi inserissi in quel settore, farei affari d'oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161602
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221161602,
					"content": "Da dove posso iniziare le mie ricerche per scrivere una storia romantica? Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
