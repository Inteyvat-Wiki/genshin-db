			"dialogs": [
				{
					"id": 221160601,
					"content": "Una storia romantica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2211607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"1",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "L'ultima volta che sono stato in città, ho visto un uomo parlare con una giovane, all'apparenza un'indovina. Era un autentico fiume di parole, e non mi sono soffermato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160702,
					"content": "In seguito, ho scoperto che il chiacchierone si chiama Zhihua, mentre la ragazza Qiming. Penso ci sia del tenero tra quei due... Ti andrebbe di informarti sulla loro storia? Se scopri qualcosa d'interessante, fammelo sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Ora che ci penso... Conosci una certa Sisi, per caso? La trovi quasi sempre al porto, dove attende il ritorno di Chaoxi, un marinaio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160802,
					"content": "A quanto pare, si reca lì regolarmente nella speranza di rivederlo. Chissà che storia c'è dietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221160803,
					"content": "Insomma, indaga un po' da queste parti e se ti imbatti in qualcosa d'interessante, prendi appunti e consegnameli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
