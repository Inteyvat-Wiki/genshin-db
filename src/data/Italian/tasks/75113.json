			},
			"dialogs": [
				{
					"id": 751130101,
					"content": "#Gentile {F#guerriera}{M#guerriero}, grazie a te i miei Saurici sono a casa sani e salvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130106,
					"content": "Hai dimostrato così tanto coraggio e gentilezza che io, Urubamba, sarei onorato di aiutarti ad allenarti per affrontare la Sfida del guerriero. Il tutto gratis, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130104,
						751130105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130104,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751130105,
					"content": "Dammi un attimo per prepararmi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
