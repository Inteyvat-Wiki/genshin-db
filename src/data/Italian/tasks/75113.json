			"dialogs": [
				{
					"id": 751130401,
					"content": "#Wow, non pensavo te la saresti cavata tanto bene... Evidentemente ti ho {F#sottovalutata}{M#sottovalutato}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130402
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130402,
					"content": "#Chi avrebbe mai pensato che, dopo tutto il lavoro per preparare la sfida, {F#una straniera}{M#uno straniero} di passaggio avrebbe fatto man bassa dei premi...? Sembra quasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130403
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130403,
					"content": "...Come uno di quei racconti eroici narrati nei rotoli di tessuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130405
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130405,
					"content": "Chissà, magari un giorno anche le tue gesta eroiche finiranno tra le nostre leggende? Anzi, ora che mi ci fai pensare... è molto probabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130406
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130406,
					"content": "#Che ne dici di farci una foto insieme, {F#cara eroina}{M#caro eroe}? Chi lo sa, potrebbe tornarmi utile per potermi vantare di averti conosciuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		}
