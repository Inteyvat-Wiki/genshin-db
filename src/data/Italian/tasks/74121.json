						],
						"pointId": 6136
					}
				]
			},
			"dialogs": [
				{
					"id": 741210801,
					"content": "Libertà! Ah, il dolce gusto della libertà! Non sarà mai gustosa quanto un pollo arrosto, ma è sicuramente piacevole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210802,
					"content": "...Allora, il cartellone che hai in mano cosa rappresenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210803,
					"content": "Mmh? Oh, questo. Rappresenta la protesta, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210804,
					"content": "Contro cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "Mmm... come te lo spiego... S-Sono stati loro a sotterrarmi, per impedirmi di lavorare sodo, e per questo motivo voglio protestare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210806,
					"content": "Aspetta, perché volevano che la smettessi di lavorare sodo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210807,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210808,
					"content": "Sai mantenere un segreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210809,
					"content": "Ovviamente, i tuoi segreti sono al sicuro con Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210810,
					"content": "Allora anche i tuoi sarebbero al sicuro con me, ma temo di non poterlo dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210811,
					"content": "Ehi! Prendi Paimon in giro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210812,
					"content": "Meglio che cambiamo argomento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "Va bene... E cos'era il barile che avevi addosso? Anche quello fa parte della protesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210814,
					"content": "Eh? Non saprei... Prima di sotterrarmi, mi hanno messo questo barile addosso. Un'azione degna dei loro gusti deviati, non c'è dubbio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210815,
					"content": "E per quale motivo ti hanno seppellito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210816,
					"content": "Perché sono persone orribili, orribili! Mi hanno acciuffato senza apparente motivo e mi hanno sotterrato nella sabbia! Mi volevano morto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210817,
					"content": "Proprio nessun motivo? Davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "O-Ovvio! Non avete visto?! Mi hanno letteralmente sotterrato nella sabbia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210819,
					"content": "Quale altro motivo avrebbero dovuto avere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210820,
					"content": "#Mmh... Ha senso, sì... {NICKNAME}, cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
