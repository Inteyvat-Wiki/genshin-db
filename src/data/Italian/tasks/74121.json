						],
						"pointId": 5746
					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "...Cosa? Allora non volevano uccidermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "*sospira* Che spirito di osservazione che avete. Esatto. La macchina l'ho rotta io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Ma perché l'hai rotta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Umpf, esatto, perché? Perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Un sacco di tempo fa, facevo una vita povera e misera. Ero molto depresso. In seguito, ho incontrato un tipo che mi ha dato una bibita salutare e mi ha rinfrancato lo spirito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "È stato davvero premuroso con me, per cui volevo ripagarlo per la sua gentilezza. Un giorno, ho approfittato dell'occasione; mi ha presentato della gente molto ricca e mi ha chiesto di aiutarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Ho solo svolto semplici lavoretti, la raccolta di parti meccaniche che appartenevano all'Istituto di ricerca di Fontaine, ma quei ricconi mi hanno pagato profumatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Woah, sembra favoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Vero? Questa volta invece mi hanno chiesto di andare a trovare questa strana macchina, estrarne il nucleo, e consegnarglielo. Avevo l'occasione di ripagare il mio amicone e di guadagnarci qualcosa: dovevo impegnarmi appieno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Ma quella terribile gente... Forse detestavano vedermi sgobbare per cambiare la mia vita. Hanno interferito con il mio lavoro e mi hanno avvisato circa la consegna dei... componenti di precisione ai miei datori di lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Ma non li ho fatti vincere! Ho preso l'incarico e ho protestato contro il loro comportamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "E di conseguenza, come dicevate, mi è stata data una bella lezione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh... Poverino... Ma era davvero un lavoro così ben pagato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Certo! Era uno dei motivi per cui non volevo dirvi perché protestavo. Però, dato che mi avete salvato la vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Non proprio salvato la vita, cioè...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "...Ho pensato anche che dato che voi due vi accorgete di tutto, magari a questo punto sia meglio dirvi la verità. Vedetela come una collaborazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Quegli strani macchinari sono stati utilizzati per lavori al di sopra e al di sotto del livello del mare. Individuarli è facile, producono una luce singolare attorno a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Occupatevene, e portatemi il nucleo al loro interno. Dovrebbero essercene <color=#00E1FFFF>sette</color> in tutto. Dopo che sarà fatto, ci dividiamo a metà i profitti. Va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Buona idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Mmm, ma cosa fanno queste macchine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Distruggono l'ambiente. Queste macchine sono da eliminare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "In che modo lo distruggono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "E come faccio a saperlo? Non lavoro mica all'Istituto di ricerca di Fontaine, io! Le anomalie si sono già verificate, per cui dev'essere dannoso per l'ambiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Beh... Sembra ragionevole. Ogni volta che si manifesta un qualsiasi ambiente sovrannaturale durante l'avventura, comporta ulteriori problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, perché non aiutiamo Henri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Ahah, fantastico! Allora affare fatto! <color=#00E1FFFF>Portatemi sette nuclei</color>, arricchiamoci insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "Cosa fanno queste macchine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Io prendo il 70% dei guadagni, e il 20% dev'essere pagato in anticipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "Uff, e va bene. Ma in anticipo non posso darti niente. Sto aspettando il pagamento anche io, che arriva alla fine del lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Mmm, ma cosa fanno queste macchine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
		},
