						],
						"pointId": 5964
					}
				]
			},
			"dialogs": [
				{
					"id": 741210101,
					"content": "#Grazie! Grazie! Grazie mille, siete {F#le mie salvatrici}{M#i miei salvatori}! Io, Henri, non dimenticherò mai la vostra gentilezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "Concentriamoci su un problema più importante. Paimon vuole sapere come sei finito qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "*sospira* Quei granchi devono esser stati attratti qui dall'aroma del pollo arrosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Anche Paimon è attratta dallo stesso odore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "No, è diverso. I granchi erano indecisi se avere me o il pollo arrosto come aperitivo. Il solo pensiero che avrebbero potuto iniziare con l'\"aperitivo fresco\" mi mette i brividi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "Mi sembra giusto, più è fresco, meglio è!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "Ehi! Paimon parlava di Henri, non dei granchi! Chi altro si sarebbe sotterrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "Allora, hai bisogno del nostro aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Ovvio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "Oh... no! Voglio dire, no! Non aiutatemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Eh? Va bene, va bene! Ti abbiamo sentito forte e chiaro! Andiamo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "No, un momento, aspetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "Eh? Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Io... Io, eh, *esita* Le cose stanno così. Ascoltatemi bene. Questo è un nuovissimo trattamento di bellezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "Non c'è bisogno che urli! A Paimon fanno male le orecchie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "Non preoccupatevi! Sono una persona perfettamente sana di mente! Questo è un trattamento di bellezza valido dal punto di vista scientifico e salutare! Per questo motivo mi sono sepolto nelle sabbie umide con le mie stesse mani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "Andate via! Non ostruite la luce del sole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Eh... Andiamo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Vedo che la curiosità vi attanaglia! Allora non mi lasciate alcuna scelta che spiegare la magia di questo trattamento per la pelle! Ehm, le nereidi nella sabbia sono in grado di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "#(Oh, che chiasso. {NICKNAME}, che cosa vuole questa persona? Paimon non ci capisce niente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "(Davvero strano...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Davvero? Cosa ne pensi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(Esaminiamo l'area circostante prima.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "Ehi? Ve ne andate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Certo, diamo uno sguardo in giro e torniamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "Va bene! Allora via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Mi chiedo più che altro perché ti sia sotterrato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "E poi, hai bisogno del nostro aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
