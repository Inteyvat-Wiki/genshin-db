			"dialogs": [
				{
					"id": 721540801,
					"content": "Quali emozioni speri di catturare nei tuoi film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Ah! Che splendida domanda! Davvero splendida. A essere sincero, devo ancora capirlo bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Credo che i film possano parlare di qualsiasi cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "Amore! Suspense! Battaglie! Persino le leggende più infondate possono essere il punto focale di un film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Ma ti dirò: credo che i film abbiano un fascino che devo ancora riuscire ad esaltare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Credo che troverò la risposta a questa domanda solo continuando a produrre film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
