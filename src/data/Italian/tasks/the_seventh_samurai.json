						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "Oh, santo cielo, il film così non va proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540202,
					"content": "Preparati di nuovo e riproviamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#Perfetto! Non mi aspettavo niente di meno dal{F#la}{M#} mi{F#a}{M#o} ero{F#ina}{M#e}! Che dimostrazione magistrale! Sei davvero una star!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "Una... che?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "#Una star! L'att{F#rice}{M#ore} più importante di un film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "Allora, signor soldato, hai capito cosa intendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "In generale sì. Quando uso la spada devo focalizzarmi non tanto sull'azione in sé, ma sulla postura, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "Se a te interessa solo la postura... ho qualche ideuzza in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Davvero? Ma è fantastico! Discutine pure con gli altri soldati, più tardi faremo un'altra ripresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "#Ti sono estremamente grato per il tuo aiuto, viaggiat{F#rice}{M#ore}. Ecco. In segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "Quale sarà l'argomento del tuo prossimo film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Il prossimo film, eh? Beh... In realtà sono piuttosto combattuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Che sia meglio girarne uno sulle tante tradizioni del Gran Santuario di Narukami? O sulle storie delle kitsune e dei tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "Ci sono così tante isole qui a Inazuma, e così tante storie da raccontare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Ma, a ogni modo, prima devo terminare la produzione de \"Il settimo samurai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Se sarà gradito alle alte sfere, sospetto che i film successivi procederanno in maniera molto più spedita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "La prossima volta vorrei un altro ruolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Non c'è problema! Una volta che questo film sarà finito, inizieremo a prepararne un altro completamente nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
