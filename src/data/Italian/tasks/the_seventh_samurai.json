	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Aspetta! Ah, signor soldato, il modo in cui hai letto l'ultima battuta non è abbastanza pregno d'emozione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "\"Samurai, come il vento che flagella la terra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Ricordi quello che ho detto sul film? Dev'essere liberatorio e deve ricordare al pubblico le vicissitudini della propria esistenza. Liberatorio! Liberatorio, capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "L'intero film si regge su questa battuta. Devi esprimere le tue emozioni in modo completo, totale e perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "E non mulinare quella spada a quel modo... Controlla sempre di restare all'interno dell'inquadratura, o la Videokamera non potrà immortalare i tuoi movimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Mettiti in posa, poi fa' una pausa, ok? Fermati un istante e poi sferra un potente fendente verso il basso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "Ma non si usa così una spada quando si combatte contro qualcuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "Vero, ma devi adattare i tuoi movimenti alle necessità della produzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Bene. Preparati, riproviamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#Oh, sei tu! Ah, mi{F#a}{M#o} car{F#a}{M#o} ragazz{F#a}{M#o}, un vento proficuo deve averti sospinto fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Come puoi vedere, sto girando un film di cappa e spada con questo bravo soldato. Lo intitolerò \"Il settimo samurai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "Oh, e ho deciso di chiamare \"cappa e spada\" questo genere di film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "Questo tipo di film includerà degli scontri all'arma bianca, e accompagnerà lo spettatore in un incredibile viaggio sul campo di battaglia... O almeno, questa è la mia idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "Incredibile che il signor Toranosuke abbia trovato il tempo per aiutarti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Quest'attività è stata approvata dai nostri superiori. Credono aiuterà a migliorare il prestigio dello Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Detto questo, non ho idea di come il signor Xavier sia riuscito a persuaderli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Il signor Mikoshi Genjirou è così... serio. Fortunatamente è anche molto comprensivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Dopo avergli parlato con schiettezza, ha accettato di buon grado la mia richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Ma... in cambio mi ha chiesto di produrre un film che abbia a che fare con lo Shogunato, preferibilmente con un samurai come protagonista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "A ogni modo, ho sempre coltivato un certo interesse in materia, quindi ovviamente ho accettato, e Lord Mikoshi Genjirou ne è stato ben felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "Oltre ad assegnarmi di persona il nostro buon soldato affinché mi aiutasse, ha anche chiesto a diversi suoi abili colleghi di affiancarmi nell'impresa, dicendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "\"Adopera queste scene in cui l'acciaio cozza contro altro acciaio per mostrare a tutti la maestosità dei samurai e dello Shogunato.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Devo ammetterlo, il signor Genjirou è davvero un visionario: ha compreso in un batter d'occhio il potenziale della cinematografia come strumento di promozione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "E io, ovviamente, non rifiuterei mai un aiuto per realizzare i miei film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Come procede la produzione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "A essere sincero, non benissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Questi soldati sanno certamente il fatto loro in materia di arti marziali, ma non sono abituati a combattere per finta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Non solo sferrano fendenti troppo rapidi per essere registrati dalla Videokamera, ma a volte escono persino dall'inquadratura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "#Viaggiat{F#rice}{M#ore}, se hai tempo, ti dispiacerebbe seguire il mio copione e far vedere ai soldati come reciti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Credo che con la tua abilità e intelligenza te la caverai alla grande di fronte alla Videokamera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Dovrebbero riuscire a capire meglio la storia, vedendola dal punto di vista di uno spettatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Forza, dai! Prima però leggi il copione. Questa parte si focalizza perlopiù sul combattimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "\"La battaglia è perduta.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ah, queste battute sono di un'altra scena... Questa è focalizzata soprattutto sul combattimento, non ci sono discorsi tanto lunghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "E va bene, fammi dare un'occhiata al copione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Oh, a proposito, ricoprirai il ruolo di Juusaburou. Gli abitanti del villaggio l'hanno ingaggiato insieme ad altri samurai per proteggere le loro case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "In questa scena uno dei tuoi compagni, Kyuuzou, ha delle battute... Farò io la sua parte e leggeremo insieme il copione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Ricorda: devi immergerti nel ruolo, comprenderlo a fondo! Immagina di essere Juusaburou. Hai capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "Ho capito, signor regista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "#Magnifico! Splendido! Bravissim{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "#Fammi sapere quando sei pront{F#a}{M#o}. Intanto regolo la posizione della Videokamera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "Io SONO Juusaburou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "\"Ma anche nel pericolo i samurai restano tali.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "\"Siete proprio un branco di spaventapasseri, non c'è dubbio...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "\"...Ma i nostri nemici non sono certo dei passeri.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Ti dispiacerebbe se ricoprissi una particina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#Ma certo che no! Dopotutto, sei e sarai sempre un{F#a}{M#} ero{F#ina}{M#e} nel mio cuore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Non dimenticherò mai \"I racconti di Tatara\", in cui abbiamo recitato entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Anche se questi soldati sanno certamente il fatto loro in materia di arti marziali, non sono abituati a combattere per finta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Non solo sferrano fendenti troppo rapidi per essere registrati dalla Videokamera, ma a volte escono persino dall'inquadratura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "Come hai fatto a convincerlo ad aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Ah, il nostro amato soldato ha appoggiato subito la mia idea. La vera impresa è stata persuadere il signor Mikoshi Genjirou a lasciarmi girare un film a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "\"Samurai, come il vento che flagella la terra.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Ci hai messo troppa passione rispetto al solito. Non sarà...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
