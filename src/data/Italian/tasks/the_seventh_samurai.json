			"dialogs": [
				{
					"id": 721540401,
					"content": "Un film \"cappa e spada\", eh? Certo che il signor Xavier ha un gusto particolare, in fatto di nomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Cosa ne pensi di questi film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "I nostri superiori credono che aiuteranno ad accrescere il prestigio dello Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Forse sono semplicemente un po' lento di comprendonio, ma... non capisco come possa essere possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Il copione è pieno zeppo di battute pessimiste. Non vi è nulla che rifletta la dignità di un samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "A che accidenti stavano pensando quando hanno approvato tutto questo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Com'è la situazione alla Fornace Mikage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Dalla \"promozione\" del signor Hanbei, Yousuke è passato al comando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Ha origini artigiane, ha i piedi per terra ed è sicuro di sé. E sa come ottenere buoni risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Con la Fornace Mikage sotto la sua gestione, dubito che ci saranno ulteriori problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
