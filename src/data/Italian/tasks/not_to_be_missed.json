				{
					"id": 206020501,
					"content": "Già di ritorno? Com'è la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020502,
					"content": "Ci sono ancora dei mostri in giro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "Dei mostri sono ancora in quest'area, eh? Quindi sembra che gli effetti della tempesta debbano ancora disperdersi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020504,
					"content": "Ahahah! Quindi c'è ancora tempo! Del tempo per la Gilda degli avventurieri per dimostrare il suo valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020505,
					"content": "Tocca a noi eliminare quei mostri là fuori, mentre i Cavalieri di Favonius sono ancora concentrati sulle difese della città e dell'area intorno a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020506,
					"content": "Capisco. Grazie per le informazioni. Riconsidererò gli incarichi da assegnare. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
