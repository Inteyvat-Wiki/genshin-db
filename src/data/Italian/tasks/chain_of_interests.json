				{
					"id": 130100610,
					"content": "Avete trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100611,
					"content": "No, niente di particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Solo qualche comunissima Capsula della conoscenza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Forse avevano solo poche Capsule della conoscenza contenenti informazioni sulla Corte della desolazione, sarà stato facile portarle via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Ma non c'è da preoccuparsi, mi è venuta un'altra idea. {NICKNAME}, voi tornate indietro da dove siamo arrivati. Io resterò qui nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Tornate qui tra un po'. Sono sicuro che per allora qualcosa sarà venuto fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Ecco perché volevi che portassi il dispositivo di localizzazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Hanno sloggiato in fretta e furia senza avere il tempo di portare via tutta la merce. Non la lasceranno di certo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Non appena penseranno che siamo andati via, torneranno a prenderle. Dobbiamo solo assicurarci che il localizzatore si allontani abbastanza da fargli credere che sia sicuro tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Oh, Paimon ha capito! Li attireremo facendo credere loro che siamo andati via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Va bene! Noi cominciamo ad allontanarci, lasciamo che qui ci pensi tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Sì, e non preoccupatevi: se osano tornare, mi assicurerò che non se ne vadano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
