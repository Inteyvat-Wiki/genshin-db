			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Che caldo... Se solo ci fosse un po' d'ombra per rinfrescarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Forse dovremmo fermarci per una pausa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Manca ancora molto, cercate di resistere un altro po'. E poi, questo posto non è l'ideale per fermarsi a riposare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "*ansima* Va bene... ma non senti anche tu questo caldo torrido, Cyno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Certamente, ma è un clima a cui sono abituato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "Hai qualche consiglio? Paimon sta per liquefarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Cerca solo di restare concentrata: supporta la mente usando la forza di volontà. Se inizi a cedere, comincerai a sentirti molto più stanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Fai un passo dopo l'altro. Non lasciare che la tua mente percepisca i limiti del corpo. Prima di rilassarci dobbiamo raggiungere un posto sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "Uh... D'accordo, se lo dici tu... Ma quale posto è più sicuro per riposare? Paimon pensa che questo sia un luogo perfetto dove fermarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Guardati intorno, c'è solo sabbia e deserto. Non c'è l'ombra di un mostro per chilometri e ch... Wow! Da dove arrivano questi scorpioni?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Fate attenzione, hanno qualcosa di strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Fiuuu... Beh, Paimon non si aspettava di vedere quei cosi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Questi non sono scorpioni normali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Guardate, hanno dei numeri sulle tenaglie. Sono stati allevati da qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Quindi, intendi dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Qualcuno non vuole che raggiungiamo l'asta e ha mandato questi scorpioni per tenerci alla larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "Siamo circondati dal deserto infinito. Se ci uccidessero qui, nessuno verrebbe a saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "Ce la siamo vista molto brutta! Per fortuna non abbiamo abbassato la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "C'è qualcosa che non va... Nel deserto non ci sono strade, quindi come facevano a sapere esattamente dove eravamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#{NICKNAME}, non ti muovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "Ecco la risposta... devono averti impiantato questo affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "Uh? Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "Un dispositivo di tracciamento della Kshahrewar. Lo stanno utilizzando per rilevare la tua posizione approssimativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Ma questo dispositivo non ha le autorizzazioni necessarie per la produzione di massa... Dove possono averlo preso? Possibile che qualcuno della Kshahrewar sia coinvolto in tutto questo? Mmmh, qualcosa non quadra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#Wow, Paimon non pensava che esistessero affari simili. Secondo te perché stava addosso a {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "#Probabilmente l'hanno impiantato su{M#l viaggiatore}{F#lla viaggiatrice} durante il combattimento di prima contro i mercenari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "Mi dispiace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "È stato un combattimento caotico, è naturale che tu non ci abbia fatto caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "Almeno tu sei riuscito a trovarlo, Cyno! Ora liberiamocene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "Mmmh, no... Per ora tienilo. Potrebbe tornarci utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Continuiamo a dirigerci verso l'asta. Restare qui sarebbe troppo pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Non l'ho nemmeno notato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Che strano... È qui che si tiene l'asta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Non c'è nessuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Già, non c'è anima viva... Che stiano facendo una pausa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Dopo che abbiamo sconfitto quei mercenari, non abbiamo perso tempo ad arrivare qui. Dubito che siano riusciti ad avvertirli del nostro arrivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "A ogni modo, sapevano che saremmo arrivati. Qualcuno qui deve aver monitorato il localizzatore e avvertito tutti di scappare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Oh, no... Ora che cosa facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Controlliamo quest'area. Non possono essere scappati portando con sé tutte le Capsule della conoscenza. Potrebbero aver lasciato qualcosa che possiamo scovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Va bene, allora diamo un'occhiata in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Oh! Sembra che Cyno abbia preso qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Quindi sei tu il cattivo che si nasconde dietro a tutto questo, eh? Svela a Paimon tutto quello che sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Sa qualcosa del contrabbando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Quando l'ho visto, non sono intervenuto subito. Ho preferito nascondermi e tenerlo d'occhio per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Non è l'organizzatore principale, ma molto probabilmente è uno dei venditori più importanti. Ho ragione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Già, impressionante... Si direbbe che la tua reputazione sia meritata, Cyno. Se avessi saputo che eri ancora in giro, non sarei stato così avido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "Eh? Avido? Cosa vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Quando abbiamo saputo che stavate arrivando, tutti i commercianti di Conoscenze in scatola hanno abbandonato la merce e sono fuggiti all'istante. Ovviamente non c'è stato il tempo di prendere tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Visto che la merce era rimasta qui senza nessuno a controllarla, ho pensato di approfittare dell'occasione per tornare a prendere quello che potevo. Sai, della merce gratis è un ottimo affare, ma... *sospira* Suppongo che sia inutile spiegarlo ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Sai chi produce e vende le Conoscenze in scatola, vero? Ce lo dirai di tua spontanea volontà o devo farti parlare io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "No, no, parlerò. Ma prima, magari, possiamo portare la conversazione altrove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Se restiamo qui, qualcuno potrebbe vedermi con voi. E questo metterebbe in pericolo me e la mia famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Va bene. Dove suggerisci di andare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Che ne dite di casa mia, al Villaggio di Aaru? Lì dovremmo essere al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Bene, andiamo. Puoi buttare via il localizzatore ora, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Ha un ruolo importante nell'asta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Papà, sei tornato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "Oh, abbiamo ospiti? Ehm, ciao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Questa è mia figlia Simin. È un pochino timida con gli sconosciuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Perché non vai di là, ora, tesoro? Papà deve parlare con questi ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Oh... va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Tutti conoscono Cyno nel nostro settore, ma lasciate che ve lo chieda... Chi siete voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Paimon è Paimon, e quest{F#a}{M#o} è {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "A essere sincero, non mi aspettavo di vedere Cyno, l'operatore solitario, lavorare con qualcun altro. Quando ho visto il localizzatore allontanarsi, ho pensato che aveste deciso di tornare a mani vuote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Ma anche se mi avete preso, vi prego di fermarvi finché siete in tempo. Dovreste abbandonare questa indagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "E perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Tutto, dalla produzione di Conoscenze in scatola fino alla vendita e alla divisione dei profitti... Ogni fase del processo coinvolge decine, se non centinaia, di persone. I profitti enormi hanno unito tutti in questo giro d'affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Chiunque farà di tutto per difendere questa industria che abbiamo lavorato per costruire. Sarà una lotta lunga e difficile anche per uno come te, Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "E anche se alla fine riuscissi a vincere, nessuno ti ringrazierebbe. Semmai, potresti finire per avere rimorsi... Perché sei così deciso a farci fallire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Ognuno ha le proprie ragioni per quello che fa, non sono tenuto a spiegare le mie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*sospira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Ecco un po' di tè, papà... e anche per gli ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Ah, ma certo. Stavo dimenticando di offrire loro del tè. Ti ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Non c'è di che... A proposito, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Dovete sapere che il nostro tè ha un sapore piuttosto amaro, ma ho messo un po' di zucchero per renderlo più gustoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "Brava, piccola, ne è rimasto ancora un po'? Se è finito, ne comprerò di più la prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Sì, ce n'è ancora... Bene, ora vado a riposare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Hai detto che tutti lo fanno per gli enormi profitti. Nel tuo caso, non sembra esattamente così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "Ehm, in realtà... è proprio di questo che volevo parlarvi. Ho un favore da chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Mia figlia è nata con una malattia cronica, ha il cuore e i polmoni abbastanza deboli. L'esercizio fisico, anche solo leggermente impegnativo, può farla svenire o persino mettere a rischio la sua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Per questo motivo, non ha mai avuto amici con cui giocare e resta in camera sua per la maggior parte del tempo. Deve prendere molte medicine, e quelle... non costano poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Per quanto mi riguarda, ero solo un mercante mediocre. Mi svegliavo presto e viaggiavo parecchio per guadagnare qualcosa, ma i Mora non erano mai abbastanza. Potevo solo guardare la salute di mia figlia peggiorare di giorno in giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Poi, a un certo punto, qualcuno mi ha contattato per mostrarmi un modo per fare dei bei guadagni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "Vendere le Conoscenze in scatola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Proprio così. Con tutti i Mora che ci ho guadagnato, ho potuto finalmente permettermi le cure mediche per mia figlia. Non c'è nulla che mi abbia mai reso più felice che vederla migliorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Ci sono molti altri come me. A voi il contrabbando di Conoscenze in scatola potrà sembrare un crimine imperdonabile, ma per noi è un mezzo di sostentamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Volevo dirvi tutto questo sperando che poteste capire e cambiare idea. Ti prego, stanne fuori, Cyno, dacci un modo per sopravvivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Oh, no... Questo significa che se impediamo la vendita delle Conoscenze in scatola, sua figlia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Devo arrivare alla verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Posso trovare qualcuno che aiuti a curare tua figlia, ma non posso chiudere un occhio sul contrabbando. Sono due questioni completamente diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "*sospira* In qualche modo sapevo che l'avresti detto, ma la tua promessa di aiutare mia figlia mi basta. Visto che volete continuare le indagini, dovreste dare un'occhiata al retro di casa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "Troverete alcune merci che ho ricevuto di recente e credo che tutto vi sarà chiaro, dopo averle viste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Raggiungi il retro della casa insieme a Cyno.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "Wow! Guardate quanta roba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Sì, tutto impacchettato con ordine e suddiviso in scatole. E pensare che è la merce di un solo venditore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "I piccoli produttori non possono produrre una quantità di merce così consistente. Uhm, che ci sia davvero l'Akademiya dietro a tutto questo? Ma è impossibile che un quantitativo simile sia sfuggito all'ispezione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Ehi, guardate! Queste sembrano diverse dalle altre Capsule della conoscenza che abbiamo visto. Forse contengono informazioni sulla Corte della desolazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Sì, avrebbe senso. Aspettate, cos'è questo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Una specie di marchio che non abbiamo mai visto prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Sì, è un sigillo dei Matra, serve a indicare che la merce ha superato l'ispezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Quando ho trovato il localizzatore, prima, ho iniziato a sospettare che qualcuno dell'Akademiya potesse essere coinvolto, ma non mi spiegavo come fosse possibile spedire così tante Conoscenze in scatola al di fuori dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Ora tutto quadra. Con questo sigillo dei Matra, le merci possono lasciare l'Akademiya senza essere sottoposte a una seconda ispezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Umpf. Adesso capisco perché non vogliono che io indaghi: dietro a tutto questo c'è un Matra. Persino io stento a crederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Potrebbe essere un malinteso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#Posso chiedervi un favore, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Dato che tutte queste Conoscenze in scatola vengono dall'Akademiya, è molto probabile che la conoscenza riguardante la Corte della desolazione provenga dagli archivi di ricerca dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Se riuscissimo a entrare nell'archivio, potremmo scoprire chi ha avuto accesso a quei documenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Tuttavia, considerata la mia situazione attuale, se mi presentassi all'Akademiya all'improvviso non farei altro che attirare inutilmente l'attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Dovrete essere voi a controllare i registri. Scriverò una lettera a Nabil, ci penserà lui a portarvi lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Certo, lascia fare a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Io, nel frattempo, continuerò la mia indagine qui. Anche se tutte le nostre piste portano a qualcuno all'interno dell'Akademiya, per ora, è ovvio che i responsabili hanno potere anche all'esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Potremo ottenere più informazioni sugli altri trafficanti da Bahari. Io resterò qui a fare qualche preparazione. Se scoprite qualcosa, venite a cercarmi in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Sai cos'è, Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
