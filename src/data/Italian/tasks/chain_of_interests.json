			"dialogs": [
				{
					"id": 130101001,
					"content": "#Ugh... Che stanchezza... Ci siamo allontanat{F#e}{M#i} abbastanza, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Sì, direi che così basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Evviva! Riposiamoci un po' prima di tornare a cercare Cyno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Vi sedete nei paraggi e vi riposate per un po'.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Uhm, probabilmente è ora di tornare all'asta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Andiamo, forse Cyno ha finalmente trovato qualche pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Dovremmo andare un po' più lontano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Più lontano? Ma Paimon non riesce a fare un altro passo... Perché non ci riposiamo un po' qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				}
			]
