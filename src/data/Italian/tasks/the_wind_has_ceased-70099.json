			"dialogs": [
				{
					"id": 700650101,
					"content": "Certa gente non vuole proprio ascoltare. Te l'ho già detto, non è il momento di salire sulla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Calma, Vecchio Mann. Parliamone con tranquillità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Prima, al Nettare della Notte andavamo così d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Ma, non appena ho detto che stavo andando al Picco Ventoquiete, mi ha afferrato e ha iniziato a trascinarmi con sé. E alla fine siamo arrivati qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Ah, è Huffman. Cosa succede qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Come puoi vedere, il Vecchio Mann sta facendo del suo meglio per tenere la gente lontana dal Picco Ventoquiete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Permettimi di fare le presentazioni. Questa è l'avventuriera Lipphart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "Ciò che ho passato è stato terrificante. Volete davvero sentirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Beh, a quanto pare oggi non combinerò nulla. E va bene, sentiamo. Sarà come una continuazione delle nostre bevute e vanterie di prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Allora... Che genere di \"grande periglio\" c'è da affrontare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "La casa di cura è infestata! Sul serio! Ho visto dei fantasmi con i miei stessi occhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Fantasmi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "È successo la notte scorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
