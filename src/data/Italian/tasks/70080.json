			"dialogs": [
				{
					"id": 700800101,
					"content": "Avendo camminato sul confine tra la vita e la morte, ciò che mi manca di più è il sapore della birra. Perfino il mio padrone e lo stesso Re Deshret verrebbero dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800102
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800102,
					"content": "Ah. Non sapevo che ti piacesse così tanto bere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "Ai tempi, quando consegnavamo i blocchi al Mausoleo di Re Deshret, ci davano due grandi boccali di birra gratis ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "A proposito, Maukie era tra coloro che sono stati riportati in vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "No. Sospetto che i piani alti vogliano occuparsi di lui... in violazione delle regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800106
					],
					"speakerTitle": "Vitruvio"
				},
				{
					"id": 700800106,
					"content": "Mi chiedo se il biglietto che gli ho chiesto di portare in segreto sia tornato utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vitruvio"
				}
