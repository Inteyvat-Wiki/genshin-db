			"dialogs": [
				{
					"id": 190940701,
					"content": "...Kaeya è scaltro, ma il vino gratis è sempre il più delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940702,
					"content": "Puoi sempre rifiutare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Ah, figurati. Del resto, i canti per i cori di chiesa non sono esattamente il mio forte, con tutte quelle meticolose formalità e via dicendo... Ma finché nell'aria ci sarà amore per la musica, sono sicuro di poter aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940704,
					"content": "Sembra che ci vorrà molto lavoro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Ehi, se io sono felice e lo sono anche sorella Grace e il pubblico... è una cosa positiva, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940705,
					"content": "Non lo fai solo per il vino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
