				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "Questo è lui. Noi trova suo sangue. Persone cattive fa questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541302,
					"content": "È terribile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541303,
					"content": "Sono d'accordo che è terribile, ma questo non cambia il fatto che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541304,
					"content": "Noi non attacca villaggio! Non noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541305,
					"content": "Lupo nero e suo branco, non di qui. Vuole rubare territorio. Lui viola codice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>Il codice di chi?</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541307,
					"content": "Di guardiano di questa terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541308,
					"content": "È la seconda volta che lo tiri fuori. Dicci chi è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541309,
					"content": "Porto Lupical più all'interno. Segue me, forse vede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
		{
			"id": 45415,
			"completionStepIds": [
				45415
			],
			"beginWay": "TALK_BEGIN_AUTO",
