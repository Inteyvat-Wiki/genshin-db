			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "Eccoci qua! Sono sufficienti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Sì, basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor mi stava parlando del codice di condotta dei lupi. Roba allucinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Abbiamo cercato ovunque e non abbiamo visto altri lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540307,
					"content": "Sì, i lupi non si fanno vedere. Quello che abbiamo catturato doveva essere malato o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "C-Che ci fai tu qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540309,
					"content": "Vendetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "È lui! Quello che è stato allevato dai lupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540312,
					"content": "Quindi sei stato tu. Avrei dovuto saperlo, i lupi non sono così intelligenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540313,
					"content": "È assurdo che tu abbia aiutato i lupi a tramare contro gli umani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540314,
					"content": "Ti lanciano degli avanzi e tu li tratti come una famiglia? Hai dimenticato chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4540315,
					"content": "Basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Giusto! Non puoi parlare in questo modo di Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "I Cavalieri di Favonius gliela faranno passare liscia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Noi. Non. Attacca. Villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
