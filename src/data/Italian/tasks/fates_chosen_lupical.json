			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "Chi va là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540102,
					"content": "Tranquillo, Razor, siamo solo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540103,
					"content": "Tu... anche tu cavaliere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540104,
					"content": "...Quindi è vero che non vi conoscete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540105,
					"content": "La \"rossa ragazza che brucia\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "No. Anche questa ragazza rossa, ma no brucia tanto come altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540108,
					"content": "Ora comincio a capire. Questo è il ragazzo lupo di cui parlavate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540109,
					"content": "Esatto! Si chiama Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540110,
					"content": "Voi aiuta me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540111,
					"content": "A fare cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540112,
					"content": "No tempo. Mandato via Lupical. Vengono persone cattive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540113,
					"content": "Quella gente di prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540114,
					"content": "Capisco... Ma devo porti qualche domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540115,
					"content": "*annusa* Odore di sangue. Presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540116,
					"content": "Sangue? Spero che i lupi non abbiano attaccato quegli idioti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540106,
					"content": "...non era Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
		{
