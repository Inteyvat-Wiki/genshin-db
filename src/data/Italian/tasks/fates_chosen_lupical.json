				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "Dove siamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}, aiuta me. Raccoglie questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541503,
					"content": "Quelli non sono semi di Bacche uncinate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541504,
					"content": "Schiaccia. Metti su ferita. Ferma sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541505,
					"content": "È vero. I semi di Bacca uncinata hanno un rivestimento liquido che non solo funziona come un leggero analgesico, ma ha anche un effetto emostatico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541506,
					"content": "...L'ho letto in un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541507,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541508,
					"content": "...Non ne ho idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541509,
					"content": "Uncini aiuta semi a muoversi. Liquido ferma dolore e sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541510,
					"content": "Animali non sente uncini, porta semi lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541511,
					"content": "...Insegnante viola ha detto così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541512,
					"content": "Io resto qui, aiuta questo. Io risponde a domande di ragazza rossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541513,
					"content": "Bene. E se quella gente tornasse, dubito che avranno il fegato di affrontare un membro dei Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541514,
					"content": "#Non ho ancora eliminato il tuo amico lupo dalla lista dei sospettati. Ma dobbiamo comunque recuperare quei semi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}