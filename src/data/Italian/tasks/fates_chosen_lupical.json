				"points": []
			},
			"dialogs": [
				{
					"id": 4540601,
					"content": "Per favore. Si calmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540602,
					"content": "Bah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540603,
					"content": "È proprio come ha detto lui: sono un branco di lupi forestieri venuti per infrangere le regole. Avranno quel che meritano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540604,
					"content": "Ma Razor, tu non devi farti coinvolgere. Questa è una questione che dovremo risolvere tra lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540605,
					"content": "Tu non combatti con gli artigli, ma con la spada. Non colpisci con i denti, ma con il fulmine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540606,
					"content": "Tu sei un umano, Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540607,
					"content": "Io no come loro! No appartiene loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540608,
					"content": "Tu non sei un lupo. Questa faccenda è per i lupi e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540609,
					"content": "E tu, tu sei il Lupical di Razor tra gli umani. La tua nobiltà ti distingue dai tuoi simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540610,
					"content": "Se lo desideri, puoi addestrarti con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540611,
					"content": "Non ho altro da dire. Spero che c'incontreremo ancora, Razor e compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540612,
					"content": "Ehi... Razor, via quella faccia lunga! Perché non vieni in città per qualche giorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540613,
					"content": "Giusto! Dopotutto hai un'amica a Mondstadt, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540614,
					"content": "Sai... quella tua amica rossa che brucia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Non sei più al sicuro nelle terre selvagge. Ma so che non vuoi far loro del male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "Io sta bene. No preoccupa. Però io non è umano di città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540617,
					"content": "Ma neanche lupo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540618,
					"content": "Razor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Grazie. {NICKNAME}, Paimon e... altra ragazza rossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540622,
					"content": "Ma come?! Siamo stati insieme per tutto questo tempo e ancora non sai il mio nome?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540623,
					"content": "Addio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540619,
					"content": "Sul col morale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
		{
			"id": 45407,
