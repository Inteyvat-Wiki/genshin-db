			"dialogs": [
				{
					"id": 220390401,
					"content": "Ah, ecco cos'hai portato. Sì, sì, credo che questi colori saranno davvero una novità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390402
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390402,
					"content": "#Grazie davvero per avermeli procurati, viaggiat{F#rice}{M#ore}. Li proverò subito. Ecco, tieni, come compenso per i tuoi sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390403
					],
					"speakerTitle": "Ogura Mio"
				},
				{
