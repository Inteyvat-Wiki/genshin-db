			"trigger": {
				"objectNames": [
					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Se va avanti così, non resterà che chiudere l'attività...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Ah, scusami. Ero assorta nei miei pensieri. Sei qui per acquistare dei capi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Le sete più raffinate di Liyue non sono ancora disponibili, ma abbiamo comunque i kimono più recenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Una volta importavate dei materiali da Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Sì. Prima riuscivamo spesso ad assicurarci sete raffinate da Liyue, come quelle che la Gilda dei commercianti di Feiyun produce usando i Fiordiseta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Ma vista la situazione attuale, è da un po' che non riusciamo a importare quel genere di seta. Abbiamo dovuto affidarci alle nostre scorte attuali per proseguire con l'attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Ogni rotolo di seta che usiamo è andato per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Io stessa volevo disegnare delle fantasie originali per i kimono, o usare delle nuove tinte per realizzare dei capi che attirassero i clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Ma non sono riuscita a inventarmi nulla che possa essere considerato una \"nuova\" tinta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "#Tu hai percorso il mondo, viaggiat{F#rice}{M#ore}, e di certo avrai visto molte cose. Ti sei mai imbattut{F#a}{M#o} in qualche tinta che riterresti \"nuova\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Oh, sì, ne ho viste eccome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "D-Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Allora, se puoi, aiutami ad allargare i miei orizzonti. Portami dei materiali di base con cui possa creare delle nuove tinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Ci penserò io a risarcire le spese. Di nuovo, grazie davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Ti servono solo delle tinte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Date le circostanze, credo sia tutto ciò che posso fare al momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Se conosci dei materiali di base che potrei usare per preparare delle tinte \"nuove\", ti prego di portarmeli. Penserò io a coprire le spese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
