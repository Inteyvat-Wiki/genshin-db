			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "Uhm, questa bottiglia sembra pesante. Sembra che ci sia qualcosa dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280102,
					"content": "\"Un nostro vecchio amico è venuto ieri portando cattive notizie...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280103,
					"content": "\"È da molto tempo che non ricevo una tua risposta. Forse ha ragione lui, dovrei accettare la realtà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280104,
					"content": "\"Ma comunque, se sei ancora in giro per la terra, se dovessi ricevere questa lettera, spero che tu possa inviarmi una risposta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280105,
					"content": "\"Allega il tuo emblema alla lettera, in modo che io possa riconoscerti vedendolo, quando arriverà il momento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280106,
					"content": "\"Ti ricordi il Ristorante Uyuu? Ci incontreremo lì, insieme alla lettera ho messo i soldi per il vino.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280107,
					"content": "\"Ma se non sei la persona a cui ho scritto questa lettera...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701280108,
					"content": "\"Allora tieni pure questo ricordo, magari troverai il suo destinatario originale per me... E prendi anche i Mora come ringraziamento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Messaggio in bottiglia"
				}
			]
		}
	]
}