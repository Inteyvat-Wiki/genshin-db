			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "Per quanto riguarda la corrente d'aria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "Si? Avete scoperto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440103,
					"content": "Ecco cosa abbiamo scoperto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "Oh cielo... Mi chiedo a quando risalga la sua comparsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440105,
					"content": "Grazie per aver indagato, riferirò la situazione alla Gilda, ecco la vostra ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "Hai un incarico per noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "Un incarico, dite? Che tempismo perfetto! Stavo giusto pensando di cercare degli avventurieri esperti per indagare sulla strana corrente d'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440203,
					"content": "Quale strana corrente d'aria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "Lasciate che vi spieghi meglio. Non molto tempo fa, una piccola squadra di esploratori è andata in spedizione sulla montagna. Alcuni avventurieri molto esperti si sono uniti a loro, e hanno scelto un percorso sicuro lontano da tutti le aree pericolose conosciute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440205,
					"content": "Ma in qualche modo, lungo la strada si sono imbattuti in un'improvvisa e potente corrente di aria fredda e sono stati costretti a tornare all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440206,
					"content": "Ho parlato con gli avventurieri quando sono tornati. Hanno detto che non c'era spiegazione per una corrente d'aria così forte sul sentiero che stavano seguendo. A quanto pare, è arrivata dal nulla. Non sembra che si tratti di un fenomeno naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440207,
					"content": "Da allora, numerosi esploratori ed esperti hanno riferito la stessa situazione. Dopo aver organizzato alcune indagini per conto nostro, crediamo di aver finalmente individuato la fonte della corrente d'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440208,
					"content": "Sfortunatamente, tutti gli avventurieri che hanno preso parte alla ricerca si stanno ancora riprendendo da congelamento, affaticamento muscolare e altri problemi, quindi per il momento le nostre indagini sono ferme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440209,
					"content": "#Viaggiat{F#rice}{M#ore}, sareste dispost{F#e}{M#i} a continuare le indagini sulla fonte di questa corrente d'aria per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440210,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "#Grazie mille. Assicuratevi di essere ben preparat{F#e}{M#i} prima di partire... qualsiasi sia la causa, è davvero innaturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440215,
					"content": "Se non avete altre domande, vi lascio procedere con l'indagine. Grazie mille per la vostra assistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440212,
					"content": "Cosa ci guadagnerei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "Oh... Dritto al punto, vedo. Non preoccupatevi, la Gilda non si approfitta dei suoi avventurieri. Al vostro ritorno all'accampamento, troverete una ricompensa che vi aspetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440214,
					"content": "E per quanto riguarda l'entità della ricompensa... Beh, dipenderà dal valore delle vostre scoperte. Conoscete il punteggio, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				}
			]
		},
