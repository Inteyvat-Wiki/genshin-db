				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "\"Il melograno canta, le mele applaudono...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Salve, Khayyam! Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "#Oh, ciao, ciao. Bambina in bianco e... *sospira* scusate, ragazz{F#e}{M#i}. I miei ricordi sono confusi e dopo un po' dimentico i nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Chiamami pure {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Ahah... Ok, quindi siete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "#Sì! Siamo Javan, giovani coraggios{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Mmh... Quindi, ditemi, gli Aranara si ricordano ancora di me? Ricordano ancora tutti noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "Oh, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Ricordano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "Capisco... Ma non posso più vederli né sapere se sentono la mia mancanza... Che peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Ehehe... Non posso più vederli. Sono troppo vecchio per vedere i loro volti o sentire le loro voci... Svanito, è tutto svanito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "*tossisce*... Scusatemi, ora devo andare. Forse un miracolo è la mia unica speranza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "Non ci si può basare sui miracoli, l'unica cosa da fare è aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam se ne va barcollando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Hanno dimenticato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Ma... Possiamo diventare di nuovo loro amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305902,
