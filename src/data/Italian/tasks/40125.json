			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei",
					"Eula",
					"Lessig",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "...Se partissimo dal Villaggio di Aaru e facessimo una piccola deviazione, potremmo visitare il Ribat delle Carovane e il Pardis Dhyai sulla strada che porta alla Città di Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Ah, molto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Avete in mente di comprare qualche souvenir lungo la strada? Prendete pure quello che volete, penserò io a portare le buste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Il peso non conta, me la caverò! Purché non si tratti di qualcosa di veramente enorme, riuscirò a farci stare tutto dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Calmati, per quanta gente credi che compreremo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mamma, Albedo, la maestra Jean, Razor... Oh, e anche Diona, Mona e Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Umpf, cos'è quello sguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Nulla, nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Allora, Klee, hai già pensato a cosa comprare a tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Mmm... Delle caramelle al Tramontino! E dei cappelloni a forma di Miconoide! E poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "Un sacco di libri di racconti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Ma non ho ancora deciso cosa prendere alla mamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Non c'è fretta. Vediamo cosa troviamo e, se non riesci a decidere, possiamo aiutarti noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Evviva! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
