			"dialogs": [
				{
					"id": 401251101,
					"content": "Non intende portare con sé la conchiglia, signorina Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "No, credo che affidarla a Idyia sia la cosa migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "L'Isola di Watatsumi ora ha un nuovo tesoro da proteggere; e la gente, presto o tardi, riuscirà a raggiungere le sue aspirazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Sarà molto più utile qui, dove potrà proteggere questo dominio in bottiglia e i sogni di tutti coloro che passano per questi luoghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
