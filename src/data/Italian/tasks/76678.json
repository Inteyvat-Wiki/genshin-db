			"dialogs": [
				{
					"id": 760840201,
					"content": "Proviamo la canzone che canta sempre Colombina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "Proviamo la canzone che canta sempre Colombina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Quale tono dovrei scegliere?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Proviamone uno calmo e gentile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Che meraviglia. Hai davvero memorizzato la melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490605,
					"content": "Eheh, solo perché sei una bravissima cantante! Ogni volta che sentiamo la tua voce, ci fermiamo un attimo solo per ascoltarla un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Mmmh, anche la Kuuhenki sembrava piuttosto affascinata dalla tua esibizione. Forse ha imparato qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490607,
					"content": "Potrei aver bisogno di nuovo della tua assistenza accademica, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490608,
					"content": "Su, datemi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490609,
					"content": "Eh? No, no, era uno spettacolo gratuito! Non serve pagare una tassa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Mmmh? Una tassa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490611,
					"content": "Pensavo solo che... il delicato bagliore del chiaro di luna sarebbe stato l'accompagnamento perfetto per una melodia così bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490701,
					"content": "Optiamo per un tono allegro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, è già finita? Avrei potuto ascoltare per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490703,
					"content": "Come ti dicevo, è l'unica ninna nanna che riesco a ricordare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490704,
					"content": "Anche se non riesco a comprenderne il significato, dopo averti sentito suonare, mi sento come se la risposta mi stesse aspettando, lassù sulla luna... Almeno dev'essere bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490705,
					"content": "Su, datemi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490706,
					"content": "Non preoccuparti. Non c'è bisogno di darci qualcosa, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, non era questa la mia intenzione... Volevo solo adornare la tua melodia con un raggio di chiaro di luna gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
