			"dialogs": [
				{
					"id": 760540301,
					"content": "Forse... così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540302,
					"content": "Mmmh, vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540304,
					"content": "Lune... Lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540305,
					"content": "Va bene qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540306,
					"content": "Sembra che questa volta abbia vinto io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540307,
					"content": "Le mie tre lune sono collegate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540308,
					"content": "Bene, così dovrebbe andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540309,
					"content": "Mmmh... Le lune sorgono e tramontano in un ciclo infinito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540310,
					"content": "Sembra che nessuna desideri essere eclissata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540311,
					"content": "Stiamo... pareggiando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540312,
					"content": "Ah, vedo che stai riflettendo attentamente prima di decidere. Capisco. Prenditi tutto il tempo che ti serve. Dopotutto, ne abbiamo molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540313,
					"content": "Hai dimenticato come si posizionano le lune nel cielo notturno? Hai bisogno di aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540314,
					"content": "Non ti piace questo gioco? Mmmh... Io lo trovo divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540315,
					"content": "Mmmh? Mi stai fissando? Il tuo sguardo non è discreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540316,
					"content": "Mi stai fissando... La verità sulle lune è scritta sul mio volto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540317,
					"content": "Il tabellone è da quella parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540318,
					"content": "Mmmh, le tue lune sono allineate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540319,
					"content": "Il cielo notturno è tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540320,
					"content": "Ah... Devo aver sbagliato qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540321,
					"content": "Trascorri dei momenti meravigliosi giocando con Colombina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Grazie, mi sono divertita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540323,
					"content": "Se ti va... Vieni pure a tenermi di nuovo compagnia, qualche volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540324,
					"content": "Ecco, prendi questo come pegno della nostra promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
