					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Woah, le Kuuhenki hanno imparato cosa sono le attrezzature di laboratorio specializzate per questo gioco? Ce la stanno mettendo proprio tutta!",
					"roleType": "TALK_ROLE_NPC",
