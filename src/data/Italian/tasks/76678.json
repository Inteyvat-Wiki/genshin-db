						760830511
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830511,
					"content": "La risposta corretta è \"la grande papera meccanica accanto al laboratorio di Aino.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830512,
					"content": "Tornate qui. Grazie, so che non è stato facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830513,
