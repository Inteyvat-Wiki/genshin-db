				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Allora è così che stanno le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Anthony, sai se queste piante, oltre a essere commestibili, possono servire ad altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "E come dovrei saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "So solo dove puoi trovarle e se puoi mangiarle o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Mmh... Allora dovrò andare a vedere da sola. Non preoccuparti, vado solo a raccogliere delle piante. Non mi avvicinerò minimamente ai mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "...Oh, fa' attenzione, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Lo so, lo so. Allora oggi tornerò un po' tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Anna, ti stai ancora allenando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "#Ehi, ciao, viaggiat{F#rice}{M#ore}! Che tempismo! Stavo proprio pensando di andare a esaminare delle piante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Cyrus mi ha detto che spesso gli avventurieri si accampano nella natura, dove una delle abilità più importanti è saper cercare il cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Quindi, sto pensando di andare a esaminare delle piante selvatiche. Controllerò le loro caratteristiche e poi le memorizzerò con calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "In questo modo, almeno in futuro saprò cosa posso o non posso mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Comunque, penso che scrivere e basta non sia molto intuitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "#Viaggiat{F#rice}{M#ore}, mi hanno detto che hai un gadget che si chiama Fotokamera. Giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "In questo caso, potresti aiutarmi a fotografare alcune specie botaniche nel loro habitat naturale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Bene! Allora, potresti fotografare dei gigli di calla, della Lampadulina e delle Cecilie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Quando hai finito, aiutami a raccogliere queste tre specie botaniche, per favore. Mi piacerebbe conservarle come campioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Immagini di queste piante nel loro habitat naturale, esemplari vivi e descrizioni dettagliate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "La sezione botanica del mio manuale sembra in ottime condizioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "#Bene allora, viaggiat{F#rice}{M#ore}, conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "La sorgente al Villaggio Acquachiara accoglie un gran numero di gigli di calla, mentre la Lampadulina è comune nel Regno dei Lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "E le Cecilie devono trovarsi al Promontorio Acchiappastelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Nel frattempo io continuerò a esaminare piante altrove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Incontriamoci in città non appena hai le foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Come sta andando il tuo addestramento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
				2002026
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002025",
							"2"
						],
						"stepId": 2002025,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "#Eccoti di nuovo, viaggiat{F#rice}{M#ore}! Come è andata? Hai scattato tutte le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Foto e campioni al completo, ecco qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#Wow! Che velocità incredibile! Sei proprio {F#un'avventuriera}{M#un avventuriere} con esperienza, eh? Sono sbalordita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "#Grazie davvero, viaggiat{F#rice}{M#ore}! Che ne dici se per ringraziarti ti preparo qualcosa da mangiare? Ti prometto che sarà buono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Come ti sembra? Non male, no? Spero ti piaccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Ora vado a scrivere i miei appunti. Mmh, e queste piante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Chiederò a Jack se sa come si preservano i campioni di piante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "E credo che le Cecilie starebbero meglio in un vaso da qualche parte, piuttosto che essere trattate come campioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
