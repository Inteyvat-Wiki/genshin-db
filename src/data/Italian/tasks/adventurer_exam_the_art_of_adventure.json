	"talks": [
		{
			"id": 2002001,
			"completionStepIds": [
				2002001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
