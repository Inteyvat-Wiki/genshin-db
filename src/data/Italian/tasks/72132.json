				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Grazie per l'impegno. L'isola è ancora piena di pericoli, ma almeno stiamo trasmettendo speranza alle persone che hanno dovuto abbandonare la propria casa e vogliono tornarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Il fatto che la pioggia abbia smesso di cadere potrebbe rendere più aggressive le fazioni in lotta per il predominio sull'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Ma non sarebbero comunque state d'aiuto nel risolvere il problema dell'isola. Se non altro, le nostre azioni impediranno che la situazione peggiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Ecco il premio che ti ho promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Questa è la famosa lancia usata un tempo dai prefetti di Yashiori. Non so quanto possa esserti utile questo disegno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Ma se lo affiderai a un fabbro sufficientemente abile, dovrebbe essere in grado di ricreare ciò che un tempo Lord Kitain brandiva con orgoglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*sospira* Ahimè, l'età degli eroi è giunta e tramontata, e i Kitain, che un tempo vinsero tanti mali, non torneranno mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Tuttavia, grazie al tuo aiuto, sembra che siamo arrivati a un passo dall'eguagliare le gesta di Lord Kitain nel presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Ora raggiungerò i miei amici dell'esercito dello Shogunato, potrebbero aver bisogno di assistenza. Spero di rivederti, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
