			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210102,
					"content": "Ehilà, Colombina! Oggi sembri di buon umore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Ahah... Salite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210104,
					"content": "Facciamo una partita a Scacchi lunari o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Sì. È passato un po' di tempo dall'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210106,
					"content": "Le regole sono sempre le solite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Oppure ora puoi muovere più pezzi per turno perché sei la Dea trilunare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Sarebbe barare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210109,
					"content": "Hihi, certo, Paimon lo sa! Voleva solo scherzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "Allora, vogliamo cominciare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
		{
