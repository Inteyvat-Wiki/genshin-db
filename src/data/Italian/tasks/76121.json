				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Forse... così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540302,
					"content": "Mmmh, vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540304,
					"content": "Lune... Lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540305,
					"content": "Va bene qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540306,
					"content": "Sembra che questa volta abbia vinto io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540307,
					"content": "Le mie tre lune sono collegate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540308,
					"content": "Bene, così dovrebbe andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540309,
					"content": "Mmmh... Le lune sorgono e tramontano in un ciclo infinito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540310,
					"content": "Sembra che nessuna desideri essere eclissata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540311,
					"content": "Stiamo... pareggiando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540312,
					"content": "Ah, vedo che stai riflettendo attentamente prima di decidere. Capisco. Prenditi tutto il tempo che ti serve. Dopotutto, ne abbiamo molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540313,
					"content": "Hai dimenticato come si posizionano le lune nel cielo notturno? Hai bisogno di aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540314,
					"content": "Non ti piace questo gioco? Mmmh... Io lo trovo divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540315,
					"content": "Mmmh? Mi stai fissando? Il tuo sguardo non è discreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540316,
					"content": "Mi stai fissando... La verità sulle lune è scritta sul mio volto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540317,
					"content": "Il tabellone è da quella parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540318,
					"content": "Mmmh, le tue lune sono allineate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540319,
					"content": "Il cielo notturno è tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540320,
					"content": "Ah... Devo aver sbagliato qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540321,
					"content": "Trascorri dei momenti meravigliosi giocando con Colombina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Le tre lune, allineate una dopo l'altra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210203,
					"content": "Mmh? Stai ancora pensando a com'è andata l'ultima partita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Oh, no. È solo che... ripensare alla partita ora mi dà una strana sensazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210205,
					"content": "Ah, certo. Adesso che hai il potere di tre lune, sei diventata più di una semplice entità che domina il cielo notturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Sì. E penso anche... che il destino del mondo sarebbe stato diverso, se non ci fosse stata una divisione tra le tre Dee della luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210207,
					"content": "Com'erano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "La prima che ho incontrato è stata Sonnet della Luna iridescente. Era più vivace di quanto immaginassi, dava l'aria di una sorellina giocosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210209,
					"content": "Aria della Luna eterna era la più matura delle tre. Era una leader nata e trattava tutti con gentilezza. Ah, era proprio come Lauma, in effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210210,
					"content": "Canon della Luna gelata... sembrava saggia e lungimirante. È stata lei a donarmi la sua luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210211,
					"content": "Si direbbero tutte divinità benevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Sì. Nonostante le loro differenze, amavano Teyvat e amano questa casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210213,
					"content": "Quando ho parlato loro delle cose a venire, sembravano tutte sollevate, felici che questo mondo abbia ancora un futuro così ricco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210214,
					"content": "È anche per questo che mi hanno dato il potere di tornare a \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210215,
					"content": "Mmh... A Paimon piacerebbe tanto incontrarle e ringraziarle per bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Piacerebbe molto anche a me. Ma temo che non sia più possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210217,
					"content": "Fortunatamente, questo mondo va avanti, e gli umani che loro hanno protetto sono sopravvissuti e tramandano le loro storie ancora oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210218,
					"content": "Esatto! Finché vivremo bene e impediremo ai malvagi di distruggere il mondo... questo è il modo migliore che abbiamo per ringraziarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Ci sai proprio fare con le parole, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Quindi, per te ogni giorno è un giorno di cui essere grati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Certo! Paimon cerca sempre di godersi la vita al massimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Anche tu, Colombina! Mangia e dormi bene ogni giorno, e vieni a trovarci se vuoi giocare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Ahah, certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761210224,
					"content": "Sospetto che d'ora in poi penserò a quelle tre dee gentili ogni volta che giocherò a Scacchi lunari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
