	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"La Damigella"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "...Mmmh, forse il tono è un po' troppo alto. Riproviamo, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490102,
					"content": "Ehilà! Ciao, Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Aspetta, ma stai... insegnando alle Kuuhenki come suonare la lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Sì. Erano così felici che fosse stata riparata che non mi hanno lasciato per un secondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490105,
					"content": "Suonare la lira non è mai stato il mio forte. Sono più abituata ad ascoltare gli altri suonare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490106,
					"content": "Ohhh, giusto! Se fossi in un gruppo, tu saresti sicuramente la cantante, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Quando si tratta di strumenti, {NICKNAME} è un vero prodigio! Dalla lira al Tamburo Djem Djem, sa suonare tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "#Non sono così {F#brava}{M#bravo}, dai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Oh, ma davvero? In tal caso... Forse potresti insegnarglielo tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490111,
					"content": "Va bene, perché no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Le stavo facendo esercitare con la canzone che canto di solito. Forse ti ricordi come fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490114,
					"content": "Oppure... anche un'altra melodia va bene. È raro che le Kuuhenki riescano ad ascoltare musica da altri luoghi. Anche io sarei curiosa di ascoltare qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490115,
					"content": "(Mmmh, cosa potrei suonare?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Proviamo la canzone che canta sempre Colombina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Quale tono dovrei scegliere?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Proviamone uno calmo e gentile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Che meraviglia. Hai davvero memorizzato la melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490605,
					"content": "Eheh, solo perché sei una bravissima cantante! Ogni volta che sentiamo la tua voce, ci fermiamo un attimo solo per ascoltarla un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Mmmh, anche la Kuuhenki sembrava piuttosto affascinata dalla tua esibizione. Forse ha imparato qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490607,
					"content": "Potrei aver bisogno di nuovo della tua assistenza accademica, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490608,
					"content": "Su, datemi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490609,
					"content": "Eh? No, no, era uno spettacolo gratuito! Non serve pagare una tassa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Mmmh? Una tassa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490611,
					"content": "Pensavo solo che... il delicato bagliore del chiaro di luna sarebbe stato l'accompagnamento perfetto per una melodia così bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490701,
					"content": "Optiamo per un tono allegro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, è già finita? Avrei potuto ascoltare per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490703,
					"content": "Come ti dicevo, è l'unica ninna nanna che riesco a ricordare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490704,
					"content": "Anche se non riesco a comprenderne il significato, dopo averti sentito suonare, mi sento come se la risposta mi stesse aspettando, lassù sulla luna... Almeno dev'essere bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490705,
					"content": "Su, datemi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490706,
					"content": "Non preoccuparti. Non c'è bisogno di darci qualcosa, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, non era questa la mia intenzione... Volevo solo adornare la tua melodia con un raggio di chiaro di luna gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490801,
					"content": "Proviamo qualcosa di un'altra nazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Che cosa particolare... Ho già sentito melodie di questo tipo prima, ma la tua musica conferisce loro una dimensione completamente nuova...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490803,
					"content": "Ah, forse è perché sta canalizzando il suo legame emotivo con quel luogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "La cosa particolare è che... Mi sembra di poter immaginare il paesaggio solo ascoltando la melodia. Mi chiedo come sia il vero luogo rispetto alla mia immaginazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490805,
					"content": "Dovresti andarlo a vedere, un giorno! Possiamo farti da guida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mmmh... Forse. Se mai dovesse arrivare quel giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490112,
					"content": "Che cosa dovrei suonare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Sì, so suonare qualcosina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
