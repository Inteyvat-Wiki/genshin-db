			"dialogs": [
				{
					"id": 760380201,
					"content": "Una scultura di zucchero, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "Ecco qua. Mi raccomando, mangiala in fretta una volta aperta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
