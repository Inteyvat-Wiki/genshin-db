			"dialogs": [
				{
					"id": 760380901,
					"content": "(A <color=#FFCC33FF>Colombina</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Sculture di zucchero... Credo di averle già assaggiate. Potresti farmene una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380903,
					"content": "Certo! Un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380904
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380904,
					"content": "(Mm... Dove ho già visto questa ragazza in città...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380905
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380905,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380906
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380906,
					"content": "(Wow! Sembra così entusiasta... Ah, pensa, pensa! Che stile le potrebbe piacere di più?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380907,
					"content": "(Segui il tuo istinto... Fidati del tuo intuito... Ok, ok! Lo so!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Uhm... Ho finito. Allora... Ti piace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "È magnifica. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380910,
					"content": "Eheh, ne sono felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Sì, il mio istinto aveva ragione: questo stile leggero e arioso si addice proprio a una ragazza così spensierata!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mmm, è anche molto buona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380913,
					"content": "Potresti prepararne altre due? Vorrei portarle con me per farle assaggiare anche alle Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380914,
					"content": "Per... le Kuuhenki? Beh, potrei, ma non ho abbastanza ingredienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Allora tornerò domani e li porterò con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760380916,
					"content": "Nessun problema... A presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
