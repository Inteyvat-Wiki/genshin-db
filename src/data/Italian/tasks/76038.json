			"dialogs": [
				{
					"id": 760381001,
					"content": "(A <color=#FFCC33FF>Illuga</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Beh, visto che sono già qui... Salve, una scultura di zucchero, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Ah! Sarebbe possibile averne una un po' più piccola? Temo di non riuscire a finirla tutta in una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Nessun problema! Quelle piccole sono altrettanto buone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Comunque, voi Guardaluce avete davvero un bel da fare... Nemmeno il tempo di gustarvi una scultura di zucchero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Ehm... Ahaha... Beh, non è sempre per via del lavoro. A volte è perché mi imbatto in qualcuno che ha bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Le sculture di zucchero mangiate a metà sono difficili da conservare. Posso solo avvolgerle in un panno e infilarmele in tasca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Ma quando ho finito di aiutare e la tiro fuori, ormai si è sciolta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Capisco... Vediamo un po'. Una piccola scultura di zucchero... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Ci sono! Posso creare una piccola scultura con gusti diversi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Metto questo sapore alla base... Poi quest'altro sopra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "Benissimo! Ecco fatto, una mini scultura di zucchero multigusto! Soddisfa le sue esigenze, gentile cliente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, è perfetta! Grazie, signorina Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Oh, di niente. Di certo non sono in grado di aiutare voi Ratniki nel vostro lavoro... Ma posso farvi tutte le sculture di zucchero che desiderate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "È nostro dovere. Troppo gentile, signorina Hunajatta... Ora mi congedo, ho altro lavoro che mi aspetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Certo, stia bene! E la prossima volta che vorrà una scultura di zucchero, venga a trovarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
