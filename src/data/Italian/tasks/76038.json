			"dialogs": [
				{
					"id": 760380508,
					"content": "(Ad <color=#FFCC33FF>Aino</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Ciao capo! Una scultura di zucchero, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Oh, signorina Aino! Da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Eheh. Sono arrivata in città per dare una mano con delle riparazioni, così ho pensato di fare un salto per comprare delle caramelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Anzi, dato che Ineffa non è nei paraggi... ti dispiacerebbe preparamene qualcuna in più? E falle ancora più dolci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Certo, nessun problema... ma ricordati di lavarti i denti dopo mangiato, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Sì, sì, lo so, lo so. Mi lavo sempre i denti dopo aver mangiato dolci! I miei denti sono perfetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380507,
					"content": "Ahah... D'accordo, allora aspetta un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
