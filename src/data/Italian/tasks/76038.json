			"dialogs": [
				{
					"id": 760380701,
					"content": "(A <color=#FFCC33FF>Jahoda</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "Capo, una extra large, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Non è la prima volta che vieni qui, Jahoda. Sai che le dimensioni delle nostre sculture di zucchero sono fisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Dai, oggi ho avuto una giornata fantastica! Sbrigati, dai, fanne una un pochino più grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Una giornata fantastica? Il tuo incarico è andato bene, immagino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Eheh, ovviamente. Era una semplice missione di scorta. È stata una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Nemmeno un capello torto alla testa del cliente, e neanche un graffio alle merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Ok, basta parlare. Veloce, fammi una scultura di zucchero più grande da portar via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Nessun problema. Dammi un minuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
