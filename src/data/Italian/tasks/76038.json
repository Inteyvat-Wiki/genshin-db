			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Forse <color=#FFCC33FF>Lauma</color> è interessata alle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Potrebbe prepararmene qualcuna, signorina Hunajatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Certamente, signorina Lauma. Ai bambini sono piaciute quelle che ha riportato l'ultima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Eheh, moltissimo. In realtà, alcuni di loro si sono convinti a rovinare i loro bellissimi dolcetti solo quando ormai si erano quasi sciolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Capisco... Allora facciamo così: la prossima volta verrò da voi con i miei utensili, allestirò una postazione e li preparerò per i bambini al momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Oh, sarebbe fantastico. I bambini saranno felicissimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, ma ora torniamo a noi. Vado a preparare le sue sculture di zucchero. Quando saranno pronte, chiederò a qualcuno di consegnarle agli Eredi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Ma prima... Eheh, mi è venuta un'idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Mi dia un momento, signorina Lauma. Le preparerò qualcosa di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
