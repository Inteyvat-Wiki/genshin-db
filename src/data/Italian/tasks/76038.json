				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "(Forse <color=#FFCC33FF>Flins</color> ha un interesse per le sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Signorina Hunajatta. Se posso permettermi, potrebbe prepararmi una scultura di zucchero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Oh, certo. Tu sei... Flins, il Ratnik, giusto? Penso di averti già visto in negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Sì, di fatti a volte passo qui a fare acquisti. Sono onorato che si sia ricordata di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Oggi, invece, passavo di qui per caso e ho notato la sua bravura nel modellare lo zucchero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "E, dopo averci riflettuto a lungo, ho deciso di chiederle di realizzare una scultura di zucchero per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Oh, non c'è bisogno di essere così formali. Mi fai arrossire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Attendi un attimo, te ne porterò subito una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Mmh, forse dovremmo fare qualcosa di speciale per il nostro buon Ratnik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
