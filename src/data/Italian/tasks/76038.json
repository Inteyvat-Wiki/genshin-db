					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760381109,
					"content": "(Forse a <color=#FFCC33FF>Linnea</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Oh, ciao, Linnea! Sei venuta a comprare altre sculture di zucchero per Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Sì! Lumi adora talmente tanto le tue sculture di zucchero che non se la sente di mangiarle. Ogni volta, si limita a leccarle leggermente e poi me le ridà affinché le tenga al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Però, essendo fatte di zucchero... col tempo finiscono per sciogliersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Quindi, se non è di troppo disturbo, Hunajatta, posso chiederti di prepararmene un'altra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Nessun problema! Solo un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Lumi è davvero un amore... Quanto vorrei accarezzarla! Ma farlo sarebbe scortese. Beh, lasciamo stare...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Ecco qua, Linnea! Una scultura di zucchero per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Grazie infinite! Lumi, è pronta. La vuoi adesso, oppu... Ah, si è addormentata. Gliela darò più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
