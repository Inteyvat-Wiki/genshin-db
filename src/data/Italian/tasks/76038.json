			},
			"dialogs": [
				{
					"id": 760380601,
					"content": "(Forse a <color=#FFCC33FF>Ineffa</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Mi scusi. Potrei chiederle di prepararmi una scultura di zucchero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Certo. Per la signorina Aino, presumo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Negativo. Aino mi ha ordinato di venire a comprare una bella scultura di zucchero per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Secondo lei, questo fa parte del mio addestramento nelle \"attività sociali\", che dovrebbe rendere i miei acquisti futuri molto più semplici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Io non lo capisco. Non ho bisogno di assumere così tanti zuccheri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Ho il sospetto che Aino finirà per mangiarsi questa scultura di nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380610,
					"content": "Signorina Hunajatta, potrebbe preparare una scultura di zucchero di dimensioni più piccole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380611,
					"content": "Aino adora le caramelle, ma credo che dovrebbe mangiarne un po' di meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380612,
					"content": "Nessun problema, ci penso io... Ora, vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
