			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(Forse a <color=#FFCC33FF>Nefer</color> potrebbero interessare delle sculture di zucchero...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Hunajatta, vorrei una scultura di zucchero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "Che sorpresa inaspettata, Lady Nefer. Cosa la porta qui oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "Trovo che uscire a fare una passeggiata qualche volta faccia bene, tanto al corpo quanto all'anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "Inoltre, mangiare qualcosa di dolce aiuta anche a pensare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "Splendido! Mi dia un attimo, preparo subito il suo ordine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Molte grazie. Ah, e prendi anche questi soldi. La prossima volta che verrà Jahoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "Dovrò farle una scultura più grande? O più dolce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "...Consegnale questi Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "E dille: \"Nefer ha pagato il doppio. Quando avrai finito di battere la fiacca, porta una scultura di zucchero anche a lei, già che ci sei\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
