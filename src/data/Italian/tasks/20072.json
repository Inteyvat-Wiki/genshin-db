				"points": []
			},
			"dialogs": [
				{
					"id": 200720101,
					"content": "In che stato sono i fiori che abbiamo conservato prima sul Picco del Drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "#Sono riuscit{F#a}{M#o} a recuperare solo un contenitore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "Gli altri non potevano essere recuperati? Mmh... Va bene, allora. Dopotutto, è piuttosto difficile prevedere le condizioni su quella montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Ma se ne abbiamo solo uno, non possiamo fare alcun confronto. Immagino che dovremo solo aspettare l'opportunità di svolgere un'altra ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Grazie per il disturbo, comunque. Ecco, ho una ricompensa per te... Potrei aver bisogno nuovamente del tuo aiuto, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007202,
			"completionStepIds": [
				2007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
