				"objectNames": [
					"Mahina Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Il signor Milu ha pubblicato un nuovo disco! Non so se comprarlo o meno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Parlami della musica di Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Mmmh? Oh, è fantastica! Haloa e i piccoli Saurici la adorano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Tutte le volte che fanno i capricci e non vogliono dormire, gli faccio ascoltare la \"Canzone del giorno di primavera\" del signor Milu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Appena la sentono, si addormentano in un baleno: sogni d'oro e a domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Però... Haloa ha detto che preferirebbe ascoltare qualcosa di più vivace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Se il signor Milu riuscisse a comporre un paio di brani un po' più briosi, sono sicura che le piacerebbero ancora di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
