					"content": "Sembri non avere problemi a persuadere anche i tipi più irrequieti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271303,
						250271305
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271303,
					"content": "E non ho neanche usato tutto il mio potere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271304
					]
				},
				{
					"id": 250271304,
					"content": "Me ne sono accorto. È impossibile non notarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "Beh, è stata una bella avventura e sono riuscito a individuare tanti suoni da campionare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Terminata la preparazione, potrò iniziare a registrare l'audio effettivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271309,
					"content": "Mmmh... Dovremmo iniziare con i \"suoni della battaglia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "Anzi, no. Non è un buon punto di partenza. È meglio iniziare con qualcosa di più consueto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271305,
					"content": "Penso sia andata bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271306
					]
				},
				{
					"id": 250271306,
