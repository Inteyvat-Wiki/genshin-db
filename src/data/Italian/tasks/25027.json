			"dialogs": [
				{
					"id": 250270901,
					"content": "Potresti provare a raccogliere alcuni campioni sonori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Campioni? Oh, vuoi dire che potremmo riprodurre i suoni della natura direttamente nelle canzoni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Mmmh... Mi sembra una buona idea. Sì, proprio bella! Sapevo di poter contare su di te! Forza, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Aspetta, non porti niente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Certo che no. Devo forse trascinarmi dietro un grammofono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Non preoccuparti, andiamo semplicemente a scoprire che tipo di suoni possiamo usare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Il battito d'ali di un'anatra, il tonfo di un Koholasauro nell'acqua, il rumore dei passi di un Tepetlisauro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Una volta scelti i soggetti giusti, farò i preparativi necessari per prelevare i campioni sonori... Ma più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Per il momento, andiamo... Stiamo perdendo tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
