			},
			"dialogs": [
				{
					"id": 250270401,
					"content": "Guarda quegli uccelli, ascolta i loro versi! Oh, sarebbero ottimo materiale per il mio prossimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Ma il suono sarebbe troppo monotono, se ne registrassimo solo alcuni. Dovremmo trovare un intero stormo e registrare i loro richiami di gruppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Aspetta, c'è un Koholasauro poco più avanti. Senti come graffia la pietra con gli artigli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Non avviciniamoci troppo, i Koholasauri sono molto sensibili. Dopo chiamerò alcuni professionisti della nostra tribù per raccogliere ciò che mi serve: sono gli unici in grado di farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Oh... Guerrieri che si battono l'uno contro l'altro. Ottimo, ottimo, i rumori della battaglia sono davvero suggestivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Ehi! Perché vi aggirate di soppiatto? State cercando guai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Guerriero della tribù arrabbiato"
				},
				{
					"id": 250270407,
					"content": "Stiamo solo... raccogliendo dei materiali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
