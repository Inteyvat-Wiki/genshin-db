			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Non riesco proprio a comunicare con Pakaa... Non capisce affatto le mie inclinazioni musicali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#Mmmh? Sei... {F#una viaggiatrice}{M#un viaggiatore}...? Ti porgo i miei saluti. Mi chiamo Milu Nui, sono un musicista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "Se hai visitato il Negozio di musica Xochicuicatl, avrai visto alcuni dei miei album nella sezione di musica pop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Quei dischi racchiudono interamente la mia concezione del \"pop\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Il problema è che Pakaa non mi capisce affatto, e si ostina a dire che le mie sembrano più \"canzoni per bambini\" che \"pop\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "E qualsiasi cosa gli dica, vuole che i miei dischi vengano esposti nella sezione dedicata ai bambini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "È vero che le mie canzoni piacciono ai piccoli, e che alcuni genitori le comprano per regalarle ai propri figli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "Ma è perché i bambini sono gli ascoltatori più appassionati! E poi la tribù ne è piena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Perciò... Se la mia musica è così popolare tra i bambini, dev'essere inserita nella sezione pop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Beh... Non fa una piega...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Vero? Umpf! Lo sapevo che Pakaa era il solito ignorante. Ma adesso basta! Quando ascolterà la mia nuova canzone, non potrà fare a meno di riconoscere le mie capacità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "#Non che mi fidi più dei suoi gusti musicali, ma... Comunque sia, {F#viaggiatrice}{M#viaggiatore}, quanto te ne intendi di musica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "Suoni uno strumento? Va bene anche se ti limiti a cantare o canticchiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Dal punto di vista musicale sono davvero versatile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "Fantastico! Allora capirai sicuramente la mia filosofia musicale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "Ho bisogno proprio di una persona come te per creare la mia nuova canzone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "Non preoccuparti, ti ricompenserò profumatamente. Ti garantisco che ne varrà la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "D'accordo, allora. Affidati al tuo intuito e dimmi: qual è la prima cosa che devo fare per creare un ottimo brano musicale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Neanche lontanamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "Non importa! Solo una persona come te può godersi la musica con il cuore. Sono sicuro che il tuo giudizio sarà ancora più obiettivo e giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "Potresti considerarlo \"pop per bambini\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "E quali sarebbero queste inclinazioni musicali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
