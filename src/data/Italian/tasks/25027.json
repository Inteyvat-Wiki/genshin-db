						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "Ecco le opinioni che ho sentito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Riferisci a Milu Nui i commenti degli ascoltatori...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "A-Ah... È così che la pensano? Grazie, sono commenti molto preziosi. Vediamo che modifiche posso fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Eppure, a pensarci bene... Sembra che considerino i miei dischi come delle \"canzoni per bambini\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "No, non importa, un motivo in più per fare dei cambiamenti... Ma da dove comincio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
