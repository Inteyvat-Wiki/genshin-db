				"points": []
			},
			"dialogs": [
				{
					"id": 200170401,
					"content": "#Grazie davvero, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170402,
					"content": "Sembrano molto insistenti, comunque. Non posso più restare qui, è troppo pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170403,
					"content": "Hanno sfasciato il carretto di nuovo. Non ha senso aggiustarlo da cima a fondo... Dovrò semplicemente arrangiarmi avvolgendolo con una corda. Oh santo cielo, dov'è la mia corda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170404,
					"content": "#Non è possibile! Quei mostri devono essersela portata via! Viaggiat{F#rice}{M#ore}... Puoi vedere se riesci a trovare qualche <color=#00E1FFFF>corda</color> nei paraggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001705,
