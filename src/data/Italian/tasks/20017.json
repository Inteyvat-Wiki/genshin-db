					"content": "Ovviamente no!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200171002
					]
				},
				{
					"id": 200171002,
					"content": "Ehi, aspetta! E cosa dovrei fare se tornano?! Tirargli delle mele addosso non servirà a molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200171003
