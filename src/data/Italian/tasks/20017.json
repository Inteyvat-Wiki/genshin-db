				"points": []
			},
			"dialogs": [
				{
					"id": 200170301,
					"content": "Ne hai trovate un bel po'. Mi lavo le mani e aggiusto subito il carretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170302
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170302,
					"content": "#Eh? E-Eccoli di nuovo! Viaggiat{F#rice}{M#ore}! Sono tornatiiiiii!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
