			"dialogs": [
				{
					"id": 200170601,
					"content": "Perfetto. Mi basterà almeno fino all'arrivo in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170602
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170602,
					"content": "#Grazie per l'aiuto, viaggiat{F#rice}{M#ore}. Spero che ci incontreremo di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170603
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170603,
					"content": "Uff, come farò a eliminare quest'odore disgustoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
