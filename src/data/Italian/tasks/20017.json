			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Farrah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "#No, ti prego! Non colpirmi! No... eh? Viaggiat{F#rice}{M#ore}, dove sono finiti gli Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Fantastico! Grazie mille! Se ne sono davvero andati tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Fiuuu... Ti devo un favore. Ma dopo tutto quel casino ora non posso più raggiungere la carovana in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "E in più il mio carretto è rotto. Devo farmelo riparare e arrivare in città prima che la frutta marcisca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Se tutta questa frutta marcisce... Non puoi nemmeno immaginare la puzza. Impossibile lavarla via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Dovrò fare di nuovo l'inventario... Sento già l'odore di parte della frutta andata a male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Per favore, puoi aiutarmi a cercare dei materiali con cui riparare il mio carretto? Un'<color=#00E1FFFF>asse robusta</color> dovrebbe bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
