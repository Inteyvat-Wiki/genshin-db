			},
			"dialogs": [
				{
					"id": 200170201,
					"content": "Dovrebbero esserci molte <color=#00E1FFFF>assi robuste</color> nel bosco. Per favore, sbrigati. Se aspettiamo ancora molto tempo, tutta la frutta andrà a male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001703,
