			"dialogs": [
				{
					"id": 200170801,
					"content": "Lascio fare a te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200170802
					]
				},
				{
					"id": 200170802,
					"content": "Aspetta! Ti prego... Senti questa puzza? Ora, immagina questo odore, ma mille volte peggio... Ecco come sarà il mio carretto se non sposto subito tutta la frutta! Ti prego, aiutami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
