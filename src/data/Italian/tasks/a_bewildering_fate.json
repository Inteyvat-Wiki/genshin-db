			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "L'ho trovata! Ecco la scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Per fortuna le esplosioni non l'hanno danneggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "Recupero completato! Riportiamola indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "#Finalmente siete tornat{F#e}{M#i}. L'attesa è stata davvero noiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Volevo leggere un libro per passare il tempo, ma questo è soltanto un ridicolo diario che non contiene nulla di interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "È caduto dallo zaino di Klee, così pensavo che potesse contenere qualche antico insegnamento, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Non ha importanza. Allora? Avete trovato la scatola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Sì. È in condizioni perfette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "Magnifico! Ma... Un momento... P-Perché non è chiusa a chiave?! E come mai è vuota?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Beh... Perché l'ho presa in prestito per conservare i miei tesori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "Presa in prestito?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Ma visto che sei venuta fin qui per prenderla, ci ho tolto i miei tesori da dentro. Ecco perché ora è vuota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "Tu... l'hai usata per metterci le tue cose?! A-Allora dove hai messo il vecchio contenuto? Io sto cercando quello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Oooh... Vuoi quello che c'era dentro prima? Lo potevi dire subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "Non l'hai... rotto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "No, no! Non è per niente rotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Fiuuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "È il libro che hai in mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "Cooosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "Q-Questo... Quindi questo libro... Questo diario... è il diario che cinquant'anni fa apparteneva a quella megera?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "Ciò che voleva tanto riavere dopo cinquant'anni era l'oscura storia della sua gioventù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Ah! Sono finita! Ora capisco perché la vecchia ha minacciato di farmi a pezzi, se avessi guardato nella scatola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Sono... Sono nei guai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Ah! Sei tu che hai detto di volere la scatola! Non avevi parlato di quello che c'era dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "Non voglio saperne nulla. Ora vado! Ciao ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "Che finale toccante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Beh... la tua maestra non lo scoprirà se non le dici niente, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "Impossibile. L'astrologia può vedere attraverso qualsiasi menzogna. Ne siete stati testimoni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*sospira* Dopo aver speso tutti i Mora che avevo per raggiungere Mondstadt, non solo non ho ottenuto nuove conoscenze, ma ora non posso più nemmeno tornare indietro... Com'è potuto accadere...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Ahhh, è così triste... Forse potresti dimenticare tutto quello che hai letto e poi tornare comunque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "No... troppo difficile. E anche se volessi rimanere a Mondstadt, sarebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "Troppo imbarazzante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Sì. Come potrei conservare una giusta mentalità da astrologa se rimanessi in mezzo a tutti questi filistei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "Beh, allora dovrai tornare e affrontare la tua maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "S-Smettila di dirlo! Io... credo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Dovrò restare temporaneamente a Mondstadt. Quando la vecchia megera avrà vissuto l'ultimo dei suoi giorni, sarò libera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Un proposito intimidatorio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Ma come farò con le mie ricerche astrologiche? Anzi... non ho nemmeno un posto in cui stare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Riguardo a questo, possiamo chiedere a <color=#00E1FFFF>Katheryne alla Gilda degli avventurieri</color>. Forse può aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "La Gilda degli avventurieri? Ah, giusto, si possono fare commissioni per loro in cambio di... Avete capito cosa intendo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Oh. Uhm, grazie. Io... Niente, come non detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "L'idea era proprio quella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "A me non sembra una cosa tanto \"temporanea\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Troppo costoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Sì... Cioè, no! Non ci sai proprio fare con le parole, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "Non c'è motivo di prendersela con Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050208",
							"2"
						],
						"stepId": 1050208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "A proposito di Mona e del suo problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "Mmh... Capisco la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "Qui a Mondstadt c'è un <color=#00E1FFFF>laboratorio di magia</color> su cui uno sconosciuto ha posto un sigillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "Anche se abbiamo alcuni specialisti che potrebbero rompere il sigillo, hanno già tutti il proprio laboratorio, quindi non sono interessati alla cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "Se l'astrologa di cui mi avete parlato fosse in grado di romperlo, al proprietario della casa non importerebbe se rimanesse ad abitare lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "Credo che possa farcela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Molto bene. Allora ti dirò dove si trova la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "La porterò là a dare un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "Questo sigillo... non è il lavoro di un dilettante. Spezzarlo con la forza è praticamente impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Interessante. Suppongo valga la pena usare la mia astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Diamo un'occhiata... Mmh... Quindi se faccio prima questo... e poi quest'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "Molto bene: aperto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "Accipicchia! Ma è incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "Ora non ci resta che tornare da Katheryne, dopodiché potrai abitare qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "Non ce n'è bisogno. Vi ringrazio di cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "E lei chi sarebbe... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Oh, sono Goth, il proprietario della casa. Sono passato dalla Gilda degli avventurieri poco fa e Katheryne mi ha parlato della cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "Non avrei mai pensato che quel fastidioso sigillo potesse essere spezzato tanto velocemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "Quindi posso rimanere qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Ma certo. In fondo finora è rimasto tutto abbandonato a sé stesso. Sarei felice se qualcuno ci abitasse di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "Per esprimerti la mia gratitudine, ti affitterò la casa al prezzo più basso possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "A-Affitto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "Nessuno aveva parlato di affitto... e ho anche dato una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Sì, certo, capisco. Te ne sono molto grato, per cui ti assicuro che l'affitto sarà davvero ragionevole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "Io... Ecco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Paimon crede che Mona abbia frainteso la situazione, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "Credo che sia l'opzione migliore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "*sospira* Suppongo di non avere altra scelta... Prenderò in affitto la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "Ottimo! Allora siamo d'accordo. Vado subito a preparare i documenti. Aspettami qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Grazie per l'aiuto. E... mi dispiace di non poter ricambiare al momento in rispetto al nostro accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "Senza gli strumenti giusti e senza nuove conoscenze, mi ci vorrà un po' per vedere il tuo destino chiaramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "Ma ti prometto che ti farò una lettura non appena sarò pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "Come avevi detto all'inizio, questo viaggio ha avuto solo lati positivi per me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "Grazie. Il nostro viaggio insieme è stato deciso dal fato... che è stato benevolo, aggiungerei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "#Auguro a entramb{F#e}{M#i} un buon viaggio! Quanto a me, anch'io dovrò pensare al mio futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "Come farà a guadagnarsi da vivere, visto che non usa l'astrologia per denaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "Forse dovremmo tornare a farle visita ogni tanto per vedere come sta. Sarebbe davvero terribile se dovesse svenire per la fame là dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "Allora suppongo che dovrai continuare a lavorarci su.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "Sì... Non so ancora cosa fare esattamente, ma... farò comunque del mio meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "Risparmia un po' qui, fai un po' d'economia là e vedrai che ce la farai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
		},
