				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "#Siete pront{F#e}{M#i}? Non fatemi fare brutta figura, perché stiamo per incontrare la persona che custodisce la scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "Non so predire il futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "Suppongo che... No! Anche un semplice discepolo deve conoscere almeno i concetti base dell'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "Una delle nostre regole è che non possiamo insegnare agli estranei, ma immagino di poter fare un'eccezione con te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "La mia astrologia si basa sull'idromanzia. Come suggerisce il nome, uso i riflessi sulle superfici d'acqua per osservare l'autentico cielo stellato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "Lasciate che vi dia una dimostrazione. Guardate bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "In base all'attuale posizione e movimento degli astri... riesco a vedere che l'erede della conoscenza... è una giovane donna... nonché Cavaliere di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "Sembra la descrizione di... Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "L'incontreremo qui tra non molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Beh, è tutto ciò che ci serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "T-Tutto qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "*sospira* A quanto pare anche l'astrologia più elementare è difficile da afferrare al volo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "Ma non importa. Vi spiegherò tutto in dettaglio più tardi. È arrivata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "#Wow, sei proprio tu, prode Cavaliere Onorari{F#a}{M#o}! E c'è anche Paimon! Siete tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "Eccola! È lei l'erede della conoscenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "Intendi... Klee?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "Erede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "Esatto. Sono l'astrologa che ha sondato le profondità dell'oceano di stelle. Sono certa che anche tu abbia previsto il mio arrivo da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "Un oceano di stelle? Cos'è? Ci sono anche i pesci dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "Pesci? No... non fare la finta tonta! Mi stai per caso prendendo in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "Dovrei essere io a chiedertelo! Non ho capito niente di ciò che hai detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "Non stiamo facendo molti progressi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "Le mie predizioni non possono sbagliare! Verifichiamo... Il nome di tua madre è Alice, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "Esatto! Quindi sei un'amica della mamma! Ma lei è andata molto lontano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "Come previsto dalla mia divinazione... Ma prima di partire, tua madre deve averti insegnato le sue arti mistiche, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "Arti... mistiche? Io... non capisco... La mamma mi ha soltanto insegnato a fare Conigli Bumbum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "Quindi la madre di Klee sarebbe l'amica, nonché rivale, della maestra di Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Sì. Per quanto abile nell'astrologia, la mia maestra non conosceva altro, mentre Alice era abile anche in molti altri campi mistici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Klee è molto giovane, quindi, anche se avesse sentito parlare di queste conoscenze, potrebbe non averle comprese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Sì... A quanto pare ha ereditato le capacità innate di sua madre, ma non la conoscenza... Un grossolano errore nei miei calcoli. Stando così le cose, non può esserci sfida tra noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Ah, dimenticavo! Prima di partire, Alice ti ha per caso parlato di un accordo risalente a cinquant'anni fa e di una certa scatola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "Oooh, questa la so! Allora sei qui per quella scatola. Aspetta, lasciami cercare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Mmmh... No, non è questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "Mmmh... Mmh... Neanche questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "No, no... Non è nemmeno questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "Ah! Ora ricordo! L'ho sepolta insieme al mio nuovo tesoro, a <color=#00E1FFFF>Levanteolo</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "È un'altra bomba, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Aspettatemi, sarò di ritorno in un baleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "Klee, non correre via così! Non hai bisogno delle cose nel tuo zaino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "Penserò io a rimettere tutto a posto. Voi seguitela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "*sospira* Visto quant'è avventata, temo per la sorte della scatola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "Perché continui a seppellire le cose importanti all'aperto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "Ecco... L'avevo detto che non era una buona idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "Dev'esserci un errore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "Non ho nemmeno avuto il tempo di dare un'occhiata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "Non so leggere le stelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050204",
							"2"
						],
						"stepId": 1050204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "Ci siamooo! Forza, scaviamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020202,
					"content": "Questa dev'essere opera dei Melmosi di Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "Non può essere! Avevo messo un cartello proprio qui. Non mi sto sbagliando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020205,
					"content": "Aaah! Melmosi di Dendro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020206,
					"content": "Già, Melmosi di Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "*sospira* Parleremo dopo. Ora facciamoli fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020203,
					"content": "Devono essere stati i Melmosi di Dendro a fare questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				}
			]
		},
		{
			"id": 1050203,
			"completionStepIds": [
				1050206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
