			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "I-Incredibile! Potresti davvero riuscirci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490202,
					"content": "Per favore, ti supplico, porta queste offerte... Le offerte... Devi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490203,
					"content": "Devi portarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490204,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490205,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490206,
					"content": "Oh mamma... le sue parole sono sempre più confuse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490207,
					"content": "Portale nel luogo dove devono essere custodite... consacra i frammenti della mia anima per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490208,
					"content": "Ehm, signor spirito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490209,
					"content": "Per... Per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490210,
					"content": "Per cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490211,
					"content": "Per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490212,
					"content": "Uff, questo tizio non è per nulla chiaro! Ma sembra che dobbiamo portare queste offerte in un luogo... Questo è quello che ha capito Paimon, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490213,
					"content": "Queste offerte sono qui da così tanto tempo! Chissà se riesco a trovare qualcosa di commestibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490214,
					"content": "In ogni modo, non credo sia il caso di mangiarle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "Ehi! Paimon non mangia qualunque cosa, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490216,
					"content": "#Beh, in ogni caso, portiamo le offerte con noi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224903,
			"completionStepIds": [
				7224905
