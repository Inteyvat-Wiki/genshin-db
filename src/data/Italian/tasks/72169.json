	"talks": [
		{
			"id": 7216901,
			"completionStepIds": [
				7216901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
