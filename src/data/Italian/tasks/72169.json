					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "#Ah, viaggiat{F#rice}{M#ore}! Come va la caccia al granchio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Oh! Questo granchio sembra ottimo. Ci sai fare con queste cose, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Bene, visto che abbiamo tutti gli ingredienti, iniziamo subito a cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "#Lasciami cucinare per un po', viaggiat{F#rice}{M#ore}. Aspettami qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
			"completionStepIds": [
				7216904
