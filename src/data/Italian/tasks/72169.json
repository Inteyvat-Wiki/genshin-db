			"dialogs": [
				{
					"id": 721690301,
					"content": "Kourayaki... Chissà perché si chiama così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690302,
					"content": "Beh, immagino di doverlo preparare, prima di fare delle domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690303,
					"content": "Ahah, ecco a voi un kourayaki di uova di granchio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690304,
					"content": "Ne prendo uno! Mmmh, ma è buonissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690305,
					"content": "Dammene uno dei più piccoli. Non credo che riuscirò a finirne uno troppo grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690306,
					"content": "#E questa porzione è per te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690307,
					"content": "Ecco qui, perché non prendi anche una copia della ricetta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690308,
					"content": "Non dovrebbe essere troppo difficile da preparare, quindi se ti piace puoi cucinarlo anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690311,
					"content": "Probabilmente, ora ci dirigeremo nei paraggi <color=#00E1FFFF>dell'Isola di Yashiori</color>. Se hai tempo, vieni a trovarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690309,
					"content": "Bene, ora mangio un boccone anch'io, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690310,
					"content": "Ehi, Julie! Lasciamene uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
