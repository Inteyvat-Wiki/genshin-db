			"dialogs": [
				{
					"id": 751560101,
					"content": "*singhiozza* Libera, finalmente! Libera da questo carro per Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560102,
					"content": "Uff. Quel carro era soffocante e caldo... e anche puzzolente! Sono rimasta lì dentro per mezza giornata e già sentivo che mi avesse tolto qualche anno di vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560103,
					"content": "Ancora tu? Davvero? Che è successo stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "#Ah, sei tu, {F#mia salvatrice}{M#mio salvatore}! Non mi aspettavo di incontrarti... Cioè, non mi aspettavo che mi avresti soccorso di nuovo durante i nostri rispettivi viaggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560105,
					"content": "Ah, non avevo già detto prima che mi chiamo Conulaf, e che sono un'apprendista sacerdotessa dei Maestri del Vento della Notte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560106,
					"content": "Il mio addestramento è ancora in corso al momento e, per questo, gli anziani della tribù mi hanno detto che ci sono tesori ancestrali da trovare in tutta Natlan. \"Vai a caccia di tesori, Conulaf!\", hanno detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560107,
					"content": "E così mi hanno cacciata via dalla tribù con la scusa dell'addestramento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560108,
					"content": "E, beh, le mie orecchie hanno colto degli indizi su un tesoro da trovare da queste parti... Qualcosa riguardo a un tesoro che avrei trovato seguendo le orme di qualche bestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560109,
					"content": "Ho pensato: \"Ma non farà riferimento a una bestia da soma? Oppure a un alpaca?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560110,
					"content": "Comunque, ho seguito la bestia da soma fino all'accampamento allestito da queste persone e, pensando che fossi una specie di ladra, mi hanno rinchiusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560111,
					"content": "Lasciamo perdere il tesoro sepolto, a momenti venivo sepolta io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560112,
					"content": "Avevi una serie di indizi incompleti in partenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "Hai ragione! Non sarò così avventata in futuro... Mmm. Forse questa lezione è il tesoro più grande che ho ottenuto da questo incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560114,
					"content": "*sospira* Dovrò trovare un posto dove farmi un bel bagno per togliermi questo odore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560115,
					"content": "Grazie mille! Permettimi di darti un modesto pegno, preso dalle mie limitate risorse di viaggio, per esprimere la mia gratitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
