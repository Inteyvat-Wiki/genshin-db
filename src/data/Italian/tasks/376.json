			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, patron Diluc. Ha visto due ladri nei paraggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Cos'è successo? Perché hai chiamato tutte queste guardie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Non ha sentito, patron Diluc? Due ladri hanno tentato di rubare la Lira sacra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Eh? Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Vero? La Lira sacra, il tesoro suonato dal Dio di Anemo in persona. Una reliquia preziosa, parte della nostra eredità culturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Perché qualcuno dovrebbe voler rubare qualcosa che non può vendere? Sarebbe più conveniente rubare dalle mie cantine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Scusate, sto divagando. Credo che si siano diretti da quella parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Tutto chiaro. Grazie, patron Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
		{
			"id": 37607,
			"completionStepIds": [
				37608
			],
