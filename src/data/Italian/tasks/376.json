				"points": []
			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "Patron Diluc, questi sono i conti della settimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "Mmh... Il disastro ha avuto un impatto enorme sull'attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Beh, speriamo che finisca presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Ciao, vorremmo un posto al vostro tavolo più... ahem... discreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "Uhm... Al primo piano ci sono meno clienti. Lì non dovrebbe disturbarvi nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Ma tu non sei un bardo? Perché non vi accomodate al centro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "Ahahah, rimandiamo l'esibizione alla prossima volta. Il secondo piano andrà benissimo, a dopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Ehi, tienili d'occhio. Quel bardo ha un che di strano. Vado a chiedere informazioni in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "Chiedere a chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "Ai \"protettori\" di Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
