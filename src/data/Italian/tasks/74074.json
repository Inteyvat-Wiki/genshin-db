			"dialogs": [
				{
					"id": 740740101,
					"content": "...Non dovresti preoccuparti di più della persona che giace a terra nel tuo campo visivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Eh? Ah! Cos'è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Le mie scuse, Mademoiselle. Ho dato priorità alla ricerca della tavoletta di pietra. Consentimi di eseguire subito una scansione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "...Le mie scuse, Mademoiselle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Sebbene sia ancora vivo, il soffio vitale è fuoriuscito dal suo corpo attraverso gli orifizi. L'ho già visto accadere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "Puah! Paimon non vuole guardare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Dobbiamo cercare aiuto! Non possiamo lasciarlo in questo stato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Portate l'uomo privo di sensi al Porto Lumidouce.\\nLa gente del posto si adopera subito per offrirgli delle cure mediche.\\nSapendo che è in buone mani, tornate tutti da dove siete venuti.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Bene! Ora diamo un'occhiata a questa tavoletta di pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "\"Osservate, questo posto è l'Ottante dei Desideri, la Sala dei Desideri, la Stanza dei Desideri...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "\"In frequente contraddizione\"... \"Nato in un istante, ti accompagno nell'eterno riposo, in unione perpetua\"... \"I frutti corrotti del peccato\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Un altro indovinello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Perché fare qualcosa di così spaventoso qui...? Che abbia a che fare con la soluzione dell'indovinello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Beh, gli abitanti di Fontaine sono \"peccatori\", la vita è stata contaminata dal peccato originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Per questa ragione, la soluzione è \"vita\". L'avevo già indovinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Sei sicuro che quella sia la soluzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Conosco fin troppo bene la retorica e la semiotica dell'Ordo Narzissenkreuz. Salvo sorprese, la soluzione è quella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Ok, è ora di recuperare il tempo perduto. Dobbiamo sbrigarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
