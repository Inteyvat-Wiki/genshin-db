					"nextDialogs": [
						740742102
					]
				},
				{
					"id": 740742102,
					"content": "Qualcuno ha preso anche... quello che c'era qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742103,
					"content": "Pare proprio di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742104,
					"content": "Ma chi è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "È Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742106,
					"content": "In passato abbiamo avuto uno scontro a Elynas. Cioè, in realtà di recente, non \"in passato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742107,
					"content": "Quando ho visto quel poveretto all'entrata, sapevo che era opera sua. Sembra che sia ancora attivo, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742108,
					"content": "E allora cosa vuole farne della roba che si è preso da qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742109,
					"content": "Semplice, anche lui vorrebbe riforgiare la Spada sacra di Narzissenkreuz. Il sogno dell'Ordo rimane irrealizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742110,
					"content": "Comunque, ora dovremmo dirigerci verso l'area finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
