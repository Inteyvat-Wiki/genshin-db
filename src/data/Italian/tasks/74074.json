					"content": "La vita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740740502
					]
				},
				{
					"id": 740740502,
					"content": "A Paimon sembra strano. La vita può davvero generare il peccato originale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740503,
					"content": "Eppure, Paimon crede di averlo già sentito da qualche parte. Optiamo per questa risposta, per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
