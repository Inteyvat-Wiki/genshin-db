			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "Eh? Ma quello era... un Qucusauro? Quindi i Qucusauri portano davvero le statue rubate qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Aspetta un attimo. Ha afferrato la statua e poi... si è lanciato nel cratere?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Quella è la bocca del vulcano, quindi? Che spettacolo, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Uhm... Quando abbiamo chiesto indicazioni, non ci avevano forse detto che la bocca del vulcano è piena di Flogisto aeriforme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Oh, un momento, ma certo! Possiamo <color=#00E1FFFF>trovare un modo per attraversare il Flogisto aeriforme</color>, proprio come ha fatto quel Qucusauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Ma, ehm... *sussulta* S-Siamo piuttosto in alto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Non preoccuparti, Paimon, ti porto io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Eh? Anche tu sei già pronto a saltare? Ma... Ugh, e va bene. S-Stando così le cose, allora neanche Paimon ha più paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "E non c'è solo il problema dell'altezza... Non dimentichiamoci del Flogisto aeriforme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "C-Comunque, prepariamoci per bene prima di andare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "L'importante è che tu mi prenda appena prima di arrivare a terra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Non se ne parla! A parte che Paimon non ne avrebbe la forza, ma servirebbe un tempismo assurdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "E tu smettila con quei \"roar\" qua e \"roar\" là, non assecondare le sue idee folli! *sospira*... Sapete che vi dice Paimon? Avete fatto sparire tutta la tensione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
