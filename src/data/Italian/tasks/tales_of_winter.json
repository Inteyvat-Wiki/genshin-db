			"dialogs": [
				{
					"id": 206000401,
					"content": "Bene, parlami della Tsaritsa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "Cosa, vuoi farmi delle domande sulla Tsaritsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "È per questo che vuoi unirti ai Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "Non voglio sminuirti, ma perché non pesi le tue parole per un attimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Comunque non posso parlarti della Tsaritsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Perché non vai a prendere qualche oggetto da una Guardia delle rovine? Ho bisogno di qualcosa con cui giocherellare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "Io... Ok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Bene, allora va'. Ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "A cosa ti serve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Eh? Non posso semplicemente collezionare dei ninnoli? O hai paura di una piccola Guardia delle rovine, come un qualunque abitante di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Noi Fatui avremmo a malapena bisogno di muovere un dito per occuparcene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Comunque... *sospira* Questa brezza è proprio come una ninnananna, mi sto addormentando, quindi affido a te questa questione insignificante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
