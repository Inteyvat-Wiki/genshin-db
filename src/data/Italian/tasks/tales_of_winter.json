				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "L'hai trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Fammi vedere. Beh... è passabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Bene, ti parlerò un po' dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Noi Fatui veniamo dal Palazzo Zapolyarny. Eseguiamo gli ordini di Sua Maestà la Tsaritsa ed ereditiamo la sua volontà, mettendola in atto in tutto il paese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Agli undici più forti tra noi è stato conferito il titolo di Messaggeri da Sua Maestà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Rispetto a un soldato insignificante come me, gli Undici Messaggeri sono delle figure davvero eccezionali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "#Se ti unirai ai Fatui e dimostrerai la tua forza, allora forse potrai essere scelt{F#a}{M#o} da uno di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "E da lì salire sempre più in alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "Quanto a me... Beh, io non sono stato proprio \"scelto\", ma sono venuto qui per sbrigare qualche faccenda per Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Ma se potessi scegliere... Preferirei lavorare per Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
