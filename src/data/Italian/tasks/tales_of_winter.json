					"content": "Ricordati, devi sgraffignare qualcosa ai Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000702,
					"content": "E se solo provi a prenderti gioco di me con qualche trucco, l'accordo salta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
