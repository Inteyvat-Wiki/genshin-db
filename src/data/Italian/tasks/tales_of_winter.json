			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "Quindi, parlami delle Illusioni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Aha! Ci sei o ci fai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "Non sei nemmeno un membro ufficiale dei Fatui. Pensi davvero di potermi chiedere delle Illusioni come se nulla fosse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Pensavi che te l'avrei detto? Come quei due Cavalieri di Favonius che fanno la guardia all'ingresso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Comunque, le Illusioni sono la nostra fonte d'orgoglio e di gioia... Non costa niente dare qualche spiegazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "Ascoltami bene, allora. Hai visto i Cacciatori di tesori fuori Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "Sono un branco di furtivi taccagni da due soldi, ma a volte si trasformano in qualcosa di prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "Se vai laggiù e prendi qualcosina da loro, in cambio ti parlerò un po' delle Illusioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Va bene, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Mi piaci. Ora va'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Sei a corto di soldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Soldi? Ahahah, mi hai preso per un Cavaliere di Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "No, sono solo curioso di vedere cosa possano portare alla luce i Cacciatori di tesori a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "Comunque non penso che troveranno niente di decente. *ridacchia*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
