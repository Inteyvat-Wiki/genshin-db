			},
			"dialogs": [
				{
					"id": 206001001,
					"content": "Allora, hai portato il bottino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001002,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Ah, non male. Sei forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Bene, volevi che ti parlassi di Sua Maestà la Tsaritsa, giusto? Da dove comincio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "In poche parole, la Tsaritsa è la nostra dea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Questa non è una cosa astratta, ma la concreta verità. La Tsaritsa è l'Archon di Cryo, una dei Sette a detenere il dominio sul regno dei mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Ma per noi Fatui, Sua Maestà ha uno status superiore perfino a una divinità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Quanto al perché... Anche se te lo spiegassi, non penso che lo capiresti. O meglio, non saresti capace di capirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Ma se vuoi capire, unisciti a noi. Così comprenderai com'è Sua Maestà la Tsaritsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "...Ecco tutto quello che ti dirò per ora. Quella sorella mi sta di nuovo lanciando delle occhiatacce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
	]
