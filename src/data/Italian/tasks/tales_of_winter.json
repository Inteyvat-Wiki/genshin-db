					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "Cos'è esattamente? È un... corno. Vai subito a prenderlo.",
					"roleType": "TALK_ROLE_NPC",
