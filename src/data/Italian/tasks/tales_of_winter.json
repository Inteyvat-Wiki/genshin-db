				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "#Viaggiat{F#rice}{M#ore}, vieni qui. Ti stavo osservando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000102,
					"content": "Che cosa vuoi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "Non ti fidi di me? Ho una proposta interessante da farti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000104,
					"content": "Ti piacerebbe unirti ai Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000105,
					"content": "Ti piacerebbe, eh? Non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "Ci penserò su.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "Ehi, che vuol dire che ci penserai su? Non dovremmo rifiutare immediatamente?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "Hai buon occhio. Se vuoi fare grandi cose, non c'è niente di meglio dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000111,
					"content": "Ora... Sembri avere delle domande, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000109,
					"content": "Beh, qui siamo a Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "E quindi? Noi Fatui reclutiamo in tutto il continente. È un gioco alla pari, e i Cavalieri non hanno voce in capitolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060002",
							"2"
						],
						"stepId": 2060002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "Dunque, parlami dei Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "Non ci giri intorno, eh? Mm... è una lunga storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000203,
					"content": "Ma visto che non fai ancora parte dei Fatui ufficialmente, non posso dirtelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000204,
					"content": "Ho sentito che ci sono molti Hilichurl nei dintorni di Mondstadt, e che alcuni hanno perfino formato dei gruppi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000205,
					"content": "Facciamo un patto: tu vai là fuori e mi porti il trofeo di un Mitachurl, e io ti racconto una storia. Cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000206,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "#Sei schiett{F#a}{M#o}, mi piace! Non si trova gente come te a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000208,
					"content": "Sbrigati, allora. Ti aspetto qui. Ho già detto che devi sbrigarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000209,
					"content": "Tutto qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "Cosa, troppo facile per te? Tutto qui. O forse pensi che puoi occuparti di qualcosa di più difficile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000211,
					"content": "Ora vai, e torna presto. Ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000212,
					"content": "*sospira* Se mi avessi fatto aspettare ancora un po', ci avrebbe pensato questo vento a farmi addormentare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060003,
			"completionStepIds": [
				2060003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
