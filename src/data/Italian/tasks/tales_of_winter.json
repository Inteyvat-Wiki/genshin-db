					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000801,
					"content": "Allora? Ce l'hai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Fammi vedere. Ah, ovviamente non hai trovato niente di valore in questo posto sperduto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Va bene, va bene, ecco una storia sulle Illusioni. Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Le Illusioni sono tesori dal potere incredibile, concessi da Sua Maestà la Tsaritsa in persona. Un'Illusione fa sembrare un gioco da ragazzi perfino la fede o una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Comunque non tutti possono detenerne. Oltre agli Undici Messaggeri, pochissimi altri Fatui posseggono un'Illusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Tuttavia, per un comune mortale come me, un'Illusione è molto più pratica di una Visione, che può essere ottenuta solo attraverso la grazia degli dèi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Ah, vedo che neanche tu possiedi una Visione. Beh, se ti unisci ai Fatui, chissà, forse riuscirai davvero ad acquisirne una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "Ed ecco tutto ciò che ho da dire sulle Illusioni. I Cavalieri di Favonius sono po' suscettibili riguardo a queste cose, quindi è meglio se non li metti sulle mie tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
