			"dialogs": [
				{
					"id": 747110101,
					"content": "Ah-ha! Tutto procede senza intoppi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Penso che la nostra ricerca della cura stia entrando nella sua fase finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Oltre a trovare qualche altro paziente per completare la lista, avrei un'altra richiesta un po' particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Vorrei che individuaste dei meccanismi subacquei specifici nelle acque contaminate, e che recuperaste i dati registrati dai loro sensori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Vuoi analizzare i dati per individuare eventuali schemi rilevanti...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Dovremmo anche parlare con gli armatori e i subacquei per assicurarci che abbiano imparato la lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Infatti, e anche con pescatori e turisti... Tutti quelli che fanno uso di barche o s'immergono in acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Chiunque interagisca con le nostre acque deve essere consapevole: gettare rifiuti in mare e andare in giro a distruggere gli habitat marini è fuori discussione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Altrimenti, potrebbero arrivare dei pesci molto aggressivi a ribaltare le loro barche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Così da prevenire incidenti simili in futuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
