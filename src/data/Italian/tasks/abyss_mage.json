	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "L'Ordine dell'Abisso... I nemici dell'umanità. Perfino i sistemi di spionaggio più avanzati raramente riescono a raccogliere informazioni su di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "È stata una bella seccatura, ma alla fine sono riuscito a trovare degli indizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Davvero? Sei stato velocissimo! Patron Diluc, hai proprio le conoscenze giuste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Però è strano, come mai il grande Dio di Anemo Barbatos ha bisogno dell'aiuto di semplici esseri umani...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Mmh... Come te lo spiego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Quelli che oggi le persone conoscono come i Sette, in passato venivano chiamati i \"Sette Archon\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Ogni Archon ha come compito quello di presiedere alla propria parte di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Solo adempiendo a questo compito possiamo ottenere il potere. Anche se a me non fa assolutamente impazzire l'idea di \"governare\" Mondstadt, e credo che neanche i cittadini di questa nazione lo vogliano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "\"Andate e create una città della libertà senza padroni\". Non ci siamo scordati di quello che Barbatos desidera per Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Jean... Che devozione esagerata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Forse qualcuno si è preso un po' troppe libertà e non ha voglia di occuparsene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Ahh... In ogni caso... È da moltissimo tempo che non torno a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Al momento sono sicuramente l'Archon più debole dei Sette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "Sembra quasi che tu te ne stia vantando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Che dolce, così mi fai arrossire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Oh, che dio umile... Chissà se sarà un bene o un male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Non perdiamoci in chiacchiere e torniamo al nocciolo della questione: il nemico comune del genere umano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "Abbiamo rintracciato il <color=#00E1FFFF>Mago dell'Abisso</color> nei dintorni del <color=#00E1FFFF>Vigneto</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Non dobbiamo assolutamente farcelo scappare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "Prendiamolo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Forse è per questo che sei il dio della Città della Libertà....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "Eh? E questo cos'è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970402,
					"content": "Dopo che abbiamo sconfitto il Mago dell'Abisso, il suo corpo ha cominciato a emanare una strana energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970403,
					"content": "Sembra che quell'energia venisse usata per interrompere il legame tra me e Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, hai mai sentito parlare del <color=#00E1FFFF>Covo di Terrore alato</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970406,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Sono sicuro che Jean e patron Diluc ne sono a conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970410,
					"content": "Dopo essersi risvegliato, Dvalin fece di quelle antiche rovine il suo covo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970411,
					"content": "L'entrata delle rovine è sigillata da una barriera speciale, simile alle tempeste che avevano separato Mondstadt dal mondo esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970412,
					"content": "Ora però, vedendo l'energia fuoriuscire dal Mago dell'Abisso, sono riuscito ad ascoltare il flusso ritmico che compone la magia della barriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970413,
					"content": "Devo essere sincero: nemmeno gli schiamazzi degli Hilichurl hanno un suono così orrendo, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970414,
					"content": "...dovrebbe essere sufficiente per superare la barriera di vento e raggiungere il <color=#00E1FFFF>Covo di Terrore alato</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970415,
					"content": "Quindi, se ho capito bene, dovremo affrontare Dvalin, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970416,
					"content": "Per me non c'è nessun problema... ma Jean vuole evitare qualsiasi tipo di conflitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970417,
					"content": "Ti sbagli. In mancanza di alternative, è mio dovere cambiare i nostri piani di conseguenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970418,
					"content": "Se non abbiamo altra scelta che ucciderlo, non mi tirerò indietro. Anzi, sarò io a guidare la carica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970419,
					"content": "Per fortuna, al momento non è necessario arrivare fino a questo punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970420,
					"content": "Mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970421,
					"content": "Intendi dire che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970422,
					"content": "Voglio dire che la Lira sacra non è la nostra carta vincente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970423,
					"content": "#Sapete qual è il vero asso nella manica? {NICKNAME}, mi sembra ovvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970425,
					"content": "Dici così perché ho purificato la Lacrima di cristallo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970430,
					"content": "Le impurità nelle lacrime e la maledizione che perseguita Dvalin risalgono tutte allo stesso potere malefico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970431,
					"content": "Il che significa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970432,
					"content": "Bardo stonato che non sei altro, non ti rendi conto delle assurdità che stai dicendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970433,
					"content": "#Hai visto anche tu di cosa è capace Dvalin quando si arrabbia! {NICKNAME} non ha scampo, non riuscirà nemmeno a scalfirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970434,
					"content": "Che fine hanno fatto i complimenti per le mie capacità in battaglia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "...Ehi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970437,
					"content": "È un ottimo piano. Vale la pena fare un tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970438,
					"content": "#Combatterò al tuo fianco, Cavaliere Onorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970439,
					"content": "Oh! Quindi dobbiamo solamente affrontare dei mostri dell'Abisso e... un drago! Niente di che, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970440,
					"content": "Anche gli umani hanno i loro punti di forza. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970441,
					"content": "E così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970442,
					"content": "Le gesta epiche degli eroi coraggiosi li condussero infine al culmine della battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970435,
					"content": "In questa battaglia... dovremo dare tutti il massimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "Dici così perché riesco a combattere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "Beh, diciamo di sì... Non sei sicuramente da sottovalutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970429,
					"content": "Ma hai un talento ancora più prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970408,
					"content": "Mi sembra di averne sentito parlare a Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "Certo. Sono sicuro che tutti i cittadini di Mondstadt lo conoscono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}