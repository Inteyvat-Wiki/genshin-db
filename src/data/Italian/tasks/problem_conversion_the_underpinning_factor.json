			"dialogs": [
				{
					"id": 230220501,
					"content": "Sì, questi materiali dovrebbero andare bene. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220502,
					"content": "I materiali che ha scelto Qishan sono davvero molto leggeri... Saranno affidabili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220503,
					"content": "Fidati. Saranno meglio di quelli che avevi scelto tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220504,
					"content": "Beh, immagino che ora tocchi a te preparare i giubbotti di salvataggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220505,
					"content": "Oh, fidati di me... Questi basteranno.",
					"roleType": "TALK_ROLE_NPC",
