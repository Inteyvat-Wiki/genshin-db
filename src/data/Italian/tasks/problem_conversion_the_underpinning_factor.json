				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "Se aumentiamo la forza qui, dovremo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Se userai questo progetto, non ci sarà molta differenza con il precedente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Stai ancora lavorando al progetto della nave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#Ah, è {F#la}{M#il} viaggiat{F#rice}{M#ore}. Sì, Qishan e io abbiamo discusso di alcuni... aspetti importanti del progetto dall'ultima prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Abbiamo avuto un... notevole scambio di opinioni, e stiamo provando a ideare un nuovo progetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Tuttavia, abbiamo ancora delle divergenze sull'uso dei materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Ma questa volta ho seguito i consigli di Qishan! Ho comprato molti materiali solidi. Mi sono costati una fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "#Come puoi vedere, viaggiat{F#rice}{M#ore}, non riesco a spostarli da solo. Neanche Qishan è abbastanza forte, quindi potresti...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Lo faremo insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Sapevo di poter contare su di te! Diamoci da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Qishan ha scelto lei stessa i materiali. Credo che stavolta le cose andranno bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Ho delle ricompense ancora maggiori per te, questa volta. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Ok, facciamolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
