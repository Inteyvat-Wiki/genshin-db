			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika dovrebbe presto tornare dalle Rovine di Dahri. Con l'Ararakalari di Arabalika, i Pezzi di ferro e i Miconoidi non faranno più paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Se Aranakula fosse forte la metà di Arabalika, Aranakula proteggerebbe i vivai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Aranakula non ha nemmeno la metà della metà della forza di Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*singhiozza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "#Aranakula può avere più coraggio, come {F#la}{M#il} Nara dorat{F#a}{M#o}. Ad Aranakula serve solo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
