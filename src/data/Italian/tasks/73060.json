			"dialogs": [
				{
					"id": 730600601,
					"content": "C'erano molti cattivi al Monumento di Yasna, ma Aranakula è di ritorno. Bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "#{F#La}{M#Il} Nara dorat{F#a}{M#o} è fuggit{F#a}{M#o} dai brutti mostri con Aranakula e ha sistemato la Memoria di pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Una volta guarita la Macchina di Varuna, i fiori del vivaio potranno tornare. Aranara non dimenticano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Rimane solo Arakunti nel Frutteto dei Sogni. Quando Arakunti torna, possiamo liberarci degli insettacci che tormentano le radici della Macchina di Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
