				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika sta bene, ma Arabalika si preoccupa ancora per Aranakula al Monumento di Yasna e Arakunti nel Frutteto dei Sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Ci sono troppi funghi cattivi! Se Aranakula venisse catturato di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "#Preoccuparsi troppo non fa bene. {F#La}{M#Il} Nara dorat{F#a}{M#o} è forte e ha abbattuto quel Pezzo di ferro grosso come vento impetuoso contro legno marcio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Dobbiamo solo guarire la Macchina di Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
