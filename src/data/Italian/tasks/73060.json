			"dialogs": [
				{
					"id": 730600701,
					"content": "Aranakula è al Monumento di Yasna. Ci sono così tanti funghi cattivi lì, Arapandu si preoccupa... Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600702
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600702,
					"content": "Arabalika non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600703,
					"content": "Aranakula sa come nascondersi. I funghi cattivi non lo trovano di certo. Perché Arapandu si preoccupa?",
