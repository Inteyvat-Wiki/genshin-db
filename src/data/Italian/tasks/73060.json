					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "#Non sembri aver paura di nulla, Nara dorat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "#{F#La}{M#Il} Nara dorat{F#a}{M#o} è {F#una}{M#un} Nara coraggios{F#a}{M#o}. Come Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "#Anche se Arapandu si preoccupa per Arabalika nelle Rovine di Dahri e per Arakunti nel Frutteto dei Sogni, con l'aiuto di Nara dorat{F#a}{M#o} andrà tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "#Ora che la Macchina di Varuna è stata guarita, nessun cattivo disturberà i vivai. Aranakula vorrebbe donar{F#le}{M#gli} i fiori del giardino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
