				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "Il Frutteto dei Sogni... Una melodia pacifica, il gorgoglio dell'acqua, lo sbattere d'ali degli uccelli e il calpestio sui rami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Parlando con Nara e Paimon... Paimon è divertente. Purtroppo però Paimon non vuole diventare un seme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Ecco perché Paimon non è un Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Il Frutteto dei Sogni ora sta bene. Arabalika è nelle Rovine di Dahri, ma Arapandu non si preoccupa. Però ci sono molti Miconoidi al Monumento di Yasna. Arapandu si preoccupa per Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
