			},
			"dialogs": [
				{
					"id": 223020401,
					"content": "Vincerò di sicuro. Di sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020402
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020402,
					"content": "Vincerò alla grande e il mio libro verrà venduto in tutto il mondo... Così lo leggerà anche lei... Lo leggerà di sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020403,
					"content": "Che ci fai ancora qui? Porta subito il manoscritto alla <color=#00E1FFFF>Gilda dei commercianti di Feiyun</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2230205,
