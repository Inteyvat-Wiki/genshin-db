			"dialogs": [
				{
					"id": 223020601,
					"content": "Non si sbircia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020602
					]
				},
				{
					"id": 223020602,
					"content": "Va bene, guastafeste... Hai ragione però, in teoria non dovremmo sfogliarlo senza il suo permesso.",
					"roleType": "TALK_ROLE_NPC",
