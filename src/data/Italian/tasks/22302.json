			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Stavolta vincerò io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020102,
					"content": "Vincerai cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Non so se lo sai, ma a Inazuma si tiene regolarmente un concorso letterario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020104,
					"content": "Il bello è che la competizione è sponsorizzata dalla Casa editrice Yae, un vero gigante per quanto riguarda le pubblicazioni di Inazuma. Mi pare si chiami... \"Questo romanzo è fantastico!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020105,
					"content": "Mi sono preparato duramente studiando a fondo la letteratura tipica di Inazuma. Per capire meglio cosa aspettarmi, sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020106,
					"content": "Inutile precisare che possiedo una biblioteca molto variegata di volumi... e li ho letti tutti, nel tempo. Tornando al concorso, ho scritto un romanzo che integra il meglio delle culture di Liyue e Inazuma. Ho già la vittoria in tasca, me lo sento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020107,
					"content": "Ho parlato con la Gilda dei commercianti di Feiyun. Manderanno qualcuno a ritirare il mio libro per portarlo a Inazuma di persona. Quel qualcuno, però, non si è fatto ancora vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020108,
					"content": "Consegneresti il manoscritto alla <color=#00E1FFFF>Gilda dei commercianti di Feiyun</color> al posto mio? Hai tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020109,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Musica per le mie orecchie! Corri, allora, la vittoria mi attende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020111,
					"content": "Di cosa tratta il libro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "È un concorso, non intendo divulgare i dettagli dell'opera che sicuramente trionferà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 223020113,
					"content": "Se vinco, tutto il resto migliorerà di conseguenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
