			},
			"dialogs": [
				{
					"id": 223020501,
					"content": "Solo una guardatina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "Certo, velocissima! Aprilo, aprilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020503,
					"content": "Ehm... Anche a te sembra che questo ragazzo sia proprio Chang il Nono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Come dicono i brontoloni, \"l'importante è essere giovani dentro\"... Hai presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Meglio consegnare il libro alla <color=#00E1FFFF>Gilda dei commercianti di Feiyun</color>, ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2230206,
