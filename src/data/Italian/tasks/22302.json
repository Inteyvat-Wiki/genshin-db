					"Xu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020301,
					"content": "Dove sarà andato il padrone, stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Devo consegnare il libro di Chang il Nono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Come? Sul serio quello lì scrive ancora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Oh, ora ricordo. Ha detto di voler partecipare a un concorso letterario d'Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Stavolta cosa ha scritto? L'ultima volta era un libro sulle Sette Stelle che voleva farci pubblicare a ogni costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Se l'avessimo fatto, avremmo ricevuto una visitina dai Milleliti in tempo zero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "In questo caso, se non altro, il concorso è a Inazuma. Nessuno dovrebbe riuscire a risalire al fatto che sono coinvolto anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Dammi qua. Chiederò a qualche marinaio diretto a Inazuma di portarlo con sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Tanto non credo che Chang abbia possibilità di vittoria. Dicono che un romanzo chiamato \"Leggenda di una spada\" stia spopolando, laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Anche quell'autore è di Liyue, sai? Non so chi sia, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Grazie per aver portato il libro. Chang il Nono ci aveva chiesto di passare a prenderlo, anzi ha perfino pagato in anticipo... Ecco qui, per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
