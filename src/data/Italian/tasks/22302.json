				"points": []
			},
			"dialogs": [
				{
					"id": 223020201,
					"content": "Quella laggiù sembra la <color=#00E1FFFF>Gilda dei commercianti di Feiyun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Consegna il libro al <color=#00E1FFFF>tizio all'entrata</color>. Ecco fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Anche se... Paimon è mooolto curiosa di sapere di che si tratta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "Che ne dici? Sbirciamo un pochino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
