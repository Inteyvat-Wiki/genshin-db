						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150240601,
					"content": "Iniziate pure quando volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
			"id": 1502407,
			"completionStepIds": [
				1502407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502407",
