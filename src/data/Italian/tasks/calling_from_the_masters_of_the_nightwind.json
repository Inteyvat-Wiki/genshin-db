			},
			"dialogs": [
				{
					"id": 150240901,
					"content": "Ci sono un sacco di rotoli di tessuto, qui. A Paimon sembra di averne visti alcuni visitando altre tribù. Pare che documentino eventi storici importanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240902,
					"content": "Questo è diverso dagli altri, anche solo perché è più grande. Chissà che storia racchiude...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240903,
					"content": "Anche i colori sono molto particolari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240904
					]
				},
				{
					"id": 150240904,
					"content": "Già, hai ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240905,
					"content": "#Laggiù ha lampeggiato qualcosa! {NICKNAME}, l'hai notato anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240906,
					"content": "Forse è così che si esce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "...Vedendo cose che prima erano invisibili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
					"id": 150240908,
					"content": "Oooh, ma certo! Paimon concorda con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
