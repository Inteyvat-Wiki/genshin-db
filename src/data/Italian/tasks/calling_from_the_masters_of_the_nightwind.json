						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Woah, che caspiterina è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "È uno dei doveri quotidiani di noi sacerdoti. Tentiamo di contattare gli spiriti dei nostri antenati in cerca di illuminazione e rivelazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "Il capo si trova laggiù. Attendete qui mentre vi annuncio, prego. Ci vorrà solo un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Beh, non si può certo dire che i Maestri del Vento della Notte non siano avvolti dal mistero, come ci si aspettava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Ecco, ho avvertito il capo del vostro arrivo. Ora potete andare a parlare con lui. Da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "#Dunque, siete voi {F#le nominate}{M#i nominati}? Io sono Biram, il capotribù. Vi do il benvenuto e vi ringrazio per la pazienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "Quant'è alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Anche troppo. Sì, ne sono consapevole. Ma vi assicuro che non c'è nulla di cui allarmarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "Oh... No, certamente! Scusa, Paimon ha reagito senza pensarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "#Cosa significa che siamo {F#state \"nominate\"}{M#stati \"nominati\"}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "#Ah, già, Caholom me ne ha parlato. In quanto persone esterne alla nostra tribù, immagino sia la prima volta che sentite parlare di queste \"nomine\". Di certo sarete {F#confuse}{M#confusi}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "#Nel corso della nostra storia, solo i membri dei Maestri del Vento della Notte hanno ricevuto la nomina per svolgere questi specifici incarichi. Non era mai successo che venisse affidata a {F#delle forestiere}{M#dei forestieri}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "Sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Vi spiego: nella nostra tribù c'è un'antica tradizione che consiste nel raccogliere le testimonianze storiche sotto forma di rotoli di tessuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "E questo non vale solo per la nostra storia, raccogliamo anche tutte le leggende e le gesta eroiche che riguardano le altre tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "È una tradizione che dura da svariati secoli, per noi è un dovere solenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Tuttavia, quando si verificano eventi storici straordinari che riguardano l'intera Natlan, li registriamo su un tipo di rotolo destinato appositamente a occasioni del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "E questi rotoli possono essere intessuti soltanto da qualcuno scelto espressamente dall'Anziano Iktomisauro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Quando l'Anziano Iktomisauro percepisce un forte cambiamento nelle linee geomantiche, invia una dichiarazione formale per nominare un tessitore del rotolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "Wow, significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "L'Anziano Tlapo aveva percepito i cambiamenti nelle linee geomantiche già diverso tempo fa, ma non aveva ancora designato dei tessitori... fino al vostro arrivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "Tutto chiaro, ma... giusto per essere chiari, noi non sappiamo nulla di come si tessono quei rotoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "La cosa non mi stupisce affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "Nei duecento anni in cui ha ricoperto il ruolo, l'Anziano Tlapo non ha mai nominato nessuno che avesse esperienza nella tessitura dei rotoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "Significa che duecento anni di importantissimi eventi storici non sono mai stati documentati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "No, i rotoli sono sempre stati realizzati nei tempi previsti. Tuttavia, chi se n'è occupato ha sempre affermato di non aver fatto nulla, e che fossero un \"dono degli spiriti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Perdinci... Questa tribù è sempre più un mistero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Sì, beh... Quella è la parte che mi dà pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "La nozione secondo cui dobbiamo affidarci a entità esoteriche come i \"doni degli spiriti\" per registrare eventi storici così rilevanti... è a dir poco sconcertante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Uh... Strano sentire una cosa del genere dal capo della tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Lo immagino. Probabilmente considerate i Maestri del Vento della Notte come gente velata di mistero, che si fa vanto delle proprie pratiche arcane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "Io tuttavia sono un'eccezione. Per quanto io sia il capo, quando si parla di tradizioni, sono un convinto fautore del cambiamento e della riforma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Ho dedicato le mie energie a decifrare molte storie della mia tribù. Nel farlo, spero di aver stabilito delle regole chiare che possano aiutarci a mantenere le nostre tradizioni nei giorni a venire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Cavoli, sembra fantastico! Quindi hai capito il mistero dei \"doni degli spiriti\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "Purtroppo no... Si tratta di qualcosa di cui da tempo cerco di venire a capo, ma non ho ancora scoperto a cosa si riferisca esattamente questo \"dono\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Gli eventi che sono stati registrati su questi rotoli speciali sono pochi, distanziati l'un l'altro da diverse decadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "Quando verrà nominato il prossimo tessitore, avrò già concluso da tempo il mio compito di capotribù. Non sarò più nella posizione di poter indagare in libertà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "Quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Per quanto non sia venuto a capo della questione, ho comunque scoperto qualcosa. Ma per comprovare le mie teorie, l'unico modo che ho è chiedere la cooperazione di coloro che vengono nominati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "Ed è il motivo per cui vuoi farci sostenere questa prova...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Precisamente. Nulla di cui preoccuparsi... È solo un modo come un altro per verificare le mie ipotesi. Non dovreste metterci molto e non vi esporrà ad alcun pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "Va bene. In cosa consiste, per l'esattezza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "Vi spiegherò tutto nel dettaglio una volta arrivati al luogo della prova. Vi chiedo solo un istante di attesa, devo togliermi il Mantello paraspiriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Questo indumento è una delle nostre più importanti reliquie culturali, viene tramandato tra i capi di ogni generazione, e si indossa solo per officiare specifiche cerimonie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram si toglie con cura il mantello e lo affida al sacerdote.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Prego, seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "Vedete questo portale? Toccandolo, accederete a uno spazio nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "La prova di oggi è, molto semplicemente, trovarne la via d'uscita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "Tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "Vi assicuro che non è semplice come sembra. Se non riuscirete a trovarla, interverrò io per riportarvi indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Ma, così facendo, non scopriremo nulla di nuovo che ci aiuti a risolvere il mistero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Faremo un tentativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Bene. Allora toccate il portale per dare inizio alla prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
			"id": 1502406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
