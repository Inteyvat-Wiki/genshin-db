			"dialogs": [
				{
					"id": 150240101,
					"content": "*sussulta* C'è qualcosa nascosto dietro la statua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240102,
					"content": "Oh, è un piccolo di Iktomisauro. Che bellino... Ma perché ci fissa così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240103,
					"content": "#{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240104,
					"content": "(Dove sono...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240106,
					"content": "(Tu sei...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Ah... Quanto tempo è passato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "Paimon ha guardato il piccolo Iktomisauro per una frazione di secondo, e si è ritrovata in uno strano posto dove c'era un Iktomisauro gigantesco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240110,
					"content": "Sì, idem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "Che cosa sarà stato? Tu hai qualche idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240112,
					"content": "#...{NICKNAME}! Ehi, tutto a posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240113,
					"content": "È laggiù...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "Guarda! È il piccolo Iktomisauro... Vuole che lo seguiamo, pare. Lo spirito d'avventura di Paimon le dice che dobbiamo andare in fondo alla cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240116,
					"content": "Concordo! Muoviamoci!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "Qualcuno ci sta chiamando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
		{
