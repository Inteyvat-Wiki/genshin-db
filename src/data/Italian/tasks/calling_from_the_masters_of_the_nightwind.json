			"dialogs": [
				{
					"id": 150240301,
					"content": "Ehi, ciao... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240303,
					"content": "Bene, probabilmente non riesce a capirci... Sembra che gli si sia incantato il cervello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240304,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240305,
					"content": "Ops, scusa! Non volevo offenderti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "Voi! Come osate mancare di rispetto al nostro Anziano?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "#Oh, vuole dire che... Oh, capisco. Scusate, errore mio. Sembra che siate {F#giunte}{M#giunti} qui dietro invito. In tal caso, è mio dovere darvi il benvenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Iniziamo dalle presentazioni. Io sono Caholom, uno dei sacerdoti della tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "E lui è il nostro Anziano Iktomisauro, il Grande Tlapopoctiztetl. Un autentico totem vivente tra i Maestri del Vento della Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "Woah, sembra uno scioglilingua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "In effetti, lo chiamiamo \"Anziano Tlapo\" per fare prima. Potete fare lo stesso anche voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "#Siamo {F#state invitate}{M#stati invitati} in un modo decisamente... insolito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Ah, immagino vi riferiate alla sua speciale capacità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "L'Anziano Tlapo ha vissuto per svariati secoli, ed è custode di segreti a cui nemmeno noi sacerdoti siamo in grado di trovare una spiegazione, quindi la vostra reazione è condivisibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "Ma se c'è una cosa di cui posso assicurarvi, è che l'Anziano Tlapo ha nominato voi due per un incarico di capitale importanza. Pertanto, chiedo la vostra disponibilità per sostenere una prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "Un incarico di che tipo? E di che prova si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Se siete d'accordo, vi conduco dal nostro capo. Sarà in grado di rispondervi molto meglio di quanto potrei fare io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Ah... Va bene, d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Eccellente. Allora prego, seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Usate pure questo portale per raggiungere l'Altare d'ossidiana, dove si trova il nostro capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "Non preoccupatevi, non è che una delle tante abilità mistiche della nostra tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
