					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1677.043,
							13.091,
							9690.75
						],
						"pointId": 10006
					},
					{
						"sceneId": 3,
						"position": [
							-1680.302,
							13.722,
							9690.748
						],
						"pointId": 9383
					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "Fiuu, finalmente siamo fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "Proprio come pensavo. Questa missione è davvero alla vostra portata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "Questo ha dimostrato la tua teoria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "Sì. Avete visto un gran numero di rotoli diversi in quel luogo, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "Decisamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "Questo specifico tipo di rotolo ci è stato lasciato dai nostri antenati. Dopo degli attenti esami, ho scoperto che a distinguerlo dagli altri è l'uso di un certo colore non presente nei rotoli più comuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "È un colore assai misterioso, e la maggior parte delle persone non è in grado neppure di rilevarlo. Io stesso, per confermarne l'esistenza, ho dovuto adottare delle tecniche speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "Tuttavia, ci sono persone in grado di percepirlo naturalmente. È per questo che ho voluto mettervi alla prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "Vuoi dire che...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "Quello spazio era una sala espositiva per conservare questo genere di rotoli di tessuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "Secoli fa, una grande sciamana chiamata Huitzilin mise in atto una misura di sicurezza per intrappolare in quella sala chiunque vi fosse entrato senza permesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "Quella misura è in effetto ancora oggi e, anche se non sono riuscito a comprenderne il funzionamento, almeno ho scoperto come attivarla e disattivarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "Chiunque rimanga intrappolato all'interno non riuscirà a trovare una via di fuga senza un aiuto esterno... A meno che non possieda la capacità di percepire quel colore, come la grande sciamana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "Credo di aver capito cosa intendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "#È evidente che sei {F#dotata}{M#dotato} di quella capacità... Il che mi porta a credere che l'Anziano Iktomisauro riesca ad avvertirla all'interno delle persone, e che decida di nominarle in base a questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "#Un altro potere segreto? Certo che sei proprio {F#piena}{M#pieno} di sorprese, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "#Però, possedere questa capacità non cambia il fatto che {F#nessuna}{M#nessuno} di noi due ha idea di come tessere un rotolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "Di questo non dovete preoccuparvi. Il metodo per tessere i rotoli di questo genere è grosso modo lo stesso di quello usato per i rotoli comuni. La differenza principale sta nella tintura che gli conferisce quel colore così unico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "Se i miei sospetti sono fondati, la tintura è la chiave del processo di tessitura... E la vostra capacità speciale è la chiave per ottenerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "Anche il processo di tintura è un po' diverso dal normale, ma non mi aspetto grandi problemi da quel punto di vista. Purché riusciate a procurarvi la tintura, potrò assistervi nel suo utilizzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "...Bene, faremo come dici tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "Grandioso. Allora vi prego di usare la vostra capacità per trovare gli ingredienti necessari, io nel frattempo farò preparare del tessuto per eseguire delle prove di tintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "Creeremo dei campioni per verificare la mia ipotesi. Se tutto va come deve, potremo dare inizio ai lavori effettivi sul rotolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "#Se ci aiuterete, quando avrete finito sarete ampiamente {F#ricompensate}{M#ricompensati}. Allora, che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "Penso che dalla capacità di aiutare derivi una grande responsabilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "Affare fatto! A maggior ragione se c'è una ricompensa di mezzo! A proposito... In che consiste? Cibo, per caso? Paimon spera tanto che si tratti di un buon pasto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "Data la posta in gioco, penso che una somma sostanziale di Mora sia più appropriata... Di certo preferibile a un semplice pasto gratuito, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "Vanno benissimo anche i Mora! Comunque, come li cerchiamo questi ingredienti? Non dovremo mica girare per tutta Natlan sperando di trovarli per caso, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "Fortunatamente no. Ho già localizzato un'area dove credo sia possibile trovarli, e ho chiesto a qualcuno di guidarvi fin lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "La vostra guida vi attende qui fuori. Potete partire quando volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "In effetti ho visto un colore particolare, lì dentro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
