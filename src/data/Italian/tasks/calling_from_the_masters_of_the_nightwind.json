			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1616.678,
							172.831,
							9686.546
						],
						"pointId": 9998
					}
				]
			},
			"dialogs": [
				{
					"id": 150240201,
					"content": "Chissà se possiamo entrare...? Oh, la porta si è aperta da sola. Paimon immagina che sia un sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240202,
					"content": "Uh! L'Iktomisauro di prima, è davvero qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240203,
					"content": "È lui che ci ha chiamato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240204
					]
				},
				{
					"id": 150240204,
					"content": "Allora andiamo a presentarci, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
