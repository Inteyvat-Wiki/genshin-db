						],
						"pointId": 8759
					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "Dovrebbe essere tutto, giusto? Questo incarico è stato molto più facile di quanto Paimon pensasse! Quindi esistono davvero poteri miracolosi come quello? Paimon era piuttosto scettica prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Anche tu vuoi risvegliare i tuoi poteri nascosti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Ma certo! Non sarebbe fantastico avere una super abilità per rilevare i tesori o il potere di distruggere qualsiasi mostro con un solo pugno? Renderebbe le cose molto facili! Dai, {NICKNAME}, non lo vorresti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Voglio più potereee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Forza, sbrighiamoci a rimettere i frammenti sulla stella! Wow... Mi chiedo quale potere risveglierà... Forse sarò persino capace di ascendere fino al cielo... Eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Sono già abbastanza forte. Non ne ho bisogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Eh? Ma non si dice che la strada per perseguire più potere è infinita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
