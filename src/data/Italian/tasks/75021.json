			"dialogs": [
				{
					"id": 750210701,
					"content": "Wow! Fantastico! Avete trovato tutti i frammenti della stella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "Ho messo da parte un bel po' di soldi aiutando Mamma Coco. Vi darò fino all'ultimo Mora in cambio dei frammenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Frammenti di stella? A cosa servono? Uh... Ma prima di questo, che cosa diamine ci fa qui un ragazzino tutto solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "Tutti mi chiamano Orqo, quindi potreste farlo anche voi... Anche se è soltanto un nome in codice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Io sono qui soltanto per raccogliere i frammenti di stella! Avete visto anche voi la grande roccia qui sotto, vero? È una stella caduta dal cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Se riusciremo a raccogliere i frammenti sparsi e a riportarli alla stella, potremo ottenere il potere perduto... Vi prego, vi supplico, ho davvero bisogno di quei frammenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Sembra tutto molto sospetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Già... Ma vale comunque come indizio, no? Perché non proviamo e vediamo cosa succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Anche se... questa storia di frammenti dei stelle, del potere perduto e tutto il resto... Sembra una roba uscita da un romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "Non avete mai sentito la storia di Qoyllor e Ukuku? Mio padre me l'ha raccontata un milione di volte, la so a memoria. Sarei felice di parlarne anche a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Ma prima scendiamo laggiù insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Tu e Orqo arrivate accanto alla \"stella caduta\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Forza, sbrighiamoci a rimettere i frammenti sulla stella! Wow... Mi chiedo quale potere risveglierà... Forse sarò persino capace di ascendere fino al cielo... Eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Woah, davvero sono così fantastici? Beh, allora non vedo perché dovrei darteli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Ehi, è solo un bambino! Rilassati un po'. E poi, anche se non sappiamo se quello che dice è vero, possiamo sempre provare a vedere cosa succede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
