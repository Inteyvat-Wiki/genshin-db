				]
			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, avverti qualche potere incredibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "No, non direi proprio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "La grande roccia non è cambiata affatto! Nessun bagliore misterioso né scosse o crepe improvvise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Abbiamo usato l'incantesimo sbagliato? Anche se a Paimon sembrava giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Di tanto in tanto ci imbattiamo in situazioni come questa quando esploriamo le rovine! Se ti ricordi male la parola d'ordine o il segnale, il meccanismo non risponde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Strano... Mi avevano detto che pronunciare quelle parole avrebbe liberato il potere nascosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "E la persona che me l'ha detto ha chiuso gli occhi e ha iniziato a gemere di dolore subito dopo averle pronunciate! Non solo, ma in seguito ha ottenuto un \"occhio magico\" in grado di riconoscere il valore delle gemme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Caspita, potente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Eh? Sembra piuttosto sospetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Oh, cielo! Finalmente ti ho trovato, razza di testone! Come sei finito quaggiù? Tuo padre era terribilmente preoccupato per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211312,
					"content": "Gli avevo detto che sarei tornato in tempo per mangiare! Doveva proprio dirtelo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "#Continui a ribattere? Anche voi due {F#ragazze}{M#ragazzi}, non indugiate! Chissà quali pericoli potrebbero presentarsi se vi attardate troppo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211314,
					"content": "Riportate Orqo di sopra e spiegate la situazione...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "*sospira* Quelle di cui parlava sono soltanto fantasie infantili. Mi dispiace che vi abbia coinvolto nelle sue marachelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211316,
					"content": "È diventato piuttosto birichino perché nessuno gli impone una vera disciplina. Dopotutto, sua madre non c'è e suo padre non ci vede più bene. Io cerco di dare una mano, visto che sono una loro vicina, ma anche le mie energie sono limitate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211317,
					"content": "Ah, allora è così! Paimon lo sapeva! Non è possibile che una cosa del genere sia vera... Immagina se bastasse raccogliere qualche frammento di pietra per ottenere dei poteri misteriosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Io non sono birichino, lo faccio per papà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Non fare lo sciocco! È solo che non vuoi dare ascolto alle persone più grandi e più sagge di te. Questa volta sei sano e salvo, ma ti sei mai fermato a pensare a cosa succederebbe se un giorno ti ritrovassi in un vero guaio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211320,
					"content": "Umpf! Basta. Comportati bene e vieni con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211321,
					"content": "Va bene... Ma prima... Ecco, tenete. Avevamo un accordo. Sono i Mora che avevo promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Prendeteli. Non vorremmo mai che diventasse una persona che non tiene fede alla parola data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211323,
					"content": "Beh, se la mettete così... non possiamo dire di no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Già, e forse avrò bisogno del vostro aiuto in futuro! Questa volta abbiamo fallito, ma non significa che la prossima volta non avremo successo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Oh, frugoletto...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mamma Coco"
				},
				{
					"id": 750211327,
					"content": "#Andiamo, Mamma Coco, papà ci sta aspettando! Grazie a {F#entrambe}{M#entrambi}, alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Questi sintomi mi sembrano familiari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
