			"dialogs": [
				{
					"id": 750210101,
					"content": "Ehi, che ci fai tu qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "Woah! M'hai fatto prendere un colpo! Guarda che potevo cadere! Come mi avresti ripagato? I miei poteri nascosti non si sono ancora risvegliati, sai, sono solo un bambino indifeso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ah! Scusa, Paimon non aveva intenzione di spaventarti! Ma... poteri nascosti? Parli di qualche super mega tecnica definitiva o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Senti, c'è una ragione se si chiamano poteri \"nascosti\". Se sono nascosti, come diamine faccio a sapere in cosa consistono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Non ha tutti i torti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Lasciamo perdere questa storia, per ora. Potete aiutarmi a trovare i frammenti di stella? Ho messo da parte un bel po' di soldi aiutando Mamma Coco, e potrete averli tutti fino all'ultimo Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Beh, visto che stai chiedendo il nostro aiuto, potresti almeno dirci il tuo nome. A proposito, Paimon è Paimon e {F#questa}{M#questo} è {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Il nome che uso in questo momento non è altro che un nome in codice... Ma tutti mi chiamano Orqo, quindi potreste farlo anche voi. Ora, a proposito di quei frammenti di stella, mi aiuterete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Ecco... che cosa sono i frammenti di stella? Non sembrano qualcosa in cui ci si imbatte tanto facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Sono schegge che si sono staccate da stelle cadute dal cielo! Se le trovi e le riporti al loro posto, puoi riacquistare il potere perduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Guardate! Proprio qui sotto c'è una stella caduta. Laggiù devono esserci degli indizi per trovare i frammenti. Per favore, datemi una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Va bene, va bene, questa volta ti aiuteremo! Anche se... questa storia dei frammenti di stelle, del potere perduto e tutto il resto... Sembra una roba uscita da un romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Non avete mai sentito la storia di Qoyllor e Ukuku? Mio padre me l'ha raccontata un milione di volte, la so a memoria. Sarei felice di parlarne anche a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Ma prima scendiamo a dare un'occhiata insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Così giovane e così fanfarone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
		{
