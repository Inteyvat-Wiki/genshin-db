				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Fiuuu! Non ce l'avrei mai fatta da solo, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Quindi, è questa la stella caduta? Se la si guarda da vicino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaah! Un misterioso potere si sta diffondendo nel mio corpo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "COOOSA?!? Davvero? Ehi, aspetta un secondo, non abbiamo ancora nemmeno trovato i frammenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "E, a proposito di frammenti, ci sono davvero degli indizi qui intorno? Paimon non vede nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Quindi ora che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Dovremo fare affidamento sulla forza bruta. <color=#00E1FFFF>Colpiamola con tutta la potenza di un Tepetlisauro</color>, e forse scopriremo dove si trovano i frammenti mancanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "La forza bruta può risolvere la maggior parte dei problemi! È quello che dice sempre mio padre. Ma la mia forza non si è ancora risvegliata, e non ho nemmeno un Saurico tutto mio... Quindi voi siete la mia unica speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Che strana roccia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Sembra decisamente particolare, ma... è Paimon a essere lenta, per caso? Non sembra emanare alcun potere misterioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
