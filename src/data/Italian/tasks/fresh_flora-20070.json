			"dialogs": [
				{
					"id": 200700501,
					"content": "Ehi, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700502
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700502,
					"content": "Ti ricordi dei fiori che ti ho chiesto di conservare al Picco del Drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700503,
					"content": "È passato un giorno e vorrei vedere i risultati del nostro esperimento di conservazione a freddo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700504
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700504,
					"content": "Potresti aiutarmi a salire sulla montagna e riportare indietro quei fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700505,
						200700507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700505,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "Conto su di te, allora. Ti aspetto qui, torna presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700507,
					"content": "Dov'è che li ho messi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700508
					]
				},
				{
					"id": 200700508,
					"content": "L'hai dimenticato? Li hai messi <color=#00E1FFFF>accanto a una Statua dei Sette</color>, <color=#00E1FFFF>nei pressi di uno specchio d'acqua nelle montagne</color> e <color=#00E1FFFF>vicino a una caverna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700509
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700509,
					"content": "Lascia che ti aiuti a segnarli di nuovo sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
