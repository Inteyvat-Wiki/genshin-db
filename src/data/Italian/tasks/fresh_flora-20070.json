			"dialogs": [
				{
					"id": 200700301,
					"content": "In che stato sono i fiori che abbiamo conservato prima sul Picco del Drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700302,
					"content": "Li ho tutti qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700303
					]
				},
				{
					"id": 200700303,
					"content": "Tutti? Che bello! Fammi vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700304,
					"content": "Eheh, niente male. Mmh... Sembra che questo metodo funzioni davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700305,
					"content": "L'unico problema è che il Picco del Drago è molto lontano da Mondstadt. Non posso disturbarti ogni volta. Devo trovare un altro modo in futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700306,
					"content": "Grazie mille lo stesso. Ecco il tuo compenso, ti prego di accettarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
