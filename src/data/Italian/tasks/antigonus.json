			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Voi due siete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Tu sei Antei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Proprio così, sono io. Mi sento... un po' strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Ricordo di aver inseguito quei furfanti... Di aver strappato un nucleo e di averlo gettato in un accampamento. Poi mi sono sentito un po' intontito per le mie ferite... Ero ferito piuttosto gravemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Ma poi mi sono svegliato e ho incontrato voi, e ora mi sento bene. Ditemi, sto per morire o cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "...Adesso non è importante. Siete qui per arrestarmi di nuovo? Ho già dimostrato la mia innocenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Sono state quelle persone di Khaenri'ah. Hanno rubato loro il libro della biblioteca. Mi era stato affidato il compito di fargli da guardia del corpo, certo, ma non mi sarei mai sognato di finire in combutta con loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Ho seguito il loro gruppo di diplomatici in questo posto e li ho sconfitti tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Ma ho passato parecchio tempo alle prese con una gigantesca creatura meccanica che avevano con loro. Alla fine sono riuscito a strappargli il nucleo, ma nel farlo sono stato ferito gravemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "La macchina disattivata si è schiantata sopra il libro perduto. Adesso è impossibile recuperarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Wow, i Jibashiri di Byakuyakoku sono piuttosto forti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Aspettate, non siete dei Jibashiri o dei candidati a diventarlo? *sospira* A ogni modo, all'inizio i Jibashiri erano eroi che combattevano contro gli Elementosauri abissali. Solo dopo sono diventati tutori della legge: i giudici dell'aldilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Il nucleo della macchina è nell'accampamento. Andate a dare un'occhiata, se non mi credete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
