			},
			"dialogs": [
				{
					"id": 230181601,
					"content": "Eccoti qua. Com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Non mangia carne da qualche giorno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "Cosa? Gli ho detto di mangiare leggero, non di smettere di mangiare carne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Pensa sia più facile accogliere le benedizioni dell'Archon di Dendro così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "Bene... Immagino che dovrò inventarmi qualcos'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "Grazie per il tuo impegno. Ecco, per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
		},
