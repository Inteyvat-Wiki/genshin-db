			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Stavolta la consegna dei medicinali è per Gurgen, alla coltivazione farmaceutica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Si è stirato il braccio per il troppo lavoro svolto qualche giorno prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Per favore, consegnagli questa medicina. Comunque, digli anche di stare a casa e pregare in silenzio l'Archon di Dendro. La coltivazione può aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Torna quando avrai portato a termine la consegna. Preparerò la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Pregare in silenzio l'Archon di Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Non ascolta una parola, se non gliela dico. Fai come ti ho spiegato, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301803",
							"2"
						],
						"stepId": 2301803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180301,
					"content": "Eh? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Ecco la tua medicina, ricorda di pregare in silenzio l'Archon di Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "Ah, grazie. Pregare in silenzio l'Archon di Dendro... Sì, lo farò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180304,
