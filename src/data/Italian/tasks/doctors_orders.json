						230181803
					]
				},
				{
					"id": 230181803,
					"content": "Davvero? Una dieta leggera non significa eliminare completamente la carne? Nemmeno i ricercatori dell'Akademiya lo fanno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "Q-Quindi è così! Pensavo di fare arrabbiare l'Archon di Dendro mangiando la carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Se anche i ricercatori la mangiano... non mi preoccuperò più di non mangiare carne. Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
				}
			]
		},
