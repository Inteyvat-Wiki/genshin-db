			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*sospira* Che seccatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Serve una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Ultimamente stiamo davvero alle strette e non dormo da giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "#Se non ti dispiace, viaggiat{F#rice}{M#ore}, potresti aiutarmi a consegnare alcune medicine ai pazienti nelle vicinanze? Per favore, dovresti anche controllare come stanno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Conto su di te. Per l'amor dell'Archon di Dendro, potrebbe davvero essermi utile l'aiuto di qualcuno in grado di dire qualcos'altro oltre a: \"Che l'Archon di Dendro ti benedica\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ah, \"per l'amor dell'Archon di Dendro\"... Lo sto dicendo spesso ultimamente, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Dovresti fare una pausa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Temo di non averne la possibilità. Ho sistemato altrove i pazienti con patologie più gravi, e devo preparare i loro farmaci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "*sospira* Di certo mi chiederanno come possono accogliere le benedizioni dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "#Conto su di te. Potrebbe davvero essermi utile {F#un'}{M#un }assistente in grado di parlare di qualcosa di diverso dalle benedizioni dell'Archon di Dendro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Devi essere {F#una}{M#un} viaggiat{F#rice}{M#ore}. Questo è il Bimarstan, un ospedale che aiuta le masse... Ehm... diffondendo le benedizioni dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Chiunque abbia bisogno, che sia ricco o povero, può ricevervi assistenza medica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Ma il risultato è che... abbiamo troppi pazienti e non abbastanza mani per occuparci di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "*sospira* La benevolenza dell'Archon di Dendro può essere infinita... Ma il nostro budget e il nostro personale no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "E poi ci sono pazienti che ignorano tutte le istruzioni mediche, ma continuano a chiedere come accogliere meglio le benedizioni dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Ahah, benedizioni dell'Archon di Dendro... Santo cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Se l'Archon di Dendro potesse davvero far piovere benedizioni, non si sarebbero proprio ammalati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "...Fiuu, scusa, non avrei dovuto dirlo. Per favore, non raccontarlo a Golshan o potrebbe di nuovo farmi la ramanzina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Non sei un pio credente dell'Archon di Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Certo che lo sono. Chi non lo è alla Città di Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Ma lascia pure fuori la religiosità da tutto questo. Mi considero piuttosto un... credente razionale dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Uff... Scusa, devo essere esausto anch'io. Mi stavo solo sfogando. Non prendere troppo sul serio quello che ho detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Alcuni dicono che la benedizione dell'Archon di Dendro sia il trattamento stesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*sospira* Ma considerale solo delle storie, ok? Non prenderle sul serio come alcuni nostri pazienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Se l'Archon di Dendro fosse potente come dicono le leggende, non dovrei far altro che somministrare dei funghi ai pazienti e guarirebbero all'istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
