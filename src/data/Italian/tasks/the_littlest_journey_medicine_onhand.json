			"dialogs": [
				{
					"id": 210280401,
					"content": "Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280402,
					"content": "Sì, questa basterà per preparare qualche medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280403,
					"content": "Metterò nel prossimo lotto le medicine contro i colpi di calore e ve le farò consegnare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280404,
					"content": "Grazie, Gui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280405,
					"content": "#E qui c'è qualcosa per te, viaggiat{F#rice}{M#ore}. Grazie per il tuo aiuto! Ora andiamo via, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280406,
					"content": "Eheh, papà sarà molto contento quando lo saprà, ne sono certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280407,
					"content": "Aspetta un attimo, Piccolo Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280408,
					"content": "Eh? Che c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280409,
					"content": "Non avevi detto che dovevi controllare le medicine? Non hai ancora dato un'occhiata alle liste sul retro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280410,
					"content": "Eh? Cosa? Ma... io ho passato così tanto tempo a controllarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280411,
					"content": "E ce ne sono ancora altre, Piccolo Meng. Forza, continuiamo a esaminarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280412,
					"content": "Uffa... Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
