			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#Tempismo perfetto, viaggiat{F#rice}{M#ore}! Volevo proprio chiederti una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Ha detto che il viaggio sarà molto lungo e che avremo bisogno di alcune medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280106,
					"content": "Qualcosa per il mal di testa, per la diarrea, per i colpi di calore, per i postumi della sbornia, per aiutare la digestione... Ci serviranno un sacco di medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280107,
					"content": "Aspetta, perché dovrebbero aver bisogno di un medicinale contro i postumi della sbornia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "Probabilmente sarà in previsione delle trattative d'affari.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Eh? Cosa c'entra un medicinale contro i postumi della sbornia con le trattative d'affari? Non mi sembra che ci sia una correlazione tra gli affari e l'alcool, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "In ogni caso, papà vuole che vada a chiedere alla Farmacia Bubu se le medicine sono già pronte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280111,
					"content": "Potreste accompagnarmi? Vorrei chiedervi di aiutarmi con una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280112,
					"content": "Andiamo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Forza, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280113,
					"content": "In cosa possiamo aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Ne parleremo quando saremo lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280103,
					"content": "Come stanno andando i preparativi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Beh, sono soprattutto papà e i suoi amici che si stanno occupando dei preparativi... Ma papà mi ha affidato un compito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
