			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui l'erborista",
					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Salve. State per caso cercando un rimedio a base di erbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280202,
					"content": "Piccolo Meng? Cosa ti porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280203,
					"content": "Oh, giusto: ora ricordo. Sei qui per quelle medicine, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280204,
					"content": "Non preoccuparti, sono quasi tutte pronte. Le manderò a tuo padre poco alla volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280205,
					"content": "Detto questo, il suo ordine ha esaurito le nostre scorte di erbe, quindi alcune di quelle medicine saranno pronte in un secondo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280206,
					"content": "Fammi vedere... Beh, siamo soprattutto a corto di menta, il che ha bloccato la produzione di medicine contro i colpi di calore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280207,
					"content": "Insomma, prendiamo anche altri ordini oltre quelli di tuo padre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280208,
					"content": "Beh, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280209,
					"content": "È arrivato il momento di entrare in azione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Eheh, grazie, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280213,
					"content": "Conto su di te per recuperare quelle erbe! Nel frattempo dovrò restare qui a controllare quelle medicine, proprio come mi ha detto di fare papà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280214,
					"content": "Ahah, ma che ragazzino coscienzioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280215,
					"content": "Va bene, da questa parte. Controlleremo questo lotto di medicine insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280216,
					"content": "Wow, ma sono tantissime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280217,
					"content": "Dai prima un'occhiata a queste, poi ti farò vedere le altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 210280218,
					"content": "Eh? Ce ne sono altre?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210280211,
					"content": "Non dimenticarti di pagarmi, mi raccomando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#Eheh, nessun problema! Grazie, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
