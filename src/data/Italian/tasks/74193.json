				{
					"id": 741930504,
					"content": "Non importa se non hai niente con te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930505
					]
				},
				{
					"id": 741930505,
					"content": "Esatto. Possiamo darti comunque l'Algamarea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930506,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930507
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930507,
					"content": "#Paimon, amica... sincera! {NICKNAME}, {F#amica... sincera}{M#amico... sincero}! Quindi... scambio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930508
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930508,
					"content": "Um, d'accordo allora. Per quanto tempo starai via, Pahsiv? È un \"ci vediamo\", vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930509,
					"content": "Ci... vediamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930510
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930510,
					"content": "Sì, è quello che si dice per dire che si vorrebbe incontrare di nuovo qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930511,
					"content": "\"Ci vediamo\" sono le parole che usiamo per congedarci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930512
					]
				},
				{
					"id": 741930512,
					"content": "Esattamente. Prima ti abbiamo detto che ti avremmo insegnato come congedarsi, no? Perché non provi tu a dirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930513,
					"content": "Ci... vediamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930514
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930514,
					"content": "Oh, non sai cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930515,
					"content": "Mmm... Beh, anche quello lo puoi considerare una sorta di scambio. Come scambiarsi il domani l'uno con l'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "Tu prendi un pezzetto del tuo domani e lo dai a noi e noi diamo a te un pezzetto del nostro. Et voilà, ci si rincontra! Ora hai capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Scambio domani... per domani! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930518
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930518,
					"content": "Eheh, a quanto pare hai capito! In tal caso, ci diciamo \"ci vediamo\" per ora. In questo modo, ci rincontreremo di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930519,
					"content": "Ci vediamo! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930520,
					"content": "Ci vediamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930521
					]
				},
				{
					"id": 741930521,
					"content": "#Ci vediamo, {NICKNAME}! Ci vediamo, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		}
