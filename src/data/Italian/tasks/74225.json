			"dialogs": [
				{
					"id": 742250201,
					"content": "#Grazie, {F#mia benefattrice}{M#mio benefattore}! Sia lode al Dio re, sono salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "#Sei per caso {F#una}{M#uno} dei legionari che difendono la città? O un'anima prode di passaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Sia come sia, permettimi di presentarmi. Faustus è il mio nome, faccio parte dei Mercatores Exquisiti, nominato dal Dio re in persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Sono venuto a portare delle spezie provenienti dai regni del Sud... Non pensavo che quegli spregevoli Elementosauri mi avrebbero accerchiato nel momento stesso in cui ho toccato terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Elementosauri? Non ho visto nessun Elementosauro io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#Mmm? Corbezzoli, sei davvero {F#una prode guerriera}{M#un prode guerriero}, e non consideri nemmeno alla tua portata quegli spregevoli avversari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "In ogni caso, ecco a te. Temo di non aver molto tempo per i convenevoli, questa merce dev'essere portata in città. Forse ci rivedremo lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
}