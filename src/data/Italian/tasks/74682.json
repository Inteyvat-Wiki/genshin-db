			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "E alla fine eccoci qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "E il tuo sogno da bambino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Da adulto ho capito perché i Guardiani della foresta si facevano scuri in volto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "*tossisce* Fa niente, ci ho provato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "Ho anche imparato che non è mai una buona idea avvicinare un frutto non trattato di Regisreptus di Pyro a un Fungostro Cresta di giada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Quando ho sentito odore di bruciato, era già troppo tardi. Stavo per soffocare a causa di tutte le spore che aveva rilasciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "A volte ci si dimentica che i Miconoidi sono una specie completamente diversa dai Funghiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Comunque... sono un tipo di fungo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "Esatto, e se ne ricava una zuppa deliziosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "Comunque... Torniamo alla sfida odierna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "Beh, non mi sono ancora deciso su cosa cucin... Ah! Giusto, intendevi le \"negoziazioni\". Scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "Forse hai sentito parlare della storia dei due sovrani Aberranti del Fontemer... Si racconta che l'Ippocampo Perlamillenario sia descritto come \"nobile\" e \"orgoglioso\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "Al contrario, l'Imperatore del Fuoco e del Ferro pare essere una creatura crudele e feroce. Forte ma anche brutale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "E Paimon che pensava che avresti scelto l'avversario più tosto. Dopotutto, un rivale più forte non rende la storia più accattivante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "Vero, ma l'Imperatore è un granchio pesantemente corazzato... Mentre l'altro è un cavalluccio marino che vola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "Visto che è un cavalluccio marino che vola, non dovrebbe chiamarsi cavalluccio alato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "È questa la domanda più importante che ti viene in mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Se solo potessi cavalcarlo... Solo per una volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Ma certo. Sembra proprio che arriverai in fondo alla questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "#Beh, siamo qui, no? Non possiamo certo andarcene a mani vuote. Comunque, quando sarete {F#pronte}{M#pronti} ci avvieremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "#Sono {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Ho altre cose da fare. Ci vediamo fra un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Nessun problema, ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Per me è lo stesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}