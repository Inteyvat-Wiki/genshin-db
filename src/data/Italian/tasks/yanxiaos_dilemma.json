			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "Hai consegnato il piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Sì, e mi ha chiesto di ring...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Ringraziarmi di cuore? Ma figurati, che buffonata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Che rabbia... Non so quante volte ho già sentito queste parole negli ultimi anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030605,
					"content": "Ringraziarmi di cuore sembra essere il suo unico passatempo oltre alla pesca. E se invece la smettesse di perdere tempo e venisse alla locanda a guadagnarsi la pagnotta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030606,
					"content": "Ah, sfogare la mia rabbia su di te non serve a nulla. Ecco la tua ricompensa, te la sei meritata, a differenza di altre persone. Ora puoi tornare alle tue cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200305",
							"2"
						],
						"stepId": 2200305,
						"stateName": "QUEST_STATE_UNFINISHED"
