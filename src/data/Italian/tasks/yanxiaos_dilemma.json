				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Aspettami qui. Quando il piatto sarà pronto, potrai portarglielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Non fare quella faccia scontenta! Non preoccuparti, ti ricompenserò a dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Ok, è pronto. Portalo al signor Scroccone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Si chiama <color=#00E1FFFF>Jiangxue</color>. Lo troverai a pescare in riva al fiume, non puoi sbagliarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200304",
							"2"
						],
						"stepId": 2200304,
						"stateName": "QUEST_STATE_UNFINISHED"
