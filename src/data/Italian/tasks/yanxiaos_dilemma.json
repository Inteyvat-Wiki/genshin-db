			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Tsk, che faccia tosta... è solo uno scroccone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Sto cucinando per qualcuno che non se lo merita, ecco cosa sto facendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030104,
					"content": "Assurdo! Passa tutto il suo tempo a fare quello che vuole e non si offre nemmeno di aiutare alla locanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Passa la maggior parte della sua giornata a pescare, ma non riesce a prendere più di due pesciolini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Se non fosse per me, morirebbe di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Uff, a che serve lamentarsi? Non può sentirmi, e anche se potesse, farebbe finta di nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Se non hai niente di meglio da fare, puoi andare a prendermi un paio di ingredienti che mi mancano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Non mi serve molto, solo un <color=#00E1FFFF>peperoncino di Jueyun</color> e un <color=#00E1FFFF>frutto di loto</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Portameli qui dopo che li hai trovati. Voglio finire il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Ma ci sono così tanti ingredienti qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "La proprietaria ha pagato fior di Mora per quelli. Secondo te quello scroccone glieli restituirà? Io penso proprio di no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Tutto quello che cucino per lui lo pago di tasca mia... Tsk, mi deve un sacco di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Vai a cercare quegli ingredienti, ok? Non chiedo tanto, ti assicuro che non ci impiegherai troppo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200302,
