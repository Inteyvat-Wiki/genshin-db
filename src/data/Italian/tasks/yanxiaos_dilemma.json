					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030201,
					"content": "Dove sono i miei ingredienti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030202,
					"content": "Eccoli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "Non li ho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "E perché diavolo non li hai ancora?!? Vai a prenderli! Altrimenti, quel fannullone si arrabbierà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200303,
			"completionStepIds": [
				2200303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200303",
							"2"
						],
						"stepId": 2200303,
						"stateName": "QUEST_STATE_UNFINISHED"
