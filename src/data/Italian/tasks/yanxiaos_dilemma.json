				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "E non fare tardi! Un taccagno felice è sempre meglio di un taccagno affamato, fidati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Perché cucini per lui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Se proprio vuoi saperlo, è una persona solitaria. Sono l'unica persona che conosce in tutta Liyue. E questo è l'unico posto dove ha il coraggio di venire a scroccare qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030404,
					"content": "#Perché me lo chiedi? Che importanza ha? Va bene, va bene... il motivo è che voglio cucinare per lui. Content{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Se io non cucinassi per lui, andrebbe di nuovo a fare qualcosa di stupido alla Palude di Dihua. E non possiamo permettere che accada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030406,
					"content": "Cosa ci fai ancora qui? Non perdere tempo, muoviti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 2200305,
			"completionStepIds": [
				2200304
