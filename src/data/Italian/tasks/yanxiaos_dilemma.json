			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "Ciao! Stavi cercando me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030502,
					"content": "Questo è da parte di Yanxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "Ah, mi stavo proprio chiedendo da dove venisse questo profumino. È un cuoco davvero talentuoso, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030504,
					"content": "Grazie per avermelo portato. E ricordati di ringraziarlo di cuore da parte mia, quando torni da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
				2200305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
