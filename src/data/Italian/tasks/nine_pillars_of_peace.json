				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Fammici pensare un po'...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Tsk... Beh, va bene. Pensateci un po'. Magari la mia offerta non è la migliore che avete ricevuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Ma quando si tratta di affari, se scegliete me, le cose andranno alla grande per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Pensateci, questo anello non smetterà di passare di mano in mano. Se me lo vendete adesso, vi renderò partecipi di tutte le altre transazioni che avverranno in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "E non solo, sono anche disposto ad aggiungere alcune cosucce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Pensateci bene e tornate da me in qualsiasi momento, se decidete di vendere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
