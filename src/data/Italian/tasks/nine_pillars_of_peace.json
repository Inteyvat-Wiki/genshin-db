			"dialogs": [
				{
					"id": 710050401,
					"content": "Affare fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Meraviglioso! Che decisione rapida. Ecco i soldi, sono vostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Ah, questo anello è un vero tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Devono esserci altre gemme così tra quelle rovine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 7100505,
			"completionStepIds": [
				7100535
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
