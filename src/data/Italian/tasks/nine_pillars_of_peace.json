			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "\"Avidità, nostalgia, visione, gelosia, rabbia, lussuria, autoesaltazione, competizione, agitazione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Iscrizione"
				},
				{
					"id": 710051202,
					"content": "\"Questi nove desideri mortali possono guarire il mondo o ferirlo gravemente. La loro fiamma non si affievolirà e non si spegnerà mai... Così, poniamo nove pilastri per portare la pace, per porre fine ai conflitti che affliggono questo mondo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Iscrizione"
				},
				{
					"id": 710051203,
					"content": "\"Se un giorno qualcuno spezzerà i pilastri ed entrerà, la guerra tornerà a consumare il mondo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Iscrizione"
				},
				{
					"id": 710051204,
					"content": "\"O voi che leggete questa stele, reclamate il tesoro che si cela all'interno e portate la pace a Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iscrizione"
				}
			]
		},
