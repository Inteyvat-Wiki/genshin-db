			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050101,
					"content": "\"Tutti i disordini del mondo affondano le radici nel vizio umano...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050102
					],
					"speakerTitle": "Iscrizione"
				},
				{
					"id": 710050102,
					"content": "\"Qui innalziamo nove pilastri, per sopprimere il conflitto, perché mai più un esercito venga scagliato contro un altro...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iscrizione"
				}
			]
		},
		{
			"id": 7100502,
			"completionStepIds": [
				7100531
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100531",
							"2"
						],
						"stepId": 7100531,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "#Queste rovine fanno venire i brividi a Paimon, ma dovremmo essere arrivat{F#e}{M#i} alla fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "E abbiamo anche un tesoro per ripagare i nostri sforzi... Quell'anello che abbiamo trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Andiamo a cercare qualcuno che <color=#00E1FFFF>se ne intenda di antiquariato</color> e vediamo a quanto possiamo venderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100532",
							"2"
						],
						"stepId": 7100532,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100535",
							"2"
						],
						"stepId": 7100535,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Potresti dare un'occhiata a questo pezzo d'antiquariato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Antiquariato e curiosità? Non è proprio il mio campo, ma vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Questo anello... ha una gemma di giada incastonata, e anche di buona qualità. Anche solo la gemma varrebbe una bella somma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "C'è anche un'iscrizione: \"La catastrofe dilaga in tutto il mondo, e chi ancora vive lo fa in agonia\"... Dove l'avete trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "Tra alcune rovine vicino al Pendio di Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Il Pendio di Cuijue, eh... Umpf, che peccato. E pensare che è così vicino ai Monti di Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Se l'anello provenisse dalle rovine dei Monti di Jueyun, varrebbe sicuramente molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Purtroppo, senza un'origine storica, il prezzo di questo gioiello si abbassa molto. Ma è di buona qualità e sono sicuro che qualcuno lo vorrà comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Che ne direste se offrissi <color=#00E1FFFF>180.000 Mora</color> per questo anello, con qualche aggiunta. Me lo vendereste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 7100504,
