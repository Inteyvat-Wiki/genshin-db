				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Potresti dare un'occhiata a questo pezzo d'antiquariato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "#Un pezzo d'antiquariato? Beh, siete venut{F#e}{M#i} dalla persona giusta. Oserei dire che sono la più brava in tutta Liyue a valutare queste cose. Vediamo un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Mmmh... Sia la gemma che l'anello sono di qualità pregiata, e sono molto antichi... Eppure sono molto ben conservati... Molto insolito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Però non posso dire di aver mai sentito la frase: \"La catastrofe dilaga in tutto il mondo, e chi ancora vive lo fa in agonia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Non ha importanza. Dove l'avete trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "Tra alcune rovine vicino al Pendio di Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "#Ah, allora siete {F#delle esperte}{M#degli esperti}, eh? Non molti osano spingersi lì a caccia di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Per caso quelle rovine erano circondate da nove pilastri, con una stele di pietra al centro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "#Non siate sorpres{F#e}{M#i}. Ho sentito molte persone che vengono a fare affari con me parlare di quel posto. Dicono sempre che una formazione così grande deve celare qualche tesoro al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Sostengono addirittura che quei pilastri e quelle rovine siano stati costruiti dagli antenati di Liyue per sedare i conflitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Ma immagino che sia solo una leggenda. Dopotutto, se nove pilastri di pietra potessero mettere fine alle guerre, questo mondo sarebbe già in pace da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Però, che sia vero o meno, questo anello arriva da quelle rovine, quindi deve avere qualcosa a che fare con quella leggenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Ha un nome e una storia, ed è anche di buona qualità, quindi vale una bella somma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "#Rilassatevi, non vi chiederò come siete entrat{F#e}{M#i} lì dentro. Io mi occupo solo di affari, il resto non mi riguarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Tutto sommato, direi che questo anello vale <color=#00E1FFFF>200.000 Mora</color>. Che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
