					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "Se partite ora, dovreste riuscire a coglierlo con le mani nel sacco. Aspetterò voi e le vostre buone notizie qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "#C'è qualcos'altro che vorresti dirmi, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Non sembri molto entusiasta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Il caso è poco interessante: ha un colpevole noioso e i metodi non sono affatto sofisticati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Se dovessi descriverlo in tre parola, direi che è... una noia mortale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Ma è un crimine, perciò è un bene che venga risolto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Non vieni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Ho già fatto la mia parte, mi terrò fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "E poi, con il mio fisico e le mie abilità nel combattimento, il colpevole potrebbe prendermi in ostaggio, cosa che poi userebbe a suo vantaggio per fare ciò che vuole. Sarebbe lo scenario peggiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Conosco i miei limiti, quindi lascio a voi l'onere di occuparvi di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
	]
}