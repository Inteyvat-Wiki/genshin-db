			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "#Ora l'abbiamo colto con le mani nel sacco. Grazie dell'aiuto, Ryuuji, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Io e Amano porteremo questi Cacciatori di tesori alla stazione di polizia. Al resto ci pensiamo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "È fantastico come Sango abbia capito i dettagli del caso in modo così accurato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Beh, è pur sempre Sango. Un caso come questo è una bazzecola per lei, senza alcun dubbio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Ryuuji, noi torniamo prima alla stazione di polizia. Passeremo a salutare quando avremo finito con questo tizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Certo, fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "#Viaggiat{F#rice}{M#ore}, torniamo da Sango a fare rapporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
