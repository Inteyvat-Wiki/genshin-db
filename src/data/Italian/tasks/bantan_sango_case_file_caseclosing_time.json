				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "...E Andou e Amano stanno portando il colpevole alla stazione di polizia in questo momento, Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Capisco, allora è finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "#Viaggiat{F#rice}{M#ore}, grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "Quindi... è finita così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "È normale sentirsi così. Dopotutto, sono stati Amano e Andou a portare via il criminale. Perché non ti prendi la tua ricompensa? Ti aiuterà ad accettare il fatto che la situazione sia stata risolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "E il tuo compenso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Il mio? La ricompensa più grande per me è aiutare la polizia a risolvere un caso e portare pace e sicurezza alla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Ma, a essere sincera, non ho guadagnato molto, stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Non ho visto nessuna nuova tecnica o idea criminale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "È stato un crimine poco interessante. Per fortuna non ha richiesto troppo sforzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Mmmh? È la prima volta che incontri qualcuno tanto interessato al crimine come me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "È il suo fascino che mi ha portato a decidere di diventare un'investigatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "Anche tu vuoi commettere \"crimini\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Sì, in un certo senso. Mi piacerebbe commettere un crimine perfetto e impeccabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Tuttavia, è inevitabile lasciarsi dietro delle prove durante un crimine. E finché ci sono prove, è solo questione di tempo prima che il caso venga risolto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "E se il crimine non fosse stato commesso da una persona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Lo vedi? Anche tu non riesci a evitare di pensare di commettere un crimine, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Non agitarti, ci stai pensando solo ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Io penso ai crimini tutto il tempo, al come e al perché vengono commessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Perché pensi queste cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Per risolvere meglio i casi, ovviamente. I casi a cui lavoro ultimamente stanno diventando sempre più complicati, perciò ho dovuto rifletterci molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Tuttavia, nessuno di quei casi può definirsi perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Hai mai visto un crimine perfetto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Sì. C'è stato un crimine perfetto che ancora oggi non riesco a risolvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Ma credo che ci dovrebbero essere delle prove, se questo crimine è stato commesso da una persona. È solo che non le ho ancora trovate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "#Comunque, ecco il tuo compenso. Grazie del tuo aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "Vieni pure quando hai tempo. Ma, se hai troppi impegni... beh... non preoccupartene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Eppure, il mio istinto mi dice che avremo di nuovo modo di unire le forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "E se il colpevole non esistesse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "C'è un modo per cancellare le tue tracce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Tutti gli investigatori sono come te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Non vorrei generalizzare, ma sono molto interessata al \"crimine\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Non vuoi niente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Ho già assaggiato il dolce sapore della giustizia. Non mi serve nient'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "Eheh... Niente male come discorso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Non c'è altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
