				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "Bene, allora conto su voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "Puoi stare tranquilla, Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "Non posso credere che ce l'avessimo sotto il naso per tutto il tempo. Ha una bella faccia tosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "Come diamine gli sarà venuto in mente... di fingere così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "In ogni caso, oggi segnerà la fine della sua \"carriera\". Ryuuji, ricordi ciò che ho detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "#Bene... Ci sei anche tu, viaggiat{F#rice}{M#ore}, ottimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "Catturerai il ladro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "Ho raccolto abbastanza prove e ho capito le abitudini del colpevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "#Viaggiat{F#rice}{M#ore}, andresti con Ryuuji, Andou e Amano a portare il colpevole alla giustizia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "Deve avere molti complici. Grazie alla tua presenza, le probabilità di successo dell'operazione saranno molto alte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "Cosa devo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Usa la tua aura imponente per spaventare il colpevole in modo che non riesca a fare nulla... di particolarmente stupido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "In ogni caso, credo che un ladro che non sappia fare altro che restare nell'ombra non avrà il coraggio di fare mosse drastiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "Se non mi sono sbagliata, il nostro uomo sarà andato in un posto incontaminato per seppellire le merci appena rubate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "Se partite ora, dovreste riuscire a coglierlo con le mani nel sacco. Aspetterò voi e le vostre buone notizie qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "Non vieni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Ho già fatto la mia parte, mi terrò fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "#Viaggiat{F#rice}{M#ore}, usa la tua aura imponente per spaventare il colpevole in modo che non riesca a fare nulla... di particolarmente stupido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "In ogni caso, credo che un ladro che non sappia fare altro che restare nell'ombra non avrà il coraggio di fare mosse drastiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "Risolverai il caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Sì. Se tutto va bene, il caso sarà risolto oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201902,
			"completionStepIds": [
				2201903
