			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ascolta la prossima rassegna"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-336.767,
							200.419,
							-709.591
						],
						"pointId": 7026
					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Salve a tutti. Io sono Tian Lingua di ferro, e questa è l'insegna dell'evento \"Campo di addestramento Arataki per le sfolgoranti lotte tra scarabei corazzati\". Vale anche come autorizzazione per il suo svolgimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662002,
					"content": "Woah! E questi... dovrebbero essere Toro sdraiato e Bastone cremisi? È tutto così esagerato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Oh, ma che forza! Il disegno non è opera mia, purtroppo, ma... guardate che stile! E che bel tratto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "È fantastico, ha un'aria così epica! È la perfetta rappresentazione della mia incredibile potenza combattiva nelle lotte tra scarabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Ehi, amico! No, aspetta... Com'è che ci si rivolge agli estranei in questa parte del mondo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Forse con... \"egregio\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716662007,
					"content": "Sì, esatto! Egregio Tian, la tua è un'autentica opera d'arte! La Banda di Arataki non ha parole per esprimerti la sua gratitudine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Non serve alcun \"egregio\", capo Arataki. Inoltre, io non sono un artista, soltanto un cantastorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662009,
					"content": "Questa illustrazione promozionale è stata realizzata da una giovanotta del Ministero degli Affari Civili. Yanfei va spesso a trovarla, e quando ha saputo del vostro evento si è offerta di dare questo contributo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662010,
					"content": "Ooh, quindi è opera di Yanfei! Cavoli, le ha davvero pensate tutte... Questo è esattamente ciò che ci serviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Il qui presente giovane Granmaestro Hanakado mi diceva che il vostro campo di addestramento consiste in un ambizioso percorso di formazione per i futuri combattenti nelle lotte tra scarabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662012,
					"content": "Io non ho mai partecipato a lotte del genere, ma ne ho sentito un gran parlare e mi hanno sempre incuriosito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662013,
					"content": "Chissà, potrebbe darmi l'ispirazione per una storia nuova e appassionante da raccontare agli abitanti del quartiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662014,
					"content": "Le lotte tra scarabei sono una pratica che richiede un'affinità naturale. Prendi Melonlavanda Biancoferro Squarciatrice dei cieli, per esempio: ha affrontato la sua prima battaglia mostrando un'abilità eccezionale, il tutto solo dopo aver osservato una breve dimostrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716662015,
					"content": "Quando l'egregio Tian avrà appreso le basi della lotta tra scarabei e ne avrà compreso il fascino, le sue storie potrebbero essere un'ottima pubblicità gratuita per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716662016,
					"content": "Grande! Sarebbe pazzesco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Bene, Ambrogio! Adagio! Elegio! EGREGIO! Ahehehehehem... Beh... C-Che vinca il migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 7166621,
			"completionStepIds": [
				7152503
			],
