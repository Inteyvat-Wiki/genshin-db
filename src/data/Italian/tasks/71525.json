					}
				]
			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "Magnifico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662102,
					"content": "La Banda di Arataki è riuscita a trasformare le lotte tra scarabei in uno sport entusiasmante e ferocemente competitivo. Sì, ci sono i rudimenti per trarne un'ottima storia che verrà raccontata più e più volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662103,
					"content": "Abbiamo avuto un grande duello, egregio Tian! È stato un autarchico piacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "Si dice \"autentico piacere\", Re oni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716662105,
					"content": "Ah, sciocchezzuole! Quello che intendo è... Grazie per il tuo supporto al nostro campo d'addestramento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Anch'io ti sono grato, capo Arataki. Resterò qui a osservare ancora per un po', così potrò scovare altri spunti di scrittura. Non badate a me, fate pure come se non ci fossi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Ascolta la prossima rassegna"
				},
				{
					"id": 716662107,
					"content": "Cavolo, è la prima volta che combatto contro qualcuno così... colto! Mi ronza la testa dopo aver ascoltato tutti questi paroloni. Com'è che si chiama questo tipo di ronzio? Ah, già... \"Apprendimento\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Pare che l'evento \"Campo di addestramento Arataki per le sfolgoranti lotte tra scarabei corazzati\" sia partito alla grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
