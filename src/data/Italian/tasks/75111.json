					"Chanca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751111501,
					"content": "Eh? Sì, è la mia lettera. Non immaginavo avesse incontrato un destino simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Ah, beh, mi toccherà scriverne un'altra. Per fortuna non era così urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "#Grazie comunque per avermi riconsegnato la lettera. Sei {F#tutta sudata}{M#tutto sudato}! Tieni, ti offro da bere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chanca"
				}
			]
		},
		{
			"id": 7511116,
