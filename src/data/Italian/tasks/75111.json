			"dialogs": [
				{
					"id": 751111401,
					"content": "Sì, me lo ricordo. Un membro dei Figli degli Echi era interessato ad acquistare delle pitture, ma era totalmente incapace di dirmi con precisione quali colori stesse cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "Così gli avevo inviato un pacchetto con varie boccette di pittura affinché potesse decidersi prima di tornare da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Gliele farò rispedire... Non voglio che torni solo per farmi un'altra delle sue richieste ridicole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ah, giusto! Questo è per te. Grazie per avermi riportato il pacchetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
