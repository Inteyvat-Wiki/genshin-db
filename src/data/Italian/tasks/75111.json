				"points": []
			},
			"dialogs": [
				{
					"id": 751111601,
					"content": "Sì, lo riconosco... È il pacchetto che avevo spedito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111602
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111602,
					"content": "Ah, meno male, avevo quasi pensato di aver sbagliato a indicare il destinatario... Me la sarei vista nera se fosse stato così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111603
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111603,
					"content": "Grazie davvero! Ecco, questo è per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111604
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111604,
					"content": "E poi... Ehm, potresti evitare di dirlo alla signora Cheven? Ti supplico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
