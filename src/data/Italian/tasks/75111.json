			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Sembra che... sia per Acat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "L'imballaggio è rotto. Se lo rispediamo così com'è, l'intero articolo potrebbe rovinarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "Io devo ancora rimettere in ordine i pacchetti nel negozio, potresti aiutarmi a recapitarglielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "È la proprietaria della Tavolozza di Frida. Non preoccuparti, è impossibile non notare l'insegna del suo negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
							"2"
