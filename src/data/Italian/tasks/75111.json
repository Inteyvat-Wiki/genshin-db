				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110501,
					"content": "...Questa è una lettera di Tirda, se non sbaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Che stesse cercando di inviarla alla sua tribù? Ma guarda tu in che condizioni è ridotta... Dovremo riportargliela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Io devo ancora rimettere in ordine i pacchetti nel negozio, potresti riconsegnarla a Tirda al posto mio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Canta al Tramonto d'oro. La troverai in men che non si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
