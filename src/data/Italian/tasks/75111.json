			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "Il Gemporio di Muhuru... Imix? Ugh, questa è una fattura inviata da lei, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Se questa spedizione viene smarrita, quella ragazzina riceverà una bella strigliata dalla signora Cheven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "Io devo ancora rimettere in ordine i pacchetti nel negozio, potresti aiutarmi a restituirla a Imix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "Il Gemporio di Muhuru si trova nelle terre dei Figli degli Echi, è facilissimo da trovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511105,
			"completionStepIds": [
				7511105
			],
