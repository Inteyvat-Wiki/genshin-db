			"dialogs": [
				{
					"id": 710702601,
					"content": "Grazie dell'aiuto. Senza di te, di sicuro la nostra spedizione sarebbe stata un fallimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702602
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702602,
					"content": "#Non so come ci sia riuscit{F#a}{M#o}, ma i valori delle linee geomantiche di quest'area si sono stabilizzati in modo significativo... Ah, e le sostanze inquinanti si stanno diffondendo più lentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702603,
					"content": "Ma non sappiamo il perché... Chissà, forse la risposta si cela ancora più in profondità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710702604,
					"content": "E Zhiqiong... Beh, diciamo solo che può ancora andar via, ma a lei importa più della Voragine che della propria vita... E non capisce che la Voragine sembra intenzionata a togliergliela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
