					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702204
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710702204,
					"content": "Mi ha detto che poi mi avrebbe raccontato la sua avventura. Se andrai da quella parte, dovresti riuscire a trovarla facilmente.",
