	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, eccovi! Grazie per averci aiutati a liberare la strada. Grazie anche a te, Zhiqiong, per averci fatto da guida. Ci sei stata di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Parlami dell'accampamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Beh, è proprio bello, vero? Gli accampamenti sono la mia specialità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Mio padre cominciò a insegnarmi tutte queste cose quando avevo circa dieci anni... Ho imparato a mettere su un accampamento, a realizzare delle lampade di cristallo, a prendermi cura dell'attrezzatura da miniera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Mentre imparavo, mio padre invecchiava... Quando ha iniziato a perdere la vista, la responsabilità della manutenzione delle dotazioni di sicurezza della miniera è ricaduta sulle mie spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Ho continuato anche dopo, e... Beh, come puoi vedere, ormai neanch'io sono più tanto giovane. Non c'è molto altro da raccontare... Ho incontrato un uomo, l'ho perso, ho avuto una figlia che poi si è trasferita a studiare a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Ogni tanto, quando i minatori vanno via presto, mi prendo cura io dei loro figli... Quindi ho sempre con me dei dolcetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Ed è per questo che... immagino sempre che i bambini mi vedano come una persona che profuma di dolcetti, e che mi osservino dal basso in attesa di ricevere qualche caramella o roccia colorata con cui giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Wow. Ehm, quindi ora hai delle caramelle con te, Jinwu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Non ho delle caramelle raffinate come quelle che si trovano in città, ma non sarai mica schizzinosa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Ah, quindi sono queste le caramelle di cui parlavi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "Le persone vanno e vengono, quindi i miei ricordi sono l'unica compagnia che ho... Oltre agli avventurieri come te che esplorano le miniere, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Parlami un po' di Zhiqiong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong fa parte dell'ultimo gruppo di minatori giunto qui, e proviene dal Villaggio di Mingyun. A essere sincera, tutti i minatori più esperti della Voragine venivano da lì. Lei sembra essere nata nell'epoca sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Ah, non mi fraintendere, non sto dicendo che siano tempi difficili, ma i giacimenti minerari di Mingyun si sono esauriti tantissimo tempo fa, per cui lì non c'è più lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Quell'incidente si verificò poco dopo l'arrivo di Zhiqiong nella Voragine, e le attività di estrazione si fermarono. Immagino che non sia destinata a fare questo lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Dopodiché ognuno andò per la propria strada. Io sono rimasta perché serve qualcuno che si prenda cura dell'attrezzatura. Lei, invece, è diventata un'avventuriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Però non è per niente cresciuta, né ha imparato a dare importanza alla propria vita... Forse è perché non ha trascorso abbastanza tempo giù nelle miniere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Sono sicura che, quando si abituerà alla vita in miniera e salverà un po' di gente da situazioni pericolose, imparerà ad apprezzare la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Non so se posso chiedertelo, ma... Potresti vegliare su di lei? Non voglio che finisca per farsi ammazzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Bene, allora. Abbi cura di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
