			"dialogs": [
				{
					"id": 710702001,
					"content": "Oh, eccoti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702002
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702002,
					"content": "Ultimamente Zhiqiong non è in gran forma. Ho il sospetto che quella... roba contaminata le stia facendo male sia al corpo che alla mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702003
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702003,
					"content": "Di qualsiasi cosa si tratti, è molto simile a quella che la gente che viveva qui cinquecento anni fa chiamava \"calamità oscura\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702004
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702004,
					"content": "Ma oggi gli Yaksha non sono che un lontano ricordo, e persino Rex Lapis ci ha lasciati... Devo ammettere che non ero mai stata così preoccupata per l'incolumità di noi mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702005
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702005,
					"content": "Scusami, ti sto trattenendo qui solo per raccontarti queste sciocchezze inutili. Eppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702006
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702006,
					"content": "Non importa... Fa' attenzione, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
