						710702507
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702502,
					"content": "Beh, di sicuro sembri startene con le mani in mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702503
					]
				},
				{
					"id": 710702503,
					"content": "Oh, dai. Mi hai preso per uno scansafatiche? Vorrei sottolineare che, ogni volta che qualcuno ha bisogno di me, non ho tempo per fare nient'altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702504,
					"content": "Come sta Zhiqiong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702505
					]
				},
				{
					"id": 710702505,
					"content": "Sembra essersi calmata un bel po' da quando è tornata. A essere sincero, mi chiedo se sia quest'atmosfera angosciante a far perdere le staffe a tutti così facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702506
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702506,
					"content": "Poco tempo fa, sono anche stato rimproverato da Jinwu. Non l'avevo mai vista così arrabbiata... Se ci ripenso, mi vengo i brividi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702507,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702508
					]
				},
				{
					"id": 710702508,
					"content": "Alla prossima, stammi bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
