			"dialogs": [
				{
					"id": 710702801,
					"content": "Ahah, rieccoti! Bene, siediti e riposa un pochino. Fa' come se fossi a casa tua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702802,
					"content": "Beh, di per sé questo luogo non mi fa \"sentire a casa\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "Ahahah! Ahi, certo che hai la lingua tagliente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Grazie a voi, ora all'accampamento c'è un'atmosfera molto più rilassata. Mi dispiace se prima vi ho dato l'impressione di essere eccessivamente seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "Abbiamo già risolto la questione più importante. Ora dobbiamo solo occuparci di un'altra faccenda a lungo termine, ossia costruire un punto di osservazione stabile sottoterra da cui tenere sotto controllo ogni cambiamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "Nel frattempo, possiamo aprire parzialmente varie miniere, ma sarà ancora proibito scendere così tanto in profondità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Dobbiamo sigillare quest'area e impedire ai minatori... Anzi, impedire a chiunque di venire quaggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "Ma secondo te io vivo in una galleria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
			]
		},
