			"dialogs": [
				{
					"id": 710702901,
					"content": "Ah, eccoti! Ti do il benvenuto nella base di demolizione della squadra di esplorazione della Voragine. C'è anche un punto di raccolta dell'acqua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702902,
					"content": "La squadra, ossia io, Clitopho, ti rende omaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702903,
					"content": "Dai, vieni a bere qualcosa! Non preoccuparti, offro io! Voglio ripagarti di tutto ciò che hai fatto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702904,
					"content": "E ora cosa farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Beh, ora faccio ufficialmente parte della squadra, quindi finché resteranno gli altri, resterò anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702907,
					"content": "Di sicuro sarebbe tutto più semplice se Khedive e Jinwu riuscissero a mandarmi qualche aiutante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702908,
					"content": "Detto ciò, se lo facessero, non potrei più definirmi l'unico membro e il caposquadra qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702905,
					"content": "Resterai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
