			"dialogs": [
				{
					"id": 710701901,
					"content": "Scusa, mi gira la testa, ma posso farcela! Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701902,
						710701907
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701902,
					"content": "Che ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "Mi piace definirmi un bardo all'antica, e ovviamente sono qui in cerca d'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701904,
					"content": "Beh, fino a poco fa sembravi star bene, mentre ora sembri sul punto di svenire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710701905,
					"content": "Non sono mai sceso in una miniera... E nella fretta di arrivare qui mi sono... stirato un muscolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701906,
					"content": "Ahi, ahi, ahi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701907,
					"content": "Non ti disturberò oltre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Argh... Quest'olio medicinale non mi sta aiutando per niente... Vabbè, torna a trovarmi se hai qualche nuova storia da raccontare! Ci vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
