						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Ciao! Come procedono i tuoi viaggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Bene, e a te come va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Grazie per prima. Dopo che siamo riusciti a creare una miccia per una palla di cannone, hanno tutti iniziato a essere più favorevoli a farmi rimanere qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Non ho ancora pensato bene a cosa farò una volta tornato in superficie, ma probabilmente non mi unirò di nuovo ai Cacciatori di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Probabilmente...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Oh, ehm, volevo dire che di sicuro non mi unirò di nuovo ai Cacciatori di tesori! Sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Abbia cura di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Sul serio...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Quel... *sospira* Eh? Oh, ciao. Scusa, mi stai disturbando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Quindi ora siamo pari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Smettila di infierire. Al momento la situazione non è rosea. Non lo è per niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Hai visto quel frammento di cristallo luminoso, giusto? Se non vado errato, ce ne dovrebbe essere uno più grosso nelle profondità... Ma immagino che tu lo sappia già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "In teoria, i valori si sarebbero dovuti stabilizzare non appena il frammento lassù fosse \"tornato\" alla sua posizione iniziale. Ed effettivamente è quello che è successo, ma... la forma d'onda è completamente sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Di cosa stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Non sei uno studente modello, vero? Te lo spiego semplicemente. Siamo come fagioli in una macina, sull'orlo di essere schiacciati da due potenti forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Per quanto ciò avverrà in tempi molto lunghi, al momento siamo frantumati da due forze, una sopra e l'altra sotto di noi... E presto diventeremo farina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Se non mi credi, aspetta e vedrai. Quell'avventuriera chiamata Zhiqiong... Ho visto cosa succede a chi si avvicina troppo a cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Oggi tossisce sangue, domani potrebbe sputare fuori le proprie interiora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Posso aiutare in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Tu? Ehm, fammici pensare un attimo... Dev'esserci un modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Beh, in ogni caso, al momento la faccenda più urgente che devi sbrigare è quella di continuare a esplorare finché non scopri cos'è successo laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Non preoccuparti, non rimarrò con le mani in mano. Dopotutto, mi devo assicurare di guadagnare qualcosa da questo investimento, quindi farò in modo che la squadra di esplorazione rimanga incolume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Ti prenderai la responsabilità anche per me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Mmmh, beh... Devo ammettere che sei molto più capace di quanto pensassi. Quindi non credo tu abbia bisogno che mi prenda la responsabilità al posto tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Argh, lascia perdere, come non detto... Se ti succederà qualcosa, ti risarcirò, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Cerca di farmi capire, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
