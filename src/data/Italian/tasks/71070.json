				},
				{
					"id": 710702102,
					"content": "Cioè, dai! Mi aveva detto che non si sarebbe più arrabbiata con me... Ma da quando è arrivata all'accampamento, il suo caratterino non è per niente migliorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702103
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702103,
					"content": "Quel tizio, Khedive, sta dicendo a tutti che Zhiqiong è impazzita ed è dovuta andar via dalla Voragine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702104,
					"content": "Eh, sembra che quello a non essere del tutto a posto con la testa sia proprio lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
