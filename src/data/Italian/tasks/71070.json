				{
					"id": 710702702,
					"content": "Continuerò a migliorare la mappa che ho disegnato e aiuterò Jinwu a posizionare i segnalatori, così da osservare il comportamento della sostanza oscura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702703,
					"content": "Dicono che... questa sostanza potrebbe avere qualcosa a che fare con la calamità oscura di cinquecento anni fa. Non è ancora chiaro se sia un residuo o un presagio di qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702704,
					"content": "In ogni caso, grazie per avermi fatto capire i limiti di noi persone comuni e... come inseguire i miei sogni senza superare tali limiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702705,
					"content": "Oh, guarda un po' chi si è trasformata in una filosofa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "Non credo di aver mai pensato nulla di altrettanto profondo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "È solo che... Mi hai aiutata tantissimo mentre io, invece, ho bisogno di te anche per faccende semplici, come disegnare una mappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702708,
					"content": "E ti trascino sempre con me in luoghi pericolosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702709,
					"content": "Non voglio che ti faccia male, tutto qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Sì... Neanch'io mi arrenderò. Mi rimetterò in viaggio non appena mi sarò riposata abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702710,
					"content": "Non preoccuparti. Spero che tu riesca a completare le mappe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
			]
		},
