						710702402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702402,
					"content": "A proposito di Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702403
					]
				},
				{
					"id": 710702403,
					"content": "È tornata indietro perché la mappa riportava degli errori di stampa. Non capisco perché avesse tutta quella fretta... Ma mi fa piacere vederla così allegra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702404
					],
					"speakerTitle": "Jinwu"
				},
