					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "#Allora non ti trattengo oltre. Sappi solo che sarai sempre {F#la}{M#il} benvenut{F#a}{M#o} nella squadra di esplorazione!",
					"roleType": "TALK_ROLE_NPC",
