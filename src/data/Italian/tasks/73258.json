			"dialogs": [
				{
					"id": 732580401,
					"content": "(Continua a leggere...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "#\"...sta benissimo con una ghirlanda di fiori, e l{F#a}{M#o} mette in connessione con tutti quanti. Così, anche {F#lei}{M#lui} è un Aranara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580403,
					"content": "#\"Ora Nara {NICKNAME} e Paimon stanno riposando. Continuo a non capire. Perché Nara devono riposare? Non si possono creare ricordi con amici mentre si riposa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580404,
					"content": "#\"...andando a trovare Ashvattha. Ashvattha accetterà Nara {NICKNAME} e Paimon. Siamo tutti Figli della foresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580405,
					"content": "#\"A ogni modo, nell'Aranyaka ci devono essere molti racconti delle avventure di Nara {NICKNAME}, Paimon e tutti gli altri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580406,
					"content": "#\"Dopo che Nara {NICKNAME} e Paimon avranno preso il Bija e aiutato Narana, chiamiamo Arana e leggiamo le storie dell'Aranyaka!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti scritti male"
				}
			]
		}
