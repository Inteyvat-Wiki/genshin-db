			"dialogs": [
				{
					"id": 732580301,
					"content": "(Continua a leggere...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580302
					]
				},
				{
					"id": 732580302,
					"content": "#\"...Arama ha preparato dei fiori, ma Arama ha paura di non poterli dare a {F#lei}{M#lui}. La paura non è una buona cosa. Come ha detto una volta Arana, se hai paura, credi nel potere della paura...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580303
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580303,
					"content": "\"...Il Festival di Utsava sta per cominciare. Molti amici che Arama non vedeva da tempo sono tornati nel Vanarana. Anche Araja è felice di poter occupare il posto vacante per lui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti scritti male"
				}
			]
		},
		{
			"id": 7325804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
