			"dialogs": [
				{
					"id": 732580201,
					"content": "(Continua a leggere...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580202
					]
				},
				{
					"id": 732580202,
					"content": "#\"...Arama è felice per la conoscenza che Paimon mi ha insegnato. L'incantesimo si è rivelato un tesoro, non spazzatura. Nara {NICKNAME} ha sconfitto Vanagni senza sforzi. Incredibile...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580203
					],
					"speakerTitle": "Appunti scritti male"
				},
				{
					"id": 732580203,
					"content": "#\"...Tutti {F#le}{M#li} amano. Quell{F#a}{M#o} dorat{F#a}{M#o} è come un grande sole e quella d'argento è come una piccola luna, gentile e luminosa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti scritti male"
				}
			]
		},
		{
			"id": 7325803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
