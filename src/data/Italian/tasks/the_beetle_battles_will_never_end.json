			},
			"dialogs": [
				{
					"id": 727310201,
					"content": "Ahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310202,
					"content": "Incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310203,
					"content": "Ahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Sebbene il tuo stile di combattimento sia molto diverso dal mio, la passione che hai riversato sul tuo Onikabuto mi ha fortemente contagiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310206,
					"content": "Col tempo, diventerai un grande campione nel mondo delle lotte tra scarabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310207,
					"content": "Nemmeno tu sei male! Sei riuscito a vincere 570 round su 1.141!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "Di tutte le battaglie tra scarabei che ho combattuto, sei quello che è durato più di tutti! Sarò sincero, sono colpito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "A dire il vero ho vinto 571 round, quindi sono in vantaggio. Tu stai anche giocando in casa. Se tieni conto di questo, devi ammettere che sono meglio di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310210,
					"content": "Eh? Perché devi essere così testardo? La mia memoria non m'inganna, e Mamoru ci è testimone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Vero, Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Capo, io... Non ce la faccio davvero più... Ti supplico, lasciami dormire per un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Uhh... Sono andati avanti per tutto questo tempo senza mai fermarsi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Sono andati avanti per tutto questo tempo senza fermarsi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "L'arena sta per venire giù...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Bene! Visto che sono un tipo generoso, ti concederò un round, no problem! Ti sconfiggerò la prossima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "E se non sei ancora convinto, la prossima volta combatteremo nella tua arena. Ti dimostrerò che il combattente è più importante del posto in cui si combatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Per me va bene. Seguimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310220,
					"content": "Eh? Ehi, compadre e Melonlavanda volante! Siete qui, finalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Un momento, perché chiami di nuovo Paimon \"Melonlavanda volante\"? Paimon merita un bel soprannome solo quando combatte per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "Oh, non pensarci per ora! Eccoti il tuo buono per il ramen gratis per due mesi, come d'accordo. Tieni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Un buono? Oh, già, è vero! Il ramen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Ora sì che si parla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "Festeggiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Oh, no, no, no, no. Era solo il riscaldamento. La Straordinaria, esaltante ed estrema Lotta degli Scarabei di Arataki l'Onnipotente deve ancora cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Dopotutto, senza un pubblico è tutto molto più tranquillo. L'evento non può finire così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "Ma le buone notizie sono che il Granmaestro Hanakado ha finalmente messo da parte il suo orgoglio e ha riconosciuto che sono un combattente fortissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Eppure abbiamo ancora un conto in sospeso. Presto andrò a combattere da lui in trasferta, e lo sconfiggerò una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Quando ciò accadrà, dovrà seguire i miei ordini... E con questo intendo dire che ci aiuterà a rendere la Straordinaria, esaltante ed estrema Lotta degli Scarabei di Arataki l'Onnipotente l'evento più grande e furioso che sia mai esistito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "#Grazie ancora a entramb{F#e}{M#i}. Aspettatemi qui, molto presto vi porterò delle buone notizie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Toro sdraiato sembra davvero divertirsi, e noi abbiamo ottenuto due mesi di ramen gratis, evvai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "È stata una vittoria per tutti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Capo, capo! C'è una lettera da parte di Shinobu. Guarda qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Eh? Dov'è finito il capo? Era qui a combattere un momento fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "Eh? È urgente? Perché Toro sdraiato è appena andato via con il Granmaestro Hanakado. Hanno detto che avrebbero continuato a combattere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Beh, non è urgente, solo un tantino inaspettato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "#Se volete, potete leggere la lettera voi stess{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Che cavolo... Quindi il Granmaestro Hanakado fa davvero parte della Banda di Arataki? Ma il suo... stile di comunicazione ha fatto sentire Toro sdraiato come se stesse affrontando un nemico mortale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Proprio come pensava Shinobu, Toro sdraiato sta trascorrendo il tempo a combattere senza riposarsi né mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Ma ci ha chiesto di organizzare l'evento della Lotta degli Scarabei per lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "Non lo definirei comunque risposare in senso stretto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Paimon pensa che Shinobu si meriti il buono del ramen più di noi! Perché non la portiamo a mangiarne un po', quando torna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Mmm... Anzi, aspetta un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Toro sdraiato non ci ha detto in quale bancarella di ramen sia valido quel buono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "...Dovremmo trovarla noi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Tutti sono felici, e questa è l'unica cosa che conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "E l'estrema Lotta degli scarabei è finita!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Gli Onikabuto saranno esausti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
			"id": 7273107,
			"completionStepIds": [
				7273101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273101",
							"2"
						],
						"stepId": 7273101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273104",
							"2"
						],
						"stepId": 7273104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Granmaestro Hanakado",
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "Capisco, capisco... Combattiamo ancora. Stavolta prevederò ogni tua mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310702,
					"content": "La vittoria e la sconfitta non sembrano più avere importanza... Combattiamo per divertimento, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310703,
					"content": "Incontrare un avversario tanto notevole è una cosa rara. Concludere le nostre battaglie così presto sarebbe un peccato, non trovi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 727310704,
					"content": "Certamente! Fatti sotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "Ma prevedere le mie mosse segrete? Naa, amico mio, questo puoi scordartelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "Se ammetterai che sono il combattente più forte, ti sfiderò per tutti i round che vorrai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Uff, pare che Toro sdraiato e il Granmaestro Hanakado siano ancora impazienti di combattere... Ok, lasciamoli fare! Che combattano quanto vogliono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}