				{
					"id": 4880301,
					"content": "#Grazie mille. Pensavo di essere davvero finito nei guai, questa volta. Meno male che siete venut{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880302
