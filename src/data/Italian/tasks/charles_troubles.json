			"dialogs": [
				{
					"id": 4880101,
					"content": "Ecco dov'era finita la consegna di Charles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "Siete qui per salvarmi? Ne ho abbastanza di aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Questa è la prima volta, in tanti anni di duro lavoro nel Vigneto, che sono stato derubato dagli Hilichurl. *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Se non mi aveste trovato subito, non so cosa avrei fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Non ti preoccupare, {NICKNAME} è {M#un formidabile sterminatore}{F#una formidabile sterminatrice} di Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Meglio così. Allora... Potreste scortare questo <color=#00E1FFFF>trasportatore</color> fino alla fine della strada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Fate attenzione. Il vostro obiettivo non è solo sconfiggere gli Hilichurl, ma anche di <color=#00E1FFFF>fare in modo che la merce resti intatta</color>. Anche perché non ho i Mora necessari per acquistarne altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "Vi attenderò a destinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
