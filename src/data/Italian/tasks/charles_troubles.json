			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa? Sei qui per la dichiarazione dei redditi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Oh, salve tesoro. Sì, proprio così. Dopo aver saputo della povera Jean, ho pensato di assistervi con i compiti che richiedono una maggiore erudizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Ottimo! Beh, se allora non c'è più bisogno di noi, ce ne andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Oh, aspettate un attimo. A dire il vero, Charles si chiedeva se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Lasciate che sia io a spiegarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Ho appena accettato un ordine molto importante, ma sfortunatamente abbiamo terminato i nostri prodotti e la merce che ho richiesto dal Vigneto è in ritardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Se la cosa non vi disturba, potreste <color=#00E1FFFF>fare qualcosa per risolvere questo intoppo logistico</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Cos'ha di tanto urgente quest'ordine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*sospira* È arrivato all'ultimo momento, proprio qualche secondo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Esatto, ecco perché è urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "D'accordo, vedrò cosa possiamo fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "D'accordo, ma la prossima volta dovrai offrirmi qualcosa da bere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Heh... Credo che il mio capo, patron Diluc, sarà ben contento di offrirti qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "Mi pare più che giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
