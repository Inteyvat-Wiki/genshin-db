			"dialogs": [
				{
					"id": 732441901,
					"content": "Condensatori per la trasformazione energetica... Spero che Benben si riprenderà una volta che li avremo trovati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "#Se non siete sicur{F#e}{M#i}, posso venire con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "È meglio se rimani qua con Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Va bene. Aspetto buone notizie... Mi raccomando fate attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Faremo in fretta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
