						732441506
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441506,
					"content": "Benben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441507
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441507,
					"content": "Benben si collega ai Condensatori per la trasformazione energetica ed estrae l'energia.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732441508
					]
				},
				{
					"id": 732441508,
					"content": "Bip bip! Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "Wow! Abbiamo resuscitato Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "Non dire sciocchezze, Paimon. Benben si è solo svegliato da una lunga dormita, tutto qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441511,
					"content": "Bip... Biiip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Ehi, non ero preoccupata! Sapevo che ti saresti ripreso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441513,
					"content": "Umpf. \"Non voglio metterlo in pericolo di nuovo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "Non farmi il verso, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441515,
					"content": "Bip bip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#Oh, sì! {NICKNAME}, Benben ti ringrazia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Anche se Benben era immobile a terra senza dire nulla, sa benissimo che l'hai aiutato tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "Non c'è bisogno di ringraziarmi, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Anche se Benben si è risvegliato, sembra che un po' di riposo non gli farebbe male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441523,
					"content": "Giusto! Riposati per bene, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "Bip bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benben"
				}
			]
		},
