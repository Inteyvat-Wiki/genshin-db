			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "Come... Come ho potuto dimenticarmene...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440102,
					"content": "Spero che non sia troppo tardi. Dobbiamo almeno cercare vicino alla sua tenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440103,
					"content": "Jeht! Che succede? Vai da qualche parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon e {NICKNAME}... Appena in tempo. C'è una cosa che devo fare ora... Sto andando a casa di Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440105,
					"content": "Aderfi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "Non è quel traditore che aveva complottato con i Fatui? Oh, Paimon ha capito! Vuoi vedere se si è lasciato dietro qualcosa di utile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "No, non mi interessano per nulla le sue cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440108,
					"content": "La tribù ha delle regole su come gestire gli oggetti dei traditori come Aderfi. Umpf... se non fosse per queste regole avrei già bruciato tutto non appena possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440109,
					"content": "Vado alla sua tenda perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440110,
					"content": "Per Benben, dico bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "Ohh! Oh, no! Benben è ancora da Aderfi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Jehhht...! Perché hai lasciato Benben con qualcuno come lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "N-Non sapevo fosse un traditore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440114,
					"content": "In ogni caso, devo sbrigarmi, devo andare a vedere come sta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, andiamo con lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "Non c'è un momento da perdere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Sì... Paimon spera che Benben stia bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "Andiamo subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Ehi, guarda, c'è qualcosa qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "A Paimon non sembrano documenti d'indagine. Sembra più... una specie di lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "Una lettera? Apriamola e vediamo cosa c'è scritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "La lettera dice che Benben è semplicemente a corto di energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "Ora che Paimon ci pensa, Benben ha aperto le porte del Mausoleo di Re Deshret per noi e ci ha dato le autorizzazioni... Ci ha aiutato un sacco durante il nostro viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "E anche le creature meccaniche come Benben si stancano. Forse ha finito l'energia dopo averci aiutato così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "Questa lettera parla di qualcosa che si chiama \"Condensatori per la trasformazione energetica\", ma non ho visto nulla del genere nella tenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Che siano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "...nascosti da qualche parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Non penso sia così. Se erano appositamente per riparare Benben perché avrebbe dovuto nasconderli? Non sarebbe stato più intuitivo usarli subito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "Aha, ma certo! È perché lo scambio non è ancora avvenuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi non ha portato Benben allo scambio, quindi non dovrebbe esserci alcun Condensatore per la trasformazione energetica qui... C'è ancora una cosa che non mi è chiara: con chi avrà fatto l'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Ah, che domanda stupida da porsi. C'è solo un gruppo con cui potrebbe aver fatto accordi del genere al difuori della tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "I ricercatori di Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Sono i Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "Cosa dovremmo fare ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "Cos'altro potremmo fare? La negoziazione con i Fatui non si farà: andremo lì e ruberemo i Condensatori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "Woohoo! Sì, rubiamoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "Ma Benben... non possiamo portarlo con noi in quello stato, non possiamo portarlo al luogo del negoziato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "Anche lasciarlo qui da solo non è sicuro. Non voglio metterlo in pericolo di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Paimon e {NICKNAME} andranno ad affrontare i Fatui! Tu aspetta qui con Benben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Si!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Sì! Assaltiamo i Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#Vorrei davvero andarci io stessa, ma... {NICKNAME}, Paimon, conto su di voi per aiutare Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "E... anche se sono solo un manipolo di Fatui, fate attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Non preoccuparti! Lascia fare a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "Non mi va di stare con Benben nella tenda di questo traditore. Lo porterò da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Incontriamoci alla mia tenda quando avrete recuperato i Condensatori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "Andiamo ad assaltare i Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Sisì! Non è neanche la prima volta che lo facciamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "I Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Esattamente, chi altri sennò?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "Potrebbe non averli mai ricevuti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ah, ho capito cosa intendi! Lo scambio non è ancora avvenuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				}
			]
		},
