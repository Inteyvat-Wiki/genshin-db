			"dialogs": [
				{
					"id": 732440801,
					"content": "Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440803,
					"content": "#Com'è andata? Non vi siete mess{F#e}{M#i} nei guai, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440802,
					"content": "È andato tutto come previsto! Guarda! Abbiamo recuperato i Condensatori per la trasformazione energetica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324419",
							"2"
						],
						"stepId": 7324419,
