			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "B-Basta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441702,
					"content": "Pietà... Ci rimetteremo la pelle se continuate così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441703,
					"content": "Sembra convincente, detto da uno che le sta prendendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Parla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Sputa il rospo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "V-Va bene, vi dirò tutto! Tutto quello che volete sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441707,
					"content": "Comincia da dove ti pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "A-Abbiamo sempre avuto accordi con Aderfi... E sembra che alla Matriarca non piacessero Azariq... e la nuova ragazza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441709,
					"content": "E non so perché, ma sembra che anche Azariq sia sparito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441710,
					"content": "Quella donna è spietata. Considera chiunque non sia più utile alla tribù come un peso morto da gettare via... e Aderfi si è messo in contatto con noi per mantenere il suo status.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441711,
					"content": "I nostri affari nell'area del deserto non sono mai andati come previsto... fino a quando non abbiamo stretto un accordo con Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441712,
					"content": "Chiunque non sia più utile... cosa significa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "Non lo so... Davvero non lo so! Deve avere a che fare con questioni interne alla gente del deserto... Ma azzardando un'ipotesi, forse pensava che non fossimo più degni di fiducia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441714,
					"content": "Così ha cominciato a prendere le distanze da noi, e Aderfi, che è sempre stato in contatto con noi era davvero afflitto dalla situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441715,
					"content": "In fondo, noi possiamo sempre lasciare questo brutto posto quando vogliamo. Ma Aderfi, al contrario, verrà usato dalla tribù fino a quando non sarà più \"utile\". La sua vita appartiene praticamente a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441724,
					"content": "Ma era estremamente astuto. In qualche modo ci ha fatto esaudire ogni sua richiesta, mentre noi, dal canto nostro, non abbiamo mai avuto notizie degli oggetti che avevamo chiesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441725,
					"content": "E ora pare che si sia cacciato in una brutta situazione... Non eravamo sicuri di cosa fosse successo, ma l'abbiamo vista come un'opportunità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441726,
					"content": "Un'opportunità per cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "Abbiamo pensato che non avremmo avuto molte opportunità per fare affari con Aderfi in futuro, quindi gli abbiamo chiesto di portare quello speciale Costrutto primordiale che aveva menzionato nelle lettere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441728,
					"content": "Se fossimo riusciti a metterci le mani sopra prima di lasciare per sempre questo posto, avremmo comunque guadagnato qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441729,
					"content": "Uh, quindi anche voi siete qui per rubare cose? Ecco perché non riuscivamo a trovare nulla, tantomeno i Condensatori per la trasformazione energetica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Aspetta... Hai appena detto \"anche voi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441731,
					"content": "Sì. E ora fuori i Condensatori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Argh... Non dirai a Paimon che i Condensatori per la trasformazione energetica non esistono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "No. Esistono per davvero, ce n'è un'intera partita. Sembrano essere reliquie antiche, quindi non è sicuro che funzionino ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441735,
					"content": "Dicci dove sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Continua con questo tono, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Eheh, Paimon lo farà! ...Ehi, {NICKNAME}, non cambiare discorso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Avanti! Diteci dove sono i Condensatori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "...Sono in una struttura non lontana da qui. Questa è la chiave per entrare... Ho detto tutto ciò che so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441740,
					"content": "Allora muoviamoci!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Va bene, va bene, me ne andrò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441741,
					"content": "E non farti più vedere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "Siete cascati male a incontrare noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "Questi \"affari\" che fate nel deserto... in cosa consistono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "...Sono informazioni riservate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#Vedi, ora {NICKNAME} è infuriat{F#a}{M#o}! Vuoi davvero vedere cosa potrebbe succederti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Uff...! Va bene, va bene! Per favore non arrabbiarti, te lo dirò! Ma non... non conosco tutta la storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441721,
					"content": "Ci hanno chiesto di investigare sulla situazione delle diverse tribù del deserto. Dopo esserci infiltrati tra di loro facendo affari volevamo attirare l'attenzione dei saggi... e aiutare il Lord Messaggero nella Città di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441722,
					"content": "Il professor Froderock stava cercando degli esemplari vivi nel deserto, tenta sempre di opporsi agli ordini del Luminare... È tutta una questione di gelosia, se ci tenete a saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Negoziatore dei Fatui"
				},
				{
					"id": 732441723,
					"content": "Ahem, sto divagando... In ogni caso, Aderfi era il nostro aggancio ed è stato messo a gestire tutto quello che era collegato agli scambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Negoziatore dei Fatui"
				}
			]
		},
