			},
			"dialogs": [
				{
					"id": 221150601,
					"content": "*sospira* Oh, Piccolo Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Chang il Nono è tornato sano e salvo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Sì, ho visto! Grazie di cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Si comporta così fin da bambino... Corre via e si caccia nei guai, poi protesta definendosi un adulto... In realtà, temo non crescerà mai davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150605,
					"content": "A ogni modo, nulla di cui dobbiate preoccuparvi. Il Piccolo Chang fa sempre di testa sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Grazie per i vostri sforzi nel riportarlo a casa. Ho qui qualcosa per ringraziarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Non vi tratterrò ulteriormente, immagino abbiate molte cose da fare. Però... mi raccomando, non fate come il Piccolo Chang. Si preoccupa troppo di come lo vedono gli altri, ma non si ferma mai a guardare dentro sé stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150608,
					"content": "Ahimè, gli umani non sono come gli Adepti... La vita mortale è solo una breve sofferenza che precede la morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				}
			]
		},
