				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*sospira* Voglio scrivere un romanzo coi fiocchi... Ma come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150502,
					"content": "Ti sono cadute queste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Eh? Oh sì, sono mie. Non mi piaceva ciò che avevo scritto, quindi le ho gettate nel fiume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150504,
					"content": "Le avete raccolte tutte? Non ci credo... A ogni modo, ormai le parole si leggono a malapena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150505,
					"content": "Cosa stavi scrivendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Una storia per una bambina che conoscevo da piccolo. Queste sono le bozze che ho scartato. Eh... Quella piccola peste era incredibile, mi chiedeva di continuo di leggerle qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150507,
					"content": "Purtroppo, all'epoca non trovavo mai il tempo di scrivere. Ho solo buttato giù l'introduzione di un racconto, nella speranza di finirlo più avanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150508,
					"content": "Un giorno, però, lei è sparita. Non sono riuscito a trovarla da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150509,
					"content": "Sono sicuro sia successo per via della sua famiglia. Non li stavo simpatico e non volevano aver nulla a che fare con me. In pratica, alla prima occasione utile hanno abbandonato in sordina il Villaggio di Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150510,
					"content": "Presto però gliela farò vedere io! Non appena mi sarò fatto un nome, mi vedranno con occhi diversi! La storia che finirò di scrivere per lei verrà venduta in tutto il mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150511,
					"content": "Non so dove si siano cacciati, ma le notizie sul mio conto li raggiungeranno, così capiranno che non sono più lo stesso Chang il Nono di una volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150512,
					"content": "E infine potrò... Potrò vederla nuovamente. Ma andiamo con ordine... Prima devo finire la storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150513,
					"content": "Ehm... Scusami, mi sono messo a snocciolarti tutta la mia vita! Farei meglio a rimettermi al lavoro sul libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
