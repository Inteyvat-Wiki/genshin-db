			"trigger": {
				"objectNames": [
					"Nonna Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "*sospira* Torna a casa, Piccolo Chang... Inizio a preoccuparmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Chi è il Piccolo Chang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Oh... È solo un nomignolo che ho dato a Chang il Nono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150104,
					"content": "Sono così abituata a chiamarlo Piccolo Chang che trovo strano dire \"Chang il Nono\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Ieri notte ha detto che sarebbe uscito a fare alcune ricerche per il suo libro. Non ci ho dato molto peso, mi sono limitata a raccomandargli di non fare tardi, come faccio sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Però non è ancora tornato. Sono preoccupata, temo possa essergli successo qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Sono troppo vecchia e fragile, non posso andare di persona a cercarlo. Potreste farlo voi al posto mio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Splendido, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Dove si è diretto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*sospira* Va sempre nello stesso posto, sulla Collina di Wuwang a nord di qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Andate a cercarlo, per favore. Fatelo per me. È via da così tanto tempo, spero non gli sia successo nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
