			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Bah! Maledetti mostri... Che esseri spaventosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150202,
					"content": "Cercavo solo un pochino d'ispirazione per il mio romanzo, e invece mi sono ritrovato circondato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150203,
					"content": "Grazie per l'aiuto. Non credo che ce l'avrei fatta, senza il tuo intervento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150204,
					"content": "Nonna Ruoxin è molto preoccupata per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Davvero? Non ce n'è bisogno, so badare a me stesso. Messo alle strette, di sicuro me la sarei cavata anche contro quegli esseri... Sarebbe stata una scocciatura, quello sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 221150206,
					"content": "#Nonostante ciò, sono felice che tu sia arrivat{M#o}{F#a}, così ho velocizzato l'operazione. Almeno stavolta non si lamenterà che ci ho messo troppo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
