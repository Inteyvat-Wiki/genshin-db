			"dialogs": [
				{
					"id": 721570101,
					"content": "Eh? Dov'è la Pietra protettiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570102,
					"content": "Mmmh, a quanto pare non sarà facile come pensavamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570103,
					"content": "Diamo un'occhiata in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "Sì, sembra che sia la nostra unica opzione. Vediamo se troviamo qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570105,
					"content": "Ma questo posto è enorme! Per quanto tempo dovremo cercare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570106,
					"content": "Beh, immagino sarà una questione di fortuna. In ogni caso, è ora di cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570107,
					"content": "Sembra che trovare le Pietre protettive sia un ulteriore ostacolo al sigillarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570108,
					"content": "Beh, speriamo di trovare qualche indizio nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570109,
					"content": "Andiamo, Taisuke. Non abbiamo tempo da perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "Etsuko"
				},
				{
