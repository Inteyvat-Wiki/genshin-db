	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Mmmh... Evocare la poesia con la pittura, o dipingere con poeticità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Mmmh... Ma queste frasi non vogliono dire la stessa cosa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Di cosa stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Oh, salve. Esatto. Sto cercando di scrivere una poesia sul paesaggio di Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Però... Onestamente, i paesaggi qui sono molto diversi da quelli di Liyue. Non conosco nemmeno la storia locale, quindi non so proprio da dove cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Inoltre, non scrivo poesie e rime per professione... Né ho mai composto nemmeno una filastrocca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "*sospira* Ma non posso tornare a mani vuote. I miei colleghi del Ministero degli Affari Civili mi prenderanno in giro. \"Stavi davvero cercando ispirazione là fuori, oppure solo respirazione?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Lavori al Ministero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Sì... Più o meno. Qualche tempo fa mi hanno chiesto di svolgere delle indagini sul campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "*sospira* In pratica, portavo le persone in giro per Liyue a vedere se l'acqua e il terreno fossero cambiati, se le mappe dovessero essere aggiornate e così via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Mi è bastata una volta sola per tornare a casa a pezzi e con le scarpe consumate... Perciò ho deciso di prendermi una vacanza. Avevo bisogno di cambiare ritmo, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "È solo che... Non so cosa mi sia passato per la testa, ma quando ho chiesto le ferie, questa è stata la mia motivazione: \"Mi è venuta voglia di comporre poesie. Vado a cercare ispirazione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Non pensavo che il responsabile dei congedi avrebbe risposto in modo tanto serio, con un \"che tu possa ottenere la possanza poetica\"... Concedendomi oltre due settimane di permesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Non è una cosa buona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Così si direbbe... Se non fosse che ora tutto il Ministero sa perché sono in ferie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*sospira* È stata un'esperienza divertente, non c'è dubbio. Il paesaggio è bello, il cibo è delizioso e ci sono molti animali interessanti, soprattutto i cuccioli di Saurico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Ma non mi è venuto in mente nemmeno un verso. Neanche uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Ho persino preso in prestito una Fotokamera per trovare ispirazione, ma non è servito a molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Me la cavo bene con i paesaggi naturali, ma lasciamo perdere i negozi e le persone: quegli scatti sono assolutamente inguardabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Posso darti una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Vorresti aiutarmi? Oh, grazie al cielo... Devo assolutamente trovare un po' d'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Me la cavo benissimo a scattare foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "E hai raggiunto questa fantomatica possanza poetica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Per niente, ma la notizia delle mie ferie e del perché le ho prese si è diffusa in lungo e in largo. Ora tutti al Ministero sanno il motivo del mio viaggio a Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Stai scrivendo delle poesie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
