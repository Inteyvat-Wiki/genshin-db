			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Ah, giusto! Ho sentito dire che i negozi del Popolo delle Sorgenti espongono insegne molto particolari, tra cui quella degli \"Studi Djembe\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Scatta una foto per me di quello studio durante le prime ore del mattino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
