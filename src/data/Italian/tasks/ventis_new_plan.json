			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "Non ha funzionato... Lo sapevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "Come, lo \"sapevi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Volevo solo verificare quanto fosse influente {NICKNAME}, l'asso dei Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "Di solito, il guerriero migliore viene sempre presentato con la migliore delle spade. Invece, ci ritroviamo in questa situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "Non pensi che questa storia sia perfetta per una ballata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "Cosa stai cercando di dire? Che non siamo abbastanza per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "No, anzi. Volevo solo commentare l'incapacità di Mondstadt nel riconoscere il grande guerriero che si erge davanti ai suoi occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Molto bene. A quanto pare non potremo prenderla in prestito. Non ci resta che rubarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Oggi siamo qui in nome del libero arbitrio! Qualche consiglio su come rubarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "Non voglio rubare nulla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Forza, parlate. A che serve il libero arbitrio, sennò?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "Ahahah, ma guardati. Siamo solo all'inizio e già ti fai da parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "Ma dico seriamente, puoi completare l'incarico meglio di quanto non possa farlo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "Io non ho alcun talento, oltre alla voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "E in più, se venissi scoperto e arrestato ingiustamente, nessuno prenderebbe le mie parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "Come puoi essere \"arrestato ingiustamente\" se ti beccano con le mani nel sacco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Ma per {NICKNAME} è diverso: tu sei la stella dei Cavalieri di Favonius. Il tuo contributo nei confronti di Mondstadt è stato di grande valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Se ti dovessero beccare, non dovresti avere difficoltà a convincere tutti che c'è stato un errore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Sembra che le guardie non siano in servizio, di notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Se riusciamo a cogliere questa opportunità, il resto sarà un gioco da ragazzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "Smettila di parlare di cosa succederebbe se ci beccassero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Scusa... Un attimo... Hai appena detto... di essere Barbatos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}... Cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "Ah, sì. A quanto pare l'ho detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Se sei davvero un dio, non possiamo abbandonarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Perché la tua decisione si basa sul fatto che io sia un dio o meno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "E se non sei un dio, aiuterò comunque Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Paimon ti racconterà del passato di {NICKNAME}, quando avremo il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Ti porterò la Lira sacra celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Non voglio assistere a un'altra separazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
