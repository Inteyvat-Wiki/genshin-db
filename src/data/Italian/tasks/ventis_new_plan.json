					"content": "Che rottura dover restare qui tutto il santo <color=#00E1FFFF>giorno</color> a guardia di questa entrata.\\nEhi! Non ti muovere! È vietato andare laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "A quanto pare, per intrufolarci dovremo aspettare che <color=#00E1FFFF>faccia buio</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
