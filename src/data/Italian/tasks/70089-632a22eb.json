			"dialogs": [
				{
					"id": 700890101,
					"content": "Oh, c'è qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Neanche questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890103,
					"content": "Ehi, che stai facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Sto cercando di tornare sui miei passi. Ricordo solo che devo trovare una Statua dell'Archon di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890105,
					"content": "Non ricordo nient'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890106,
					"content": "Sui tuoi passi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Avverto come una vaga nostalgia di casa, ma non riesco a ricordare assolutamente nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890108,
					"content": "Quando mi sono svegliato, l'unica cosa che avevo era un biglietto in mano con su scritto \"Tu sei 'Maukie'\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890109,
					"content": "Quindi suppongo che il mio nome sia Maukie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890110,
					"content": "Ora devo andare. Arrivederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890111,
					"content": "Che tipo strano, ma non sembra cattivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "Stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "Ho avuto una strana visione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Una strana visione? Forse perché quella persona ha toccato la statua poco fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
