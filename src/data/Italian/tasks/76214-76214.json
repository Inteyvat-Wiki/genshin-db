			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Bau? Cosa c'è, {F#signorina viaggiatrice dorata}{M#signor viaggiatore dorato}? Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Signorina Barboncino nobildonna"
				},
				{
					"id": 762140302,
					"content": "A nome del signor Gatto Grigio, porgi un invito al ricevimento alla signorina Barboncina nobildonna...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Oh? È già ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Signorina Barboncino nobildonna"
				},
				{
					"id": 762140304,
					"content": "Grazie, bau! Se non fossi stata così impegnata, sarei andata a invitare la signorina Soriana personalmente... Se l'avessi fatto, forse il signor Gatto Grigio avrebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Signorina Barboncino nobildonna"
				},
				{
					"id": 762140305,
					"content": "Gatti o cani, siamo tutti capaci di andare d'amore e d'accordo... Sì, proprio così. Ad ogni modo, ora devo recarmi al ricevimento. Grazie per il promemoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signorina Barboncino nobildonna"
				}
			]
		},
