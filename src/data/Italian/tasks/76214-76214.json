			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "Miao... La tua abilità con la spada... è veramente notevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Signorina Soriana"
				},
				{
					"id": 762140209,
					"content": "#Ti ringrazio, {F#stimata}{M#stimato} cavaliere proveniente da lontano. Quei bruti non disturberanno mai più le case della mia gente con la loro arroganza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Signorina Soriana"
				},
				{
					"id": 762140210,
					"content": "Ordunque... cosa ti porta alla mia corte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Signorina Soriana"
				},
				{
					"id": 762140202,
					"content": "\"Corte\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Uhm... Essendo questa una fiaba, deve far parte di quel mondo fiabesco, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "A nome del signor Gatto Grigio, porgi un invito al ricevimento alla signorina Soriana...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Signorina Soriana"
				},
				{
					"id": 762140208,
					"content": "#...Capisco e ti ringrazio, {F#stimata}{M#stimato} cavaliere proveniente da lontano. Seguirò il tuo saggio consiglio e m'incamminerò seduta stante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signorina Soriana"
				},
				{
					"id": 762140204,
					"content": "Maestà, sono qui per il rapporto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Ahem, qualcuno si è adattato in fretta! Si vede che quando si è \"all'estero\" ci si adegua alle usanze locali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
