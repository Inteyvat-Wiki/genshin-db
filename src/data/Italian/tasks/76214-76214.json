					}
				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Miao... È già ora del ricevimento, miao. Mi chiedo se si siano perse, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140102,
					"content": "#Oh, sei tu, {F#signorina viaggiatrice dorata}{M#signor viaggiatore dorato}. Devi essere l'eroe prescelto, miao! Mi aiuteresti a cercare le mie amiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140103,
					"content": "Chi sarebbero queste tue amiche...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Oh, e delle due signore che non sono ancora qui, una è un micio che sa parlare proprio come me. Ma a differenza mia, lei è una gatta soriana, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140107,
					"content": "L'altra amica è una barboncina nobildonna molto educata. È un canino, sì, ma è comunque molto raffinata, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140108,
					"content": "Anche se una di loro è un gatto e l'altra è un cane, ogni volta che ci sediamo a prendere il tè passiamo sempre dei momenti meravigliosi, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140109,
					"content": "Ti prego, per la pace di Miaopolis, dammi una zampa, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signor Gatto Grigio"
				},
				{
					"id": 762140104,
					"content": "Wow, al giorno d'oggi è davvero facile diventare un \"eroe\", eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Oh, non cavilliamo troppo sui dettagli, miao. Se hai già la Spada sacra leggendaria, sei un eroe, che tu trovi il Puro Graal di cui parlano oppure no, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Signor Gatto Grigio"
				}
			]
		},
		{
