			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee dice che hanno scoperto alcuni misteriosi binari che puoi percorrere usando una \"Navetta Flapflap super divertente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, anche io ne ho sentito parlare. A quanto sembra è una navetta che fa una corsa \"terrificante\" a una velocità \"incontrollabile\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Sì, dovrebbe essere quello. Quando la nnavetta scende per una ripida discesa, il tuo corpo comincia a fluttuare come se fosse privo di peso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Davvero? Uh, ho sentito che lo zaino di Klee è quasi volato via. Se Kaeya non l'avesse afferrato al volo, sarebbero volati per aria moltissimi Conigli Bumbum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Oh no, sembra piuttosto pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*sospira* Ma se proprio ci tieni a fare una corsa, ti ci accompagno quando ho tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Eh? Ma Eula, come facevi a sapere che...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "L'ho notato subito... Ma fammi mettere in chiaro una cosa, non ti aiuterò a prendere niente che voli via durante la corsa. Quindi assicurati di non avere nulla in tasca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ah, sì, certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
