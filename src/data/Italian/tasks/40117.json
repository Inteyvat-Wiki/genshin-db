				{
					"id": 401171501,
					"content": "Chi l'avrebbe detto che mi sarei cacciata in questo pasticcio... Uff, dopo tutte quelle chiacchiere con Alice sul portare in visita sua figlia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "Ma come ha detto la Generale... Se riusciremo a ripristinare il dominio, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
