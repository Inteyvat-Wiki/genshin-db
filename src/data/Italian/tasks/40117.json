			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Ehi Kaeya, hai promesso di raccontarmi la storia della djinn in bottiglia se non fossi scappata. Ti ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah, sì. Bene, dov'ero rimasto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Oh, mi ricordo! La djinn era uscita fuori e stava per divorare il giovane pastore che aveva aperto la bottiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Giusto, come la djinn aprì le sue larghe e minacciose fauci, il giovane pastore, improvvisamente, ebbe un'idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Lanciò un Coniglio Bumbum nella bocca della djinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Ahah, sono sicuro che avrebbe fatto così se avesse avuto un Coniglio Bumbum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Ma il giovane pastore non aveva niente del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Disse alla djinn: \"Aspetta, come faceva il tuo corpo enorme a stare dentro una bottiglia così piccola? Se non lo vedessi con i miei occhi non ci crederei mai!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "La djinn si arrabbiò e disse: \"Muahaha. Stupido ragazzo, osi mettere in dubbio i miei poteri?!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "La djinn tornò nella bottiglia e il ragazzo si affrettò a chiuderla velocemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Sììì! Così la djinn malvagia non potrà più uscire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Ma, come fa la djinn a dormire in una bottiglia così piccola? Probabilmente non è molto comoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "No, ma la djinn era stata catturata e sigillata nella bottiglia perché aveva fatto molte cose cattive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Quindi la cosa più importante da ricordare è che, se fai qualcosa di cattivo e non vuoi essere rinchiusa, non farti mai catturare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
