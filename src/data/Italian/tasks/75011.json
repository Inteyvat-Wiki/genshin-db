			"dialogs": [
				{
					"id": 750110201,
					"content": "Fiuuu, questo dovrebbe essere l'ultimo meccanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Non è diverso dagli altri. Chikya, sicura di non essere stata ingannata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "Certo che no! Quando si tratta di decifrare antichi rotoli, sono molto sicura... Sono abbastanza sicura... Insomma, ho un po' di fiducia nelle mie capacità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110205,
					"content": "La tua fiducia si riduce di secondo in secondo! Aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Sia come sia, sono abbastanza sicura che questo sia l'ultimo meccanismo. Se ricordo bene, dovrebbe essere più grande e... completo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110207,
					"content": "\"Isole fluttuanti\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "#{F#Giovanotta}{M#Giovanotto}, a prescindere dalle tue grandi potenzialità, nessuno ti capirà se non finisci le frasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110209,
					"content": "Se il tesoro e l'elisir esistono davvero... Beh, lo sapremo solo quando avremo provato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110210,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Se questa volta non funziona, funzionerà la prossima. Se non qui, da un'altra parte. Continuando a provarci, prima o poi accadrà un miracolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110212,
					"content": "Il tuo ottimismo non conosce limiti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "Lo prenderò come un complimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110216,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Eheh, guardate, anche {REALNAME[ID(2)|SHOWHOST(true)]} è molto emozionato. Forza, {NICKNAME}, usa il Flogisto per attivare il meccanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110214,
					"content": "Sarà un miracolo non perdere la motivazione per continuare a provare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "Non c'è posto per il pessimismo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				}
			]
		},
