			"dialogs": [
				{
					"id": 750110301,
					"content": "Ma guarda un po'! Un'isola nascosta al centro del Sanctum superiore... *sospira* E io che mi chiedevo perché avesse un aspetto così diverso da quello che avevo visto nelle immagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110302
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110302,
					"content": "Posso ancora contare sulla mia memoria, dopotutto. Se così non fosse, non sarei la responsabile della cura di tutti quei rotoli antichi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110303
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110303,
					"content": "Ma, a parte quella roccia ancora più grande al centro, non c'è nient'altro... Che sia quella il leggendario dono del Saggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110304,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110305,
					"content": "A questo punto, sono genuinamente confusa. In tutti i rotoli che ho visto, quando gli eroi superano la prova e raggiungono questo posto, dovrebbero percepire lo spirito del Saggio della Fiamma rubata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110306
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110306,
					"content": "Se raggiungi questo posto superando la prova, dovresti sentire una sorta di invocazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110307
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110307,
					"content": "Ma non ho idea di cosa significhi. Credevo che sarei stata in grado di capirlo una volta arrivata qui, che avrei potuto... *sospira* Mi ero semplicemente illusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110308
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110308,
					"content": "Roar... Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110309,
					"content": "#Oh... {REALNAME[ID(2)|SHOWHOST(true)]}, riesci a vederlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110310
					]
				},
				{
					"id": 750110310,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110311,
					"content": "Quindi... Sai cosa vuol dire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110312
					]
				},
				{
					"id": 750110312,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110313,
					"content": "#Hai visto qualcosa? Hai visto qualcosa?! Non ci posso credere! Quindi la persona che si meritava il dono eri tu, {F#giovanotta}{M#giovanotto}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110314
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110314,
					"content": "Eh? Anche Paimon non ha visto niente... Che strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110315,
					"content": "Ho visto un motivo dorato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110316
					]
				},
				{
					"id": 750110316,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110317,
					"content": "#Un motivo dorato? Intendi uno come quello che hai visto quando abbiamo incontrato {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110318,
					"content": "Aspetta, Paimon pensava che avessi le allucinazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110319,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110320,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, dire a Paimon di guardare in alto è inutile, perché Paimon non lo vede! Ma visto che hai detto che è lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110321,
						750110322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110321,
					"content": "Anche la voce sembra familiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				},
				{
					"id": 750110323,
					"content": "Quindi forse è stato il Saggio della Fiamma rubata a lasciarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110324,
					"content": "Cosa?! Mi state dicendo che avete ricevuto un segno dal Saggio della Fiamma rubata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110325
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110325,
					"content": "#Ho detto che avevi un ottimo futuro davanti a te, {F#figliola}{M#figliolo}, e cosa c'è ora davanti a te, se non un futuro radioso? Sapevo che avevi grandi potenzialità, altrimenti non ti avrei preso sotto la mia ala! Hai capito come ricevere il dono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110326
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110326,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110327,
						750110328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110327,
					"content": "Sì, devo solo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110329,
					"content": "La stele di pietra comincia a riecheggiare con un forte rimbombo.\\nMentre la terra trema, la roccia gigante rivela la sua vera forma...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750110328,
					"content": "(Protendi la mano verso la stele di pietra gigante...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110322,
					"content": "È sicuramente la stessa persona che ha lasciato quel motivo dorato prima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				}
			]
		},
