					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "Questa piccola sfera... sembra un componente o qualcosa del genere. Ti piace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090203,
					"content": "Roar... Groooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Anche se non l'abbiamo dissotterrata noi, visto che l'abbiamo trovata qui... Potrebbe comunque rivelarsi preziosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090205,
					"content": "Chiediamolo quando ce ne andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
