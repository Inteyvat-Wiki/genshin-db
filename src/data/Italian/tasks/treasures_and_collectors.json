			"dialogs": [
				{
					"id": 750090601,
					"content": "Com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ha trovato questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Fammi dare un'occhiata... Non è certo un oggetto comune, ma comunque una buona scoperta. È in ottime condizioni e i segni del flusso di Flogisto sono ben visibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "Sì... Me la cedereste per 10.000 Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "Cosa?!? Abbiamo davvero trovato una reliquia saurica inestimabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#Paimon sapeva che {REALNAME[ID(2)|SHOWHOST(true)]} era incredibile e che ci avrebbe portato fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "No, non è neanche lontanamente preziosa quanto credi. Se la portassi all'Associazione per stimare il prezzo, la valuterebbero al massimo 5.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Che accicavolo di trucchetto sarebbe?? Se vale solo 5.000 Mora, perché sei disposta a pagarne 10.000?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "È per via del motivo unico che ha. Mi piace molto. Anche se agli altri potrebbe non sembrare un oggetto di valore, sono disposta a pagare un prezzo un po' superiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Potrai pure definirmi stramba, ma è solo la natura di un collezionista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Mmm... Se la metti così, Paimon capisce. E 10.000 Mora sono un bel gruzzolo, se paragonati al prezzo d'iscrizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "Quindi, la scambiamo per 10.000 Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "Rrrroar... Rrrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#Non sembri molto felice di questa cosa, {REALNAME[ID(2)|SHOWHOST(true)]}... Vuoi tenertela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "Rrr... Rrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "Beh, l'hai trovata tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} non vuole vendere, quindi ce la teniamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#Sembra che per te {REALNAME[ID(2)|SHOWHOST(true)]} valga molto più di qualche Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "Certo! È nostro amico, dopotutto. Ma se troveremo qualcosa di simile in futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Grazie, ma la passione dei collezionisti è mutevole come le maree. Potrebbe tornare improvvisamente o sparire senza lasciare traccia. In futuro potrei avere una nuova ossessione, anche se non so ancora cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "Roar! Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
