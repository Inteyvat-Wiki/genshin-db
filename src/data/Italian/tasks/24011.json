					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111503,
					"content": "Beh... Anche se non si può fare, devi solo darmi il tempo necessario per mangiare le mie patatine. Allora grazie di volertene occupare.",
