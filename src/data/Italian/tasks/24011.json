				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Ah, gabbiani pescatori violucenti. Quando avete finito con le patatine, vi prego, andatevene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Com'è la situazione al momento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Per niente. Quando i gabbiani sono arrivati per rubarmi le patatine, si è nascosto dietro di me tremando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*sospira* Non lo biasimo. La sua razza ha sempre avuto un solo dovere: amare gli altri e ricevere amore. Non ha mai imparato ad attaccare niente nella sua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Anche noi abbiamo questo dovere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Forse. Ma in certe circostanze anche l'amore può essere considerato un \"diritto\". E quando si tratta di queste cose, tutto tende a complicarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Scusami, ho detto troppo. Oggi ho dovuto gestire molte controversie di natura emotiva e temo di non essermi ancora ripreso del tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*sospira* Ma al momento il mio compito più urgente è quello di capire come finire le mie patatine senza altri guai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Prendere un cane ti è stato d'aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
