				"points": []
			},
			"dialogs": [
				{
					"id": 240111101,
					"content": "Hai provato a prendere un cane?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "Vuoi dire che... Dovrei prendere un cane affinché li spaventi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
					"content": "Non è una brutta idea. Potrei riuscire a farmene prestare uno da qualcuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
