					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "Mm, che ne dici di andare a mangiare da un'altra parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "E comunque adesso non trovo niente di meglio da mangiare. Se mi avvicinassi troppo al Palais Mermonia, potrei imbattermi in uno dei miei colleghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "E mi faccio trascinare di nuovo dalle loro discussioni sul lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Ma se mi allontano troppo, non riuscirò a tornare in ufficio in tempo, e potrei perdermi qualcosa di importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Considerando questi due fattori, non mi rimane che questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
