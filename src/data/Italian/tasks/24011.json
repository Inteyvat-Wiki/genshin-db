			"dialogs": [
				{
					"id": 240111401,
					"content": "Li scacceremo tutti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Certo, ma potresti concentrarti solo sullo... scacciarli? Vogliono solo le mie patatine, ma non c'è cattiveria in loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Voglio dire, è una cosa brutta per me, ma non è molto grave, quindi... Per favore, scacciali e basta, ti dispiace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
