			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Ah, simpatici gabbiani. Lo so che avete fame, ma anche io ne ho ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Come non detto, l'importante è che siate felici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#Viaggiat{F#rice}{M#ore}? Oh, ma che bella sorpresa. Se sei qui per chiedere di me, temo che dovrai aspettare. Non ho ancora finito con le mie patatine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Oh, non sono qui in veste ufficiale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Oh, ma davvero? Bene. Ho bisogno di sbrigarmi e finirle il prima possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Beh, è il mio pasto principale. Devo andare a condurre degli affari con Roialte, per cui devo finire in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Non è mia abitudine mangiare all'interno del Palais Mermonia, per cui vado spesso alla ricerca di un angolo silenzioso per finire il mio pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Ma oggi... Non so cosa sta facendo impazzire tutti questi gabbiani, ma vogliono le mie patatine, e non importa quante ne prendano, non gli bastano mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Beh, ci sono un sacco di gabbiani, e le patatine sono solo queste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Vero, ma non sto mica qui a sfamare tutti i gabbiani dell'oceano, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Beh, le patatine sono tue, vero? Non farti prendere la mano dai gabbiani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Se continui così non ti sazierai, non lo sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Sembri un po' stanchino, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Davvero? Beh, non lo sono... O forse sì. Vedo che non ti sfugge niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "È solo che... non so quale sia il significato del mio lavoro. Ogni giorno sgobbo come un mulo alla Maison Gestion, ma non vedo dei risultati tangibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Non sono stato in grado di aiutare nessuno, né la vita di nessuno è stata resa più comoda dal mio lavoro. Roialte dice che il nostro lavoro è molto importante, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Mi siedo davanti a una macchina da scrivere e mi metto a battere all'infinito. Ma a cosa serve? Potrei anche perdere un altro copritasto. Almeno così Estelle guadagnerà un po' di Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Mi dispiace. So che non dovrei dire tutto questo, ma mi sento piuttosto perso in questo momento, qualunque cosa io faccia. Forse... Forse ho bisogno di più tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Ma prima finiamo di mangiare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Hai ragione. Ma non abbiamo tempo a sufficienza per andare a comprare una nuova confezione di patatine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Lascia perdere, darò il resto agli uccelli. Prenderò qualcosa da mangiare quando io e Roialte avremo finito di lavorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Ci vorrà... Quanto, mezza giornata? Non troppo tempo, direi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Riuscirai a resistere senza mangiare per così tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Penserò io ai gabbiani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Ehm, non sarebbe un problema troppo grande? Mi sembra esagerato, per una semplice porzione di patatine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Pensa a mangiare. Non dovresti soffrire la fame, anche se sei molto impegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Mi occuperò di quei gabbiani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Risolviamo prima il tuo problema coi gabbiani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Sembri un po' triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Non tutti hanno ricevuto qualcosa da mangiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "E perché sei qui a mangiare patatine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
