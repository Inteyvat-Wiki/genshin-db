			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Sembra che non se la passi troppo bene... Deve star morendo di fame! Diamogli un po' da mangiare, vuoi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Che questo cibo gli dia la forza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "Non per essere parziali, ma Paimon pensa che il tuo cibo sia strepitoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Dai alla persona a terra una porzione di uovo fritto di Teyvat.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Sono...Sono di nuovo vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Wow, deve essere davvero affamato. Era solo un uovo fritto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Ah, che delizia indescrivibile, di sicuro sufficiente a risvegliare i morti! Se avessi saputo che le uova fritte avevano questo sapore, avrei comprato quell'uovo misterioso da quel tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Quale uovo misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Si dice che se lo mangi, puoi evitare l'equivalente di un giorno di sfortuna. Oh, quanto vorrei averne comprato uno... o magari una dozzina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Oh, sembra davvero sospetto, e Paimon crede di saper riconoscere una truffa. Eppure, come hai fatto a ritrovarti qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Io... Beh, sono un rinomato artista di Fontaine, e sono venuto a Sumeru per raccogliere ispirazione per il mio lavoro. Potete chiamarmi Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "Ispirazione? Qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Non ci sono altri posti più adatti per l'ispirazione? Sai, un posto con una vista migliore e misure di sicurezza migliori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Inoltre, se sei un artista di Fontaine, perché sei a mani vuote?... Sei una spia dei Fatui, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Che pensieri radicali! Tanto radicali che viene da chiedersi cosa ti sia successo per avere una simile mentalità! Sono purtuttavia un artista e nient'altro, temo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "È solo che... Beh, ho già raccolto abbastanza ispirazione da questo luogo e mi stavo preparando per tornare a Fontaine con quello che ho ottenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Non mi aspettavo che a Sumeru il clima fosse così secco. Quando ho attraversato la Vallata Chenyu durante il mio tragitto, l'aria era ancora relativamente umida, ma appena varcati i confini di Sumeru le tempeste di sabbia hanno iniziato a scatenarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Devo confessare che sono abituato a climi più umidi, per cui avevo in programma di tornare via mare per ammirare paesaggi diversi, ma la mia zattera è finita alla deriva, e io non so nuotare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Immagino che vivere a Fontaine non sia stato facile per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Esatto, anche se non si tratta solo di saper nuotare o meno... *sospira* Lasciamo stare. Ho trovato un luogo in cui riposare vicino all'acqua, e ci sono ancora delle foglie di tè che non sono ancora completamente inzuppate. Permettetemi di ringraziarvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Ci stai invitando a prendere del tè?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Oh, ovvio, ovvio! Dovrò esprimere la mia gratitudine per il dono dell'uovo fritto, ovviamente. Come preferite che vi chiami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Ah, ma certo, Paimon aveva quasi dimenticato le presentazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#Siamo {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ah, che nomi brillanti. Beh, in ogni caso venite a prendere del tè, il mio accampamento è qui vicino. Vi dirò di più, siamo a due passi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "#L'emissari{F#a}{M#o} di giustizia e la sua assistente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Siamo {NICKNAME} e Paimon, l'amica migliore che ci sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Puoi chiamarci Oro splendente e Argento abbagliante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Siamo l'Oro splendente {NICKNAME}, e l'Argento abbagliante Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Come fa la gente a chiamarsi \"rinomata\" da sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Esattamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Beh lui, non è te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Dai su! Chi non è svenuto per la fame almeno una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
