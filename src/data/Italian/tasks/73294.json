		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Che accampamento semplice... Paimon si chiede se lo si possa definire accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Beh, ha davvero un bello scenario, e c'è un senso di apertura quando mi avvicino all'acqua. Onestamente è molto più rilassante di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Seriamente, che tipo di vita facevi quando eri lì? Non è... proprio quello che Paimon si aspettava da un artista rinomato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Vivevo in un luogo piccolissimo a Fontaine... E questo solo perché sono una persona umile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Ma anche gli accampamenti degli avventurieri hanno un aspetto migliore. Huh? Hai un amico animale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Eh, non ce l'ho. Questo dev'esser stato abbandonato da un avventuriere o qualcosa del genere. A proposito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Mi piacerebbe ricevervi in condizioni migliori, ma la maggior parte dei miei bagagli è caduta nell'acqua quando la mia zattera si è sfaldata, e non so nuotare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Ma se poteste trovarmi i miei bagagli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "Saranno ancora utilizzabili dopo esser stati a mollo così a lungo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Ho impacchettato tutto con cura, ma ci sono delle cose che... *sospira* beh, se le ho perse, le ho perse. Posso sempre ridisegnarle... sì, ridisegnarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "Ehm, forse dovremmo aiutare. Questo tizio sembra essere in una condizione pietosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Non ho nessun altro su cui fare affidamento qui, per cui posso chiedere aiuto solo a voi due. Aspetterò qui con del buon tè in mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329410",
							"2"
						],
						"stepId": 7329410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Strano. Perché mai c'è un cane qui? E sta facendo la guardia a qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Ti guarda sospettoso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Cane"
				},
				{
					"id": 732941003,
					"content": "Che cagnolino intelligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Emette un abbaio breve.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Cane"
				},
				{
					"id": 732941007,
					"content": "Ah, è vero, non abbiamo forse visto una scodella di cibo nell'accampamento di Julien? Forse appartiene a lui! Strano però, Julien non ci ha detto di non avere nessun amico a quattro zampe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*piagnucola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Cane"
				},
				{
					"id": 732941009,
					"content": "Il cane si dirige verso l'accampamento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Se n'è andato... Chiediamolo a Julien più tardi. Per ora Paimon si chiede solo cosa ci sia sotto questo mucchio di sabbia. Diamo un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "Da dove viene questo cane selvaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Emette un ringhio.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Cane"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Eccoci qua! Oh, allora è il tuo amico a quattro zampe, Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Ringhia minaccioso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Cane"
				},
				{
					"id": 732941203,
					"content": "Fantastico, Pepe... Adesso mi ringhi pure contro? Non lo sai chi è che ti riempie la pancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Oh, allora ce l'ha un nome! Però... Davvero questo tizio sta discutendo con un cane?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Sembrano molto legati.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(Tu questo lo chiami \"essere legati\"?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Ehi, Julien! Abbiamo trovato quello che avevi perso! Pepe è il tuo amichetto a quattro zampe, vero? Perché ci hai mentito prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Questo ingrato sarebbe mio amico? Tanto varrebbe adottare un Segugio della Faglia, piuttosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Dubito che resterete compagni a lungo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Esattamente. Se qualcuno come te, che sviene per la fame, si trovasse davanti un Segugio della Faglia, la situazione non si risolverebbe con un semplice uovo fritto di Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "A proposito, sembra che facesse la guardia a un tavolo da disegno sulla spiaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Forse voleva nasconderlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Che cane cattivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Abbaia, come se volesse protestare.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Cane"
				},
				{
					"id": 732941218,
					"content": "Ti stai davvero lamentando di questo? Se non ti avessi seguito fin qui, sarei tornato a Fontaine per la strada che avevo in mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Eh? Non avevi detto di esserti mosso via mare perché volevi apprezzare i paesaggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "D'accordo, va bene... Il fatto è che non mi stavo nemmeno godendo i paesaggi di Sumeru... Sono finito qui semplicemente perché ho seguito il cane. In questo posto le strade vanno in ogni direzione, era impossibile non perdersi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Oh, allora è così che è andata. Suvvia, avresti dovuto dirci la verità dall'inizio! Perché non lo hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Oh... Per... conservare l'immagine di rinomato artista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Oh, mi sembra che stia solo provando a ingannarci quando balbetti così, e non sei mica poi così bravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Ma parlando di paesaggi qui a Sumeru, si dà il caso che {NICKNAME} e Paimon conoscano dei bei luoghi. Ti ci possiamo portare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "N-Non serve. Cioè, voglio dire... Apprezzo la vostra offerta, ma sono pur sempre un rinomato artista. Penso che i paesaggi degni di nota siano quelli che scopriamo da soli, in fin dei conti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Oh, ecco, il tè è pronto. Avete per caso delle altre uova fritte? Sapete, come spuntino da accompagnare al tè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Che abbinamento inusuale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Infatti! {NICKNAME} sa preparare un mondo di piatti! Possiamo sempre mangiare qualcos'altro, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Vi gustate il tè insieme a qualcosa da sgranocchiare.\\nIl sapore del tè è difficile da descrivere...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Oh, questo tè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Me l'ha venduto un mio amico. A quanto pare, è in grado di attivare la saggezza latente in chi lo beve. E penso che abbia un ottimo sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Per fortuna che non ho amici simili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Ma come? È così bello avere degli amici. A dire il vero, sono venuto a Sumeru proprio perché me l'ha consigliata un amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "#Grazie a entramb{F#e}{M#i} per ciò che avete fatto oggi per me. Spero che il compenso che vi ho preparato corrisponda alle vostre aspettative...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Va bene così, è solo che... Sei sicuro di non aver bisogno del nostro aiuto per l'ispirazione? Paimon crede che tu possa perderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "Lo scopo di un pellegrinaggio... Cioè, lo scopo di un viaggio sta nel farlo da soli. Non è il caso che vi disturbi ancora. Devo farcela con le mie sole forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Beh, se lo dici tu... Assicurati solo di non svenire di nuovo dalla fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Puoi darmi un'altra tazza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#Davvero le tue papille gustative non hanno niente di strano, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Ahah, non per essere tirchio o altro, ma dato che resterò a Sumeru per un po' devo tenere un po' di soldi da parte per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "È una vana speranza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Mmh... Ma se prendiamo solo il tè, sembrerà mancarci quel tocco di non so che, giusto? Prepariamo qualcosa di veloce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Forse proteggeva il tavolo da disegno da potenziali ladri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Ma è corso via nel momento in cui l'abbiamo trovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Non sento l'odore di nessun liquore...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Ma è sempre così? Sembra una persona un po' problematica...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}