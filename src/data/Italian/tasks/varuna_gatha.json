			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141001,
					"content": "Quindi questa è l'\"area di relax\", eh? Basta guardarsi intorno per capire che gli Aranara sono stati qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "La Macchina di Varuna è ancora più maestosa vista da qui. Argh... la pressione è così forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon, stai attenta a non venire risucchiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "Ma è impossibile che succeda! O almeno Paimon lo spera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Abbiamo un accordo: ci incontreremo nell'\"area di relax\" dopo aver risanato i rami e le foglie della Macchina di Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Poi, scacceremo insettacci che stanno rosicchiando radici della Macchina di Varuna e la risaneremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "A questo proposito, cosa intendi con \"i rami e le foglie della Macchina di Varuna\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "I rami e le foglie della Macchina di Varuna sono sparpagliati per Vana. Danno alla macchina potere di trasformare pioggia nera in pioggia buona. Pioggia buona dà vita alle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Come acqua piovana scorre in un ruscello e poi in un lago, i rami e le foglie raccolgono frammenti che vanno nella Macchina di Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "Ora Macchina di Varuna non è più la stessa. È come se i rami spezzati avessero ostacolato acqua piovana in modo che i ruscelli non potessero più formarsi. Senza ruscelli, lago si prosciuga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Argh... Paimon continua a non capire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "È praticamente la stessa cosa che succede quando muori di fame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "Oh! Paimon non ha le forze necessarie per lavorare se non mangia! Questo significa che la Macchina di Varuna è affamata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "No, non credo proprio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Mmh, sì, è così! Nessuno ha le forze di fare i capricci se ha fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "A ogni modo, per prima cosa dobbiamo risanare i rami e le foglie, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Sì. Arapandu porterà Paimon lì e Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "È la stessa cosa che succede quando una via di trasporto sicura è bloccata da qualche ostacolo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "Allora dobbiamo rimuovere tutti gli ostacoli per poter andare avanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "Allora dobbiamo solo trovare un'altra strada! In fin dei conti, chi ha deciso che questa sia la strada giusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Già, chi l'ha deciso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
			]
		},
		{
			"id": 7301412,
