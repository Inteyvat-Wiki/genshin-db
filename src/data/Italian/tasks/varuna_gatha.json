		{
			"id": 7301415,
			"completionStepIds": [
				7301415
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301415",
							"2"
						],
						"stepId": 7301415,
						"stateName": "QUEST_STATE_UNFINISHED"
