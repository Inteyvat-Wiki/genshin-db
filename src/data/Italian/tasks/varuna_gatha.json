					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "#Oh, {F#una}{M#un} Nara. {F#Una}{M#Un} Nara dorat{F#a}{M#o} e coraggios{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140302,
					"content": "#Ciao! Paimon è Paimon e {F#lei}{M#lui} è {NICKNAME}. Come mai sei qui tutto solo? Nel Vanarana sono tutti impegnati con i preparativi per il Festival di Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140303,
					"content": "Arapandu ha compito molto importante per Festival di Utsava, per Boschi di Apam e per Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140304,
					"content": "Beh, ora sappiamo che tu sei Arapandu. E \"Nara Varuna\", invece? Mmh... Questo nome mi è familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140305,
					"content": "#Nara Varuna... È {F#un}{M#una} Nara dorat{F#o}{M#a} e coraggios{F#o}{M#a}, proprio come Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140306,
					"content": "Quando la luna e il sole non si vedevano, anche foglie di grandi alberi del Vanarana erano state strappate dal vento e loro rami erano marciti sotto la pioggia nera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140307,
					"content": "Dolore del Vanarana scorreva nel terreno. Odore di ferro e di sale ovunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140308,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140309,
					"content": "#Nessuno sa quanti tramonti e albe passarono prima dell'arrivo di Nara Varuna. {F#Un}{M#Una} Nara dorat{F#o}{M#a} che parlava una lingua dorata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "#{F#Lui}{M#Lei} e Aranara riportarono indietro la luna e il sole. Macchina di Varuna portò via dolore del Vanarana. Pioggia nera sparì e odore di ferro e di sale non c'era più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "Tutti nel Vanarana adoravano e ringraziavano Nara Varuna. Nara Varuna era come sole, come fango, come gocce di rugiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "#Wow, ma è meraviglioso! Dev'essere proprio {F#un}{M#una} brav{F#o}{M#a} Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Eheh... Ma anche Nara {NICKNAME} ha aiutato tante persone, per cui tante persone {F#le}{M#gli} sono riconoscenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#Quindi ti piacerà anche Nara {NICKNAME}, Arapandu! Paimon ne è sicura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#Dopo che {F#lui}{M#lei} se ne andò nel Vanarana, molti nacquero dal terreno e molti ritornarono nel terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "In seguito, i rami e le foglie di Macchina di Varuna si indebolirono. Varunastra era come uccellino spaventato che sbatteva le ali all'impazzata. Poi cominciò a diluviare. Molto strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Ora funghi che corrono si sono insediati a Vana. Semi mai visti prima sono ovunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "...Intendi dire i Miconoidi e le spore? E poi, cosa sono la Macchina di Varuna e Varunastra, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Forse sono delle armi molto potenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Una lama in grado di fare a fette Valuka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Aspetta! Sarebbe fin troppo potente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Mmmh... No. Nara {NICKNAME} e Paimon si sbagliano entramb{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Andiamo in un posto in alto e Arapandu ve lo dirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Forse non sono armi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Cosa potrebbero essere, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Forse sono Aranara alati fatti d'acqua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Non saranno semplicemente gli imitatori evocati dall'Oceanide?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
