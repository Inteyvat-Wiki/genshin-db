			},
			"dialogs": [
				{
					"id": 730141201,
					"content": "Wow... Paimon non avrebbe mai immaginato che fossero in un posto del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141202,
					"content": "Aspetta un attimo... Eh? Sono questi i \"rami e le foglie\"? Ma sembrano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141203,
					"content": "Le pietre che hanno posizionato gli Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Foglie e rami di pietra. Sono stati creati da Aramuhukunda e dall'Archon di Dendro, e possono incanalare il potere del Vanarana nella Macchina di Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141205,
					"content": "Quindi la Macchina di Varuna è come un grande albero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "Allora è così che stanno le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Mmmh... Oh, no... Tre foglie devono essere rivolte nella stessa direzione del ramo, ma Arapandu non è abbastanza forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#Beh, voi Aranara siete piuttosto piccoli. Non preoccuparti, lascia fare a Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141209,
					"content": "Arabalika potrebbe riuscirci, ma Aranakula e Arakunti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141210,
					"content": "#In ogni caso, dobbiamo prima risolvere questo problema. Nara {NICKNAME}, Arapandu lascerà tutto nelle tue mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
			"id": 7301413,
			"completionStepIds": [],
