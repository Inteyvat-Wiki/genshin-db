				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Grazie, Nara {NICKNAME}. Arapandu penserà al resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141502,
					"content": "Ma è passato troppo tempo. Non so se questa volta funzionerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141503,
					"content": "Cosa?! C'è la possibilità che non funzioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Ultima volta ha funzionato, ma questa volta potrebbe non funzionare. Proprio come il sole è sorto l'ultima volta e quella prima ancora, ma nessuno sa se sorgerà la prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Solo dopo che la prossima volta sole sarà sorto, Paimon potrà dire: \"Oh, il sole è sorto di nuovo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Uhm, aspetta, questo è un bel problema: e se il sole non sorgesse mai più?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#Paimon, non c'è bisogno di avere paura. Nara {NICKNAME} è dorat{F#a}{M#o} come sole, proprio come Nara Varuna. Nara {NICKNAME} è Nara coraggios{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Nara Varuna ci ha restituito la luna e il sole. Anche Nara {NICKNAME} può farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "#...Sì! Anche Paimon crede in {NICKNAME}. {F#Lei}{M#Lui} può superare qualsiasi difficoltà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "Non preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Per ora, però, lascia fare ad Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Oh, Paimon crede che... abbia funzionato. Forse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Sì, ramo e foglie sono stati risanati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "Ma è fantastico! E a Paimon piace la tua danza Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Paimon, potresti farti insegnare qualche passo dagli Aranara!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Ottima idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Voglio dire, ti farà bene fare un po' di esercizio fisico in più, dato quanto mangi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Ehi! Paimon fa già tanto esercizio fisico! Paimon sta sempre a correre di qua e di là con te, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Tuttavia, non è abbastanza per risanare la Macchina di Varuna, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "A Vana ci sono altri tre posti come questo. Arabalika è molto forte e potrebbe riuscirci... Ma Arapandu è in pensiero per Aranakula e Arakunti. Vana è più pericolosa dopo strana pioggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "In tal caso, che ne dici se ti aiutiamo e andiamo a dare un'occhiata? D'altronde, non possiamo preparare in tranquillità il Festival di Utsava se la Macchina di Varuna non viene risanata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Con aiuto di Paimon e Nara {NICKNAME}, sono sicuro che Macchina di Varuna verrà risanata presto e vita a Vana tornerà alla normalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula si trova al <color=#00E1FFFF>Monumento di Yasna</color>. Nelle profondità di Vana c'è monumento eretto dagli Aranara per ricordare Nara Varuna, ma non andiamo lì da molto tempo a causa dei Miconoidi e delle spore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula è abituato a stare a contatto con suolo e semi. Conosce bene tutte le cose che nascono dal suolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Quando lo trovate, ditegli nome di Arapandu. Così non avrà paura di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Oh, sembra un Aranara alquanto timoroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#Ararakalari di Arabalika è molto forte! Ma... per favore, Paimon e Nara {NICKNAME}, andate a dare un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "#Arabalika si trova alle <color=#00E1FFFF>Rovine di Dahri</color>. Molto odore di ferro lì... Paimon e Nara {NICKNAME} devono fare attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Faremo attenzione, grazie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti si trova al <color=#00E1FFFF>Frutteto dei Sogni</color>. Potete entrare nei sogni da lì. Lui non conosce Nara. Se si nasconde, suona la nostra musica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "A questo proposito, non abbiamo già ricevuto uno spartito degli Aranara? Possiamo provare a suonarlo se non riusciamo a trovare Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "Arapandu vi aspetterà nell'\"area di relax\" e terrà d'occhio Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika e Arakunti sanno che ci dobbiamo incontrare nell'\"area di relax\" dopo aver risanato rami e foglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Nara dorat{F#a}{M#o}, sei Nara coraggios{F#a}{M#o}. Che Aramuhukunda vegli su Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "Conta su di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Ehi! Cosa c'è laggiù?! È straordinario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Ora Nara {NICKNAME} e Paimon sanno. Quello è Varunastra. Ma Macchina di Varuna è in un posto più in profondità, un luogo profondo come radici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "Abbiamo sottovalutato Nara Varuna. Paimon non immaginava che il tesoro fosse così grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "Una potenza del genere non va sottovalutata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Prima che pioggia nera e Nara Varuna arrivassero a Vana, Aramuhukunda e il Signore di Dendro crearono Macchina di Varuna. Pioggia ha dato vita a molte cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "Pioggia nera, fango nero e molte altre cose brutte hanno messo a soqquadro Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "#Prima che {F#lui}{M#lei} arrivasse qui, Arapandu non aveva mai visto {F#un}{M#una} Nara così coraggios{F#o}{M#a}. Ha riparato macchina con gli Aranara, proprio come il sole che spazza via nebbia assopita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Nara Varuna non è più nel Vanarana. Aramuhukunda non è più nel Vanarana... Ma gli Aranara devono riparare Macchina di Varuna per Festival di Utsava e per Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Abbiamo promesso ad Araja e Arama di aiutare con i preparativi per il Festival di Utsava. Come si suol dire, il fuoco è più grande e più forte quando più Nara aiutano a raccogliere la legna, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "Ehm... No, aspetta... Paimon voleva solo dire che con l'aiuto di più Nara tutto filerà liscio! Non preoccuparti, non ha nulla a che vedere con il fuoco! Era solo una metafora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Paimon, ti sei data di nuovo la zappa sui piedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Oh, andiamo... Da quando siamo a Sumeru, Paimon vuole dimostrare a tutti che anche lei sa molte cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu non ha paura. Paimon ha cuore d'oro, proprio come Nara {NICKNAME} e Nara Varuna. Paimon è amica degli Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti e Arapandu vogliono guarire Macchina di Varuna, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "Ci sono troppe spore e Miconoidi, quindi non possiamo fare nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Arapandu non ha un'Ararakalari potente come Arabalika, e strana pioggia ha reso Miconoidi più aggressivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Aspetta un attimo, Ararakalari? Arana ha detto a Paimon che può essere usata per respingere il Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Ararakalari potente può scacciare Miconoidi. Ararakalari di Arapandu è debole, quindi non può scacciare Miconoidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "Cosa? L'Ararakalari può essere usata anche in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Credo che Ararakalari sia un termine generico per indicare un certo tipo di abilità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} è più intelligente di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Aranara diversi possiedono Ararakalari differenti, ma tutti Aranara ottengono il potere di usarlo da piante di Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Ararakalari di Arabalika è molto potente, non ha paura di grandi Miconoidi e di grandi Nara di ferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "Grandi Nara di ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Grandi Nara di ferro sono molto grandi e hanno due braccia e due gambe proprio come Nara {NICKNAME}, ma un solo occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "Oh, intendi le Guardie delle rovine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Molto intelligente, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "Oh! Su quegli alberi laggiù ci sono dei Miconoidi... Arabalika può sconfiggerli, ma Arapandu no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Neanche Nara {NICKNAME} ha paura di Miconoidi. Non usi Ararakalari, ma sei molto potente. Distruggili, come raffica di vento travolgente che spazza via foglia! Puff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Se non vengono eliminati, spore e Miconoidi si moltiplicheranno... Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141734,
					"content": "#Lascia che ce ne occupiamo noi! Nara {NICKNAME} li sconfiggerà in un istante! Giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}