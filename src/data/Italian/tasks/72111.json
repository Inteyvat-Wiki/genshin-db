					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110503,
					"content": "Questa è stata lasciata di proposito di notte, mentre pioveva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
