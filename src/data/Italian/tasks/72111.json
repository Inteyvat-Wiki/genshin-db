					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "Un sacchetto per tenere dei Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110202,
					"content": "Questa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110203,
					"content": "Questa appartiene alla nostra famiglia. Non c'è nulla di sospetto. Proprio così, niente di strano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110204,
					"content": "Ora mi fa sospettare ancora di più! Qui c'è sotto qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110205,
					"content": "Adesso, per favore, disegna il simbolo che c'è sulla borsa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110211,
					"content": "E va bene. Questa borsa non è mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110212,
					"content": "Chissà quante persone saranno passate per il mio giardino. Sarà sicuramente caduta a qualcuno, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110213,
					"content": "È...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110214,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "*sospira* Va bene, avete capito tutto. Ero davvero tentato di tenere quella borsa solo per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110216,
					"content": "Oh, Densuke! Come ha potuto un uomo della tua età pensare una cosa del genere?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110217,
					"content": "Qualcosa non mi convince.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "Ho... Ho appena confessato la mia intenzione di rubare dei Mora. Cos'altro dovrei nascondere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110220,
					"content": "Andiamo, dai... Restituirò la borsa allo Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110221,
					"content": "C'è qualcosa che non quadra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110222,
					"content": "Qualcuno ha messo qui quella borsa di proposito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "C-Che prove avete per dire una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110228,
					"content": "La borsa di monete è solo una parte del mistero. Abbiamo trovato anche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110229,
					"content": "#Mmmh... Cos'era...? {NICKNAME}, tocca a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, che cosa abbiamo trovato prima nel canale?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110231,
					"content": "Questa è stata lasciata di proposito di notte, mentre pioveva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "Non è che stai pensando troppo, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(Non può essere andata così, {NICKNAME}. Davvero pensi che nonno Densuke volesse solo rubare un po' di Mora?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110225,
					"content": "(Sta nascondendo qualcosa)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110226,
					"content": "Qualcuno ha messo qui quella borsa di proposito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "Stai nascondendo qualcosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "Dimmi quanti Mora contiene, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "Ahahah, che razza di domanda è questa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110208,
					"content": "Non avresti mai potuto sapere quanti Mora contiene se tu non l'avessi mai aperta, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110209,
					"content": "Adesso, per favore, disegna il simbolo che c'è sulla borsa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
