			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "#Allora, cosa posso fare per voi, ragazz{M#i}{F#e}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "Abbiamo trovato le prove.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Le prove? Che prove? Non so di cosa stiate parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "Le prove su quegli strani incidenti al villaggio. Per piacere, basta con le recite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Sciocchezze! Che strani incidenti potrebbero mai accadere nel nostro villaggio? E va bene, fatemi vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#(Ehi, {NICKNAME}, cominciamo da quello che abbiamo trovato vicino al pozzo. Paimon lascia che faccia tu!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Abbiamo trovato questa vicino al pozzo prosciugato nel tuo giardino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
