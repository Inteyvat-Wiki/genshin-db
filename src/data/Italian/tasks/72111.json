			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110601,
					"content": "Che cos'è? Non riesco a leggere niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110602
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110602,
					"content": "#Non cercate di ingannarmi con cose a caso, ragazz{M#i}{F#e}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110603,
					"content": "Abbiamo trovato questa vicino ai resti di un carretto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211107,
			"completionStepIds": [
				7211107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211101",
							"3"
						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211102",
							"3"
						],
						"stepId": 7211102,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211103",
							"3"
						],
						"stepId": 7211103,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211107",
							"2"
						],
						"stepId": 7211107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Ma è... è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Non riesco a credere di essere stato così distratto quando ho danneggiato il carretto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Oh! Finalmente l'hai ammesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "#Visto che siete arrivat{M#i}{F#e} così avanti con la vostra indagine, ormai non posso più nascondervi nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "#Immagino che vi siate già fatt{M#i}{F#e} un'idea di quello che è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "Un'idea molto chiara, nonno Densuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Hai tentato di derubare un carretto dello Shogunato, non è vero? Nel mezzo della colluttazione, hai distrutto il carretto in un colpo solo e fatto finire il carico nel canale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Nella speranza di salvarsi, gli uomini dello Shogunato hanno lanciato le loro borse di monete nel pozzo per distrarti! Dopo quanto è successo, hai chiuso il pozzo per impedire ad altri di rubare i Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Eh? No, non è così che è andata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Davvero? Paimon voleva giusto chiederti la chiave per assicurarsi quei Mora in fondo al pozzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "...e consegnarli allo Shogunato! Proprio così! Devono assolutamente essere consegnati allo Shogunato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "*sospira* Va bene, vi racconto com'è andata veramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "I responsabili di tutto sono alcuni giovani del villaggio. Dopo aver bevuto troppo, si sono sentiti tanto spavaldi da derubare uno dei carretti dello Shogunato. Quindi è vero: le merci e la borsa di monete sono proprietà dello Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "Non potevo permettere che si spargesse in giro la voce su un fatto così vergognoso per il nostro villaggio. Ecco perché ho cercato di insabbiare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "E quella confessione che hai fatto prima sulla borsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "L'ha fatto per nascondere la verità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "È così. Ho pensato che confessando avrei posto fine all'indagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Se fossi stato solo io, se nessun altro fosse rimasto coinvolto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Vi prego, non informate lo Shogunato. Non lo dico per salvare la mia reputazione. Non voglio che l'intero villaggio sia coinvolto in tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Non ho intenzione di denunciarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Esatto, non siamo qui per questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Oh, grazie al cielo! Grazie al cielo....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "La mia coscienza non ha fatto altro che tormentarmi per aver nascosto tutto, quindi ho scritto i miei pensieri in un diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "L'ho lanciato sul tetto. Se volete leggerlo, andate pure a prenderlo. Cercate però di non rovinare il tetto: l'ho appena rinnovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "E il pozzo chiuso a chiave...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Sì, sono stato io a chiuderlo. Ho anche scritto dove ho nascosto la chiave. Leggi e saprai ogni cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Nonno Densuke, sai qualcosa sulla barriera del Villaggio di Konda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "La barriera? Oh, allora quella vecchia leggenda è ancora diffusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "Si dice che in tempi antichi, sotto il terreno sul quale ci troviamo in questo momento, si trovassero le radici del Sakura del tuono. Si tratta invero di una delle cinque radici che salvaguardano la pace sull'Isola di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Secondo la leggenda, il clan Konda, il nostro clan, ha ricevuto il compito di proteggere queste radici e la barriera dalla Saiguu Kitsune in persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Tutto questo accadde molto, molto tempo fa. Non ricordo praticamente nulla dei dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "Voglio solo sapere la verità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Esatto, non siamo qui per denunciarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "La verità? Eheh... Voi giovani d'oggi siete così interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
