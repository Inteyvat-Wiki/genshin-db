			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "Ehi, è Simulanka! Uhm... Ma perché ci sono light novel della Casa editrice Yae sparse per terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Beh, parlando della mia illuminazione letteraria, la mia più grande fonte d'ispirazione... è Lady Anya in persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "È stata l'ultima a unirsi all'Hexenzirkel, ma anche la prima ad andarsene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Amavo tutte le sue storie. Che si trattasse di una semplice idea o di un manoscritto completo, Anya era sempre così abile nel far trasalire di gioia i suoi lettori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Le discussioni dell'Hexenzirkel raramente si allontanano dalla magia, ed è mia convinzione che Anya possedesse una magia unica tutta sua. Sapeva intrecciare amore e compassione in parole e storie capaci di toccare i cuori degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Le chiesi dei consigli su come scrivere storie avvincenti. Mi insegnò molti trucchi e tecniche, ma alla fine il mio peggior nemico sono sempre stata io stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Troppo pigra per mettere tutto nero su bianco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Ahah! Sì, per così dire. Comunicare attraverso il pensiero è semplicemente molto più comodo. A quanto pare, anche gli angeli possono cedere alla pigrizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Tuttavia, di recente ho deciso di fare uno sforzo, anche solo per evitare i rimproveri di un certo Seelie di mia conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Ooh! Significa che finalmente potremo leggere qualcosa che hai scritto tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Chi ha parlato di scrivere? Intendo acquistare le opere più popolari degli ultimi secoli e sfogliarle nel tempo libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Ahah! Sì, potremmo dirlo così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Comunicare attraverso il pensiero è molto più comodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Pare che anche gli angeli possano cedere alla pigrizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
