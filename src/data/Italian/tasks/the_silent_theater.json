					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "Ma che...?! Paimon c'è quasi rimasta secca! Essere risucchiati in questo modo da un dipinto è... Aspetta un attimo, questo posto sembra familiare. Oh, è il tavolo dove le maghe organizzano i loro tè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Tutto ebbe inizio la prima volta che Alice mi invitò a prendere il tè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Quel giorno non partecipai di persona... Principalmente perché, all'epoca, non avevo ancora deciso se unirmi davvero all'Hexenzirkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice era l'unica tra le presenti a conoscere la mia vera identità. Mi avvertì di non dire nulla e di non permettere a nessuno di scoprire chi fossi. Dovevo solo osservare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "...E poi cos'accadde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Beh... Conclusi che mi stava punendo per la mia esitazione a unirmi a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Stavano tutte parlando di cose così interessanti. Come avrei potuto non intromettermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "E, naturalmente, quando sei nel bel mezzo di una conversazione e qualcuno lancia una domanda di cui conosci la risposta, come fai a tenere la bocca chiusa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Il che ci porta alla scommessa tra Barbeloth e Alice, alle creazioni proibite di Rhinedottir, alle macchinazioni politiche di Ivanovna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Erano come una serie di rappresentazioni teatrali recitate in modo sontuoso, concentrate nei confini di una tazza da tè. Le loro parole da sole sono state sufficienti ad accendere il mio istinto di rivelare loro la verità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Quindi ti sei introdotta nelle loro teste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Ma certo che no! La testa stava quasi per esplodermi, ma mi sono trattenuta con tutte le mie forze. Dopotutto, sono un angelo responsabile, conosco bene la differenza tra \"quello che vorrei dire\" e \"quello che mi è concesso dire\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Così ho fatto una piccola chiacchierata privata con Alice dentro la sua testa, solo io e lei, e ho accettato di unirmi all'Hexenzirkel, lì su due piedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Era piuttosto felice della mia decisione, ma... Beh, sostiene che, dopo averle parlato nella mente, nei giorni successivi ha avuto un tale mal di testa da dover consultare un medico a Liyue per trovare sollievo. Ma non può certo incolpare me per questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
