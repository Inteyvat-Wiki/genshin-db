					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "Quello è un albero dell'Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Oh, questo dipinto? Quindi conoscete gli alberi bianchi... Sapevate che il tradimento del primo angelo avvenne proprio sotto i rami di uno di questi alberi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Non lo sapevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Uh, ora Paimon è curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Bene, credo sia finalmente giunto il momento di raccontarvi una storia di amore e orrore. Fatemi pensare a come proteggere al meglio l'identità delle persone coinvolte... Ecco, ci sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "Tanto, tanto tempo fa, c'era un viaggiatore che vagava tra le stelle. Non era per niente come te... ma questo è irrilevante, per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Un giorno egli viaggiò fino a un albero argenteo per far visita alla Principessa della Stella del mattino. Non passò molto che iniziò a interrogarla sui segreti più proibiti del suo regno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Le sue parole lasciarono perplessa la Principessa. Come poteva conoscere tutte quelle cose che gli dèi avevano proibito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Il giovane rivelò le sue origini e mostrò alla Principessa cose che lei non aveva mai visto prima: il libero arbitrio e l'amore, tanto nobili quanto spirituali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Le sue parole risvegliarono in lei la consapevolezza di sé, fino ad allora incatenata dagli dèi. Il suo cuore si levò in volo, portandola oltre limiti che non aveva mai osato varcare prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "La Principessa della Stella del mattino confidò i segreti del regno al giovane, e tra loro l'amore crebbe e sbocciò, insieme alla determinazione di sfidare gli dèi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "È solo una banale storia d'amore! Avevi detto che ci sarebbe stato dell'orrore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Non preoccuparti, Paimon, l'orrore inizia adesso. Entrambi desideravano ardentemente aiutare la gente a vivere in libertà assoluta, ma gli dèi non potevano perdonare il loro tradimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Scatenarono tuoni e furia, distruggendo la dimora dei due amanti. E quando la grande guerra si placò, il potere e la saggezza della Principessa andarono perduti per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Persino le sue amiche più care furono maledette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "Ehm, sì... Il finale si è rivelato piuttosto terrificante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Ma non avevi detto che ci avresti parlato del primo angelo? E inoltre... N-Non starai mica dicendo che questa storia è vera, giusto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Certo che lo è, ed è questo che la rende davvero spaventosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Bene, credo sia finalmente giunto il momento di raccontarvi una storia di amore e orrore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Fatemi pensare a come proteggere al meglio l'identità delle persone coinvolte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Ecco, ci sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Mi suona familiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
