							-26.859
						],
						"pointId": 31
					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "Ah, siete qui! Stavo giusto iniziando a chiedermi se avrei dovuto inviarvi istruzioni più chiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Ma poi ho pensato: se rendo i miei suggerimenti troppo ovvi, potrei intralciare i loro piani di viaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "#E poi, mentre camminavo avanti e indietro, tormentandomi su cosa avrei dovuto fare... siete {F#arrivate}{M#arrivati} comunque! Quindi, alla fine, è andato tutto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Ehi, Nicole! Oggi sei davvero piena di energia! E... anche di... cose da dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "#Lo prendo come un complimento! Bene, allora, siete {F#pronte}{M#pronti} ad ammirare la mia prossima stanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
