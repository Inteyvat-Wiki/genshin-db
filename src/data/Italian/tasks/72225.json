			},
			"dialogs": [
				{
					"id": 722250101,
					"content": "Ahia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}, Paimon! Arrivate proprio al momento giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250103,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "Ahi, ahi, ahi, credo di essermi slogato la caviglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250105,
					"content": "Fratello Ku si è di nuovo fatto male. Potresti aiutarci a fare delle offerte al trespolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250106,
					"content": "Devo ammettere che mi aspettavo potesse succedere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "Non preoccuparti! Ci pensiamo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250109,
					"content": "Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250110,
					"content": "Oooh, giusto! Tu sei molto attento agli elementi, vero, Ruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250111,
					"content": "Perché non puoi farlo tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250112,
					"content": "Mm... In realtà, ci ho già provato durante alcuni rituali, ma non è andata a finire molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250113,
					"content": "Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "Io... Non lo so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250117,
					"content": "Bene. Suppongo che ci occuperemo di questa faccenda del trespolo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250115,
					"content": "Allora lo farò io al tuo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "Lasceremo fratello Ku a te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
			"id": 7222502,
