			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu",
					"Ku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Wow, il trespolo è completamente illuminato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250302,
					"content": "Problema risolto. Mi dispiace, immagino non sia stato un gioco da ragazzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250303,
					"content": "Eheh! Risolvere i problemi è la cosa che sappiamo fare meglio, non lo sapevi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250304,
					"content": "Non era poi così diverso dal rituale di attivazione della luce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Andare in tre posti per risolvere problemi secondari al fine di risolvere il problema principale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250306,
					"content": "Non è la prima volta che ci capita una cosa del genere, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250307,
					"content": "Non ho capito molto il tuo discorso, ma gli adulti hanno un detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250308,
					"content": "Si chiama la regola del tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250309,
					"content": "Mm, che significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250310,
					"content": "Beh, significa che per ottenere un risultato, devi fare una cosa tre volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250311,
					"content": "Per esempio, si dice che i buoni presagi debbano verificarsi tre volte affinché la fortuna arrivi davvero... Lo stesso vale per i cattivi presagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250312,
					"content": "E si dice anche che devi superare gli ostacoli tre volte, per riuscire al quarto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250313,
					"content": "Allora dovrebbe chiamarsi la regola del quattro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250314,
					"content": "Ah, giusto! Sei davvero brava con i numeri, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250315,
					"content": "Hihi, ovvio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250316,
					"content": "E qual è il punto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "In ogni caso, pensi che Ku starà bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250319,
					"content": "Non preoccupatevi, Ku si fa male in continuazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250320,
					"content": "Uff, che imbarazzo... Spero solo che questo non influisca sul rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250321,
					"content": "Se succedesse, non riuscirei più a guardarti in faccia, Ruu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250322,
					"content": "Oh dai, non fare così! Sei sempre stato così carino con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}, Paimon, andate avanti voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250325,
					"content": "Io resterò qui con fratello Ku. Quando avrete finito, noi rimetteremo tutto in ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250318,
					"content": "A proposito, come sta Ku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
