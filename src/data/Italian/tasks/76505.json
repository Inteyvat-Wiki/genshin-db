			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}? Paimon? Che coincidenza! Ho sentito dire che eravate {F#partite}{M#partiti} per Nod-Krai, ma non pensavo di rivedervi così presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Eh, già! Paimon pensava quasi di avere le allucinazioni! Che ci fai così lontana da casa, Varesa? Ti sei messa in viaggio anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Eheh, diciamo di sì! Sono venuta ad acquistare un set di macchinari agricoli per il nostro orto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Papà dice che a Nod-Krai vendono cose che possono rendere i nostri frutti più buoni e salutari. Sai, così potrei avere più tempo per dormire... ehm, e allenarmi, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "E quando sono arrivata, ho trovato un saaacco di cose squisite introvabili a Natlan! Quindi, a parte gli incarichi ufficiali, ho trascorso la maggior parte del tempo a mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "Sinceramente, ora che è quasi ora di andare, mi dispiace un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Quindi, finché ne ho l'occasione, voglio andare un po' in giro e provare tutto quello che non ho mai provato, e vedere tutto ciò che non ho mai visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#E voi che mi dite? Indovino... {F#La nostra eroina}{M#Il nostro eroe} {NICKNAME} sta difendendo la giustizia in una nuova terra. Ho detto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Stiamo solo dando un'occhiata nei dintorni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Ooh, capisco, capisco! Quando si va in un posto nuovo, ci sono mille cose da vedere... Ti viene voglia di catturarle tutte con la Fotokamera, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "A proposito di fotografie... Argh! Dovrei scattarne di più a tutti i piatti deliziosi che sto mangiando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Così facendo, potrei chiedere a zio Atolli di ricrearli basandosi sulle foto, una volta tornata a casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Potresti scoprire di avere un futuro come fotografa di alimenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Eheh, dici sul serio? Una fotografa di alimenti... Sembra un lavoro interessante, devo dire! Potrei venire in contatto con del buon cibo ogni giorno e fotografarlo nel suo momento più appetitoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Ma prima che tu vada a scattare foto di cibi deliziosi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Eh? Volete farmi una foto? Dite sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "A-Aspettate. Non ho i capelli in disordine, vero? Ho mica della salsa intorno alla bocca? Uuuh, se avessi saputo che vi avrei incontrato, mi sarei messa alcuni degli accessori che ho comprato al mercato ieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Sei perfetta così come sei ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "D-D'accordo, allora lascio fare a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Il tuo sorriso basta e avanza per una foto perfetta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Ti spiace se ti scattiamo una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
