				{
					"id": 722080201,
					"content": "Grazie mille! Ora posso finalmente salire a bordo della barca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "A proposito, dov'è diretta quella barca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "#Verso la terra dell'oro, la terra dei sogni. Un regno senza nebbia. Ci rincontreremo nei sogni, stranier{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				}
			]
		},
