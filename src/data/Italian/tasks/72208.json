			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Ci sai fare con la pesca, ma puoi ancora migliorare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "Cosa?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ahahah, scusa, scusa... Mi dimentico sempre di salutare. A volte mi dimentico che potrei spaventare la gente, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "A me sembra che la cosa ti diverta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "Oh, dai... Spaventare la gente di tanto in tanto è divertente, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "*tossisce* In ogni caso, torniamo a parlare di pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "Perché? È una faccenda seria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Beh, so che questo non è il momento migliore... Ma prima, mentre stavo pescando, mi è caduto l'amuleto che mi ha dato Makiri, il quale contiene le benedizioni dei suoi spiriti ancestrali e del grande Uccello del tuono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "Non saprei cosa dirle, se scoprisse che l'ho perso dopo che siamo saliti sulla barca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "Il tizio della barca dorata ha detto che avrebbe trovato delle persone per aiutarmi a cercarlo, ma non sembra che verrà qualcuno! Così ho pensato che, siccome sei qui, potresti aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "E io che pensavo che fossi un tipo affidabile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Di solito vado laggiù a pescare, ma... per qualche motivo la mia memoria sta peggiorando sempre di più, quindi temo che dovrò affidare a te la ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Dato che è un luogo di antiche memorie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "Eh? Cosa intendi? È forse un metodo che usate voi stranieri per trovare gli oggetti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "*sospira* Beh, in ogni caso, se trovi il punto giusto, dovresti riuscire a trovare anche l'amuleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "Come posso cercare l'amuleto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Ehm... Potresti provare a pescarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "Sì, potrebbe funzionare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "#Grazie, stranier{F#a}{M#o}! Che il grande Uccello del tuono e i nostri antenati ti proteggano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Suppongo che mi serviranno le \"piume\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Sei un caso disperato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "C'è un'isola a ovest delle Piane d'Autake che fronteggia tre cascate. L'amuleto dovrebbe trovarsi nel mare a ovest di quella piccola isola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "Ti piace davvero tanto pescare, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "La prossima volta che decidi di comparire all'improvviso, che ne dici di iniziare dai saluti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
