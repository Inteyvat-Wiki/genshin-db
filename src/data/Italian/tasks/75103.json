			"dialogs": [
				{
					"id": 751030101,
					"content": "Porca pupazza, quanto pesce che c'è qui! Che state combinando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Mh? Oh, ciao, {F#sorellona bionda}{M#fratellone biondo}! E ciao anche a te, ehm... sorellina... bianchina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Io e Iwai stiamo aspettando che i pinguini Solcacorrenti tornino a riva. Non possiamo fare molto altro, a dirla tutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Che tornino a riva? Sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Huooo, ruooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Va bene, Iwai, vieni qui. Sei proprio bravissimo, lo sai? Ora fai il bravo, non avere fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Roo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Vedete, la nostra idea era venire qui a giocare. Nessuno viene qui a parte zio Rongo, per noi è come una specie di base super segreta... o qualcosa del genere, comunque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Non ci aspettavamo che quegli uccelli ci avrebbero battuto sul tempo, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Ecco perché ho portato tutto questo pesce: per attirarli qui. I pinguini Solcacorrenti ne sono golosissimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Davvero? Non ne sembrano molto attratti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Già. Magari siamo troppo lontani e l'odore non gli arriva... Se solo potessimo attirarli a riva in qualche modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Se zio Rongo fosse qui, direbbe qualcosa tipo: <color=#00E1FFFF>\"Spingili a riva, è tanto semplice!\"</color>... Io e Iwai non abbiamo la forza fisica per riuscirci. Ce le darebbero sode, poco ma sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Uhm... Perché non ci proviamo noi, {NICKNAME}? Se riusciamo a farli venire a riva, forse si lasceranno attrarre dai pesci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Ho capito. Quindi \"Paimon\" è una specie di pinguino Solcacorrenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Perché è rotondetta e ghiotta di pesci... Sì, in effetti potresti avere ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmh! Mmmh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "Cosa?! No! Sentite, torniamo al discorso di prima: quindi, non siete riusciti ad attirarne neanche uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
