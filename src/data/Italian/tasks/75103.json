					"content": "#Wow, sono venuti davvero! Grazie mille, {F#sorellona bionda}{M#fratellone biondo}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031102
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751031102,
					"content": "Huooo, roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031103
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751031103,
					"content": "Ho preparato tutto questo pesce per attirare da questa parte tutti i pinguini Solcacorrenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751031104,
					"content": "Hihi, andiamo a <color=#00E1FFFF>spingere a riva quei pinguini</color> come abbiamo fatto prima, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pania"
				}
			]
		}
