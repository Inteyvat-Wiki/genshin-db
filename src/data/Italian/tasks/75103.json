			"dialogs": [
				{
					"id": 751030401,
					"content": "Grazie davvero! Ora che i pinguini sono impegnati a mangiare il pesce, finalmente io e Iwai possiamo giocare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030402
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030402,
					"content": "Huooo, roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030403,
						751030404
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030403,
					"content": "È stato un piacere poter essere d'aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030406
					]
				},
				{
					"id": 751030406,
					"content": "Ci vediamo, allora! Se vi va, venite pure a giocare con noi quando volete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030404,
					"content": "Anche Paimon sembra attratta da quei pesci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030405
					]
				},
				{
					"id": 751030405,
					"content": "N-Non è vero! Col cavolo che Paimon si lascerebbe attirare da un ingrediente non ancora deliziosamente cucinato! Nossignore, no no!",
					"roleType": "TALK_ROLE_NPC",
