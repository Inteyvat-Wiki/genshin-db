					}
				]
			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "Porca pupazza, è una tonnellata di pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "#Fermo! Non muoverti, {F#sorellona bionda}{M#fratellone biondo}! Quelli servono ad attirare i pinguini Solcacorrenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Uh. attirare i pinguini Solcacorrenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Sì! Io e Iwai stiamo aspettando che i pinguini Solcacorrenti tornino a riva. Non possiamo fare molto altro, a dirla tutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Huooo, ruooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Va bene, Iwai, vieni qui. Sei proprio bravissimo, lo sai? Ora fai il bravo, non avere fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Roo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Vedete, la nostra idea era venire qui a giocare. In fondo, nessuno viene qui a parte lo zio Rongo, per noi è come una specie di base super segreta... o qualcosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Non ci aspettavamo che quegli uccelli ci avrebbero battuto sul tempo, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Ecco perché ho portato tutto questo pesce: per attirarli qui. I pinguini Solcacorrenti ne sono golosissimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Davvero? Non ne sembrano molto attratti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Già. Magari siamo troppo lontani e l'odore non gli arriva... Se solo potessimo attirarli a riva in qualche modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Se zio Rongo fosse qui, direbbe qualcosa tipo: <color=#00E1FFFF>\"Spingili a riva, è tanto semplice!\"</color>... Io e Iwai non abbiamo la forza fisica per riuscirci. Ce le darebbero sode, poco ma sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Uhm... Perché non ci proviamo noi, {NICKNAME}? Se riusciamo a farli venire a riva, forse si lasceranno attrarre dai pesci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Ho capito. Quindi \"Paimon\" è una specie di pinguino Solcacorrenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Perché è rotondetta e ghiotta di pesci... Sì, in effetti potresti avere ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Mmh! Mmmh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "Cosa?! No! Sentite, torniamo al discorso di prima: quindi, non siete riusciti ad attirarne neanche uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
