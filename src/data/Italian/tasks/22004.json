				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "Spero di riuscire a prendere qualche pesce, prima o poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Mi preparo a tirare su il pesce più grosso che tu possa mai vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040104,
					"content": "Ho un amico a cui piace cucinare. Se riuscissi a pescare un bel pesce grosso, scommetto che lo renderei felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040105,
					"content": "Il problema è che i mostri creano continuamente scompiglio, il che disturba i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040106,
					"content": "Percepisco un forte potere elementale in te. Vorresti occuparti dei mostri per me, così posso finalmente prendere quel pesce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040112,
					"content": "Come fai a sapere quando i mostri arriveranno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040113,
					"content": "Vedere per credere. Attenzione, dietro di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040114,
					"content": "Ahah! Questo è il trucco più vecchio del mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040109,
					"content": "Come si fa a capirlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "Anch'io avevo una Visione, un tempo. Non la uso più, ma posso ancora percepire il potere elementale, se voglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040111,
					"content": "Con il potere degli elementi dalla tua parte, non dovresti avere nessun problema a sconfiggere quei mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "Tu... tu li hai sconfitti! Com'è possibile, Paimon non ti ha visto muovere un dito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Dicci la verità: tu chi SEI?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Sono solo un pescatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Mmmh... Non ha senso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Hai ragione, non lo ha. Molte cose in questo mondo non hanno senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Prendi ad esempio il cuoco della locanda: prima era uno spadaccino, ora fa il cuoco. Ha una faccia di bronzo, ma un cuore d'oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "Lo stesso vale per la proprietaria della locanda: vive a Mondstadt, ma gli abitanti di Mondstadt non la conoscono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Anche tu sei un esempio: non hai una Visione, ma puoi ugualmente usare il potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Molte cose non hanno senso, ma ciò non significa che devono diventare fonte di preoccupazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Ecco, prendi, in segno di ringraziamento. Ora voglio riprendere a pescare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}