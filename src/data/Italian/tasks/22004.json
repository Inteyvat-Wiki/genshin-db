	"talks": [
		{
			"id": 2200401,
			"completionStepIds": [
				2200401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200401",
							"2"
						],
						"stepId": 2200401,
						"stateName": "QUEST_STATE_UNFINISHED"
