				"objectNames": [
					"Zio Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711051101,
					"content": "#Se non c'è altro, vi lascio {F#libere}{M#liberi} di guardarvi intorno quanto volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711051102,
					"content": "Quindi davvero non esiste nessuno di nome Xiangjun...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Chiederò in giro, dev'esserci stato qualche fraintendimento. Forse qualcuno si è confuso sul nome del posto in cui vive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711051104,
					"content": "A ogni modo, vi ringrazio di aver aiutato quell'Adeptus a innaffiare le sue erbe. Sono certo che in cambio vi difenderà da qualsiasi minaccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zio Luo"
				}
			]
		}
	]
}