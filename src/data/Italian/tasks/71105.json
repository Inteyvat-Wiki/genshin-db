			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1235.081,
							205.769,
							1930.251
						],
						"pointId": 311400096
					}
				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Mmm... Dovrebbe essere questo il posto, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Perché non c'è nessuno? Non ci sono neanche tracce da seguire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Forse è già tornato indietro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Paimon non crede. È ferito, come avrebbe fatto a camminare tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Però è vero che qui non c'è.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Forse si è imbattuto in qualcuno che lo ha portato in salvo? Paimon pensa che potrebbe essere andata così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Forse è meglio tornare al Villaggio di Qiaoying e chiedere in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Prima prendiamo un po' di quest'acqua sacra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Eh? Oh, giusto. Se il nonno di Xiangjun è in salvo, potrebbe avere ancora bisogno di questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Già che lo stiamo aiutando... Sei proprio gentile, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zio Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "#Ah, sei tu, {F#viaggiatrice}{M#viaggiatore}, sembri di gran fretta. C'è qualche problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050802,
					"content": "Beh... Zio Luo, sai per caso dove vivono Xiangjun e suo nonno? Li stiamo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun? Mai sentito questo nome prima d'ora. La ragazza è di queste parti? Credevo di conoscere tutti al villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050804,
					"content": "Com'è possibile? Abbiamo incontrato questa ragazzina che dice di chiamarsi Xiangjun e di vivere al Villaggio di Qiaoying. Ci ha chiesto di aiutarla a ritrovare suo nonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "E ha anche una grossa zattera di bambù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Beh, zattere di quel tipo si vedono spesso da queste parti... ma Xiangjun... Non credo di conoscere nessuno con quel nome al villaggio. Sapete come si chiami il nonno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050807,
					"content": "Sappiamo che è un erborista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Un erborista? Fatemi pensare. Una volta ne avevamo uno, ma... è morto circa tre anni fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050809,
					"content": "Morto? Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Già, si è imbattuto in dei mostri mentre vagava per i sentieri... *sospira* Ma non credo sia la stessa persona che state cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050811,
					"content": "Era un tipo strambo, che non si è mai sposato. Non credo quindi che avesse nipoti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050812,
					"content": "Aspetta... Ma allora... La Xiangjun che abbiamo incontrato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "...Se fosse lei il demone?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Che tipo di erbe raccoglieva il vostro erborista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Fiori ed erbe che noi non avevamo mai visto prima. Non me ne intendo granché, quindi non sono molto di aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050816,
					"content": "Mi ricordo però che lo trovammo nei pressi del Monte Xuanlian, che stringeva ancora in mano una bottiglietta d'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050817,
					"content": "Sosteneva di avere una pianta in giardino da innaffiare con quella specie di acqua sacra. Tutte frottole, per quanto mi riguarda: non era altro che banale acqua di fiume, uguale a qualunque altra! Non capisco come qualcuno possa rimetterci la vita per una roba del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050818,
					"content": "*sospira* A ogni modo, dopo averlo seppellito, abbiamo versato quella boccetta d'acqua nel suo giardino. Spero abbia dato sollievo al suo spirito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050819,
					"content": "L'acqua sacra del Monte Xuanlian? Anche noi abbiamo raccolto dell'acqua in quel posto... Quindi quel vostro erborista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Credo che stiamo parlando della stessa persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Sì, troppe coincidenze, non credo ci sia un errore... Perché non venite con me? Vi porto nel giardino di quel poveretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Zio Luo"
				},
				{
					"id": 711050822,
					"content": "Se anche voi avete raccolto dell'acqua, potete sempre versarla nel suo giardino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zio Luo"
				}
			]
		},
		{
			"id": 7110511,
			"completionStepIds": [
				7110511
			],
