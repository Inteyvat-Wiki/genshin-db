					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"Mi sono addormentato! Non posso crederci, devo rientrare prima di domani o nessuno baderà a Xiangjun... Che idiota!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050202,
					"content": "\"Se ricordo bene c'è una scorciatoia, una stradina che conduce dalla Valle Yaodie al Monte Xuanlian. Devo solo superare quella, poi una grotta di montagna e dovrei esserci...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050203,
					"content": "\"Ho sentito dire che ci sono dei mostri in quell'area, ma devo almeno provarci...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050204,
					"content": "Quest'oggetto ha l'aria di qualcosa che può aver perso suo nonno. Sembra che abbia preso una stradina, andiamo a dare un'occhiata anche lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"È dall'inizio che sono in ansia per i mostri, ma...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050502,
					"content": "\"Ma che... La mia gamba... Non posso fermarmi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050503,
					"content": "\"Così tanto sonno... Ma il Monte Xuanlian è proprio lì sopra... Xiangjun, vedrai, troverò l'acqua sacra...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050504,
					"content": "\"Xiangjun... Troverò l'acqua sacra...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Appunti di qualcuno"
				},
				{
					"id": 711050505,
					"content": "Oh, no... Dei mostri l'hanno attaccato e sembra sia stato gravemente ferito... Nonostante questo, vuole ancora cercare l'acqua sul Monte Xuanlian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Sbrighiamoci, Paimon spera che potremo aiutarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110506,
			"completionStepIds": [
				7110506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
