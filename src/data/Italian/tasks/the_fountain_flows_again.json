						"pointId": 340200033
					},
					{
						"sceneId": 3,
						"position": [
							3695.918,
							485.64,
							3626.725
						],
						"pointId": 340200104
					}
				]
			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "Eccoci qui, mettiamoci al lavoro. Questa fontana è rimasta spenta fin troppo a lungo. È ora di rimetterla in funzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "I due si mettono all'opera con zelo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "La valvola è stata installata. Ho anche effettuato un esame di quello che non va, e non c'è nessun guasto importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Bene. Allora, fermiamoci un momento. L'ultima cosa che resta da fare è aprire la paratoia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Vediamo un po'... Quella principale è qui, e anche la paratoia secondaria dev'essere regolata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Aspettatemi qui. Apro le paratoie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Ma chi ha progettato questo sistema? Perché hanno messo le paratoie principali tanto lontane...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel si precipita alle paratoie principali e torna poco dopo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Argh, aprirle è stato davvero complicato. Che stanchezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Aspettiamo. L'acqua dovrebbe iniziare a scorrere a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Dopo alcuni ronzii sordi, la fontana riprende a funzionare normalmente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Grandioso! La fontana sta funzionando di nuovo... Ora, anche se Keratry parlerà di quel che è successo quella sera, posso far finta di non sapere di cosa stia parlando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370813,
					"content": "Ora sai che devi fare attenzione con gli spettacoli di magia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Non è affatto un problema causato dalla magia... ma grazie comunque. Ecco. Questo è quello che ho da parte, è per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370816,
					"content": "C'è anche il pagamento che ti ho promesso. Grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370817,
					"content": "E grazie anche a voi, Edel ed Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370818,
					"content": "Ho solo fatto il mio lavoro. La prossima volta, non portare fuori la tua sorellina nel cuore della notte... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Remaudière! Che ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry?! E che ci fai tu qui? Non sei... non dovevi andare a fare una passeggiata con mamma e papà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370821,
					"content": "Eheh... Sono scappata via mentre non guardavano. Volevo vedere cosa era successo alla fontana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Ma non l'avevi fermata con la magia? Pensavo che non avesse ancora ripreso a scorrere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Ahah... Ehm... Eheh... La magia ha i suoi limiti, sicuramente lo sai, vero? Funziona solo per un certo periodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370824,
					"content": "Oooh... Allora voglio vedere altra magia! Puoi interrompere di nuovo il flusso d'acqua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Ecco, eh... *tossisce* Keratry, ci sono un sacco di persone qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370826,
					"content": "Se la fermo di nuovo, tutta la gente che vuole guardarla ne resterà turbata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370827,
					"content": "Beh... Possiamo anche tornare dopo! E portiamoci anche mamma e papà. Sicuramente anche loro vorranno vederti esibire in un numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Eh?! No, è... Sorellina, non sono ancora... un super esperto di questa magia della fontana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370829,
					"content": "Sicuramente i nostri genitori non vogliono scomodarsi per un'esibizione blanda e inesperta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370830,
					"content": "E per questo non devi parlare a mamma e papà della mia \"magia della fontana\", almeno per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370831,
					"content": "Voglio capirla per bene prima di preparare uno spettacolo sorprendente per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370832,
					"content": "Va bene! Sicuramente ne saranno entusiasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Certo, sicuramente. Ma torniamo prima a casa, va bene? Posso... posso mostrarti dei nuovi trucchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370814,
					"content": "Ora lo sai che magia e miracoli hanno un prezzo da pagare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
}