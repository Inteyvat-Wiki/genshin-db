			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Queste tubature vanno sostituite... e le valvole... bisognerà pensare anche alla pulizia... *sospira* Problemi su problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Eh? Ti serve qualcosa? A giudicare dal tuo aspetto... Non sei la squadra di riparazione di Estelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "A proposito di Remaudière...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Eh, lui? Eh, la sua magia è davvero impressionante. Ha fatto arrugginire una valvola delle tubature inferiori e rotto completamente la bocchetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Ahahah, sto scherzando. A dire il vero, è stata la valvola deformata a rimanere bloccata e a intasare tutto l'impianto idrico. Abbiamo spento la fontana per ragioni di sicurezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Ma perché si è rotto il beccuccio? Non lo so davvero... È così strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudière continua a dire che se la fontana non sarà riparata quanto prima gli daranno una bella strigliata... Ma più di così non potevo fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Oggi ho finalmente avuto un po' di tempo per ordinare una nuova valvola e un nuovo beccuccio da Estelle, e sto per andare in città a prenderli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Potete venire con me se volete. Ho parecchia roba da prendere, quindi sono un po' preoccupato di non riuscire a farcela da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
