			"dialogs": [
				{
					"id": 740370101,
					"content": "*sospira* Perché Edel non ha ancora riparato questa fontana...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370102,
					"content": "Se non verrà riparata quanto prima, Keratry griderà tanto forte che lo saprà tutta Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370103,
					"content": "Questa fontana è rotta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "*sospira* Pochi giorni fa funzionava bene, ma ora si è fermata di colpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370105,
					"content": "Quel che è peggio, si è rotta proprio quando stavo per eseguire i miei numeri di magia per Keratry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370106,
					"content": "Quand'è successo i miei genitori erano a teatro, e mi avevano chiesto di stare a casa con mia sorella e d'intrattenerla con giochi o libri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370107,
					"content": "Ma Keratry non la smetteva di assillarmi perché la facessi uscire. Non sono riuscito a calmarla e alla fine l'ho portata fuori a giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370108,
					"content": "Quando siamo arrivati alla fontana, Keratry se n'è uscita con l'idea di voler aspettare i genitori all'uscita da teatro, e tornare a casa a piedi assieme a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370109,
					"content": "Non è una brutta idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Sì. Paimon pensa che, visto che avevate già fatto tutta quella strada, se foste andati ad aspettare i vostri genitori fuori dal teatro vi avrebbero comprato qualcosa di goloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Si era già fatto molto tardi... Se i miei avessero scoperto che avevo portato fuori mia sorella di sera, mi avrebbero dato una strigliata coi fiocchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370112,
					"content": "Quindi ho raccontato una piccola bugia a Keratry... Le ho detto che conoscevo un numero di magia che avrebbe fermato lo zampillo della fontana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370113,
					"content": "Conoscevo gli intervalli di tempo tra gli spruzzi d'acqua, e volevo farla divertire per poi riportarla a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370114,
					"content": "Ho calcolato correttamente quando la fontana si sarebbe fermata, e mia sorella si è bevuta la storia della \"magia\". Per tutto il tragitto verso casa non ha smesso di chiedermi d'insegnarle questo \"incantesimo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370115,
					"content": "Così, dopo averla riportata a casa mi sono inventato qualcosa per soddisfare la sua curiosità, e l'ho messa a letto prima di tornare in camera mia. Mamma e papà sono tornati poco dopo, e sembrava tutto normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370116,
					"content": "Ma il giorno dopo, quando sono uscito per ritirare il giornale di papà, mi sono accorto che la fontana non stava ancora funzionando... Si era rotta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370117,
					"content": "La tua magia è piuttosto potente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Forza, non scherzare! Se Keratry lo dicesse a mamma e a papà, sarei fritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370120,
					"content": "\"Eh? La fontana nella piazza si è rotta? Cosa ne pensi, caro?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370121,
					"content": "\"È... molto strano. Sembrava a posto prima che andassimo a teatro quella sera.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370122,
					"content": "\"So io il perché! L'ha fatta fermare Remaudière! Giusto?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370123,
					"content": "Bene, complimenti davvero!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Inoltre, scopriranno che io e mia sorella eravamo usciti di sera, e poi mi sgrideranno così tanto che sarò in punizione per i prossimi due mesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370126,
					"content": "Ma... non c'è nessuno che si occupi di questa fontana? Se si rompe, non possono semplicemente chiamare qualcuno per ripararla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Gliel'ho detto al gestore della fontana, Edel, e mi ha promesso che ci avrebbe pensato al più presto. Ma... a tutt'oggi il problema non è stato risolto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370128,
					"content": "Non posso nascondere la situazione ancora per molto, sono finito, kaputt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370129,
					"content": "Ci andrò a parlare io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "Davvero? Vuoi aiutarmi? In tal caso, ti darò la mia... paghetta di riserva, tutta quanta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370132,
					"content": "Edel è laggiù. Sbrigati, per favore! Va' a chiedergli cosa sta succedendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370130,
					"content": "Oh, non è così grave. Ti darò una mano io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Grazie alla tua esibizione intensa e appassionata, ora comprendo completamente la situazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Come ci si aspetta da un potente mago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Mentre osservi la fontana, arriva qualcun altro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
