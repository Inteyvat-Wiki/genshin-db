			},
			"dialogs": [
				{
					"id": 740370701,
					"content": "Questi dovrebbero bastare! Dammi solo un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle inizia a lavorare freneticamente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Ok, fatto! Abbiamo la valvola, la bocchetta e tutti gli altri componenti che ci servono. Tutto pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "#Edel, viaggiat{F#rice}{M#ore}, andiamo a Érinnyes. La fontana sarà riparata in un batter d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "#Grazie... Viaggiat{F#rice}{M#ore}, muoviamoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
			"id": 7403708,
