			"dialogs": [
				{
					"id": 150251001,
					"content": "Guardate questo panorama. Cosa ve ne pare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251002,
					"content": "È stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Ora provate a guardare un po' più in là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251004,
					"content": "Wow... Quel graffito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Sin dalla fondazione della nostra tribù, quei colori ci hanno accompagnati in ogni passo della nostra storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251006,
					"content": "È vero, la mia volontà è dare nuova linfa all'antica tribù tramite il cambiamento e le riforme. Ma sono conscio del fatto che non possiamo gettare via le nostre fondamenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251007,
					"content": "La prima delle quali è il modo in cui documentiamo la nostra storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251008,
					"content": "In effetti, è giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Fin dall'inizio, la nostra tribù ha cercato di donare colore alla storia, e sono profondamente convinto che sia una parte della nostra cultura a cui non dovremmo rinunciare in alcun modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251010,
					"content": "Pertanto, costi quel che costi, il mio dovere è assicurarmi che la nostra produzione di rotoli di tessuto tradizionali venga preservata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251011,
					"content": "Hai perfettamente ragione. Paimon chiede scusa per ciò che ha detto prima. È stata indiscreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Non fa nulla. Mi fa solo piacere che abbiate capito il mio discorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150251013,
					"content": "Ti aiuteremo a trovare una soluzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Allora speriamo che, la prossima settimana, riusciremo a far rivivere questa tradizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				}
			]
		},
