			"dialogs": [
				{
					"id": 150250101,
					"content": "Presumo che voi siate le persone nominate dall'Anziano Tlapo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Infatti! Tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Chiamatemi Toltec. Il capo mi ha chiesto di farvi da guida per quest'oggi. I suoi emissari mi hanno già informato. Seguitemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#Non ci siamo già {F#state}{M#stati}, qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "#Sì, ma non dimenticare che siamo {F#state scelte}{M#stati scelti}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "La cosa curiosa è che i nostri antenati non hanno mai rimosso il sigillo nemmeno dopo aver portato a termine i graffiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Da quando il luogo è stato sigillato, l'unica persona a esservi entrata è la grande sciamana Huitzilin, ben duecento anni fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Stando alle sue parole, l'opera rappresenta la storia di un eroe chiamato Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "...Ma sto divagando. Scusatemi, è che sono un grande appassionato di graffiti, potrei stare a parlarne per ore e ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Sei proprio sicuro di non voler venire con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Sì. Ci ho già provato una volta, ma il sigillo mi ha sbarrato la strada. Ho provato a farlo rimuovere dal mio Iktomisauro coi suoi poteri, ma non ha funzionato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Credo sia stato lasciato lì dai nostri antenati come prova. Se non riesci a superarla, vuol dire che non sei degno di ammirare i loro capolavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Non vi preoccupate. Anche se potessi, per stavolta non verrei comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "A differenza del nostro capo, io non ho il coraggio di sfidare le tradizioni. Si tratta di un compito che vi è stato assegnato direttamente dal nostro Anziano Iktomisauro. Chissà cosa potrebbe mai accadermi, se venissi con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Giusto. Va bene, cercheremo di fare presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
