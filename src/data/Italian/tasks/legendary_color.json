						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Guardate, questo è un rotolo di tessuto creato dai nostri antenati. Noi dovremo realizzare qualcosa di simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250702,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "La persona raffigurata è Huitzilin, la sciamana leggendaria. Visse duecento anni fa, e come voi venne nominata dall'Anziano Iktomisauro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250704,
					"content": "Era molto abile nell'arte della manipolazione cromatica, e ovviamente portò a termine il suo incarico con grande successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250705,
					"content": "Questo rotolo racchiude le sue gesta, e molto probabilmente è stato realizzato personalmente da lei. La qualità è a dir poco straordinaria, anche a confronto con altri rotoli del medesimo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250706,
					"content": "Sfortunatamente, dopo la sua dipartita, tutti coloro che sono stati nominati dall'Anziano Iktomisauro hanno dovuto affidarsi al \"dono degli spiriti\" per completare il proprio lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250707,
					"content": "Ma ora tu stai per ridar vita a un'antica tradizione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "Messa così fa un certo effetto. C'è solo una cosa che cambierei nella tua frase: non sarò solo \"io\" a farlo, ma \"noi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250709,
					"content": "Uuuh, ora Paimon si sta esaltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Porta pure i campioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250711,
					"content": "Un'assistente porta i campioni per le prove di tintura.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "Dunque... Come ti ho accennato, il processo di tintura è un po' complesso, ma sono sicuro che te la caverai. Dovrai solo seguire le mie istruzioni con attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250713,
					"content": "Tutto chiaro. Possiamo iniziare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Il motivo è già stato abbozzato sul campione, devi soltanto colorare ciascuna forma col colore giusto. Ma aspetta che ogni tintura si asciughi a dovere prima di passare alla successiva, onde evitare sbavature di colore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250715,
					"content": "(Colora il tessuto seguendo le istruzioni.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Bene. Il tessuto ha assorbito il colore della tintura, e il motivo su di esso è nitido e chiaro. Ora bisogna applicare la tintura restante e dovremmo poter scorgere quel colore così sfuggente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250717,
					"content": "Bene, siamo all'ultimo passaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Applica la tintura restante.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Ehm... Ha funzionato? Paimon non vede niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "Il colore non è venuto... Il processo di tintura è fallito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250721,
					"content": "Ho sbagliato qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "No, la tua tecnica è stata impeccabile. Hai seguito ogni passaggio nel modo più corretto. Se fossi stato al tuo posto, non ci sarebbe stata alcuna differenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250723,
					"content": "Allora cos'è andato storto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Forse è per via della tecnica di tessitura, oppure la tintura va applicata in modo diverso... Qualunque sia il motivo, non sono riuscito a venire a capo di questo mistero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250725,
					"content": "Oh, no... Paimon vorrebbe potessimo fare di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "Sono io a dovermi scusare con voi. Vi ho fatto lavorare così tanto per niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250727,
					"content": "#Ovviamente terrò fede al mio impegno e vi ricompenserò per il disturbo. Spero tuttavia che non rinuncerete a questo incarico. Ho intenzione di indagare oltre, e farò in modo di tenervi {F#informate}{M#informati} sui progressi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250728,
					"content": "Non preoccuparti, non ci arrendiamo così facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Paimon ha una domanda, però... Mmh, registrare gli eventi storici sui rotoli di tessuto sembra un processo davvero complicato. Non potete semplicemente metterli per iscritto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "Tu stesso hai detto di essere aperto al cambiamento e alle riforme. Beh, sarebbe un ottimo modo per iniziare, non credi? Scrivere le cose sarebbe molto più facile per tutti, e le vostre raccolte sarebbero molto più ricche di dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "...Credo tu abbia frainteso la mia filosofia, ma non fa nulla. Posso rispondere alla tua domanda, ma prima di farlo devo mostrarvi una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Capo dei Maestri del Vento della Notte"
				},
				{
					"id": 150250732,
					"content": "Ah... Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
