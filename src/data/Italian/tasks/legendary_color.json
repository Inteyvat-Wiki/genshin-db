			"dialogs": [
				{
					"id": 150251201,
					"content": "#Ricordi quando siamo {F#venute}{M#venuti} qua l'ultima volta? La caverna era tempestata di tutti quei capolavori. Gli antenati di questa gente erano veri e propri artisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251202,
					"content": "Probabilmente per dipingere usavano gli stessi ingredienti che usiamo noi per la tintura, vero? Forse anche noi creeremo un'opera d'arte tutta nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251203,
					"content": "Meglio se ci diamo da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251204
					]
				},
				{
					"id": 150251204,
