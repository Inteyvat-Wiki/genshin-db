					"content": "Credo sia stato lasciato lì dai nostri antenati come prova. Se non riesci a superarla, vuol dire che non sei degno di ammirare i loro capolavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250308
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250308,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250309,
					"content": "Non vi preoccupate. Anche se potessi, per stavolta non verrei comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250310
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250310,
					"content": "A differenza del nostro capo, io non ho il coraggio di sfidare le tradizioni. Si tratta di un compito che vi è stato assegnato direttamente dal nostro Anziano Iktomisauro. Chissà cosa potrebbe mai accadermi, se venissi con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250311
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250311,
					"content": "Giusto. Va bene, cercheremo di fare presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
