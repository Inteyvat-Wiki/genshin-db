			"dialogs": [
				{
					"id": 150250801,
					"content": "#Siamo {F#tornate}{M#tornati}! E abbiamo trovato gli ingredienti per la tintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250802,
					"content": "Sembra che abbiate oltrepassato il sigillo! L'Anziano Iktomisauro aveva proprio ragione su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250803
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250803,
					"content": "Si sta facendo tardi. Seguitemi, vi riporterò indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
