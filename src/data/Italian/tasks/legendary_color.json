			"dialogs": [
				{
					"id": 150250401,
					"content": "Dovremmo esserci! I frutti di cui parlava Toltec dovrebbero essere quelli su questo muro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250402,
					"content": "#Paimon non ci aveva fatto caso quando siamo {F#venute}{M#venuti} prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250403,
					"content": "Ora l'unica domanda è: quale prendiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250404,
					"content": "Immagino che la mia capacità speciale entri in gioco ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250405
					]
				},
				{
					"id": 150250405,
					"content": "Bene. Allora coraggio, prova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
