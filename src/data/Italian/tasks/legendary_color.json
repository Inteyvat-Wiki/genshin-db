			"dialogs": [
				{
					"id": 150251801,
					"content": "Gli antenati di questa gente hanno realizzato dei veri capolavori, qui dentro. Però, in base a ciò che abbiamo visto finora, sembra che la storia non finisca qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Tu pensi che ci siano altre opere, più avanti? Sembra un po' strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "Possiamo andare a controllare, se vuoi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Oh, non ce n'è bisogno... Paimon stava solo riflettendo a voce alta. Toltec ci aspetta qui fuori e noi abbiamo un lavoro da fare, quindi magari è meglio se ce ne andiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251807,
					"content": "Torniamo indietro da Toltec!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251805,
					"content": "Forse... Ma abbiamo un lavoro da fare, meglio concentrarci su quello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251806
					]
				},
				{
					"id": 150251806,
					"content": "Già, hai ragione. Rimanderemo alla prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				}
