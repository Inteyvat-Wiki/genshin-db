			"dialogs": [
				{
					"id": 150251501,
					"content": "Quindi la tintura è all'interno di questa caverna, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "Io non posso guidarvi più in là di così. Solo coloro che sono stati nominati possono procedere oltre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "E perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "È una storia un po' lunga. A quanto pare, in questa caverna crescono dei frutti dal cui succo è possibile ricavare una tintura di qualità eccelsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Molti anni fa, i nostri antenati partirono per creare un'ambiziosa serie di graffiti. Scelsero di realizzarla in questa caverna, forse proprio per la grande quantità di tintura disponibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Senonché, non volevano che altri si avvicinassero alla loro opera prima che fosse completata. Così, decisero di sigillare l'entrata per controllare gli accessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Per oltrepassare il sigillo bisogna aver padroneggiato l'arte della percezione cromatica, o una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251508,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
