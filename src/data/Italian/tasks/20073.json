				},
				{
					"id": 200730302,
					"content": "Il Picco del Drago è un luogo pericoloso. Non addentrartici troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730303
					],
					"speakerTitle": "Punto di rifornimento d'emergenza"
