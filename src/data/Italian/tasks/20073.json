			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Hai posizionato tutte le scorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Sono tutte dove devono essere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Magnifico, allora posso stare tranquillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Comunque, spero che coloro che salgono sulla montagna siano sufficientemente preparati e che non debbano ricorrere a quei viveri di emergenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Ora che ci penso, i tuoi vestiti sembrano un po' troppo leggeri. Per caso si tratta dell'ultima moda di Mondstadt o qualcosa di simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "A ogni modo, prendi questi come segno della mia gratitudine e vai a metterti qualche strato di vestiti in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
