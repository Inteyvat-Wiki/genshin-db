	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "#Viaggiat{F#rice}{M#ore}! Che tempismo perfetto. Potresti farmi un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Cosa ti serve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Come avrai certamente visto, le condizioni quassù sono terribili. Le insidie che si nascondono sul Picco del Drago sarebbero troppo anche per gli avventurieri più esperti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Ho ricevuto ordini dalla Gran Maestra Reggente di stare qui di guardia e avvertire i cittadini di non salire sulla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Tuttavia, per quanto sia stato in grado di convincere molti a non farlo, ci sono degli avventurieri che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Sono certo che tu sappia cosa intendo quando dico che non c'è stato modo di convincerli. Volevano salire sulla montagna a ogni costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Ho perso il conto di tutte le questioni che ho dovuto risolvere in cui c'entravano gli avventurieri... ma quelli continuano ad arrivare in gran numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Cercare di gestirli è impossibile... perciò ho deciso di preparare loro delle scorte e lasciarle in alcuni punti specifici sul Picco del Drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "In questo modo, gli avventurieri che sono stati costretti a fare marcia indietro e che si preparano a scendere dalla montagna avranno più possibilità di districarsi durante il rientro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Tuttavia, se qualche sciocco incosciente che vuole sfidare il destino dovesse salire troppo in alto, potrebbe contare esclusivamente su sé stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Perciò, potresti portare queste scorte sulla montagna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Allora conterò su di te. *sospira* Se solo quegli avventurieri fossero tanto abili con la spada e tanto ragionevoli quanto te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Ho segnato i tre punti specifici sulla tua mappa. Devi solo posizionare <color=#00E1FFFF>una porzione di prosciutto</color> in ognuno di essi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "*sospira* Quanto vorrei che quegli avventurieri avessero un po' più di sale in zucca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Saranno davvero utili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "È sempre meglio averle anziché no, questo è sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "In condizioni tanto tremende quanto quelle su questa montagna, le scorte non sono mai troppe. Detto ciò, conto sul tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
