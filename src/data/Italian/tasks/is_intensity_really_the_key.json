				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "Che freddo! Che freddo!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Eh? Freddo? Che dici? Sei seduto dentro a una sorgente termale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "No, no... Non è ancora abbastanza! Se voglio diventare il Campione, il Campione della Comunità dell'Abbondanza... Anzi, no, il Campione di tutta Natlan... Non posso accontentarmi di questo livello di temperatura! L'\"intensità\"... non è abbastanza elevata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Eh...? Perché ti risiedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Sembra che l'\"intensità\" non sia ancora sufficiente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "Ma che cos'è questa \"intensità\" di cui parli? Paimon non capisce una parola di quello che dici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Oh, voi dovete essere {F#le famose avventuriere}{M#i famosi avventurieri} {NICKNAME} e Paimon! Fantastico! Siamo salvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "Eh? Salvi? Cosa sta succedendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Va bene, sputerò il rospo. A detta del maestro stesso, egli è in viaggio per diventare il Campione. Per raggiungere l'obiettivo, si è completamente immerso in una specie di \"allenamento della sorgente termale\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Aspetta, allenamento? In una sorgente termale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Sì... So che può sembrare assurdo, ma ha avuto l'idea da un libro di arti marziali intitolato \"Il libro delle cinque sorgenti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "Il libro dice che se segui le sue istruzioni alla lettera, puoi <color=#00E1FFFF>fare bollire dell'acqua fredda</color> usando solo la tua \"intensità\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "E non è nemmeno la parte più assurda! Il libro è pieno di storie folli su personaggi leggendari delle arti marziali. Come quella di un tizio che ha bucato una montagna in una notte a suon di pugni; o quella di un altro che riusciva a frantumare le rocce a mani nude per trasformarle in pietre preziose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Paimon non avrebbe mai immaginato che esistessero delle arti marziali così incredibili! Se riuscissi a impararle anche tu, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Wow, sembrano storie uscite da dei romanzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Sentite, lo so che sembra ridicolo. Ma questo non è un libro qualsiasi. Il nostro maestro l'ha trovato tra le collezioni dei Maestri del Vento della Notte, quindi dev'essere vero. E soprattutto, lui ci crede con tutto sé stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "Ecco perché ha scelto questa sorgente termale, o meglio, questa sorgente \"non termale\". Il suo obiettivo è trasformare l'acqua gelida in una vera sorgente d'acqua calda usando nient'altro che la sua pura \"intensità\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Aspetta... È vero! L'acqua qui è fredda come un ghiacciolo! Ma non si ammala a rimanere in acqua così a lungo? Va bene che è forte, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Sì, esatto! E anche se non si ammala, di certo non può andare avanti per sempre. La nostra \"Sfida del guerriero\" è sospesa da giorni, e tutti stanno aspettando il suo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Ma il maestro continua a dire che rinunciare ora significherebbe che non ha abbastanza \"intensità\". Ha giurato che non uscirà finché l'acqua non inizierà a bollire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "La direzione delle terme non ha idea del perché l'acqua si sia raffreddata. Se solo avessimo degli avventurieri esperti che ci aiutassero... Guardate, ho persino preparato una ricompensa! È tutta per chiunque possa risolvere il problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Forse dovresti chiedere aiuto a qualcuno del Popolo delle Sorgenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Ehi, non rifiutiamola così in fretta e furia. Perlomeno vediamo prima quanto offre!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "Ehm, non preoccuparti, la faremo tornare una sorgente di acqua calda. Anche perché non possiamo lasciare il maestro immerso nell'acqua gelida fino ad ammalarsi. Aiutare le persone è ciò che fanno i bravi avventurieri, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Oh, grazie! Conto su di voi, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Tu resta qui. Ce ne occuperemo in men che non si dica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Stai davvero cercando di corrompermi con quella ricompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Non ci credi davvero... Vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Probabilmente è perché alzarsi in piedi gli fa sentire ancora di più il freddo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Anche Paimon la pensa così. Non c'è da stupirsi che tremi come una foglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
