			"dialogs": [
				{
					"id": 751780901,
					"content": "#Oh, ehi, {NICKNAME}, sei tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780902,
					"content": "Perché hai quell'aria abbattuta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "A dire il vero... l'acqua della sorgente termale sembra comunque più fredda rispetto a prima di tutta questa storia. Stavolta ho combinato un bel guaio. Cosa farò quando tornerò indietro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780905,
					"content": "Non preoccuparti, ci vorrà solo un altro po' di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "E va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 751780903,
					"content": "Ci vediamo in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Ehm... Stammi bene, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
