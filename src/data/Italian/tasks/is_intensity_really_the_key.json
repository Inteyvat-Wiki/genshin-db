			"dialogs": [
				{
					"id": 751780101,
					"content": "Ehi, ciao! Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Wow, che \"intensità\"! Proprio quello che uno si aspetta {F#dalle leggendarie}{M#dai leggendari} {NICKNAME} e Paimon! Siete {F#venute}{M#venuti} fin qua... Non ditemi che siete qui per competere per il titolo di \"Campione della Comunità dell'Abbondanza\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "\"Campione della Comunità dell'Abbondanza\"? Non è la normale \"Sfida del guerriero\"? Guarda tutte quelle persone là in fila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Ahah, loro non sono niente in confronto a voi. Per poter reclamare il titolo di Campione, dovete sconfiggere il Campione attualmente in carica. Le persone normali non hanno nemmeno la speranza di qualificarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Perciò è un bene che voi siate qui... Anche se il vostro tempismo non lo è tanto, temo. Il maestro al momento non ha tempo per attività mondane, per cui non è possibile incontrarlo di persona per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "Dov'è adesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Eh? Volete vedere il maestro per sfidarlo? Che mossa audace! In tal caso, vi dirò dove si trova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Viaggia lungo il percorso d'allenamento accidentato e incontrerai una regione montuosa ricca di \"Acque dell'intensità\". Forse lì troverai tracce del Campione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Ok, allora aspetteremo che torni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Ma certo, ma certo. L'\"intensità\" richiama altra \"intensità\". E la strada del Campione di sicuro si incrocerà con quella del nuovo Campione. Per cui sì, vi conviene aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
		{
			"id": 7517802,
