					"Yoleehe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "Qualcuno può darci una mano? Una persona è svenuta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Oh, no! Sembra che il maestro sia svenuto! Andiamo a dare una mano anche noi, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Sembra che il maestro sia solo svenuto per il caldo e non sia gravemente ferito. Con il tuo aiuto, Yoleehe lo porta in salvo ancora privo di sensi...\\nSi direbbe che il maestro debba migliorare la sua capacità di gestire l'\"intensità\"...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
