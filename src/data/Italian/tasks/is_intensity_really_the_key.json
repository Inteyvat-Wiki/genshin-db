			"dialogs": [
				{
					"id": 751781001,
					"content": "Mmm... Beh, avevamo già accettato di aiutare, ma da dove possiamo iniziare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781002,
					"content": "Che ne dici di fare un tentativo con il nostro magico Flogisto mistico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "Non funzionerà mai! L'area è troppo grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781009,
					"content": "*sospira* Non c'è una soluzione più realistica da poter provare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781010,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#Aspetta, {REALNAME[ID(2)|SHOWHOST(true)]}, non andartene in giro così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Probabilmente c'è molto magma nel vulcano qui vicino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Oh! Paimon ha avuto un'idea! Possiamo far scavare un tunnel al nostro piccolino e poi usare il magma per riscaldare la sorgente termale, no? È geniale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Roar! Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#...Oh, accicacchio, hai ragione! Potrebbero morire delle persone così! E la cosa peggiore è che {REALNAME[ID(2)|SHOWHOST(true)]} ti ha quasi creduto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
			]
		},
