			},
			"dialogs": [
				{
					"id": 751781401,
					"content": "Eh? Un piccolo Koholasauro? Cosa ci fa qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o...! Quindi eri qui, alla fine... Se non foste sbucati fuori in tempo, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "E se ti facevi male? Non scappare di nuovo così, ok? *tira su col naso*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "E-Ehi, su col morale! Non vedi che sta bene? Ha anche un sacco di energia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Sì, ehm... Ora sto bene. Ah! Mi sono dimenticata di presentarmi. Sono Linaha, del Popolo delle Sorgenti. Di solito mi occupo dei piccoli Koholasauri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Da sola? Incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "N-Non proprio... Se fossi più come te, signorina Paimon, probabilmente non sarebbero scappati in quel modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Pensavo che fossero andati tutti a giocare vicino ai condotti e alla fine avevo ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "Quindi la sorgente termale si è raffreddata perché i piccoli Koholasauri hanno bloccato tutti i condotti di Flogisto, eh? Ecco perché il custode non si è accorto di nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "In realtà... Ci sono altri due Koholasauri che non ho ancora trovato. Penso che anche loro si siano nascosti nei condotti di Flogisto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Lascia fare a noi! Troveremo gli altri piccoli Koholasauri mentre regoliamo la temperatura dell'acqua. Non preoccuparti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Davvero? Grazie! È bello averti qui, signorina Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Eheh, ma certo! Puoi sempre contare su una leggendaria avventuriera come Paimon! Sarà un gioco da ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Wow! Signorina Paimon, sei straordinaria! Voglio essere come te, un giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "Sono d'accordo, la grande signorina Paimon è davvero fantastica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Ehi, non mettere Paimon in imbarazzo davanti agli altri! Facciamo così: stasera Paimon ti lascerà il piatto migliore, ok?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Ahem! Comunque, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781417,
					"content": "Va bene, allora lascio il prossimo combattimento a te, grande signorina Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				}
			]
		},
		{
