	"talks": [
		{
			"id": 1104201,
			"completionStepIds": [
				1104201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
